                            try:
                                px_, qt_ = float(i.get("target_price") or 0), float(i.get("locked_qty") or 0)
                            except Exception:
                                continue
                            snap["tracked"][str(oid)] = {"bot": name, "sym": sym, "side": side_, "px": px_, "qty": qt_,
                                                         "g": float(_hg.get("g") or 0) or 0.008, "hg": int(_hg.get("ep") or 0)}
                            if side_ == "buy":
                                q["bots_frozen"] += px_ * qt_
                            n_tr += 1
                modes.setdefault(base, set()).add("dca")
                snap["coins"].setdefault(base, {"mode": "dca", "base_exp": 0.0, "handoff": 0.0,
                                                "acc": 0.0, "bots": [], "px": 0.0, "tol_q": 0.0,
                                                "inflight": False})["bots"].append(sym)
            else:
                exp = 0.0
                for key in ("limit_sells", "virtual_sells", "accum_sells"):
                    for i in (st.get(key) or {}).values():
                        try:
                            exp += float(i.get("locked_qty") or 0)
                        except Exception:
                            pass
                ri = st.get("reinvest") if isinstance(st.get("reinvest"), dict) else {}
                pend_ho = 0.0
                for ho in _ri_handoffs_of(st):          # 🪙 كل تسليم ما استلمه المُراكِم بعد = بالطريق
                    try:
                        if ho.get("id") not in seen_ho:
                            pend_ho += float(ho.get("coin") or 0)
                    except Exception:
                        continue
                pend_ho += float(ri.get("cap_coin_total") or 0)   # 💉 عملة رأس مال رجعت للمحفظة بالتفكيك
                c = snap["coins"].setdefault(base, {"mode": "grid", "base_exp": 0.0, "handoff": 0.0,
                                                    "acc": 0.0, "bots": [], "px": 0.0, "tol_q": 0.0,
                                                    "inflight": False})
                c["base_exp"] += exp
                c["handoff"] += pend_ho
                c["bots"].append(sym)
                if cp > 0:
                    c["px"] = cp
                    c["tol_q"] = max(c["tol_q"], float(cfg.get("usd_value") or 0) / cp * 0.02)
                modes.setdefault(base, set()).add("grid")
                for side, key in (("buy", "limit_buys"), ("sell", "limit_sells")):
                    for oid, i in (st.get(key) or {}).items():
                        try:
                            px_, qt_ = float(i.get("target_price") or 0), float(i.get("locked_qty") or 0)
                        except Exception:
                            continue
                        snap["tracked"][str(oid)] = {"bot": name, "sym": sym, "side": side,
                                                     "px": px_, "qty": qt_, "g": g}
                        if side == "buy":
                            q["bots_frozen"] += px_ * qt_
                        n_tr += 1
                usd = float(cfg.get("usd_value") or 0)
                if bt == "grid_step":                    # 🪜 usd_value = مبلغ المستوى كله ⇒ أمره الواحد = ÷ الأجزاء
                    try:
                        usd /= max(1, int(float(cfg.get("step_parts") or 1)))
                    except Exception:
