                         f"**{_ls['qty']}** @ **{_ls['px']}$** · ربح **{_ls['profit']}$**")
            if s.get('last_move'):
                _lm = s['last_move']
                L.append(f"- آخر ترحيل للمتراكم: `{datetime.fromtimestamp(_lm['ts']).strftime('%Y-%m-%d %H:%M')}` · "
                         f"**{_lm['usd']}$** ({_lm.get('why','')})")
            if s.get('skip'):
                L.append(f"- ⚠️ الحالة الآن: {s['skip']}")

    # ── السجل العام ──
    L.append("\n---\n\n## 📒 سجل الأرباح العام\n")
    L.append(f"- المفاتيح: **{len([k for k in led if not str(k).startswith('_')])}**")
    tot30 = 0.0
    for k, e in led.items():
        if str(k).startswith("_") or not isinstance(e, dict): continue
        tot30 += sum(float(v or 0) for kk, v in (e.get("daily") or {}).items() if kk >= cut)
    L.append(f"- إجمالي آخر {days} يوم: **{tot30:.4f}$**")
    mig = [k for k, e in led.items() if isinstance(e, dict) and e.get("_migrated")]
    if mig: L.append(f"- مُرحّلة: `{mig}`")

    L.append("\n---\n\n> 🔒 كل المفاتيح والأسرار محجوبة من هذا التقرير.")
    _md_ = "\n".join(L)
    return _md_ + (_safe(_money_audit_md, default='') or '')   # 💰 تدقيق حركة الأموال


