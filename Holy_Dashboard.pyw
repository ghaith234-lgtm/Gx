TG_DIAG = {"last": "لم يُرسل شيء بعد"}

def tg_send(text, force=False, plain=False):
    if TG_MUTED["v"] and not force:
        TG_DIAG["last"] = "🔕 الإشعارات مكتومة (زر 🔔)"
        return False
    if not plain:                       # 📱 v3.24.0: نفس الإشعار — مختصر — لتطبيق الموبايل (plain = إعادة لنفس النص ⇒ ما يتكرر)
        try:
            app_feed_push(text)
        except Exception:
            pass
    c = dash_cfg()
    token = (c.get("tg_token") or "").strip()
    chat = (c.get("tg_chat_id") or "").strip()
    if not token or not chat:
        TG_DIAG["last"] = "❌ لا يوجد توكن أو Chat ID محفوظ — افتح 🔗 الارتباط واحفظهما"
        return False
    try:
        _pl = {"chat_id": chat, "text": text}
        if not plain:
            _pl["parse_mode"] = "Markdown"      # plain=True: البديل الآمن لو تيليغرام رفض التنسيق
        data = json.dumps(_pl).encode()
        req = urllib.request.Request(f"https://api.telegram.org/bot{token}/sendMessage",
                                     data=data, headers={"Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=8, context=_TG_CTX) as r:
            j = json.loads(r.read().decode("utf-8"))
        if j.get("ok"):
            TG_DIAG["last"] = "✅ آخر إرسال نجح"
            journal("notify", "✈️ " + str(text)[:1800], "ok")
            return True
        TG_DIAG["last"] = f"❌ تيليغرام رفض: {j.get('description', 'خطأ مجهول')}"
        journal("notify", "✈️ لم يُرسَل: " + TG_DIAG["last"] + " — " + str(text)[:300], "err", rl="tgfail:" + str(j.get('description', ''))[:60])
        return False
    except urllib.error.HTTPError as e:
        body = ""
        try:
            body = e.read().decode("utf-8")[:200]
        except Exception:
            pass
        TG_DIAG["last"] = f"❌ HTTP {e.code}: {body or 'تحقق من صحة التوكن'}"
        return False
    except Exception as ex:
        TG_DIAG["last"] = f"❌ تعذّر الاتصال بتيليغرام: {ex}"
        return False


def tg_photo(png, caption=""):
    """🖼️ v3.23.3: صورة لتيليغرام (بطاقة الأرباح — بس لما تطلبها، فتنرسل حتى لو الإشعارات مكتومة). يرجع (نجح، رسالة)."""
    c = dash_cfg()
    token = (c.get("tg_token") or "").strip()
    chat = (c.get("tg_chat_id") or "").strip()
    if not token or not chat:
        return False, "❌ لا يوجد توكن أو Chat ID محفوظ — افتح 🔗 الارتباط واحفظهما"
    bnd = "----holycard" + _sc.token_hex(8)
    parts = []
    for name, val in (("chat_id", chat), ("caption", str(caption or "")[:1000])):
        if val:
            parts.append(f'--{bnd}\r\nContent-Disposition: form-data; name="{name}"\r\n\r\n{val}\r\n'.encode("utf-8"))
    parts.append(f'--{bnd}\r\nContent-Disposition: form-data; name="photo"; filename="holy_card.png"\r\nContent-Type: image/png\r\n\r\n'.encode("utf-8")
                 + png + b"\r\n")
    parts.append(f"--{bnd}--\r\n".encode("utf-8"))
    try:
        req = urllib.request.Request(f"https://api.telegram.org/bot{token}/sendPhoto", data=b"".join(parts),
                                     headers={"Content-Type": f"multipart/form-data; boundary={bnd}"})
        with urllib.request.urlopen(req, timeout=25, context=_TG_CTX) as r:
            j = json.loads(r.read().decode("utf-8"))
        if j.get("ok"):
            journal("notify", "🖼️ أُرسلت بطاقة الأرباح إلى تيليغرام — " + str(caption or "")[:200], "ok")
            return True, "✅ أُرسلت البطاقة — راجع تيليغرام"
        return False, f"❌ تيليغرام رفض: {j.get('description', 'خطأ مجهول')}"
    except urllib.error.HTTPError as e:
        body = ""
        try:
            body = e.read().decode("utf-8")[:200]
        except Exception:
            pass
        return False, f"❌ HTTP {e.code}: {body or 'تحقق من صحة التوكن'}"
    except Exception as ex:
        return False, f"❌ تعذّر الاتصال بتيليغرام: {type(ex).__name__}"


