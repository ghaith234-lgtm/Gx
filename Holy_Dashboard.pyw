    const _u=d.is_buy?'USDT':(d.base_coin||'');
    const _act=d.is_buy?'بِع':'اشترِ';
    R.lp.textContent=(lp>=0?'+':'')+lp+' '+_u;
    R.lp.className='num '+(lp>=0?'dcacoin':'dcaloss');
