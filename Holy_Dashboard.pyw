def _ri_stat(b, st):   # noqa: C901
    """لقطة رقمية لإعادة الاستثمار ببوت واحد — كلها بالدولار عند سعر الدرجة.

    🔑 نستعمل `px` المخزَّن بالدرجة لا سعر السوق، فالرقم **ما يتحرك بحركة السعر** —
    يتحرك بالنمو وحده. هذا اللي يخلي فرق اليومين معنىً حقيقياً.
    """
    ri = (st or {}).get("reinvest")
    if not isinstance(ri, dict):
        return None
    lv = ri.get("levels") or {}
    g = bq = pig = inj = 0.0
    for e in lv.values():
        try:
            px = float(e.get("px") or 0)
            g += float(e.get("grown_qty") or 0) * px
            bq += float(e.get("base_qty") or 0) * px
            pig += float(e.get("usd_book") or 0)
            inj += float(e.get("inj_book") or 0) + float(e.get("inj_grown") or 0)
        except Exception:
            continue
    return {"g": round(g, 6), "b": round(bq, 6), "p": round(pig, 6),
            "j": round(inj, 6), "c": int(ri.get("cycles") or 0),
            "n": len(lv), "on": bool(ri.get("on"))}


_RI_RE_SELL = re.compile(r"\[بيع فوري\].*?الربح:\s*\+?([\d.]+)")
_RI_RE_IN = re.compile(r"\[ربح داخلي\].*?الربح:\s*\+?([\d.]+)")
_RI_RE_CU = re.compile(r"\[ربح تعويضي\][^:]*:\s*\+([\d.]+)\$.*?\((\d+)\)")   # ⚡ بيع لحاق: الحصة العادية + عدد المستويات


def daily_earn_map(days=45):
    """📅 ربح كل يوم من **سجل صفقات المحرك** — المصدر الحي.

    🔑 ليش من السجل لا من فروقات الأرصدة؟
       الرصيد الداخلي **ينزل** عند التحرير والسحب، فالفرق يطلع سالباً أو مضخّماً.
       أما السجل فيكتب كل بيعة بوقتها وربحها **مهما كانت الحالة**:
         🔴 [بيع فوري]  → الحصة العادية (رقم المحرك الإجمالي × المعامل)
         💠 [ربح داخلي] → الحصة المعاد استثمارها (صافية أصلاً)
       فيشتغل بالثلاث حالات: مطفية · نسبة · 100%. وبلا إعادة تشغيل بوتات.

    ⚠️ السجل محدود بـ1000 سطر لكل بوت (≈أسبوعان) — ولهذا `reinvest_tick`
       يؤرشف المبلغ اليومي حتى يعيش لشهور.
    """
    out = {}
    cut = (datetime.now() - timedelta(days=days)).strftime("%Y-%m-%d")
    for d, b in bot_dirs().items():
        try:
            _, hp, _ = paths_of(b)
            hist = _safe(load_json, hp, default=[]) or []
            nfv = _safe(net_factor, b, default=1.0)
            for row in hist:
                if not isinstance(row, dict):
                    continue
                day = str(row.get("time") or "")[:10]
                if not day or day < cut:
                    continue
                msg = str(row.get("msg") or "")
                m = _RI_RE_IN.search(msg)
                if m:
                    e = out.setdefault(day, {"norm": 0.0, "ri": 0.0})
                    e["ri"] += float(m.group(1))
                    continue
                m = _RI_RE_SELL.search(msg)
                if m:
                    e = out.setdefault(day, {"norm": 0.0, "ri": 0.0})
                    e["norm"] += float(m.group(1)) * nfv
        except Exception:
            continue
    for e in out.values():
        e["norm"] = round(e["norm"], 6)
        e["ri"] = round(e["ri"], 6)
    return out


def position_of(b, st, px=None):
    """💼 المركز الكامل لبوت واحد — **كل سنت محسوب من الحالة**.

    🔑 الفكرة: كل أمر بيع يحمل عملة مشتراة بسعر معروف (`cost_px`)،
       وكل أمر شراء يحجز دولارات (`target_price × locked_qty`).
       فنجمعهم ونعرف بالضبط: كم عملة تملك · بأي معدل · وكم دولار محجوز.

    يرجّع:
      qty/cost/avg  : العملة المحتجزة بأوامر البيع ومعدّل تكلفتها
      value/unreal  : قيمتها بالسوق والربح/الخسارة الدفترية
      lock_buy      : دولارات محجوزة بأوامر الشراء
      live/mem      : عدد الأوامر المنشورة والذاكرة
    """
    st = st or {}
    px = float(px if px is not None else (st.get("current_price") or 0) or 0)
    # 🧾 عمولة الشراء **دُفعت فعلاً** على العملة المحتجزة — فهي جزء من تكلفتك.
    #    بدونها ما تطابق محفظة المنصة (الفرق = التكلفة × العمولة).
    try:
        fee = float((b.get("cfg") or {}).get("fee_rate") or FEE_RATE_DEFAULT)
    except Exception:
        fee = FEE_RATE_DEFAULT
    if not (0.0 <= fee < 0.05):
        fee = FEE_RATE_DEFAULT
    qty = cost = lock = 0.0
    live = mem = 0
    for key in ("limit_sells", "virtual_sells", "accum_sells"):
        for info in (st.get(key) or {}).values():
            try:
                q = float(info.get("locked_qty") or 0)
                if q <= 0:
                    continue
                c = float(info.get("cost_px") or info.get("original_buy_anchor") or 0)
                qty += q
                cost += q * c * (1.0 + fee)      # السعر + عمولة الشراء
                live += 1 if key == "limit_sells" else 0
                mem += 0 if key == "limit_sells" else 1
            except Exception:
                continue
    for key in ("limit_buys", "virtual_buys", "accum_buys"):
        for info in (st.get(key) or {}).values():
            try:
                q = float(info.get("locked_qty") or 0)
                t = float(info.get("target_price") or 0)
                if q > 0 and t > 0:
                    lock += q * t
                    live += 1 if key == "limit_buys" else 0
                    mem += 0 if key == "limit_buys" else 1
            except Exception:
                continue
    avg = (cost / qty) if qty > 0 else 0.0      # معدّل شامل العمولة
    val = qty * px
    return {"qty": round(qty, 10), "cost": round(cost, 6), "avg": round(avg, 8),
            "value": round(val, 6), "unreal": round(val - cost, 6),
            "lock_buy": round(lock, 6), "live": live, "mem": mem,
            "fee": fee, "px": px}


