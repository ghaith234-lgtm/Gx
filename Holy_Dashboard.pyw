# ═══════════════ 💻 v3.26.0: برنامج ويندوز — شاشة كاملة · ينزل من ⚙️ مثل تطبيق أندرويد ═══════════════
#   برنامج صغير (C) يفتح اللوحة نفسها بنافذة Edge/Chrome بوضع التطبيق وبشاشة كاملة (بملف تعريف خاص ⇒ يبقى داخل).
#   العنوان ينكتب داخله وقت التنزيل (فتحة ثابتة بعد «HOLY-URL-SLOT:») — ما بيه مفاتيح ولا يلمس البوتات.
WIN_URL_TAG = b"HOLY-URL-SLOT:"
WIN_URL_MAX = 540


def win_exe():
    c = _WIN_CACHE
    if not c:
        try:
            raw = _b64s.b64decode(WIN_EXE_B64)
        except Exception:
            raw = b""
        c.update(raw=raw, sha256=_hl.sha256(raw).hexdigest() if raw else "", size=len(raw))
    return c


_WIN_CACHE = {}


def win_url_ok(u):
    """عنوان اللوحة اللي ينكتب بالبرنامج: http/https بس · بلا فراغات ولا رموز تحكم · ≤540 بايت."""
    u = str(u or "").strip()
    if not re.match(r"^https?://[^\s\"'<>\\]+$", u) or len(u.encode("utf-8")) > WIN_URL_MAX:
        return ""
    return u.rstrip("/")


def win_exe_for(url):
    """نسخة البرنامج وبيها عنوان لوحتك (يكتبه بالفتحة — باقي البرنامج نفسه بايت ببايت)."""
    raw = win_exe()["raw"]
    i = raw.find(WIN_URL_TAG)
    u = win_url_ok(url).encode("utf-8")
    if not raw or i < 0 or not u:
        return raw
    j = i + len(WIN_URL_TAG)
    return raw[:j] + u + b"\0" * (WIN_URL_MAX + 20 - len(u)) + raw[j + WIN_URL_MAX + 20:]



