    st = acc_state(); out = []
    wk = (datetime.now() - timedelta(days=7)).timestamp()
    mo = (datetime.now() - timedelta(days=30)).timestamp()
    for a in acc_cfgs():
        e = st.get(a["id"]) or {}
        buys = e.get("buys") or []
        coin = float(e.get("coin", 0)); spent = float(e.get("spent", 0))
        sym = a.get("symbol", ""); px = _acc_price(sym)
        w = [b for b in buys if b.get("ts", 0) >= wk]
        m = [b for b in buys if b.get("ts", 0) >= mo]
        out.append({
            "id": a["id"], "name": a.get("name") or sym, "start": a.get("start"), "symbol": sym,
            "base": sym.split("-")[0], "pct": a.get("pct"),
            "coin_pct": a.get("coin_pct") or 0,
            "avg_px": (round(float(e.get("spent") or 0) / float(e.get("coin") or 1), 8)
                       if float(e.get("coin") or 0) > 0 else 0),
            "n_reinv": len([x for x in (e.get("buys") or [])
                            if isinstance(x, dict) and x.get("why") == "إعادة استثمار"]),
            "qty_reinv": round(sum(float(x.get("qty") or 0) for x in (e.get("buys") or [])
                                   if isinstance(x, dict) and x.get("why") == "إعادة استثمار"), 10),
            "enabled": a.get("enabled", True),
            "min_buy": a.get("min_buy"), "max_buy": a.get("max_buy"),
            "low": a.get("low_price"), "high": a.get("high_price"),
            "pending": round(float(e.get("pending", 0)), 4),
            "pool": round(float(e.get("pool", 0)), 4),
            "last_move": (e.get("moves") or [None])[0],
            "withdrawn": round(float(e.get("withdrawn", 0)), 2),
            "realized": round(float(e.get("realized", 0)), 2),
            "n_sells": len(e.get("sells") or []),
            "last_sell": (e.get("sells") or [None])[0],
            "sell_pending": bool(e.get("sell_inflight")),
            "coin": round(coin, 8), "spent": round(spent, 2),
            "avg": round(spent / coin, 8) if coin > 0 else None,
            "cp": px, "value": round(coin * px, 2) if px else None,
            "pl": round(coin * px - spent, 2) if px and coin else None,
            "pl_pct": round((coin * px - spent) / spent * 100, 2) if px and spent > 0 else None,
