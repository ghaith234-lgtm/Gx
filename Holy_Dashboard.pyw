def backup_states():
    """🗄️ نسخة يومية من ملفات الحالة والإعدادات — رجوع آمن دائماً"""
    d = datetime.now().strftime("%Y-%m-%d")
    if _BK_DONE["day"] == d: return
    root = os.path.join(ROOT, "Holy_Backups", d)
    try:
        os.makedirs(root, exist_ok=True)
        for b in bot_dirs().values():
            sp, hp, _ = paths_of(b)
            sub = os.path.join(root, os.path.relpath(b["dir"], ROOT).replace(os.sep, "_"))
            os.makedirs(sub, exist_ok=True)
            for f in (sp, b["cfg_path"]):
                if os.path.isfile(f):
                    shutil.copy2(f, os.path.join(sub, os.path.basename(f)))
        if os.path.isfile(LEDGER):
            shutil.copy2(LEDGER, os.path.join(root, "Holy_Ledger.json"))
        # نُبقي آخر 14 يوماً فقط
        bk = os.path.join(ROOT, "Holy_Backups")
        days = sorted(x for x in os.listdir(bk) if re.match(r"\d{4}-\d{2}-\d{2}$", x))
        for old_d in days[:-14]:
            shutil.rmtree(os.path.join(bk, old_d), ignore_errors=True)
        _BK_DONE["day"] = d
    except Exception:
        pass

