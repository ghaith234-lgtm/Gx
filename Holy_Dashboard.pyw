                     "type": ktype.get(k) or str(e.get("type") or "grid"), "v": round(v, 6), "gone": k not in live}
                    for k, e, v in sorted(ltd.get(wid, []), key=lambda x: -x[2])]
            wait_ = 0.0                                      # ⏳ اللي ما انقيّد بعد — من الدفتر (حتى المحذوف) · نافذة اللحاق بس
