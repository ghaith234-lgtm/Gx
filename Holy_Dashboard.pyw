def _acc_last_run():
    return (acc_state().get("_meta") or {}).get("last_run_day", "")

def _acc_mark_run(day):
    st = acc_state()
    st.setdefault("_meta", {})["last_run_day"] = day
    st["_meta"]["last_run_ts"] = time.time()
    _acc_save(st)

def _acc_has_pending():
    """هل في رصيد متراكم ينتظر شراءً؟"""
    st = acc_state()
    for a in acc_cfgs():
        if not a.get("enabled", True): continue
        e = st.get(a["id"]) or {}
        if float(e.get("pool", 0)) > 0:
            return True
        if e.get("inflight"):
            return True
    return False

def accum_loop():
    """⏰ الجولة الرئيسية: مرة واحدة بعد منتصف الليل (نهاية اليوم).
    وإعادة محاولة كل ساعة فقط إذا بقي رصيد معلّق (سعر خارج النطاق أو أمر ينتظر تأكيداً)."""
    while True:
        try:
            now = datetime.now()
            today = now.strftime("%Y-%m-%d")
            if _acc_last_run() != today:
                # 🌙 جولة اليوم (مرة واحدة — محفوظة على القرص فتنجو من إعادة التشغيل)
                #    التوزيع دائماً · الشراء فقط لو كنا داخل النافذة
                _acc_mark_run(today)
                _ACC_RUN["retry"] = time.time()
                accum_tick()
                _safe(profit_tick, default=None)      # 💰 v3.22.8: الباقي بعد المُراكِمات ⇒ الربح (نفس اللحظة)
            elif (acc_in_window() and time.time() - _ACC_RUN["retry"] >= 1800
                  and _acc_has_pending()):
                # ⏳ داخل النافذة ورصيد ينتظر (سعر خارج النطاق) — نعيد المحاولة
                _ACC_RUN["retry"] = time.time()
                accum_tick()
        except Exception:
            pass
        time.sleep(120)

def acc_withdraw(aid, amount):
    """📤 يحوّل مبلغاً من الرصيد المتراكم للصندوق النهائي — يصير دولار حر بحسابك، لا يُشترى به.
    v3.22.7: amount="all" ⇒ المتراكم كله بالضبط (زر «الكل» يعرض المبلغ مقرّب لسنتين) · فرق التقريب ≤ نص سنت ⇒ الكل."""
    st = acc_state()
    e = st.get(aid)
    if e is None:
        return False, "المُراكِم غير موجود"
    if e.get("inflight"):
        return False, "⏳ في أمر شراء ينتظر التأكيد — انتظر تسويته أولاً"
    pend = round(float(e.get("pending", 0)), 6)
    if str(amount).strip().lower() == "all":
        amt = pend
    else:
        try:
            amt = round(float(amount), 6)
        except Exception:
            return False, "رقم غير صحيح"
        if pend < amt <= pend + 0.005:
            amt = pend                  # 2 خانات بالواجهة ⇒ فرق تقريب، مو طلب أكبر من المتراكم
    if amt <= 0:
        return False, ("ماكو رصيد بالمتراكم" if pend <= 0 else "المبلغ لازم أكبر من صفر")
    if amt > pend + 1e-9:
        return False, f"المتراكم {pend:.2f}$ فقط — ما يصير تحويل {amt:.2f}$"
    e["pending"] = round(pend - amt, 6)
    e["withdrawn"] = round(float(e.get("withdrawn", 0)) + amt, 4)
    e["wlog"] = ([{"ts": time.time(), "usd": amt}] + list(e.get("wlog") or []))[:100]
    _acc_save(st)
    try:
        journal("accum", f"📤 {aid}: تحويل {amt:.2f}$ من المتراكم للصندوق النهائي — المتبقي {e['pending']:.2f}$", "ok",
                bot=aid, amount=amt, left=e["pending"], withdrawn=e["withdrawn"])
    except Exception:
        pass
    return True, f"📤 تحوّل {amt:.2f}$ للصندوق النهائي 💰 (دولار حر بحسابك) — المتبقي بالمتراكم {e['pending']:.2f}$"


def acc_coin_out(aid, qty):
    """📤 v3.23.1: جزء من مخزون المُراكِم (أو كله) ⇒ 🪙 الصندوق النهائي كعملة — ما تنباع ولا تتحرك بالمنصة.
    الكلفة تنزل بنسبتها (المتوسط يبقى) · الكل ⇒ الكلفة تصفّر · العملة باقية بحسابك ⇒ الرقابة تبقى تتوقعها (`_ri_left_w`) ·
    `cout` ينقيّد بالصندوق النهائي من `profit_tick`. يرجع (نجح، رسالة)."""
    a = next((x for x in acc_cfgs() if x.get("id") == aid), None)
    st = acc_state()
    e = st.get(aid)
    if a is None or e is None:
        return False, "المُراكِم غير موجود"
    if e.get("inflight") or e.get("sell_inflight"):
        return False, "⏳ في أمر ينتظر تأكيد المنصة — حوّل بعد ما يتسوّى"
    base = str(a.get("symbol") or "").split("-")[0]
    coin = round(float(e.get("coin") or 0), 10)
    if str(qty).strip().lower() == "all":
        q = coin
    else:
        try:
            q = round(float(qty), 10)
        except Exception:
            return False, "رقم غير صحيح"
    if q <= 0:
        return False, ("ماكو عملة بالمخزون" if coin <= 0 else "الكمية لازم أكبر من صفر")
    if q > coin + 1e-12:
        return False, f"المخزون {coin:.8g} {base} بس"
    q = min(q, coin)
    spent = float(e.get("spent") or 0)
    left = round(coin - q, 10)
    if left <= 1e-10:
        cost = round(spent, 6)
        e["coin"], e["spent"] = 0.0, 0.0            # الكل ⇒ تجميع جديد من الصفر
    else:
        cost = round(q * (spent / coin if coin > 0 else 0.0), 6)
        e["coin"], e["spent"] = left, round(spent - cost, 6)
    e["cout"] = ([{"ts": time.time(), "qty": round(q, 10), "cost": cost}] + list(e.get("cout") or []))[:200]
    wid = acc_wid(a) or "?"
    lf = st.setdefault("_ri_left", {})                # 🛡️ العملة باقية بحسابك ⇒ الرقابة تبقى تتوقعها
    lf[base] = round(float(lf.get(base) or 0) + q, 10)
    lw = st.setdefault("_ri_left_w", {}).setdefault(wid, {})
    lw[base] = round(float(lw.get(base) or 0) + q, 10)
    _acc_save(st)
    _safe(journal, "accum", f"📤 {a.get('name') or aid}: تحويل {q:.8g} {base} من المخزون للصندوق النهائي (كلفتها {cost:.4f}$) — الباقي {e['coin']:.8g}",
          "ok", bot=aid, sym=a.get("symbol", ""), coin=q, cost=cost, left=e["coin"], wallet=wid, default=None)
    return True, (f"📤 تحوّل {q:.8g} {base} للصندوق النهائي 💰 (عملة — باقية بحسابك) — الباقي بالمخزون {e['coin']:.8g}"
                  + (" · صُفّرت الكلفة" if left <= 1e-10 else ""))


# 🔒 ملف المُراكِم يكتب عليه أكثر من خيط (جولة نص الليل · الاستلام الفوري · أزرارك) ⇒ قفل واحد.
#    نلفّ الدوال من برّا — أجسامها بايت ببايت كما هي.
_ACC_IO = threading.RLock()


def _acc_locked(fn):
    def _w(*a, **k):
        with _ACC_IO:
            return fn(*a, **k)
    _w.__name__, _w.__doc__ = fn.__name__, fn.__doc__
    return _w


_acc_apply_sell = _acc_locked(_acc_apply_sell)
_acc_mark_run = _acc_locked(_acc_mark_run)
_acc_move_to_reserve = _acc_locked(_acc_move_to_reserve)
_acc_settle = _acc_locked(_acc_settle)
acc_buy_now = _acc_locked(acc_buy_now)
acc_sell_now = _acc_locked(acc_sell_now)
acc_settle_sell = _acc_locked(acc_settle_sell)
acc_withdraw = _acc_locked(acc_withdraw)
acc_coin_out = _acc_locked(acc_coin_out)
accum_tick = _acc_locked(accum_tick)



def acc_alloc_summary():
    """📊 محاسبة أرباح أمس — 👛 لكل محفظة لحالها (v3.22.9): ربح بوتاتها · وُزّع لمُراكِماتها · غير مخصّص (يمنع أي تكرار أو ضياع)"""
    y = (datetime.now() - timedelta(days=1)).strftime("%Y-%m-%d")
    prof = day_profit(y)
    st = acc_state()
    led = load_json(LEDGER) or {}
    live = _live_wmap()
    try:
        aw = acc_wallets()
    except Exception:
        aw = {}
    groups = []
    for k, e in led.items():
        if str(k).startswith("_") or not isinstance(e, dict):
            continue
        w = _led_wid(k, e, live)
        if w and float((e.get("daily") or {}).get(y) or 0) > 0 and w not in groups:
            groups.append(w)
    for a in acc_cfgs():
        if acc_wid(a) not in groups:
            groups.append(acc_wid(a))
    rows = []; total_alloc = 0.0; wallets = []
    for w in groups:
        wp = day_profit_w(y, w, led, live)
        wr, wa, wu = [], 0.0, 0.0
        for a in acc_cfgs():
            if acc_wid(a) != w:
                continue
            e = st.get(a["id"]) or {}
            share = float((e.get("days") or {}).get(y) or 0)
            wa += share
            wu += float(a.get("pct") or 0)
            wr.append({"id": a["id"], "name": a.get("name") or a.get("symbol"),
                       "pct": a.get("pct"), "coin_pct": a.get("coin_pct") or 0,
                       "share": round(share, 4),
                       "pool": round(float(e.get("pool", 0)), 4),
                       "reserve": round(float(e.get("pending", 0)), 4),
                       "enabled": a.get("enabled", True), "wid": w, "wlabel": (aw.get(w) or {}).get("label") or w})
        rows += wr
        total_alloc += wa
        wallets.append({"wid": w, "label": (aw.get(w) or {}).get("label") or w, "profit": round(wp, 4), "allocated": round(wa, 4),
                        "unallocated": round(wp - wa, 4), "used_pct": round(wu, 2), "free_pct": round(100 - wu, 2), "rows": wr})
    used = max([x["used_pct"] for x in wallets] or [0.0])
    return {"day": y, "profit": round(prof, 4), "allocated": round(total_alloc, 4),
            "unallocated": round(prof - total_alloc, 4),
            "used_pct": round(used, 2), "free_pct": round(100 - used, 2), "rows": rows, "wallets": wallets}


def acc_log(aid, limit=300):
    """📜 v3.26.3: سجل المُراكِم — من سجلاته المحفوظة بحالته (نصيب كل يوم · شراء · عملة استلمها · بيع · نقل للمتراكم ·
    تحويل للصندوق النهائي — دولار أو عملة) + تنبيهاته وأخطاءه من السجلات المفصّلة (7 أيام) · قراءة بس — ولا شي يتحرك"""
    a = next((x for x in acc_cfgs() if x.get("id") == aid), None)
    if not a:
        return {"ok": False, "msg": "المُراكِم مو موجود", "items": []}
    e = acc_state().get(aid) or {}
    sym = str(a.get("symbol") or "")
    base = sym.split("-")[0].upper()
    out = []
    T = lambda ts: datetime.fromtimestamp(float(ts)).strftime("%Y-%m-%d %H:%M:%S")
    q = lambda v: _okx_num(v) if v else "0"

    def add(ts, msg, k):
        try:
            out.append({"t": float(ts), "time": T(ts), "msg": msg, "k": k})
        except Exception:
            pass
    dp = e.get("dpct") or {}
    for d, v in (e.get("days") or {}).items():
        try:
            v = float(v or 0)
            if v <= 0:
                continue                                 # يوم بلا ربح — ما ينكتب (لا ضجيج)
            ts = (datetime.strptime(d, "%Y-%m-%d") + timedelta(days=1)).timestamp()
        except Exception:
            continue
        pc = dp.get(d)
        out.append({"t": ts - 0.5, "time": d + " · نهاية اليوم",
                    "msg": f"📥 نصيب ربح يوم {d}: +{v:.4f}$" + (f" ({float(pc):g}% من ربح محفظته)" if pc is not None else "") + " ⇒ قيد الشراء",
                    "k": "share"})
    for x in (e.get("buys") or []):
        try:
            if x.get("hid"):
                add(x["ts"], f"🪙 استلم {q(x.get('qty'))} {base} من {x.get('why') or 'بوت'} (كلفتها {float(x.get('usd') or 0):.4f}$) — بلا شراء", "coin")
            else:
                add(x["ts"], f"🛒 شراء {q(x.get('qty'))} {base} بـ {float(x.get('usd') or 0):.2f}$ @ {x.get('px')} ({x.get('why') or 'آلي'})", "buy")
        except Exception:
            continue
    for x in (e.get("sells") or []):
        try:
            pf = float(x.get("profit") or 0)
            add(x["ts"], f"💰 بيع {q(x.get('qty'))} {base} بـ {float(x.get('usd') or 0):.2f}$ @ {x.get('px')} · "
                         f"{'ربح' if pf >= 0 else 'خسارة'} {pf:+.2f}$ ⇒ الصندوق النهائي" + (f" ({x['why']})" if x.get("why") else ""), "sell")
        except Exception:
            continue
    for x in (e.get("moves") or []):
        try:
            add(x["ts"], f"📦 نُقل {float(x.get('usd') or 0):.2f}$ من قيد الشراء للمتراكم ({x.get('why') or ''})", "move")
        except Exception:
            continue
    for x in (e.get("wlog") or []):
        try:
            add(x["ts"], f"📤 تحويل {float(x.get('usd') or 0):.2f}$ من المتراكم للصندوق النهائي", "wd")
        except Exception:
            continue
    for x in (e.get("cout") or []):
        try:
            add(x["ts"], f"📤 {q(x.get('qty'))} {base} من المخزون للصندوق النهائي (كلفتها {float(x.get('cost') or 0):.2f}$)", "cout")
        except Exception:
            continue
    try:                                                 # ⚠️ فشل شراء/بيع وتنبيهاته (السجلات المفصّلة — 7 أيام)
        for j in (journal_query(bot=aid, lv="warn", limit=100) or {}).get("items") or []:
            add(j.get("t") or 0, ("❌ " if j.get("lv") == "err" else "⚠️ ") + str(j.get("m") or "")[:400], "warn")
    except Exception:
        pass
    out.sort(key=lambda x: x["t"], reverse=True)
    return {"ok": True, "id": aid, "name": a.get("name") or sym, "sym": sym, "items": out[:max(1, min(1000, int(limit or 300)))]}


