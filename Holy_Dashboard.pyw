def _app_go(text, title):
    """وين يفتح الإشعار لما تضغطه: كرت البوت · المُراكِم · الرقابة · التقارير · اللوحة."""
    syms = re.findall(r"`([A-Z0-9]{2,15}-[A-Z]{2,10})`", text)
    if any(w in title for w in ("الرقابة", "رقابة", "الحارس")):
        return "guard"
    if any(w in title for w in ("المُراكِم", "المراكم", "المجمّع", "المتراكم", "تسوية شراء")):
        m = re.search(r"`([^`]{1,60})`", (str(text).splitlines() or [""])[0])      # الاسم بين `` بسطر العنوان الأصلي
        return "acc:" + (m.group(1) if m else "")
    if any(w in title for w in ("تقرير", "ملخص")):
        return "reports"
    if syms:
        dirs = [os.path.relpath(b["dir"], ROOT) for b in bot_dirs().values() if b.get("symbol") == syms[0]]
        return ("bot:" + dirs[0]) if len(dirs) == 1 else ("sym:" + syms[0])
    return ""


def _app_short(text):
    """إشعار تيليغرام ⇒ نسخة مختصرة للموبايل: عنوان + سطر · نوعه (صفقة/تنبيه/معلومة) · ربحه بالدولار (للتجميع) · وين يفتح."""
    def clean(s):
        s = re.sub(r"<[^>]+>", "", str(s))
        return re.sub(r"\s+", " ", s.replace("*", "").replace("`", "").replace("_", " ")).strip()
    lines = [l for l in str(text).splitlines() if l.strip() and not set(l.strip()) <= set("━─-=_ ")]
    title = clean(lines[0])[:90] if lines else "Holy"
    rest = [clean(l) for l in lines[1:]]
    usd = None
    pick = [l for l in rest if re.search(r"ربح الصفقة|ربح الدورة|^الصفقة", l)]
    if pick:
        m = re.search(r"([+-]?\d+(?:\.\d+)?)\s*(?:\$|USDT)", pick[0])
        if m:
            usd = round(float(m.group(1)), 6)
    tot = [l for l in rest if "الإجمالي" in l and l not in pick[:1]]          # صفقة ⇒ ربحها + الإجمالي
    body = " · ".join((pick[:1] + tot[:1]) if pick and tot else (pick[:1] + [l for l in rest if l not in pick[:1]])[:2])[:150]
    if re.search(r"[🚨⚠🛑❌🔌]|فشل|أوقف|طاح|ما اشترى|ما تكدر|خطر|لم يشتر|لم يستطع|تعذّر|لم يُطبَّق", title):
        kind = "alert"
    elif usd is not None or re.search(r"ربح|💰|💎", title):
        kind = "trade"
    else:
        kind = "info"
    return {"k": kind, "t": title, "b": body, "usd": usd, "go": _app_go(str(text), title)}


def app_feed_push(text, go=None, kind=None):
    """📨 كل إشعار تيليغرام (بعد زر الكتم) ينضاف هنا مختصراً — بس لو في جهاز مربوط · نفس النص خلال 3 ساعات ما يتكرر ·
    `go`: وين يفتح لما ينضغط · `kind` (v3.26.7): نوعه بالموبايل («price» ⇒ قناة «📈 إشعارات الأسعار» بنغمة Holy · التطبيق القديم يعتبره «معلومات»)."""
    with _APPD_LOCK:
        _appd_load()
        if not _APPD["devs"]:
            return False
    it = _app_short(text)
    if go:
        it["go"] = go
    if kind:
        it["k"] = kind
    hk = _hl.sha256(str(text).encode("utf-8", "replace")).hexdigest()[:20]
    with _APPF_COND:
        _appf_load()
        now = time.time()
        seen = _APPF["seen"]
        if now - seen.get(hk, 0) < 3 * 3600:
            return False
        seen[hk] = now
        if len(seen) > 600:
            for k in sorted(seen, key=seen.get)[:300]:
                seen.pop(k, None)
        _APPF["last"] += 1
        it.update(id=_APPF["last"], ts=int(now))
        _APPF["items"].append(it)
        del _APPF["items"][:-APP_FEED_KEEP]
        save_json_atomic(APP_FEED_FILE, {"last": _APPF["last"], "items": _APPF["items"]})
        _APPF_COND.notify_all()
    return True


_WD_E = {"grid": "♾️", "grid_plus": "➕", "grid_range": "🎚️", "grid_step": "🪜", "dca": "📉", "dca_buy": "📈", "rec_buy": "🟢", "rec_sell": "🔴", "rec_va": "💹"}


def _wd_n(v, u, sign=True):
    """📱 v3.36.13: رقم الويدجت — بإشارته (اختياري) · خانتين فوق 10 وإلا أربع · وحدته ($ ملزوقة · العملة بمسافة) · لونه u/d/z"""
    try:
        x = float(v)
    except Exception:
        return "—", "z"
    t = f"{abs(x):,.{2 if abs(x) >= 10 else 4}f}"
    sg = ("+" if x > 0 else "-" if x < 0 else "") if sign else ("-" if x < 0 else "")
    return sg + t + ("$" if u == "$" else (" " + u if u else "")), ("u" if x > 1e-12 else "d" if x < -1e-12 else "z")


def app_widget_view():
    """📱 v3.36.13: ويدجت الشاشة الرئيسية (تطبيق 1.9) — للعرض فقط: ربح اليوم · هذا الشهر · الإجمالي · وكل بوت (رمزه · نوعه · يعمل؟ ·
    ربح اليوم · الإجمالي) — بلا مفاتيح ولا أرصدة ولا أوامر · بمفتاح الجهاز المربوط فقط
    · v3.36.32 (تطبيق 2.0): «kb» ستة أرقام · «t» نوع كل بوت (لونه على الويدجت) · «k» الثلاثة تبقى لتطبيق 1.9"""
    o = overview()
    st = o.get("stats") or {}
    today = datetime.now().strftime("%Y-%m-%d")
    TN = _safe(trade_now, default={}) or {}               # 🔄 v3.36.18 (طلب المالك): ربح التداول (عادي + 💠) بكل الخانات
    _bt0 = (_safe(trade_period, today, today, default=None) or {}).get("by_bot") or {}
    _bta = (_safe(trade_period, str(st.get("first") or "") or today, today, default=None) or {}).get("by_bot") or {}
    rows = []
    for b in o.get("bots") or []:
        if b.get("demo"):
            continue
        t = b.get("bot_type") or "grid"
        if t in ("rec_buy", "rec_sell", "rec_va"):
            r = b.get("rec") or {}
            u, pt, td = ((r.get("base") or "") if t == "rec_sell" else "$"), r.get("profit"), r.get("today")
        elif t in ("dca", "dca_buy"):
            d = b.get("dca") or {}
            u, pt, td = ("$" if (t == "dca_buy" or d.get("is_buy")) else (d.get("base_coin") or "")), d.get("coin_profit"), None
        else:
            u, pt, td = "$", b.get("profit"), b.get("today")
        _k = b.get("dir")
        if u == "$" and (_k in _bta or _k in _bt0):         # ربح التداول للبوت: اليوم · كل أيامه
            _x0, _xa = _bt0.get(_k) or {}, _bta.get(_k) or {}
            td = float(_x0.get("n") or 0) + float(_x0.get("r") or 0)
            pt = float(_xa.get("n") or 0) + float(_xa.get("r") or 0)
        a, c = _wd_n(td, u) if td is not None else ("—", "z")
        rows.append(((0 if b.get("alive") else 1, -abs(float(td or 0))),
                     {"e": _WD_E.get(t, "🤖"), "s": str(b.get("symbol") or "").split("-")[0], "on": 1 if b.get("alive") else 0,
                      "a": a, "b": _wd_n(pt, u, False)[0], "c": c, "t": t}))
    rows.sort(key=lambda x: x[0])
    k = lambda lbl, v, sg=True: [lbl] + list(_wd_n(v, "$", sg))
    # 📱 v3.36.32 (تطبيق 2.0): ستة أرقام من ربح التداول (عادي + 💠) — اليوم · أمس · آخر 7 أيام · آخر 30 يوماً (كلاهما مع اليوم) ·
    #    هذا الشهر · الإجمالي — بطلب واحد يغطي آخر 30 يوماً وبداية الشهر
    _n0 = datetime.now()
    _dy = lambda i: (_n0 - timedelta(days=i)).strftime("%Y-%m-%d")
    _m1 = _n0.strftime("%Y-%m-01")
    _pd = (_safe(trade_period, min(_m1, _dy(29)), today, default=None) or {}).get("per_day")
    _sm = (lambda ds: sum(float((_pd.get(x) or {}).get("n") or 0) + float((_pd.get(x) or {}).get("r") or 0) for x in ds)) if _pd else (lambda ds: None)
    return {"ok": True, "run": int(o.get("running") or 0), "n": len(rows),
            "k": [k("ربح اليوم", TN.get("today", o.get("today_profit"))), k("هذا الشهر", st.get("mtd")),
                  k("الإجمالي", TN.get("trade_all", o.get("total_profit")), False)],
            "kb": [k("اليوم", _sm([today])), k("أمس", _sm([_dy(1)])), k("آخر 7 أيام", _sm([_dy(i) for i in range(7)])),
                   k("آخر 30 يوماً", _sm([_dy(i) for i in range(30)])), k("هذا الشهر", _sm([x for x in (_pd or {}) if x >= _m1])),
                   k("الإجمالي", TN.get("trade_all", o.get("total_profit")), False)],
            "bots": [r for _k, r in rows[:12]], "server": APP_VERSION}


def app_feed_wait(since, wait):
    """⏳ سحب طويل: الطلب ينتظر لحد ما يجي إشعار جديد (أو تخلص المهلة) — إشعار فوري بلا ما التطبيق يسأل كل ثانية."""
    deadline = time.time() + max(0.0, min(55.0, float(wait)))
    with _APPF_COND:
        _appf_load()
        gen = _APPF["gen"]
        while _APPF["last"] <= since and time.time() < deadline and _APPF["gen"] == gen:      # جهاز انفصل ⇒ الانتظار يخلص فوراً
            _APPF_COND.wait(max(0.05, deadline - time.time()))
        items = [x for x in _APPF["items"] if int(x.get("id") or 0) > since][-50:]
        return _APPF["last"], items


def app_pair(name, iid, code, ip):
    """🔗 ربط جهاز (من داخل اللوحة وإنت داخل): مفتاح عشوائي يرجع للتطبيق مرة وحدة · هنا ينحفظ مُجزّأ (sha256) بس."""
    tok = _sc.token_urlsafe(32)
    did = _sc.token_hex(4)
    with _APPD_LOCK:
        _appd_load()
        iid = str(iid or "")[:64]
        _APPD["devs"] = [d for d in _APPD["devs"] if not (iid and d.get("iid") == iid)]
        _APPD["devs"].append({"id": did, "iid": iid, "name": str(name or "Android")[:60], "h": _hl.sha256(tok.encode()).hexdigest(),
                              "created": int(time.time()), "seen": int(time.time()), "code": int(code or 0), "ip": str(ip)[:45]})
        _APPD["devs"] = _APPD["devs"][-APP_DEV_MAX:]
        _appd_save(True)
    with _APPF_COND:
        _appf_load()
        last = _APPF["last"]
    journal("user", f"{'💻 حاسوب' if iid.startswith('win-') else '📱 جهاز'} رُبط بالإشعارات — {str(name or 'Android')[:60]}", "ok")
    return did, tok, last


def app_dev_auth(tok):
    """مفتاح الجهاز ⇒ الجهاز (أو None). يفتح الإشعارات وتنزيل التطبيق فقط."""
    tok = str(tok or "").strip()
    if len(tok) < 20:
        return None
    h = _hl.sha256(tok.encode()).hexdigest()
    with _APPD_LOCK:
        _appd_load()
        for d in _APPD["devs"]:
            if _hm.compare_digest(str(d.get("h")), h):
                d["seen"] = int(time.time())
                _appd_save()
                return d
    return None


