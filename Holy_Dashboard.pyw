/* ⚡ أسعار لحظية: المتصفح يتصل مباشرة بقناة OKX العامة (بلا مفاتيح) — ولو انقطع يرجع لأسعار السيرفر */
const LIVE={ws:null,key:'',retry:0,last:{},ping:null,dirty:new Set(),sched:0,lastFlush:0};
const LIVE_MS=250;                                   // 📈 v3.26.8: أسعار OKX توصل عشرات المرات بالثانية ⇒ نرسمها 4 مرات بالثانية بحد أقصى (نفس الدقة بالعين)
function liveWS(coins){
  const key=(coins||[]).join(',');
  if(LIVE.key===key&&LIVE.ws&&LIVE.ws.readyState<=1)return;
  if(LIVE.ws){const o=LIVE.ws; LIVE.ws=null; try{o.close()}catch(e){}}
  clearInterval(LIVE.ping); LIVE.key=key;
  if(!coins||!coins.length||typeof WebSocket==='undefined')return;
  let ws; try{ws=new WebSocket('wss://ws.okx.com:8443/ws/v5/public')}catch(e){return}
  LIVE.ws=ws;
  ws.onopen=()=>{LIVE.retry=0;
    try{ws.send(JSON.stringify({op:'subscribe',args:coins.map(c=>({channel:'tickers',instId:c}))}))}catch(e){}
    LIVE.ping=setInterval(()=>{try{if(ws.readyState===1)ws.send('ping')}catch(e){}},25000)};
  ws.onmessage=ev=>{ if(ev.data==='pong')return; let m; try{m=JSON.parse(ev.data)}catch(e){return}
    (m.data||[]).forEach(d=>{const px=+d.last, o=+d.open24h; if(px>0)livePx(d.instId,px,o>0?(px-o)/o*100:0)})};
  ws.onclose=()=>{clearInterval(LIVE.ping);
    if(LIVE.ws===ws){LIVE.ws=null; LIVE.key='';
      setTimeout(()=>{if(document.hidden)return;const T=((DATA||{}).ticker||{}); liveWS(wsCoins(T.on?(T.coins||[]):[]))},Math.min(30000,2000*(++LIVE.retry)))}};
  ws.onerror=()=>{try{ws.close()}catch(e){}};
}
function livePx(sym,px,chg){
  LIVE.last[sym]={px,chg,ts:Date.now()}; if(window.JPX)JPX[sym]=px;
  LIVE.dirty.add(sym);
  if(!LIVE.sched)LIVE.sched=setTimeout(()=>requestAnimationFrame(liveFlush),Math.max(0,LIVE_MS-(performance.now()-LIVE.lastFlush)));
}
function liveFlush(){LIVE.sched=0; LIVE.lastFlush=performance.now();
  const L=[...LIVE.dirty]; LIVE.dirty.clear();
  for(const sym of L){const v=LIVE.last[sym]; if(v)tkWrite(sym,v.px,v.chg,true)}}
/* ✍️ كاتب واحد لشريط الأسعار: يغيّر بس اللي تغيّر · خانة السعر ما يتغيّر عرضها · لمحة لون هادئة كل 1.5 ث بحد أقصى */
function tkWrite(sym,px,chg,flash){
  const sel=(window.CSS&&CSS.escape)?CSS.escape(sym):sym, t=fmtPx(px), up=(+chg||0)>=0, ct=(up?'▲ ':'▼ ')+Math.abs(+chg||0).toFixed(2)+'%', cc='tkc '+(up?'up':'dn'), now=Date.now();
  document.querySelectorAll(`#tapein .tk[data-s="${sel}"]`).forEach(e=>{
    const p=e.querySelector('.tkp'), c=e.querySelector('.tkc'); if(!p||!c)return;
    const old=p.dataset.v!=null&&p.dataset.v!==''?+p.dataset.v:null;
    if(p.textContent!==t){
      if(t.length>(+p.dataset.w||0)){p.dataset.w=t.length; p.style.minWidth=t.length+'ch'}
      p.textContent=t;
      if(flash&&old!=null&&old!==+px&&now-(+p.dataset.ft||0)>1500){p.dataset.ft=now; p.dataset.fl=+px>old?'u':'d'; clearTimeout(p._ft); p._ft=setTimeout(()=>{delete p.dataset.fl},650)}
    }
