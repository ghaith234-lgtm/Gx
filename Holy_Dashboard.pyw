def _gd_hist_recent(hp, hours=24.0, cap=3000):
    """سطور سجل البوت خلال آخر `hours` ساعة (الأحدث أولاً)."""
    out = []
    lim = datetime.now() - timedelta(hours=hours)
    for h in (load_json(hp) or [])[:cap]:
        try:
            if datetime.strptime(str(h.get("time") or "")[:19], "%Y-%m-%d %H:%M:%S") < lim:
