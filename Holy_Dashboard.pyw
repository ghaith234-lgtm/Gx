        <circle class="fga" cx="15" cy="15" r="12.5" fill="none" stroke-width="3" stroke-linecap="round" stroke-dasharray="78.54" stroke-dashoffset="78.54" transform="rotate(-90 15 15)"/>
        <text class="fgn" x="15" y="18.8" text-anchor="middle"></text></svg><span>الخوف والطمع</span> <small class="fgt"></small></span>`;w=fg.querySelector('.fgw')}
      const a=w.querySelector('.fga'), n=w.querySelector('.fgn'), t=w.querySelector('.fgt');
      a.style.stroke=c; n.textContent=v; n.style.fill=c; t.textContent=f.txt||''; t.style.color=c;
      w.classList.toggle('ext', v<25||v>75);                             // نبض بالخوف أو الطمع الشديد
      const _now=Date.now(), _replay=(+w.dataset.v!==v)||(_now-(+w.dataset.t||0)>60000);   // 🌀 تنكنس من الصفر لقيمتها: لما تتغيّر أو كل دقيقة
      if(_replay){w.dataset.v=v;w.dataset.t=_now;a.style.transition='none';a.style.strokeDashoffset='78.54';void a.getBoundingClientRect();a.style.transition='';}
      requestAnimationFrame(()=>requestAnimationFrame(()=>{a.style.strokeDashoffset=(78.54*(1-v/100)).toFixed(2)}));
    } else fg.innerHTML='<span style="color:var(--mut2)">الخوف والطمع —</span>';
  }
