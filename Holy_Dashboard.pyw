  if(!TAPES.i)TAPES.i=new Tape($('#tape2 .tapewrap')||el,inn);
  TAPES.i.setLoop(Math.max(30,(+((DATA||{}).ticker||{}).speed||45)*1.4));
  const TR={up:['📈 صاعد','var(--green)'],down:['📉 هابط','var(--red)'],flat:['➖ عرضي','var(--mut)']};
