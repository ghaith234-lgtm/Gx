def okx_code(r):
    try:
        return str(r.get("code")) if isinstance(r, dict) else ""
    except Exception:
        return ""


def okx_errmsg(r, who=""):
    """🔑 v3.22.7: نص رفض OKX — ولو الرفض من المفتاح: اسم المحفظة/البوت + شنو تسوي."""
    if r is None:
        return "تعذّر الاتصال بـOKX (إنترنت/جدار حماية)"
    c = okx_code(r)
    try:
        d = (r.get("data") or [{}])[0] if isinstance(r.get("data"), list) and r.get("data") else {}
        m = f"OKX {c}: {d.get('sMsg') or r.get('msg') or 'رفض الطلب'}".strip()
    except Exception:
        m = f"OKX {c}: رد غير مفهوم"
    h = _OKX_AUTH_HINT.get(c)
    if h:
        m = "🔑 " + (f"مفتاح «{who}» مرفوض — " if who else "المفتاح مرفوض — ") + m + " · " + h
    return m


def _scope_err(scope, r):
    try:
        if r is None:
            BAL_ERR[scope] = "تعذر الاتصال بـ OKX (إنترنت/جدار حماية)"
            return True
        if r.get("code") != "0":
            BAL_ERR[scope] = okx_errmsg(r)       # 🔑 v3.22.7: مع شرح الحل لو الرفض من المفتاح
            return True
        BAL_ERR.pop(scope, None)
        return False
    except Exception:
        return True

def ex_open_counts():
    """📋 v3.26.0: «الأوامر المنشورة على المنصة» — كل أمر مرة وحدة.
    كل بوت يسأل المنصة عن أوامر عملته بمفتاحه ⇒ بوتين على نفس العملة بنفس المحفظة (الدوري ويّا الشبكة/DCA) كانوا ينحسبون
    نفس الأوامر مرتين · وبوت انحذف كان رقمه يبقى. هسه: اتحاد أرقام الأوامر (ordId) للبوتات الموجودة بس → (شراء، بيع)."""
    live = {b["dir"] for b in bot_dirs().values() if not (b.get("cfg") or {}).get("is_demo")}
    ids = {"b": set(), "s": set()}
    for d, v in list(BAL.items()):
        if d not in live or not isinstance(v, dict):
            continue
        for k in ("b", "s"):
            got = v.get("oid_" + k)
            if got is None:                      # قراءة قديمة بلا أرقام (أول دقيقة بعد التحديث) ⇒ العدد مثل ما هو
                ids[k].update(f"{d}#{k}{i}" for i in range(int(v.get("o" + k) or 0)))
            else:
                ids[k].update(x for x in got if x)
    return len(ids["b"]), len(ids["s"])


def ex_orders_view():
    """📋 v3.36.10: «الأوامر المنشورة على المنصة» بالتفصيل — نفس مصدر رقم الخانة (أوامر عملة كل بوت بمفتاحه من OKX كل 30 ثانية ·
    كل أمر مرة وحدة) · كل أمر لبوته من بداية رقمه (clOrdId — نفس معادلة الرقابة: البوت نفسه · شبكة التعاوني) · اللي ما يطابق بوت = خارج البوتات.
    قراءة فقط — ولا مفتاح يطلع."""
    bots = [b for b in bot_dirs().values() if not (b.get("cfg") or {}).get("is_demo")]
    wn = {str(w.get("api") or ""): str(w.get("name") or "") for w in (app_cfg().get("wallets") or []) if w.get("api")}
    pre = {b["dir"]: _safe(_gd_bot_ids, b, default=[]) or [] for b in bots}
    seen, groups, ages = set(), {}, []
    for b in bots:
        v = BAL.get(b["dir"]) or {}
        if not isinstance(v.get("ords"), list):
            continue
        ages.append(time.time() - float(v.get("ord_t") or 0))
        wkey = str((b.get("cfg") or {}).get("api_key") or "")
        for o in v["ords"]:
            oid = str(o.get("id") or o.get("cl") or "")
            if not oid or oid in seen:
                continue
            seen.add(oid)
            cl = str(o.get("cl") or "")
            own = next((x for x in bots if str((x.get("cfg") or {}).get("api_key") or "") == wkey and x["symbol"] == o.get("sym")
                        and any(cl.startswith(p) for p in pre.get(x["dir"]) or [])), None)
            hg = bool(own and (own.get("cfg") or {}).get("bot_type") == "rec_va" and cl.startswith("HG"))
            gk = (own["dir"] if own else "~" + wkey[:6] + "|" + str(o.get("sym"))) + ("|hg" if hg else "")
            g = groups.get(gk)
            if g is None:
                bt = str(((own or {}).get("cfg") or {}).get("bot_type") or "")
                g = groups[gk] = {"name": (os.path.basename(own["dir"]) if own else "") , "sym": str(o.get("sym") or ""),
                                  "type": ("♾️ شبكة التعاوني" if hg else _PV_TYPE_ALL.get(bt or "grid", "")) if own else "",
                                  "bot": bool(own), "wallet": wn.get(wkey, ""), "orders": [], "nb": 0, "ns": 0, "usd_b": 0.0, "usd_s": 0.0}
            left = max(0.0, float(o.get("sz") or 0) - float(o.get("fill") or 0))
            val = left * float(o.get("px") or 0)
            g["orders"].append({"side": o.get("side"), "px": o.get("px"), "sz": o.get("sz"), "fill": o.get("fill"), "usd": round(val, 6),
                                "t": o.get("t"), "type": o.get("type")})
            k = "s" if o.get("side") == "sell" else "b"
            g["n" + k] += 1
            g["usd_" + k] += val
    out = []
    for g in groups.values():
        g["orders"].sort(key=lambda r: (0 if r["side"] == "sell" else 1, -float(r["px"] or 0)))
        g["usd_b"], g["usd_s"] = round(g["usd_b"], 6), round(g["usd_s"], 6)
        out.append(g)
    out.sort(key=lambda g: (not g["bot"], g["sym"], g["type"], g["name"]))
    return {"ok": True, "groups": out, "nb": sum(g["nb"] for g in out), "ns": sum(g["ns"] for g in out),
            "usd_b": round(sum(g["usd_b"] for g in out), 6), "usd_s": round(sum(g["usd_s"] for g in out), 6),
            "outside": sum(g["nb"] + g["ns"] for g in out if not g["bot"]), "age": round(max(ages), 1) if ages else None}


