           "user": "👤 أوامرك", "guard": "🛡️ الرقابة", "loss": "📉 الخسائر", "notify": "🔔 الإشعارات", "system": "⚙️ النظام"}
_JR_SECRET = ("key", "secret", "pass", "token", "pw", "pin", "chat_id")
_JR_SECRET_EXACT = {"api", "sec"}      # 🔒 v3.22.7: حقول المحافظ (api · sec · pass) — «api» و«sec» ما كانت تنحجب بالسجلات ولا بالتقرير التشخيصي


def _jr_clean(v, depth=0):
    """🔒 ولا مفتاح/كلمة سر/توكن يدخل السجل."""
    if depth > 4:
        return "…"
    if isinstance(v, dict):
        return {str(k): ("***" if (str(k).lower() in _JR_SECRET_EXACT or any(x in str(k).lower() for x in _JR_SECRET)) else _jr_clean(x, depth + 1)) for k, x in list(v.items())[:60]}
    if isinstance(v, (list, tuple)):
        return [_jr_clean(x, depth + 1) for x in list(v)[:60]]
    if isinstance(v, str):
        return v[:1500]
    if isinstance(v, (int, float, bool)) or v is None:
        return v
    return str(v)[:300]


def journal_scrub_once():
    """🔒 v3.22.7: مرة وحدة — يحجب مفاتيح محافظ انكتبت بسجلات v3.22.6 (إضافة محفظة كانت تسجّل api/sec كما هي)."""
    flag = os.path.join(JOURNAL_DIR, "_scrubbed_v3227")
    try:
        if not os.path.isdir(JOURNAL_DIR) or os.path.exists(flag):
            return 0
        n = 0
        with _JR_LOCK:
            for fn in sorted(os.listdir(JOURNAL_DIR)):
                if not fn.endswith(".jsonl"):
                    continue
                fp = os.path.join(JOURNAL_DIR, fn)
                out, ch = [], False
                with open(fp, encoding="utf-8") as f:
                    for ln in f:
                        try:
                            e = json.loads(ln)
                        except Exception:
                            out.append(ln if ln.endswith("\n") else ln + "\n")
                            continue
                        if isinstance(e, dict) and isinstance(e.get("d"), dict):
                            d2 = _jr_clean(e["d"])
                            if d2 != e["d"]:
                                e["d"] = d2; ch = True; n += 1
                        out.append(json.dumps(e, ensure_ascii=False) + "\n")
                if ch:
                    tmp = fp + ".tmp"
                    with open(tmp, "w", encoding="utf-8") as f:
                        f.writelines(out)
                    os.replace(tmp, fp)
        with open(flag, "w") as f:
            f.write(str(n))
        return n
    except Exception:
        return 0


def _jr_prune(today):
    if _JR["pruned"] == today:
        return
    _JR["pruned"] = today
    cut = (datetime.strptime(today, "%Y-%m-%d") - timedelta(days=JOURNAL_KEEP_DAYS - 1)).strftime("%Y-%m-%d")
    try:
        for fn in os.listdir(JOURNAL_DIR):
            if fn.endswith(".jsonl") and fn[:10] < cut:
                try:
                    os.remove(os.path.join(JOURNAL_DIR, fn))
                except Exception:
                    pass
    except Exception:
        pass


def journal(cat, msg, lv="info", bot="", sym="", t=None, rl=None, **data):
    """📜 سطر بالسجلات المفصّلة: {t · c (الفئة) · lv (info/ok/warn/err) · bot · sym · m (الرسالة) · d (التفاصيل)}.
    ملف لكل يوم بـHoly_Journal/ — يبقى 7 أيام وينمسح لحاله. `rl` = مفتاح يمنع تكرار نفس السطر خلال 10 دقائق."""
    try:
        now = float(t if t is not None else time.time())
        if rl:
            last = _JR["rl"].get(rl, 0)
            if now - last < 600:
                return
            _JR["rl"][rl] = now
            if len(_JR["rl"]) > 2000:
                _JR["rl"].clear()
        day = datetime.fromtimestamp(now).strftime("%Y-%m-%d")
        e = {"t": round(now, 3), "c": cat if cat in JR_CATS else "system", "lv": lv if lv in ("info", "ok", "warn", "err") else "info",
             "bot": str(bot or ""), "sym": str(sym or ""), "m": str(msg)[:2000]}
        if data:
            e["d"] = _jr_clean(data)
        line = json.dumps(e, ensure_ascii=False, separators=(",", ":"))
        with _JR_LOCK:
            os.makedirs(JOURNAL_DIR, exist_ok=True)
            _jr_prune(datetime.now().strftime("%Y-%m-%d"))
            with open(os.path.join(JOURNAL_DIR, day + ".jsonl"), "a", encoding="utf-8") as fh:
                fh.write(line + "\n")
    except Exception:
        pass


def _jr_kind(msg):
    """سطر سجل بوت ⇒ (الفئة، المستوى)."""
    m = str(msg or "")
    if ("[بيع فوري]" in m or "[ربح تعويضي]" in m or "[ربح داخلي]" in m or "🟢" in m[:3] or "[شراء]" in m or "تنفيذ شراء" in m or "إغلاق الدورة" in m
            or "دوري #" in m or m.startswith("💰 ")):                # 🔁 الدوري: أمر دوري · خروج بربح/خسارة
        return "trade", "ok"
    if "رفض" in m or "فشل" in m or "خطأ" in m or "❌" in m[:3] or "تالف" in m:
        return "bot", "err"
    if "⚠️" in m[:3] or "🔌" in m[:3] or "🪫" in m[:3] or "🩹" in m[:3] or "معلّق" in m or "⏭️" in m[:3]:
        return "bot", "warn"
    return "bot", "info"


def journal_ingest_bots():
    """🤖 سطور سجلات البوتات الجديدة ⇒ السجلات (كل سطر مرة وحدة — المؤشر بملف حتى بعد إعادة التشغيل).
    أول مرة: آخر 7 أيام من سجل كل بوت."""
    cur_p = os.path.join(JOURNAL_DIR, "_cursor.json")
    cur = load_json(cur_p) or {}
    if not isinstance(cur, dict):
        cur = {}
    first_cut = (datetime.now() - timedelta(days=JOURNAL_KEEP_DAYS - 1)).strftime("%Y-%m-%d 00:00:00")
    changed = False
    for b in bot_dirs().values():
        try:
            key = os.path.relpath(b["dir"], ROOT)
            _, hp, _ = paths_of(b)
            if not os.path.exists(hp):
                continue
            mt = os.path.getmtime(hp)
            c = cur.get(key) or {}
            if c.get("mt") == mt:
                continue
            hist = load_json(hp) or []
            if not isinstance(hist, list):
                continue
            last_t, seen = str(c.get("t") or first_cut), set(c.get("s") or [])
            new = []
            for row in hist:                                     # الأحدث أولاً
                if not isinstance(row, dict):
                    continue
                ts = str(row.get("time") or "")[:19]
                msg = str(row.get("msg") or "")
                if ts < last_t:
                    break                                        # وصلنا للي انقرا قبل
                if ts == last_t and msg in seen:
                    continue
                new.append((ts, msg))
            if new:
                for ts, msg in reversed(new):
                    try:
                        tt = datetime.strptime(ts, "%Y-%m-%d %H:%M:%S").timestamp()
                    except Exception:
                        tt = time.time()
                    cat, lv = _jr_kind(msg)
                    journal(cat, msg, lv, bot=key, sym=b.get("symbol", ""), t=tt)
                top = new[0][0]
                c = {"t": top, "s": [m for t2, m in new if t2 == top][:50] + ([x for x in seen] if top == last_t else [])[:50]}
            c["mt"] = mt
            cur[key] = c
            changed = True
        except Exception:
            continue
    if changed:
        try:
            os.makedirs(JOURNAL_DIR, exist_ok=True)
            save_json_atomic(cur_p, cur)
        except Exception:
            pass


def journal_query(cats=None, lv=None, bot=None, q=None, d_from=None, d_to=None, before=None, limit=400, after=None):
    """🔎 فلترة السجلات (الأحدث أولاً): الفئات · تنبيهات وأخطاء بس · بوت · نص · من/إلى يوم · أقدم من لحظة (للتحميل أكثر)."""
    limit = max(1, min(3000, int(limit or 400)))
    cats = set(c for c in (cats or []) if c)
    qq = str(q or "").strip().lower()
    out, counts, more, scanned = [], {k: 0 for k in JR_CATS}, False, 0
    try:
        files = sorted([f for f in os.listdir(JOURNAL_DIR) if f.endswith(".jsonl")], reverse=True)
    except Exception:
        files = []
    for fn in files:
        day = fn[:10]
        if d_from and day < d_from:
            continue
        if d_to and day > d_to:
            continue
        try:
            with open(os.path.join(JOURNAL_DIR, fn), "r", encoding="utf-8", errors="ignore") as fh:
                lines = fh.readlines()
        except Exception:
            continue
        ents = []
        for ln in lines:
            try:
                ents.append(json.loads(ln))
            except Exception:
                continue
        ents.sort(key=lambda e: e.get("t", 0), reverse=True)      # سطور سجل البوت تنكتب بوقتها الحقيقي (ممكن متأخرة) ⇒ ترتيب بالوقت
        for e in ents:
            scanned += 1
            if scanned > 400_000:
                break
            if before is not None and e.get("t", 0) >= before:
                continue
            if after is not None and e.get("t", 0) < after:
                continue
            if lv == "warn" and e.get("lv") not in ("warn", "err"):
                continue
            if lv == "err" and e.get("lv") != "err":
                continue
            if bot == "__dash":
                if e.get("bot"):
                    continue
            elif bot and e.get("bot") != bot:
                continue
            if qq and qq not in (str(e.get("m") or "") + " " + json.dumps(e.get("d") or {}, ensure_ascii=False) + " " + str(e.get("sym") or "") + " " + str(e.get("bot") or "")).lower():
                continue
            c = e.get("c") or "system"
            counts[c] = counts.get(c, 0) + 1
            if cats and c not in cats:
                continue
            if len(out) < limit:
                out.append(e)
            else:
                more = True
    days = [f[:10] for f in files]
    return {"ok": True, "items": out, "more": more, "counts": counts, "cats": JR_CATS, "days": days,
            "keep": JOURNAL_KEEP_DAYS, "bots": sorted({os.path.relpath(b["dir"], ROOT) for b in bot_dirs().values()})}


# ───────────── اكتشاف البوتات ─────────────
def bot_dirs():
    found = {}
    for cfgp in glob.glob(os.path.join(ROOT, "config_*.json")) + glob.glob(os.path.join(ROOT, "*", "config_*.json")):
        d = os.path.dirname(cfgp) or ROOT
        if os.path.basename(d).startswith("_archive"):
            continue
        cfg = load_json(cfgp)
        if isinstance(cfg, dict) and cfg.get("symbol"):
            found[d] = {"dir": d, "cfg_path": cfgp, "cfg": cfg, "symbol": cfg["symbol"]}
    return found

def paths_of(b):
    sym = b["symbol"]; base = sym.split("-")[0]
    _bt0 = b.get("cfg", {}).get("bot_type")
    state_name = (f"dca_state_{sym}.json" if _bt0 in ("dca", "dca_buy") else
                  f"rec_state_{sym}.json" if _bt0 in ("rec_buy", "rec_sell") else f"grid_state_{sym}.json")   # 🔁 v3.25.0: الدوري
    return (os.path.join(b["dir"], state_name),
            os.path.join(b["dir"], f"trade_history_{base}.json"),
            os.path.join(b["dir"], "log_main.txt"))

def is_alive(d, state_path):
    p = PROCS.get(d)
    if p is not None and p.poll() is None:
        return True, "dash"
    try:
        if time.time() - os.path.getmtime(state_path) < ALIVE_WINDOW:
            return True, "external"
    except Exception:
        pass
    try:   # 🔎 عملية يتيمة بعد إعادة تشغيل اللوحة — نشوفها بمجلد العمل
        if bot_pids(d):
            return True, "orphan"
    except Exception:
        pass
    return False, ""

PROFIT_RE = re.compile(r"(?:الربح|Profit)\s*[:：]?\s*\+\s*([0-9]+(?:\.[0-9]+)?)")

def _eng_old(b):
    try:
        _, eng_script, eng_ver = engine_for(b["cfg"])
        mp = os.path.join(b["dir"], eng_script)
        if not os.path.exists(mp):
            return False
        return _file_fp(mp) != eng_ver
    except Exception:
        return False

def _pv_sig(x):
    """🔎 سعر للعرض: فوق الواحد 6 خانات (مثل قبل) · تحته 10 أرقام معنوية (العملات الرخيصة ما تصير 0.0)."""
    return round(x, 6) if abs(x) >= 1 else float("%.10g" % x)


def pack_levels(dct, kind):
    out = []
    for v in (dct or {}).values():
        try:
            out.append({"p": _pv_sig(float(v.get("target_price", 0))),     # 🔎 تحت الواحد: أرقام معنوية (كان 6 خانات ⇒ 0.0 للرخيصة)
                        "q": round(float(v.get("locked_qty", 0)), 6), "k": kind})
        except Exception:
            pass
    return out

RI_BUY_D = ("limit_buys", "virtual_buys", "accum_buys")
RI_SELL_D = ("limit_sells", "virtual_sells", "accum_sells")

def _rung_key(st, px, g):
    """رقم الدرجة بالسلّم — نفس حساب المحرك (rung_n)."""
    try:
        base = float(st.get("ladder_base") or 0)
        px = float(px or 0)
        if base <= 0 or g <= 0 or px <= 0:
            return None
        return str(int(round(math.log(px / base) / math.log(1.0 + g))))
    except Exception:
        return None

def _inj_pending(d):
    """هل بيه طلب حقن لسه ما التقطه البوت؟"""
    try:
        return bool(d) and os.path.exists(os.path.join(d, "reinvest_inject.json"))
    except Exception:
        return False


def reinvest_snapshot(b, st):
    """🔄 المتراكم داخل الأوامر: دولار (شراء معلّق) وعملة (ماسك عملة)."""
    ri = st.get("reinvest")
    if not isinstance(ri, dict):
        # البوت ما اشتغل باللفّة بعد — نرجّع قراءة من التهيئة حتى تعكس
        # الشريحة الحالة فوراً بدل ما تظل «مطفية» والزبون يشك
        if not b["cfg"].get("reinvest"):
            return None
        return {"on": False, "cfg_on": True, "usd": 0.0, "coin": 0.0,
                "cycles": 0, "levels": 0, "days": 0.0, "rows": [], "top": [],
                "desync": [], "handoff": None, "released": None,
                "file": os.path.exists(os.path.join(b["dir"], "reinvest.py")),
                "file_old": False, "pending_boot": True}
    lv = ri.get("levels") or {}
    g = float(b["cfg"].get("grid_percentage") or 0)
    usd = float(ri.get("orphan_usd") or 0.0)
    coin = 0.0
    seen = set()
    rows = []
    for dname in RI_BUY_D + RI_SELL_D:
        issell = dname in RI_SELL_D
        for info in (st.get(dname) or {}).values():
            if not isinstance(info, dict):
                continue
            px = info.get("original_buy_anchor") if issell else info.get("target_price")
            k = _rung_key(st, px, g)
            if k is None or k not in lv or k in seen:
                continue
            seen.add(k)
            e = lv[k]
            usd += float(e.get("usd_book") or 0)
            gq = float(e.get("grown_qty") or 0)
            bq = float(e.get("base_qty") or 0)
            bk = float(e.get("usd_book") or 0)
            lpx = float(px or 0)
            _epx = float(e.get("px") or 0) or lpx          # 🧾 سعر دفتر الدرجة — نفس اللي يدفعه الإيقاف (المعروض = المدفوع)
            if gq > 0:
                if issell:
                    coin += gq
                else:
                    usd += gq * _epx
            # الصف يبقى ما دام للدرجة أمر — حتى لو فرّغتها كلياً،
            # وإلا يختفي وتضيع معه أزرار الحقن والسحب
            if True:
                _sp = (info.get("target_price") if issell
                       else info.get("original_sell_anchor")) or 0
                _io = None
                if issell and bq > 0:           # 🪙 العملة **الموجودة فعلاً** داخل أمر البيع (نفس حساب البوت: من كمية الشراء الأصلية)
                    _lk = float(info.get("locked_qty") or 0)
                    _io = round(min(gq, max(0.0, float(info.get("buy_qty") or _lk) - bq), _lk), 8)
                elif bq > 0:                    # 💵 النمو **الموجود فعلاً** داخل أمر الشراء (الباقي بالدفتر)
                    _io = round(min(gq, max(0.0, float(info.get("locked_qty") or 0) - bq)), 8)
                rows.append({"p": round(lpx, 8), "sp": round(float(_sp or 0), 8),
                             "b": round(bq, 8), "g": round(gq, 8),
                             "k": round(bk, 6), "s": "sell" if issell else "buy",
                             "v": round(gq * _epx, 6), "kk": str(k), "io": _io,
                             "j": round(min(float(e.get("inj_book") or 0)
                                            + float(e.get("inj_grown") or 0),
                                            bk + gq * _epx), 6),
                             "tv": round(bk + gq * _epx, 6),
                             "c": int(e.get("cycles") or 0),
                             "pct": round((gq / bq * 100) if bq > 0 else 0, 2)})
    for k, e in lv.items():                      # درجات يتيمة — فلوسها ما تنمحي
        if k not in seen:
            _bk = float(e.get("usd_book") or 0)
            _gq = float(e.get("grown_qty") or 0)
            _bq = float(e.get("base_qty") or 0)
            # السعر المخزَّن — نفس اللي يستعمله التحرير بالضبط، فالمعروض = المدفوع
            _px = float(e.get("px") or 0)
            _gv = _gq * _px if (_gq > 0 and _px > 0) else 0.0
            usd += _bk + _gv
            if _bk > 0 or _gq > 0:
                rows.append({"p": round(_px, 8), "sp": 0, "b": round(_bq, 8),
                             "g": round(_gq, 8), "kk": str(k),
                             "j": round(min(float(e.get("inj_book") or 0)
                                            + float(e.get("inj_grown") or 0),
                                            _bk + _gv), 6),
                             "tv": round(_bk + _gv, 6),
                             "c": int(e.get("cycles") or 0),
                             "k": round(_bk, 6), "s": "orphan", "v": round(_gv, 6),
                             "pct": round((_gq / _bq * 100) if _bq > 0 else 0, 2)})
    rows.sort(key=lambda r: -r["p"])
    # 🔍 هل الأوامر الحية بحجمها المفترض؟ (أساس + نمو)
    desync = []
    for oid, info in (st.get("limit_buys") or {}).items():
        if not isinstance(info, dict):
            continue
        k = _rung_key(st, info.get("target_price"), g)
        e = lv.get(k) if k else None
        if not e:
            continue
        want = float(e.get("base_qty") or 0) + float(e.get("grown_qty") or 0)
        got = float(info.get("locked_qty") or 0)
        if want > 0 and abs(got - want) > max(1e-9, want * 0.02):
            desync.append({"p": float(info.get("target_price") or 0),
                           "want": round(want, 8), "got": round(got, 8)})
    top = sorted([{"p": float(v.get("px") or 0), "b": float(v.get("base_qty") or 0),
                   "g": float(v.get("grown_qty") or 0),
                   "pct": round((float(v.get("grown_qty") or 0) /
                                 float(v.get("base_qty") or 1) * 100), 1)}
                  for v in lv.values() if float(v.get("grown_qty") or 0) > 0],
                 key=lambda x: -x["pct"])[:5]
    started = float(ri.get("started_ts") or 0)
    _uw = ri.get("unwind") or {}
    return {"on": bool(ri.get("on")), "desync": desync[:8], "top": top,
            "inj_total": round(float(ri.get("inj_total") or 0), 6),
            "pct": (100.0 if ri.get("pct") is None
                    else round(float(ri.get("pct") or 0), 2)),
            "pct_cfg": (100.0 if (b.get("cfg") or {}).get("reinvest_pct") is None
                        else round(float((b.get("cfg") or {}).get("reinvest_pct") or 0), 2)),
            "inj_pending": bool(_inj_pending(b.get("dir") if isinstance(b, dict) else None)),
            "unwind": [{"p": float(v.get("px") or 0),
                        "sp": round(float(v.get("px") or 0) * (1 + g), 8) if g > 0 else 0,
                        "b": float(v.get("base_qty") or 0),
                        "g": float(v.get("grown_qty") or 0),
                        "k": 0.0, "v": round(float(v.get("grown_qty") or 0)
                                             * float(v.get("px") or 0), 6),
                        "uw": True, "s": v.get("side") or "buy"}
                       for v in list(_uw.values())[:60]],
            "n_unwind": len(_uw),
            "handoff": (_ri_pending_handoffs(st, 0.0) or [None])[0], "handoff_stuck": (_ri_pending_handoffs(st, 1800.0) or [None])[0], "usd": round(usd, 4), "coin": round(coin, 8),
            "rows": rows[:300],
            "cycles": int(ri.get("cycles") or 0), "levels": len(lv),
            "days": round(max(0.0, (time.time() - started) / 86400.0), 2) if started else 0.0,
            "file": os.path.exists(os.path.join(b["dir"], "reinvest.py")),
            "file_old": (os.path.exists(os.path.join(b["dir"], "reinvest.py"))
                         and _file_fp(os.path.join(b["dir"], "reinvest.py")) != REINV_VERSION),
            "cfg_on": bool(b["cfg"].get("reinvest")),
            "released": ri.get("released")}

_FEE_CACHE = {}
FEE_TTL = 6 * 3600          # يُسحب كل 6 ساعات — المعدّل ما يتغير بسرعة

def okx_fee_rate(b):
    """🧾 معدّل العمولة الفعلي لهذا الحساب وهذا الزوج — من OKX مباشرة.

    OKX ترجّع الأرقام سالبة (مخصومة) فناخذ قيمتها المطلقة.
    المعدّل يختلف بشكل كبير حسب المنطقة ومستوى VIP وحيازة OKB —
    التخمين هنا يعني إعادة استثمار مبلغ غلط، فنسحبه بدل ما نخمّنه.
    """
    sym = b["symbol"]
    k = (b["cfg"].get("api_key") or "").strip()
    ck = f"{k[:8]}|{sym}"
    hit = _FEE_CACHE.get(ck)
    if hit and (time.time() - hit["ts"]) < FEE_TTL:
        return hit
    try:
        s = b["cfg"].get("secret_key") or ""
        p = b["cfg"].get("passphrase") or ""
        if not (k and s and p):
            return None
        r = _okx_get(f"/api/v5/account/trade-fee?instType=SPOT&instId={sym}", k, s, p)
        d = ((r or {}).get("data") or [{}])[0]
        mk, tk = abs(float(d.get("maker") or 0)), abs(float(d.get("taker") or 0))
        if not (0 < tk < 0.05) or not (0 < mk < 0.05):
            return None
        ent = {"maker": mk, "taker": tk, "ts": time.time(), "src": "okx"}
        _FEE_CACHE[ck] = ent
        # 🔁 نكتبه بتهيئة البوت حتى يستعمله reinvest.py.
        #    نستعمل **الصانع** لأن أوامر الجرد تنتظر بدفتر الأوامر فتُنفَّذ كصانع.
        try:
            if abs(float(b["cfg"].get("fee_rate") or 0) - mk) > 1e-9:
                write_cfg_keys(b["cfg_path"], {"fee_rate": round(mk, 8)})
                log_event(f"🧾 [{sym}] معدّل العمولة من OKX: صانع {mk*100:.3f}% · "
                          f"آخذ {tk*100:.3f}% — حُدّثت التهيئة")
        except Exception:
            pass
        return ent
    except Exception:
        return None

def eng_script_of(b):
    try:
        return engine_for(b["cfg"])[1]
    except Exception:
        return "main.py"

def net_factor(b):
    """📉 معامل تحويل ربح المحرك لربح صافي.

    المحرك يحسب (بيع−شراء)×كمية×0.999 — والـ0.999 تاخذ 0.1% من **الربح**،
    بينما عمولة OKX تُؤخذ من **قيمة الصفقة** بالجهتين. فنصحّح:

        المبلَّغ  = كمية × سعر × خطوة × 0.999
        الحقيقي  = كمية × سعر × (خطوة − 2×عمولة − خطوة×عمولة)

    النسبة بينهما ثابتة، فنضربها بكل رقم ربح يُعرض أو يُوزَّع.
    """
    try:
        g = float(b["cfg"].get("grid_percentage") or 0)
        f = float(b["cfg"].get("fee_rate") or FEE_RATE_DEFAULT)
        if g <= 0 or f < 0:
            return 1.0
        net = g - 2.0 * f - g * f
        if net <= 0:
            return 0.0                      # خطوة تحت التعادل — كل دورة خاسرة
        return max(0.0, min(1.0, net / (g * 0.999)))
    except Exception:
        return 1.0

_WALLET_IDS = {}

def wallet_id(b):
    """🔑 رقم المحفظة: البوتات اللي تستعمل نفس مفاتيح OKX تتقاسم نفس الرصيد.
       يُرجّع رقماً فقط — ولا حرف من المفتاح يخرج للواجهة."""
    k = (b["cfg"].get("api_key") or "").strip()
    if not k or b["cfg"].get("is_demo"):
        return None
    if k not in _WALLET_IDS:
        _WALLET_IDS[k] = len(_WALLET_IDS)
    return _WALLET_IDS[k]

def bot_snapshot(b):
    sp, hp, lp = paths_of(b)
    st = load_json(sp) or {}
    alive, src = is_alive(b["dir"], sp)
    hist = load_json(hp) or []
    today = time.strftime("%Y-%m-%d"); today_profit = 0.0; last_event = ""
    for e in hist[:400]:
        if not isinstance(e, dict):
            continue
        last_event = e.get("msg", "")[:140]
        break
    _bt = b["cfg"].get("bot_type")
    if (_bt in ("dca", "dca_buy") and st.get("cycles_log")) or _bt in ("rec_buy", "rec_sell"):   # 🔁 الدوري: نفس سجل الصفقات
        # 🧾 v3.22.1: ربح اليوم من سجل الدورات (صافي بعد العمولة) — بالشرائي دولار وبالبيعي عملة
        for c in st.get("cycles_log") or []:
            try:
                if time.strftime("%Y-%m-%d", time.localtime(float(c.get("ts") or 0))) == today:
                    today_profit += float(c.get("profit") or 0)
            except Exception:
                continue
    elif _bt in ("dca", "dca_buy"):
        # 🪙 DCA ربحه بالعملة ولا يدخل السجل — نمسح كل أحداث اليوم (لا أول 400 فقط)
        for e in hist:
            if not isinstance(e, dict):
                continue
            if str(e.get("time", "")).startswith(today):
                m = PROFIT_RE.search(e.get("msg", ""))
                if m:
                    today_profit += float(m.group(1))
            elif today_profit and not str(e.get("time", "")).startswith(today):
                break            # السجل مرتّب بالأحدث — خرجنا من اليوم
    else:
        # 💵 الجرد: نقرأ من سجل الأرباح مباشرة — دقيق ولا يتأثر بعدد الأحداث
        #    (كان يُحسب بتحليل الرسائل ضمن أول 400 حدث، فينقص بيوم التذبذب العالي)
        try:
            _led = load_json(LEDGER) or {}
            _k = os.path.relpath(b["dir"], ROOT)
            _ent = _led.get(_k) or _led.get(b["symbol"]) or {}
            today_profit = float((_ent.get("daily") or {}).get(today) or 0)
        except Exception:
            today_profit = 0.0
    # ⏱️ زمن التشغيل: من أقدم ظهور مثبّت (يبقى صحيحاً رغم تقليم ملف السجل)
    age_days = 0.0
    try:
        _fs = first_seen_of(b, hist)
        if _fs > 0:
            age_days = max(0.0, (time.time() - _fs) / 86400.0)
    except Exception:
        age_days = 0.0
    return {"dir": os.path.relpath(b["dir"], ROOT), "symbol": b["symbol"],
            "demo": bool(b["cfg"].get("is_demo")), "grid_pct": float(b["cfg"].get("grid_percentage", 0)) * 100,
            "usd_value": b["cfg"].get("usd_value", 0), "min_price": b["cfg"].get("min_price", 0),
            "forced_base": b["cfg"].get("forced_base_price", 0),
            "guard": bool(b["cfg"].get("knife_guard")), "auto": bool(b["cfg"].get("auto_restart")),
            "alive": alive, "alive_src": src, "status": st.get("status", "—"),
            "age_days": round(age_days, 2),
            "rate_daily": (round(float(st.get("total_coin_profit") or 0) / age_days, 8) if _bt in ("dca", "dca_buy")   # 🔧 v3.25.3: DCA ربحه هنا (كان +0)
                           else round((float(st.get("total_profit") or 0) * _safe(net_factor, b, default=1.0) / age_days), 4))
            if age_days >= 0.5 else None,
            "cp": float(PX.get(b["symbol"]) or st.get("current_price") or 0),
            "profit": round(float(st.get("total_profit") or 0)
                            * _safe(net_factor, b, default=1.0), 4),
            "profit_gross": round(float(st.get("total_profit") or 0), 4),
            "net_f": round(_safe(net_factor, b, default=1.0), 6),
            "today": round(today_profit, 4),
            "pause_buy": bool(st.get("pause_buy")), "pause_sell": bool(st.get("pause_sell")),
            "floor": float(st.get("buy_floor") or 0), "ceil": float(st.get("sell_ceiling") or 0),
            "n_buys": len(st.get("limit_buys") or {}), "n_sells": len(st.get("limit_sells") or {}),
            "n_vbuys": len(st.get("virtual_buys") or {}), "n_vsells": len(st.get("virtual_sells") or {}),
            "n_abuys": len(st.get("accum_buys") or {}), "n_asells": len(st.get("accum_sells") or {}),
            "accx": _safe(_accx_snap, b, st, default=None),   # 📦 v3.21.2: عدّاد الإيقاف = اللي قطعها السعر بس (يبدي من صفر)
            "abuys_usd": round(sum(float(v.get("target_price", 0)) * float(v.get("locked_qty", 0)) for v in (st.get("accum_buys") or {}).values()), 2),
            "asells_usd": round(sum(float(v.get("target_price", 0)) * float(v.get("locked_qty", 0)) for v in (st.get("accum_sells") or {}).values()), 2),
            "bal": BAL.get(b["dir"]), "launch_err": LAUNCH_ERR.get(b["dir"]), "eng_old": _eng_old(b), "last_event": last_event,
