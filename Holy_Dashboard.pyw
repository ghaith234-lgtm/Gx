    glint (v3.26.7) ⇒ data-glint + شريط ضوء يعبر الحروف (`glintInit` بالصفحة يحرّكه كل 7 ثواني) بلون السوق `--glint`."""
    pad = 4
    g = "".join(f'<path d="{d}" transform="translate({x} 0)"/>' for x, d in BRAND_WORD)
    W, H = BRAND_W + pad * 2 + (L if full else 0), BRAND_CAP + pad * 2 + (L if full else 0)
    gl, top = "", ""
    if glint:                                    # ✨ نسخة ملوّنة متوهّجة من الحروف تبين بس داخل شريط يعبر (قناع بتدرّج يتحرك) — ساكنة ⇒ ما تبين
        gl = (f'<linearGradient id="{uid}Lg" class="bglint" data-w="{BRAND_W}" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="{round(BRAND_W * .3)}" y2="0"'
              f' gradientTransform="translate({-round(BRAND_W * .45)} 0)"><stop offset="0" stop-color="#fff" stop-opacity="0"/><stop offset=".5" stop-color="#fff" stop-opacity="1"/>'
              '<stop offset="1" stop-color="#fff" stop-opacity="0"/></linearGradient>'
              f'<mask id="{uid}Lm" maskUnits="userSpaceOnUse" x="{-pad - 40}" y="{-pad - 40}" width="{W + 80}" height="{H + 80}">'
              f'<rect x="{-pad - 40}" y="{-pad - 40}" width="{W + 80}" height="{H + 80}" fill="url(#{uid}Lg)"/></mask>'
              f'<filter id="{uid}Lf" x="-5%" y="-60%" width="110%" height="220%"><feGaussianBlur stdDeviation="9" result="b"/>'
              '<feMerge><feMergeNode in="b"/><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>')
        top = f'<g mask="url(#{uid}Lm)"><use class="bglow" href="#{uid}G" filter="url(#{uid}Lf)"/></g>'
    dg = ' data-glint="1"' if glint else ""
    return (f'<svg class="{cls}"{dg} viewBox="{-pad} {-pad} {W} {H}" role="img" aria-label="The Holy Dashboard" focusable="false">'
            f'<defs><g id="{uid}G" fill="none" stroke-linejoin="round">{g}</g>{gl}</defs>'
