        <tr style="color:var(--mut2)"><td>المُراكِم</td><td>النسبة</td><td>قيد الشراء</td><td>المتراكم</td><td>العملة</td><td>كلفتها</td><td>قيمتها</td><td>ربح/خسارة</td><td>آخر شراء</td><td>الحالة</td></tr>
