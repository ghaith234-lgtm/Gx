APP_SILENT_SEC = 1800       # 📱 الموبايل يسحب كل ≤ دقيقة (والفحص الاحتياطي كل 15 دقيقة) ⇒ 30 دقيقة سكوت = النظام سكّره أو النت مقطوع
_APP_SILENT = {}


def app_dev_watch(now=None):
    """📱 v3.25.2: موبايل مربوط سكت أكثر من 30 دقيقة ⇒ سطر بالسجلات (مرة) · رجع ⇒ سطر «رجع اتصل». الإشعارات ما تضيع: تنتظره وتوصل لما يرجع."""
    now = now or time.time()
    out = []
    for d in _safe(app_devices, default=[]) or []:
        did, seen = str(d.get("id") or ""), float(d.get("seen") or 0)
        if not did or not seen:
            continue
        quiet = now - seen > APP_SILENT_SEC
        pc = str(d.get("name") or "").startswith("💻")              # 💻 v3.26.1: حاسوب مطفي = طبيعي ⇒ سطر هادئ
        if quiet and did not in _APP_SILENT and pc:
            _APP_SILENT[did] = seen
            out.append(("quiet", d))
            _safe(journal, "notify", f"💻 الحاسوب «{d.get('name')}» لم يتصل منذ {int((now - seen) / 60)} دقيقة — غالباً مطفأ أو البرنامج مغلق"
                  " (الإشعارات تنتظره وتصل عند عودته)", "ok", default=None)
        elif quiet and did not in _APP_SILENT:
            _APP_SILENT[did] = seen
            out.append(("quiet", d))
            _safe(journal, "notify", f"📱 الموبايل «{d.get('name')}» لم يتصل منذ {int((now - seen) / 60)} دقيقة — غالباً أغلق النظام Holy أو الإنترنت مقطوع"
                  " (الإشعارات تنتظره وتصل كلها عند عودته · من التطبيق: ⚙️ ⇐ 📱 ⇐ «والتطبيق مغلق»)", "warn", default=None)
        elif not quiet and did in _APP_SILENT:
            gap = seen - _APP_SILENT.pop(did)
            out.append(("back", d))
            _safe(journal, "notify", f"📱 الموبايل «{d.get('name')}» عاد للاتصال (بعد {int(max(0, gap) / 60)} دقيقة) — وصله ما فاته", "ok", default=None)
    return out


def guard_loop():
    """🛡️ يفحص كل 10 دقائق. أول فحص بعد دقيقة (حتى تحمّل الأسعار والأرصدة)."""
    time.sleep(60)
    while True:
        _safe(app_dev_watch, default=None)            # 📱 v3.25.2
        try:
            guard_scan()
        except Exception as e:
            try:
                log_event(f"⚠️ [الرقابة] فشل الفحص الدوري: {type(e).__name__}: {e}")
            except Exception:
                pass
        time.sleep(GUARD_EVERY)


def selfcheck():
    """🩺 فحص ذاتي — يمسك أي تناقض بالأرقام قبل ما يكلّفك فلوس.

    يفحص الثوابت اللي لازم تصح دائماً بكل بوت:
      · ولا خانة سالبة بدفتر إعادة الاستثمار
      · رأس المال المحقون ما يتجاوز الموجود بالدرجة
      · الحصّالة ما تتجاوز حدّ التحويل (خطوتين)
      · بنود التفكيك ما تَعِد بأكثر مما بالأمر
      · العملة المسلَّمة للمُراكِم ≤ المحرَّر فعلياً
      · كل درجة إلها سعر مخزَّن، وكل أمر بيع إلها تكلفة
    """
    out = []
    for d, b in bot_dirs().items():
        sym = b.get("symbol") or os.path.basename(d)
        try:
            sp, _, _ = paths_of(b)
            st = _safe(load_json, sp, default={}) or {}
            ri = st.get("reinvest") if isinstance(st.get("reinvest"), dict) else {}
            lv = ri.get("levels") or {}
            for k, e in lv.items():
                ub = float(e.get("usd_book") or 0)
                gq = float(e.get("grown_qty") or 0)
                ib = float(e.get("inj_book") or 0)
                ig = float(e.get("inj_grown") or 0)
                px = float(e.get("px") or 0)
                if min(ub, gq, ib, ig) < -1e-9:
                    out.append(f"🔴 {sym} الدرجة {k}: خانة سالبة")
                if px <= 0:
                    out.append(f"🟠 {sym} الدرجة {k}: بلا سعر مخزَّن")
                elif (ib + ig) > (ub + gq * px) + 1e-6:
                    out.append(f"🔴 {sym} الدرجة {k}: المحقون "
                               f"{ib+ig:.4f}$ > الموجود {ub+gq*px:.4f}$")
            for k, u in (ri.get("unwind") or {}).items():
                if float(u.get("grown_qty") or 0) < -1e-12:
                    out.append(f"🔴 {sym} تفكيك {k}: كمية سالبة")
            # 🪙 العملة المسلَّمة مقابل المحرَّر
            rel = ri.get("released") or {}
            hc = float(rel.get("coin") or 0)
            if hc > 0:
                tot_sell = 0.0
                for key in ("limit_sells", "virtual_sells", "accum_sells"):
                    for i2 in (st.get(key) or {}).values():
                        tot_sell += float(i2.get("locked_qty") or 0)
                out.append(f"ℹ️ {sym}: سُلّم للمُراكِم {hc:.8f} عملة "
                           f"· باقٍ بالأوامر {tot_sell:.8f}")
            # كل أمر بيع إلها تكلفة
            miss = 0
            for key in ("limit_sells", "virtual_sells", "accum_sells"):
                for i2 in (st.get(key) or {}).values():
                    if float(i2.get("cost_px") or i2.get("original_buy_anchor") or 0) <= 0:
                        miss += 1
            if miss:
                out.append(f"🟠 {sym}: {miss} أمر بيع بلا سعر تكلفة "
                           f"— المركز يُحسب بتقدير")
        except Exception as ex:
            out.append(f"⚠️ {sym}: تعذّر الفحص ({type(ex).__name__})")
    return out


def reconcile():
    """🧾 مطابقة شاملة — كل دولار وكل عملة، بكل الحالات.

    الهوية اللي لازم تصح دائماً:
        حقوقك = دولار محجوز بالشراء + قيمة العملة المحتجزة + عملة المُراكِم
                 + الدولار الحر بالمحفظة
    و:
        ربح التداول = المحقّق (الدفتر) + المتراكم داخل الأوامر + اللي راح للمُراكِم
    """
    out = {"bots": [], "lock_buy": 0.0, "coin_value": 0.0, "coin_cost": 0.0,
           "unreal": 0.0, "realized": 0.0, "inside": 0.0, "injected": 0.0,
           "unwind": 0.0, "handoff": 0.0,
           "acc_coin": 0.0, "acc_cost": 0.0, "acc_value": 0.0,
           "ts": time.time()}
    for d, b in bot_dirs().items():
        try:
            sp, _, _ = paths_of(b)
            st = _safe(load_json, sp, default={}) or {}
            px = float(b.get("cp") or st.get("current_price") or 0)
            pos = position_of(b, st, px)
            nfv = _safe(net_factor, b, default=1.0)
            real = float(st.get("total_profit") or 0) * nfv
            ri = st.get("reinvest") if isinstance(st.get("reinvest"), dict) else {}
            ins = inj = 0.0
            for e in (ri.get("levels") or {}).values():
                try:
                    lp = float(e.get("px") or 0)
                    ins += float(e.get("grown_qty") or 0) * lp + float(e.get("usd_book") or 0)
                    inj += float(e.get("inj_book") or 0) + float(e.get("inj_grown") or 0)
                except Exception:
                    continue
            uw = sum(max(0.0, float(v.get("grown_qty") or 0) * float(v.get("px") or 0)
                         - float(v.get("inj") or 0))
                     for v in (ri.get("unwind") or {}).values())
            # 🪙 عملة سُلّمت للمُراكِم عند الإطفاء — ربح تداول صار عملة،
            #    ما عاد يظهر بالدفتر ولا بالمتراكم. نعدّه صراحة وإلا يضيع من الحساب.
            _rl = ri.get("released") or {}
            hcost = float(ri.get("handoff_total") or 0.0)
            if hcost <= 0 and float(_rl.get("coin") or 0) > 0:   # نسخ قديمة
                hcost = float(_rl.get("coin") or 0) * float(_rl.get("avg_px") or 0)
            row = {"symbol": b["symbol"], "dir": os.path.relpath(d, ROOT), "px": px,
                   "pos": pos, "realized": round(real, 6),
                   "inside": round(max(0.0, ins - inj), 6), "injected": round(inj, 6),
                   "unwind": round(uw, 6), "handoff": round(hcost, 6),
                   "ri_on": bool(ri.get("on")),
                   "pct": (100 if (b.get("cfg") or {}).get("reinvest_pct") is None
                           else float((b.get("cfg") or {}).get("reinvest_pct")))}
            out["bots"].append(row)
            out["lock_buy"] += pos["lock_buy"]
            out["coin_value"] += pos["value"]
            out["coin_cost"] += pos["cost"]
            out["unreal"] += pos["unreal"]
            out["realized"] += real
            out["inside"] += row["inside"]
            out["injected"] += inj
            out["unwind"] += uw
            out["handoff"] += hcost
        except Exception:
            continue
    # 🪙 المُراكِمات
    try:
        for a in (app_cfg().get("accumulators") or []):
            c = float(a.get("coin") or 0)
            sp2 = float(a.get("spent") or 0)
            out["acc_coin"] += c
            out["acc_cost"] += sp2
            pxa = 0.0
            for r in out["bots"]:
                if r["symbol"] == a.get("symbol"):
                    pxa = r["px"]; break
            out["acc_value"] += c * pxa
    except Exception:
        pass
    out["equity_locked"] = round(out["lock_buy"] + out["coin_value"] + out["acc_value"], 6)
    out["acc_unreal"] = round(out["acc_value"] - out["acc_cost"], 6)
    out["trade_profit"] = round(out["realized"] + out["inside"] + out["unwind"]
                                + out["handoff"], 6)
    for k in ("lock_buy", "coin_value", "coin_cost", "unreal", "realized",
              "inside", "injected", "unwind", "handoff",
              "acc_coin", "acc_cost", "acc_value"):
        out[k] = round(out[k], 6)
    return out



# ═══════════════ 📊 ربح التداول يوم بيوم + 🖨️ التقرير المصوّر ═══════════════
_PV_TYPE = {"grid": "لانهائية", "grid_range": "مدى", "grid_plus": "بلس", "grid_step": "متدرج"}
_PV_WD = ("الاثنين", "الثلاثاء", "الأربعاء", "الخميس", "الجمعة", "السبت", "الأحد")


def _pv_cfg_txt(c):
    """⚙️ إعدادات بوت الجرد بسطر واحد (للتقرير)."""
    try:
        if str(c.get("bot_type") or "") == "rec_va":
            return _va_cfg_txt(c)                   # 💹 v3.34.0
        if str(c.get("bot_type") or "") in _REC_T:
            _u = {"h": "ساعة", "d": "يوم", "m": "شهر"}.get(c.get("unit") or "d", "يوم")
            _a = f"{float(c.get('amount') or 0):g}" + ("$" if (c.get("bot_type") == "rec_buy" or c.get("amt_usd")) else " " + str(c.get("symbol") or "").split("-")[0])
            if float(c.get("lo") or 0) or float(c.get("hi") or 0):
                _a += f" · 📏 {float(c.get('lo') or 0):g}–{float(c.get('hi') or 0) or '∞'}"
            return (f"كل {int(float(c.get('every') or 1))} {_u} {_a} · هدف {float(c.get('tp_pct') or 0):g}% · "
                    + ("بالمعدل" if c.get("mode") == "avg" else "كل أمر على حدة" + (f" · 💠 {float(c.get('ri_pct') or 0):g}%" if float(c.get("ri_pct") or 0) > 0 else "")))
        if str(c.get("bot_type") or "") in ("dca", "dca_buy"):
            return (f"أساس {float(c.get('base_order_qty') or 0):g} · {int(float(c.get('max_safety_orders') or 0))} أمان "
                    f"{float(c.get('first_deviation') or 0):g}% · هدف {float(c.get('take_profit_pct') or 0):g}%")
        g = float(c.get("grid_percentage") or 0) * 100
        if str(c.get("bot_type") or "") == "grid_step":         # 🪜 v3.36.15
            _d = float(c.get('step_sell') or 0) * 100
            _d1 = float(c.get('step_first') or c.get('step_sell') or 0) * 100
            return (f"{int(float(c.get('step_parts') or 0))} بيعات لكل شراء · "
                    + (f"البيع {_d:g}% · " if abs(_d1 - _d) < 1e-9 else f"أول بيعة {_d1:g}% · بين البيعات {_d:g}% · ")
                    + f"الشراء {g:g}% · {float(c.get('usd_value') or 0):g}$ لكل شراء")
        s = f"{g:.2f}% · {float(c.get('usd_value') or 0):g}$"
        bt = str(c.get("bot_type") or "grid")
        if bt == "grid_plus" and float(c.get("buy_offset") or 0) > 0:
            s += f" · بُعد {float(c.get('buy_offset')) * 100:.2f}%"
        if bt == "grid_range":
            lo, up = float(c.get("lower_price") or 0), float(c.get("upper_price") or 0)
            s += f" · {lo:g} ↔ {up:g}" if (lo or up) else ""
        return s
    except Exception:
        return ""


def _pv_num(x):
    try:
        return abs(float(x or 0)) > 1e-12
    except Exception:
        return False


_RI_LEGACY_K = "_ri_legacy"      # 💠 أيام قبل v3.11: الأرشيف كان يخزّن مجموع المعاد استثماره بس (مو لكل بوت)


def _ri_keyset(arcb):
    """📒 v3.22.6: البوتات اللي بيها إعادة استثمار (أرشيفها بيه 💠 · أو حالتها مستعملة · أو المحذوف كان عنده 💠) —
    الباقي ربح تداوله = ربحه المحرر **بالضبط** (نفس الدفتر) بدل أرقام السجل المقرّبة لأربع مراتب."""
    out = set()
    for k, e in (arcb or {}).items():
        if isinstance(e, dict) and any(float((v or {}).get("r") or 0) > 0 for v in (e.get("daily") or {}).values() if isinstance(v, dict)):
            out.add(k)
    for k, b in _tp_bots().items():
        rs = _safe(_ri_state_of, _safe(load_json, paths_of(b)[0], default={}) or {}, default=None)
        if rs and rs.get("used"):
            out.add(k)
    for e in (((load_json(GONE) or {}).get("bots") or {}).values()):
        if isinstance(e, dict) and e.get("key") and (float(e.get("held") or 0) > 0 or float(e.get("handoff") or 0) > 0):
            out.add(e["key"])
    return out


def _pv_per_rows(led, arcb, keys, d0, today, legacy=None, ri=None):
    """📚 v3.22.3: محرّك الأيام الوحيد — لكل بوت ولكل يوم (مباشر n · معاد r · بيعات c · الدفتر lv · المصدر).
    التقرير والشريط والإجماليات والتقرير اليومي بتيليغرام كلها منه ⇒ ما يختلفون.
    `legacy` (مجموع 💠 القديم لكل يوم): الزايد عن 💠 الموزّع على البوتات ⇒ صف «غير موزّع» (`_RI_LEGACY_K`) — ما يضيع."""
    per, first = {}, None
    for k in keys:
        le, ae = led.get(k), arcb.get(k)
        ld = (le.get("daily") or {}) if isinstance(le, dict) else {}
        ltd = (le.get("trades_daily") or {}) if isinstance(le, dict) and le.get("dca") else None   # DCA شرائي: عدد الدورات
        ltr = (le.get("rec_tr") or {}) if isinstance(le, dict) and le.get("rec") else None       # 🔁 الدوري: تداول كل يوم من دفتره
        ad = (ae.get("daily") or {}) if isinstance(ae, dict) else {}
        a0 = min(ad) if ad else None
        kd = [d for d, x in ld.items() if _pv_num(x)] + [d for d, x in ad.items() if isinstance(x, dict)]
        f0 = min(kd) if kd else None                    # أول يوم معروف للبوت (قبله ما كان موجود)
        rows, dd = {}, d0
        while dd <= today:
            ds = dd.strftime("%Y-%m-%d")
            try:
                lv = float(ld.get(ds) or 0)
            except Exception:
                lv = 0.0
            a = ad.get(ds)
            if ltr is not None:                                     # 🔁 الدوري: المحرر من كل صفقة n + المعاد استثماره r (السحب تحويل ⇒ بالمحرر lv بس)
                x = ltr.get(ds) or {}
                n, r, c, s = float(x.get("n") or 0), float(x.get("r") or 0), int(x.get("c") or 0), "a"
            elif ltd is not None:
                n, r, c, s = lv, 0.0, int(ltd.get(ds) or 0), "a"   # 💵 DCA شرائي: الدفتر هو المصدر (صافي لكل دورة) · العدد = الدورات
            elif ri is not None and k not in ri:                    # 📒 v3.22.6: بلا إعادة استثمار ⇒ التداول = المحرر بالضبط (الدفتر)
                n, r = max(0.0, lv), 0.0
                c, s = (int(a.get("c") or 0), "a") if isinstance(a, dict) else (int((le.get("trades_daily") or {}).get(ds) or 0) if isinstance(le, dict) else 0, "a")
            elif isinstance(a, dict):
                n, r, c, s = float(a.get("n") or 0), float(a.get("r") or 0), int(a.get("c") or 0), "a"
            elif a0 is None or ds < a0:
                n, r, c, s = max(0.0, lv), 0.0, None, "l"       # قبل ما يبدي الأرشيف: الدفتر
            else:
                n, r, c, s = 0.0, 0.0, 0, "a"                     # الأرشيف شغّال وماكو بيعات هاليوم
            if n > 1e-12 or r > 1e-12 or abs(lv) > 1e-12 or c or (s == "l" and a0 and f0 and f0 <= ds):
                rows[ds] = (n, r, c, lv, s)                     # ↑ قبل أرشيفه ودفتره صفر = مو معروف (يمكن انعاد استثماره) — مو «صفر»
                if first is None or ds < first:
                    first = ds
            dd += timedelta(days=1)
        per[k] = rows
    if isinstance(legacy, dict) and legacy:
        rows, dd = {}, d0
        while dd <= today:
            ds = dd.strftime("%Y-%m-%d")
            try:
                ex = float(legacy.get(ds) or 0) - sum(x[ds][1] for x in per.values() if ds in x)
            except Exception:
                ex = 0.0
            if ex > 1e-6:
                rows[ds] = (0.0, ex, 0, 0.0, "a")
                if first is None or ds < first:
                    first = ds
            dd += timedelta(days=1)
        if rows:
            per[_RI_LEGACY_K] = rows
    return per, first


def _arc_live(arcb, days=20):
    """💠 الأرشيف لكل بوت + آخر البيعات من سجل صفقات البوتات الحية (دمج بالأكبر — نفس قاعدة `reinvest_tick` بلا كتابة)
    ⇒ أرقام اليوم طازجة بكل مكان حتى بين نبضات الأرشيف (كل ~5 دقائق)."""
    out = dict(arcb or {})
    for key, b in _tp_bots().items():
        live = _safe(_hist_day_parts, b, days, default={}) or {}
        if not live:
            continue
        e = dict(out.get(key) or {})
        dd = dict(e.get("daily") or {})
        for d, v in live.items():
            c_ = dd.get(d) or {}
            dd[d] = {"n": round(max(float(c_.get("n") or 0), v["n"]), 6), "r": round(max(float(c_.get("r") or 0), v["r"]), 6),
                     "c": max(int(c_.get("c") or 0), int(v["c"]))}
        e["daily"] = dd
        e.setdefault("symbol", b["symbol"])
        out[key] = e
    return out


def profit_view(days=30, tick=True, start_hint=None, end=None):
    """📊 ربح التداول **بيوم ما انكسب** (مو يوم ما انحرر) — لكل بوت جرد ولكل يوم.

    المصدر: أرشيف إعادة الاستثمار (بيعة بيعة من سجل كل بوت، يتحدّث كل ~5 دقائق ويعيش أشهر):
      مباشر n (نزل للربح المحرر بيومه) + معاد استثماره r (دخل الأوامر) + بيعات c.
    يوم قبل ما يبدي أرشيف البوت ⇒ الدفتر (وقتها الربح المحرر = المكسوب).
    تحرير إعادة الاستثمار والسحب **تحويلات مو أرباح**: انعدّت يوم ما انكسبت، فما تنعد مرة ثانية.
    الدفتر (المحرر) يرجع ويا كل يوم للمطابقة. يبدأ من أول يوم بيه ربح لو البوتات أصغر من المدة.
    أكثر من 62 يوم ⇒ أسابيع · أكثر من 200 ⇒ أشهر (حتى يبقى الرسم مقروء)."""
    try:
        days = max(1, min(400, int(days or 30)))
    except Exception:
        days = 30
    if tick:
        _safe(reinvest_tick, default=None)              # 🔄 آخر البيعات (دمج بالأكبر — آمن ويا الحلقة)
    led = load_json(LEDGER) or {}
    arc0 = load_json(RI_LEDGER) or {}
    arcb = (arc0.get("bots") or {}) if isinstance(arc0, dict) else {}
    legacy = (arc0.get("daily") or {}) if isinstance(arc0, dict) else {}
    if not isinstance(led, dict):
        led = {}
    if not isinstance(arcb, dict):
        arcb = {}
    arcb = _arc_live(arcb)
    meta = {}
    for b in bot_dirs().values():
        c0 = b.get("cfg") or {}
        if c0.get("is_demo") or c0.get("bot_type") == "dca":
            continue
        if c0.get("bot_type") == "rec_sell" and os.path.relpath(b["dir"], ROOT) not in led:
            continue                                   # 🔁 الدوري البيعي ربحه عملة — يطلع هنا بس لو حرّر دولار (سحب)
        meta[os.path.relpath(b["dir"], ROOT)] = {"sym": str(b.get("symbol") or c0.get("symbol") or ""),
                                                "type": str(c0.get("bot_type") or "grid"), "cfg": c0}
    _gone_t = {}
    for _e in (((load_json(GONE) or {}).get("bots") or {}).values()):
        if isinstance(_e, dict) and _e.get("key"):
            _gone_t[_e["key"]] = str(_e.get("type") or "grid")
    keys = set(meta)
    for src in (led, arcb):
        for k, v in src.items():
            if isinstance(v, dict) and not str(k).startswith("_"):
                keys.add(str(k))
    today = end or datetime.now().date()               # 📅 v3.36.12: نهاية الفترة (الشهر السابق ينتهي بآخر يوم بيه)
    today_s = today.strftime("%Y-%m-%d")
    d0 = today - timedelta(days=days - 1)
    per, first = _pv_per_rows(led, arcb, keys, d0, today, legacy, _ri_keyset(arcb))
    if _RI_LEGACY_K in per:
        keys.add(_RI_LEGACY_K)
    start = datetime.strptime(first, "%Y-%m-%d").date() if first else today
    if start < d0:
        start = d0
    try:                                                # 🖨️ v3.30.0: التقرير يبدي من أول يوم بيه أي ربح (مُراكِم · عملة) حتى لو قبل أول ربح بوت
        _sh = datetime.strptime(start_hint, "%Y-%m-%d").date() if start_hint else None
        if _sh and d0 <= _sh < start:
            start = _sh
    except Exception:
        pass
    dl, dd = [], start
    while dd <= today:
        dl.append(dd.strftime("%Y-%m-%d"))
        dd += timedelta(days=1)
    span = len(dl)
    bk = "day" if span <= 62 else ("week" if span <= 200 else "month")

    def _sym(k):
        m = meta.get(k)
        if m and m.get("sym"):
            return m["sym"]
        for src in (led, arcb):
            e = src.get(k)
            if isinstance(e, dict) and e.get("symbol"):
                return str(e["symbol"])
        return str(k)
    syms = {k: _sym(k) for k in keys}
    bases = {k: (syms[k].split("-")[0] or k).upper() for k in keys}

    def _typ(k):
        if k in meta:
            return meta[k]["type"]
        if k in _gone_t:
            return _gone_t[k]
        le0 = led.get(k)
        if isinstance(le0, dict) and le0.get("rec") and le0.get("type"):
            return str(le0["type"])
        return "dca_buy" if isinstance(le0, dict) and le0.get("dca") else "grid"
    types = {k: _typ(k) for k in keys}
    if _RI_LEGACY_K in types:
        types[_RI_LEGACY_K] = "ri_legacy"                       # بلا اسم نوع (مو بوت)
    dup = {b0 for b0 in bases.values() if list(bases.values()).count(b0) > 1}
    dup2 = {(bases[k], types[k]) for k in keys if sum(1 for j in keys if bases[j] == bases[k] and types[j] == types[k]) > 1}
    # 🏷️ v3.22.2: بوتين بنفس العملة ⇒ يتميّزون بالنوع (لانهائية · مدى · بلس · DCA شرائي) · ونفس النوع كمان ⇒ + المجلد
    names = {k: (bases[k] + (" · " + _PV_TYPE_ALL.get(types[k], "جرد") if bases[k] in dup else "")
                 + (" · " + k if (bases[k], types[k]) in dup2 else "")) + ("" if k in meta else " (محذوف)") for k in keys}
    if _RI_LEGACY_K in names:
        names[_RI_LEGACY_K] = "💠 غير موزّع على عملة (قبل v3.11)"

    bots, dayt = [], {ds: 0.0 for ds in dl}
    for k in keys:
        rows = per[k]
        n = r = lv = 0.0
        c, cu, act, best = 0, False, 0, None
        for ds in dl:
            x = rows.get(ds)
            if not x:
                continue
            n += x[0]
            r += x[1]
            lv += x[3]
            if x[2] is None:
                cu = True
            else:
                c += x[2]
            t1 = x[0] + x[1]
            dayt[ds] += t1
            if t1 > 1e-12:
                act += 1
                if best is None or t1 > best[1]:
                    best = (ds, t1)
        if k not in meta and abs(n + r) <= 1e-12 and abs(lv) <= 1e-12:
            continue                                            # بوت محذوف وماكو شي بالفترة (السالب ينعرض ⇒ مجموع الصفوف = الإجمالي)
        m = meta.get(k) or {}
        bots.append({"k": k, "sym": syms[k], "name": names[k], "type": types[k],
                     "tl": _PV_TYPE_ALL.get(types[k], ""), "live": k in meta,
                     "cfg_txt": _pv_cfg_txt(m.get("cfg") or {}) if m else "",
                     "t": round(n + r, 6), "n": round(n, 6), "r": round(r, 6), "c": c, "cu": cu,
                     "led": round(lv, 6), "act": act,
                     "avg": round((n + r) / span, 6) if span else 0.0,
                     "best": {"d": best[0], "v": round(best[1], 6)} if best else None})
    pos = sorted([b for b in bots if b["t"] > 1e-9], key=lambda x: (-x["t"], x["k"]))
    top = pos[:5]
    for i, b in enumerate(sorted(top, key=lambda x: x["k"])):   # 🎨 لون البوت يتبعه هو، مو ترتيبه
        b["slot"] = i
    for b in bots:
        b.setdefault("slot", -1)
    oth = [b for b in pos if b["slot"] < 0]
    bots.sort(key=lambda x: (-x["t"], x["k"]))

    def _bkey(ds):
        if bk == "day":
            return ds
        if bk == "week":
            dt = datetime.strptime(ds, "%Y-%m-%d").date()
            return (start + timedelta(days=((dt - start).days // 7) * 7)).strftime("%Y-%m-%d")
        return ds[:7]
    B, order = {}, []
    for ds in dl:
        kb = _bkey(ds)
        if kb not in B:
            B[kb] = {"d": ds, "d2": ds, "n": 0.0, "r": 0.0, "c": 0, "cu": False, "led": 0.0, "by": {}, "src": set(), "lk": set()}
            order.append(kb)
        e = B[kb]
        e["d2"] = ds
        for k in keys:
            x = per[k].get(ds)
            if not x:
                continue
            e["n"] += x[0]
            e["r"] += x[1]
            e["led"] += x[3]
            e["src"].add(x[4])
            if x[2] is None:
                e["cu"] = True
            else:
                e["c"] += x[2]
            t1 = x[0] + x[1]
            if t1 > 1e-12:
                e["by"][k] = e["by"].get(k, 0.0) + t1
            if x[4] == "l":
                e["lk"].add(k)                                  # 📒 رقم هذا البوت بهذا اليوم من الدفتر (قبل أرشيفه)
    out_days = []
    for kb in order:
        e = B[kb]
        dt = datetime.strptime(e["d"], "%Y-%m-%d").date()
        dt2 = datetime.strptime(e["d2"], "%Y-%m-%d").date()
        if bk == "day":
            lbl, full = f"{dt.day}/{dt.month}", f"{_PV_WD[dt.weekday()]} {dt.day}/{dt.month}/{dt.year}"
        elif bk == "week":
            lbl, full = f"{dt.day}/{dt.month}", f"{dt.day}/{dt.month} إلى {dt2.day}/{dt2.month}/{dt2.year}"
        else:
            lbl, full = f"{dt.month}/{str(dt.year)[2:]}", f"{dt.month}/{dt.year}"
        out_days.append({"d": e["d"], "d2": e["d2"], "lbl": lbl, "full": full,
                         "n": round(e["n"], 6), "r": round(e["r"], 6), "t": round(e["n"] + e["r"], 6),
                         "c": e["c"], "cu": e["cu"], "led": round(e["led"], 6), "src": "".join(sorted(e["src"])), "lk": sorted(e["lk"]),
                         "by": [{"k": k, "t": round(v2, 6)} for k, v2 in sorted(e["by"].items(), key=lambda kv: -kv[1])]})
    tn = sum(b["n"] for b in bots)
    tr = sum(b["r"] for b in bots)
    tt = tn + tr
    bd = max(dl, key=lambda ds: dayt[ds]) if dl else None
    bdt = datetime.strptime(bd, "%Y-%m-%d").date() if bd else None
    tot = {"t": round(tt, 6), "n": round(tn, 6), "r": round(tr, 6), "c": sum(b["c"] for b in bots),
           "cu": any(b["cu"] for b in bots), "led": round(sum(b["led"] for b in bots), 6),
           "active": sum(1 for ds in dl if dayt[ds] > 1e-12), "span": span,
           "avg": round(tt / span, 6) if span else 0.0,
           "r_pct": round(tr / tt * 100, 2) if tt > 1e-12 else 0.0,
           "best": ({"d": bd, "v": round(dayt[bd], 6), "full": f"{_PV_WD[bdt.weekday()]} {bdt.day}/{bdt.month}/{bdt.year}"}
                    if bd and dayt[bd] > 1e-12 else None),
           "other": round(sum(b["t"] for b in oth), 6), "n_other": len(oth)}
    tot["coins"] = {kk: vv["t"] for kk, vv in (_safe(coins_period, dl[0] if dl else today_s, today_s, default={}) or {}).items()}
    tot["ctrade"] = (_safe(coin_trade_period, d0.strftime("%Y-%m-%d"), today_s, default={}) or {}).get("coins") or {}   # 🪙 v3.30.0: كل المدة المطلوبة
    return {"ok": True, "from": dl[0] if dl else today_s, "to": today_s, "span": span, "req": days, "bucket": bk,
            "days": out_days, "bots": bots, "tot": tot, "ts": time.time()}


# 🎨 ألوان الورق (مفحوصة بأداة عمى الألوان على الأبيض — التباين الأقل من 3:1 مغطّى بالقيم المكتوبة جنب كل لون)
_REP_C = {"d": "#0891b2", "r": "#7c3aed", "bots": ("#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#e87ba4"),
          "other": "#b4b2a9", "ink": "#1a1530", "ink2": "#4a4560", "mut": "#8a879a", "grid": "#ebe9f2", "base": "#cfcbdc"}


def _rep_step(x):
    if not x or x <= 0:
        return 1.0
    e = 10 ** math.floor(math.log10(x))
    f = x / e
    return (1 if f <= 1 else 2 if f <= 2 else 5 if f <= 5 else 10) * e


def _rep_rtop(x, y, w, h, rad):
    """مستطيل رأسه مدوّر 4px وقاعدته مربعة (نهاية البيانات بس)."""
    rad = max(0.0, min(rad, w / 2, h))
    return (f"M{x:.2f},{y + h:.2f}V{y + rad:.2f}Q{x:.2f},{y:.2f} {x + rad:.2f},{y:.2f}"
            f"H{x + w - rad:.2f}Q{x + w:.2f},{y:.2f} {x + w:.2f},{y + rad:.2f}V{y + h:.2f}Z")


def _rep_bars_svg(v, C=_REP_C, W=1000, H=300, fs=13, fm=14, nl=10, cls="wide"):
    """📊 أعمدة ربح التداول (مباشر تحت · معاد استثماره فوق) — SVG ثابت بلا جافاسكربت (يطبع مضبوط)."""
    days = v.get("days") or []
    if not days or not any(d["t"] > 0 for d in days):
        return '<p class="empty">لا يوجد ربح تداول مسجّل في الفترة.</p>'
    L, R, T, B = int(fs * 4), int(fs * 1.7), int(fm * 1.9), int(fs * 2.3)   # R: آخر تاريخ ما ينقص عند الحافة
    pw, ph = W - L - R, H - T - B
    N = len(days)
    band = pw / N
    bw = min(24.0, max(2.0, band * 0.68))
    mx = max(d["t"] for d in days)
    st = _rep_step(mx / 4)
    top = max(st, math.ceil(mx / st - 1e-9) * st)
    dp = 0 if st >= 1 else (2 if st >= 0.01 else 4)
    y = lambda val: T + ph - (val / top) * ph
    o = [f'<svg viewBox="0 0 {W} {H}" class="bars {cls}" role="img" aria-label="ربح التداول لكل يوم" style="direction:ltr">']
    for i in range(int(round(top / st)) + 1):
        yy = y(i * st)
        o.append(f'<line x1="{L}" x2="{W - R}" y1="{yy:.1f}" y2="{yy:.1f}" stroke="{C["base"] if i == 0 else C["grid"]}" stroke-width="1"/>'
                 f'<text x="{L - 8}" y="{yy + fs * 0.35:.1f}" text-anchor="end" class="ax" font-size="{fs}">{i * st:.{dp}f}</text>')
    k = max(1, math.ceil(N / nl))
    mi = max(range(N), key=lambda i: days[i]["t"])
    for i, d in enumerate(days):
        x = L + i * band + (band - bw) / 2
        base = T + ph
        hn = d["n"] / top * ph
        hr = d["r"] / top * ph
        if d["n"] > 0 and hn < 1:
            hn = 1.0
        if d["r"] > 0 and hr < 1:
            hr = 1.0
        if hn > 0:
            if hr > 0:
                o.append(f'<rect x="{x:.2f}" y="{base - hn:.2f}" width="{bw:.2f}" height="{hn:.2f}" fill="{C["d"]}"/>')
            else:
                o.append(f'<path d="{_rep_rtop(x, base - hn, bw, hn, 4)}" fill="{C["d"]}"/>')
        if hr > 0:
            gap = 2 if (hn > 0 and hr > 2) else 0          # 2px فراغ بين الجزئين — من الجزء الفوقاني (الطول الكلي صادق)
            o.append(f'<path d="{_rep_rtop(x, base - hn - hr, bw, hr - gap, 4)}" fill="{C["r"]}"/>')
        if (N - 1 - i) % k == 0:
            o.append(f'<text x="{x + bw / 2:.1f}" y="{H - fs * 0.7:.1f}" text-anchor="middle" class="ax" font-size="{fs}">{d["lbl"]}</text>')
    dm = days[mi]
    o.append(f'<text x="{L + mi * band + band / 2:.1f}" y="{y(dm["t"]) - fm * 0.5:.1f}" text-anchor="middle" class="mx" font-size="{fm}">{dm["t"]:.2f}$</text>')
    o.append("</svg>")
    return "".join(o)


def _rep_arc(cx, cy, r0, r1, a0, a1):
    p = lambda rr, a: (cx + rr * math.sin(a), cy - rr * math.cos(a))
    lg = 1 if (a1 - a0) > math.pi else 0
    x0, y0 = p(r1, a0)
    x1, y1 = p(r1, a1)
    x2, y2 = p(r0, a1)
    x3, y3 = p(r0, a0)
    return f"M{x0:.2f},{y0:.2f}A{r1},{r1} 0 {lg} 1 {x1:.2f},{y1:.2f}L{x2:.2f},{y2:.2f}A{r0},{r0} 0 {lg} 0 {x3:.2f},{y3:.2f}Z"


def _rep_segs(v, C=_REP_C):
    """شرائح الدائري: أكبر 5 بوتات (كل واحد بلونه الثابت) + «غيرها» رمادي — ≤ 6 شرائح."""
    segs = [{"name": b["name"], "tl": b["tl"], "t": b["t"], "c": b["c"], "cu": b["cu"], "col": C["bots"][b["slot"]], "k": b["k"]}
            for b in sorted((v.get("bots") or []), key=lambda x: -x["t"]) if b["slot"] >= 0 and b["t"] > 1e-9]
    T = v.get("tot") or {}
    if float(T.get("other") or 0) > 1e-9:
        segs.append({"name": f"غيرها ({T.get('n_other')})", "tl": "", "t": float(T["other"]), "c": None, "cu": False,
                     "col": C["other"], "k": ""})
    return segs


def _rep_donut_svg(v, C=_REP_C, S=230):
    segs = _rep_segs(v, C)
    tot = sum(s["t"] for s in segs)
    if tot <= 1e-12:
        return ""
    c, r1, r0 = S / 2, S / 2 - 6, S / 2 - 38
    gap = 2 / ((r0 + r1) / 2) if len(segs) > 1 else 0
    o = [f'<svg viewBox="0 0 {S} {S}" class="donut" role="img" aria-label="حصة كل بوت من ربح التداول">']
    a = 0.0
    for s in segs:
        da = s["t"] / tot * 2 * math.pi
        if len(segs) == 1:
            o.append(f'<circle cx="{c}" cy="{c}" r="{(r0 + r1) / 2}" fill="none" stroke="{s["col"]}" stroke-width="{r1 - r0}"/>')
        elif da > gap:
            o.append(f'<path d="{_rep_arc(c, c, r0, r1, a + gap / 2, a + da - gap / 2)}" fill="{s["col"]}"/>')
        a += da
    o.append(f'<text x="{c}" y="{c + 2}" text-anchor="middle" class="c1">{tot:.2f}$</text>'
             f'<text x="{c}" y="{c + 22}" text-anchor="middle" class="c2">ربح التداول</text></svg>')
    return "".join(o)


