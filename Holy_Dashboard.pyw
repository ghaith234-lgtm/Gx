def _rec_ledger_book(b, st, led, now_t):
    """💵 الدفتر اليومي للدوري — كل حدث مرة وحدة بمعرّفه وبيومه الحقيقي (حتى لو اللوحة كانت طافية وقته):
    الشرائي: الجزء المحرر من ربح كل صفقة (صافي بعد العمولة · الخسارة تنقص) ⇒ المحرر · وتداول اليوم (`rec_tr`) = المحرر + المعاد استثماره.
    الاثنين: دولار «سحب المعاد استثماره» ⇒ المحرر بس (تحويل — انحسب ربح تداول يوم صفقته)."""
    key = os.path.relpath(b["dir"], ROOT)
    bt = b["cfg"].get("bot_type")
    ent = led.get(key) if isinstance(led.get(key), dict) else None
    seen = list((ent or {}).get("rec_seen") or [])
    sset = set(seen)
    new = []
    if bt in _REC_USD:
        for c in (st.get("cycles_log") or []):
            cid = str(c.get("id") or "")
            if cid and ("c:" + cid) not in sset:
                new.append(("c", cid, c))
    for r in (st.get("releases") or []):
        rid = str(r.get("id") or "")
        if rid and ("w:" + rid) not in sset:
            new.append(("w", rid, r))
    _w = _gd_wid(b["cfg"].get("api_key")) if str(b["cfg"].get("api_key") or "").strip() else ""
    if not new:
        if ent is not None and _w and ent.get("w") != _w:
            ent["w"] = _w
            return True
        return False
    if ent is None:
        ent = {"symbol": b["symbol"], "rec": True, "type": bt, "daily": {}, "monthly": {}, "trades_daily": {}, "hourly": {},
               "rec_seen": [], "rec_tr": {}}
    ent["rec"], ent["type"] = True, bt
    ent.setdefault("symbol", b["symbol"])
    if _w:
        ent["w"] = _w
    daily = ent.setdefault("daily", {})
    tr = ent.setdefault("rec_tr", {})
    tdl = ent.setdefault("trades_daily", {})
    for kind, eid, x in new:
        try:
            day = datetime.fromtimestamp(float(x.get("ts") or now_t)).strftime("%Y-%m-%d")
        except Exception:
            day = datetime.now().strftime("%Y-%m-%d")
        if kind == "c":
            try:
                rel, ri, pv = float(x.get("rel") or 0), float(x.get("ri") or 0), float(x.get("profit") or 0)
            except Exception:
                rel = ri = pv = 0.0
            daily[day] = round(float(daily.get(day, 0.0)) + rel, 6)
            t = tr.setdefault(day, {"n": 0.0, "r": 0.0, "c": 0})
            t["n"] = round(float(t.get("n") or 0) + rel, 8)
            t["r"] = round(float(t.get("r") or 0) + ri, 8)
            t["c"] = int(t.get("c") or 0) + 1
            tdl[day] = int(tdl.get(day, 0)) + 1
            journal("profit", (("♾️ مسار القيمة — ربح الشبكة #" if x.get("grid") else "💹 مسار القيمة — بيعة #") if bt == "rec_va" else "💵 دوري شرائي — صفقة #")
                    + f"{x.get('n', '?')}: ربح {pv:+.4f}$ صافي (محرر {rel:+.4f}$"
                    + (f" · 💠 {ri:.4f}$ معاد استثماره" if ri > 0 else "") + f") — يوم {day}", "ok", bot=key, sym=b["symbol"],
                    cycle=eid, day=day, profit=pv, rel=rel, ri=ri, manual=bool(x.get("manual")))
        else:
            usd = float(x.get("usd") or 0)
            if usd > 1e-12:
                daily[day] = round(float(daily.get(day, 0.0)) + usd, 6)
                journal("profit", f"💠 دوري — سحب الربح المعاد استثماره: {usd:+.4f}$ محرر (تحويل — حُسب ربحه يوم صفقته) — يوم {day}", "ok",
                        bot=key, sym=b["symbol"], release=eid, day=day, usd=usd)
        seen.append(kind + ":" + eid)
    ent["rec_seen"] = seen[-3000:]          # البوت يحتفظ بآخر 400 صفقة و200 سحب ⇒ كل معرّف بحالته يبقى معلّم
    led[key] = ent
    return True


def _rec_range(cfg, st):
    """📏 نطاق الأوامر الدورية (أدنى، أعلى): من الكرت (الحالة) وإلا من الإنشاء · صفر = بلا حد — نفس المحرك"""
    out = []
    for k in ("lo", "hi"):
        v = (st or {}).get(k)
        if v is None:
            v = (cfg or {}).get(k)
        try:
            out.append(max(0.0, float(v or 0)))
        except Exception:
            out.append(0.0)
    return out[0], out[1]


def _rec_snapshot(b, st):
    """🔁 بيانات كرت الدوري: كل أمر مفتوح بحسبته (الهدف · لو طلع هسه) أو المعدل · المستثمر وحد الأمان · 💠 داخل البوت · الموعد الجاي"""
    if str((b.get("cfg") or {}).get("bot_type") or "") == "rec_va":
        return _va_snapshot(b, st)                  # 💹 v3.34.0: مسار القيمة
    cfg = b["cfg"]
    sell = cfg.get("bot_type") == "rec_sell"
    base = str(b["symbol"]).split("-")[0]
    cp = float(PX.get(b["symbol"]) or st.get("px") or 0)
    try:
        tp = max(float(cfg.get("tp_pct") or 0), 0.2) / 100.0
    except Exception:
        tp = 0.002
    try:                                     # 💸 v3.25.1: عمولة حسابك المتعلّمة من التنفيذ (المحرك يكتبها) — وإلا 0.1%
        F = float(st.get("fee_rate") or 0)
    except Exception:
        F = 0.0
    if not 0 < F < 0.01:
        F = REC_FEE
    usd_amt = (not sell) or bool(cfg.get("amt_usd"))

    def tgt_of(q, c):
        if q <= 0 or c <= 0:
            return 0.0
        return c * (1 + tp) / (q * (1 - F)) if not sell else c * (1 - F) / (q * (1 + tp))

    def pl_of(q, c):                         # لو طلع هسه بأمر سوقي (عمولة الآخذ) — شرائي دولار · بيعي عملة
        if cp <= 0 or q <= 0 or c <= 0:
            return None
        return q * cp * (1 - F) - c if not sell else c * (1 - F) / cp - q

    def dist_of(t):
        if cp <= 0 or t <= 0:
            return None
        return round((t / cp - 1) * 100, 3) if not sell else round((1 - t / cp) * 100, 3)

    rows, Q, C, RI = [], 0.0, 0.0, 0.0
    for l in (st.get("lots") or []):
        if not isinstance(l, dict):
            continue
        try:
            q, c, ri, px = float(l.get("q") or 0), float(l.get("c") or 0), float(l.get("ri") or 0), float(l.get("px") or 0)
        except Exception:
            continue
        Q += q; C += c; RI += ri
        t, pl = tgt_of(q, c), pl_of(q, c)
        bv = q if sell else c
        rows.append({"id": str(l.get("id")), "n": int(l.get("n") or 0), "ts": float(l.get("ts") or 0), "px": _pv_sig(px),
                     "q": round(q, 8), "c": round(c, 6), "ri": round(ri, 10), "tgt": _pv_sig(t),
                     "pl": round(pl, 8) if pl is not None else None,
                     "plp": round(pl / bv * 100, 3) if pl is not None and bv > 0 else None,
                     "dist": dist_of(t), "x": bool(l.get("x")), "why": str(l.get("why") or "")})
    avg = None
    if rows:
        t, pl = tgt_of(Q, C), pl_of(Q, C)
        bv = Q if sell else C
        avg = {"q": round(Q, 8), "c": round(C, 6), "px": _pv_sig(C / Q) if Q > 0 else 0, "tgt": _pv_sig(t),
               "pl": round(pl, 8) if pl is not None else None, "plp": round(pl / bv * 100, 3) if pl is not None and bv > 0 else None,
               "dist": dist_of(t)}
    today = time.strftime("%Y-%m-%d")
    tday = 0.0
    for c in (st.get("cycles_log") or []):
        try:
            if time.strftime("%Y-%m-%d", time.localtime(float(c.get("ts") or 0))) == today:
                tday += float(c.get("profit") or 0)
        except Exception:
            continue
    cl = st.get("close") if isinstance(st.get("close"), dict) else None
    try:
        hb_age = round(time.time() - float(st.get("hb") or 0), 1) if st.get("hb") else None
    except Exception:
        hb_age = None
    evs = []
    for e in (st.get("events") or [])[-6:]:
        if isinstance(e, dict):
            evs.append({k: e.get(k) for k in ("k", "ts", "n", "px", "q", "c", "ri", "profit", "pct", "why", "manual", "usd", "coin", "lots")})
    lc = st.get("last_cycle") if isinstance(st.get("last_cycle"), dict) else None
    lo, hi = _rec_range(cfg, st)
    fees = {str(k): round(float(v or 0), 12) for k, v in (st.get("fees") or {}).items() if float(v or 0) > 0}
    fee_usd = sum(v if k in ("USDT", "USDC", "USD") else (v * cp if k == base else 0.0) for k, v in fees.items())
    pdx = st.get("pending") if isinstance(st.get("pending"), dict) else None
    return {"lo": lo, "hi": hi, "in_range": not ((lo > 0 and cp > 0 and cp < lo) or (hi > 0 and cp > hi)),
            "fees": fees, "fee_usd": round(fee_usd, 6), "fee_other": [k for k in fees if k not in ("USDT", "USDC", "USD", base)],
            "fee_rate": round(F * 100, 4), "amt_usd": usd_amt, "unsure": bool(pdx and not pdx.get("oid")),
            "dust": round(float(st.get("dust") or 0), 12),
            "side": "sell" if sell else "buy", "mode": "avg" if cfg.get("mode") == "avg" else "lots", "base": base,
            "unit": base if sell else "USDT", "amount": float(cfg.get("amount") or 0), "every": int(float(cfg.get("every") or 1)),
            "per": cfg.get("unit") or "d", "at": cfg.get("at") or "", "tp": round(tp * 100, 4), "cap": float(cfg.get("cap") or 0),
            "ri_pct": _rec_ri_pct(cfg, st), "paused": bool(st.get("paused")), "next_at": float(st.get("next_at") or 0),
            "hb_age": hb_age, "lots": sorted(rows, key=lambda r: r["n"]), "avg": avg,
            "expo": round(C if usd_amt else Q, 8), "expo_usd": round(C if usd_amt else Q * cp, 4),
            "pot": round(float(st.get("pot") or 0), 10), "held": round(_rec_held(st), 10), "held_lots": round(RI, 10),
            "profit": round(float(st.get("profit_total") or 0), 10), "rel": round(float(st.get("rel_total") or 0), 10),
            "ri_total": round(float(st.get("ri_total") or 0), 10), "wd_usd": round(float(st.get("wd_usd") or 0), 8),
            "wd_coin": round(float(st.get("wd_coin") or 0), 10), "cycles": int(st.get("cycles") or 0),
            "orders": int(st.get("orders") or 0), "skips": int(st.get("skips") or 0), "today": round(tday, 10),
            "closing": ({"ids": list(cl.get("ids") or []), "manual": bool(cl.get("manual")),
                         "part": round(float(cl.get("dq") or 0) / float(cl.get("Q") or 1), 4) if not sell else
                         round(float(cl.get("dv") or 0) / float(cl.get("C") or 1), 4)} if cl else None),
            "pending": bool(st.get("pending")), "rq": {"sell": bool(st.get("rq_sell")), "wd": bool(st.get("rq_withdraw")), "now": bool(st.get("rq_now"))},
            "last": ({k: lc.get(k) for k in ("n", "ts", "profit", "manual", "lots")} if lc else None),
            "ev": evs, "fee": F * 100, "cp": cp}


def _rec_control(b, sp, action, value):
    """🔁 أزرار الدوري — اللوحة تكتب **حقل طلب بس** بملف الحالة والمحرك ينفّذ (ولا أمر يطلع من اللوحة نفسها)"""
    if str((b.get("cfg") or {}).get("bot_type") or "") == "rec_va":
        return _va_control(b, sp, action, value)    # 💹 v3.34.0: مسار القيمة
    st = load_json(sp) or {}
    cfg = b["cfg"]
    sell = cfg.get("bot_type") == "rec_sell"
    alive = is_alive(b["dir"], sp)[0]

    def put(upd):
        if not save_state_keys(sp, upd):
            return False
        return True
    if action in ("rec_pause", "rec_resume"):
        on = action == "rec_pause"
        if not put({"paused": on}):
            return {"ok": False, "msg": "تعذّرت الكتابة في ملف البوت — أعد المحاولة بعد ثانية"}
        return {"ok": True, "msg": (f"⏸ توقّف الأمر الدوري — لا {'يبيع' if sell else 'يشتري'} في المواعيد · الأهداف والخروج اليدوي تعمل كالمعتاد"
                                    if on else f"▶️ عاد الأمر الدوري — أول {'بيع' if sell else 'شراء'} في الموعد القادم")}
    if action == "rec_ri":
        if str(cfg.get("mode") or "lots") == "avg":
            return {"ok": False, "msg": "⚖️ إعادة الاستثمار للنوع «كل أمر على حدة» فقط — لا للمعدّل"}
        try:
            v = float(value)
        except Exception:
            return {"ok": False, "msg": "اكتب نسبة من 0 إلى 100"}
        if not (0 <= v <= 100):
            return {"ok": False, "msg": "اكتب نسبة من 0 إلى 100"}
        if not put({"ri_pct": round(v, 4)}):
            return {"ok": False, "msg": "تعذّرت الكتابة في ملف البوت — أعد المحاولة بعد ثانية"}
        u = "عملة" if sell else "دولار"
        return {"ok": True, "msg": (f"⚖️ {v:g}% من ربح كل صفقة يعود فيُضاف إلى الأمر القادم (يبقى داخل البوت — يمكنك سحبه) · الباقي محرر {u}"
                                    if v > 0 else f"⚖️ أُوقفت إعادة الاستثمار — ربح كل صفقة يتحرر {u} (ما داخل البوت يبقى حتى تسحبه)")}
    if action == "rec_range":
        v = value if isinstance(value, dict) else {}
        try:
            lo, hi = max(0.0, float(v.get("lo") or 0)), max(0.0, float(v.get("hi") or 0))
        except Exception:
            return {"ok": False, "msg": "اكتب أسعار صحيحة (0 = بلا حد)"}
        if not all(x == x and x != float("inf") for x in (lo, hi)):
            return {"ok": False, "msg": "اكتب أسعار صحيحة (0 = بلا حد)"}
        if lo > 0 and hi > 0 and lo >= hi:
            return {"ok": False, "msg": "الحد الأدنى يجب أن يكون أصغر من الأعلى"}
        if not put({"lo": lo, "hi": hi}):
            return {"ok": False, "msg": "تعذّرت الكتابة في ملف البوت — أعد المحاولة بعد ثانية"}
        act = "يبيع" if sell else "يشتري"
        if not lo and not hi:
            return {"ok": True, "msg": f"📏 أُزيل النطاق — {act} في كل موعد مهما كان السعر"}
        return {"ok": True, "msg": f"📏 حُفظ النطاق — {act} في الموعد فقط حين يكون السعر بين {lo:g} و {hi:g}".replace(" 0 ", " — ")
                + " · خارج النطاق يتخطّى الموعد ويبلّغك · الخروج بالهدف لا يتأثر"}
    if not alive:
        return {"ok": False, "msg": "البوت متوقف — شغّله أولاً (الطلب ينفّذه المحرك نفسه)"}
    if action == "rec_sell":
        if st.get("rq_sell"):
            return {"ok": False, "msg": "⏳ طلب الخروج السابق لم يُطبَّق بعد — ثوانٍ"}
        if st.get("close"):
            return {"ok": False, "msg": "⏳ يوجد خروج قيد التنفيذ الآن — انتظر حتى ينتهي"}
        open_ids = [str(l.get("id")) for l in (st.get("lots") or []) if isinstance(l, dict) and not l.get("x")]
        if not open_ids:
            return {"ok": False, "msg": "لا توجد أوامر مفتوحة للخروج"}
        ids = "all"
        if str(cfg.get("mode") or "lots") != "avg" and value not in (None, "", "all"):
            want = value.get("ids") if isinstance(value, dict) else value
            want = [str(x) for x in (want if isinstance(want, list) else [want])]
            if want != ["all"]:
                ids = [x for x in want if x in open_ids]
                if not ids:
                    return {"ok": False, "msg": "هذا الأمر غير مفتوح (هل بِيع؟) — حدّث الصفحة"}
        if not put({"rq_sell": {"ids": ids, "ts": time.time()}}):
            return {"ok": False, "msg": "تعذّرت الكتابة في ملف البوت — أعد المحاولة بعد ثانية"}
        what = "الكل" if ids == "all" else ("الأمر " + ", ".join("#" + x.lstrip("L") for x in ids))
        return {"ok": True, "msg": f"✋ كُتب الخروج ({what}) — البوت {'يعود للشراء' if sell else 'يبيع'} خلال ثوانٍ بسعر السوق"}
    if action == "rec_withdraw":
        if st.get("rq_withdraw"):
            return {"ok": False, "msg": "⏳ طلب السحب السابق لم يُطبَّق بعد — ثوانٍ"}
        if _rec_held(st) <= 1e-12:
            return {"ok": False, "msg": "💠 لا يوجد ربح معاد استثماره داخل البوت للسحب"}
        if not put({"rq_withdraw": time.time()}):
            return {"ok": False, "msg": "تعذّرت الكتابة في ملف البوت — أعد المحاولة بعد ثانية"}
        return {"ok": True, "msg": "💠 سُجّل السحب — يُحرَّر الربح المعاد استثماره خلال ثوانٍ: " + (
            "الحصّالة بالدولار + حصته من الأوامر المفتوحة بالعملة (تذهب إلى المُراكِم/المحفظة)" if not sell else
            "الحصّالة بالعملة + حصته من الأوامر المفتوحة بالدولار")}
    if action == "rec_now":
        if st.get("rq_now"):
            return {"ok": False, "msg": "⏳ الطلب السابق لم يُطبَّق بعد — ثوانٍ"}
        if not put({"rq_now": time.time()}):
            return {"ok": False, "msg": "تعذّرت الكتابة في ملف البوت — أعد المحاولة بعد ثانية"}
        return {"ok": True, "msg": f"{'🏷️ يبيع' if sell else '🛒 يشتري'} الآن بمبلغ أمره (خارج الجدول — لا يتغيّر الموعد القادم) · يبقى حد الأمان حاكماً"}
    return {"ok": False, "msg": "أمر غير معروف للبوت الدوري"}


def _rec_tg_load():
    if _REC_TG["d"] is None:
        d = _safe(load_json, REC_TG_FILE, default=None)
        _REC_TG["d"] = d if isinstance(d, dict) else {}
    return _REC_TG["d"]


def _rec_evn(e):
    try:
        return int(str(e.get("id") or "").rsplit("-E", 1)[1])
    except Exception:
        return 0


def _rec_msg(b, st, e):
    """📨 نص تيليغرام لحدث واحد — قصير وواضح (والتطبيق ياخذ منه «ربح الصفقة»)"""
    if str((b.get("cfg") or {}).get("bot_type") or "") == "rec_va":
        return _va_msg(b, st, e)                    # 💹 v3.34.0: مسار القيمة (بالفصحى)
    cfg = b["cfg"]
    sym = b["symbol"]
    sell = cfg.get("bot_type") == "rec_sell"
    base = sym.split("-")[0]
    u = f" {base}" if sell else "$"
    k = e.get("k")
    SEP = "━━━━━━━━━━━━━"
    lots = [l for l in (st.get("lots") or []) if isinstance(l, dict)]
    usd_amt = (not sell) or bool(cfg.get("amt_usd"))
    expo = sum(float(l.get("c" if usd_amt else "q") or 0) for l in lots)
    cap = float(cfg.get("cap") or 0)
    ue = "$" if usd_amt else u
    nx = float(st.get("next_at") or 0)
    nxt = datetime.fromtimestamp(nx).strftime("%Y-%m-%d %H:%M") if nx else "—"
    if k == "open":
        q, c, ri, px = float(e.get("q") or 0), float(e.get("c") or 0), float(e.get("ri") or 0), float(e.get("px") or 0)
        head = f"🏷️ *بيع دوري #{e.get('n')} — `{sym}`*" if sell else f"🛒 *شراء دوري #{e.get('n')} — `{sym}`*"
        line = (f"🔴 باع `{q:.8g}` {base} ⇐ `{c:.4f}$` بسعر `{px:.8g}`" if sell else
                f"🟢 اشترى `{q:.8g}` {base} بـ `{c:.4f}$` بسعر `{px:.8g}`")
        _fe = float(e.get("fee") or 0)
        return (head + "\n" + SEP + "\n" + line + "\n"
                + (f"💠 منها `{ri:.8g}`{u} ربح معاد استثماره\n" if ri > 1e-12 else "")
                + (f"💸 العمولة: `{_fe:.8g}` {e.get('fc') or ''}\n" if _fe > 0 else "")
                + f"📦 المفتوح: `{len(lots)}` أمر · `{expo:.6g}`{ue}" + (f" من حد `{cap:g}`{ue}" if cap > 0 else "") + "\n"
                + f"⏰ الموعد القادم: {nxt}")
    if k == "close":
        p, pc = float(e.get("profit") or 0), float(e.get("pct") or 0)
        ri, rel = float(e.get("ri") or 0), float(e.get("rel") or 0)
        ids = list(e.get("lots") or [])
        avg = cfg.get("mode") == "avg"
        what = (f"📊 الكل ({len(ids)} أمر)" if avg and len(ids) > 1 else "🧩 " + ("الأمر " if len(ids) == 1 else "الأوامر ")
                + ", ".join("#" + str(i).lstrip("L") for i in ids))
        head = (f"💰 *{'أعاد الشراء' if sell else 'بيع دوري'} — `{sym}`* " + ("✨" if p >= 0 else "⚠️"))
        return (head + "\n" + SEP + "\n" + what + "\n"
                + f"💎 ربح الصفقة: `{p:+.8g}`{u} ({pc:+.2f}%)" + (" · ✋ يدوي" if e.get("manual") else "") + "\n"
                + (f"⚖️ `{ri:.8g}`{u} للأمر القادم (داخل البوت) · محرر `{rel:+.8g}`{u}\n" if ri > 1e-12 else "")
                + SEP + "\n"
                + f"📊 الإجمالي: `{float(st.get('profit_total') or 0):.8g}`{u} · {int(st.get('cycles') or 0)} صفقة")
    if k == "skip":
        why = e.get("why")
        act = "البيع" if sell else "الشراء"
        if why == "range":
            lo_, hi_ = float(e.get("lo") or 0), float(e.get("hi") or 0)
            return (f"📏 *تخطّى {act} الدوري — `{sym}`*\nالسعر `{float(e.get('px') or 0):.8g}` خارج النطاق"
                    f" (`{lo_:.8g}` ← `{hi_:.8g}`)".replace("`0` ← ", "— ← ").replace(" ← `0`", " ← —") + f"\n⏰ الموعد القادم: {nxt}")
        if why == "cap":
            return (f"⏭️ *تخطّى {act} الدوري — `{sym}`*\nبلغ حد الأمان (`{float(e.get('expo') or 0):.6g}`{ue} من `{float(e.get('cap') or 0):g}`{ue})"
                    f" · يعود حين يُباع أمر\n⏰ الموعد القادم: {nxt}")
        if why == "balance":
            return (f"⚠️ *تخطّى {act} الدوري — `{sym}`*\nالرصيد لا يكفي (`{float(e.get('need') or 0):.8g}`{u}) — لم يحدث شيء ويكمل في الموعد القادم\n"
                    f"⏰ الموعد القادم: {nxt}")
        if why == "min":
            return f"⚠️ *تخطّى {act} الدوري — `{sym}`*\nالكمية تحت حد OKX — كبّر مبلغ الأمر\n⏰ الموعد القادم: {nxt}"
        return f"⚠️ *تخطّى {act} الدوري — `{sym}`*\nالمنصة رفضت الأمر (رمز `{e.get('code')}`) — السبب بسجل البوت\n⏰ الموعد القادم: {nxt}"
    if k == "withdraw":
        usd, coin = float(e.get("usd") or 0), float(e.get("coin") or 0)
        parts = [x for x in ((f"`{usd:.4f}$`" if usd > 1e-12 else ""), (f"`{coin:.8g}` {base}" if coin > 1e-12 else "")) if x]
        return (f"💠 *سحب الربح المعاد استثماره — `{sym}`*\nمحرر: " + " + ".join(parts)
                + ("\n🪙 العملة للمُراكِم (إذا كان مفعّلاً على العملة والمحفظة نفسيهما) وإلا تبقى في المحفظة" if coin > 1e-12 else ""))
    return ""


def _rec_notify(b, st):
    """📨 إشعار الدوري من أحداث حالته: كل حدث مرة وحدة (المؤشر محفوظ بملف) · أول مرة يشوف البوت ⇒ آخر 10 دقائق بس · أقصى 6 رسائل بالجولة"""
    key = os.path.relpath(b["dir"], ROOT) + "|" + str(b["cfg"].get("bot_id") or "")
    evs = [e for e in (st.get("events") or []) if isinstance(e, dict)]
    top = max([_rec_evn(e) for e in evs] + [int(st.get("ev_n") or 0)])
    with _REC_TG_LOCK:
        d = _rec_tg_load()
        last = d.get(key)
        now = time.time()
        if last is None:
            olds = [_rec_evn(e) for e in evs if now - float(e.get("ts") or 0) > 600]
            last = max(olds) if olds else 0
        last = int(last)
        if top < last:                        # الحالة انمسحت/انعاد بناؤها ⇒ نبدي من رقمها
            d[key] = top
            _safe(save_json_atomic, REC_TG_FILE, d, default=None)
            return
        new = sorted([e for e in evs if _rec_evn(e) > last], key=_rec_evn)
        if not new and d.get(key) == last:
            return
        sent = more = 0
        for e in new:
            txt = _safe(_rec_msg, b, st, e, default="")
            if not txt:
                continue                      # 🔕 v3.36.12: حدث صامت (تبديل الشبكة ⇄ المسار …) — لا رسالة ولا «أحداث أخرى»
            if sent >= 6:
                more += 1
                continue
            tg_send(txt)
            sent += 1
        if more:
            tg_send((f"💹 *`{b['symbol']}`* — و `{more}` أحداث أخرى ببوت مسار القيمة (التفاصيل بسجل البوت)" if _is_va(b) else
                     f"🔁 *`{b['symbol']}`* — و `{more}` حدث آخر في البوت الدوري (التفاصيل في سجل البوت)"))
        d[key] = max([last] + [_rec_evn(e) for e in new])
        _safe(save_json_atomic, REC_TG_FILE, d, default=None)


# ═══════════ 💹 v3.34.0: بوت «مسار القيمة» (Value Averaging) — فرد من عائلة الدوري بالجدول (ربحه دولار) · 📉📈 v3.35.0: بالنسبة + 📋 الجدول · 👆 v3.35.1: البيع من أي مستوى · 🗑 v3.35.2: الحذف يخيّرك (بيع العملات أو إبقاؤها) ═══════════
#   المحرك (vpath.py) يتداول وحده؛ اللوحة تقرأ حالته (rec_state_) وتكتب حقول طلب فقط — لا أمر يخرج من اللوحة نفسها.
#   القاعدة: هدف لقيمة العملة التي يحملها البوت (يبدأ بمبلغ ويكبر مبلغاً كل خطوة — أو ثابت) · الفرق يُشترى أو يُباع.
#   المركز سطر «P» بقائمة الأوامر (كلفة العملة المحمولة) · كل بيعة بسجل الدورات بربحها المحقق (موجب أو سالب)
#   ⇒ نفس طريق الدوري الشرائي: سجل اليوم · الدفتر · ربح التداول · المحرر · صندوق الربح ⇒ المُراكِمات · الخسائر · التقارير.
VA_FEE = 0.001
_VA_SET = ("step_usd", "band_pct", "max_order", "cap", "floor_on", "brake_pct", "drop_pct", "rise_pct", "guard_on", "guard_pct",
           "hg_usd", "hg_pct", "hg_ri", "hg_ri_pct", "hg_wallet")
_VA_SPEC_ASKED = set()


def _is_va(b):
    return str(((b or {}).get("cfg") or {}).get("bot_type") or "") == "rec_va"


def _va_p(cfg, st, k, d=0.0):
    """إعداد البوت كما يقرؤه المحرك: من الكرت («set_*» بالحالة) وإلا من الإنشاء"""
    v = (st or {}).get("set_" + k)
    if v is None:
        v = (cfg or {}).get(k)
    if k in ("floor_on", "guard_on", "hg_ri", "hg_wallet"):
        return bool(d if v is None else v)
    try:
        v = float(d if v is None or v == "" else v)
    except Exception:
        return float(d)
    return v if v == v and abs(v) != float("inf") else float(d)


def _va_gd(cfg, st):
    """🛡️ v3.36.5: (الحماية تعمل؟ مسافة إعادة الشراء ككسر) — نفس المحرك: بالنسبة = نسبة النزول · بالوقت = نسبة الحماية (5% افتراضياً)"""
    if not _va_p(cfg, st, "guard_on", False):
        return False, 0.0
    if _va_pm(cfg):
        return True, min(90.0, max(0.0, _va_p(cfg, st, "drop_pct", 5.0))) / 100.0
    return True, min(50.0, max(0.5, _va_p(cfg, st, "guard_pct", 5.0))) / 100.0


def _va_hg(cfg, st):
    """♾️×💹 v3.36.6: إعدادات التعاوني (الحماية + الشبكة فوق سعر التشغيل) — (درجة %، دولار الأمر، إعادة الاستثمار، نسبتها) أو None — نفس المحرك"""
    if not _va_gd(cfg, st)[0]:
        return None
    g, u = _va_p(cfg, st, "hg_pct", 0.0), _va_p(cfg, st, "hg_usd", 0.0)
    if g <= 0 or u <= 0:
        return None
    return min(20.0, max(0.1, g)), u, bool(_va_p(cfg, st, "hg_ri", False)), min(100.0, max(0.0, _va_p(cfg, st, "hg_ri_pct", 100.0)))


def _va_hg_nf(g):
    """📉 معامل ربح الشبكة الصافي (نفس `net_factor` لبوت الإنفنتي) — g ككسر"""
    try:
        f = FEE_RATE_DEFAULT
        net = g - 2.0 * f - g * f
        return 1.0 if g <= 0 else (0.0 if net <= 0 else max(0.0, min(1.0, net / (g * 0.999))))
    except Exception:
        return 1.0


def _va_hg_grid(b):
    """أوامر الشبكة الحية وذاكرتها من ملف حالتها بمجلدها (قراءة فقط) — للكرت"""
    st = load_json(os.path.join(b["dir"], "grid", f"grid_state_{b['symbol']}.json")) or {}
    rows = lambda k: [[float(v.get("target_price") or 0), float(v.get("locked_qty") or 0)] for v in (st.get(k) or {}).values() if isinstance(v, dict)]
    return {"sells": sorted(rows("limit_sells"))[:6], "buys": sorted(rows("limit_buys"), reverse=True)[:6],
            "mem": sum(len(st.get(k) or {}) for k in ("virtual_buys", "virtual_sells", "accum_buys", "accum_sells")),
            "paused": bool(float(st.get("buy_floor") or 0) or float(st.get("sell_ceiling") or 0) or st.get("pause_buy") or st.get("pause_sell"))}


def _va_p0(st, ref=0.0):
    """سعر البداية كما يقرؤه المحرك: المحفوظ · وإلا سعر أول خطوة بسجلها · وإلا السعر الآن (بوت جديد أو قديم)"""
    st = st or {}
    try:
        v = float(st.get("p0") or 0)
    except Exception:
        v = 0.0
    if v > 0 and int(st.get("n_step") or 0) > 0:
        return v
    if int(st.get("n_step") or 0) > 0:
        f = next((x for x in (st.get("steps_log") or []) if isinstance(x, dict) and int(x.get("k") or 0) == 1), None)
        try:
            v = float((f or {}).get("px") or 0)
        except Exception:
            v = 0.0
        if v > 0:
            return v
    return float(ref or 0)


def _va_pos(st):
    """(العملة التي يحملها البوت، كلفتها بالدولار)"""
    for l in (st or {}).get("lots") or []:
        if isinstance(l, dict) and l.get("id") == "P":
            try:
                return max(0.0, float(l.get("q") or 0)), max(0.0, float(l.get("c") or 0))
            except Exception:
                return 0.0, 0.0
    return 0.0, 0.0


def _va_next_tgt(cfg, st):
    """هدف الخطوة القادمة — نفس معادلة المحرك"""
    if int((st or {}).get("n_step") or 0) <= 0 or (st or {}).get("tgt") is None:
        return max(0.0, _va_p(cfg, st, "start_usd"))
    return max(0.0, float(st.get("tgt") or 0) + max(0.0, _va_p(cfg, st, "step_usd")))


def _va_cfg_txt(c, st=None):
    """⚙️ إعدادات بوت مسار القيمة بسطر واحد (للتقرير والكرت)"""
    h = (c.get("unit") or "d") == "h"
    n = int(float(c.get("every") or 1))
    per = ("كل " + ("ساعة" if h else "يوم") if n == 1 else "كل " + ("ساعتين" if h else "يومين") if n == 2
           else f"كل {n} " + (("ساعات" if h else "أيام") if n <= 10 else ("ساعة" if h else "يوماً")))
    step, start = _va_p(c, st, "step_usd"), _va_p(c, st, "start_usd")
    if _va_pm(c):                                            # 📉📈 v3.35.0: بالنسبة (بلا وقت)
        dd = _va_p(c, st, "drop_pct", 5.0)
        uu = _va_p(c, st, "rise_pct", dd)
        head = (f"قيمة ثابتة {start:g}$" if step <= 0 else f"هدف يبدأ {start:g}$ ويكبر {step:g}$ مع كل مستوى نزول")
        per = f"يشتري كل نزول {dd:g}% · يبيع كل صعود {uu:g}%"
        return (f"{head} · {per} · أقصى أمر {_va_p(c, st, 'max_order'):g}$ · ميزانية {_va_p(c, st, 'cap'):g}$"
                + (" · البيع فوق الكلفة" if _va_p(c, st, "floor_on", True) else "")
                + (f" · مكابح {_va_p(c, st, 'brake_pct'):g}%" if _va_p(c, st, "brake_pct") > 0 else "") + _va_gd_txt(c, st))
    head = (f"قيمة ثابتة {start:g}$" if step <= 0 else f"هدف يبدأ {start:g}$ ويكبر {step:g}$")
    return (f"{head} · {per} · نطاق {_va_p(c, st, 'band_pct', 2):g}% · أقصى أمر {_va_p(c, st, 'max_order'):g}$ · ميزانية {_va_p(c, st, 'cap'):g}$"
            + (" · البيع فوق الكلفة" if _va_p(c, st, "floor_on", True) else "")
            + (f" · مكابح {_va_p(c, st, 'brake_pct'):g}%" if _va_p(c, st, "brake_pct") > 0 else "") + _va_gd_txt(c, st))


def _va_gd_txt(c, st=None):
    h = _va_hg(c, st)
    w0 = " · 👛 أول طلب من المحفظة" if str((c or {}).get("first_src") or "") == "wallet" else ""     # 👛 v3.36.11
    if h:
        return (f" · ♾️×💹 تعاوني: فوق سعر التشغيل شبكة لانهائية (درجة {h[0]:g}% · {h[1]:g}$ للأمر"
                + (f" · إعادة استثمار {h[3]:g}%" if h[2] else "")
                + (" · تبيع من عملات المحفظة أيضاً" if _va_p(c, st, "hg_wallet", False) else "") + ")" + w0)
    on, dist = _va_gd(c, st)
    return (f" · 🛡️ لا شراء فوق سعر البداية (يعيد شراء ما باعه أوطى بـ{dist * 100:g}%)" if on else "") + w0


def _va_pm(cfg):
    """📉📈 v3.35.0: البوت يخطو بالنسبة (نزول X% / صعود Y% عن آخر خطوة) بدل الوقت"""
    return str((cfg or {}).get("trigger") or "time") == "price"


def _va_next_line(cfg, st):
    """سطر «الخطوة القادمة» للرسائل: موعد (بالوقت) أو سعرا المستويين القادمين (بالنسبة)"""
    st = st or {}
    if _va_pm(cfg):
        try:
            a = float(st.get("anchor") or 0)
        except Exception:
            a = 0.0
        if a <= 0:
            return "📉📈 الخطوة القادمة: عند التشغيل بالسعر الحالي"
        dd = _va_p(cfg, st, "drop_pct", 5.0)
        uu = _va_p(cfg, st, "rise_pct", dd)
        return f"📉 الشراء القادم عند `{a * (1 - dd / 100):.8g}` · 📈 البيع القادم عند `{a * (1 + uu / 100):.8g}`"
    nx = float(st.get("next_at") or 0)
    return "⏰ الخطوة القادمة: " + (datetime.fromtimestamp(nx).strftime("%Y-%m-%d %H:%M") if nx else "—")


def _va_sim_step(T, p, Q, C, band_abs, mo, cap, floor_on, F, mn=0.0, lot=0.0):
    """خطوة واحدة بنفس قواعد المحرك بالضبط ⇒ (الفعل، دولار الأمر، عملة الأمر، الكمية بعده، الكلفة بعده، ربح البيعة)
    الشراء: الفرق ⇐ أقصى أمر ⇐ ما بقي من الميزانية ⇐ بالسنت · العمولة من العملة · البيع: الفائض بسعر الشراء بالدفتر · العمولة من الدولار ·
    «البيع فوق الكلفة»: لا بيع تحت (الكلفة للعملة × 1.001 ÷ (1 − العمولة)) · أقل أمر: 1$ أو أقل كمية بالمنصة (mn) أيهما أكبر ·
    v3.35.1: كمية البيع تنزل لوحدة العملة بالمنصة (lot) مثل المحرك (`fmt_qty`) — وبلا وحدة معروفة 8 خانات"""
    gap = T - Q * p
    if abs(gap) <= max(band_abs, 0.01):
        return "hold", 0.0, 0.0, Q, C, 0.0
    if gap > 0:
        amt = gap
        if mo > 0:
            amt = min(amt, mo)
        if cap > 0:
            amt = min(amt, cap - C)
        amt = math.floor(max(0.0, amt) * 100 + 1e-9) / 100
        mnu = max(1.0, mn * p)
        if cap > 0 and cap - C < mnu:
            return "cap", 0.0, 0.0, Q, C, 0.0
        if amt < mnu:
            return "small", 0.0, 0.0, Q, C, 0.0
        q = amt / p * (1 - F)
        return "buy", amt, q, Q + q, C + amt, 0.0
    q = min(-gap / p, Q)
    if lot > 0:
        q = round(math.floor(q / lot + 1e-9) * lot, max(0, -int(math.floor(math.log10(lot) + 1e-9))) + 2)
    else:
        q = math.floor(q * 1e8 + 1e-6) / 1e8
    if q <= 0 or q * p < 1.0 or (mn > 0 and q < mn):
        return "small", 0.0, 0.0, Q, C, 0.0
    if floor_on and Q > 0 and C > 0 and p < (C / Q) * 1.001 / (1 - F):
        return "floor", 0.0, 0.0, Q, C, 0.0
    usd = q * p * (1 - F)
    cost = C * q / Q if Q > 0 else 0.0
    return "sell", usd, q, Q - q, C - cost, usd - cost


def va_plan(cfg, st=None, px=0.0, down=40, up=12, mn=0.0, keep=0, lot=0.0, at=0):
    """📋 v3.35.0: جدول مسار القيمة — نفس خطوات المحرك بالضبط على مسار أسعار محدد:
      📉📈 بالنسبة: مستويات الشبكة نفسها (كل نزول X% وكل صعود Y% عن آخر خطوة) ⇒ ما سيفعله البوت حرفياً عند كل سعر
      ⏱️ بالوقت: سيناريو «خطوة بكل موعد والسعر يتحرك النطاق + 1% كل مرة» ⇒ تقريبي (البوت الحقيقي يتبع سعر الموعد)
    st = حالة البوت الحية (الجدول يبدأ من مركزه الآن ويتحدّث معه) أو None لبوت جديد يبدأ بالسعر px · mn = أقل كمية بالمنصة · lot = وحدة الكمية ·
    المكابح لا تُحسب (تعتمد على الوقت) · 👆 v3.35.1: at = رقم مستوى بجدول النزول ⇒ «up_at» = جدول الصعود لو اشترى البوت لحد ذاك المستوى ثم صعد ·
    ♾️×💹 v3.36.6 التعاوني: تحت سعر التشغيل جدول المسار نفسه · فوقه سلّم الشبكة اللانهائية من سعر التشغيل (`hg`)
    بكل سطر «res» = النتيجة لو بعت كل العملة هنا (المحقق بهذا المسار + قيمة العملة بعد عمولة البيع − كلفتها) — سالبها خسارة ورقية"""
    st = st or {}
    _hgc = _va_hg(cfg, st)
    if _hgc is not None and not (cfg or {}).get("_hg_inner"):
        return _va_plan_hg(cfg, st, px, down, up, mn, keep, lot, at, _hgc)
    try:
        F = float(st.get("fee_rate") or 0)
    except Exception:
        F = 0.0
    if not 0 < F < 0.01:
        F = VA_FEE
    pm = _va_pm(cfg)
    start, S = max(0.0, _va_p(cfg, st, "start_usd")), max(0.0, _va_p(cfg, st, "step_usd"))
    mo, cap, fl = max(0.0, _va_p(cfg, st, "max_order")), max(0.0, _va_p(cfg, st, "cap")), _va_p(cfg, st, "floor_on", True)
    bp = max(0.0, _va_p(cfg, st, "band_pct", 2.0))
    if pm:
        d = min(90.0, max(0.0, _va_p(cfg, st, "drop_pct", 5.0))) / 100.0
        u = max(0.0, _va_p(cfg, st, "rise_pct", d * 100)) / 100.0
    else:
        d = u = min(90.0, bp + 1.0) / 100.0
    Q, C = _va_pos(st)
    n = int(st.get("n_step") or 0)
    lvl = int(st.get("lvl") or 0)
    gd, gdist = _va_gd(cfg, st)                              # 🛡️ v3.36.5: الحماية فوق سعر البداية
    try:
        anchor = float(st.get("anchor") or 0)
    except Exception:
        anchor = 0.0
    tgt = float(st["tgt"]) if st.get("tgt") is not None else None
    try:
        ref = float(px or st.get("px") or 0)
    except Exception:
        ref = 0.0
    if ref <= 0 or start <= 0 or d <= 0:
        return {"ok": False, "msg": "السعر أو الإعدادات غير متوفرة"}
    p0 = _va_p0(st, ref) if gd else 0.0
    tk0 = []
    if gd:
        for t in (st.get("rb") or []):
            try:
                tk0.append([float(t["px"]), float(t["q"]), float(t.get("sp") or 0)])
            except Exception:
                continue
    first = None
    if n <= 0 or (pm and anchor <= 0):                       # بوت جديد (أو بعد «بيع الكل»): أول خطوة بالسعر الآن
        a, x, q, Q, C, pr = _va_sim_step(start, ref, Q, C, 0.0 if pm else bp / 100 * start, mo, cap, fl, F, mn)
        first = {"px": ref, "tgt": start, "act": a, "usd": round(x, 6), "q": round(q, 10), "Q": round(Q, 10), "C": round(C, 6), "val": round(Q * ref, 6)}
        if a not in ("cap",):
            n, tgt, lvl = 1, start, 0
        anchor = ref

    def rebuys(tk, p, prev, q_, c_):
        """🔁 إعادات الشراء التي يمرّ بها السعر نازلاً من prev إلى p — كل نقطة بسعرها (أو prev لو تجاوزها السعر قبل) · نفس قواعد المحرك:
        نفس الكمية صافية (للسنت الأعلى) ⇐ أقصى أمر ⇐ الميزانية ⇐ أقل أمر · النقاط بنفس السعر = أمر واحد · الباقي (أقصى أمر) أوامر تالية"""
        out = {"usd": 0.0, "q": 0.0, "n": 0, "px": None, "held": False}
        due = sorted({min(t[0], prev) for t in tk if t[0] >= p * (1 - 1e-12) and t[1] > 1e-12}, reverse=True)
        for ex in due:
            grp = [t for t in tk if t[1] > 1e-12 and t[0] >= p * (1 - 1e-12) and abs(min(t[0], prev) - ex) <= 1e-12 * ex]
            for _ in range(1000):
                qs = sum(t[1] for t in grp)
                if qs <= 1e-12:
                    break
                amt = math.ceil(qs * ex / (1 - F) * 100 - 1e-6) / 100
                mnu = max(1.0, mn * ex)
                if mo > 0 and amt > mo:
                    full, amt = amt, mo
                    if full - mo < mnu and full - mnu - 0.01 >= mnu:
                        amt = round(full - mnu - 0.01, 2)
                if cap > 0:
                    amt = min(amt, math.floor(max(0.0, cap - c_) * 100 + 1e-9) / 100)
                amt = max(0.0, round(amt, 2))
                if cap > 0 and cap - c_ < mnu:
                    out["held"] = True                       # الميزانية ممتلئة ⇒ تبقى معلّقة
                    break
                if amt < mnu:
                    for t in grp:
                        t[1] = 0.0                           # أصغر من أقل أمر ⇒ تُلغى
                    break
                qn = amt / ex * (1 - F)
                q_, c_ = q_ + qn, c_ + amt
                out["usd"] += amt; out["q"] += qn; out["n"] += 1; out["px"] = ex
                ratio = min(1.0, qn / qs)
                for t in grp:
                    left = t[1] * (1 - ratio)
                    t[1] = left if (ratio < 0.999 and left * ex >= 0.5) else 0.0
            if out["held"]:
                break
        tk[:] = [t for t in tk if t[1] > 1e-12]
        return out, q_, c_

    def walk(sign, N, s0, base, cut=0, nmax=0, need=0):
        """صفوف مسار واحد من حالة s0 = (الكمية، الكلفة، المستوى، الهدف، الخطوات، إعادات الشراء المعلّقة) · الصعود يكمل لحد «need» بيعات (حتى nmax)
        حتى يبيّن وين يبدأ البيع ⇒ (الصفوف، الحالة بعد الصف «cut» وسعره) · 🛡️ فوق سعر البداية: لا شراء جديد (المستوى لا يُحسب · الهدف لا يتقدّم)
        وإعادات الشراء بسعرها · كل بيعة فوقه تترك نقطة إعادة شراء أوطى بمستوى"""
        rows, (q_, c_, lv, tg, k, tk), cum, snap, sells = [], s0, 0.0, None, 0
        tk = [list(t) for t in tk]
        prev = base
        for i in range(1, max(N, nmax) + 1):
            p = base * ((1 - d) ** i if sign < 0 else (1 + u) ** i)
            if p <= 0:
                break
            rb = None
            if gd and sign < 0 and tk:
                rb, q_, c_ = rebuys(tk, p, prev, q_, c_)
            if pm:
                lv2 = lv + 1 if sign < 0 else max(0, lv - 1)
                T = start + S * lv2
                band_abs = 0.0
            else:
                T = (tg + S) if (k > 0 and tg is not None) else start
                band_abs = bp / 100 * T
            want = T - q_ * p
            above = gd and p0 > 0 and p > p0 * (1 + 1e-9)
            if above and want > 0.01:
                a, x, qq, q2, c2, pr = "guard", 0.0, 0.0, q_, c_, 0.0
            else:
                a, x, qq, q2, c2, pr = _va_sim_step(T, p, q_, c_, band_abs, mo, cap, fl, F, mn, lot)
            if a not in ("cap", "guard"):
                q_, c_ = q2, c2
                if pm:
                    lv = lv2
                else:
                    tg, k = T, k + 1
            rbp = None
            if a == "sell" and above and qq > 0:
                tp = p * (1 - gdist)
                if tp > p0 * (1 + 1e-9):
                    tk.append([tp, qq, p])
                    rbp = tp
            act = a
            if rb and rb["n"] and a in ("guard", "hold", "small"):
                act = "rebuy"
            cum += pr
            sells += a == "sell"
            paper = (q_ * p * (1 - F) - c_) if q_ > 0 else -c_
            row = {"i": i, "px": p, "chg": round((p / ref - 1) * 100, 4), "chg_b": round((p / base - 1) * 100, 4), "tgt": round(T, 6), "act": act,
                   "usd": round(rb["usd"] if act == "rebuy" else x, 6), "q": round(rb["q"] if act == "rebuy" else qq, 10), "Q": round(q_, 10), "C": round(c_, 6),
                   "avg": (c_ / q_) if q_ > 0 else 0.0, "val": round(q_ * p, 6), "profit": round(pr, 6), "cum": round(cum, 6), "lvl": lv if pm else k,
                   "want": round(want, 6), "paper": round(paper, 6), "res": round(cum + paper, 6), "cap_pct": round(min(100.0, c_ / cap * 100), 2) if cap > 0 else 0.0}
            if rb and rb["n"]:
                row["rb"] = {"usd": round(rb["usd"], 6), "q": round(rb["q"], 10), "n": rb["n"], "px": rb["px"]}
                if act != "rebuy":
                    row["rb"]["with"] = a
            if rbp:
                row["rb_px"] = rbp
            if above:
                row["above"] = True
            rows.append(row)
            prev = p
            if cut and i == cut:
                snap = ((q_, c_, lv, tg, k, [list(t) for t in tk]), p)
            if sign < 0 and a == "cap":
                break
            if sign > 0 and i >= N and (sells >= need or i >= nmax):
                break
        return rows, snap

    s0, b0 = (Q, C, lvl, tgt, n, tk0), (anchor if pm else ref)
    at = max(0, min(int(at or 0), down))
    rd, snap = walk(-1, down, s0, b0, cut=at)
    if at and snap is None and rd:                           # المستوى المختار بعد امتلاء الميزانية ⇒ آخر سطر
        at = len(rd)
        rd, snap = walk(-1, down, s0, b0, cut=at)
    ru, _ = walk(1, up, s0, b0, nmax=40, need=3)
    buys = [r for r in rd if r["act"] == "buy"]
    capr = next((r for r in rd if r["act"] == "cap"), None)
    end = {"last_buy_px": buys[-1]["px"] if buys else None, "last_buy_chg": buys[-1]["chg"] if buys else None,
           "full_px": capr["px"] if capr else None, "full_chg": capr["chg"] if capr else None, "spent": rd[-1]["C"] if rd else round(C, 6),
           "levels": len(buys), "beyond": capr is None}
    nb = next((r for r in rd if r["act"] in ("buy", "cap", "rebuy")), None)
    ns = next((r for r in ru if r["act"] in ("sell", "floor")), None)
    if capr:
        end.update(full_C=capr["C"], full_val=round(capr["Q"] * capr["px"], 6), full_res=capr["res"])
    at_info, up_at = None, None
    if at and snap:                                          # 👆 جدول البيع لو اشترى لحد المستوى «at» ثم صعد (نفس الشبكة: المرساة = سعر ذاك المستوى)
        (q0, c0, _l, _t, _k, _tk), pa = snap
        up_at, _ = walk(1, up, snap[0], pa, nmax=60, need=3)
        fpx = (c0 / q0) * 1.001 / (1 - F) if (fl and q0 > 0 and c0 > 0) else 0.0
        fs = next((r for r in up_at if r["act"] == "sell"), None)
        at_info = {"i": at, "px": pa, "chg": round((pa / ref - 1) * 100, 4), "Q": round(q0, 10), "C": round(c0, 6), "avg": (c0 / q0) if q0 > 0 else 0.0,
                   "val": round(q0 * pa, 6), "res": round((q0 * pa * (1 - F) - c0) if q0 > 0 else -c0, 6), "floor_px": fpx,
                   "floor_chg_b": round((fpx / pa - 1) * 100, 4) if fpx else None, "floor_chg": round((fpx / ref - 1) * 100, 4) if fpx else None,
                   "first_sell": fs, "sells": sum(1 for r in up_at if r["act"] == "sell"), "lvl": _l if pm else _k}
    if keep and len(rd) > keep:                               # الملخص من كل المستويات (حتى امتلاء الميزانية) · الصفوف المرسلة أول «keep» + سطر الامتلاء
        rd = rd[:keep] + ([capr] if capr else [])
    return {"ok": True, "trigger": "price" if pm else "time", "approx": not pm, "ref": ref, "min_sz": mn, "lot": lot, "d": round(d * 100, 6), "u": round(u * 100, 6),
            "anchor": anchor if pm else None, "lvl": lvl, "fee": round(F * 100, 4), "first": first, "down": rd, "up": ru, "end": end,
            "next_buy": nb, "next_sell": ns, "Q": round(Q, 10), "C": round(C, 6), "at": at_info, "up_at": up_at,
            "guard": ({"on": True, "p0": p0, "dist": round(gdist * 100, 6), "above": ref > p0 * (1 + 1e-9), "rb": len(tk0),
                       "rb_q": round(sum(t[1] for t in tk0), 10), "rb_next": max([t[0] for t in tk0]) if tk0 else None,
                       "first_buy": next((r for r in rd if r["act"] in ("buy", "cap")), None)} if gd else {"on": False})}


def _va_plan_hg(cfg, st, px, down, up, mn, keep, lot, at, hgc):
    """📋 ♾️×💹 التعاوني: تحت سعر التشغيل جدول المسار نفسه بالحرف (المحرك هناك مسار عادي) · فوقه سلّم الشبكة اللانهائية:
    درجاتها من سعر التشغيل × (1 + الدرجة)ⁿ · كمية كل درجة = دولار الأمر ÷ سعر شرائها · ربح الدورة الصافي (نفس حساب بوت الإنفنتي)"""
    g, u, ri, rip = hgc
    st2 = {k: v for k, v in (st or {}).items() if k != "set_guard_on"}
    P = va_plan(dict(cfg, guard_on=False, _hg_inner=True), st2, px, down, up, mn, keep, lot, at)
    if not P.get("ok"):
        return P
    ref = float(P.get("ref") or px or 0)
    hs = (st or {}).get("hg") if isinstance((st or {}).get("hg"), dict) else {}
    p0 = float(hs.get("p0") or 0) if hs.get("on") else 0.0
    p0 = p0 or (_va_p0(st, ref) if int((st or {}).get("n_step") or 0) > 0 else ref)    # بوت جديد: سعر التشغيل = سعر أول شراء (الآن)
    gg = g / 100.0
    if p0 > 0:
        P["down"] = [r for r in (P.get("down") or []) if float(r.get("px") or 0) <= p0 * (1 + 1e-9)]
        P["up"] = [r for r in (P.get("up") or []) if float(r.get("px") or 0) <= p0 * (1 + 1e-9)]
        P["next_buy"] = next((r for r in P["down"] if r.get("act") in ("buy", "cap")), None)
        P["next_sell"] = next((r for r in P["up"] if r.get("act") == "sell"), None)
        if P.get("up_at"):
            P["up_at"] = [r for r in P["up_at"] if float(r.get("px") or 0) <= p0 * (1 + 1e-9)]
    nf = _va_hg_nf(gg)
    rungs = []
    for k in range(1, 13):
        hi_, lo_ = p0 * (1 + gg) ** k, p0 * (1 + gg) ** (k - 1)
        q = round(u / lo_, 2) if lo_ > 0 else 0.0
        net = (hi_ - lo_) * q * 0.999 * nf
        part = rip / 100.0 if ri else 0.0
        rungs.append({"k": k, "px": round(hi_, 10), "buy": round(lo_, 10), "q": q, "usd": round(q * hi_, 6), "net": round(net, 6),
                      "rel": round(net * (1 - part), 6), "ri": round(net * part, 6), "chg": round((hi_ / ref - 1) * 100, 4) if ref > 0 else 0.0})
    P["hg"] = {"on": True, "p0": round(p0, 10), "g": g, "usd": u, "ri": ri, "rip": rip, "exit_px": round(p0 * (1 - gg / 2), 10), "nf": round(nf, 6),
               "rungs": rungs, "active": bool(hs.get("on")), "ep": int(hs.get("ep") or 0)}
    P["guard"] = {"on": False}
    return P


def _va_snapshot(b, st):
    """💹 بيانات كرت مسار القيمة: الهدف القادم مقابل قيمة العملة الآن · ماذا سيفعل · الكلفة والميزانية · المحقق وغير المحقق · رسم المسار"""
    cfg = b["cfg"]
    base = str(b["symbol"]).split("-")[0]
    cp = float(PX.get(b["symbol"]) or st.get("px") or 0)
    try:
        F = float(st.get("fee_rate") or 0)
    except Exception:
        F = 0.0
    if not 0 < F < 0.01:
        F = VA_FEE
    Q, C = _va_pos(st)
    val = Q * cp
    pm = _va_pm(cfg)
    lvl = int(st.get("lvl") or 0)
    if pm and int(st.get("n_step") or 0) > 0:                # 📉📈 بالنسبة: هدف المستوى الحالي (يتغيّر فقط عند عبور مستوى)
        T = max(0.0, _va_p(cfg, st, "start_usd") + max(0.0, _va_p(cfg, st, "step_usd")) * lvl)
    else:
        T = _va_next_tgt(cfg, st)
    band = 0.0 if pm else _va_p(cfg, st, "band_pct", 2.0) / 100.0 * T
    gap = T - val
    floor_on = _va_p(cfg, st, "floor_on", True)
    floor_px = (C / Q) * 1.001 / (1 - F) if Q > 0 and C > 0 else 0.0
    if cp <= 0:
        hint = ""
    elif pm:
        hint = "wait"                                          # بالنسبة: ينتظر عبور مستوى (الجدول يقول أين وكم)
    elif abs(gap) <= max(band, 0.01):
        hint = "hold"
    elif gap > 0:
        hint = "buy"
    else:
        hint = "floor" if (floor_on and floor_px > 0 and cp * (1 - 0.00025) < floor_px) else "sell"
    unreal = (Q * cp * (1 - F) - C) if (Q > 0 and cp > 0) else 0.0
    profit = float(st.get("profit_total") or 0)
    today = time.strftime("%Y-%m-%d")
    tday = 0.0
    for c in (st.get("cycles_log") or []):
        try:
            if time.strftime("%Y-%m-%d", time.localtime(float(c.get("ts") or 0))) == today:
                tday += float(c.get("profit") or 0)
        except Exception:
            continue
    hs = [h for h in (st.get("hi24") or []) if isinstance(h, list) and len(h) == 2 and time.time() - float(h[0]) <= 86400]
    hi = max([float(h[1]) for h in hs] + [cp]) if cp > 0 else 0.0
    drop = round((1 - cp / hi) * 100, 2) if hi > 0 and cp > 0 else 0.0
    bp = _va_p(cfg, st, "brake_pct")
    fees = {str(k): round(float(v or 0), 12) for k, v in (st.get("fees") or {}).items() if float(v or 0) > 0}
    fee_usd = sum(v if k in ("USDT", "USDC", "USD") else (v * cp if k == base else 0.0) for k, v in fees.items())
    try:
        hb_age = round(time.time() - float(st.get("hb") or 0), 1) if st.get("hb") else None
    except Exception:
        hb_age = None
    steps = []
    for s in (st.get("steps_log") or [])[-60:]:
        if isinstance(s, dict):
            steps.append({k: s.get(k) for k in ("k", "ts", "px", "tgt", "val", "after", "act", "amt")})
    lc = st.get("last_cycle") if isinstance(st.get("last_cycle"), dict) else None
    pdx = st.get("pending") if isinstance(st.get("pending"), dict) else None
    cap = _va_p(cfg, st, "cap")
    _sc = _INST_CACHE.get(b["symbol"])
    if not _sc and b["symbol"] not in _VA_SPEC_ASKED:            # أقل كمية بالمنصة للجدول — تُجلب مرة بالخلفية (لا انتظار بجولة اللوحة)
        _VA_SPEC_ASKED.add(b["symbol"])
        threading.Thread(target=_acc_spec, args=(b["symbol"],), daemon=True).start()
    _sv = (_sc or {}).get("v") or {}
    try:
        plan = va_plan(cfg, st, cp, down=150, up=10, mn=float(_sv.get("minSz") or 0), keep=25, lot=float(_sv.get("lotSz") or 0)) if cp > 0 else {"ok": False}
    except Exception:
        plan = {"ok": False}
    try:
        anchor = float(st.get("anchor") or 0)
    except Exception:
        anchor = 0.0
    dd = _va_p(cfg, st, "drop_pct", 5.0)
    _drel, _dit = _va_del_of(b)
    gd, gdist = _va_gd(cfg, st)                              # 🛡️ v3.36.5
    p0 = _va_p0(st, cp) if gd else 0.0
    rbs = [t for t in (st.get("rb") or []) if isinstance(t, dict)]
    above = bool(gd and p0 > 0 and cp > p0 * (1 + 1e-9))
    if above and hint == "buy":
        hint = "guard"
    hgc = _va_hg(cfg, st)                                     # ♾️×💹 v3.36.6: التعاوني
    hgs = st.get("hg") if isinstance(st.get("hg"), dict) else {}
    hg_out = None
    if hgc or hgs.get("on") or hgs.get("last"):
        lv = hgs.get("live") if isinstance(hgs.get("live"), dict) else {}
        hist = [h for h in (hgs.get("hist") or []) if isinstance(h, dict)]
        g_ = (float(hgs.get("g") or 0) * 100) if hgs.get("on") else (hgc[0] if hgc else 0.0)
        hp0 = float(hgs.get("p0") or 0) if hgs.get("on") else p0
        hg_out = {"cfg": ({"g": hgc[0], "usd": hgc[1], "ri": hgc[2], "rip": hgc[3]} if hgc else None), "on": bool(hgs.get("on")),
                  "ep": int(hgs.get("ep") or 0), "p0": hp0, "exit_px": round(hp0 * (1 - g_ / 200.0), 10) if hp0 > 0 else 0.0,
                  "g": g_, "usd": float(hgs.get("u") or 0) if hgs.get("on") else (hgc[1] if hgc else 0.0),
                  "q0": float(hgs.get("q0") or 0), "q": float(lv.get("q") or hgs.get("q0") or 0), "lock": float(lv.get("lock") or 0),
                  "qb": float(lv.get("qb") or 0), "qs": float(lv.get("qs") or 0), "B": float(lv.get("B") or 0), "S": float(lv.get("S") or 0),
                  "n": int(hgs.get("n") or 0), "rel": float(hgs.get("rel") or 0), "ri": float(hgs.get("rib") or 0), "drain": hgs.get("drain") or "",
                  "pz": bool(hgs.get("pz")), "t0": hgs.get("t0"), "last": hgs.get("last") if isinstance(hgs.get("last"), dict) else None,
                  "periods": len(hist), "tot": round(sum(float(h.get("rel") or 0) + float(h.get("ri") or 0) for h in hist)
                                                    + (float(hgs.get("rel") or 0) + float(hgs.get("rib") or 0) if hgs.get("on") else 0.0), 10),
                  "sells_n": sum(int(h.get("n") or 0) for h in hist) + (int(hgs.get("n") or 0) if hgs.get("on") else 0),
                  "ri_now": bool(hgs.get("ri")) if hgs.get("on") else None,                       # 💠 v3.36.8: إعداد الفترة الجارية
                  "rip_now": float(hgs.get("rip") if hgs.get("rip") is not None else 100.0) if hgs.get("on") else None}
        hg_out.update(wal=bool(_va_p(cfg, st, "hg_wallet", False)), wq=round(float(hgs.get("wq") or 0), 12),        # 👛 v3.36.11
                      wq_all=round(sum(float(h.get("wq") or 0) for h in hist) + (float(hgs.get("wq") or 0) if hgs.get("on") else 0.0), 12))
        if hgs.get("on"):
            hg_out.update(_safe(_va_hg_grid, b, default={}) or {})
            hg_out["c_live"] = round(float(hgs.get("c0") or 0) + hg_out["B"] - hg_out["S"] + hg_out["rel"] + hg_out["ri"], 10)   # كلفة المسار مع الفترة (نفس دمجها)
            hg_out["cash"] = round(hg_out["S"] - hg_out["B"], 10)                                                          # دولار بيعات الشبكة بانتظار إعادة الشراء
            hg_out["q0"] = float(hgs.get("qs0", hgs.get("q0")) or 0)                                                       # ⏸️ v3.36.10: عملة بداية الفترة
            hg_out["parks"] = int(hgs.get("parks") or 0)
            if isinstance(hgs.get("dn"), dict):          # ⏸️ v3.36.10: الشبكة تنتظر تحت سعر التشغيل بأوامرها — المسار يعمل بعملته (دفتره + حصة الشبكة)
                hg_out.update(dn=True, dn_t=float(hgs["dn"].get("t") or 0), lock=round(float(hgs["dn"].get("lock") or hg_out["lock"]), 12),
                              q=round(Q + float(lv.get("q") or 0), 12), c_live=round(C + hg_out["c_live"], 10))
            else:
                hint = "grid"
    return {"kind": "va", "base": base, "cp": cp, "side": "buy", "mode": "avg", "del_pending": bool(_dit),
            "trigger": "price" if pm else "time", "drop_pct": dd, "rise_pct": _va_p(cfg, st, "rise_pct", dd), "anchor": anchor, "lvl": lvl, "plan": plan,
            "start": _va_p(cfg, st, "start_usd"), "step": _va_p(cfg, st, "step_usd"), "every": int(float(cfg.get("every") or 1)),
            "per": cfg.get("unit") or "d", "at": cfg.get("at") or "", "band": _va_p(cfg, st, "band_pct", 2.0),
            "max_order": _va_p(cfg, st, "max_order"), "cap": cap, "floor_on": floor_on, "brake": bp,
            "brake_now": bool(bp > 0 and drop >= bp), "drop": drop, "hi24": hi,
            "fixed": _va_p(cfg, st, "step_usd") <= 0, "cfg_txt": _va_cfg_txt(cfg, st),
            "n_step": int(st.get("n_step") or 0), "tgt": float(st.get("tgt") or 0) if st.get("tgt") is not None else None,
            "next_tgt": round(T, 6), "q": round(Q, 10), "c": round(C, 6), "avg": round(C / Q, 10) if Q > 0 else 0.0,
            "val": round(val, 6), "gap": round(gap, 6), "band_usd": round(band, 6), "hint": hint, "floor_px": round(floor_px, 10),
            "expo": round(C, 6), "expo_usd": round(C, 4), "cap_pct": round(min(100.0, C / cap * 100), 2) if cap > 0 else 0.0,
            "profit": round(profit, 10), "rel": round(float(st.get("rel_total") or 0), 10), "unreal": round(unreal, 6),
            "total": round(profit + unreal, 6), "buy_usd": round(float(st.get("buy_usd") or 0), 6), "sell_usd": round(float(st.get("sell_usd") or 0), 6),
            "orders": int(st.get("orders") or 0), "cycles": int(st.get("cycles") or 0), "skips": int(st.get("skips") or 0),
            "skip_why": st.get("_skip_why") or "", "today": round(tday, 10), "paused": bool(st.get("paused")),
            "next_at": float(st.get("next_at") or 0), "hb_age": hb_age, "steps": steps,
            "fees": fees, "fee_usd": round(fee_usd, 6), "fee_other": [k for k in fees if k not in ("USDT", "USDC", "USD", base)],
            "fee_rate": round(F * 100, 4), "pending": bool(pdx), "unsure": bool(pdx and not pdx.get("oid")),
            "guard_on": gd, "guard_pct": _va_p(cfg, st, "guard_pct", 5.0), "guard_dist": round(gdist * 100, 6), "p0": p0, "above": above,
            "rb": [{"px": float(t.get("px") or 0), "q": float(t.get("q") or 0), "sp": float(t.get("sp") or 0)} for t in sorted(rbs, key=lambda t: -float(t.get("px") or 0))[:12]],
            "rb_n": len(rbs), "rb_q": round(sum(float(t.get("q") or 0) for t in rbs), 10), "gd_skips": int(st.get("gd_skips") or 0),
            "rb_why": st.get("_rb_why") or "", "hg": hg_out,
            "first_src": str(cfg.get("first_src") or "buy"), "w0": st.get("w0") if isinstance(st.get("w0"), dict) else None,     # 👛 v3.36.11
            "rq": {"now": bool(st.get("rq_now")), "exit": bool(st.get("rq_exit"))},
            "last": ({k: lc.get(k) for k in ("n", "ts", "profit", "manual", "px", "out", "in")} if lc else None)}


VA_DEL_FILE = os.path.join(ROOT, "Holy_VaDelete.json")
_VA_DEL = {"d": None}
_VA_DEL_LOCK = threading.Lock()
_VA_DEL_RUN = set()


def _va_del_all():
    """🗑 v3.35.2: «بع العملات ثم احذف» المعلّقة {مجلد البوت: {ts, bot_id, sym}} — بملف اللوحة (المحرك لا يكتب عليه)"""
    with _VA_DEL_LOCK:
        if _VA_DEL["d"] is None:
            d = load_json(VA_DEL_FILE)
            _VA_DEL["d"] = d if isinstance(d, dict) else {}
        return dict(_VA_DEL["d"])


def _va_del_set(rel, item):
    _va_del_all()
    with _VA_DEL_LOCK:
        if item is None:
            _VA_DEL["d"].pop(rel, None)
        else:
            _VA_DEL["d"][rel] = item
        try:
            save_json_atomic(VA_DEL_FILE, _VA_DEL["d"])
        except Exception:
            pass


def _va_del_of(b):
    """الطلب المعلّق لهذا البوت بالذات (نفس المجلد **ونفس المعرّف** — بوت جديد بنفس اسم المجلد لا يُحذف بالغلط)"""
    rel = os.path.relpath(b["dir"], ROOT)
    it = _va_del_all().get(rel)
    if it and str(it.get("bot_id") or "") != str((b.get("cfg") or {}).get("bot_id") or ""):
        _va_del_set(rel, None)
        return rel, None
    return rel, it


def _va_del_abort(b, rel, why):
    """البيع لم يكتمل ⇒ لا حذف: الطلب يُلغى (ولا يبقى «بيع الكل» معلّقاً يتنفّذ لاحقاً بالغلط) · إشعار واضح"""
    _va_del_set(rel, None)
    sp = paths_of(b)[0]
    st = load_json(sp) or {}
    if st.get("rq_exit"):
        save_state_keys(sp, {"rq_exit": None})
    base = str(b["symbol"]).split("-")[0]
    journal("bot", f"⚠️ لم يُحذف بوت مسار القيمة: {why}", lv="warn", bot=os.path.basename(b["dir"]), sym=b["symbol"])
    tg_send(f"⚠️ *لم يُحذف بوت مسار القيمة — `{b['symbol']}`*\n{why}\nالبوت والعملات ({base}) باقية كما هي — أعد المحاولة من 🗑")


def _va_del_do(b, rel):
    try:
        res = delete_purge(b)
        journal("bot", "🗑 بيعت عملات بوت مسار القيمة ثم حُذف البوت" + ("" if res.get("ok") else f" — تعذّر النقل: {res.get('msg')}"),
                lv="info" if res.get("ok") else "warn", bot=os.path.basename(b["dir"]), sym=b["symbol"])
    finally:
        _va_del_set(rel, None)
        _VA_DEL_RUN.discard(rel)


def _va_del_tick(b, st):
    """🗑 من حلقة الإشعارات (كل بضع ثوانٍ): بعد ما يحسم المحرك «بيع الكل» يُحذف البوت — أو يُلغى الحذف لو بقيت عملة"""
    rel, it = _va_del_of(b)
    if not it or rel in _VA_DEL_RUN:
        return
    st = load_json(paths_of(b)[0]) or st                   # قراءة طازجة: الطلب يُكتب بعد «بيع الكل» ⇒ لا تُقرأ حالة قديمة سبقت الضغطة
    age = time.time() - float(it.get("ts") or 0)
    if st.get("rq_exit") or st.get("pending"):              # البيع لم يُحسم بعد
        if age > 900:
            _va_del_abort(b, rel, "لم يتم البيع خلال 15 دقيقة (الشبكة أو المنصة)")
        return
    Q, _C = _va_pos(st)
    cp = float(PX.get(b["symbol"]) or st.get("px") or 0)
    mn = float((((_INST_CACHE.get(b["symbol"]) or {}).get("v")) or {}).get("minSz") or 0)
    if Q > 0 and not ((cp > 0 and Q * cp < 1.0) or (mn > 0 and Q < mn)):
        _va_del_abort(b, rel, f"بقيت {Q:.8g} {str(b['symbol']).split('-')[0]} لم تُبع (أمر البيع لم يُنفَّذ بالمنصة)")
        return
    _VA_DEL_RUN.add(rel)
    threading.Thread(target=_va_del_do, args=(b, rel), daemon=True).start()


def _va_control(b, sp, action, value):
    """💹 أزرار مسار القيمة — اللوحة تكتب حقل طلب فقط بملف الحالة والمحرك ينفّذ"""
    st = load_json(sp) or {}
    cfg = b["cfg"]
    alive = is_alive(b["dir"], sp)[0]
    busy = {"ok": False, "msg": "تعذّرت الكتابة بملف البوت — أعد المحاولة بعد ثانية"}
    if action in ("va_pause", "va_resume"):
        on = action == "va_pause"
        if not save_state_keys(sp, {"paused": on}):
            return busy
        return {"ok": True, "msg": ("⏸ أوقِف المسار — لا خطوات ولا شراء ولا بيع، والهدف لا يتقدّم حتى تشغّله" if on else
                                    ("▶️ عاد المسار — يتابع الشبكة نفسها: إذا عبر السعر مستوى أثناء التوقف يخطو خطوة واحدة الآن" if _va_pm(cfg) else
                                     "▶️ عاد المسار — الخطوة القادمة في موعدها")
                                    + (" (يبدأ من الهدف الأول بعد «بيع الكل»)" if not st.get("n_step") and st.get("cycles") else ""))}
    if action == "va_hg_ri":                                  # 💠 v3.36.8: إعادة استثمار شبكة التعاوني من الكرت (تشغيل/إيقاف + النسبة) — مثل بوت الإنفنتي
        v = value if isinstance(value, dict) else {}
        if not _va_hg(cfg, st):
            return {"ok": False, "msg": "إعادة استثمار الشبكة تعمل مع التعاوني ♾️×💹 فقط — فعّله أولاً من ⚙️ الإعدادات"}
        try:
            on = bool(v.get("on"))
            pct = float(v.get("pct") if v.get("pct") not in (None, "") else 100)
        except Exception:
            return {"ok": False, "msg": "اكتب نسبة صحيحة"}
        if not (pct == pct and 0 <= pct <= 100):
            return {"ok": False, "msg": "نسبة إعادة الاستثمار من 0% إلى 100%"}
        pct = round(pct, 2)
        if not save_state_keys(sp, {"set_hg_ri": on, "set_hg_ri_pct": pct}):
            return busy
        hgs = st.get("hg") if isinstance(st.get("hg"), dict) else {}
        what = (f"تعمل — {pct:g}% من ربح كل بيعة للشبكة يعود إلى أمرها فيكبر و{100 - pct:g}% ربح محرَّر" if on
                else "متوقفة — ربح كل بيعة للشبكة يُحرَّر كاملاً")
        if hgs.get("on"):
            cur = (f"بإعادة استثمار {float(hgs.get('rip') if hgs.get('rip') is not None else 100):g}%" if hgs.get("ri") else "بلا إعادة استثمار")
            when = (f"الفترة الحالية #{int(hgs.get('ep') or 0)} تكمل {cur} — ويُطبَّق عندما ينزل السعر تحت سعر التشغيل ثم يرجع فوقه: "
                    "تنتهي الفترة (تلغي أوامرها) وتبدأ فترة جديدة به")
        else:
            when = "يُطبَّق من أول فترة للشبكة (عندما يصعد السعر فوق سعر التشغيل)"
        tg_send(f"💠 *إعادة استثمار شبكة التعاوني — `{b['symbol']}`*\n{what}\n{when}")
        return {"ok": True, "msg": f"💠 إعادة استثمار الشبكة {what} · {when}"}
    if action == "va_set":
        v = value if isinstance(value, dict) else {}
        upd = {}
        lim = {"step_usd": (0.0, 1e6), "band_pct": (0.0, 50.0), "max_order": (1.0, 1e7), "cap": (1.0, 1e8), "brake_pct": (0.0, 90.0),
               "drop_pct": (0.5, 50.0), "rise_pct": (0.5, 100.0)}
        for k, (lo, hi) in lim.items():
            if k in v and v[k] not in (None, ""):
                try:
                    x = float(v[k])
                except Exception:
                    return {"ok": False, "msg": "اكتب أرقاماً صحيحة"}
                if not (x == x and lo <= x <= hi):
                    return {"ok": False, "msg": {"step_usd": "مبلغ الخطوة من 0 فأكثر", "band_pct": "النطاق من 0% إلى 50%",
                                                 "max_order": "أقصى أمر 1$ فأكثر", "cap": "الميزانية 1$ فأكثر",
                                                 "brake_pct": "المكابح من 0% (مطفأة) إلى 90%", "drop_pct": "نسبة النزول من 0.5% إلى 50%",
                                                 "rise_pct": "نسبة الصعود من 0.5% إلى 100%"}[k]}
                upd["set_" + k] = round(x, 6)
        if "floor_on" in v:
            upd["set_floor_on"] = bool(v.get("floor_on"))
        if "guard_on" in v:                                       # 🛡️ v3.36.5: الحماية فوق سعر البداية
            upd["set_guard_on"] = bool(v.get("guard_on"))
        if "guard_pct" in v and v["guard_pct"] not in (None, ""):
            try:
                x = float(v["guard_pct"])
            except Exception:
                return {"ok": False, "msg": "اكتب أرقاماً صحيحة"}
            if not (x == x and 0.5 <= x <= 50):
                return {"ok": False, "msg": "مسافة إعادة الشراء من 0.5% إلى 50%"}
            upd["set_guard_pct"] = round(x, 6)
        for k, (lo, hi, why) in (("hg_pct", (0.1, 20.0, "درجة الشبكة من 0.1% إلى 20%")), ("hg_usd", (1.0, 1e7, "دولار أمر الشبكة 1$ فأكثر")),
                                 ("hg_ri_pct", (0.0, 100.0, "نسبة إعادة الاستثمار من 0% إلى 100%"))):       # ♾️×💹 v3.36.6
            if k in v and v[k] not in (None, ""):
                try:
                    x = float(v[k])
                except Exception:
                    return {"ok": False, "msg": "اكتب أرقاماً صحيحة"}
                if not (x == x and lo <= x <= hi):
                    return {"ok": False, "msg": why}
                upd["set_" + k] = round(x, 6)
        if "hg_ri" in v:
            upd["set_hg_ri"] = bool(v.get("hg_ri"))
        if "hg_wallet" in v:                                      # 👛 v3.36.11: الشبكة تبيع من عملات المحفظة (يُطبَّق فوراً)
            upd["set_hg_wallet"] = bool(v.get("hg_wallet"))
            if upd["set_hg_wallet"] == bool(_va_p(cfg, st, "hg_wallet", False)) and len([k_ for k_ in v if k_ != "hg_wallet"]) == 0:
                upd.pop("set_hg_wallet")
        if not upd:
            return {"ok": False, "msg": "لم يتغيّر شيء"}
        mo = upd.get("set_max_order", _va_p(cfg, st, "max_order"))
        cp_ = upd.get("set_cap", _va_p(cfg, st, "cap"))
        if cp_ + 1e-9 < mo:
            return {"ok": False, "msg": "الميزانية يجب أن تكون أكبر من أو تساوي أقصى أمر"}
        if not save_state_keys(sp, upd):
            return busy
        st2 = dict(st, **upd)
        g_on = _va_gd(cfg, st2)[0]
        g_was = _va_gd(cfg, st)[0]
        gtxt = ""
        h_on, h_was = _va_hg(cfg, st2), _va_hg(cfg, st)
        hgs = st.get("hg") if isinstance(st.get("hg"), dict) else {}
        if h_on and not h_was:
            _p = _va_p0(st2, float(PX.get(b["symbol"]) or st.get("px") or 0))
            gtxt = (f" · ♾️×💹 التعاوني يعمل من الآن: فوق سعر التشغيل {_p:.8g} شبكة لانهائية — تحته المسار" if _p > 0
                    else " · ♾️×💹 التعاوني يعمل من أول خطوة (سعرها = سعر التشغيل)")
        elif h_was and not h_on:
            gtxt = (" · ♾️ أُطفئ التعاوني — الشبكة تلغي أوامرها وتعيد عملاتها ودولارها إلى المسار" if hgs.get("on")
                    else " · ♾️ أُطفئ التعاوني")
        elif h_on and hgs.get("on") and any(k in upd for k in ("set_hg_pct", "set_hg_ri", "set_hg_ri_pct")):
            gtxt = (" · ♾️ درجة الشبكة وإعادة الاستثمار: الفترة الحالية تكمل بإعداداتها، وتُطبَّق عندما ينزل السعر تحت سعر التشغيل ثم يعود فوقه "
                    "(تنتهي الفترة وتبدأ فترة جديدة بها) · دولار الأمر يتغيّر الآن")
        if gtxt:
            pass
        elif g_on and not g_was:
            _p = _va_p0(st2, float(PX.get(b["symbol"]) or st.get("px") or 0))
            gtxt = (f" · 🛡️ الحماية تعمل من الآن: سعر البداية {_p:.8g} — فوقه لا شراء جديد" if _p > 0 else " · 🛡️ الحماية تعمل من أول خطوة")
        elif g_was and not g_on:
            gtxt = " · 🛡️ أُطفئت الحماية — تُلغى إعادات الشراء المعلّقة ويعود البوت لطريقته العادية"
        if "set_hg_wallet" in upd and bool(upd["set_hg_wallet"]) != bool(_va_p(cfg, st, "hg_wallet", False)):
            gtxt += (" · 👛 الشبكة تبيع من عملات المحفظة الحرة أيضاً — يُطبَّق فوراً (ما تأخذه ينضم لحصّتها بسعر السوق)" if upd["set_hg_wallet"]
                     else " · 👛 الشبكة تبيع عملة المسار فقط — يُطبَّق فوراً (ما أخذته سابقاً يبقى ضمن حصّتها)")
        return {"ok": True, "msg": "✅ حُفظت الإعدادات — يطبّقها البوت من الخطوة القادمة: " + _va_cfg_txt(cfg, st2) + gtxt}
    if action == "va_exit_delete":                            # 🗑 v3.35.2: «بع العملات ثم احذف البوت» — البيع ينفّذه المحرك نفسه (لا أمر من اللوحة)
        if st.get("rq_exit"):
            return {"ok": False, "msg": "⏳ طلب بيع الكل السابق لم يُنفَّذ بعد — ثوانٍ"}
        if st.get("pending"):
            return {"ok": False, "msg": "⏳ هناك أمر قيد التنفيذ — انتظر ثوانيَ ثم أعد المحاولة"}
        if _va_pos(st)[0] <= 0:
            return {"ok": False, "msg": "لا عملة يحملها البوت — احذفه مباشرة"}
        rel = os.path.relpath(b["dir"], ROOT)
        if not save_state_keys(sp, {"rq_exit": time.time()}):
            return busy
        _va_del_set(rel, {"ts": time.time(), "bot_id": str(cfg.get("bot_id") or ""), "sym": b["symbol"]})
        started = ""
        if not alive:
            ok, msg = launch(b)
            if not ok:
                _va_del_set(rel, None)
                save_state_keys(sp, {"rq_exit": None})
                return {"ok": False, "msg": "تعذّر تشغيل البوت للبيع: " + str(msg)}
            started = " (شُغّل البوت للبيع فقط)"
        journal("bot", "🗑 طلب: بيع عملات بوت مسار القيمة ثم حذفه" + started, bot=os.path.basename(b["dir"]), sym=b["symbol"])
        return {"ok": True, "msg": "💰 يبيع البوت عملاته الآن بسعر السوق" + started + " — وبعد تأكيد البيع من المنصة يُحذف البوت تلقائياً ويصلك إشعار"}
    if not alive:
        return {"ok": False, "msg": "البوت متوقف — شغّله أولاً (الطلب ينفّذه المحرك نفسه)"}
    if action == "va_now":
        if ((st.get("hg") or {}).get("on") and not isinstance((st.get("hg") or {}).get("dn"), dict)) if isinstance(st.get("hg"), dict) else False:
            return {"ok": False, "msg": "⏩ «خطوة الآن» لا تعمل والشبكة تعمل فوق سعر التشغيل — يعود المسار عندما ينزل السعر تحته"}
        if st.get("rq_now"):
            return {"ok": False, "msg": "⏳ الطلب السابق لم يُنفَّذ بعد — ثوانٍ"}
        if not save_state_keys(sp, {"rq_now": time.time()}):
            return busy
        return {"ok": True, "msg": ("⏩ خطوة الآن: يقارن الهدف بقيمة العملة ويشتري الفرق أو يبيع الفائض خلال ثوانٍ — والشبكة تبدأ من السعر الحالي"
                                    if _va_pm(cfg) else "⏩ خطوة الآن: يقارن الهدف بقيمة العملة ويشتري الفرق أو يبيع الفائض خلال ثوانٍ (الموعد القادم لا يتغيّر)")}
    if action == "va_exit":
        if st.get("rq_exit"):
            return {"ok": False, "msg": "⏳ طلب بيع الكل السابق لم يُنفَّذ بعد — ثوانٍ"}
        if st.get("pending"):
            return {"ok": False, "msg": "⏳ هناك أمر قيد التنفيذ — انتظر ثوانيَ ثم أعد المحاولة"}
        if _va_pos(st)[0] <= 0:
            return {"ok": False, "msg": "لا عملة يحملها البوت للبيع"}
        if not save_state_keys(sp, {"rq_exit": time.time()}):
            return busy
        return {"ok": True, "msg": "✋ كُتب «بيع الكل»: يبيع البوت كل العملة التي يحملها بسعر السوق خلال ثوانٍ ويتوقف — ويبدأ المسار من جديد عند التشغيل"}
    return {"ok": False, "msg": "أمر غير معروف لبوت مسار القيمة"}


def _va_msg(b, st, e):
    """📨 نص تيليغرام لحدث واحد من مسار القيمة — بالفصحى (والتطبيق يأخذ منه «ربح الصفقة»)"""
    cfg = b["cfg"]
    sym = b["symbol"]
    base = sym.split("-")[0]
    k = e.get("k")
    SEP = "━━━━━━━━━━━━━"
    Q, C = _va_pos(st)
    cap = _va_p(cfg, st, "cap")
    nl = _va_next_line(cfg, st)
    if k == "buy":
        q, c, px = float(e.get("q") or 0), float(e.get("c") or 0), float(e.get("px") or 0)
        _fe = float(e.get("fee") or 0)
        return (f"🛒 *شراء — مسار القيمة — `{sym}`*\n{SEP}\n"
                f"🟢 اشترى `{q:.8g}` {base} بـ `{c:.4f}$` بسعر `{px:.8g}`\n"
                f"🎯 الهدف `{float(e.get('tgt') or 0):.2f}$` · قيمة العملة قبل `{float(e.get('val') or 0):.2f}$` وبعد `{float(e.get('after') or 0):.2f}$`\n"
                + (f"💸 العمولة: `{_fe:.8g}` {e.get('fc') or ''}\n" if _fe > 0 else "")
                + f"📦 كلفة العملة `{C:.2f}$`" + (f" من ميزانية `{cap:g}$`" if cap > 0 else "") + "\n"
                + nl)
    if k == "rebuy":                                          # 🔁 v3.36.5: إعادة شراء الحماية
        q, c, px, sp = float(e.get("q") or 0), float(e.get("c") or 0), float(e.get("px") or 0), float(e.get("sp") or 0)
        _fe = float(e.get("fee") or 0)
        return (f"🔁 *إعادة شراء — مسار القيمة — `{sym}`*\n{SEP}\n"
                f"🟢 أعاد شراء `{q:.8g}` {base} بـ `{c:.4f}$` بسعر `{px:.8g}`"
                + (f" — باعها فوق سعر البداية بسعر `{sp:.8g}` (أعلى بـ {(sp / px - 1) * 100:.2f}%)" if sp > 0 and px > 0 else "") + "\n"
                + (f"💸 العمولة: `{_fe:.8g}` {e.get('fc') or ''}\n" if _fe > 0 else "")
                + f"📦 كلفة العملة `{C:.2f}$`" + (f" من ميزانية `{cap:g}$`" if cap > 0 else "")
                + (f" · بانتظار إعادة الشراء: {int(e.get('left') or 0)}" if int(e.get("left") or 0) > 0 else "") + "\n"
                + nl)
    if k == "sell":
        p, pc = float(e.get("profit") or 0), float(e.get("pct") or 0)
        head = (f"💰 *{'بيع الكل' if e.get('manual') else 'بيع الفائض'} — مسار القيمة — `{sym}`* " + ("✨" if p >= 0 else "⚠️"))
        return (head + f"\n{SEP}\n"
                f"🔴 باع `{float(e.get('q') or 0):.8g}` {base} ⇐ `{float(e.get('usd') or 0):.4f}$` بسعر `{float(e.get('px') or 0):.8g}`\n"
                f"💎 ربح الصفقة (المحقق): `{p:+.4f}$` ({pc:+.2f}%)" + (" · ✋ يدوي" if e.get("manual") else "") + "\n"
                + ("" if e.get("manual") else f"🎯 الهدف `{float(e.get('tgt') or 0):.2f}$`\n")
                + (f"🔁 يعيد شراء الكمية نفسها عند `{float(e.get('rb_px') or 0):.8g}` إذا نزل السعر (الحماية فوق سعر البداية)\n" if e.get("rb_px") else "")
                + SEP + "\n"
                + f"📊 الإجمالي المحقق: `{float(st.get('profit_total') or 0):+.4f}$` · {int(st.get('cycles') or 0)} بيعة"
                + ("\n⏸ البوت متوقف — يبدأ المسار من جديد عند التشغيل" if e.get("manual") else ""))
    if k == "hg_on":                                          # ♾️×💹 v3.36.6: التعاوني
        return (f"♾️×💹 *التعاوني — بدأت الشبكة — `{sym}`*\n{SEP}\n"
                f"السعر `{float(e.get('px') or 0):.8g}` فوق سعر التشغيل `{float(e.get('p0') or 0):.8g}` — تعمل الشبكة اللانهائية نفسها على عملة المسار "
                f"(`{float(e.get('q') or 0):.8g}` {base}): درجة `{float(e.get('g') or 0):g}%` · `{float(e.get('usd') or 0):g}$` للأمر"
                + (f" · إعادة استثمار `{float(e.get('rip') or 0):g}%`" if e.get("ri") else "")
                + f"\nأدنى سعر لها سعر التشغيل · تحت `{float(e.get('p0') or 0) * (1 - float(e.get('g') or 0) / 200):.8g}` يعود المسار والشبكة تنتظر بأوامرها (لا تُلغى) "
                  "— تنتهي فقط بإطفاء التعاوني أو «بيع الكل» أو الحذف")
    if k == "w0":                                             # 👛 v3.36.11: أول طلب من المحفظة
        q, px, usd, rest = float(e.get("q") or 0), float(e.get("px") or 0), float(e.get("usd") or 0), float(e.get("rest") or 0)
        return (f"👛 *أول طلب من المحفظة — مسار القيمة — `{sym}`*\n{SEP}\n"
                + (f"أخذ البوت `{q:.8g}` {base} من محفظتك بسعر السوق `{px:.8g}` = `{usd:.2f}$` — تُحسب كأنها مشتراة (بلا عمولة)\n" if q > 0
                   else f"لا توجد {base} حرة في المحفظة — يُشترى الطلب الأول من السوق\n")
                + (f"🛒 الباقي `{rest:.2f}$` يُشترى من السوق\n" if q > 0 and rest >= 1 else "")
                + f"📦 كلفة العملة `{C:.2f}$`" + (f" من ميزانية `{cap:g}$`" if cap > 0 else "") + "\n" + nl)
    if k == "hg_wal":                                         # 👛 v3.36.11: شبكة التعاوني باعت من عملات المحفظة
        return (f"👛 *شبكة التعاوني تبيع من المحفظة — `{sym}`*\n{SEP}\n"
                f"أخذت الشبكة `{float(e.get('q') or 0):.8g}` {base} من عملات محفظتك الحرة بسعر السوق `{float(e.get('px') or 0):.8g}` "
                f"= `{float(e.get('usd') or 0):.4f}$` — تنضم إلى حصّتها كأنها مشتراة\n"
                f"مجموع ما أخذته في هذه الفترة: `{float(e.get('tot') or 0):.8g}` {base}")
    if k == "hg_sell":
        pv, ri = float(e.get("profit") or 0), float(e.get("ri") or 0)
        hgs = st.get("hg") if isinstance(st.get("hg"), dict) else {}
        return (f"♾️ *ربح الشبكة — مسار القيمة — `{sym}`* ✨\n{SEP}\n"
                + (f"🔴 باعت `{float(e.get('q') or 0):.8g}` {base} بسعر `{float(e.get('px') or 0):.8g}` — اشترتها بـ `{float(e.get('buy') or 0):.8g}`\n" if e.get("px") else "")
                + f"💎 ربح الصفقة (صافٍ): `{pv:+.4f}$`" + (f" · 💠 معاد استثماره `{ri:.4f}$`" if ri > 0 else " · محرر") + "\n"
                + f"📊 الشبكة بهذه الفترة: `{float(hgs.get('rel') or 0) + float(hgs.get('rib') or 0):+.4f}$` · {int(hgs.get('n') or e.get('n') or 0)} بيعة رابحة")
    if k == "hg_off":
        why = {"down": "نزل السعر تحت سعر التشغيل", "exit": "بيع الكل", "delete": "حذف البوت", "off": "أُطفئ التعاوني",
               "cfg": "تغيّرت درجة الشبكة أو إعادة استثمارها — تبدأ فترة جديدة بالإعداد الجديد"}.get(e.get("why"), "")
        return (f"💹 *رجع المسار — `{sym}`*\n{SEP}\n"
                f"الشبكة (فترة #{int(e.get('ep') or 0)}) انتهت" + (f" — {why}" if why else "") + f": {int(e.get('n') or 0)} بيعة رابحة · "
                f"ربح `{float(e.get('rel') or 0) + float(e.get('ri') or 0):+.4f}$`\n"
                f"🪙 العملة `{float(e.get('q0') or 0):.8g}` ⇐ `{float(e.get('q1') or 0):.8g}` {base} · كلفتها `{float(e.get('c1') or 0):.2f}$`\n" + nl)
    if k == "skip":
        why = e.get("why")
        if why == "guard":                                    # 🛡️ v3.36.5: مرة لكل فترة فوق سعر البداية
            return (f"🛡️ *مسار القيمة — لا شراء فوق سعر البداية — `{sym}`*\n"
                    f"السعر `{float(e.get('px') or 0):.8g}` فوق سعر البداية `{float(e.get('p0') or 0):.8g}` — الحماية تمنع الشراء الجديد هنا: "
                    f"يبيع الفائض فقط ويعيد شراء ما باعه أوطى بـ `{float(e.get('dist') or 0):g}%` · عند سعر البداية وتحته يعود لطريقته العادية\n{nl}")
        if e.get("rb"):                                       # 🔁 إعادة شراء مؤجلة (مكابح · ميزانية · رصيد · رفض)
            rs = {"brake": f"السعر نزل `{float(e.get('drop') or 0):.1f}%` عن أعلى سعر خلال 24 ساعة — مكابح الانهيار تمنع الشراء",
                  "cap": f"الميزانية ممتلئة (كلفة العملة `{float(e.get('expo') or 0):.2f}$` من `{float(e.get('cap') or 0):g}$`)",
                  "balance": f"رصيد الدولار لا يكفي (`{float(e.get('need') or 0):.2f}$`)"}.get(why) or f"رفضت المنصة الأمر (رمز `{e.get('code')}`)"
            return f"⏸ *إعادة الشراء مؤجلة — مسار القيمة — `{sym}`*\n{rs} — تُعاد المحاولة كل دقيقة\n{nl}"
        if why == "brake":
            return (f"🧯 *مسار القيمة مؤجَّل — `{sym}`*\nالسعر نزل `{float(e.get('drop') or 0):.1f}%` عن أعلى سعر خلال 24 ساعة"
                    f" — مكابح الانهيار تمنع الشراء والهدف لا يتقدّم\n{nl}")
        if why == "cap":
            return (f"🛡️ *الميزانية ممتلئة — `{sym}`*\nكلفة العملة `{float(e.get('expo') or 0):.2f}$` من `{float(e.get('cap') or 0):g}$`"
                    f" — لا شراء والهدف لا يتقدّم حتى يبيع البوت فائضاً\n{nl}")
        if why == "balance":
            return (f"⚠️ *مسار القيمة مؤجَّل — `{sym}`*\nرصيد الدولار لا يكفي (`{float(e.get('need') or 0):.2f}$`) — لم يحدث شيء ويُعاد "
                    + ("عند المستوى القادم" if _va_pm(cfg) else "في الموعد القادم") + f"\n{nl}")
        if why == "nocoin":
            return (f"🚫 *مسار القيمة لم يستطع البيع — `{sym}`*\nالعملة في المحفظة أقل مما يحمله البوت — هل سُحبت أو بيعت يدوياً؟"
                    f" (أو صرفها بوت آخر على العملة نفسها)\n{nl}")
        return f"⚠️ *مسار القيمة مؤجَّل — `{sym}`*\nرفضت المنصة الأمر (رمز `{e.get('code')}`) — السبب بسجل البوت\n{nl}"
    return ""


def deploy_va(data):
    """💹 v3.34.0: ينشئ بوت «مسار القيمة». الإعدادات كلها تتغيّر لاحقاً من الكرت (⚙️) — إلا العملة والمحفظة والجدول."""
    sym = str(data.get("symbol", "")).strip().upper()
    if not sym or "-" not in sym:
        return {"ok": False, "msg": "اكتب الرمز كاملاً مثل XRP-USDT"}
    base = sym.split("-")[0]
    fixed = str(data.get("va_mode") or "fixed") == "fixed"
    pm = str(data.get("trigger") or "time") == "price"           # 📉📈 v3.35.0
    try:
        drop = float(data.get("drop_pct") if data.get("drop_pct") not in (None, "") else 5)
        rise = float(data.get("rise_pct") if data.get("rise_pct") not in (None, "") else drop)
        start = float(data.get("start_usd") or 0)
        step = 0.0 if fixed else float(data.get("step_usd") or 0)
        every = int(float(data.get("every") if data.get("every") not in (None, "") else 1))
        band = float(data.get("band_pct") if data.get("band_pct") not in (None, "") else 4)
        mo = float(data.get("max_order") or 0)
        cap = float(data.get("cap") or 0)
        brake = float(data.get("brake_pct") or 0)
        gpct = float(data.get("guard_pct") if data.get("guard_pct") not in (None, "") else 5)
        hgp = float(data.get("hg_pct") or 0)                   # ♾️×💹 v3.36.6: الشبكة فوق سعر التشغيل
        hgu = float(data.get("hg_usd") or 0)
        hgrp = float(data.get("hg_ri_pct") if data.get("hg_ri_pct") not in (None, "") else 100)
    except Exception:
        return {"ok": False, "msg": "تأكد من الأرقام في كل الخانات"}
    guard = bool(data.get("guard_on", False))                   # 🛡️ v3.36.5: الحماية فوق سعر البداية (اختياري)
    hg = guard and (hgp > 0 or hgu > 0)
    w0 = str(data.get("first_src") or "buy") == "wallet"         # 👛 v3.36.11: أول طلب من المحفظة
    try:
        wq = float(data.get("wallet_q") or 0) if w0 else 0.0
    except Exception:
        return {"ok": False, "msg": "تأكد من الأرقام في كل الخانات"}
    if w0 and not (wq == wq and 0 <= wq < 1e15):
        return {"ok": False, "msg": "كمية العملة من المحفظة غير صحيحة"}
    if hg and not (0.1 <= hgp <= 20):
        return {"ok": False, "msg": "درجة الشبكة (التعاوني) من 0.1% إلى 20%"}
    if hg and not (1 <= hgu <= 1e7):
        return {"ok": False, "msg": "دولار أمر الشبكة (التعاوني) 1$ فأكثر"}
    if hg and not (0 <= hgrp <= 100):
        return {"ok": False, "msg": "نسبة إعادة استثمار الشبكة من 0% إلى 100%"}
    if guard and not hg and not pm and not (0.5 <= gpct <= 50):
        return {"ok": False, "msg": "مسافة إعادة الشراء (الحماية) من 0.5% إلى 50%"}
    if not all(x == x and abs(x) != float("inf") for x in (start, step, band, mo, cap, brake, drop, rise)):
        return {"ok": False, "msg": "تأكد من الأرقام في كل الخانات"}
    if pm and not (0.5 <= drop <= 50):
        return {"ok": False, "msg": "نسبة النزول للشراء من 0.5% إلى 50%"}
    if pm and not (0.5 <= rise <= 100):
        return {"ok": False, "msg": "نسبة الصعود للبيع من 0.5% إلى 100%"}
    unit = str(data.get("unit") or "d")
    if unit not in ("h", "d"):
        unit = "d"
    at = str(data.get("at") or "").strip()
    if unit == "h":
        at = ""
    elif at:
        m_ = re.fullmatch(r"(\d{1,2}):(\d{2})", at)
        if not m_ or int(m_.group(1)) > 23 or int(m_.group(2)) > 59:
            return {"ok": False, "msg": "الساعة بصيغة 24 ساعة مثل 09:30"}
        at = f"{int(m_.group(1)):02d}:{m_.group(2)}"
    if start < 1:
        return {"ok": False, "msg": "الهدف الأول (قيمة العملة المطلوبة) لا يقل عن 1$"}
    if not fixed and step <= 0:
        return {"ok": False, "msg": "في وضع «الهدف المتزايد» يجب أن يكون مبلغ الخطوة أكبر من صفر (أو اختر «قيمة ثابتة»)"}
    if every < 1 or every > {"h": 720, "d": 90}[unit]:
        return {"ok": False, "msg": "الفترة: ساعات 1–720 · أيام 1–90"}
    if not (0 <= band <= 50):
        return {"ok": False, "msg": "النطاق من 0% إلى 50%"}
    if mo < 1:
        return {"ok": False, "msg": "أقصى أمر واحد لا يقل عن 1$"}
    if cap <= 0:
        return {"ok": False, "msg": "حدّد الميزانية — أقصى كلفة للعملة التي يحملها البوت ($) — تحميك إذا نزل السعر طويلاً"}
    if cap + 1e-9 < max(mo, start):
        return {"ok": False, "msg": "الميزانية يجب أن تكون أكبر من أو تساوي الهدف الأول وأقصى أمر"}
    if not (0 <= brake <= 90):
        return {"ok": False, "msg": "مكابح الانهيار من 0% (مطفأة) إلى 90%"}
    try:                                                   # 📏 حد OKX للكمية (قراءة عامة — بلا مفاتيح)
        _sp = _acc_spec(sym)
        _px = float(_acc_price(sym) or 0)
        _mn = float(_sp.get("minSz") or 0)
        if _mn > 0 and _px > 0 and start / _px + 1e-12 < _mn:
            return {"ok": False, "msg": f"الهدف الأول أصغر من حد OKX: أقل كمية {_mn:g} {base} (≈ {_mn * _px:.2f}$)"}
    except Exception:
        pass
    keys = wallet_keys(data.get("wallet", "")) or {
        "api_key": str(data.get("api_key", "")).strip(),
        "secret_key": str(data.get("secret_key", "")).strip(),
        "passphrase": str(data.get("passphrase", "")).strip()}
    if not keys["api_key"]:
        return {"ok": False, "msg": "اختر محفظة أو أدخل مفاتيح API"}
    folder = _new_bot_folder("va_" + base.lower())               # 🆔 v3.36.20: كود عشوائي لكل بوت
    full = os.path.join(ROOT, folder)
    os.makedirs(full, exist_ok=True)
    cfg = {**keys, "symbol": sym, "bot_type": "rec_va", "mode": "avg", "start_usd": start, "step_usd": step, "every": every, "unit": unit,
           "at": at, "start_now": bool(data.get("start_now", True)), "band_pct": band, "max_order": mo, "cap": cap,
           "floor_on": bool(data.get("floor_on", True)), "brake_pct": brake, "trigger": "price" if pm else "time",
           **({"drop_pct": drop, "rise_pct": rise} if pm else {}),
           "guard_on": guard, **({"guard_pct": gpct} if guard and not pm and not hg else {}),
           **({"hg_pct": hgp, "hg_usd": hgu, "hg_ri": bool(data.get("hg_ri")), "hg_ri_pct": hgrp, "hg_wallet": bool(data.get("hg_wallet"))} if hg else {}),
           **({"first_src": "wallet", "wallet_q": round(wq, 12)} if w0 else {}),                 # 👛 v3.36.11
           "bot_id": "HR" + _hl.md5(os.path.abspath(full).encode()).hexdigest()[:10].upper(),     # 🆔 نفس معادلة المحرك (الرقابة تعرف أوامره)
           "auto_restart": bool(data.get("auto", True))}
    save_json_atomic(os.path.join(full, f"config_{sym}.json"), cfg)
    eng_src, eng_script, _ = engine_for(cfg)
    with open(os.path.join(full, eng_script), "w", encoding="utf-8") as f:
        f.write(eng_src)
    _drop_reinvest(full)
    b = {"dir": full, "cfg_path": os.path.join(full, f"config_{sym}.json"), "cfg": cfg, "symbol": sym}
    ok, msg = launch(b)
    return {"ok": ok, "msg": ("✅ انطلق بوت مسار القيمة — " + sym + " · " + _va_cfg_txt(cfg)) if ok else msg, "dir": folder}


def va_w0_api(data):
    """👛 v3.36.11 — قبل التشغيل بـ«أول طلب من المحفظة»: كم عملة حرة بمحفظتك (رصيد OKX الحر − ما تحتاجه بوتاتك الأخرى بنفس المحفظة
    والعملة) · كم يأخذ منها بسعر السوق الآن · كم يشتري من السوق — اللوحة تعرضه وتطلب موافقتك قبل التشغيل (قراءة فقط · بلا أوامر · بلا مفاتيح للواجهة)"""
    sym = str(data.get("symbol", "")).strip().upper()
    if not sym or "-" not in sym:
        return {"ok": False, "msg": "اكتب الرمز كاملاً مثل XRP-USDT"}
    base = sym.split("-")[0]
    try:
        T = float(data.get("start_usd") or 0)
    except Exception:
        T = 0.0
    if T < 1:
        return {"ok": False, "msg": "الهدف الأول (قيمة العملة المطلوبة) لا يقل عن 1$"}
    keys = wallet_keys(data.get("wallet", "")) or {
        "api_key": str(data.get("api_key", "")).strip(), "secret_key": str(data.get("secret_key", "")).strip(),
        "passphrase": str(data.get("passphrase", "")).strip()}
    if not keys["api_key"]:
        return {"ok": False, "msg": "اختر محفظة أو أدخل مفاتيح API"}
    try:
        px = float(PX.get(sym) or 0) or float(_acc_price(sym) or 0)
    except Exception:
        px = 0.0
    if px <= 0:
        return {"ok": False, "msg": "سعر العملة غير معروف الآن — أعد المحاولة"}
    r = _okx_get(f"/api/v5/account/balance?ccy={base}", keys["api_key"], keys["secret_key"], keys["passphrase"])
    if not r or str(r.get("code")) != "0" or not isinstance(r.get("data"), list) or not r["data"]:
        return {"ok": False, "msg": "تعذّر قراءة رصيد المحفظة من OKX — أعد المحاولة"}
    av = 0.0
    for d in (r["data"][0].get("details") or []):
        if str(d.get("ccy")) == base:
            av = max(0.0, float(d.get("availBal") or 0))
    claims, who = 0.0, []
    for b in bot_dirs().values():
        try:
            if str((b.get("cfg") or {}).get("api_key") or "").strip() != keys["api_key"] or b["symbol"].split("-")[0] != base:
                continue
            c = float((_gd_free_claims(b, load_json(paths_of(b)[0]) or {}) or {}).get(base) or 0)
            if c > 1e-12:
                claims += c
                who.append(f"{os.path.basename(b['dir'])} ({c:.8g})")
        except Exception:
            continue
    free = max(0.0, av - claims)
    need = T / px
    q = min(need, free)
    try:
        lot = float((_acc_spec(sym) or {}).get("lotSz") or 0)
    except Exception:
        lot = 0.0
    q = (math.floor(q / lot + 1e-9) * lot) if lot > 0 else math.floor(q * 1e8) / 1e8
    q = max(0.0, round(q, 12))
    rest = max(0.0, T - q * px)
    return {"ok": True, "base": base, "px": px, "T": round(T, 6), "av": round(av, 12), "claims": round(claims, 12), "who": who[:6],
            "free": round(free, 12), "need": round(need, 12), "q": q, "usd": round(q * px, 6), "rest": round(rest, 6), "buy": rest >= 1.0}


def va_plan_api(data):
    """📋 v3.35.0: جدول ما قبل التشغيل — نفس قراءة إعدادات النشر (بلا مفاتيح ولا كتابة) ⇒ va_plan عند السعر الحالي ·
    👆 v3.35.1: «at» = مستوى مختار بجدول النزول (جدول البيع من عنده) · «dir» = بوت شغّال (نفس جدول كرته من حالته — قراءة فقط)"""
    try:
        at = max(0, min(150, int(float(data.get("at") or 0))))
    except Exception:
        at = 0
    d_rel = str(data.get("dir") or "").strip()
    if d_rel:
        bots = bot_dirs()
        full = os.path.realpath(os.path.join(ROOT, d_rel))
        b = bots.get(full) if full.startswith(os.path.realpath(ROOT)) else None
        if not b or not _is_va(b):
            return {"ok": False, "msg": "مجلد غير معروف"}
        st = load_json(paths_of(b)[0]) or {}
        cp = float(PX.get(b["symbol"]) or st.get("px") or 0)
        sv = (_INST_CACHE.get(b["symbol"]) or {}).get("v") or {}
        if cp <= 0:
            return {"ok": False, "msg": "السعر غير معروف الآن"}
        return va_plan(b["cfg"], st, cp, down=150, up=10, mn=float(sv.get("minSz") or 0), keep=25, lot=float(sv.get("lotSz") or 0), at=at)
    sym = str(data.get("symbol", "")).strip().upper()
    try:
        px = float(data.get("px") or 0)
    except Exception:
        px = 0.0
    if px <= 0 and sym and "-" in sym:
        try:
            px = float(_acc_price(sym) or 0)
        except Exception:
            px = 0.0
    fixed = str(data.get("va_mode") or "fixed") == "fixed"
    try:
        cfg = {"trigger": "price" if str(data.get("trigger") or "time") == "price" else "time",
               "start_usd": float(data.get("start_usd") or 0), "step_usd": 0.0 if fixed else float(data.get("step_usd") or 0),
               "band_pct": float(data.get("band_pct") if data.get("band_pct") not in (None, "") else 4),
               "drop_pct": float(data.get("drop_pct") if data.get("drop_pct") not in (None, "") else 5),
               "max_order": float(data.get("max_order") or 0), "cap": float(data.get("cap") or 0), "floor_on": bool(data.get("floor_on", True)),
               "guard_on": bool(data.get("guard_on", False)), "guard_pct": float(data.get("guard_pct") if data.get("guard_pct") not in (None, "") else 5),
               "hg_pct": float(data.get("hg_pct") or 0), "hg_usd": float(data.get("hg_usd") or 0), "hg_ri": bool(data.get("hg_ri")),
               "hg_ri_pct": float(data.get("hg_ri_pct") if data.get("hg_ri_pct") not in (None, "") else 100)}
        cfg["rise_pct"] = float(data.get("rise_pct") if data.get("rise_pct") not in (None, "") else cfg["drop_pct"])
    except Exception:
        return {"ok": False, "msg": "تأكد من الأرقام"}
    mn = lot = 0.0
    if px > 0 and sym and "-" in sym:
        try:
            sv = _acc_spec(sym)
            mn, lot = float(sv.get("minSz") or 0), float(sv.get("lotSz") or 0)
        except Exception:
            mn = lot = 0.0
    r = va_plan(cfg, None, px if px > 0 else 1.0, down=80, up=15, mn=mn, lot=lot, at=at)
    r["px_known"] = px > 0
    return r

# ═══════════ 🧪 v3.36.0: الاختبار على مسار تجريبي — محرك البوت نفسه (المدمج هنا، بلا أي تعديل) داخل صندوق مغلق ═══════════
#   منصة تجريبية تعيد مساراً عشوائياً واقعياً للسعر يبدأ وينتهي عند السعر نفسه ⇒ كل فرق بالمحفظة هو ما صنعه البوت ·
#   ساعة افتراضية · مفاتيح وهمية · بلا شبكة أصلاً · عملية منفصلة بأولوية منخفضة · لا تلمس البوتات ولا الدفاتر ولا الإشعارات.
#   المحرك يرى العالم الذي يراه على OKX نفسه (مكتبة okx · نقاط REST · الوقت) ⇒ أي تحديث للمحركات مستقبلاً يُختبر كما هو.
#   الإعدادات = ما يكتبه النشر نفسه بالحرف: دالة النشر الحقيقية تُستدعى داخل العملية المنفصلة على مجلد مؤقت (بلا تشغيل ولا مفاتيح).
import random as _bt_rnd, types as _bt_types, builtins as _bt_bi, io as _bt_io, itertools as _bt_it, tempfile as _bt_tmp
import datetime as _bt_dtm
import urllib.parse as _bt_up
