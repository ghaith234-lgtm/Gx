def _loss_split(bt, c, lots):
    """🔁 خروج «كل أمر على حدا» شمل أكثر من أمر (بيع يدوي للكل/لأوامر مختارة): نتيجة كل أمر لحاله من نفس التنفيذ —
    الشرائي: عملات الأمر × (الدولار الصافي ÷ العملات المباعة) − كلفته · البيعي: دولار الأمر × (العملات الراجعة ÷ الدولار المصروف) − عملاته.
    `lots` = لقطة الأوامر قبل الخروج {id: [q, c]}. يرجع [(id, النتيجة, الكلفة, الراجع)] — أو None لو اللقطة ناقصة أو ما تطابق السجل
    (⇒ الخروج ينحسب كمجموعة وحدة)."""
    ids = [str(x) for x in (c.get("lots") or [])]
    if not ids or any(i not in lots for i in ids):
        return None
    try:
        out, inn, cost = float(c.get("out") or 0), float(c.get("in") or 0), float(c.get("cost") or 0)
        Q = sum(float(lots[i][0]) for i in ids)
        C = sum(float(lots[i][1]) for i in ids)
    except Exception:
        return None
    res = []
    if bt == "rec_buy":
        if Q <= 0 or out <= 0 or abs(C - cost) > 1e-6 + 1e-6 * abs(cost):
            return None
        den = max(out, Q)
        for i in ids:
            q, cc = float(lots[i][0]), float(lots[i][1])
            got = inn * q / den
            res.append((i, got - cc, cc, got))
    else:
        if C <= 0 or out <= 0 or abs(Q - cost) > 1e-9 + 1e-6 * abs(cost):
            return None
        den = max(out, C)
        for i in ids:
            q, cc = float(lots[i][0]), float(lots[i][1])
            back = inn * cc / den
            res.append((i, back - q, q, back))
    return res


def _loss_fmt(it):
    u = it.get("ccy") or ""
    a = float(it.get("amt") or 0)
    return (f"{a:.4f}$" if u == "USDT" else f"{a:.8g} {u} ≈ {float(it.get('usd') or 0):.4f}$")


def loss_tick():
    """📉 v3.25.4: يقرا الخسائر الجديدة من سجلات البوتات والمُراكِمات (قراءة بس — ولا شي يتحرك ولا يتغيّر ببوت أو دفتر ربح).
    كل سجل خروج ينقرا مرة وحدة (`done`) · الأوامر المفتوحة للدوري تنحفظ لقطتها (`lots`) حتى خروج يدوي لأكثر من أمر
    ينحسب أمر أمر. يرجع عدد الخسائر الجديدة."""
    with _LOSS_LOCK:
        L = _loss_load()
        now = time.time()
        ch = False
        if not L.get("since"):
            L = {"v": 1, "since": now, "since_d": datetime.now().strftime("%Y-%m-%d %H:%M"), "items": [], "done": [], "lots": {}}
            ch = True
        since = float(L["since"])
        items = L.setdefault("items", [])
        have = {str(x.get("id")) for x in items if isinstance(x, dict)}
        done = [str(x) for x in (L.get("done") or [])]
        dset = set(done)
        lc = L.setdefault("lots", {})
        live, new = set(), []
        try:
            labs = _pf_wallets()[1]
        except Exception:
            labs = {}

        def mark(i):
            dset.add(i); done.append(i)

        def put(it):
            if it["id"] not in have:
                have.add(it["id"]); new.append(it)

        for b in bot_dirs().values():
            cfg = b.get("cfg") or {}
            bt = str(cfg.get("bot_type") or "")
            if cfg.get("is_demo") or bt not in ("dca", "dca_buy") + _REC_T:
                continue
            st = _safe(load_json, paths_of(b)[0], default=None)
            if not isinstance(st, dict):
                continue
            key = os.path.relpath(b["dir"], ROOT)
            k_ = str(cfg.get("api_key") or "").strip()
            w = _gd_wid(k_) if k_ else ""
            sym = b["symbol"]
            base, quote = (sym.split("-") + ["USDT"])[:2]
            com = {"w": w, "wl": labs.get(w, ""), "bot": key, "name": sym, "sym": sym}
            if bt in ("dca", "dca_buy"):
                for c in (st.get("cycles_log") or []):
                    if not isinstance(c, dict) or not c.get("id"):
                        continue
                    cid = "dca:" + str(c["id"])
                    live.add(cid)
                    try:
                        ts, p, px = float(c.get("ts") or 0), float(c.get("profit") or 0), float(c.get("px") or 0)
                    except Exception:
                        continue
                    if cid in dset or ts < since:
                        continue
                    mark(cid); ch = True
                    if p < -1e-12:
                        ccy = base if bt == "dca" else quote
                        put(dict(com, id=cid, ts=ts, src=bt, ccy=ccy, amt=round(-p, 10), px=px,
                                 usd=round(-p * px if ccy != quote else -p, 6), n=c.get("n"), manual=bool(c.get("manual"))))
                continue
            mode = str(st.get("mode") or cfg.get("mode") or "lots")
            cache = lc.setdefault(key, {})
            ccy = quote if bt == "rec_buy" else base
            for c in (st.get("cycles_log") or []):
                if not isinstance(c, dict) or not c.get("id"):
                    continue
                cid = "rec:" + str(c["id"])
                live.add(cid)
                try:
                    ts, p, px = float(c.get("ts") or 0), float(c.get("profit") or 0), float(c.get("px") or 0)
                except Exception:
                    continue
                ids = [str(x) for x in (c.get("lots") or [])]
                if cid in dset or ts < since:
                    for i in ids:
                        cache.pop(i, None)
                    continue
                mark(cid); ch = True
                val = (lambda a: round(a, 6)) if ccy == quote else (lambda a, px=px: round(a * px, 6))
                parts = _loss_split(bt, c, cache) if (mode != "avg" and len(ids) > 1) else None
                if parts is not None:
                    for (lid, pnl, cost, got) in parts:
                        if pnl < -1e-12:
                            put(dict(com, id=cid + "|" + lid, ts=ts, src="rec_lot", ccy=ccy, amt=round(-pnl, 10), px=px, usd=val(-pnl),
                                     n=c.get("n"), lot=lid, manual=bool(c.get("manual")), cost=round(cost, 10), got=round(got, 10)))
                elif p < -1e-12:
                    put(dict(com, id=cid, ts=ts, src="rec_avg" if mode == "avg" else "rec_lot", ccy=ccy, amt=round(-p, 10), px=px, usd=val(-p),
                             n=c.get("n"), lot=(ids[0] if len(ids) == 1 else ""), lots=len(ids), grp=bool(mode != "avg" and len(ids) > 1),
                             manual=bool(c.get("manual")), cost=c.get("cost"), got=c.get("in")))
                for i in ids:
                    cache.pop(i, None)
            cur = {}
            for l in (st.get("lots") or []):
                if isinstance(l, dict) and l.get("id"):
                    try:
                        cur[str(l["id"])] = [round(float(l.get("q") or 0), 12), round(float(l.get("c") or 0), 10)]
                    except Exception:
                        pass
            for i, v in cur.items():
                if cache.get(i) != v:
                    cache[i] = v; ch = True
            if len(cache) > 1000:
                for i in [i for i in cache if i not in cur][:len(cache) - 1000]:
                    cache.pop(i, None)
        try:
            ast = acc_state() or {}
            cmap = {a.get("id"): a for a in (acc_cfgs() or []) if isinstance(a, dict)}
        except Exception:
            ast, cmap = {}, {}
        for aid, e in (ast.items() if isinstance(ast, dict) else []):
            if str(aid).startswith("_") or not isinstance(e, dict):
                continue
            a = cmap.get(aid) or {}
            sym = str(a.get("symbol") or "")
            w = (_safe(acc_wid, a, default="") or "") if a else ""
            for x in (e.get("sells") or []):
                if not isinstance(x, dict):
                    continue
                sid = f"acc:{aid}|{x.get('ts')}"
                live.add(sid)
                try:
                    ts, p = float(x.get("ts") or 0), float(x.get("profit") or 0)
                except Exception:
                    continue
                if sid in dset or ts < since:
                    continue
                mark(sid); ch = True
                if p < -1e-9:
                    usd = float(x.get("usd") or 0)
                    put({"id": sid, "ts": ts, "w": w, "wl": labs.get(w, ""), "bot": aid, "name": a.get("name") or sym or aid, "sym": sym,
                         "src": "acc", "ccy": "USDT", "amt": round(-p, 6), "usd": round(-p, 6), "px": x.get("px"), "qty": x.get("qty"),
                         "got": round(usd, 6), "cost": round(usd - p, 6), "manual": str(x.get("why") or "") != "آلي", "why": str(x.get("why") or "")[:40]})
        if new:
            new.sort(key=lambda it: float(it.get("ts") or 0))
            items.extend(new)
            for it in new:
                _safe(journal, "loss", f"📉 {LOSS_SRC.get(it['src'], it['src'])}: −{_loss_fmt(it)} — {it.get('name')}"
                      + (f" · #{it.get('n')}" if it.get("n") is not None else "") + (f" · أمر {it.get('lot')}" if it.get("lot") else "")
                      + (" · يدوي" if it.get("manual") else "") + (f" · {it.get('wl')}" if it.get("wl") else ""), "warn",
                      bot=str(it.get("bot") or ""), sym=str(it.get("sym") or ""), src=it["src"], amount=it.get("amt"), ccy=it.get("ccy"),
                      usd=it.get("usd"), wallet=it.get("w"), loss=it["id"], default=None)
            ch = True
        if len(items) > LOSS_KEEP:
            L["items"] = items[-LOSS_KEEP:]
        if ch:
            L["done"] = list(dict.fromkeys([x for x in done if x in live] + done[-30000:]))
            _safe(save_json_atomic, LOSS_FILE, L, default=None)
        return len(new)


def loss_view(w=None, src=None, d_from=None, d_to=None, limit=500):
    """📉 صفحة الخسائر: لكل محفظة مجموعها (دولار + كل عملة + ما يقابلها بالدولار وقتها) ومنين جت · والقائمة بالفلاتر"""
    _safe(loss_tick, default=None)
    L = _loss_load()
    items = [x for x in (L.get("items") or []) if isinstance(x, dict)]
    try:
        labs = _pf_wallets()[1]
    except Exception:
        labs = {}
    lab = lambda x: labs.get(x.get("w") or "") or x.get("wl") or ("محفظة غير معروفة" if not x.get("w") else str(x.get("w")))
    day = lambda x: datetime.fromtimestamp(float(x.get("ts") or 0)).strftime("%Y-%m-%d")

    def acc(e, x):
        a = float(x.get("amt") or 0)
        if x.get("ccy") == "USDT":
            e["usd"] = round(e["usd"] + a, 6)
        else:
            e["coins"][x["ccy"]] = round(e["coins"].get(x["ccy"], 0.0) + a, 10)
        e["eq"] = round(e["eq"] + float(x.get("usd") or 0), 6)
        e["n"] += 1

    blank = lambda: {"usd": 0.0, "coins": {}, "eq": 0.0, "n": 0}
    W = {}
    for x in items:
        wk = x.get("w") or ""
        e = W.setdefault(wk, dict(blank(), wid=wk, label=lab(x), src={}))
        acc(e, x)
        acc(e["src"].setdefault(x.get("src") or "?", blank()), x)
    sel = [x for x in items if (not w or (x.get("w") or "") == w) and (not src or x.get("src") == src)
           and (not d_from or day(x) >= d_from) and (not d_to or day(x) <= d_to)]
    S = dict(blank(), src={}, days={})
    for x in sel:
        acc(S, x)
        acc(S["src"].setdefault(x.get("src") or "?", blank()), x)
        acc(S["days"].setdefault(day(x), blank()), x)
    out = []
    for x in reversed(sel[-int(limit or 500):]):
        y = {k: x.get(k) for k in ("id", "ts", "w", "src", "bot", "name", "sym", "ccy", "amt", "usd", "px", "n", "lot", "lots", "grp", "manual", "cost", "got", "qty", "why")}
        y.update(wl=lab(x), src_t=LOSS_SRC.get(x.get("src"), x.get("src")), day=day(x))
        out.append(y)
    return {"ok": True, "since": L.get("since"), "since_d": L.get("since_d"), "srcs": LOSS_SRC,
            "wallets": sorted(W.values(), key=lambda e: -e["eq"]), "sel": S, "n": len(sel), "n_all": len(items), "items": out}


def _ri_eligible(b, cfgs=None):
    """(مُراكِمات مؤهلة، سبب الانتظار) — نفس العملة · مفعّل · نسبة عملة > 0 · **نفس المحفظة**.

    التسليم دفتري (ما ينقل عملة بين المحافظ) ⇒ لو المُراكِم على محفظة ثانية، العملة
    فعلياً مو عنده — فما نسجّلها له؛ تنتظر وتطلع بالرقابة."""
    cfgs = acc_cfgs() if cfgs is None else cfgs
    base = b["symbol"].split("-")[0].upper()
    bk = str((b.get("cfg") or {}).get("api_key") or "").strip()
    bw = _gd_wid(bk) if bk else ""
    same = [a for a in cfgs if str(a.get("symbol", "")).split("-")[0].upper() == base]
    if not same:
        return [], f"ماكو مُراكِم لعملة {base}"
    samew = [a for a in same if acc_wid(a) == bw]          # 👛 v3.22.9: كل مُراكِم على محفظته — العملة لمُراكِم نفس محفظة البوت بس
    if not samew:
        return [], f"مُراكِم {base} على محفظة ثانية — العملة تبقى بمحفظة البوت (كل محفظة حسابها مستقل)"
    mine = [a for a in samew if a.get("enabled", True) and float(a.get("coin_pct") or 0) > 0]
    if not mine:
        if not any(a.get("enabled", True) for a in samew):
            return [], f"مُراكِم {base} (بنفس المحفظة) موقوف"
        return [], f"«نسبة العملة» بمُراكِم {base} صفر — خلّيها 100%"
    return mine, ""


def accum_coin_handoff():
    """🪙 يستلم العملة المحرَّرة من إعادة الاستثمار ويوزّعها مباشرة على المُراكِم — خلال ثوانٍ.

    العملة مشتراة أصلاً — فما بيه شراء ولا عمولة. تنضاف للكمية، وتكلفتها
    تنضاف لـspent، فالمعدّل يندمج لحاله:  المعدّل = spent ÷ coin

    🔒 آمن ذاتياً: الزيادة وعلامة «انسلّم» بنفس الكتابة الذرّية — لو كتابة قديمة مسحتهما
       سوية يعاد التسليم بالدورة الجاية، فما يضيع وما يتكرر. والقفل `_ACC_IO` يمنع
       التداخل ويا جولة نص الليل والأزرار.
    ⏳ ماكو مُراكِم مؤهل ⇒ **ينتظر** (ما ينعلّم مستلماً) ويطلع بالرقابة بسببه.
    بوابتا الحد الأدنى والنطاق **ما تنطبقان** — هذني تحكمان الشراء."""
    with _ACC_IO:
        cfgs = acc_cfgs()
        st = acc_state()
        seen = list(st.get("_ri_seen") or [])
        seen_set = set(seen)
        done = []
        live_h = set()                                   # 🔢 v3.25.4: كل تسليم لسه بسجل بوت (ما ينمسح من العلامات أبداً)
        for b in bot_dirs().values():
            try:
                bst = load_json(paths_of(b)[0]) or {}
            except Exception:
                continue
            allh = _ri_handoffs_of(bst) + _dca_handoffs_of(b, bst) + _rec_handoffs_of(b, bst)
            live_h.update(str(h.get("id")) for h in allh if h.get("id"))
            his = [h for h in allh if h.get("id") not in seen_set]
            if not his:
                continue
            mine, _why = _ri_eligible(b, cfgs)
            _bk = str((b.get("cfg") or {}).get("api_key") or "").strip()
            _bw = _gd_wid(_bk) if _bk else "?"                 # 👛 v3.22.9: الباقي محفوظ لكل محفظة (للرقابة)
            if not mine:
                # 👛 ماكو مُراكِم مفعّل يستلمها ⇒ تتحرر **للمحفظة مباشرة** (طلب المالك) — مسجّلة بمعرّفها
                for ho in his:
                    hid, coin = ho["id"], float(ho.get("coin") or 0)
                    seen_set.add(hid); seen.append(hid)
                    if coin > 0:
                        _bs = str(ho.get("symbol") or b["symbol"]).split("-")[0]
                        lf = st.setdefault("_ri_left", {}); lf[_bs] = round(float(lf.get(_bs) or 0) + coin, 10)
                        lw = st.setdefault("_ri_left_w", {}).setdefault(_bw, {}); lw[_bs] = round(float(lw.get(_bs) or 0) + coin, 10)
                        st.setdefault("_ri_left_log", {})[hid] = coin
                        done.append((str(ho.get("symbol") or b["symbol"]), _bs, coin, float(ho.get("avg_px") or 0), [], coin,
                                     str(ho.get("why") or "") + " · " + _why))
                continue
            tot_pct = sum(float(a.get("coin_pct") or 0) for a in mine)
            scale = 100.0 / tot_pct if tot_pct > 100.0 else 1.0
            for ho in sorted(his, key=lambda h: float(h.get("ts") or 0)):
                hid, coin, avg = ho["id"], float(ho.get("coin") or 0), float(ho.get("avg_px") or 0)
                if coin <= 0 or avg <= 0:
                    seen_set.add(hid); seen.append(hid)
                    continue
                sym = str(ho.get("symbol") or b["symbol"])
                base = sym.split("-")[0]
                given, rows = 0.0, []
                for a in mine:
                    q = round(coin * float(a.get("coin_pct") or 0) / 100.0 * scale, 10)
                    if q <= 0:
                        continue
                    e = st.setdefault(a["id"], {"pending": 0.0, "coin": 0.0, "spent": 0.0, "buys": []})
                    e["coin"] = round(float(e.get("coin", 0)) + q, 10)
                    e["spent"] = round(float(e.get("spent", 0)) + q * avg, 6)
                    e["buys"] = ([{"ts": time.time(), "qty": round(q, 10), "usd": round(q * avg, 6),
                                   "px": round(avg, 10), "why": "ربح DCA" if str(hid).startswith("dca:") else ("الدوري" if str(hid).startswith("rec:") else "إعادة استثمار"),
                                   "hid": hid}] + list(e.get("buys") or []))[:400]
                    given += q
                    rows.append((a.get("name") or sym, float(a.get("coin_pct") or 0), q, e["coin"],
                                 (e["spent"] / e["coin"]) if e["coin"] > 0 else 0.0))
                left = round(coin - given, 10)
                if left > 1e-12:                           # 👛 الباقي بقصد (نسبة أقل من 100%) — للرقابة
                    lf = st.setdefault("_ri_left", {})
                    lf[base] = round(float(lf.get(base) or 0) + left, 10)
                    lw = st.setdefault("_ri_left_w", {}).setdefault(_bw, {}); lw[base] = round(float(lw.get(base) or 0) + left, 10)
                    ll = st.setdefault("_ri_left_log", {})          # 🧾 باقي كل تسليم بمعرّفه — للتدقيق
                    ll[hid] = left
                seen_set.add(hid)
                seen.append(hid)
                done.append((sym, base, coin, avg, rows, left, str(ho.get("why") or "")))
        if not done:
            return 0
        # 🔢 v3.25.4: العلامات = كل اللي لسه بسجلات البوتات + آخر 30000 (قبل: آخر 3000 بس — بوتات كثيرة ⇒ تسليم قديم ينعاد مرة ثانية)
        st["_ri_seen"] = list(dict.fromkeys([x for x in seen if x in live_h] + seen[-30000:]))
        ll = st.get("_ri_left_log") or {}
        if len(ll) > 30000:                               # 🧾 باقي التسليمات: القديم اللي طلع من سجلات البوتات بس ينقص
            for _k in [k for k in ll if k not in live_h][:len(ll) - 30000]:
                ll.pop(_k, None)
        _acc_save(st)
    for sym, base, coin, avg, rows, left, why in done:
        _dcah = str(why or "").startswith("ربح DCA")
        _rech = "الدوري" in str(why or "")
        msg = (f"🪙 *{'ربح DCA محرَّر (عملة)' if _dcah else ('ربح الدوري محرَّر (عملة)' if _rech else 'عملة معاد استثمارها')} — {'للمُراكِم' if rows else 'للمحفظة'}*\n`{sym}` · {why or 'تحرير'}\n━━━━━━━━━━━━━\n"
               f"📦 المحرَّر: `{coin:.8f}` {base} @ `{avg:.8f}$` = `{coin * avg:.4f}$`\n━━━━━━━━━━━━━\n")
        for nm, pc, q, tq, ta in rows:
            msg += f"🏧 {_tp_md(nm)}: `{pc:.0f}%` ← `{q:.8f}` {base} · صار عنده `{tq:.8f}` بمعدل `{ta:.8f}$`\n"
        if left > 1e-12:
            msg += f"👛 {'تحررت للمحفظة' if not rows else 'بقى بالمحفظة'}: `{left:.8f}` {base}\n"
        msg += ("بلا شراء وبلا عمولة — انضافت مباشرة ومعدلها اندمج" if rows else "ماكو مُراكِم مفتوح على هالعملة بنفس المحفظة — بقت حرة بمحفظتك")
        tg_send(msg)
        log_event(f"🪙 [إعادة استثمار] {sym}: سُلّم {coin - left:.8f}/{coin:.8f} {base} @ {avg:.8f}$ "
                  f"({why}) على {len(rows)} مُراكِم · الباقي {left:.8f} للمحفظة")
    return len(done)


def handoff_loop():
    """🪙 يلحق تسليمات العملة خلال ثوانٍ من الإطفاء أو التفكيك — بدل انتظار جولة نص الليل."""
    time.sleep(8)
    while True:
        try:
            if acc_cfgs():
                accum_coin_handoff()
        except Exception as e:
            try:
                log_event(f"⚠️ [تسليم المُراكِم] {type(e).__name__}: {e}")
            except Exception:
                pass
        time.sleep(5)


def _acc_last_run():
    return (acc_state().get("_meta") or {}).get("last_run_day", "")

def _acc_mark_run(day):
    st = acc_state()
    st.setdefault("_meta", {})["last_run_day"] = day
    st["_meta"]["last_run_ts"] = time.time()
    _acc_save(st)

def _acc_has_pending():
    """هل في رصيد متراكم ينتظر شراءً؟"""
    st = acc_state()
    for a in acc_cfgs():
        if not a.get("enabled", True): continue
        e = st.get(a["id"]) or {}
        if float(e.get("pool", 0)) > 0:
            return True
        if e.get("inflight"):
            return True
    return False

def accum_loop():
    """⏰ الجولة الرئيسية: مرة واحدة بعد منتصف الليل (نهاية اليوم).
    وإعادة محاولة كل ساعة فقط إذا بقي رصيد معلّق (سعر خارج النطاق أو أمر ينتظر تأكيداً)."""
    while True:
        try:
            now = datetime.now()
            today = now.strftime("%Y-%m-%d")
            if _acc_last_run() != today:
                # 🌙 جولة اليوم (مرة واحدة — محفوظة على القرص فتنجو من إعادة التشغيل)
                #    التوزيع دائماً · الشراء فقط لو كنا داخل النافذة
                _acc_mark_run(today)
                _ACC_RUN["retry"] = time.time()
                accum_tick()
                _safe(profit_tick, default=None)      # 💰 v3.22.8: الباقي بعد المُراكِمات ⇒ الربح (نفس اللحظة)
            elif (acc_in_window() and time.time() - _ACC_RUN["retry"] >= 1800
                  and _acc_has_pending()):
                # ⏳ داخل النافذة ورصيد ينتظر (سعر خارج النطاق) — نعيد المحاولة
                _ACC_RUN["retry"] = time.time()
                accum_tick()
        except Exception:
            pass
        time.sleep(120)

def acc_withdraw(aid, amount):
    """📤 يحوّل مبلغاً من الرصيد المتراكم للصندوق النهائي — يصير دولار حر بحسابك، لا يُشترى به.
    v3.22.7: amount="all" ⇒ المتراكم كله بالضبط (زر «الكل» يعرض المبلغ مقرّب لسنتين) · فرق التقريب ≤ نص سنت ⇒ الكل."""
    st = acc_state()
    e = st.get(aid)
    if e is None:
        return False, "المُراكِم غير موجود"
    if e.get("inflight"):
        return False, "⏳ في أمر شراء ينتظر التأكيد — انتظر تسويته أولاً"
    pend = round(float(e.get("pending", 0)), 6)
    if str(amount).strip().lower() == "all":
        amt = pend
    else:
        try:
            amt = round(float(amount), 6)
        except Exception:
            return False, "رقم غير صحيح"
        if pend < amt <= pend + 0.005:
            amt = pend                  # 2 خانات بالواجهة ⇒ فرق تقريب، مو طلب أكبر من المتراكم
    if amt <= 0:
        return False, ("ماكو رصيد بالمتراكم" if pend <= 0 else "المبلغ لازم أكبر من صفر")
    if amt > pend + 1e-9:
        return False, f"المتراكم {pend:.2f}$ فقط — ما يصير تحويل {amt:.2f}$"
    e["pending"] = round(pend - amt, 6)
    e["withdrawn"] = round(float(e.get("withdrawn", 0)) + amt, 4)
    e["wlog"] = ([{"ts": time.time(), "usd": amt}] + list(e.get("wlog") or []))[:100]
    _acc_save(st)
    try:
        journal("accum", f"📤 {aid}: تحويل {amt:.2f}$ من المتراكم للصندوق النهائي — المتبقي {e['pending']:.2f}$", "ok",
                bot=aid, amount=amt, left=e["pending"], withdrawn=e["withdrawn"])
    except Exception:
        pass
    return True, f"📤 تحوّل {amt:.2f}$ للصندوق النهائي 💰 (دولار حر بحسابك) — المتبقي بالمتراكم {e['pending']:.2f}$"


def acc_coin_out(aid, qty):
    """📤 v3.23.1: جزء من مخزون المُراكِم (أو كله) ⇒ 🪙 الصندوق النهائي كعملة — ما تنباع ولا تتحرك بالمنصة.
    الكلفة تنزل بنسبتها (المتوسط يبقى) · الكل ⇒ الكلفة تصفّر · العملة باقية بحسابك ⇒ الرقابة تبقى تتوقعها (`_ri_left_w`) ·
    `cout` ينقيّد بالصندوق النهائي من `profit_tick`. يرجع (نجح، رسالة)."""
    a = next((x for x in acc_cfgs() if x.get("id") == aid), None)
    st = acc_state()
    e = st.get(aid)
    if a is None or e is None:
        return False, "المُراكِم غير موجود"
    if e.get("inflight") or e.get("sell_inflight"):
        return False, "⏳ في أمر ينتظر تأكيد المنصة — حوّل بعد ما يتسوّى"
    base = str(a.get("symbol") or "").split("-")[0]
    coin = round(float(e.get("coin") or 0), 10)
    if str(qty).strip().lower() == "all":
        q = coin
    else:
        try:
            q = round(float(qty), 10)
        except Exception:
            return False, "رقم غير صحيح"
    if q <= 0:
        return False, ("ماكو عملة بالمخزون" if coin <= 0 else "الكمية لازم أكبر من صفر")
    if q > coin + 1e-12:
        return False, f"المخزون {coin:.8g} {base} بس"
    q = min(q, coin)
    spent = float(e.get("spent") or 0)
    left = round(coin - q, 10)
    if left <= 1e-10:
        cost = round(spent, 6)
        e["coin"], e["spent"] = 0.0, 0.0            # الكل ⇒ تجميع جديد من الصفر
    else:
        cost = round(q * (spent / coin if coin > 0 else 0.0), 6)
        e["coin"], e["spent"] = left, round(spent - cost, 6)
    e["cout"] = ([{"ts": time.time(), "qty": round(q, 10), "cost": cost}] + list(e.get("cout") or []))[:200]
    wid = acc_wid(a) or "?"
    lf = st.setdefault("_ri_left", {})                # 🛡️ العملة باقية بحسابك ⇒ الرقابة تبقى تتوقعها
    lf[base] = round(float(lf.get(base) or 0) + q, 10)
    lw = st.setdefault("_ri_left_w", {}).setdefault(wid, {})
    lw[base] = round(float(lw.get(base) or 0) + q, 10)
    _acc_save(st)
    _safe(journal, "accum", f"📤 {a.get('name') or aid}: تحويل {q:.8g} {base} من المخزون للصندوق النهائي (كلفتها {cost:.4f}$) — الباقي {e['coin']:.8g}",
          "ok", bot=aid, sym=a.get("symbol", ""), coin=q, cost=cost, left=e["coin"], wallet=wid, default=None)
    return True, (f"📤 تحوّل {q:.8g} {base} للصندوق النهائي 💰 (عملة — باقية بحسابك) — الباقي بالمخزون {e['coin']:.8g}"
                  + (" · صُفّرت الكلفة" if left <= 1e-10 else ""))


# 🔒 ملف المُراكِم يكتب عليه أكثر من خيط (جولة نص الليل · الاستلام الفوري · أزرارك) ⇒ قفل واحد.
#    نلفّ الدوال من برّا — أجسامها بايت ببايت كما هي.
_ACC_IO = threading.RLock()


def _acc_locked(fn):
    def _w(*a, **k):
        with _ACC_IO:
            return fn(*a, **k)
    _w.__name__, _w.__doc__ = fn.__name__, fn.__doc__
    return _w


_acc_apply_sell = _acc_locked(_acc_apply_sell)
_acc_mark_run = _acc_locked(_acc_mark_run)
_acc_move_to_reserve = _acc_locked(_acc_move_to_reserve)
_acc_settle = _acc_locked(_acc_settle)
acc_buy_now = _acc_locked(acc_buy_now)
acc_sell_now = _acc_locked(acc_sell_now)
acc_settle_sell = _acc_locked(acc_settle_sell)
acc_withdraw = _acc_locked(acc_withdraw)
acc_coin_out = _acc_locked(acc_coin_out)
accum_tick = _acc_locked(accum_tick)



def acc_alloc_summary():
    """📊 محاسبة أرباح أمس — 👛 لكل محفظة لحالها (v3.22.9): ربح بوتاتها · وُزّع لمُراكِماتها · غير مخصّص (يمنع أي تكرار أو ضياع)"""
    y = (datetime.now() - timedelta(days=1)).strftime("%Y-%m-%d")
    prof = day_profit(y)
    st = acc_state()
    led = load_json(LEDGER) or {}
    live = _live_wmap()
    try:
        aw = acc_wallets()
    except Exception:
        aw = {}
    groups = []
    for k, e in led.items():
        if str(k).startswith("_") or not isinstance(e, dict):
            continue
        w = _led_wid(k, e, live)
        if w and float((e.get("daily") or {}).get(y) or 0) > 0 and w not in groups:
            groups.append(w)
    for a in acc_cfgs():
        if acc_wid(a) not in groups:
            groups.append(acc_wid(a))
    rows = []; total_alloc = 0.0; wallets = []
    for w in groups:
        wp = day_profit_w(y, w, led, live)
        wr, wa, wu = [], 0.0, 0.0
        for a in acc_cfgs():
            if acc_wid(a) != w:
                continue
            e = st.get(a["id"]) or {}
            share = float((e.get("days") or {}).get(y) or 0)
            wa += share
            wu += float(a.get("pct") or 0)
            wr.append({"id": a["id"], "name": a.get("name") or a.get("symbol"),
                       "pct": a.get("pct"), "coin_pct": a.get("coin_pct") or 0,
                       "share": round(share, 4),
                       "pool": round(float(e.get("pool", 0)), 4),
                       "reserve": round(float(e.get("pending", 0)), 4),
                       "enabled": a.get("enabled", True), "wid": w, "wlabel": (aw.get(w) or {}).get("label") or w})
        rows += wr
        total_alloc += wa
        wallets.append({"wid": w, "label": (aw.get(w) or {}).get("label") or w, "profit": round(wp, 4), "allocated": round(wa, 4),
                        "unallocated": round(wp - wa, 4), "used_pct": round(wu, 2), "free_pct": round(100 - wu, 2), "rows": wr})
    used = max([x["used_pct"] for x in wallets] or [0.0])
    return {"day": y, "profit": round(prof, 4), "allocated": round(total_alloc, 4),
            "unallocated": round(prof - total_alloc, 4),
            "used_pct": round(used, 2), "free_pct": round(100 - used, 2), "rows": rows, "wallets": wallets}


def acc_snapshot():
