        _pc = float(b["cfg"].get("trail_pct") or 0.3)
        return {"ok": True, "msg": (f"🛡️ الدرع اشتغل — أوامر الأمان تنسحب للذاكرة ويتتبّعها (ارتداد {_pc:g}%) · الإغلاق يتتبّع بعد الهدف"
                                    if _on else "🛡️ الدرع انطفى — أوامر الأمان ترجع حدود ثابتة على المنصة")}
    if action == "pause":
        sp, _, _ = paths_of(b)
        stt = load_json(sp) or {}
        stt["paused"] = True
        save_state_keys(sp, {"paused": True}) or save_json_atomic(sp, stt)   # 🔐 v3.21.10 (ب٢٨): الحقل بس
        return {"ok": True, "msg": "⏸ توقّف البوت مؤقتاً — أوامره تبقى على المنصة"}
    if action == "resume":
        sp, _, _ = paths_of(b)
        stt = load_json(sp) or {}
        stt["paused"] = False
        save_state_keys(sp, {"paused": False}) or save_json_atomic(sp, stt)   # 🔐 v3.21.10 (ب٢٨): الحقل بس
        return {"ok": True, "msg": "▶️ استأنف البوت العمل"}
    if action == "delete_purge":
        return delete_purge(b)
    if action == "delete":
