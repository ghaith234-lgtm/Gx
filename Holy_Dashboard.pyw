  --modal-bg:linear-gradient(165deg,#15212e,#080d13);--tip-bg:#121c27;--coin-bg:#16222f;--chart-bg:#080d13;--card2:#101923;--bd:#253546;--on-acc:#08131c}
html[data-theme="sky"]{color-scheme:light;--bg0:#eef5fb;--bg1:#ffffff;--tx:#0f1d2e;--mut:#4d5f73;--mut2:#5f7186;
  --vio-rgb:3 105 161;--vio2-rgb:7 89 133;--vio3-rgb:2 132 199;--cyan-rgb:124 58 237;--cyan2-rgb:109 40 217;--cyan3-rgb:124 58 237;
  --green-rgb:4 120 87;--green2-rgb:22 163 74;--red-rgb:190 18 60;--red2-rgb:220 38 38;--amber-rgb:180 83 9;--amber2-rgb:217 119 6;--amber3-rgb:180 83 9;
  --blue-rgb:37 99 235;--ov-rgb:15 29 46;--sh-rgb:70 95 125;--surf-rgb:255 255 255;--surf2-rgb:255 255 255;--surf3-rgb:248 251 254;--surf4-rgb:255 255 255;--scrim-rgb:228 238 247;
  --hi:#0f1d2e;--on-acc:#ffffff;--on-green:#ffffff;--red-soft:#9f1239;--green-soft:#065f46;--big-a:#12304a;--tx2:#233b52;
  --bgA:#d6ecfb;--bgB:#e9ddff;--orb1:#7dd3fc;--orb2:#c4b5fd;--orb3:#a5f3fc;
  --glass:linear-gradient(160deg,rgb(255 255 255/.95),rgb(255 255 255/.82));--line:rgb(3 105 161/.15);--line2:rgb(124 58 237/.28);
  --modal-bg:linear-gradient(165deg,#ffffff,#f3f8fc);--tip-bg:#ffffff;--coin-bg:#e3eef8;--chart-bg:#ffffff;--card2:#f5f9fd;--bd:#d9e6f2}
html[data-theme="okx"]{--bg0:#000000;--bg1:#121212;--tx:#ffffff;--mut:#8c8c8c;--mut2:#6b6b6b;
  --vio-rgb:235 235 235;--vio2-rgb:120 120 120;--vio3-rgb:200 200 200;--cyan-rgb:170 170 170;--cyan2-rgb:110 110 110;--cyan3-rgb:90 90 90;
  --green-rgb:37 167 80;--green2-rgb:30 140 66;--red-rgb:239 69 74;--red2-rgb:200 50 56;
  --surf-rgb:18 18 18;--surf2-rgb:12 12 12;--surf3-rgb:8 8 8;--surf4-rgb:26 26 26;--scrim-rgb:0 0 0;
  --big-a:#ffffff;--tx2:#d6d6d6;--bgA:#0a0a0a;--bgB:#000000;--orb1:transparent;--orb2:transparent;--orb3:transparent;
  --line:rgb(255 255 255/.09);--line2:rgb(255 255 255/.16);--on-acc:#000000;
  --modal-bg:linear-gradient(165deg,#161616,#0b0b0b);--tip-bg:#161616;--coin-bg:#1e1e1e;--chart-bg:#0b0b0b;--card2:#141414;--bd:#262626}
html[data-theme="okx"] button.primary{color:#000}
html[data-theme="light"]{color-scheme:light;--bg0:#f3f1fa;--bg1:#ffffff;--tx:#1d1733;--mut:#57526f;--mut2:#6b6685;
  --vio-rgb:109 40 217;--vio2-rgb:109 40 217;--vio3-rgb:124 58 237;--cyan-rgb:14 116 144;--cyan2-rgb:8 145 178;--cyan3-rgb:14 116 144;
  --green-rgb:4 120 87;--green2-rgb:22 163 74;--red-rgb:190 18 60;--red2-rgb:220 38 38;--amber-rgb:180 83 9;--amber2-rgb:217 119 6;--amber3-rgb:180 83 9;
  --blue-rgb:37 99 235;--ov-rgb:30 20 70;--sh-rgb:90 80 130;--surf-rgb:255 255 255;--surf2-rgb:255 255 255;--surf3-rgb:250 249 254;--surf4-rgb:255 255 255;--scrim-rgb:236 233 246;
  --hi:#1d1733;--on-acc:#ffffff;--on-green:#ffffff;--red-soft:#9f1239;--green-soft:#065f46;--big-a:#2a2350;--tx2:#3b3457;
  --bgA:#e6ddff;--bgB:#d9f3fb;--orb1:#c4b5fd;--orb2:#a5f3fc;--orb3:#fbcfe8;
  --glass:linear-gradient(160deg,rgb(255 255 255/.95),rgb(255 255 255/.82));--line:rgb(109 40 217/.15);--line2:rgb(14 116 144/.32);
  --modal-bg:linear-gradient(165deg,#ffffff,#f7f5fd);--tip-bg:#ffffff;--coin-bg:#ece8f7;--chart-bg:#ffffff;--card2:#f7f5fd;--bd:#e3def0}
html[data-theme="light"] .card,html[data-theme="sky"] .card{box-shadow:0 1px 0 rgb(255 255 255/.8) inset,0 10px 28px rgb(60 40 120/.10)}
html[data-theme="light"] .card:hover,html[data-theme="sky"] .card:hover{box-shadow:0 14px 34px rgb(60 40 120/.16)}
html[data-theme="light"] .modal,html[data-theme="sky"] .modal{box-shadow:0 24px 60px rgb(60 40 120/.22)}
html[data-theme="light"] button.primary,html[data-theme="light"] .dcabuy.loss,html[data-theme="sky"] button.primary,html[data-theme="sky"] .dcabuy.loss{color:#fff}
html[data-theme="light"] nav.actions .grp button[style*="gradient"],html[data-theme="sky"] nav.actions .grp button[style*="gradient"]{color:#fff!important}
html[data-theme="light"] .tot b{background:linear-gradient(92deg,#0e7490,#6d28d9);-webkit-background-clip:text;background-clip:text}
html[data-theme="sky"] .tot b{background:linear-gradient(92deg,#7c3aed,#0369a1);-webkit-background-clip:text;background-clip:text}
html[data-theme="light"] .st .sv>span,html[data-theme="light"] .st .sv.rotv{background:linear-gradient(92deg,#0e7490,#6d28d9);-webkit-background-clip:text;background-clip:text}
html[data-theme="sky"] .st .sv>span,html[data-theme="sky"] .st .sv.rotv{background:linear-gradient(92deg,#7c3aed,#0369a1);-webkit-background-clip:text;background-clip:text}
html[data-theme="light"] .card.dead,html[data-theme="sky"] .card.dead{filter:saturate(.55) brightness(.97)}
html[data-theme="light"] .orb,html[data-theme="sky"] .orb{opacity:.42}
html[data-theme="light"] ::-webkit-scrollbar-thumb{background:rgb(109 40 217/.22)}
html[data-theme="sky"] ::-webkit-scrollbar-thumb{background:rgb(3 105 161/.22)}
html[data-theme="graphite"] .orb{display:none}

/* ═══ ⚡ الوضع الخفيف — بلا حركات دائمة ولا ضبابية ولا أجرام (للموبايل والأجهزة الضعيفة) ═══ */
html.lite .orb{display:none}
html.lite *,html.lite *::before,html.lite *::after{backdrop-filter:none!important;-webkit-backdrop-filter:none!important}
html.lite .pulse,html.lite .pill.ok::before,html.lite .lmark,html.lite .pmk::after,html.lite .belldot,
html.lite .fgw.ext .fga,html.lite .pscan{animation:none!important}
html.lite .pscan{display:none}
html.lite body.boot .card{animation:none}
html.lite header{background:rgb(var(--surf2-rgb)/.96)}
html.lite .page{background:rgb(var(--surf3-rgb)/.97)}
html.lite .mbg{background:rgb(var(--scrim-rgb)/.82)}
html.lite #notifPanel{background:rgb(var(--surf-rgb)/.98)}
html.lite .card:hover,html.lite button:hover{transform:none}

/* ═══ ⚡ خفة دائمة: الكرت برّا الشاشة ما ينرسم (ولا حركاته) لحد ما يقرب · النبضات على بطاقة الرسوميات مو المعالج ═══ */
.card{content-visibility:auto;contain-intrinsic-size:auto 560px}
.pulse,.pill.ok::before,.pmk::after,.lmark,.belldot{will-change:transform,opacity}

/* ═══ 🎨 أزرار الثيمات بالإعدادات ═══ */
.thgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(104px,1fr));gap:8px}
.thb{display:flex;flex-direction:column;align-items:center;gap:6px;padding:10px 6px;border-radius:12px;font-size:11.5px;min-height:74px}
.thb .sw3{display:flex;gap:3px;padding:4px;border-radius:9px;border:1px solid var(--line)}
.thb .sw3 i{width:14px;height:14px;border-radius:50%;display:block}
.thb.on{border-color:var(--amber);box-shadow:inset 0 0 0 1px rgb(var(--amber-rgb)/.35)}
.pollrow{display:flex;gap:6px;flex-wrap:wrap}
.pollrow button{padding:7px 12px;font-size:12px}
.pollrow button.on{border-color:var(--amber);color:var(--amber)}

/* ═══ 🩹 إصلاحات فحص الواجهة ═══ */
.modal{max-width:100%}
@media (max-width:520px){.mbg{padding:10px}.modal{padding:18px 15px;border-radius:18px}}
/* 💰 v3.31.1: صفوف «محفظتي في المنصة» — أعمدة ثابتة حتى الأرقام تصطف تحت بعض */
.fxr{display:grid;grid-template-columns:22px 64px minmax(0,1fr) 56px 84px 92px;grid-template-areas:"i n q p c v";align-items:center;column-gap:9px;font-size:12.5px;line-height:20px}
.fxr>.coin{grid-area:i}.fxr .fxn{grid-area:n;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.fxr .fxq{grid-area:q;min-width:0;display:flex;flex-wrap:wrap;align-items:center;gap:0 9px;color:var(--mut)}.fxr .fxq>span{line-height:18px;height:18px}.fxr .fxl{color:var(--mut2);font-size:10.5px}
.fxr .fxp{grid-area:p;justify-self:end;font-size:10.5px;white-space:nowrap}.fxr .fxc{grid-area:c;justify-self:start;display:flex;line-height:16px}
.fxr .fxv{grid-area:v;justify-self:end;white-space:nowrap}
@media (max-width:600px){.fxr{grid-template-columns:22px minmax(0,1fr) auto 80px;grid-template-rows:20px minmax(18px,auto);grid-template-areas:"i n p v" "i q q c";row-gap:2px;padding:3px 0;line-height:18px}
  .fxr>.coin{align-self:center}.fxr .fxn{font-size:13px;line-height:20px}.fxr .fxv{line-height:20px}.fxr .fxq{font-size:11px;gap:0 6px}.fxr .fxl{font-size:10px}
  .fxr .fxc{justify-self:end}.fxr.nofx{grid-template-areas:"i n p v" "i q q q"}.fxr.nofx .fxc{display:none}}   /* USDT (بلا أثر سعر): الكمية تاخذ السطر كله */
@media (max-width:380px){.fxr{grid-template-columns:22px minmax(0,1fr) auto 72px;column-gap:8px}.fxr .fxq{font-size:10.5px}.fxr .fxl{font-size:9.5px}}
.bench{min-width:0}
.dline .dlbl{font-size:9.5px}
.bigprice.long{font-size:17px}
.bidi{unicode-bidi:isolate;direction:ltr;display:inline-block}
.tape2 .iv{unicode-bidi:isolate;direction:rtl}.tape2 .iv b{unicode-bidi:isolate;direction:ltr}
/* ═══ 🪟 v3.36.34: نمط النوافذ الموحّد — كاملة الشاشة (بالحاسوب لوحة كبيرة مثل «الاختبار التجريبي») · ✕ بنفس الزاوية · التأكيدات بحجمها ═══ */
:root{--hw-gap:22px;--hw-max:1180px;--hw-r:22px}
.hwx,.phead .x,.dhead .x,.npx,.btx{width:36px;height:36px;min-width:36px;padding:0;border-radius:50%;display:grid;place-items:center;font-size:15px;line-height:1;
  border:1px solid var(--line2);background:rgb(var(--surf-rgb)/.92);color:var(--tx)}
.hwx{position:absolute;top:12px;inset-inline-end:12px;z-index:6;margin:0}
.mbg .modal{position:relative;display:flex;flex-direction:column;overflow:hidden;animation:none}
.mbg .hwb{flex:1 1 auto;min-height:0;overflow-y:auto;overscroll-behavior:contain}
.mbg .hwb>h2:first-child{padding-inline-end:48px}
/* الكاملة */
.mbg.full{padding:var(--hw-gap);place-items:stretch}
.mbg.full .modal{width:min(var(--hw-max),100%);max-width:none;height:100%;max-height:none;margin:0 auto;padding:0;border-radius:var(--hw-r);border:1px solid var(--line2)}
.mbg.full .hwb{padding:0 22px 26px}
.mbg.full .hwb>h2:first-child{position:sticky;top:0;z-index:4;margin:0 -22px 16px;padding:15px 22px 13px;padding-inline-end:62px;background:var(--modal-bg);
  border-bottom:1px solid var(--line);font-size:17px;line-height:1.45}
/* الصغيرة (التأكيدات وشبهها): حجمها كما كان · نفس الشكل */
.mbg.small .modal{border:1px solid var(--line2);border-radius:var(--hw-r)}
.mbg.small .hwb>h2:first-child{margin-bottom:14px}
/* الصفحات */
.page,.page.on{transition:none}.page{transform:none}
.page .pwrap{max-width:var(--hw-max);min-height:calc(100% - 2*var(--hw-gap));margin:var(--hw-gap) auto;padding:0 22px 40px;background:var(--modal-bg);
  border:1px solid var(--line2);border-radius:var(--hw-r);box-shadow:0 30px 80px rgb(var(--sh-rgb)/.5)}
.page .phead{position:sticky;top:0;z-index:4;margin:0 -22px 18px;padding:13px 22px 12px;padding-inline-end:16px;background:var(--modal-bg);border-bottom:1px solid var(--line);
  border-radius:var(--hw-r) var(--hw-r) 0 0}
.page .phead h2{font-size:17px}
/* تفاصيل البوت */
#drawer{inset:var(--hw-gap);width:auto;max-width:var(--hw-max);margin:0 auto;border:1px solid var(--line2);border-radius:var(--hw-r);background:var(--modal-bg);
  transform:none;opacity:0;visibility:hidden;transition:none;box-shadow:0 0 0 100vmax rgb(var(--scrim-rgb)/.66),0 30px 80px rgb(var(--sh-rgb)/.5)}
html[dir="rtl"] #drawer{transform:none}
#drawer.on{opacity:1;visibility:visible}
#drawer>*{width:100%;max-width:880px;margin-inline:auto}
#drawer .dhead{max-width:none}
/* الإشعارات */
#notifPanel{left:var(--hw-gap);right:var(--hw-gap);top:var(--hw-gap);bottom:var(--hw-gap);width:auto;max-width:var(--hw-max);margin:0 auto;
  border:1px solid var(--line2);border-radius:var(--hw-r);background:var(--modal-bg);transform:none;transition:none}
#notifPanel.on{transform:none;transition:none}
#notifPanel>*{width:100%;max-width:880px;margin-inline:auto}
#notifPanel .nphead{max-width:none}
/* الاختبار التجريبي (المرجع) */
.btov{padding:var(--hw-gap)}
.btbox{min-height:100%;border-radius:var(--hw-r)}
/* الهاتف: كل نافذة تملأ الشاشة */
@media (max-width:720px){
  .mbg.full,.btov{padding:0}
  .mbg.full .modal,.btbox{width:100%;height:100%;border-radius:0;border:0}
  .mbg.full{padding-top:env(safe-area-inset-top,0px)}
  .page .pwrap{margin:0;min-height:100%;border-radius:0;border:0;padding-top:env(safe-area-inset-top,0px)}
  .page .phead{border-radius:0}
  #drawer,#notifPanel{inset:0;border-radius:0;border:0}
  .mbg.full,.btov,.page{backdrop-filter:none;-webkit-backdrop-filter:none}   /* 🎬 v3.36.35: الشاشة كلها مغطّاة ⇒ الضبابية خلفها شغل بلا فائدة كل إطار */
}
.hwclone{overflow:hidden}
/* ═══ ⚙️ v3.36.35: الإعدادات قائمة — صف لكل إعداد · قيمته الحالية ظاهرة · تضغطه تنفتح خياراته · المفتاح على صفه ═══ */
.sgrid{max-width:780px;margin:0 auto}
.sgrp{margin-top:16px}.sgrp:first-child{margin-top:2px}
.sgt{font-size:11.5px;font-weight:600;color:var(--mut);margin:0 6px 7px}
.sgrp.warn .sgt{color:var(--red)}
.sgl{border:1px solid var(--line);border-radius:14px;overflow:hidden;background:rgb(var(--surf-rgb)/.35)}
.sgl>.sitem+.sitem{border-top:1px solid var(--line)}
.sitem{display:block;width:100%;margin:0}
button.shd,button.stg,button.sln{display:flex;align-items:center;gap:12px;width:100%;min-height:54px;margin:0;padding:10px 14px;border:0;border-radius:0;
  background:none;color:var(--tx);font-size:13px;font-weight:400;text-align:start;box-shadow:none;transform:none;transition:background .15s}
button.shd:hover,button.stg:hover,button.sln:hover{transform:none;box-shadow:none;background:rgb(var(--surf-rgb)/.7)}
button.shd:active,button.stg:active,button.sln:active{transform:none;background:rgb(var(--surf-rgb)/.9)}
button.stg.on{color:var(--tx);border-color:transparent;box-shadow:none}
.sic{flex:none;width:26px;text-align:center;font-size:19px;line-height:1}
.stt{flex:1 1 auto;min-width:0;display:flex;flex-direction:column;gap:2px}
.stt b{font-size:13.5px;font-weight:600}
.stt small{font-size:11px;color:var(--mut2);line-height:1.5}
.stg.on .stt small{color:var(--green)}
.sgrp.warn .sln b{color:var(--red)}
.sval{flex:0 1 auto;max-width:48%;display:flex;align-items:center;gap:6px;font-size:12px;color:var(--mut);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.sval>span{overflow:hidden;text-overflow:ellipsis}
.sdot{flex:none;width:12px;height:12px;border-radius:50%;display:inline-block;border:1px solid var(--line2)}
.sch{flex:none;color:var(--mut2);font-size:15px;line-height:1;transition:transform .2s ease}
.sx.open .sch{transform:rotate(180deg)}
.sx.open .shd{background:rgb(var(--surf-rgb)/.5)}
.sbody{display:none;padding:4px 14px 14px}
.sx.open .sbody{display:block}
.sx.open.anim .sbody{animation:sbIn .22s cubic-bezier(.2,.8,.2,1)}
@keyframes sbIn{from{opacity:0;transform:translateY(-6px)}to{opacity:1;transform:none}}
.snote{font-size:11px;color:var(--mut2);margin:0 0 8px;line-height:1.7}
.ssw{flex:none;position:relative;width:44px;height:26px;border-radius:13px;background:rgb(140 140 165/.38);transition:background .2s}
.ssw i{position:absolute;top:3px;inset-inline-start:3px;width:20px;height:20px;border-radius:50%;background:#fff;box-shadow:0 1px 3px rgb(0 0 0/.35);transition:inset-inline-start .2s}
.stg.on .ssw{background:var(--green)}
.stg.on .ssw i{inset-inline-start:21px}
.sfoot{color:var(--mut2);font-size:11px;margin:14px 6px 0;line-height:1.7}
html.nombar #mbar{display:none!important}   /* 📌 v3.36.38: الشريط المصغّر مطفي بهذا الجهاز */
/* 💻 v3.36.41: برنامج ويندوز 2.0 — — ☐ ✕ جنب 🔔 (✕ أقصى اليمين · أحمر عند المرور) · الشريط العلوي يحرّك النافذة */
.wbtn{font-family:'Segoe UI',system-ui,sans-serif!important;min-width:40px}
.wbtn.wcls:hover,.mbw button.wcls:hover{background:#c42b1c!important;border-color:#c42b1c!important;color:#fff!important}
html.winf #top{user-select:none;-webkit-user-select:none}
.mbw{display:none}
html.winf .mbw{display:flex;gap:4px;position:absolute;inset-inline-start:8px;top:6px}
.mbw button{border:1px solid var(--line);background:rgb(var(--ov-rgb)/.06);color:var(--tx);border-radius:8px;width:32px;height:26px;font:13px 'Segoe UI',system-ui,sans-serif;cursor:pointer;padding:0}
html.winf #mbar .mb1,html.winf #mbar .mb2{padding-inline-start:116px}
/* 📊 v3.36.39: الشريط المصغّر — الأرباح · وتحتها حالة هذا الجهاز وحاسوب البوتات واللوحة (بالهاتف تنزل لسطر ثاني لو ما وسعت — ما ينخفي شي) */
#mbar{flex-direction:column;gap:3px}
#mbar .mb1{display:flex;align-items:center;justify-content:center;gap:16px;max-width:100%}
.mb2{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;column-gap:11px;row-gap:1px;max-width:100%;white-space:nowrap;font-size:11px;line-height:1.45;color:var(--mut);font-variant-numeric:tabular-nums}
.mb2:empty{display:none}.mb2>span{flex:0 0 auto}
.mbprev{margin:8px 0 2px;padding:7px 10px;border:1px solid var(--line);border-radius:10px;background:rgb(var(--surf2-rgb)/.6)}
@media (max-width:760px){#mbar .mb1{gap:14px}}
/* ═══ 🌌 v3.36.37: الخلفية المتحركة — لوحة رسم واحدة خلف كل شي · «الأصلية» = الأجرام كما كانت ═══ */
#hbg{position:fixed;inset:0;width:100%;height:100%;z-index:0;pointer-events:none;display:none}
html.abg #hbg{display:block}
html.abg .orb{display:none}
html.abg body{background-image:none}
html.abg header{backdrop-filter:none;-webkit-backdrop-filter:none;background:rgb(var(--surf2-rgb)/.94)}
.bgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(98px,1fr));gap:8px}
.tvol{display:flex;align-items:center;gap:10px;margin-top:10px;font-size:12px;color:var(--mut)}.tvol input[type=range]{flex:1;max-width:280px;height:26px;padding:0;border:0;background:none;accent-color:rgb(var(--vio-rgb))}
.bgb{display:flex;flex-direction:column;align-items:center;gap:6px;padding:7px 6px 8px;border-radius:12px;font-size:11.5px;min-width:0}
.bgb canvas{width:100%;max-width:132px;aspect-ratio:5/3;height:auto;border-radius:8px;display:block;background:var(--bg0)}


</style>
</head>
