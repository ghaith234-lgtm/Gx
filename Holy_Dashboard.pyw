  for(let i=0;i<4;i++){const e=R['tb'+i],p=_bt[i];if(e){if(p!=null){e.style.display='';e.style.left=pos(p)+'%';e.title=f4(p)}else e.style.display='none'}}
  for(let i=0;i<4;i++){const e=R['ts'+i],p=_st[i];if(e){if(p!=null){e.style.display='';e.style.left=pos(p)+'%';e.title=f4(p)}else e.style.display='none'}}
