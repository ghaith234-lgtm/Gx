  document.querySelectorAll('#libBtns button').forEach(b=>b.disabled=true);
  try{
    const r=await api('/api/control',{action:'libs',value:op});
    if(L)L.textContent=r.log||'—';
    $('#libTbl').innerHTML=await libsRows(r.rows);
    toast(r.ok?'✅ تمّت':'⚠️ فيها مشاكل — اقرأ السجل',r.ok);
  }catch(e){ if(L)L.textContent='تعذّر الاتصال'; toast('تعذر الاتصال',false) }
  document.querySelectorAll('#libBtns button').forEach(b=>b.disabled=false);
}
