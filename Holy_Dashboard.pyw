        _ri = round(_ri, 2)
    keys = {"api_key": "", "secret_key": "", "passphrase": ""}
    if not is_demo:
        keys = wallet_keys(data.get("wallet", "")) or {
            "api_key": str(data.get("api_key", "")).strip(),
            "secret_key": str(data.get("secret_key", "")).strip(),
            "passphrase": str(data.get("passphrase", "")).strip()}
        if not keys["api_key"]:
            return {"ok": False, "msg": "اختر محفظة أو أدخل مفاتيح API"}
    folder = ("demo_" if is_demo else "") + sym.split("-")[0].lower()
    base_folder, c = folder, 1
    while os.path.exists(os.path.join(ROOT, folder)):
        folder = f"{base_folder}_{c}"; c += 1
    full = os.path.join(ROOT, folder)
    os.makedirs(full, exist_ok=True)
    try:
        lower_p = float(data.get("lower_price", 0) or 0)
        upper_p = float(data.get("upper_price", 0) or 0)
    except Exception:
        lower_p = upper_p = 0.0
    try:
        buy_off = float(data.get("buy_offset", 0) or 0) / 100.0   # يصل كنسبة مئوية
    except Exception:
        buy_off = 0.0
    if buy_off < 0 or buy_off >= 0.9:
        buy_off = 0.0
    # 🎚️ النوع: **يختاره المستخدم** (g_type) — وإذا ما وصل (طلب قديم) نخمّنه: حدود → نطاق · بُعد شراء → Grid+ · وإلا إنفنتي
    _gsel = str(data.get("g_type") or "").strip()
    if _gsel in ("grid", "grid_range", "grid_plus") and not is_demo:
        if _gsel == "grid_range" and lower_p <= 0 and upper_p <= 0:
            return {"ok": False, "msg": "🎚️ جرد المدى يحتاج حد أدنى أو أعلى (أو اختار ♾️ لانهائية)"}
        if _gsel == "grid_plus" and buy_off <= 0:
            return {"ok": False, "msg": "➕ جرد بلس يحتاج بُعد شراء أكبر من صفر (أو اختار ♾️ لانهائية)"}
        if _gsel != "grid_range":
            lower_p, upper_p = 0.0, 0.0          # حقول نوع ثاني ما تنحفظ وتلخبط
        if _gsel != "grid_plus":
            buy_off = 0.0
        g_type = _gsel
    elif is_demo:
        g_type = "grid"
    elif lower_p > 0 or upper_p > 0:
        g_type = "grid_range"
    elif buy_off > 0:
        g_type = "grid_plus"
    else:
        g_type = "grid"
    if g_type == "grid_range" and lower_p > 0 and upper_p > 0 and lower_p >= upper_p:
        return {"ok": False, "msg": "الحد الأدنى للنطاق لازم أقل من الحد الأعلى"}
    cfg = {**keys, "symbol": sym, "grid_percentage": grid, "usd_value": usd, "min_price": minp,
           "forced_base_price": base, "knife_guard": bool(data.get("guard")), "is_demo": is_demo,
           "bot_type": g_type, "lower_price": lower_p, "upper_price": upper_p,
           "buy_offset": buy_off,
           "auto_restart": bool(data.get("auto", True))}
    if _ri is not None:
        cfg["reinvest"], cfg["reinvest_pct"] = True, _ri          # launch() يشغّل reinvest.py من أول لحظة (نفس قرار زر الكرت)
    save_json_atomic(os.path.join(full, f"config_{sym}.json"), cfg)
    if is_demo:
        srcp = find_script("demo.py")
        if not srcp:
            return {"ok": False, "msg": "وضع DEMO يحتاج ملف demo.py بالمجلد الرئيسي"}
        shutil.copy2(srcp, os.path.join(full, "demo.py"))
    else:
        eng_src, eng_script, _ = engine_for(cfg)
        with open(os.path.join(full, eng_script), "w", encoding="utf-8") as f:
            f.write(eng_src)  # 🧬 المحرك المدمج الصحيح حسب النوع
    _drop_reinvest(full)
    b = {"dir": full, "cfg_path": os.path.join(full, f"config_{sym}.json"), "cfg": cfg, "symbol": sym}
    ok, msg = launch(b)
    if ok:
        tg_send(f"🚀 *تم نشر بوت جديد!*\nالعملة: `{sym}`\nالنمط: `{'DEMO' if is_demo else 'REAL'}`\nالشبكة: `{grid*100:.2f}%`"
                + (f"\n💠 إعادة الاستثمار: `{_ri:g}%` من أول دورة" if _ri is not None else ""))
    _gl = {"grid_range": "جرد نطاق", "grid_plus": "Grid+"}.get(g_type, "DEMO" if is_demo else "إنفنتي جرد")
    return {"ok": ok, "msg": ("🚀 انتشر وانطلق (" + _gl + ") " + sym + (f" · 💠 إعادة الاستثمار {_ri:g}% من أول دورة" if _ri is not None else "")) if ok else msg}

def edit_bot(b, data):
    upd, restart_needed = {}, False
    if data.get("grid_pct") not in (None, ""):
        upd["grid_percentage"] = float(data["grid_pct"]) / 100.0
    if data.get("usd_value") not in (None, ""):
        upd["usd_value"] = float(data["usd_value"])
    if data.get("min_price") not in (None, ""):
        upd["min_price"] = float(data["min_price"])
    if data.get("forced_base") not in (None, ""):
        upd["forced_base_price"] = float(data["forced_base"])
    if data.get("wallet"):
        k = wallet_keys(data["wallet"])
        if not k:
            return {"ok": False, "msg": "محفظة غير معروفة"}
        upd.update(k); restart_needed = True
    if not upd:
        return {"ok": False, "msg": "ما في شي للتعديل"}
    write_cfg_keys(b["cfg_path"], upd)
    msg = "✏️ الإعدادات انحفظت — تنطبق مباشرة (البوت يقرأها كل ثانية)"
    if "grid_percentage" in upd:
        msg += ". النسبة الجديدة للأوامر الجديدة؛ لإعادة رسم السلم كله استخدم إعادة البناء ♻️"
    if restart_needed:
        sp, _, _ = paths_of(b)
        if is_alive(b["dir"], sp)[0]:
            stop_bot(b, disable_auto=False); time.sleep(0.6); launch(b)
            msg += ". بدّلت المفاتيح وأعدت تشغيل البوت 🔄"
        else:
            msg += ". المفاتيح الجديدة راح تنطبق عند التشغيل"
    return {"ok": True, "msg": msg}

def rebuild(b):
    sp, _, _ = paths_of(b)
    was_alive = is_alive(b["dir"], sp)[0]
    stop_bot(b, disable_auto=False)
    time.sleep(0.8)
    for f in glob.glob(os.path.join(b["dir"], "grid_state_*")):
        try: os.remove(f)
        except Exception: pass
    ok, msg = launch(b) if was_alive or True else (True, "")
    tg_send(f"♻️ *إعادة بناء* — `{b['symbol']}` راح يرسم شبكة جديدة من السعر الحالي")
    return {"ok": ok, "msg": "♻️ انمسحت الذاكرة وانطلق ببناء شبكة جديدة" if ok else msg}

def _gone_archive(b):
    """🗃️ v3.22.2: لحظة الحذف — أرقام البوت الكلية تنحفظ (المحرر · 💠 داخل الأوامر · 💠 للمُراكِم · ربح العملة) ⇒ الإجماليات ما تنقص.
    قبلها نلحّق الدفترين وأرشيف إعادة الاستثمار حتى آخر ربح ينحسب بيومه."""
    c0 = b.get("cfg") or {}
    if c0.get("is_demo"):
        return
    _safe(ledger_tick, default=None)
    _safe(coin_ledger_tick, default=None)
    _safe(reinvest_tick, default=None)
    st = _safe(load_json, paths_of(b)[0], default={}) or {}
    bt = c0.get("bot_type") or "grid"
    key = os.path.relpath(b["dir"], ROOT)
    base = str(b["symbol"]).split("-")[0].upper()
    e = {"key": key, "sym": b["symbol"], "type": bt, "ts": time.time(), "rel": 0.0, "held": 0.0, "handoff": 0.0, "coin": {}}
    if bt == "dca":
        e["coin"] = {base: round(float(st.get("total_coin_profit") or 0), 10)}
    elif bt == "dca_buy":
        e["rel"] = round(float(st.get("total_coin_profit") or 0), 8)
    elif bt in _REC_T:                                     # 🔁 الدوري: المحرر بالدولار · 💠 الشرائي اللي بقى داخله (العملات بدفتر العملات)
        e["rel"] = round((float(st.get("rel_total") or 0) if bt in _REC_USD else 0.0) + float(st.get("wd_usd") or 0), 8)
        if bt in _REC_USD:
            e["held"] = round(_rec_held(st), 8)
    else:
        e["rel"] = round(float(st.get("total_profit") or 0) * _safe(net_factor, b, default=1.0), 8)
        rs = _safe(_ri_state_of, st, default=None)
        if rs:
            e["held"], e["handoff"] = round(rs["held"], 8), round(rs["handoff"], 8)
    if not (e["rel"] or e["held"] or e["handoff"] or any(e["coin"].values())):
        return
    g = load_json(GONE) or {}
    if not isinstance(g, dict):
        g = {}
    g.setdefault("bots", {})[f"{key}@{int(e['ts'])}"] = e
    save_json_atomic(GONE, g)


def delete_bot(b):
    stop_bot(b)
    time.sleep(0.5)
    _safe(loss_tick, default=None)        # 📉 v3.25.4: آخر خسارة للبوت تنكتب قبل الأرشفة
    try:
        _gone_archive(b)
    except Exception as ex:
        log_event(f"⚠️ [{b['symbol']}] تعذّر حفظ أرقام البوت قبل الحذف: {ex}")
    arch = os.path.join(ROOT, "_archive")
    os.makedirs(arch, exist_ok=True)
    dest = os.path.join(arch, f"{time.strftime('%Y%m%d_%H%M%S')}_{os.path.basename(b['dir'])}")
    try:
        shutil.move(b["dir"], dest)
    except Exception as ex:
        return {"ok": False, "msg": f"أوقفته بس فشل النقل: {ex}"}
    tg_send(f"🗑 *حذف (أرشفة)* — `{b['symbol']}` انتقل إلى `_archive`")
    return {"ok": True, "msg": "⏹ انحذف بأمان — مجلده محفوظ داخل _archive إذا احتجته"}

def shutdown_all(noexit=False):
    led = load_json(LEDGER) or {}
    today = datetime.now().strftime("%Y-%m-%d")
    t_today = sum((d.get("daily", {}) or {}).get(today, 0.0) for d in led.values() if isinstance(d, dict))
    t_all = sum(float(d.get("last_seen_total", 0) or 0) for d in led.values() if isinstance(d, dict))
    n = 0
    for b in bot_dirs().values():
        sp, _, _ = paths_of(b)
        if is_alive(b["dir"], sp)[0]:
            stop_bot(b); n += 1
    tg_send(f"🛑 *[إغلاق مركز التحكم]*\nتم إيقاف `{n}` بوت.\n💵 أرباح اليوم: `{t_today:.4f}$`\n🏦 التراكمي: `{t_all:.4f}$`")
    if not noexit:
        threading.Timer(1.5, lambda: os._exit(0)).start()
    return {"ok": True, "msg": f"⏻ أوقفت {n} بوت" + ("" if noexit else " — اللوحة تنطفي الآن")}

_BS_CACHE = {"mt": None, "v": ""}


def _books_since():
    """📒 v3.22.6: أول يوم بالدفاتر بعد «بداية جديدة للحسابات» ("" = من البداية)."""
    try:
        mt = os.path.getmtime(BOOKS_SINCE)
    except Exception:
        _BS_CACHE.update(mt=None, v="")
        return ""
    if _BS_CACHE["mt"] != mt:
        _BS_CACHE.update(mt=mt, v=str((load_json(BOOKS_SINCE) or {}).get("since") or ""))
    return _BS_CACHE["v"]


_BOOKS_LOCK = threading.RLock()     # 📒 v3.22.6: الدفاتر الثلاثة ما تنكتب سوا ويّا «بداية جديدة»


def _books_locked(fn):
    def _w(*a, **k):
        with _BOOKS_LOCK:
            return fn(*a, **k)
    _w.__name__ = fn.__name__
    _w.__doc__ = fn.__doc__
    return _w


ledger_tick = _books_locked(ledger_tick)
coin_ledger_tick = _books_locked(coin_ledger_tick)
reinvest_tick = _books_locked(reinvest_tick)
coin_trade_tick = _books_locked(coin_trade_tick)      # 🪙 v3.30.0
acc_pl_tick = _books_locked(acc_pl_tick)              # 💵 v3.30.0


def books_fresh_start():
    """📒 v3.22.6: «بداية جديدة للحسابات» — كأنها لوحة جديدة **من اليوم**: كل الدفاتر (المحرر · التداول · العملات · المحذوف)
    تنمسح أيامها قبل اليوم، واليوم يبقى كامل. فلوس حقيقية ما تنلمس: المُراكِم (قيد الشراء والمتراكم) · البوتات · أوامرها · أرباح كروتها.
    ⇒ ما ينعاد حساب أي دورة/بيعة قديمة (الدورات المحسوبة تبقى معلّمة · وسجل الصفقات قبل اليوم ما ينقرا)."""
    with _BOOKS_LOCK:
        ledger_tick()                                        # آخر ربح ينقيّد قبل المسح
        _safe(coin_ledger_tick, default=None)
        _safe(reinvest_tick, default=None)
        today = datetime.now().strftime("%Y-%m-%d")
        led = load_json(LEDGER) or {}
        for k, e in list(led.items()):
            if str(k).startswith("_") or not isinstance(e, dict):
                continue
            for f in ("daily", "trades_daily", "hourly", "rec_tr"):
                if isinstance(e.get(f), dict):
                    e[f] = {d: v for d, v in e[f].items() if str(d)[:10] >= today}
            if isinstance(e.get("monthly"), dict):
                e["monthly"] = {}
        save_json_atomic(LEDGER, led)
        arc = load_json(RI_LEDGER) or {}
        for e in ((arc.get("bots") or {}).values() if isinstance(arc, dict) else []):
            if isinstance(e, dict) and isinstance(e.get("daily"), dict):
                e["daily"] = {d: v for d, v in e["daily"].items() if d >= today}
        if isinstance(arc, dict):
            arc["daily"] = {d: v for d, v in (arc.get("daily") or {}).items() if d >= today}
            save_json_atomic(RI_LEDGER, arc)
        cl = load_json(COIN_LEDGER) or {}
        if isinstance(cl, dict):
            cl["daily"] = {d: v for d, v in (cl.get("daily") or {}).items() if d >= today}
            tot = {"dca": {}, "ri": {}, "rec": {}}
            for row in cl["daily"].values():
                for base, e in (row or {}).items():
                    for src in ("dca", "ri", "rec"):
                        q = float((e or {}).get(src) or 0)
                        if abs(q) > 1e-12:
                            tot[src][base] = round(tot[src].get(base, 0.0) + q, 10)
            cl["total_dca"], cl["total_ri"], cl["total_rec"], cl["bots"] = tot["dca"], tot["ri"], tot["rec"], {}
            save_json_atomic(COIN_LEDGER, cl)                # «seen» يبقى ⇒ الأحداث القديمة ما تنعاد
        for _fn in (COINTR_FILE, ACCPL_FILE):                # 🪙💵 v3.30.0: نفس القاعدة — الأيام قبل اليوم تنمسح · «seen» يبقى
            _B = load_json(_fn) or {}
            if isinstance(_B, dict) and _B:
                _B["daily"] = {d: v for d, v in (_B.get("daily") or {}).items() if d >= today}
                _B["v"] = _B.get("v") or 1
                save_json_atomic(_fn, _B)
        save_json_atomic(GONE, {"bots": {}})
        save_json_atomic(BOOKS_SINCE, {"since": today, "at": datetime.now().strftime("%Y-%m-%d %H:%M:%S")})
        _HDP_CACHE.clear()
        _TB_CACHE["v"] = None
    return {"ok": True, "msg": f"📒 بداية جديدة للحسابات من اليوم {today} — الأيام قبله انمسحت من الدفاتر · اليوم بقى كامل · المُراكِم والبوتات وأوامرها ما انلمست"}


