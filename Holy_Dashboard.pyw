import hashlib as _hl, hmac as _hm, secrets as _sc, base64 as _b64s

_SESSIONS = {}      # token -> {"exp": ts, "ip": str}
_LOGIN_TRY = {}     # ip -> [timestamps]  (كبح المحاولات)

def _pw_hash(pw, salt=None):
    salt = salt or _sc.token_hex(8)
    h = _hl.pbkdf2_hmac("sha256", pw.encode("utf-8"), salt.encode("utf-8"), 120000)
    return salt + "$" + h.hex()

def _pw_verify(pw, stored):
    try:
        salt, _ = stored.split("$", 1)
        return _hm.compare_digest(_pw_hash(pw, salt), stored)
    except Exception:
        return False

def auth_cfg():
    c = app_cfg()
    return {"hash": c.get("pw_hash") or "", "mins": int(c.get("lock_mins") or 30)}

def auth_enabled():
    return bool(auth_cfg()["hash"])

def _new_session(ip):
    tok = _sc.token_urlsafe(24)
    mins = max(1, auth_cfg()["mins"])
    _SESSIONS[tok] = {"exp": time.time() + mins * 60, "ip": ip}
    # تنظيف المنتهية
    for k in [k for k, v in _SESSIONS.items() if v["exp"] < time.time()]:
        _SESSIONS.pop(k, None)
    return tok

def _session_ok(tok, ip, touch=True):
    s = _SESSIONS.get(tok or "")
    if not s or s["exp"] < time.time():
        _SESSIONS.pop(tok or "", None)
        return False
    if touch:                      # تجديد المهلة مع كل نشاط
        s["exp"] = time.time() + max(1, auth_cfg()["mins"]) * 60
    return True

