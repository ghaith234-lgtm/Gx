PROFIT_FILE = os.path.join(ROOT, "Holy_Profit.json")
_PF_LOCK = threading.RLock()
_PF_RUN = {"t": 0.0}
_PF_LATE_DAYS = 9           # المُراكِم يلحق فرق يوم منتهي 8 أيام ⇒ نلحقه نفس المدة (+1)


