            "fee": float((_safe(okx_fee_rate, b, default=None) or {}).get("maker")
                         or b["cfg"].get("fee_rate") or FEE_RATE_DEFAULT),
            "fee_src": ("okx" if (_FEE_CACHE.get(
                (b["cfg"].get("api_key") or "")[:8] + "|" + b["symbol"]) or {}).get("taker")
                        else ("تهيئة" if b["cfg"].get("fee_rate") else "افتراضي")),
            "cfg": ({"base_order_qty": b["cfg"].get("base_order_qty"), "avg_order_qty": b["cfg"].get("avg_order_qty"),
                     "first_deviation": b["cfg"].get("first_deviation"), "step_multiplier": b["cfg"].get("step_multiplier"),
                     "size_multiplier": b["cfg"].get("size_multiplier"), "max_safety_orders": b["cfg"].get("max_safety_orders"),
                     "take_profit_pct": b["cfg"].get("take_profit_pct"), "exchange_orders": b["cfg"].get("exchange_orders"),
                     "cycle_wait_sec": b["cfg"].get("cycle_wait_sec")}
                    if b["cfg"].get("bot_type") in ("dca", "dca_buy") else None),
            "dca": _dca_snapshot(b, st) if b["cfg"].get("bot_type") in ("dca", "dca_buy") else None,
            "rec": _safe(_rec_snapshot, b, st, default=None) if _bt in ("rec_buy", "rec_sell") else None}

DCA_FEE_MAKER = 0.0008      # 🧾 v3.22.1: أوامر الأمان الليمت (صانع)
DCA_FEE_TAKER = 0.001       # الأساس والإغلاق والأوامر الفورية (آخذ)


def _dca_tp(cfg):
    """هدف الربح الفعلي بالمحرك: ما ينزل تحت 0.20% (حماية العمولات)"""
    try:
        return max(float(cfg.get("take_profit_pct") or 0), 0.20) / 100.0
    except Exception:
        return 0.002


def _dca_live(st, cfg, is_buy, cp, trail_on):
    """📋 v3.22.1 (ح٥/ح٦): كل مستوى بالدورة الحالية — حالته (✅ نفّذ · 🟢 بالمنصة · 📦 مخزون/🛡️ درع · ◐ جزئي)،
    بعده عن السعر الآن، ولو وصله السعر: المتوسط وسعر الخروج والربح الصافي بعد العمولة (المنفّذ بأرقامه الفعلية والباقي بالخطة)."""
    planned = [l for l in (st.get("planned_levels") or []) if isinstance(l, dict)]
    if not planned:
        return []
    tp = _dca_tp(cfg)
    fee_lv = DCA_FEE_TAKER if trail_on else DCA_FEE_MAKER
    filled = [f for f in (st.get("filled") or []) if isinstance(f, dict)]
    by_n, grp_first = {}, {}
    for f in filled:
        try:
            n = int(f.get("n", 0))
        except Exception:
            continue
        if n == -1:
            ns = [int(x) for x in (f.get("ns") or [])]
            if ns:
                grp_first.setdefault(min(ns), []).append(f)
                for x in ns:
                    by_n.setdefault(x, [])
        else:
            by_n.setdefault(n, []).append(f)
    live_n = {int(v.get("n", -9)): v for v in (st.get("active_sells") or {}).values() if isinstance(v, dict)}
    pend_n = {}
    for l in (st.get("pending_levels") or []):
        try:
            pend_n[int(l.get("n"))] = l
        except Exception:
            continue
    cq = cv = cnet = 0.0
    rows = []
    for lv in sorted(planned, key=lambda l: int(l.get("n", 0))):
        n = int(lv.get("n", 0))
        px0, q0 = float(lv.get("price") or 0), float(lv.get("qty") or 0)
        done = n in by_n
        ents = list(by_n.get(n, [])) + list(grp_first.get(n, []))
        fpx = fq = 0.0
        for f in ents:
            q, px = float(f.get("qty") or 0), float(f.get("price") or 0)
            net = f.get("net")
            if net is None:
                net = q * (1 - DCA_FEE_TAKER) if is_buy else px * q * (1 - DCA_FEE_TAKER)
            cq += q; cv += px * q; cnet += float(net)
            fv = fpx * fq + px * q; fq += q; fpx = fv / fq if fq > 0 else 0.0
        rest = 0.0
        if n in pend_n:
            rest = float(pend_n[n].get("qty") or 0)
        elif n in live_n:
            rest = float(live_n[n].get("qty") or 0)
        elif not done:
            rest = q0
        if rest > 0:
            f_r = DCA_FEE_TAKER if n == 0 else fee_lv
            cq += rest; cv += px0 * rest
            cnet += rest * (1 - f_r) if is_buy else px0 * rest * (1 - f_r)
        if done and rest > 0:
            stt = "part"
        elif done:
            stt = "done"
        elif n in live_n:
            stt = "live"
        else:
            stt = "trail" if trail_on else "mem"
        avg = cv / cq if cq > 0 else 0.0
        tgt = avg * (1 + tp) if is_buy else avg * (1 - tp)
        if is_buy:
            prof = cnet * tgt * (1 - DCA_FEE_TAKER) - cv
            exitp = (tgt / px0 - 1) * 100 if px0 > 0 else 0.0
        else:
            prof = (cnet / tgt * (1 - DCA_FEE_TAKER) - cq) if tgt > 0 else 0.0
            exitp = (1 - tgt / px0) * 100 if px0 > 0 else 0.0
        rows.append({"n": n, "px": _pv_sig(px0), "q": round(q0, 6), "st": stt, "fpx": _pv_sig(fpx) if fq > 0 else 0,
                     "dist": round((px0 / cp - 1) * 100, 3) if cp > 0 else 0, "avg": _pv_sig(avg), "tgt": _pv_sig(tgt),
                     "exitp": round(exitp, 3), "prof": round(prof, 6 if is_buy else 4), "cq": round(cq, 4), "cv": round(cv, 2)})
    return rows


def _dca_snapshot(b, st):
    """بيانات كرت DCA: المتوسط، الهدف، تقدّم الدورة، الربح اللحظي لو اشترى الآن"""
    cfg = b["cfg"]
    cp = float(PX.get(b["symbol"]) or st.get("current_price") or 0)
    avg = float(st.get("avg_price") or 0)
    target = float(st.get("target_price") or 0)
    sold_qty = float(st.get("total_sold_qty") or 0)
    total_usdt = float(st.get("total_usdt") or 0)
    n_safety = int(cfg.get("max_safety_orders", 5))
    filled = st.get("filled") or []
    # أوامر الأمان المستهلكة — الأمر المجمّع يحسب بعدد مستوياته (v3.22.0)
    safety_used = 0
    for _f in filled:
        try:
            _n = int(_f.get("n", 0))
        except Exception:
            _n = 0
        safety_used += len(_f.get("ns") or []) if _n == -1 else (1 if _n >= 1 else 0)
    is_buy = str(cfg.get("bot_type", "dca")) == "dca_buy"
    # 🧾 v3.22.0 (ح١): الصافي اللي استلمه البوت فعلاً (المحرك يكتبه) — الحالات القديمة تنقدّر بعمولة الآخذ
    try:
        total_net = float(st.get("total_net")) if st.get("total_net") is not None else (
            sold_qty * 0.999 if is_buy else total_usdt * 0.999)
    except Exception:
        total_net = 0.0
    _tv = st.get("trail_on")
    trail_on = bool(cfg.get("trail_on")) if _tv is None else bool(_tv)
    try:
        trail_pct = float(st.get("trail_pct") or cfg.get("trail_pct") or 0.3)
    except Exception:
        trail_pct = 0.3
    _ts, _tt = st.get("trail_s") or {}, st.get("trail_t") or {}
    # الربح اللحظي:
    #   البيعي: لو اشترى بكل USDT بالسعر الحالي → ربح عملة
    #   الشرائي: لو باع كل العملة بالسعر الحالي → ربح دولار
    #   (v3.22.0) بالصافي: العملة/الدولار اللي عند البوت فعلاً × سعر السوق − عمولة أمر السوق (آخذ 0.1%)
    live_profit = 0.0
    dist_to_target = 0.0
    if total_usdt > 0 and cp > 0:
        if is_buy:
            live_profit = total_net * cp * 0.999 - total_usdt   # دخل البيع الصافي − المصروف (USDT)
        else:
            live_profit = total_net / cp * 0.999 - sold_qty     # العملة المشتراة الصافية − المُباعة
    if target > 0 and cp > 0:
        # البيعي: كم % فوق الهدف (ready لما cp≤target، dist سالب)
        # الشرائي: كم % تحت الهدف (ready لما cp≥target)
        dist_to_target = (1 - cp / target) * 100 if is_buy else (cp / target - 1) * 100
    return {
        "phase": st.get("phase", "init"),
        "paused": bool(st.get("paused", False)),
        "avg_price": _pv_sig(avg), "target_price": _pv_sig(target),   # 🔎 كان round(6) ⇒ PEPE 0.00001 بدل 0.0000103
        "sold_qty": round(sold_qty, 4), "total_usdt": round(total_usdt, 2),
        "total_net": round(total_net, 6 if is_buy else 2),
        "trail_on": trail_on, "trail_pct": trail_pct,
        "stop_after": bool(st.get("stop_after_cycle")),
        "rows": _safe(_dca_live, st, cfg, is_buy, cp, trail_on, default=[]) or [],
        "tgt_prof": round(((total_net * target * (1 - DCA_FEE_TAKER) - total_usdt) if is_buy
                           else (total_net / target * (1 - DCA_FEE_TAKER) - sold_qty)) if target > 0 and total_usdt > 0 else 0.0, 6 if is_buy else 4),
        "dust": round(float(st.get("dust_usdt") or 0) if not is_buy else float(st.get("dust_coin") or 0), 6),
        "trail_peak": _pv_sig(float(_ts.get("peak") or _ts.get("low") or 0)),
        "trail_tp": _pv_sig(float(_tt.get("low") or _tt.get("high") or 0)),
        "safety_used": safety_used, "safety_max": n_safety,
        "live_profit": round(live_profit, 4),
        "dist_to_target": round(dist_to_target, 3),
        "coin_profit": round(float(st.get("total_coin_profit") or 0), 4),
        "is_buy": is_buy,
        "cycles": int(st.get("cycles_done") or 0),
        "base_coin": b["symbol"].split("-")[0],
        "active_sells": [{"price": v.get("price"), "qty": v.get("qty"), "n": v.get("n")}
                         for v in (st.get("active_sells") or {}).values()],
        "pending": [{"price": l.get("price"), "qty": l.get("qty"), "n": l.get("n")}
                    for l in (st.get("pending_levels") or [])],
    }

def _safe(fn, *a, default=None, **kw):
    """🛡️ درع: أي خلل بدوال الإضافات لا يكسر اللوحة — ترجع قيمة افتراضية"""
    try:
        return fn(*a, **kw)
    except Exception:
        return default


BOT_META = os.path.join(ROOT, "Holy_BotMeta.json")   # أقدم ظهور لكل بوت (يبقى رغم تقليم السجل)
_META_CACHE = {"t": 0.0, "d": {}}
_HEALTH_CACHE = {}

def bot_meta():
    if time.time() - _META_CACHE["t"] > 30:
        _META_CACHE["d"] = load_json(BOT_META) or {}
        _META_CACHE["t"] = time.time()
    return _META_CACHE["d"]

def first_seen_of(b, hist=None):
    """⏱️ أقدم ظهور حقيقي للبوت — يُثبَّت مرة ويبقى رغم تقليم ملف السجل"""
    key = os.path.relpath(b["dir"], ROOT)
    meta = bot_meta()
    saved = float((meta.get(key) or {}).get("first_seen") or 0)
    cands = []
    if saved > 0: cands.append(saved)
    # أقدم حدث بالسجل (قد يكون مقلّماً)
    if hist:
        try:
            t = _parse_ts(hist[-1].get("time"))
            if t > 0: cands.append(t)
        except Exception: pass
    # تاريخ إنشاء ملف الإعدادات — أقدم أثر موثوق للبوت
    for f in (b.get("cfg_path"), os.path.join(b["dir"], "config_%s.json" % b["symbol"])):
        try:
            if f and os.path.isfile(f):
                cands.append(min(os.path.getctime(f), os.path.getmtime(f)))
        except Exception: pass
    if not cands: return 0.0
    fs = min(cands)
    if abs(fs - saved) > 60:      # ثبّته لو تغيّر فعلياً
        meta.setdefault(key, {})["first_seen"] = fs
        try: save_json_atomic(BOT_META, meta); _META_CACHE["t"] = 0
        except Exception: pass
    return fs

# ───────────── 🩺 لوحة الصحة + التدقيق (إضافات) ─────────────
FAIL_RE = re.compile(r"(?:❌|⚠️).*?(?:رفض|فشل|تعذّر|خطأ)", re.S)
OK_RE = re.compile(r"(?:✅|🟢|🔴|💰).*?(?:نُشر|شراء|بيع|إغلاق|أمر)", re.S)
_ALERT_SENT = {}

def _parse_ts(s):
    for f in ("%Y-%m-%d %H:%M:%S", "%Y-%m-%d %H:%M"):
        try: return time.mktime(time.strptime(str(s)[:19], f))
        except Exception: pass
    return 0.0

def health_of(b, hist=None):
    """🩺 صحة الأوامر: كم رُفض مؤخراً · آخر نجاح · آخر خطأ (مُخزَّن مؤقتاً للخفة)"""
    if hist is None:
        _, hp, _ = paths_of(b)
        hist = load_json(hp) or []
    now = time.time()
    ck = b["dir"]
    c = _HEALTH_CACHE.get(ck)
    if c and now - c["t"] < 20 and c["n"] == len(hist) and c["h"] == (str(hist[0])[:60] if hist else ""):
        return c["v"]
    fails_1h = fails_24h = 0
    last_ok = last_err = None; last_err_msg = ""
    streak = 0; streak_open = True
    for e in hist:
        if not isinstance(e, dict): continue
        msg = str(e.get("msg", "")); ts = _parse_ts(e.get("time"))
        is_fail = bool(FAIL_RE.search(msg))
        is_ok = (not is_fail) and bool(OK_RE.search(msg))
        if is_fail:
            if now - ts <= 3600: fails_1h += 1
            if now - ts <= 86400: fails_24h += 1
            if last_err is None: last_err, last_err_msg = ts, msg[:120]
            if streak_open: streak += 1
        elif is_ok:
            if last_ok is None: last_ok = ts
            streak_open = False
    _res = {"fails_1h": fails_1h, "fails_24h": fails_24h, "streak": streak,
            "last_ok": round(last_ok, 0) if last_ok else None,
            "last_ok_ago": round((now - last_ok) / 60, 1) if last_ok else None,
            "last_err": round(last_err, 0) if last_err else None,
            "last_err_msg": last_err_msg,
            "state": ("bad" if streak >= 3 or fails_1h >= 5 else
                      "warn" if fails_1h >= 1 else "ok")}
    _HEALTH_CACHE[ck] = {"t": now, "n": len(hist), "h": (str(hist[0])[:60] if hist else ""), "v": _res}
    if len(_HEALTH_CACHE) > 60: _HEALTH_CACHE.clear()
    return _res

def error_digest(b, hist=None, top=6):
    """📋 تصنيف الأخطاء: نوع الخطأ + عدده + آخر ظهور"""
    try:
        return _error_digest_inner(b, hist, top)
    except Exception:
        return []


def _error_digest_inner(b, hist=None, top=6):
    if hist is None:
        _, hp, _ = paths_of(b)
        hist = load_json(hp) or []
    buckets = {}
    for e in hist:
        if not isinstance(e, dict): continue
        msg = str(e.get("msg", ""))
        if not FAIL_RE.search(msg): continue
        # مفتاح التصنيف: أول جزء دلالي من الرسالة
        k = re.sub(r"[0-9]+(?:\.[0-9]+)?", "#", msg)[:90]
        d = buckets.setdefault(k, {"n": 0, "last": "", "sample": msg[:130]})
        d["n"] += 1
        if not d["last"]: d["last"] = str(e.get("time", ""))
    out = sorted(buckets.values(), key=lambda x: -x["n"])[:top]
    return out

def ladder_audit(b, st=None):
    """🪜 تدقيق السلّم: انتظام الدرجات · فجوات · تكرار · تداخل"""
    if st is None:
        sp, _, _ = paths_of(b)
        st = load_json(sp) or {}
    if b["cfg"].get("bot_type") in _NONGRID:
        return {"ok": None, "msg": "التدقيق للجرد فقط"}
    g = float(b["cfg"].get("grid_percentage") or 0)
    base = float(st.get("ladder_base") or 0)
    if g <= 0 or base <= 0:
        return {"ok": None, "msg": "لا سلّم بعد"}
    lv = {}
    for grp, side in [("limit_buys", "b"), ("virtual_buys", "b"),
                      ("limit_sells", "s"), ("virtual_sells", "s")]:
        for k, v in (st.get(grp) or {}).items():
            try: lv[round(float(v.get("target_price", k)), 4)] = side
            except Exception: pass
    if not lv:
        return {"ok": None, "msg": "السلّم فارغ"}
    ps = sorted(lv)
    offs, ns = [], []
    for p in ps:
        try:
            x = math.log(p / base) / math.log(1 + g)
        except Exception:
            continue
        ns.append(round(x))
        if abs(x - round(x)) > 0.02: offs.append(p)
    dup = len(ns) - len(set(ns))
    sn = sorted(set(ns))
    gaps = sum(1 for i in range(len(sn) - 1) if sn[i + 1] - sn[i] > 1)
    bs = [p for p in ps if lv[p] == "b"]; ss = [p for p in ps if lv[p] == "s"]
    overlap = bool(bs and ss and max(bs) >= min(ss))
    ok = (not offs) and dup == 0 and not overlap
    return {"ok": ok, "levels": len(ps), "buys": len(bs), "sells": len(ss),
            "off": len(offs), "dup": dup, "gaps": gaps, "overlap": overlap,
            "lo": ps[0], "hi": ps[-1],
            "msg": ("✅ السلّم سليم" if ok else
                    "⚠️ " + " · ".join(filter(None, [
                        f"{len(offs)} درجة منزاحة" if offs else "",
                        f"{dup} تكرار" if dup else "",
                        "تداخل شراء/بيع" if overlap else ""])))}

def coverage_of(b, st=None):
    """💰 تغطية رأس المال: كم USDT وكم عملة يحتاج السلّم كاملاً"""
    if st is None:
        sp, _, _ = paths_of(b)
        st = load_json(sp) or {}
    if b["cfg"].get("bot_type") in _NONGRID:
        return None
    need_usdt = need_coin = live_usdt = live_coin = 0.0
    for grp in ("limit_buys", "virtual_buys"):
        for k, v in (st.get(grp) or {}).items():
            try:
                p = float(v.get("target_price", k)); q = float(v.get("locked_qty") or 0)
            except Exception: continue
            need_usdt += p * q
            if grp == "limit_buys": live_usdt += p * q
    for grp in ("limit_sells", "virtual_sells"):
        for k, v in (st.get(grp) or {}).items():
            try: q = float(v.get("locked_qty") or 0)
            except Exception: continue
            need_coin += q
            if grp == "limit_sells": live_coin += q
    base = b["symbol"].split("-")[0]
    bal = BAL.get(b["dir"]) or {}          # 🔑 BAL مفهرس بمجلد البوت
    have_u = float(bal.get("usdt") or 0); have_c = float(bal.get("base") or 0)
    return {"need_usdt": round(need_usdt, 2), "need_coin": round(need_coin, 4),
            "live_usdt": round(live_usdt, 2), "live_coin": round(live_coin, 4),
            "have_usdt": round(have_u, 2), "have_coin": round(have_c, 4),
            "cov_usdt": round(have_u / need_usdt * 100, 1) if need_usdt > 0 else None,
            "cov_coin": round(have_c / need_coin * 100, 1) if need_coin > 0 else None,
            "base": base}

SECRET_KEYS = ("api_key", "secret_key", "passphrase", "pw_hash", "token", "chat_id",
               "bot_token", "tg_token", "pin", "dash_pin", "password")

def _redact(d):
    """🔒 يحجب كل المفاتيح الحساسة قبل التصدير"""
    if not isinstance(d, dict):
        return d
    out = {}
    for k, v in d.items():
        if any(s in str(k).lower() for s in SECRET_KEYS):
            out[k] = "‹محجوب›" if v else ""
        elif isinstance(v, dict):
            out[k] = _redact(v)
        else:
            out[k] = v
    return out


