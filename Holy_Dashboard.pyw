    px = full1[-1][4]
    out = {"sym": sym, "base": sym.split("-")[0], "px": px, "days": len(d1), "src": (db.get("c", {}).get(sym) or {}).get("src", "okx"),
           "chg": round((px / d1[-1][4] - 1) * 100, 2) if l1 and d1[-1][4] else 0.0, "ts": time.time(), "h": {}}
    meta = _fc_meta()
    for k, nm, tf, H, dd in FC_H:
        rows, cur = tfr[tf]
        hz = {"k": k, "name": nm, "tf": tf, "tfn": FC_TFN[tf], "H": H, "days": dd}
        if len(rows) < FC_MIN[tf]:
            hz.update(short=True, have=len(rows), need=FC_MIN[tf])
            out["h"][k] = hz
            continue
        trf, trc = tfr[FC_TRD[k]]
        X = {"H": H, "hn": nm, "fng": fng, "fund": fund}
        allr = rows + ([cur] if cur else [])
        Pn = _fc_pack(allr, trf + ([trc] if trc else []), FC_TFS[tf], FC_TFS[FC_TRD[k]])   # 📍 ويّا الشمعة اللي لسه تتكوّن (مثل 📊)
        nc = len(rows)                                       # 🎯 السلاسل من الماضي بس ⇒ الفحص يستعمل نفس الحزمة بالشموع المسكّرة
        e = _fc_bt(db, sym, k, tf, Pn, X, nc)
        rc = _fc_rcal(db, sym, k, Pn, H, dd, nc)
        t = len(allr) - 1
        sig, lv = _fc_read(Pn, t, k, X)
        up, dn, n_, vk, vt = _fc_vote(sig)
        u = (e["U"] / e["N"]) if e["N"] else 0.5
        rel = _fc_grade(e["a"].get("vote"), u, H, FC_TFS[tf])
        G_ = FC_REAL.get(k) or {}
        pg = (G_.get("b") or {}).get(vk)
        own = (e.get("bk") or {}).get(vk) or [0, 0]
        d_ = (pg - G_["base"]) if pg is not None and G_.get("base") is not None else 0.0
        rk = ("up" if d_ >= FC_EDGE else "dn" if d_ <= -FC_EDGE else "eq") if G_.get("ok") else "na"
        real = {"k": rk, "t": {"up": "↗️ أعلى مرجّح", "dn": "↘️ أدنى مرجّح", "eq": "↔️ مثل العادي", "na": "↔️ غير مؤكد"}[rk],
                "p": pg, "base": G_.get("base"), "src": G_.get("src", ""), "own_n": own[0],
                "own_p": round(own[1] / own[0] * 100) if own[0] >= 20 else None, "own_base": round(u * 100) if e["N"] else None}
        parts = []
        for kk in [x[0] for x in _IND2_K] + [x[0] for x in _FC_X]:
            if kk not in sig:
                continue
            s, tx = sig[kk]
            nm_, ico, wh = meta[kk]
            parts.append({"k": kk, "name": nm_, "ico": ico, "s": round(s, 2), "w": "p" if s >= 0.15 else "n" if s <= -0.15 else "z",
                          "txt": tx, "what": wh, "acc": _fc_grade(e["a"].get(kk), u, H, FC_TFS[tf])})
        w_ = (1.0 - math.exp(-dd / 30.0)) / (dd / 30.0)
        q = _fc_rq(Pn, t, H, w_)
        if q:
            f_ = rc.get("f") or 1.0
            q = [q[2] - f_ * (q[2] - q[0]), q[2] - f_ * (q[2] - q[1]), q[2], q[2] + f_ * (q[3] - q[2]), q[2] + f_ * (q[4] - q[2])]
            pnow = Pn["D"]["c"][t]
            hz.update(lo=float(f"{pnow * math.exp(q[0]):.8g}"), lo50=float(f"{pnow * math.exp(q[1]):.8g}"), mid=float(f"{pnow * math.exp(q[2]):.8g}"),
                      hi50=float(f"{pnow * math.exp(q[3]):.8g}"), hi=float(f"{pnow * math.exp(q[4]):.8g}"))
        sqs = e["sq"]
        sq_x = round((sqs[0] / sqs[1]) / (sqs[2] / sqs[3]), 2) if sqs[1] >= 10 and sqs[3] and sqs[2] else None
        hz.update(up=up, dn=dn, n=n_, fl=n_ - up - dn, vk=vk, vt=vt, rel=rel, real=real, rng={"cov": rc.get("cov"), "n": rc.get("n"), "f": rc.get("f")},
                  sig=parts, lv=_fc_levels(lv, Pn["D"]["c"][t]), sq={"on": bool(Pn["sq"][t]), "x": sq_x}, tested=e["N"],
                  since=e["first"] or None)
        out["h"][k] = hz
        time.sleep(0.02)
    _safe(_fc_track, db, sym, out, {int(r[0]): r[4] for r in d1}, default=None)
    out["x"] = _safe(xc_coin, sym, d1, l1, _XC_BTC.get("m") or {}, default=None)      # 🧲💪 v3.32.0: برّه التصويت
    out["bot"] = _safe(bot_coin, sym, d1, _XC_BTC.get("m") or {}, default=None)      # 🟢 v3.36.27: مؤشر القاع
    return out


def fc_fetch():
    """⏱️ كل العملات المختارة (⚙️ «📈 شريط الأسعار») — عملة عملة بفاصل (حد OKX العام · والمعالج ما يثقل) · النافذة تتعبّى وحدة وحدة"""
    coins = list(ticker_cfg()["coins"])
    db = _fc_db()
    fng = _safe(_fc_fng, db, default=None)
    bd, bl = _safe(fc_candles, "BTC-USDT", db, default=([], None)) or ([], None)       # 💪 v3.32.0: المرجع دائماً (حتى لو مو بالشريط)
    _XC_BTC["m"] = {int(r[0]): float(r[4]) for r in list(bd) + ([bl] if bl else [])}
    done, bad = [], []
    for sym in coins:
        r = _safe(fc_coin, sym, db, fng, default=None)
        if r:
            done.append(sym)
            FC["coins"][sym] = r
            FC["order"] = [s for s in coins if s in FC["coins"]]
        else:
            bad.append(sym)
        time.sleep(0.4)
    keep = set(coins) | {"BTC-USDT"}                        # 💪 شموع البيتكوين تبقى (مرجع القوة · صدق السيولة/العلاوة)
    _safe(_mkt_rel, db, default=None)                       # 🎯 v3.32.0: صدق 💵 السيولة و🇺🇸 العلاوة على البيتكوين
    _safe(_pro_rel, db, default=None)                       # 🎯 v3.33.0: صدق مؤشرات المحترفين والاقتصاد + شارات العملات
    for sec in ("c", "c4", "bt", "rg", "lr", "fund"):
        for s in list((db.get(sec) or {}).keys()):
            if s not in keep:
                db[sec].pop(s, None)
    for old in ("t",):                                       # سجل v3.28 (شكله غير)
        db.pop(old, None)
    try:
        save_json_atomic(FC_FILE, db)
    except Exception:
        pass
    FC.update(ts=time.time(), coins={s: FC["coins"][s] for s in done}, order=[s for s in coins if s in done],
              err=("لم تصل بيانات: " + "، ".join(bad[:4])) if bad else "")
    return FC


def _fc_run():
    if _FC_RUN["busy"]:
        return
    _FC_RUN["busy"] = True
    try:
        fc_fetch()
    finally:
        _FC_RUN["busy"] = False


def fc_view():
    meta = _fc_meta()
    return {"ok": True, "on": indic_cfg()["on"], "ts": FC["ts"], "every": FC_EVERY, "err": FC["err"],
            "rows": [FC["coins"][s] for s in FC["order"] if s in FC["coins"]],
            "hz": [{"k": k, "name": nm, "tf": tf, "tfn": FC_TFN[tf], "H": H, "days": dd} for k, nm, tf, H, dd in FC_H],
            "kinds": [{"k": k, "name": meta[k][0], "ico": meta[k][1], "what": meta[k][2]} for k in [x[0] for x in _IND2_K] + [x[0] for x in _FC_X]]}


def fc_api():
    """🔮 GET /api/forecast — لو لسه ما انحسب ⇒ يبدي بالخلفية والنافذة ترجع تسأل بعد ثواني"""
    v = fc_view()
    if not v["rows"] and v["on"] and ticker_cfg()["coins"] and not _FC_RUN["busy"]:
        threading.Thread(target=_safe, args=(_fc_run,), daemon=True).start()
    v["busy"] = _FC_RUN["busy"] or (not v["rows"] and v["on"] and bool(ticker_cfg()["coins"]))
    return v


def fc_loop():
    """⏱️ التوقعات كل نص ساعة · يبدي بعد المؤشرات بشوية حتى ما يزاحمها · بس لما المؤشرات شغّالة"""
    time.sleep(90)
    while True:
        try:
            if (indic_cfg()["on"] or ina_cfg()["on"]) and ticker_cfg()["coins"]:      # 🟢 v3.36.27: مؤشر القاع للتنبيهات حتى لو الشريط مطفي
                _fc_run()
        except Exception:
            pass
        time.sleep(FC_EVERY)


# ═══════════════ 🔔 v3.26.6: إشعارات الأسعار — مثل إشعارات البرامج (تيليغرام + التطبيق + 🔔 اللوحة) · مو مزعجة · تنطفي وتشتغل ═══════════════
#   للعملات المختارة (⚙️ «📈 شريط الأسعار»): ⚡ حركة قوية خلال 15 دقيقة أو ساعة · 🔥/🔻 كل درجة خلال 24 ساعة (5% · 10% · 15%…) ·
#   عتبة أكبر للعملة المتقلبة (حسب تذبذبها) · نفس الحركة ما تتكرر (ساعة ونص إلا لو تضاعفت) · 📊 v3.31.0: المؤشرات انفصلت ⇒ «📊 تنبيهات المؤشرات» تحت ·
#   كل الإشعارات بنفس الدقيقة برسالة وحدة · حد يومي · زر الكتم 🔕 يكتمها ويّا الباقي. قراءة أسعار عامة بس — ولا أمر.
PXA_FILE = os.path.join(ROOT, "Holy_PriceAlerts.json")
_PXA = {"hist": {}, "lock": threading.Lock()}
PXA_SENS = {   # m15/h1/h4: أقل حركة % · k15/kh/k4: × تذبذب الساعة (ATR%) للعملة المتقلبة · d1: درجة الـ24 ساعة
    "low":  {"lbl": "هادئة",   "m15": 2.5, "h1": 4.5, "h4": 6.0, "k15": 2.0, "kh": 3.5, "k4": 7.0, "d1": 8.0},
    "mid":  {"lbl": "متوسطة",  "m15": 1.5, "h1": 3.0, "h4": 4.0, "k15": 1.5, "kh": 2.5, "k4": 5.0, "d1": 5.0},
    "high": {"lbl": "حساسة",   "m15": 1.0, "h1": 2.0, "h4": 2.5, "k15": 1.2, "kh": 2.0, "k4": 4.0, "d1": 3.0},
}   # 📉 v3.26.9: h4 «خلال 4 ساعات» — النزول/الصعود البطيء (4% بـ3 ساعات ما كان يوصل له إشعار أبداً)
PXA_CH = {"both": "تيليغرام + التطبيق", "tg": "تيليغرام فقط", "app": "التطبيق فقط"}
PXA_COOL = 90 * 60               # نفس العملة ونفس الاتجاه (15 دقيقة/ساعة) ما تتكرر خلال ساعة ونص — إلا لو الحركة تضاعفت تقريباً
PXA_COOL4 = 4 * 3600             # 📉 v3.26.9: «خلال 4 ساعات» لنفس العملة ونفس الاتجاه مرة كل 4 ساعات — إلا لو الحركة تضاعفت تقريباً


def pxa_cfg():
    c = _safe(app_cfg, default={}) or {}
    s = str(c.get("pxa_sens") or "mid")
    ch = str(c.get("pxa_ch") or "both")
    try:                                          # 🔔 v3.36.3: بلا حد يومي افتراضياً (كان 20) — 0 = بلا حد · رقم مكتوب بالإعدادات = حدّه
        v = int(c.get("pxa_cap") or 0)
        cap = 0 if v <= 0 else max(3, min(100, v))
    except Exception:
        cap = 0
    return {"on": bool(c.get("pxa_on", True)), "sens": s if s in PXA_SENS else "mid", "ch": ch if ch in PXA_CH else "both", "cap": cap}


def _pxa_ago(H, now, sec, slack):
    """السعر قبل sec ثانية من عيّنات الدقيقة (أقرب عيّنة بنافذة slack) — None لو ماكو (اللوحة لسه مشتغلة)"""
    best = None
    for ts, px in H:
        d = abs((now - ts) - sec)
        if d <= slack and (best is None or d < best[0]):
            best = (d, px)
    return best[1] if best else None


def pxa_seed(coins):
    """🔁 v3.26.9: بعد إعادة تشغيل اللوحة (تحديث · انقطاع) سجل الدقائق يبدي فاضي ⇒ «خلال 15 دقيقة/ساعة/4 ساعات» تبقى عمياء لساعات —
    نملّيه مرة وحدة لكل عملة من شموع الدقيقة العامة بـOKX (آخر 5 ساعات · قراءة بس — بلا مفاتيح ولا أوامر)"""
    n = 0
    for sym in coins or []:
        with _PXA["lock"]:
            if _PXA["hist"].get(sym):
                continue
        try:
            r = _okx_pub(f"/api/v5/market/candles?instId={sym}&bar=1m&limit=300")
            data = r.get("data") if r and str(r.get("code")) == "0" else None
            if not data:
                continue
            now = time.time()
            pts = sorted((int(c[0]) / 1000.0 + 60, float(c[4])) for c in data if float(c[4] or 0) > 0)
            pts = [p for p in pts if p[0] <= now]
            with _PXA["lock"]:
                if pts and not _PXA["hist"].get(sym):
                    _PXA["hist"][sym] = pts
                    n += 1
        except Exception:
            continue
    return n


def pxa_tick(now=None, rows=None, send=True):
    """🔔 جولة إشعارات الأسعار (بعد كل تحديث للأسعار · العيّنة كل دقيقة) — ترجع الإشعارات اللي طلعت"""
    cfg = pxa_cfg()
    now = float(now if now is not None else time.time())
    rows = rows if rows is not None else list(TICKER.get("rows") or [])
    coins = set(ticker_cfg()["coins"])
    with _PXA["lock"]:
        for r in rows:
            sym, px = r.get("sym"), float(r.get("px") or 0)
            if sym not in coins or px <= 0:
                continue
            H = _PXA["hist"].setdefault(sym, [])
            if not H or now - H[-1][0] >= 55:
                H.append((now, px))
                del H[:-1700]                               # ≈ 28 ساعة بعيّنة كل دقيقة
        if not cfg["on"]:
            return []
        st = _safe(load_json, PXA_FILE, default={}) or {}
        if not isinstance(st, dict):
            st = {}
        st0 = json.dumps(st, sort_keys=True, ensure_ascii=False)
        day = datetime.fromtimestamp(now).strftime("%Y-%m-%d")
        if st.get("day") != day:
            st.update(day=day, n=0, capped=False)
        S = PXA_SENS[cfg["sens"]]
        atr = {x.get("sym"): float(x.get("atr") or 0) for x in (INDIC.get("rows") or [])}
        last = st.setdefault("last", {})
        al = []
        for r in rows:
            sym, px = r.get("sym"), float(r.get("px") or 0)
            if sym not in coins or px <= 0:
                continue
            base = sym.split("-")[0]
            H = _PXA["hist"].get(sym) or []
            L = last.setdefault(sym, {})
            d24 = r.get("chg")
            a_ = atr.get(sym) or 0.0
            tail = f"السعر {_px_s(px)}$" + (f" · 24 ساعة {float(d24):+.1f}%" if d24 is not None else "")
            for win, sec, slack, th, lab in (("h1", 3600, 360, max(S["h1"], S["kh"] * a_), "خلال ساعة"),
                                             ("m15", 900, 150, max(S["m15"], S["k15"] * a_), "خلال 15 دقيقة"),
                                             ("h4", 4 * 3600, 900, max(S["h4"], S["k4"] * a_), "خلال 4 ساعات")):
                p0 = _pxa_ago(H, now, sec, slack)
                if not p0:
                    continue
                ch = (px / p0 - 1) * 100
                if abs(ch) < th:
                    continue
                d = "up" if ch > 0 else "dn"
                if now - float(L.get(d + "_ts") or 0) < PXA_COOL and abs(ch) < abs(float(L.get(d + "_mv") or 0)) * 1.8:
                    break                                   # 🔕 نفس الحركة انبلّغت قبل شوية
                if win == "h4" and now - float(L.get(d + "4_ts") or 0) < PXA_COOL4 and abs(ch) < abs(float(L.get(d + "4_mv") or 0)) * 1.8:
                    break                                   # 🔕 هالحركة انبلّغت (نافذة الـ4 ساعات تبقى فوق العتبة ساعات بعد أي قفزة)
                al.append({"sym": sym, "k": win, "d": d, "mv": round(ch, 2), "px": px,
                           "t": f"{'🚀' if d == 'up' else '📉'} {base} {'صعد' if d == 'up' else 'نزل'} {ch:+.1f}% {lab}", "b": tail})
                L[d + "_ts"], L[d + "_mv"] = now, round(ch, 3)
                L[d + "4_ts"], L[d + "4_mv"] = now, round(ch, 3)   # 📉 v3.26.9: أي إشعار بهالاتجاه يسكّت «خلال 4 ساعات» 4 ساعات (ما يعيد نفس القفزة)
                break                                       # إشعار قصير واحد للعملة بالجولة (الساعة قبل الربع)
            if d24 is not None:
                d24 = float(d24)
                lvl = int(abs(d24) // S["d1"])
                key, oth = ("s_up", "s_dn") if d24 >= 0 else ("s_dn", "s_up")
                L[oth] = 0
                prev = int(L.get(key) or 0)
                if lvl > prev and lvl >= 1:
                    al.append({"sym": sym, "k": "d1", "d": "up" if d24 >= 0 else "dn", "mv": round(d24, 2), "px": px,
                               "t": f"{'🔥' if d24 >= 0 else '🔻'} {base} {d24:+.1f}% خلال 24 ساعة", "b": f"السعر {_px_s(px)}$"})
                    L[key] = lvl
                elif lvl < prev and abs(d24) < (prev - 0.5) * S["d1"]:
                    L[key] = lvl                                # 🔁 ينعاد يتسلّح بس لما يرجع نص درجة (ما يتكرر لو يتذبذب حول 5%)
        cut = []
        if cfg["cap"] > 0:                                  # 🔔 v3.36.3: الحد بس لو انكتب رقم (الافتراضي بلا حد · مهلة كل عملة باقية)
            room = cfg["cap"] - int(st.get("n") or 0)
            if len(al) > max(0, room):
                cut, al = al[max(0, room):], al[:max(0, room)]
        st["n"] = int(st.get("n") or 0) + len(al)
        note = ""
        if cut and not st.get("capped"):
            st["capped"] = True
            note = f"🔕 وصلت حد إشعارات الأسعار اليوم ({cfg['cap']}) — باقي اليوم بلا إشعارات أسعار"
        log = st.setdefault("log", [])
        for a in al:
            log.insert(0, {"ts": round(now), "sym": a["sym"], "k": a["k"], "t": a["t"], "b": a["b"]})
        del log[50:]
        if json.dumps(st, sort_keys=True, ensure_ascii=False) != st0:     # 💾 بس لو تغيّر شي (الجولة كل 10 ثواني)
            try:
                save_json_atomic(PXA_FILE, st)
            except Exception:
                pass
    if send and (al or note):
        _pxa_send(al, note, cfg)
    return al


def _pxa_send(al, note, cfg):
    """📨 رسالة وحدة للجولة: إشعار واحد ⇒ عنوانه هو الإشعار · أكثر ⇒ «🔔 إشعارات الأسعار (N)» وكل عملة بسطر"""
    if len(al) == 1:
        text = al[0]["t"] + "\n" + al[0]["b"] + (("\n" + note) if note else "")
    elif al:
        text = f"🔔 إشعارات الأسعار ({len(al)})\n" + "\n".join(f"{a['t']} · {a['b'].split(' · ')[0]}" for a in al) + (("\n" + note) if note else "")
    else:
        text = note
    for a in al:                                                # 🔔 مركز الإشعارات باللوحة — اسم العملة يطلع بالعريض قبل النص ⇒ نشيله من النص
        bt = re.sub(r"\s" + re.escape(a["sym"].split("-")[0]) + r":?(?=\s)", "", a["t"], count=1)
        _safe(_dash_event, a["sym"], bt + " · " + a["b"], default=None)
    if TG_MUTED["v"]:
        journal("notify", "🔕 لم يُرسَل إشعار أسعار (الكتم مفعّل): " + text[:300], "info")
        return False
    ok = True
    if cfg["ch"] in ("both", "tg"):
        ok = bool(tg_send(text, plain=True)) and ok             # plain = بلا تنسيق وبلا نسخة ثانية للتطبيق
    if cfg["ch"] in ("both", "app"):
        _safe(app_feed_push, text, None, "price", default=None)  # 📱 v3.26.7: الضغط عليه يفتح التطبيق بس (مو نافذة الإعدادات) · قناة «📈 إشعارات الأسعار»
    return ok


def pxa_set(v):
    v = v or {}
    c = app_cfg()
    if v.get("on") is not None:
        c["pxa_on"] = bool(v["on"])
    if v.get("sens") in PXA_SENS:
        c["pxa_sens"] = v["sens"]
    if v.get("ch") in PXA_CH:
        c["pxa_ch"] = v["ch"]
