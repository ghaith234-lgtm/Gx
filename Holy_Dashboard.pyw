        threading.Thread(target=handoff_loop, daemon=True).start()  # 🪙 تسليم العملة خلال ثوانٍ
        srv = ThreadingHTTPServer(("0.0.0.0", port), Handler)
        threading.Thread(target=srv.serve_forever, daemon=True).start()
        print(f"⚡ Holy Dashboard v3 يعمل: {url}  (ومن الموبايل: http://IP-حاسبتك:{port})")
        def _boot_army():
            time.sleep(1.0)
            orphans = kill_all_bot_procs()   # امسح أي بوت يتيم من جلسة سابقة لم تُغلق بنظافة
            if orphans:
