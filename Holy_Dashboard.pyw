def log_event(msg):
    """📝 سطر حدث للوحة — يطبع على stdout ويكتب بملف دوّار.

    🐞 كانت تُنادى من **7 مواضع وما معرَّفة ولا مرة** منذ v2.8.3، فترمي
       NameError. وأخطرها موضعان:
       · `launch` (سطر 2084): داخل try/except يبلع الخطأ ⇒ **حارس منع تكرار
         العمليات ما نفّذ ولا مرة** — `kill_bot_pids` ما تُستدعى أبداً.
       · `kill_bot_pids` (سطر 2182): **بلا حماية** ⇒ ترمي بعد إنهاء العمليات
         فالمستدعي ما يستلم العدد.
       هذا على الأرجح سبب العمليات اليتيمة المتراكمة.
    """
    try:
        line = "[" + time.strftime("%Y-%m-%d %H:%M:%S") + "] " + str(msg)
    except Exception:
        return
    try:
        print(line, flush=True)
    except Exception:
        pass
    try:
        with _LOG_LOCK:
            try:                       # تدوير عند 2 ميغا — ما يكبر بلا حدود
                if os.path.getsize(EVENTS_LOG) > 2_000_000:
                    os.replace(EVENTS_LOG, EVENTS_LOG + ".1")
            except Exception:
                pass
            with open(EVENTS_LOG, "a", encoding="utf-8") as fh:
                fh.write(line + "\n")
    except Exception:
        pass
    _m = str(msg)
    journal("system", _m, "err" if ("❌" in _m or "خطأ" in _m or "فشل" in _m) else ("warn" if "⚠️" in _m else "info"))


