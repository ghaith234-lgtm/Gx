                try:
                    out.append({"h": float(c[2]), "l": float(c[3]), "c": float(c[4])})
                except Exception:
                    continue
            out.reverse()
            if len(out) >= 20:
                return out
    except Exception:
        pass
    try:
        j = _http_json(f"https://api.binance.com/api/v3/klines?symbol={sym.replace('-', '')}"
                       f"&interval=1h&limit={limit}", timeout=10) or []
        return [{"h": float(k[2]), "l": float(k[3]), "c": float(k[4])} for k in j]
    except Exception:
        return []


def _ema(vals, n):
    if not vals:
        return None
    k = 2.0 / (n + 1.0)
    e = vals[0]
    for v in vals[1:]:
        e = v * k + e * (1 - k)
    return e


def _rsi(closes, n=14):
    """📉 مؤشر القوة النسبية — فوق 70 مشترى زايد · تحت 30 مباع زايد (تهدئة بطريقة وايلدر)."""
    if len(closes) < n + 1:
        return None
    g = l = 0.0
    for i in range(1, n + 1):
        d = closes[i] - closes[i - 1]
        g += max(d, 0.0)
        l += max(-d, 0.0)
    ag, al = g / n, l / n
    for i in range(n + 1, len(closes)):
        d = closes[i] - closes[i - 1]
        ag = (ag * (n - 1) + max(d, 0.0)) / n
        al = (al * (n - 1) + max(-d, 0.0)) / n
    if al <= 1e-12:
        return 100.0 if ag > 0 else 50.0
    return 100.0 - 100.0 / (1.0 + ag / al)


def _atr_pct(c, n=14):
    """🌊 متوسط حركة الساعة كنسبة من السعر — كل ما زاد، الشبكة تاكل درجات أكثر."""
    if len(c) < n + 2:
        return None
    trs = []
    for i in range(1, len(c)):
        trs.append(max(c[i]["h"] - c[i]["l"], abs(c[i]["h"] - c[i - 1]["c"]), abs(c[i]["l"] - c[i - 1]["c"])))
    px = c[-1]["c"] or 1.0
    return sum(trs[-n:]) / n / px * 100.0


def indic_cfg():
    c = _safe(app_cfg, default={}) or {}
    return {"on": bool(c.get("indic_on", True)), "coins": ticker_cfg()["coins"]}


def indic_fetch():
    """📊 لكل عملة مختارة: الاتجاه · القوة النسبية · حركة الساعة · موقع السعر بمدى 7 أيام + مؤشر الخوف والطمع."""
    cfg = indic_cfg()
    rows, bad = [], []
    for sym in cfg["coins"]:
        cd = _ind_candles(sym)
        if len(cd) < 20:
            bad.append(sym)
            continue
        cl = [x["c"] for x in cd]
        e9, e21 = _ema(cl[-60:], 9), _ema(cl[-60:], 21)
        trend = "flat"
        if e9 and e21:
            gap = (e9 - e21) / e21 * 100.0
            trend = "up" if gap > 0.12 else ("down" if gap < -0.12 else "flat")
        hi = max(x["h"] for x in cd)
        lo = min(x["l"] for x in cd)
        pos = ((cl[-1] - lo) / (hi - lo) * 100.0) if hi > lo else 50.0
        _r, _a = _rsi(cl), _atr_pct(cd)          # ⚠️ صفر قراءة صحيحة — ما ننفع نستعمل `or`
        rows.append({"sym": sym, "base": sym.split("-")[0], "px": cl[-1],
                     "rsi": round(_r if _r is not None else 50.0, 1), "trend": trend,
                     "atr": round(_a if _a is not None else 0.0, 2), "pos": round(pos, 0),
                     "hi": hi, "lo": lo})
    fng = INDIC.get("fng") or {}
    try:
        j = _http_json("https://api.alternative.me/fng/?limit=1", timeout=8) or {}
        d0 = (j.get("data") or [{}])[0]
        v = int(float(d0.get("value") or 0))
        if v > 0:                                # 🛟 ما وصل رد ⇒ نبقي آخر قراءة، لا نكتب صفراً كاذباً
            fng = {"v": v, "txt": _fng_ar(v)}
    except Exception:
        pass
    INDIC.update(ts=time.time(), rows=rows, fng=fng,
                 err=("ما وصلت شموع: " + "، ".join(bad[:4])) if bad else "")
    return INDIC


def _fng_ar(v):
    """تصنيف مؤشر الخوف والطمع بالعربي."""
    v = int(v or 0)
    if v < 25:
        return "خوف شديد"
    if v < 45:
        return "خوف"
    if v < 56:
        return "محايد"
    if v < 75:
        return "طمع"
    return "طمع شديد"


