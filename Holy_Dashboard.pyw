document.addEventListener('keydown',e=>{if(e.key==='Escape'){if(npOpen){toggleNotif();return}hideModal();closeDrawer();closePage('reports');closePage('wallets')}});
/* 🎨 الثيمات + ⚡ الوضع الخفيف + ⏱️ سرعة التحديث — محفوظة بهذا الجهاز (كل جهاز على راحته) */
const THEMES=[['holy','بنفسجي ليلي','#0d0524','#a78bfa','#22d3ee','#fb7185'],
  ['ocean','أزرق محيطي','#061431','#60a5fa','#22d3ee','#34d399'],
  ['emerald','زمردي','#051a14','#2dd4bf','#67e8f9','#fbbf24'],
  ['gold','ذهبي','#16110a','#f4c95d','#e7c9a9','#34d399'],
  ['graphite','رمادي هادئ','#141619','#a5b4fc','#93c5fd','#e8eaed'],
  ['light','نهاري فاتح','#f3f1fa','#6d28d9','#0e7490','#be123c']];
function _ls(k,v){try{if(v===undefined)return localStorage.getItem(k);if(v===null)localStorage.removeItem(k);else localStorage.setItem(k,v)}catch(e){return null}}
function uiTheme(){const t=_ls('dash_theme');return THEMES.some(x=>x[0]===t)?t:'holy'}
function applyTheme(t){const h=document.documentElement;
  if(t&&t!=='holy')h.dataset.theme=t;else delete h.dataset.theme;
  const m=document.querySelector('meta[name="theme-color"]');if(m)m.content=(THEMES.find(x=>x[0]===t)||THEMES[0])[2];
  PC=pcPal();const a=$('#pcLd'),r=$('#pcLr');if(a)a.style.background=PC.d;if(r)r.style.background=PC.r;
  if(typeof PV!=='undefined'&&PV){try{pcBars(PV);pcDonut(PV)}catch(e){}}}
function setTheme(t){_ls('dash_theme',t==='holy'?null:t);applyTheme(t);openSettings();
  toast('🎨 '+((THEMES.find(x=>x[0]===t)||THEMES[0])[1])+(document.querySelector('.cchart iframe')?' — افتح الشارت من جديد حتى يتلوّن':''),true)}
function tvTheme(){return uiTheme()==='light'?'light':'dark'}
function tvBg(){return uiTheme()==='light'?'%23ffffff':'%230b0420'}
function uiLite(){return _ls('dash_lite')==='on'}
function uiLiteToggle(){const on=!uiLite();_ls('dash_lite',on?'on':null);document.documentElement.classList.toggle('lite',on);
  schedPoll();openSettings();toast(on?'⚡ الوضع الخفيف شغّال — بلا حركات ولا ضبابية':'✨ رجعت الحركات الكاملة',true)}
function pollMs(){const v=+_ls('dash_poll')||0;return [2000,3000,6000,10000].includes(v)?v:(uiLite()?6000:3000)}
function setPoll(ms){_ls('dash_poll',String(ms));schedPoll();openSettings()}
/* ⏱️ الاستطلاع: الصفحة مخفية (تبويب ثاني · الشاشة مقفولة) ⇒ كل 20 ثانية بس (يبقى صوت الربح والإشعارات شغّال) · ترجع ⇒ تحديث فوري */
let POLL=null;
function schedPoll(){clearInterval(POLL);POLL=setInterval(tick,document.hidden?20000:pollMs())}
document.addEventListener('visibilitychange',()=>{if(!document.hidden){tick();
  const T=((DATA||{}).ticker||{});liveWS(wsCoins(T.on?(T.coins||[]):[]))}schedPoll()});
/* ⚡ رموز القناة اللحظية = عملات الشريط + عملات البوتات (بدل استطلاع كل بوت من المتصفح كل 4 ثواني) */
function wsCoins(tape){const s=new Set(tape||[]);((DATA&&DATA.bots)||[]).forEach(b=>{if(b&&b.symbol)s.add(b.symbol)});return [...s].sort()}

async function tick(){
  try{const d=await api('/api/overview');DATA=d;$('#pulse').classList.remove('off');
    if(lastTotal!==null&&d.total_profit>lastTotal+1e-9&&localStorage.getItem('dash_sound')!=='off')chime();
    lastTotal=d.total_profit;updTop(d);syncCards(d.bots||[]);
    if(CUR&&$('#drawer').classList.contains('on'))fillDrawer(false);
  }catch(e){$('#pulse').classList.add('off')}}
window.JPX={};
async function pxLoop(){try{if(!document.hidden)for(const b of ((DATA&&DATA.bots)||[])){let ok=false;
 const _l=LIVE.last[b.symbol];if(_l&&Date.now()-_l.ts<15000)continue;     // ⚡ عنده سعر لحظي — ما نستطلع
 try{const r=await fetch('https://www.okx.com/api/v5/market/ticker?instId='+b.symbol,{cache:'no-store'});const j=await r.json();if(j&&j.code=='0'&&j.data){JPX[b.symbol]=+j.data[0].last;ok=true}}catch(e){}
 if(!ok){try{const r=await fetch('https://api.binance.com/api/v3/ticker/price?symbol='+b.symbol.replace('-',''));const j=await r.json();if(j&&j.price)JPX[b.symbol]=+j.price}catch(e){}}}}catch(e){}
 setTimeout(pxLoop,10000)}
setTimeout(pxLoop,6000);
function coinTag(c){const l=(c||'?').toLowerCase();return `<img class="coin" src="https://assets.coincap.io/assets/icons/${l}@2x.png" data-alt="https://static.okx.com/cdn/oksupport/asset/currency/icon/${l}.png" onerror="cfb(this,'${c}')">`}
/* 📉 v3.21.7: أثر السعر — شارة ملوّنة (أخضر صعود · أحمر نزول) */
function fxChip(v,big){v=+v||0;const up=v>=0;
  return `<span style="display:inline-flex;align-items:center;gap:6px;padding:${big?'3px 10px':'1px 7px'};border-radius:8px;font-size:${big?12:10.5}px;white-space:nowrap;
   background:${up?'rgb(var(--green2-rgb)/.12)':'rgb(var(--red2-rgb)/.12)'};color:${up?'var(--green)':'var(--red)'}">${big?'<span>📉 أثر السعر اليوم</span>':''}<span class="num" dir="ltr">${up?'+':'−'}$${Math.abs(v).toFixed(2)}</span></span>`}
function fxRow(c){const tot=(c.tot!=null?c.tot:c.bal), lk=+c.lock||0;
  return `<div style="display:flex;align-items:center;gap:9px;font-size:12.5px;flex-wrap:wrap">${coinTag(c.ccy)}<b style="min-width:64px">${c.ccy}</b>
   <span class="num" style="color:var(--mut)" title="الكمية الكلية (حر + محجوز بأوامر)">${tot}</span>${lk>0?`<span class="num" style="color:var(--mut2);font-size:10.5px" title="محجوز بأوامر مفتوحة">🔒 ${lk}</span>`:''}
   <span style="margin-inline-start:auto;display:flex;align-items:center;gap:7px">${c.fx!=null?`<span class="num" dir="ltr" style="font-size:10.5px;color:${c.pct>=0?'var(--green)':'var(--red)'}" title="تغيّر سعرها من أول اليوم">${c.pct>=0?'+':''}${c.pct}%</span>${fxChip(c.fx)}`:''}<b class="num">$${c.usd}</b></span></div>`}
async function openWalletView(){let s={wallets:[]};try{s=await api('/api/settings')}catch(e){}
 const ws=s.wallets||[], bf=s.bot_fx||[];let h='';
 h+=`<p style="color:var(--mut2);font-size:11px;line-height:1.75;margin:-6px 0 12px">📉 <b>أثر السعر اليوم</b> = كمية كل عملة عندك هسه (الحرة + المحجوزة بأوامر) × (سعرها هسه − سعرها بأول اليوم${s.fx_day?' '+s.fx_day:''}).
  يعني كم تغيّرت <b>قيمة عملاتك بالدولار</b> بسبب حركة السعر بس — <b>مو ربح ولا خسارة تداول</b>، ودولاراتك (USDT) ما تتأثر. يرجع لما يرجع السعر.</p>`;
 if(!ws.length&&!bf.length)h+='<p style="color:var(--mut)">ماكو محافظ بعد — أضفها من 👛 المحافظ</p>';
 ws.forEach(w=>{h+=`<div class="panel" style="margin-bottom:12px"><div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;flex-wrap:wrap"><b style="font-size:15px">👛 ${w.name}</b><span class="num" style="font-size:19px;background:linear-gradient(92deg,var(--cyan),var(--vio));-webkit-background-clip:text;background-clip:text;color:transparent">${w.eq!=null?'$'+w.eq:'—'}</span>${w.fx&&w.fx.n?fxChip(w.fx.usd,true):''}${w.err?('<span style="color:var(--red);font-size:11px">'+w.err+'</span>'):''}</div>`;
  const cs=w.coins||[];
  if(cs.length){h+='<div style="display:flex;flex-direction:column;gap:6px;max-height:38vh;overflow-y:auto">';
   cs.forEach(c=>{h+=fxRow(c)});
   h+='</div>'}
  else if(!w.err)h+='<p style="color:var(--mut);font-size:12px">⏳ جار الجلب من OKX… (يتحدث كل 30 ثانية — أو اضغط 🔄)</p>';
  h+='</div>'});
 bf.forEach(a=>{h+=`<div class="panel" style="margin-bottom:12px"><div style="display:flex;align-items:center;gap:10px;margin-bottom:8px;flex-wrap:wrap"><b style="font-size:14px">🤖 حساب بوتات <span class="num" style="color:var(--mut2);font-size:11px">${a.key}</span></b>${fxChip(a.usd,true)}</div>
  <p style="color:var(--mut2);font-size:10.5px;margin:-2px 0 8px">مو مضاف كمحفظة — عملات البوتات بس (كل عملة مرة وحدة). أضفه من 👛 المحافظ حتى تشوف كل عملاته.</p>
  <div style="display:flex;flex-direction:column;gap:6px">${(a.coins||[]).map(fxRow).join('')}</div></div>`});
 showModal(`<h2>💰 محفظتي في المنصة</h2>${h}<div class="mbtns"><button onclick="(async()=>{toast('🔄 أجلب من OKX…',true);await api('/api/control',{action:'refresh_bal'});openWalletView()})()">🔄 تحديث</button><button onclick="hideModal()">إغلاق</button></div>`)}
window.addEventListener('error',e=>{try{toast('⚠️ خلل واجهة: '+e.message,false)}catch(_){}});
/* ↔️ v3.21.7: صف البوتات/الصفحات — يبين إن بيه سحب (حافة باهتة + سهم) · الضغط على السهم يسحب */
/* ↔️ v3.21.9: صف الأزرار — تلميح سحب خفيف (ما ينلمس) بجهة الأزرار الباقية · يظهر بعد ثانيتين */
function navSync(){const n=$('#navAct'),w=$('#navwrap');if(!n||!w)return;
  const max=n.scrollWidth-n.clientWidth;if(max<=3){w.classList.remove('ml','mr');return}
  const p=Math.abs(n.scrollLeft), rtl=getComputedStyle(n).direction==='rtl';
  const left=rtl?max-p:p, right=rtl?p:max-p;                       // الباقي بكل جهة (فيزيائياً)
  w.classList.toggle('ml',left>3);w.classList.toggle('mr',right>3)}
(()=>{const n=$('#navAct'),w=$('#navwrap');if(!n||!w)return;n.addEventListener('scroll',navSync,{passive:true});window.addEventListener('resize',navSync);
  [60,600,1600].forEach(t=>setTimeout(navSync,t));
  setTimeout(()=>{navSync();w.classList.add('hint');requestAnimationFrame(()=>requestAnimationFrame(()=>w.classList.add('show')))},2000)})();
tick();schedPoll();applyTheme(uiTheme());
document.body.classList.add('boot');setTimeout(()=>document.body.classList.remove('boot'),1400);
setInterval(()=>{if(CUR&&$('#tab_log').style.display!=='none')loadHist()},8000);
</script>
</body>
</html>"""

