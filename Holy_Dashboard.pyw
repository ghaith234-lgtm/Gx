                                       "msg": "ولا بوت عنده إعادة استثمار شغّالة بلقطة مسجّلة"})
                _tg_report(txt)
                return self._json({"ok": True, "msg": "💠 انرسل تقرير إعادة الاستثمار"})
            return self._json(control(data.get("dir", ""), act, data.get("value")))
        if path == "/api/deploy":
