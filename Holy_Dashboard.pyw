def ri_period(kind="daily", ref=None):
    """💠 نمو إعادة الاستثمار خلال فترة التقرير — من سجل الصفقات."""
    try:
        now = ref or datetime.now()
        span = {"daily": 1, "weekly": 7, "monthly": 30}.get(kind, 1)
        end = (now - timedelta(days=1)).strftime("%Y-%m-%d")
        start = (now - timedelta(days=span)).strftime("%Y-%m-%d")
        m = _safe(ri_archive_map, start, end, default={}) or {}
        g = sum(m.values())
        on = bool(m) or any((v.get("ri") or 0) > 0
                            for v in (_safe(daily_earn_map, 3, default={}) or {}).values())
        return {"on": on, "usd": round(g, 4)}
    except Exception:
        return {"on": False, "usd": 0.0}


def _ri_at(ent, day):
    """أقرب لقطة عند اليوم أو قبله — يتحمّل أيام مفقودة (انقطاع/إطفاء)."""
    ds = sorted(ent.get("daily") or {})
    prev = None
    for k in ds:
        if k <= day:
            prev = k
        else:
            break
    return (ent["daily"][prev], prev) if prev else (None, None)







