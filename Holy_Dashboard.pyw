_ACCX = {"st": None, "dirty": False}      # الدرجات اللي انبلّغت لكل بوت/جهة بهالإيقاف — محفوظة بملف الإشعارات
_ACCX_FILE_KEY = "__accx__"
DASH_EVENTS = []                          # 🔔 أحداث تطلع من اللوحة نفسها ⇒ تنضم لمركز الإشعارات الداخلي


def _px_s(x):
    """سعر للعرض بأرقامه المعنوية — العملة الرخيصة ما تصير 0.0000 والغالية ما تطلع بخانات زايدة."""
    try:
        x = float(x)
    except Exception:
        return str(x)
    if not math.isfinite(x):
        return "—"
    if not x:
        return "0"
    d = 4 if abs(x) >= 1 else min(12, max(4, 3 - int(math.floor(math.log10(abs(x))))))
    return f"{x:.{d}f}".rstrip("0").rstrip(".")


def _accx_ok(b, side, p):
    """نفس قيود المحرك وقت الاستئناف: شراء تحت «أدنى سعر» ما ينشرى (v3.21.1) · النطاق: ما يطلع برّا الحدّين."""
    c = b["cfg"]
    if side == "buy" and p < float(c.get("min_price") or 0) - 1e-12:
        return False
    if str(c.get("bot_type") or "grid") == "grid_range":
        g = float(c.get("grid_percentage") or 0.008)
        lo, up = float(c.get("lower_price") or 0), float(c.get("upper_price") or 0)
        if side == "buy":
            return not ((lo > 0 and p < lo - 1e-12) or (up > 0 and p * (1 + g) > up + 1e-12))
        return not (up > 0 and p > up + 1e-12)
    return True


def _accx_levels(b, st, side, cp):
    """الدرجات اللي **قطعها السعر** وهي بمخزن الإيقاف = اللي تتنفّذ بأمر واحد لو تستأنف هسه
    (شراء: سعرها ≥ السعر الحالي · بيع: ≤ السعر الحالي). [(سعر، كمية)]"""
    out = []
    for v in (st.get("accum_buys" if side == "buy" else "accum_sells") or {}).values():
        try:
            p, q = float((v or {}).get("target_price") or 0), float((v or {}).get("locked_qty") or 0)
        except Exception:
            continue
        if p > 0 and q > 0 and _accx_ok(b, side, p) and (p >= cp if side == "buy" else p <= cp):
            out.append((p, q))
    return out


def _accx_afford(b, lv, cp):
    """💵 v3.21.8 (ب٢٤): كم درجة من المقطوعة يغطيها دولارك الحر هسه — نفس حساب المحرك بالضبط (من الحافة · سعر الأمر المجمّع
    ≤ السعر × 1.005 و ≤ أوطى درجة بالأمر · هامش 0.2%). None = الرصيد ما انجلب. الدولار الحر مشترك بين بوتات نفس الحساب."""
    ent = BAL.get(b["dir"]) or {}
    if "q_av" not in ent or not lv or not cp or cp <= 0:
        return None
    av = float(ent.get("q_av") or 0)
    cap, budget = round(float(cp) * 1.005, 4), av * 0.998
    k, sq, mn = 0, 0.0, None
    for i, (p, q) in enumerate(sorted(lv, key=lambda x: -x[0])):
        sq += q
        mn = p if mn is None else min(mn, p)
        if sq * min(cap, mn) <= budget + 1e-12:
            k = i + 1                                  # أطول بادئة يغطيها الدولار (نفس المحرك)
    need = sum(q for _, q in lv) * min(cap, min(p for p, _ in lv))
    return {"k": k, "n": len(lv), "av": round(av, 2), "need": round(need, 2)}


def _accx_snap(b, st):
    """📦 v3.21.2: عدّاد الإيقاف للكرت والنافذة — **اللي قطعها السعر بس** (يبدي من صفر لحظة الإيقاف ويزيد كل ما يقطع درجة)
    + المبلغ بأسعار الدرجات · kb/ks = كل المحفوظ بالمخزن (الأوامر اللي انسحبت لحظة الإيقاف ترجع بأماكنها بالاستئناف)."""
    cp = float(PX.get(b["symbol"]) or st.get("current_price") or 0)
    out = {"nb": 0, "ub": 0.0, "ns": 0, "us": 0.0,
           "kb": len(st.get("accum_buys") or {}), "ks": len(st.get("accum_sells") or {})}
    if cp > 0 and float(st.get("buy_floor") or 0) > 0:
        lv = _accx_levels(b, st, "buy", cp)
        out["nb"], out["ub"] = len(lv), round(sum(p * q for p, q in lv), 2)
        out["cb"] = round(sum(q for _, q in lv), 8)    # 🪙 v3.21.10: مجموع العملة (لنافذة تأكيد الاستئناف)
        _af = _accx_afford(b, lv, cp)                  # 💵 v3.21.8 (ب٢٤)
        if _af:
            out["ab"], out["qa"], out["qn"] = _af["k"], _af["av"], _af["need"]
    if cp > 0 and float(st.get("sell_ceiling") or 0) > 0:
        lv = _accx_levels(b, st, "sell", cp)
        out["ns"], out["us"] = len(lv), round(sum(p * q for p, q in lv), 2)
        out["cs"] = round(sum(q for _, q in lv), 8)    # 🪙 v3.21.10: مجموع العملة (لنافذة تأكيد الاستئناف)
    return out


def _accx_msg(b, side, lv, n_new, lim, cp):
    """(رسالة تيليگرام، سطر مركز الإشعارات): كم أمر · معدل سعر الدرجات · الكمية والمبلغ · تقدير الاستئناف الآن."""
    sym = b["symbol"]
    base = sym.split("-")[0]
    buy = side == "buy"
    n = len(lv)
    q = sum(x[1] for x in lv)
    usd = sum(x[0] * x[1] for x in lv)                 # المبلغ لو كل درجة انفّذت بسعرها (البوت العادي)
    avg = usd / q if q > 0 else 0.0                    # معدل موزون بالكمية
    now = cp * q                                       # أمر واحد بسعر السوق هسه
    k = (b["cfg"].get("api_key") or "").strip()
    tk = float((_FEE_CACHE.get(f"{k[:8]}|{sym}") or {}).get("taker") or 0.001)
    fee = now * tk                                     # الأمر المجمّع «آخذ» (IOC)
    gain = (usd - now) if buy else (now - usd)
    ar = "الشراء" if buy else "البيع"
    tg = (f"📦 *إيقاف {ar} — `{sym}`*\n"
          f"━━━━━━━━━━━━━\n"
          f"{'⬇️' if buy else '⬆️'} السعر عبر `{n_new}` درجة {'شراء' if buy else 'بيع'} جديدة\n"
          f"{'🟢 تگدر تشتري' if buy else '🔴 تگدر تبيع'}: `{n}` أمر {'تحت الأرضية' if buy else 'فوق السقف'}\n"
          f"📊 معدل سعر الدرجات: `{_px_s(avg)}`\n"
          f"🪙 الكمية: `{q:.8g}` {base}\n"
          f"💵 المبلغ بأسعار الدرجات: `{usd:.2f}$`\n"
          f"━━━━━━━━━━━━━\n"
          f"💲 السعر الحالي: `{_px_s(cp)}` · {'الأرضية' if buy else 'السقف'}: `{_px_s(lim)}`\n"
          f"⚡ لو تستأنف هسه: أمر واحد {'تدفع' if buy else 'تستلم'} ≈ `{now:.2f}$` · "
          f"{'توفير' if buy else 'زيادة'} ≈ `{gain:.2f}$`\n"
          f"🧾 عمولة الأمر ≈ `{fee:.2f}$` (آخذ `{tk * 100:.3f}%`)")
    fd = (f"📦 [إيقاف {ar}] السعر عبر {n_new} درجة جديدة — {'تگدر تشتري' if buy else 'تگدر تبيع'} {n} أمر · "
          f"معدل {_px_s(avg)} · {q:.8g} {base} ≈ {usd:.2f}$ · لو تستأنف هسه ≈ {now:.2f}$ "
          f"({'توفير' if buy else 'زيادة'} {gain:.2f}$)")
    _af = _accx_afford(b, lv, cp) if buy else None     # 💵 v3.21.8 (ب٢٤): الدولار الحر مقابل المطلوب
    if _af:
        if _af["k"] >= _af["n"]:
            tg += f"\n💵 دولارك الحر `{_af['av']:.2f}$` يكفي الكل ✅"
            fd += f" · 💵 دولارك الحر {_af['av']:.2f}$ يكفي الكل"
        elif _af["k"]:
            tg += f"\n💵 دولارك الحر `{_af['av']:.2f}$` يغطي `{_af['k']}` من `{_af['n']}` درجة — الباقي ينتظر بالمخزن لحد ما يتوفر دولار"
            fd += f" · 💵 دولارك الحر {_af['av']:.2f}$ يغطي {_af['k']} من {_af['n']} — الباقي ينتظر"
        else:
            tg += f"\n⚠️ دولارك الحر `{_af['av']:.2f}$` ما يكفي ولا درجة (الكل ≈ `{_af['need']:.2f}$`)"
            fd += f" · ⚠️ دولارك الحر {_af['av']:.2f}$ ما يكفي ولا درجة"
    return tg, fd


def _accx_state():
    if _ACCX["st"] is None:
        cur = _safe(load_json, NOTIFY_FILE, default={}) or {}
        v = cur.get(_ACCX_FILE_KEY)
        _ACCX["st"] = v if isinstance(v, dict) else {}
    return _ACCX["st"]


def _accx_save():
    """يحفظ بس لو تغيّر — والبوتات المحذوفة (مجلدها راح) تنشال من الملف."""
    if not _ACCX["dirty"] or _ACCX["st"] is None:
        return
    for k in [k for k in _ACCX["st"] if not os.path.isdir(os.path.join(ROOT, k))]:
        _ACCX["st"].pop(k, None)                       # بس اللي مجلده انحذف فعلاً (قراءة وحدة فاشلة ما تمسح)
    cur = _safe(load_json, NOTIFY_FILE, default={}) or {}
    cur[_ACCX_FILE_KEY] = _ACCX["st"]
    save_json_atomic(NOTIFY_FILE, cur)
    _ACCX["dirty"] = False


def _accx_tick(b, st, cp):
    """📦 v3.21.1: إشعار **مرة وحدة** لكل درجة يعبرها السعر وإنت موقف — شراء تحت الأرضية / بيع فوق السقف:
    كم أمر تقدر تشتري/تبيع هسه بأمر واحد · معدل سعر الدرجات · الكمية والمبلغ · تقدير الاستئناف الآن.
    تذبذب السعر على نفس الدرجة ما يعيد الإشعار · الإيقاف يخلص أو حدّه يتغيّر ⇒ يبدي من جديد ·
    محفوظ بملف الإشعارات ⇒ إعادة تشغيل اللوحة ما تعيد القديم."""
    S = _accx_state()
    key = os.path.relpath(b["dir"], ROOT)
    ent = S.setdefault(key, {})
    out = []
    for side, lk, ak in (("buy", "buy_floor", "accum_buys"), ("sell", "sell_ceiling", "accum_sells")):
        lim = float(st.get(lk) or 0)
        rec = ent.get(side)
        if lim <= 0:
            if rec is not None:
                ent.pop(side, None)                    # الإيقاف خلص ⇒ الإيقاف الجاي يبدي من الصفر
                _ACCX["dirty"] = True
            continue
        if not isinstance(rec, dict) or abs(float(rec.get("lim") or 0) - lim) > lim * 1e-9:
            rec = {"lim": lim, "k": []}                # إيقاف جديد (أو الحد تغيّر)
            ent[side] = rec
            _ACCX["dirty"] = True
        have = {f"{float((v or {}).get('target_price') or 0):.10g}" for v in (st.get(ak) or {}).values()}
        seen = [x for x in (rec.get("k") or []) if x in have]   # درجة طلعت من المخزن ⇒ تنتسى
        if len(seen) != len(rec.get("k") or []):
            rec["k"] = seen
            _ACCX["dirty"] = True
        if cp <= 0:
            continue
        lv = _accx_levels(b, st, side, cp)
        new = {f"{p:.10g}" for p, _ in lv} - set(seen)
        if not new:
            continue
        try:
            m = _accx_msg(b, side, lv, len(new), lim, cp)   # الرسالة أول — لو فشلت، الدرجات ما تنعلّم «مبلّغة»
        except Exception:
            continue
        rec["k"] = seen + sorted(new)
        _ACCX["dirty"] = True
        out.append(m)
    if not ent:
        S.pop(key, None)
    return out


