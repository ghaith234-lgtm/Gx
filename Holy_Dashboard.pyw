                    fresh = False                                         # نوبة جديدة ⇒ تنبيه حتى بعد التشغيل مباشرة (القديمة تبقى صامتة)
                V_ = b.get("real_v") or BOT_REAL_V.get(b.get("lv")) or {}
                own = (b.get("own_v") or {}).get(b.get("lv"))
