@keyframes bmPulse{0%,100%{opacity:1}50%{opacity:.22}}
@keyframes bmLeg{0%,100%{stroke-dashoffset:0}50%{stroke-dashoffset:.35}}
html.busy .brand .bmark .br,.ldr .bmark .br{stroke-dasharray:.42 .58;animation:bmFlow .85s linear infinite}
html.busy .brand .bmark .b1,.ldr .bmark .b1{animation:bmPulse .85s ease-in-out infinite}
html.busy .brand .bmark .b2,.ldr .bmark .b2{animation:bmPulse .85s ease-in-out .42s infinite}
html.busy .brand .bmark .l1,.ldr .bmark .l1,html.busy .brand .bmark .l2,.ldr .bmark .l2{stroke-dasharray:1;animation:bmLeg 1.7s ease-in-out infinite}
html.busy .brand .bmark .l2,.ldr .bmark .l2{animation-delay:.85s}
.ldr{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:9px;padding:6px 0;color:var(--mut)}
.ldr .bmark{width:40px;height:40px;stroke-width:6}
.ldr>span:empty{display:none}
html.lite .ldr .bmark *,html.lite.busy .brand .bmark *{animation-duration:1.6s!important}
@media (prefers-reduced-motion:reduce){html.busy .brand .bmark *,.ldr .bmark *{animation:none!important}}
@media (max-width:760px){
  .brand .hwd{display:none}
  .hrow>.hword{display:flex;grid-column:1/-1;grid-row:2;justify-content:center;margin:-2px 0 2px;line-height:0}
  .hrow>.hword .bword{height:15px;stroke-width:8.4}
  #top .hrow>.stats{grid-row:3}
  .bmark{width:25px;height:25px}}

@keyframes pp{0%,100%{transform:scale(1);opacity:1}50%{transform:scale(.7);opacity:.6}}
.totals{display:flex;align-items:center;gap:14px;margin-inline-start:auto}
.tot{display:flex;align-items:baseline;gap:7px}
.tot .lbl{font-size:11.5px;color:var(--mut)}
.tot b{font-size:21px;font-weight:600;background:linear-gradient(92deg,var(--cyan),var(--vio));-webkit-background-clip:text;background-clip:text;color:transparent}
.tot .cur{font-size:12px;color:var(--mut)}
.sep{width:1px;height:26px;background:var(--line)}
#spark{opacity:.32}
nav.actions{display:flex;gap:8px;flex-wrap:wrap}
button{font-family:inherit;color:var(--tx);cursor:pointer;border:1px solid var(--line);background:var(--glass);
  border-radius:12px;padding:8px 13px;font-size:13px;
  transition:transform .16s var(--pop),box-shadow .2s,border-color .2s,background .2s,opacity .2s}
button:hover{transform:translateY(-1.5px);border-color:var(--line2);box-shadow:0 6px 20px rgb(var(--cyan-rgb)/.10)}
button:active{transform:scale(.94)}
button.primary{background:linear-gradient(94deg,rgb(var(--vio2-rgb)/.85),rgb(var(--cyan2-rgb)/.85));border-color:transparent;font-weight:600;
  box-shadow:0 4px 22px rgb(var(--vio2-rgb)/.35)}
button.danger{border-color:rgb(var(--red-rgb)/.4);color:var(--red-soft)}
button.danger:hover{box-shadow:0 6px 18px rgb(var(--red-rgb)/.18)}
button.on{border-color:var(--amber);color:var(--amber);box-shadow:inset 0 0 0 1px rgb(var(--amber-rgb)/.35),0 0 14px rgb(var(--amber-rgb)/.22)}
button:disabled{opacity:.45;pointer-events:none}

/* ═══ شبكة البطاقات ═══ */
.toolbar{position:relative;z-index:2;display:flex;align-items:center;gap:14px;flex-wrap:wrap;
  max-width:1640px;margin:0 auto;padding:14px 22px 0}
.srch{position:relative;flex:1;min-width:220px;max-width:420px}
.srch input{width:100%;background:var(--glass);border:1px solid var(--line);border-radius:13px;color:var(--tx);
  padding:11px 40px 11px 42px;font-size:14px;font-family:inherit;transition:border-color .2s,box-shadow .2s}
.srch input:focus{border-color:var(--cyan);box-shadow:0 0 0 3px rgb(var(--cyan-rgb)/.13);outline:none}
.srch .si{position:absolute;inset-inline-start:14px;top:50%;transform:translateY(-50%);font-size:15px;opacity:.7;pointer-events:none}
.srch .sx{position:absolute;inset-inline-end:13px;top:50%;transform:translateY(-50%);cursor:pointer;color:var(--mut);font-size:13px}
.srch .sx:hover{color:var(--red)}
.sortbox{display:flex;align-items:center;gap:8px}
.sortbox .sl{font-size:12.5px;color:var(--mut)}
.sortbox select{background:var(--glass);border:1px solid var(--line);border-radius:11px;color:var(--tx);
  padding:9px 12px;font-size:13px;font-family:inherit;cursor:pointer;}
.sortbox select:focus{border-color:var(--cyan);outline:none}
.sortbox select option{background:var(--bg1)}
.sdir{padding:9px 13px;font-size:14px;font-weight:700;min-width:40px}
.sdir.up{color:var(--cyan);border-color:var(--line2)}
.fcount{font-size:12px;color:var(--mut2);margin-inline-start:auto}
main{position:relative;z-index:1;display:grid;grid-template-columns:repeat(auto-fill,minmax(min(355px,100%),1fr));gap:18px;padding:22px;max-width:1640px;margin:0 auto}
.empty{position:relative;z-index:1;text-align:center;color:var(--mut);padding:90px 20px;font-size:16px}

/* ═══ البطاقة (طراز performance-benchmark-card) ═══ */
.card{position:relative;background:var(--glass);border:1px solid var(--line);border-radius:20px;padding:18px 18px 14px;
  box-shadow:inset 0 1px 0 rgb(var(--ov-rgb)/.05),0 12px 34px rgb(var(--sh-rgb)/.35);
  transition:transform .28s var(--ease),box-shadow .28s,border-color .28s;overflow:hidden}
.card::before{content:'';position:absolute;inset:0;border-radius:20px;pointer-events:none;
  background:radial-gradient(420px 140px at 80% -8%,rgb(var(--vio-rgb)/.13),transparent 70%)}
.card:hover{transform:translateY(-4px);border-color:rgb(var(--vio-rgb)/.34);box-shadow:0 18px 44px rgb(var(--vio2-rgb)/.22)}
.card.dead{filter:none}                              /* 🃏 v3.26.8: الموقوف يبين من شارته «متوقف» (بلا تعتيم ثقيل — نفس شكل الباقي) */
body.boot .card{animation:rise .6s var(--ease) both;animation-delay:calc(var(--i,0)*70ms)}
@keyframes rise{from{opacity:0;transform:translateY(16px) scale(.985)}to{opacity:1;transform:none}}
.chead{display:flex;align-items:center;gap:9px;margin-bottom:12px}
.sym{font-weight:700;font-size:15.5px;display:flex;align-items:center;gap:7px}
.chip{font-size:10px;padding:2px 8px;border-radius:99px;border:1px solid var(--line);color:var(--mut)}
.chip.demo{color:var(--cyan);border-color:var(--line2)}
.chip.acc{color:var(--amber);border-color:rgb(var(--amber-rgb)/.4);background:rgb(var(--amber-rgb)/.07);box-shadow:0 0 10px rgb(var(--amber-rgb)/.15)}
@keyframes apulse{0%,100%{box-shadow:0 0 0 0 rgb(var(--amber2-rgb)/.55)}50%{box-shadow:0 0 0 7px rgb(var(--amber2-rgb)/0)}}
.hbadge{margin-inline-start:6px;font-size:13px;line-height:1}
.hbadge.bad{filter:drop-shadow(0 0 4px rgb(var(--red2-rgb)/.9))}
.hbadge.warn{filter:drop-shadow(0 0 4px rgb(var(--amber2-rgb)/.8))}
.pill{margin-inline-start:auto;font-size:11px;padding:3px 10px;border-radius:99px;display:flex;align-items:center;gap:6px;border:1px solid var(--line)}
.pill::before{content:'';width:7px;height:7px;border-radius:50%}
.pill.ok{color:var(--green-soft);border-color:rgb(var(--green-rgb)/.35)}
.pill.ok::before{background:var(--green);box-shadow:0 0 9px var(--green);animation:pp 1.8s infinite}
.pill.off{color:var(--red-soft);border-color:rgb(var(--red-rgb)/.35)}
.pill.off::before{background:var(--red)}
.cmain{display:flex;align-items:flex-end;justify-content:space-between;gap:14px;margin-bottom:14px}
.big{font-size:31px;font-weight:600;line-height:1.05;background:linear-gradient(92deg,var(--big-a),var(--cyan) 80%);-webkit-background-clip:text;background-clip:text;color:transparent}
.big .u{font-size:14px;color:var(--mut);-webkit-text-fill-color:var(--mut)}
.pricebox{display:flex;align-items:center;gap:8px;margin-top:9px}
.plabel{font-size:11px;color:var(--mut)}
.bigprice{font-size:23px;font-weight:700;transition:color .4s ease;color:var(--cyan);-webkit-text-fill-color:initial}
.bigprice.up{color:var(--green)}
.bigprice.dn{color:var(--red)}
.ptrend{font-size:15px;transition:opacity .3s;opacity:.9}
.ptrend.up{color:var(--green)}.ptrend.dn{color:var(--red)}
@keyframes priceFlash{0%{transform:scale(1)}40%{transform:scale(1.13)}100%{transform:scale(1)}}
/* ═══ كرت DCA المميّز (ثيم عنبري) ═══ */
.card.dca{border-color:rgb(var(--amber-rgb)/.28);background:linear-gradient(180deg,rgb(var(--amber-rgb)/.05),rgb(var(--surf-rgb)/.5))}
.card.dca:hover{border-color:rgb(var(--amber-rgb)/.5)}
.card.rec{border-color:rgb(var(--cyan-rgb)/.28);background:linear-gradient(180deg,rgb(var(--cyan-rgb)/.05),rgb(var(--surf-rgb)/.5))}
.card.rec:hover{border-color:rgb(var(--cyan-rgb)/.5)}
.dcatag.rectag{background:rgb(var(--cyan-rgb)/.14);color:var(--cyan);border-color:rgb(var(--cyan-rgb)/.35)}
.rcmode{flex-basis:100%;font-size:10.5px;color:var(--mut);line-height:1.6}
/* 💹 v3.34.0: كرت مسار القيمة */
.card.va .vatag{background:linear-gradient(94deg,rgb(var(--cyan-rgb)/.18),rgb(var(--vio-rgb)/.18))}
.card.va .vahint{margin:6px 0 2px;padding:6px 9px;border-radius:9px;font-size:12px;line-height:1.7;background:rgb(var(--cyan-rgb)/.07);color:var(--mut)}
.card.va .vahint.buy{background:rgb(var(--green-rgb)/.10);color:var(--green)}
.card.va .vahint.sell{background:rgb(var(--amber-rgb)/.12);color:var(--amber)}
.card.va .vahint.floor{background:rgb(var(--vio-rgb)/.10)}
.card.va .vahint small{color:var(--mut2);font-size:10.5px}
.card.va .vachart{margin:6px 0 2px}
.vach{width:100%;height:74px;display:block}
.vach polyline{fill:none;stroke-width:1.6;vector-effect:non-scaling-stroke}
.vach polyline.t{stroke:var(--cyan);stroke-dasharray:4 3}
.vach polyline.v{stroke:var(--amber)}
.vach circle.b{fill:var(--green)}.vach circle.s{fill:var(--red)}
.vach line{stroke-width:1.2;vector-effect:non-scaling-stroke;opacity:.7}.vach line.b{stroke:var(--green)}.vach line.s{stroke:var(--red)}
.valeg{display:flex;flex-wrap:wrap;gap:4px 10px;font-size:10px;color:var(--mut2);margin-top:2px}
.valeg .t{color:var(--cyan)}.valeg .v{color:var(--amber)}.valeg .b{color:var(--green)}.valeg .s{color:var(--red)}
.vach0{font-size:11px;color:var(--mut2);text-align:center;padding:10px 0}
.vamodehelp{font-size:12px;line-height:1.9;color:var(--mut);background:rgb(var(--cyan-rgb)/.06);border-radius:10px;padding:8px 10px;margin:0 0 10px}
.vamodehelp small{color:var(--mut2);font-size:11px;display:block;margin-top:2px}
/* 📋 v3.35.0: جدول مسار القيمة (قبل التشغيل وحيّاً) */
.vaplan{font-size:12px}
.vaplsum{display:flex;flex-direction:column;gap:4px;line-height:1.8;background:rgb(var(--cyan-rgb)/.06);border-radius:10px;padding:8px 10px;margin:0 0 8px}
.vapltit{font-size:12px;font-weight:700;color:var(--cyan);margin:10px 0 4px}
.vaplwrap{overflow-x:auto;max-height:46vh;overflow-y:auto;border-radius:8px}
.vapltbl{font-size:11px;min-width:100%}
.vapltbl td,.vapltbl th{white-space:nowrap;padding:4px 6px}
.vapltbl tr.buy td{background:rgb(var(--green-rgb)/.06)}
.vapltbl tr.sell td{background:rgb(var(--amber-rgb)/.08)}
.vapltbl tr.cap td{background:rgb(var(--red-rgb)/.10);font-weight:700}
.vapltbl tr.floor td{background:rgb(var(--vio-rgb)/.07);color:var(--mut)}
.vapltbl tr.rebuy td{background:rgb(var(--green-rgb)/.11)}
.vapltbl tr.guard td{background:rgb(var(--cyan-rgb)/.06);color:var(--mut)}
.card.va .vahint.guard{background:rgb(var(--cyan-rgb)/.10);color:var(--cyan)}
.vaplnote{font-size:10.5px;color:var(--mut2);line-height:1.8;margin:8px 0 0}
.vapltbl tr.pk{cursor:pointer}
.vapltbl tr.pk:hover td,.vapltbl tr.pk:focus-visible td{background:rgb(var(--cyan-rgb)/.12)}
.vapltbl tr.sel td{background:rgb(var(--cyan-rgb)/.22)!important;font-weight:700}
.vapltbl tr.sel td:first-child{box-shadow:inset -3px 0 0 var(--cyan)}
.vaplhint{font-size:11px;color:var(--mut2);margin:0 0 4px}
.vaplat{background:rgb(var(--amber-rgb)/.07)}
.vaplback{font-size:11px;padding:3px 8px;margin-inline-start:6px;border-radius:8px;vertical-align:middle}
.vapltbl small{color:var(--mut2);font-size:10px}
.vadel{display:flex;flex-direction:column;gap:6px;line-height:1.8;font-size:13px;background:rgb(var(--cyan-rgb)/.06);border-radius:10px;padding:10px 12px}
.vadel small{color:var(--mut2);font-size:11px}
.vadelnote{font-size:12px;color:var(--amber);margin:8px 0 0}
.vadelbtns{display:flex;flex-direction:column;gap:8px;margin-top:12px}
.vadelbtns button{text-align:center;padding:10px 12px;line-height:1.5}
.vadelbtns button small{display:block;font-size:11px;opacity:.85;margin-top:2px}

.card.va .vatag.hgtag{background:linear-gradient(94deg,rgb(var(--vio-rgb)/.22),rgb(var(--cyan-rgb)/.22));color:var(--tx)}
.card.va .vahg{margin:6px 0 2px;padding:7px 9px;border-radius:9px;font-size:12px;line-height:1.7;background:rgb(var(--vio-rgb)/.08);border:1px solid rgb(var(--vio-rgb)/.18)}
.card.va .vahg .hgt{font-weight:700;color:var(--vio);margin-bottom:2px}
.card.va .vahg .hgri{float:inline-end;margin:0 0 4px 6px;cursor:pointer;font-size:11px}.card.va .vahg .hgri small{color:var(--mut2);font-size:10px}
.card.va .vahg .hgr{display:flex;flex-wrap:wrap;gap:4px 8px;align-items:baseline}
.card.va .vahg .hgr span{color:var(--mut)}.card.va .vahg .hgr small{color:var(--mut2);font-size:10.5px}
.card.va .vahg .hgo{margin-top:3px;font-size:11px;line-height:1.9}
.card.va .vahg .hgch{display:inline-block;margin:0 3px 2px 0;padding:0 6px;border-radius:7px;font-size:11px}
.card.va .vahg .hgch.s{background:rgb(var(--red-rgb)/.10);color:var(--red)}.card.va .vahg .hgch.b{background:rgb(var(--green-rgb)/.10);color:var(--green)}
.card.va .vahint.grid{background:rgb(var(--vio-rgb)/.10);color:var(--vio)}
.vapltbl tr.grid td{background:rgb(var(--vio-rgb)/.05)}
/* 🧪 v3.36.0: الاختبار على مسار تجريبي */
.btov{position:fixed;inset:0;z-index:150;background:rgb(var(--scrim-rgb)/.78);backdrop-filter:blur(6px);display:flex;align-items:flex-start;justify-content:center;overflow-y:auto;padding:22px 12px}
body.btopen{overflow:hidden}
.btbox{position:relative;width:min(1180px,100%);background:var(--modal-bg);border:1px solid var(--line2);border-radius:22px;padding:22px 22px 18px;box-shadow:0 30px 90px rgb(var(--sh-rgb)/.55)}
.btx{position:absolute;top:12px;inset-inline-end:12px;width:34px;height:34px;padding:0;border-radius:50%;font-size:15px}
