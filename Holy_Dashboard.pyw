  const d=b.dca||{},base=d.base_coin||'';
  const active=(d.active_sells||[]).slice().sort((x,y)=>y.price-x.price);
  const pend=(d.pending||[]).slice().sort((x,y)=>y.price-x.price);
  let h='';
  if(active.length){h+=`<div class="ladsec" style="color:var(--green)">🟢 على المنصة (محمية عند انقطاع الكهرباء)</div>`;
    active.forEach(o=>{h+=`<div class="ladrow"><span class="num">${f4(o.price)}</span><span class="ladq">${o.qty} ${base}</span><span class="ladtag on">أمان ${o.n}</span></div>`})}
  if(pend.length){h+=d.trail_on?`<div class="ladsec" style="color:var(--green);margin-top:10px">🛡️ بالذاكرة — الدرع يتتبّعها (ارتداد ${d.trail_pct||0.3}%)</div>`:`<div class="ladsec" style="color:var(--amber);margin-top:10px">📦 مخزون جاهز بالحاسوب (يُفتح تلقائياً)</div>`;
    pend.forEach(o=>{h+=`<div class="ladrow"><span class="num">${f4(o.price)}</span><span class="ladq">${o.qty} ${base}</span><span class="ladtag pend">أمان ${o.n}</span></div>`})}
  if(!h)h='<p style="color:var(--mut);font-size:12px;padding:8px">لا أوامر بعد — يبدأ السلم عند التشغيل</p>';
  box.innerHTML=`<div class="ladhdr">🪜 السلم · متوسط ${d.avg_price?f4(d.avg_price):'—'} · هدف ${d.target_price?f4(d.target_price):'—'}</div>${h}`;
  box.style.display='';
}
function updDcaCard(el,b){
  const R=el._r,d=b.dca||{};el._alive=b.alive;
  const cp=(window.JPX&&JPX[b.symbol])||b.cp;
  const prevCp=el._lastcp;
  if(prevCp!=null&&cp!==prevCp&&R.cp){R.cp.classList.remove('up','dn');R.cp.classList.add(cp>prevCp?'up':'dn')}
  el._lastcp=cp;
  // الحبّة (تشغيل/إيقاف)
  R.pill.textContent=b.alive?'● نشط':'○ متوقف';R.pill.className='pill '+(b.alive?'on':'off');
  if(R.hb){const H=b.health||{},A=b.audit||{};
    let s='',c='',t='';
    if(H.state==='bad'){s='🚨';c='bad';t=`${H.fails_1h} أمر مرفوض آخر ساعة`}
    else if(A.ok===false){s='⚠️';c='warn';t=A.msg||'خلل بالسلّم'}
    else if(H.state==='warn'){s='⚠️';c='warn';t=`${H.fails_1h} رفض آخر ساعة`}
    if(s){R.hb.style.display='';R.hb.textContent=s;R.hb.className='hbadge '+c;R.hb.title=t;
          R.hb.onclick=(ev)=>{ev.stopPropagation();showHealth(b)}}
    else R.hb.style.display='none';}
  R.avg.textContent=d.avg_price?f4(d.avg_price):'—';
  R.cp.textContent=cp?f4(cp):'—';
  const _unit=d.is_buy?'USDT':(d.base_coin||'');
  R.coin.textContent=(d.coin_profit!=null?(d.coin_profit>=0?'+':'')+d.coin_profit+' '+_unit:'—');
  // ⏱️ زمن التشغيل + معدلات الربح (يومي/شهري/سنوي)
  if(R.age){
