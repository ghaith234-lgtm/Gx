.navhint.l{left:0;background:linear-gradient(to right,rgb(var(--surf2-rgb)/.9),rgb(var(--surf2-rgb)/0))}
.navhint.r{right:0;background:linear-gradient(to left,rgb(var(--surf2-rgb)/.9),rgb(var(--surf2-rgb)/0))}
.navwrap.hint.ml .navhint.l,.navwrap.hint.mr .navhint.r{display:flex}
.navwrap.hint.show .navhint{opacity:.45}
.navwrap.hint.show .navhint.l{animation:navHL 1.7s ease-in-out .2s 3}
.navwrap.hint.show .navhint.r{animation:navHR 1.7s ease-in-out .2s 3}
@keyframes navHL{0%,100%{transform:translateY(-50%)}50%{transform:translate(-6px,-50%);opacity:.85}}
@keyframes navHR{0%,100%{transform:translateY(-50%)}50%{transform:translate(6px,-50%);opacity:.85}}
/* ✨ الشريط العلوي — 🔔 يمين · الهوية بالوسط · ▶️ ⏹️ يسار · بطاقات الأرباح سطر تحته */
.hrow{display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);align-items:center;column-gap:12px;row-gap:10px}
.hrow>.ops.opsb{grid-column:1;grid-row:1;justify-self:start;margin:0!important}
.hrow>.brand{grid-column:2;grid-row:1;justify-self:center}
.hrow>.ops:not(.opsb){grid-column:3;grid-row:1;justify-self:end;margin:0!important}
.hrow>.totals{grid-column:1/-1;grid-row:2;width:100%;justify-content:center;margin:0!important}
.hrow>.stats{grid-column:1/-1;grid-row:2;width:100%;margin:0}
/* 📊 v3.22.2: عشر خانات متساوية — خمسة اليوم فوق · خمسة الإجمالي تحت (الموبايل: كل خانة يمّ إجماليها) */
.stats{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:6px}
/* 📏 v3.22.4: الخانات أقصر (66 ⇐ 48 بكسل) حتى الكروت تبين بالحاسوب */
.st{position:relative;overflow:hidden;display:flex;flex-direction:column;justify-content:center;gap:2px;min-width:0;min-height:0;
  padding:5px 12px;border:1px solid var(--line);border-radius:11px;background:rgb(var(--ov-rgb)/.035)}
.st .sl{font-size:11px;line-height:1.25;color:var(--mut);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;position:relative;z-index:1}
.st .sv{display:flex;align-items:baseline;gap:5px;min-width:0;font-size:18px;line-height:1.15;font-weight:600;white-space:nowrap;overflow:hidden;position:relative;z-index:1}
.st .sv>span,.st .sv.rotv{background:linear-gradient(92deg,var(--cyan),var(--vio));-webkit-background-clip:text;background-clip:text;color:transparent;overflow:hidden;text-overflow:ellipsis}
.st .sv small{font-size:12px;color:var(--mut);font-weight:400}
.st .sv .cu{font-size:12px;color:var(--mut);font-weight:500;-webkit-text-fill-color:var(--mut)}
.st.click{cursor:pointer}.st.click:hover{border-color:var(--cyan)}
.st.rot .sv{transition:opacity .28s ease}.st.rot .sv.fade{opacity:0}
.st .spk{position:absolute;left:0;right:0;bottom:0;width:100%;height:22px;opacity:.32;pointer-events:none}
.st.pos .sv>span{background:linear-gradient(92deg,var(--green),var(--cyan));-webkit-background-clip:text;background-clip:text}
.pc-kpi.stats{grid-template-columns:repeat(5,minmax(0,1fr));margin:4px 0 14px}
@media (max-width:760px){
  /* 📱 v3.23.2: كلها تبين بلا سحب — عمودين · كل خانة يمّ إجماليها (اليوم ⇐ الكلي) · شريط بسطر واحد: الاسم المختصر ⇐ الرقم · بلا خط الحركة
     (نفس الترتيب بالشريط العلوي ولوحة التقارير — الحاسوب ما تغيّر) */
  .stats,.pc-kpi.stats{grid-template-columns:repeat(2,minmax(0,1fr));grid-auto-flow:row;gap:5px;overflow:visible}
  .stats>.st:nth-child(1){order:1}.stats>.st:nth-child(6){order:2}.stats>.st:nth-child(2){order:3}.stats>.st:nth-child(7){order:4}
  .stats>.st:nth-child(3){order:5}.stats>.st:nth-child(8){order:6}.stats>.st:nth-child(4){order:7}.stats>.st:nth-child(5){order:8}
  .stats>.st:nth-child(9){order:9}.stats>.st:nth-child(10){order:10}
  .st{flex-direction:row;align-items:center;justify-content:space-between;gap:6px;min-height:32px;padding:4px 9px;border-radius:9px}
  .st .sl{flex:1 1 auto;min-width:0;font-size:10.5px;line-height:1.2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .st .sl[data-s]{font-size:0}.st .sl[data-s]::before{content:attr(data-s);font-size:10.5px}
  .st .sv{flex:0 0 auto;max-width:72%;justify-content:flex-end;font-size:14.5px;gap:3px}   /* الرقم ما ينقص أبداً — الاسم هو اللي ينضغط */
  .st .sv small,.st .sv .cu{font-size:10.5px}
  .st .sv .cu+.cu{display:none}
  .st.rot .sv{font-size:12.5px}.st.rot .sv .cu{font-size:10px}         /* 🪙 كمية العملة طويلة (+0.0005 BTC) ⇒ خط أصغر حتى الاسم ما ينقص */
  .pc-kpi.stats{gap:4px}.pc-kpi.stats .st{padding:4px 7px;gap:4px}
  .st .spk{display:none}}
@media (max-width:380px){.st .sl[data-s]::before{font-size:10px}.st .sl[data-x]::before{content:attr(data-x)}.st .sv{font-size:13.5px}.st.rot .sv{font-size:12px}.pc-kpi.stats .st{padding:4px 6px}.pc-kpi.stats .st .sl[data-s]::before{font-size:9.5px}.pc-kpi.stats .st .sv{font-size:12.5px}.pc-kpi.stats .st.rot .sv{font-size:11.5px}}
@media (max-width:760px){.hrow{column-gap:8px}}
@media (max-width:380px){.hrow{column-gap:5px}.brand{gap:5px}}
@media (prefers-reduced-motion:reduce){.navhint{animation:none!important}}
html.lite .navhint{animation:none!important}
nav.actions button{padding:7px 12px;font-size:12.8px}
button.warn{border-color:rgb(var(--amber-rgb)/.55);color:var(--amber);box-shadow:0 0 12px rgb(var(--amber-rgb)/.18)}
/* ═══ 📈 شريط الأسعار ═══ */
.tape{overflow:hidden;white-space:nowrap;direction:ltr;border-bottom:1px solid var(--line);
  background:linear-gradient(90deg,rgb(var(--cyan-rgb)/.05),rgb(var(--vio-rgb)/.05));padding:5px 0}
.tapein{display:inline-block;will-change:transform}
@keyframes tapemove{from{transform:translateX(0)}to{transform:translateX(-50%)}}
.tape,.tapewrap{touch-action:pan-y;cursor:grab;user-select:none;-webkit-user-select:none}
.tape.drag,.tapewrap.drag{cursor:grabbing}
.tkp.flu{animation:tkflu .7s ease-out}
.tkp.fld{animation:tkfld .7s ease-out}
@keyframes tkflu{0%{color:var(--hi);text-shadow:0 0 9px var(--green)}}
@keyframes tkfld{0%{color:var(--hi);text-shadow:0 0 9px var(--red)}}
.tk{display:inline-flex;align-items:center;gap:6px;margin:0 15px;vertical-align:middle;font-size:12px}
.tki{width:17px;height:17px;border-radius:50%;background:var(--line2);object-fit:cover}
.tkl{display:none;width:17px;height:17px;border-radius:50%;background:var(--line2);color:var(--tx);
  font-size:8.5px;align-items:center;justify-content:center;font-weight:700}
.tk b{color:var(--tx)}
.tkp{color:var(--cyan);font-variant-numeric:tabular-nums}
.tkc{font-style:normal;font-size:11px}
.tkc.up{color:var(--green)}
.tkc.dn{color:var(--red)}
/* ═══ 📊 شريط المؤشرات ═══ */
.tape2{display:flex;align-items:center;gap:0;padding:3px 0;background:rgb(var(--ov-rgb)/.02)}
.tapewrap{flex:1;overflow:hidden;min-width:0}
.fng{flex:none;padding:2px 12px;border-inline-end:1px solid var(--line2);font-size:11.5px;white-space:nowrap}
.fng small{font-size:10.5px}
.fgw{display:inline-flex;align-items:center;gap:7px}.fgr{flex:none;margin:-3px 0}
.fga{transition:stroke-dashoffset 1.6s var(--ease),stroke .6s}.fgn{font:600 10.5px 'IBM Plex Mono',monospace}
.fgw.ext .fga{animation:fgp 2.4s ease-in-out infinite}@keyframes fgp{0%,100%{opacity:1}50%{opacity:.5}}
@media (prefers-reduced-motion:reduce){.fga{transition:none}.fgw.ext .fga{animation:none}}
.ik{display:inline-flex;align-items:center;gap:8px;margin:0 14px;vertical-align:middle;font-size:11.5px;
  padding-inline-end:14px;border-inline-end:1px solid var(--line)}
.ikb{color:var(--cyan);font-size:12px}
.ik .iv{color:var(--mut2);font-style:normal}
.ik .iv b{color:var(--tx)}
/* 🧾 نافذة سجل اليوم · 📈 إعدادات الشريط */
.dltabs{display:flex;gap:8px;margin:2px 0 4px}
.dltabs button{flex:1;padding:8px;border-radius:10px;font-size:12.5px}
.tkchips{display:flex;flex-wrap:wrap;gap:7px;margin-top:10px}
.tkchip{display:inline-flex;align-items:center;gap:5px;background:var(--bg1);border:1px solid var(--line2);
  border-radius:20px;padding:4px 9px;font-size:12px}
.tkchip small{color:var(--mut2);font-size:10px}
.tkchip button{padding:0 3px;font-size:11px;line-height:1;border:0;background:none;color:var(--red);cursor:pointer}
#totTrade:hover,#totToday:hover{border-color:var(--cyan)}
#mbar{display:none}
/* 🖥️ v3.22.4: الشريط العلوي يمشي ويّا الصفحة بالحاسوب هم (مثل الموبايل) — كان ثابت فوق (268 بكسل) ويغطّي راس الكروت ·
   أول ما يطلع من الشاشة ينزل شريط رفيع بالأرقام (يضغط ⇒ يرجع للأعلى) */
header{position:relative}
#mbar{position:fixed;top:0;left:0;right:0;z-index:60;align-items:center;justify-content:center;gap:16px;padding:7px 12px;
  background:rgb(var(--surf2-rgb)/.9);backdrop-filter:blur(16px);border-bottom:1px solid var(--line);font-size:12.5px;cursor:pointer}
body.pastTop #mbar{display:flex}
/* 🖥️ خمس بطاقات أرباح: بالشاشات الاعتيادية تنزل لسطرها وسط الشريط بدل ما تزحزح الهوية لسطر وحدها */
@media (min-width:761px) and (max-width:1680px){.hrow .totals{order:3;width:100%;justify-content:center;margin:0}.hrow .ops{margin-inline-start:auto}}
@media (max-width:760px){
  header{position:relative;padding:10px 12px;gap:8px}
  .brand{font-size:15px}
  .hrow{gap:8px}
  .hrow .totals{order:3;width:100%;display:grid;grid-template-columns:1fr 1fr;gap:6px;margin:0}
  .totals .sep{display:none!important}
  .tk{margin:0 11px;font-size:11.5px}
  .ik{margin:0 9px;padding-inline-end:9px;gap:6px;font-size:11px}
  .fng{padding:2px 8px}
  .tot{flex-wrap:wrap;column-gap:4px;row-gap:0;background:rgb(var(--ov-rgb)/.035);border:1px solid var(--line);border-radius:10px;padding:5px 9px;min-width:0}
  .tot .lbl{flex-basis:100%;font-size:10.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .tot b{font-size:17px}
  .ops{margin-inline-start:auto;gap:5px}
  .ops button{padding:6px 8px;font-size:13px}
  nav.actions{flex-wrap:nowrap;overflow-x:auto;scrollbar-width:none;-webkit-overflow-scrolling:touch;padding-bottom:2px}
  nav.actions::-webkit-scrollbar{display:none}
  nav.actions .grp{flex-wrap:nowrap}
  nav.actions button{white-space:nowrap;padding:7px 10px;font-size:12.3px}
  #mbar{position:fixed;top:0;left:0;right:0;z-index:60;align-items:center;justify-content:center;gap:14px;padding:7px 12px;
    background:rgb(var(--surf2-rgb)/.9);backdrop-filter:blur(16px);border-bottom:1px solid var(--line);font-size:12.5px;cursor:pointer}
  body.pastTop #mbar{display:flex}
  .big{white-space:nowrap}
}
