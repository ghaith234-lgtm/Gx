_JC = {}          # كاش قراءة JSON مفتاحه (المسار، وقت التعديل، الحجم)
_JC_LOCK = threading.Lock()

def load_json(p):
    """⚡ قراءة مُخزَّنة مؤقتاً: تُعاد من الذاكرة ما دام الملف لم يتغيّر (نفس mtime والحجم).
    آمنة تماماً — أي كتابة تغيّر mtime فتُبطل الكاش فوراً."""
    try:
        stt = os.stat(p)
        key = (p, stt.st_mtime_ns, stt.st_size)
    except Exception:
        return None
    with _JC_LOCK:
        hit = _JC.get(p)
        if hit is not None and hit[0] == key:
            txt = hit[1]
            try:
                return json.loads(txt)      # 🔑 كائن جديد كل مرة — لا يتلوّث الكاش بالتعديل
            except Exception:
                return None
    try:
        with open(p, "r", encoding="utf-8") as f:
            txt = f.read()
        data = json.loads(txt)
    except Exception:
        return None
    with _JC_LOCK:
        if len(_JC) > 400:
            _JC.clear()
        _JC[p] = (key, txt)                 # نخزّن النص لا الكائن
    return data

def _dir_sync(p):
    """🔌 v3.21.2: يثبّت الاستبدال (os.replace) بالقرص — بدونه يبقى بذاكرة النظام لثواني، وانقطاع كهرباء خلالها
    يرجّع الملف لنسخته القديمة (مثلاً بصمة شراء المُراكِم تضيع والأمر وصل المنصة ⇒ يشتري مرتين). ويندوز: يتجاوز بهدوء."""
    if os.name == "nt":
        return
    try:
        fd = os.open(os.path.dirname(os.path.abspath(p)) or ".", os.O_RDONLY)
        try:
            os.fsync(fd)
        finally:
            os.close(fd)
    except Exception:
        pass

def save_json_atomic(p, data):
    try:
        with _JC_LOCK:
            _JC.pop(p, None)
    except Exception:
        pass
    tmp = p + ".dash_tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)
        f.flush(); os.fsync(f.fileno())
    os.replace(tmp, p)
    _dir_sync(p)

def save_state_keys(p, upd, tries=20):
    """🔐 v3.21.10 (ب٢٨): اللوحة تكتب **حقول التحكم بس** على أحدث نسخة من ملف حالة البوت.
    تقرا الملف لحظة الكتابة، وقبل الاستبدال تتأكد إن المحرك ما كتب بنفس اللحظة (البصمة ما تغيّرت) — كتب ⇒ تعيد.
    (كانت تكتب الملف كله من نسخة قرتها قبل ⇒ صفقة سجّلها المحرك بنفس جزء الثانية ترجع للخلف بالملف لحد حفظته الجاية،
    وسجل ربح اليوم ممكن يحسب ربحها مرتين). True = انكتب · False = الملف ما موجود أو ما گدرنا.
    لو المحرك يكتب بلا توقف (كل المحاولات تصادفت) ⇒ محاولة أخيرة بأقصر نافذة: قراءة طازجة ⇒ استبدال فوراً ⇒ التثبيت بعده."""
    def _read():
        _s = os.stat(p)
        with open(p, "r", encoding="utf-8") as f:
            return (_s.st_mtime_ns, _s.st_size), json.load(f)
    def _done():
        _dir_sync(p)
        try:
            with _JC_LOCK:
                _JC.pop(p, None)
        except Exception:
            pass
        return True
    tmp = p + ".dash_tmp"
    for _try in range(tries):
        try:
            sig0, cur = _read()
        except FileNotFoundError:
            return False
        except Exception:
            time.sleep(0.05)
            continue
        if not isinstance(cur, dict):
            time.sleep(0.05)
            continue
        cur.update(upd)
        try:
            with open(tmp, "w", encoding="utf-8") as f:
                json.dump(cur, f, ensure_ascii=False, indent=2)
                f.flush(); os.fsync(f.fileno())
            _s1 = os.stat(p)
            if (_s1.st_mtime_ns, _s1.st_size) == sig0:
                os.replace(tmp, p)
                return _done()
        except Exception:
            pass
        try:
            os.remove(tmp)
        except Exception:
            pass
        time.sleep(0.01 + 0.002 * _try)
    try:                                                  # 🧾 الأخيرة: ولا ملي ثانية بين القراءة والاستبدال (fsync بعده)
        _, cur = _read()
        if not isinstance(cur, dict):
            return False
        cur.update(upd)
        _txt = json.dumps(cur, ensure_ascii=False, indent=2)
        with open(tmp, "w", encoding="utf-8") as f:
            f.write(_txt)
        os.replace(tmp, p)
        try:
            _fd = os.open(p, os.O_RDONLY)
            try:
                os.fsync(_fd)
            finally:
                os.close(_fd)
        except Exception:
            pass
        return _done()
    except Exception:
        return False

def read_retry(path, tries=5):
    for _ in range(tries):
        d = load_json(path)
        if isinstance(d, dict):
            return d
        time.sleep(0.12)
    return None

