        if u.path == "/api/ex_orders":                    # 📋 v3.36.10: الأوامر المنشورة على المنصة بالتفصيل (قراءة فقط)
            return self._json(_safe(ex_orders_view, default={"ok": False, "groups": []}))
        if u.path == "/api/ctrade":                       # 🪙 v3.30.0: ربح تداول العملات — اليوم والكلي لكل عملة ولكل بوت
            _t0 = datetime.now().strftime("%Y-%m-%d")
            return self._json({"ok": True, "today": _safe(coin_trade_period, _t0, _t0, True, default={}) or {},
                               "all": _safe(coin_trade_period, "0000-00-00", "9999-99-99", default={}) or {}})
        if u.path == "/api/profit":                       # 📊 ربح التداول يوم بيوم + حصة كل بوت
            try:
                pdays = int((q.get("days") or ["30"])[0])
            except Exception:
                pdays = 30
            _per = str((q.get("per") or [""])[0])
            _per = _per if _per in ("month", "prev", "yday", "pweek") else ""
            _end = None
            if _per == "month":                            # 📅 v3.36.10: هذا الشهر = من أول الشهر لليوم (بتاريخ اللوحة نفسها)
                pdays = datetime.now().day
            elif _per == "prev":                           # ⏮️ v3.36.12: الشهر السابق كاملاً (من 1 لآخر يوم بيه — ما يتغيّر)
                _end, pdays = _prev_month()
            elif _per == "yday":                           # 🖼️ v3.36.28: البارحة (يوم واحد)
                _end, pdays = datetime.now().date() - timedelta(days=1), 1
            elif _per == "pweek":                          # 🖼️ v3.36.28: الأسبوع السابق كاملاً (الاثنين ← الأحد)
                _end, pdays = _prev_week()
            _pv = _safe(profit_view, max(1, min(365, pdays)), True, None, _end, default={"ok": False, "days": [], "bots": [], "tot": {}})
            if isinstance(_pv, dict):
                _n = _end or datetime.now().date()
                _pv.update(per=_per or "days", dim=_cal.monthrange(_n.year, _n.month)[1], mon=_n.month, mday=_n.day, year=_n.year)
            return self._json(_pv)
        if u.path == "/api/report.html":                  # 🖨️ التقرير المصوّر — ملف واحد جاهز للطباعة
            try:
                pdays = int((q.get("days") or ["30"])[0])
            except Exception:
                pdays = 30
            _rend = None
            if str((q.get("per") or [""])[0]) == "month":   # 📅 v3.36.10: نفس فترة لوحة التقارير
                pdays = datetime.now().day
            elif str((q.get("per") or [""])[0]) == "prev":  # ⏮️ v3.36.12: الشهر السابق كاملاً
                _rend, pdays = _prev_month()
            try:
                txt = report_html(max(1, min(365, pdays)), _rend)
            except Exception as ex:
                txt = f"<!doctype html><meta charset=utf-8><p>تعذّر توليد التقرير: {type(ex).__name__}</p>"
            body = txt.encode("utf-8")
            fn = "holy_report_" + datetime.now().strftime("%Y%m%d_%H%M") + ".html"
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Disposition", f'attachment; filename="{fn}"')
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            try: self.wfile.write(body)
            except Exception: pass
            return
        if u.path == "/api/report":
            kind = q.get("kind", ["daily"])[0]
            if q.get("src", ["main"])[0] == "ri":
                txt = _safe(reinvest_report, kind, default=None)
                return self._json({"ok": True, "src": "ri",
                                   "text": txt or "💠 لا توجد لقطات مسجّلة بعد.\n\n"
                                   "يأخذ المسجّل لقطة كل ~5 دقائق، ويحتاج **يومين على الأقل** "
                                   "ليتوفر لديه فرق يحسبه.\n"
                                   "وإذا كانت إعادة الاستثمار متوقفة في كل البوتات فلن يظهر شيء."})
            return self._json({"ok": True, "text": build_report(kind)})
        self._json({"ok": False, "msg": "?"}, 404)

    def do_POST(self):
        _OV_CACHE["t"] = 0.0                                # أي فعل ⇒ الملخص الجاي جديد (ولا رقم قديم بعد الضغط)
        _p = urlparse(self.path).path
        if _p in ("/api/login", "/api/logout"):
            try:
                n = int(self.headers.get("Content-Length") or 0)
                d = json.loads(self.rfile.read(n).decode("utf-8") or "{}") if n else {}
            except Exception:
                d = {}
            if _p == "/api/logout":
                _SESSIONS.pop(self._cookie_token(), None)
                return self._json({"ok": True, "msg": "🔒 تم الخروج"})
            ip = self._client_ip()
            _LOGIN_TRY.setdefault(ip, [])
            _LOGIN_TRY[ip] = [t for t in _LOGIN_TRY[ip] if time.time() - t < 300]
            if len(_LOGIN_TRY[ip]) >= 8:
                return self._json({"ok": False, "msg": "🚫 محاولات كثيرة — انتظر 5 دقائق"}, 429)
            if not auth_enabled():
                return self._json({"ok": True, "msg": "لا كلمة مرور مضبوطة"})
            if _pw_verify(str(d.get("pw") or ""), auth_cfg()["hash"]):
                tok = _new_session(ip)
                _LOGIN_TRY[ip] = []
                body = json.dumps({"ok": True}).encode("utf-8")
                self.send_response(200)
                self.send_header("Content-Type", "application/json; charset=utf-8")
                self.send_header("Set-Cookie", f"holy_tok={tok}; Path=/; HttpOnly; SameSite=Strict; Max-Age={max(1, auth_cfg()['mins'])*60}")
                self.send_header("Content-Length", str(len(body)))
                self.end_headers()
                try: self.wfile.write(body)
                except Exception: pass
                return
            _LOGIN_TRY[ip].append(time.time())
            return self._json({"ok": False, "msg": "كلمة المرور غير صحيحة"}, 401)
        if _p == "/api/app/bio_unlock":            # 🔐 v3.27.0: التطبيق بعد البصمة يطلب جلسة — بمفتاح الجهاز + مفتاح البصمة (بدل كلمة السر)
            ip = self._client_ip()
            tr = _BIO_TRY.setdefault(ip, [])
            tr[:] = [t for t in tr if time.time() - t < 600]
            if len(tr) >= 6:
                return self._json({"ok": False, "msg": "🚫 محاولات كثيرة — انتظر 10 دقائق أو اكتب كلمة السر"}, 429)
            dev = app_bio_check(self.headers.get("X-Holy-Device", ""), self.headers.get("X-Holy-Bio", ""))
            if dev is None:
                tr.append(time.time())
                journal("user", "🔐 رُفض فتح اللوحة بالبصمة — مفتاح خاطئ أو الجهاز غير مربوط (كلمة السر تبقى تعمل)", "warn")
                return self._json({"ok": False, "msg": "البصمة لا تفتح اللوحة على هذا الجهاز — اكتب كلمة السر"}, 401)
            if not auth_enabled():
                return self._json({"ok": True, "tok": "", "mins": 0})
            tok, mins = _new_session(ip), max(1, auth_cfg()["mins"])
            body = json.dumps({"ok": True, "tok": tok, "mins": mins}).encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "application/json; charset=utf-8")
            self.send_header("Cache-Control", "no-store")
            self.send_header("Set-Cookie", f"holy_tok={tok}; Path=/; HttpOnly; SameSite=Strict; Max-Age={mins * 60}")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            try: self.wfile.write(body)
            except Exception: pass
            return
        if not self._authed():
            return self._json({"ok": False, "auth": False, "msg": "🔒 الجلسة منتهية — أعد الدخول"}, 401)
        return self._do_POST_inner()

    def _do_POST_inner(self):
        if not self._check_pin():
            return self._json({"ok": False, "msg": "PIN خاطئ"}, 401)
        try:
            n = int(self.headers.get("Content-Length", 0))
            data = json.loads(self.rfile.read(n) or b"{}")
        except Exception:
            return self._json({"ok": False, "msg": "طلب غير صالح"}, 400)
        path = urlparse(self.path).path
        if path == "/api/fonts":                          # 🔤 v3.36.40: ما ينكتب بالسجلات (الملف ميغابايتات نص)
            a = str(data.get("act") or "")
            try:
                return self._json(user_font_add(data.get("name"), data.get("b64")) if a == "add" else user_font_del(data.get("k")) if a == "del"
                                  else {"ok": False, "msg": "طلب غير صالح"})
            except Exception as ex:
                return self._json({"ok": False, "msg": f"تعذّر: {type(ex).__name__}"})
        if not ("preview" in path or str(data.get("act") or "") == "preview" or path in ("/api/journal", "/api/card_tg")):
            self._jpost = (path, data)                     # 📜 v3.22.6: كل أمر منك ينكتب بالسجلات ويّا نتيجته (بلا أسرار)
        if path == "/api/control":
            act = data.get("action", "")
            if act == "tg_test":
                ok = tg_send("🧪 *اختبار* — إذا وصلتك هذه الرسالة فإشعارات Holy Dashboard تعمل بنجاح! 🎉", force=True)
                return self._json({"ok": ok, "msg": ("✅ أُرسلت! راجع تيليغرام" if ok else TG_DIAG["last"])})
            if act == "diag":
                lines = []
                try:
                    H = health_scan()
                    lines.append("🩺 الفحص الشامل")
                    for t, ic in (("crit", "🔴"), ("warn", "🟡"), ("info", "✅")):
                        for x in H.get(t) or []:
                            lines.append(f"{ic} {x}")
                    lines.append("")
                except Exception as _e:
                    lines.append(f"⚠️ تعذّر الفحص الشامل: {type(_e).__name__}")
                lines.append(f"🐍 بايثون المستخدم للبوتات:\n{PYTHON_EXE}")
                lines.append(f"مرشحون: {', '.join(PY_CANDS) or '—'}")
                try:
                    r = subprocess.run([PYTHON_EXE, "-c", "import okx,websocket;print('OK')"],
                                       capture_output=True, text=True, timeout=10,
                                       creationflags=(0x08000000 if os.name == "nt" else 0))
                    lines.append("📦 المكتبات (okx + websocket): " + ("✅ موجودة" if "OK" in r.stdout else ("❌\n" + (r.stderr or "")[:300])))
                except Exception as ex:
                    lines.append(f"📦 فحص المكتبات فشل: {ex}")
                _c = dash_cfg()
                _tok = (_c.get("tg_token") or "").strip()
                _chat = (_c.get("tg_chat_id") or "").strip()
                lines.append(f"📨 تيليغرام: توكن {'✅ محفوظ' if _tok else '❌ فارغ'} · Chat ID {'✅ محفوظ' if _chat else '❌ فارغ'} · مكتوم: {'نعم 🔕' if TG_MUTED['v'] else 'لا'}\nآخر حالة إرسال: {TG_DIAG['last']}")
                bots = bot_dirs()
                if bots:
                    for b in list(bots.values())[:6]:
                        _, _, lp = paths_of(b)
                        tail = ""
                        try:
                            with open(lp, "r", encoding="utf-8", errors="ignore") as f:
                                tail = "".join(f.readlines()[-12:]).strip()
                        except Exception:
                            tail = "(لا سجل بعد)"
                        lines.append(f"━━━ 📜 {b['symbol']} ━━━\n{tail or '(فارغ)'}")
                return self._json({"ok": True, "msg": "\n\n".join(lines)})
            if act == "refresh_bal":
                balances_once()
                e = " · ".join(list(BAL_ERR.values())[:2])
                return self._json({"ok": not e, "msg": ("🔄 تحدثت الأرصدة من OKX" if not e else "⚠️ " + e)})
            if act == "start_all":
                n = start_all_bots(user=True)
                return self._json({"ok": True, "msg": f"▶️ شغّلت {n} بوت — وكلهن صارن تحت جناح الحارس"})
            if act == "upgrade_engines":
                return self._json(upgrade_engines())
            if act == "shutdown_beacon":
                # يُستدعى من المتصفح عند إغلاق التبويب (sendBeacon) — يوقف كل البوتات
                stop_all_bots("أُغلق التبويب")
                kill_all_bot_procs()
                threading.Timer(0.5, lambda: os._exit(0)).start()
                return self._json({"ok": True, "msg": "🛑 توقف الكل"})
            if act == "die":
                stop_all_bots("أمر إيقاف خارجي")
                kill_all_bot_procs()
                threading.Timer(0.5, lambda: os._exit(0)).start()
                return self._json({"ok": True, "msg": "🛑 توقف الكل والمحرك يُطفأ…"})
            if act == "mute":
                TG_MUTED["v"] = not TG_MUTED["v"]
                return self._json({"ok": True, "msg": "🔕 التنبيهات مكتومة" if TG_MUTED["v"] else "🔔 التنبيهات مفعّلة"})
            if act == "libs":
                _op = str(data.get("value") or "status")
                if _op == "status":
                    return self._json({"ok": True, "rows": _safe(libs_status, default=[])})
                _ok, _log = libs_action(_op)
                log_event(f"🧰 [المكتبات] {_op} — {'نجح' if _ok else 'فشل'}")
                return self._json({"ok": _ok, "log": _log,
                                   "rows": _safe(libs_status, default=[])})
            if act == "watchdog":
                WATCHDOG["on"] = not WATCHDOG["on"]
                return self._json({"ok": True, "msg": "🤖 الحارس يعمل" if WATCHDOG["on"] else "🤖 الحارس متوقف"})
            if act == "boot":
                return self._json(boot_toggle())
            if act == "shutdown_all":
                return self._json(shutdown_all(noexit=(data.get("value") == "noexit")))
            if act == "reset_ledger":
                return self._json(books_fresh_start())    # 📒 v3.22.6: نفس «بداية جديدة» الآمنة (كانت تمسح السجل وتكتب صفر بملفات البوتات الشغّالة)
            if act == "send_report":
                kind = data.get("value") or "daily"
                _ok = _tg_report(build_report(kind))      # 💠 إعادة الاستثمار صارت داخل التقرير نفسه
                return self._json({"ok": bool(_ok),
                                   "msg": "📨 أُرسل التقرير إلى تيليغرام" if _ok
                                          else "⚠️ لم يُرسَل — " + str(TG_DIAG.get("last") or "")})
            if act == "guard_ack":
                v = data.get("value") or {}
                _by = "👤 اللوحة (" + str((self.client_address or ["?"])[0]) + ")"
                return self._json(guard_ack(v.get("key") or v.get("sym") or "", v.get("mode") or "accept",
                                            note=v.get("note") or "", by=_by))
            if act == "guard_scan":
                # 🔎 رد صادق: كم محفظة انفحصت فعلاً — ولا «مطابق» لو ما وصلنا للمنصة
                r = _safe(guard_scan, True, default=None) or {"ok": False, "msg": "⚠️ تعذّر الفحص (خطأ داخلي)"}
                return self._json({"ok": bool(r.get("ok")), "msg": r.get("msg") or "",
                                   "wallets": r.get("wallets"), "fail": r.get("fail"),
                                   "busy": r.get("busy"), "alerts": r.get("alerts") or []})
            if act == "ri_repair":
                _nm = str(data.get("value") or "")
                _b = next((x for x in bot_dirs().values() if os.path.basename(str(x["dir"]).rstrip("/\\")) == _nm), None)
                if not _b:
                    return self._json({"ok": False, "msg": "البوت غير موجود"})
                if _safe(_file_fp, os.path.join(_b["dir"], "reinvest.py"), default="") != REINV_VERSION:
                    return self._json({"ok": False, "msg": "⚠️ أعد تشغيل البوت أولاً (⏹ ثم ▶️) ليأخذ reinvest.py الجديد — القديم لا يعرف التصحيح"})
                _o = _ri_orphans(_b)
                if not _o:
                    return self._json({"ok": True, "msg": "لا يوجد نمو يتيم — كل شيء بحجمه الأساسي"})
                save_json_atomic(os.path.join(_b["dir"], "reinvest_repair.json"),
                                 {"id": f"rep-{int(time.time())}", "orders": [{k: x[k] for k in ("dn", "oid", "qty", "base")} for x in _o]})
                log_event(f"🧹 [تصحيح النمو اليتيم] {_nm}: {len(_o)} أمر · {sum(x['usd'] for x in _o):.4f}$ — بموافقة المالك")
                return self._json({"ok": True, "msg": f"🧹 أُرسل التصحيح ({len(_o)} أمر) — البوت ينفّذه خلال ثوانٍ"})
            if act == "ticker_set":
                v = data.get("value") or {}
                _c = app_cfg()
                _c["ticker_on"] = bool(v.get("on", True))
                _c["ticker_coins"] = [str(x).upper().strip() for x in (v.get("value_coins") or v.get("coins") or [])][:20]
                _c["ticker_speed"] = max(20, min(180, int(v.get("speed") or 45)))
                if v.get("indic") is not None:
                    _c["indic_on"] = bool(v.get("indic"))
                save_app_cfg(_c)
                _safe(ticker_fetch, default=None)          # تحديث فوري بلا انتظار الدورة
                threading.Thread(target=lambda: _safe(indic_fetch, default=None), daemon=True).start()
                return self._json({"ok": True, "msg": f"📈 حُفظ الشريط — {len(_c['ticker_coins'])} عملة"
                                                      + ("" if _c["ticker_on"] else " (متوقف)")})
            if act == "pxa_set":                          # 🔔 v3.26.6: إشعارات الأسعار — تشغيل/إطفاء · الحساسية · وين توصل
                return self._json(pxa_set(data.get("value") or {}))
            if act == "pxa_test":
                return self._json(pxa_test())
            if act == "pxa_get":                          # 🔔 v3.26.7: لوحة الإشعارات صارت بـ⚙️ «📈 شريط الأسعار» (قراءة بس) · v3.31.0: ويّا 📊 المؤشرات
                return self._json({"ok": True, "pxa": pxa_view(), "ina": ina_view()})
            if act == "ina_set":                          # 📊 v3.31.0: تنبيهات المؤشرات — تشغيل/إطفاء · الحساسية · وين توصل
                return self._json(ina_set(data.get("value") or {}))
            if act == "ina_test":
                return self._json(ina_test())
            if act == "guard_cfg":
                v = data.get("value") or {}
                _by = "👤 اللوحة (" + str((self.client_address or ["?"])[0]) + ")"
                return self._json(guard_cfg(auto_fix=v.get("auto_fix"), paused=v.get("paused"), by=_by))
            if act == "ri_report":
                txt = _safe(reinvest_report, data.get("value") or "daily", default=None)
                if not txt:
                    return self._json({"ok": False,
                                       "msg": "لا يوجد بوت لديه إعادة استثمار مفعّلة بلقطة مسجّلة"})
                _tg_report(txt)
                return self._json({"ok": True, "msg": "💠 أُرسل تقرير إعادة الاستثمار"})
            return self._json(control(data.get("dir", ""), act, data.get("value")))
        if path == "/api/deploy":
            return self._json(deploy(data))
        if path == "/api/deploy_dca":
            return self._json(deploy_dca(data))
        if path == "/api/deploy_rec":
            return self._json(deploy_rec(data))
