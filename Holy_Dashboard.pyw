def _gd_trade_scan(g, now, snaps=None):
    """📡 **مراقبة التداول** لكل بوت شبكة — كل جولة رقابة، من نفس بيانات المنصة (بلا طلبات زايدة):
    ١ حجم كل أمر منشور بالدفتر = حجمه بالمنصة · ٢ مطالبات البيع (منشور + ذاكرة + مخزن) ≤ رصيد العملة الكلي ·
    ٣ سطور التحذير بسجل البوت (آخر 24 ساعة) · ٤ أوامر إعادة الاستثمار تنتظر التصغير من زمان · ٥ ميزان التدقيق المالي.
    كل مشكلة ⇒ حدث بالرقابة (ويوصل تيليغرام) — ويتسكّر وحده لما تنحل."""
    by_w = {str(s.get("wid")): s for s in (snaps or []) if isinstance(s, dict) and not s.get("fatal")}
    rows, live, claims, over = [], set(), {}, []
    for b in bot_dirs().values():
        cfg = b.get("cfg") or {}
        if cfg.get("is_demo"):
            continue
        try:
            sp, hp, _lp = paths_of(b)
            st = load_json(sp) or {}
        except Exception:
            continue
        if not isinstance(st, dict) or not any(k in st for k in ("limit_buys", "limit_sells", "virtual_sells")):
            continue                                            # بوت مو شبكة (DCA) — له فحوصه
        name = os.path.basename(str(b.get("dir") or "").rstrip("/\\\\")) or str(b.get("symbol") or "bot")
        sym = str(cfg.get("symbol") or b.get("symbol") or "")
        coin = sym.split("-")[0]
        wid = _gd_wid(cfg.get("api_key"))
        snap = by_w.get(wid) or {}
        row = {"bot": name, "sym": sym, "wid": wid, "live": 0, "mism": [], "warn": {}, "uw_old": 0, "claims": 0.0}
        pend = snap.get("pending") or {} if snap.get("ok_pend") else None
        for dn in ("limit_buys", "limit_sells"):
            for oid, v in (st.get(dn) or {}).items():
                if not isinstance(v, dict):
                    continue
                row["live"] += 1
                if pend is not None and str(oid) in pend:
                    q_b, q_x = float(v.get("locked_qty") or 0), float(pend[str(oid)].get("sz") or 0)
                    if abs(q_b - q_x) > max(5e-7, q_b * 1e-9):
                        # 📏 يُسجَّل للتشخيص بس — نموذج التدفق بالرقابة يفرّق المشروع (مُراكِم بالطريق · حركة المالك) من الخطأ وينبّه بسياقه
                        row["mism"].append({"oid": str(oid), "px": v.get("target_price"), "book": q_b, "okx": q_x})
        cl = sum(float((v or {}).get("locked_qty") or 0) for dn in ("limit_sells", "virtual_sells", "accum_sells")
                 for v in (st.get(dn) or {}).values() if isinstance(v, dict))
        row["claims"] = round(cl, 8)
        c = claims.setdefault((wid, coin), [0.0, []]); c[0] += cl; c[1].append(name)
        msgs = _safe(_gd_hist_recent, hp, default=[]) or []
        for tag, sev, what in _GD_TR_WARN:
            n = sum(1 for m in msgs if tag in m)
            if n:
                row["warn"][what] = n
                k = f"tr:{name}:warn:{what}"
                ex = next((m for m in msgs if tag in m), "")
                _gd_event(g, k, sev, f"⚠️ {what} — {sym}", f"{name} · {n} مرة بآخر 24 ساعة · آخرها: {ex[:260]}",
                          wid=wid, sym=sym, kind="trade")
                live.add(k)
        uw = ((st.get("reinvest") or {}).get("unwind") or {}) if isinstance(st.get("reinvest"), dict) else {}
        old = [kk for kk, e in uw.items() if isinstance(e, dict) and now - float(e.get("ts") or now) > 6 * 3600]
        if old:
            row["uw_old"] = len(old)
            k = f"tr:{name}:uw"
            _gd_event(g, k, "🟡", f"⏳ أوامر إعادة استثمار تنتظر التصغير من +6 ساعات — {sym}",
                      f"{name} · {len(old)} أمر (البوت يعيد المحاولة كل دورة أو ينتظر تنفيذه)", wid=wid, sym=sym, kind="trade")
            live.add(k)
        rows.append(row)
    for (wid, coin), (cl, names) in claims.items():
        snap = by_w.get(wid) or {}
        if not snap.get("ok_bal") or cl <= 0:
            continue
        cash = float(((snap.get("bal") or {}).get(coin) or {}).get("cash") or 0)
        if cl > cash + max(1e-6, cl * 1e-6):
            # 🪙 يُسجَّل للتشخيص بس — «المالك سحب عملة يحتاجها البوت» ينبّه عليه نموذج التدفق بالرقابة بسياقه
            over.append({"wid": wid, "coin": coin, "claims": round(cl, 8), "cash": round(cash, 8), "bots": names})
    aud = _safe(money_audit, default={}) or {}
    # 💰 ميزان المال بس — طابور التسليم للمُراكِم (عملة «بالطريق») يتابعه فحص إعادة الاستثمار بمهلته، فما نكرّره هنا
    bad = [c for c in (aud.get("checks") or []) if isinstance(c, dict) and not c.get("ok")
           and not any(t in str(c.get("check") or "") for t in ("تسليم", "المُراكِم", "مراكم"))]
    if bad:
        _gd_event(g, "tr:audit", "🔴", f"💰 التدقيق المالي: {len(bad)} فحص ما مطابق",
                  " · ".join(f"{c.get('check')}: {str(c.get('detail'))[:120]}" for c in bad[:3]), kind="trade")
        live.add("tr:audit")
    for e in g.get("events") or []:
        kk = str(e.get("key") or "")
        if kk.startswith("tr:") and e.get("status") == "open" and kk not in live:
            e["status"], e["resolved"] = "resolved", now
    g["trade"] = {"ts": now, "rows": rows, "claims_over": over, "audit": (aud.get("summary") or {})}
    return rows

def _gd_ri_scan(g, now):
    """🔄 يتابع كل عملة ودولار بعد إطفاء إعادة الاستثمار لحد ما يوصل مكانه:
    تسليمات ما وصلت (وسببها) · أوامر مكبّرة تنتظر التفكيك · درجات ما تنلگى."""
    cfgs = _safe(acc_cfgs, default=[]) or []
    seen = set((_safe(acc_state, default={}) or {}).get("_ri_seen") or [])
    rows, live = [], set()
    for b in bot_dirs().values():
        cfg = b.get("cfg") or {}
        if cfg.get("is_demo"):
            continue
        bst = _safe(load_json, paths_of(b)[0], default={}) or {}
        ri = bst.get("reinvest") if isinstance(bst.get("reinvest"), dict) else None
        if not ri:
            continue
        name = os.path.basename(str(b["dir"]).rstrip("/\\"))
        sym, base = b["symbol"], b["symbol"].split("-")[0]
        _mine, why = _ri_eligible(b, cfgs)
        pend = [{"id": h["id"], "coin": float(h.get("coin") or 0), "avg": float(h.get("avg_px") or 0),
                 "ts": float(h.get("ts") or 0), "reason": str(h.get("why") or ""), "why": why}
                for h in _ri_handoffs_of(bst) if h.get("id") not in seen]
        uws = [{"k": str(k), "side": e.get("side"), "g": float(e.get("grown_qty") or 0),
                "px": float(e.get("px") or 0), "ts": float(e.get("ts") or 0), "miss": int(e.get("miss") or 0)}
               for k, e in (ri.get("unwind") or {}).items() if isinstance(e, dict)]
        if not pend and not uws and not ri.get("handoffs") and not float(ri.get("unwound_usd") or 0) \
                and not _safe(_ri_orphans, b, bst, default=[]):
            continue
        orph = _safe(_ri_orphans, b, bst, default=[]) or []
        rows.append({"bot": name, "sym": sym, "on": bool(ri.get("on")), "pend": pend, "uw": uws, "orphans": orph,
                     "fp_ok": _safe(_file_fp, os.path.join(b["dir"], "reinvest.py"), default="") == REINV_VERSION,
                     "handoff_total": float(ri.get("handoff_total") or 0), "unwound_usd": float(ri.get("unwound_usd") or 0),
                     "cap_coin": float(ri.get("cap_coin_total") or 0), "n_ho": len(ri.get("handoffs") or [])})
        first = g.setdefault("ri_first", {})
        for p in pend:
            k1 = "ri:ho:" + p["id"]
            age = now - float(first.setdefault(p["id"], now))   # ⏱️ من أول ما شافته الرقابة — ما نثق بوقت مكتوب
            if p["why"]:
                _gd_event(g, k1, "🟠", "🪙 عملة محرَّرة تنتظر المُراكِم",
                          f"{sym}: {p['coin']:.8f} {base} @ {p['avg']:.6f}$ ({p['reason']}) — {p['why']}. "
                          f"تنسلّم لحالها بسعرها الأصلي أول ما ينحل السبب.", sym=sym, kind="ri_wait")
                live.add(k1)
            elif age > GUARD_HO_STUCK:
                _gd_event(g, k1, "🔴", "🪙 تسليم عملة للمُراكِم ما وصل",
                          f"{sym}: {p['coin']:.8f} {base} من {int(age / 60)} دقيقة والمُراكِم جاهز — "
                          f"تأكد إن اللوحة شغّالة.", sym=sym, kind="ri_ho")
                live.add(k1)
        for u in uws:
            if u["miss"] >= GUARD_UW_MISS:
                k2 = f"ri:uw:{name}:{u['k']}"
                _gd_event(g, k2, "🟠", "🔓 أمر مكبّر ما ينلگى بالبوت",
                          f"{sym}: الدرجة {u['k']} ({'بيع' if u['side'] == 'sell' else 'شراء'} مكبّر · نمو {u['g']:.6f} "
                          f"≈ {u['g'] * u['px']:.4f}$) اختفت من أوامر البوت — غالباً انلغت من التطبيق. "
                          f"نموّها {'عملة' if u['side'] == 'sell' else 'دولار'} بالمحفظة.", sym=sym, kind="ri_miss")
                live.add(k2)
    for e in g.get("events") or []:
        kk = str(e.get("key") or "")
        if kk.startswith("ri:") and e.get("status") == "open" and kk not in live:
            e["status"], e["resolved"] = "resolved", now
    pend_ids = {p["id"] for r in rows for p in r["pend"]}
    g["ri_first"] = {k: v for k, v in (g.get("ri_first") or {}).items() if k in pend_ids}
    g["ri"] = {"ts": now, "rows": rows}


def _gd_acc_scan(g, now):
    """🪙 يراقب المُراكِم: جولته اليومية · توزيع ربح كل يوم · الأمر المعلّق · الفلوس الواقفة.

    يشتغل بنهاية اليوم ويشتري لحاله، فأي تعثّر ما ينكشف إلا بالمراقبة — ولهذا انحط بالرقابة."""
    cfgs = _safe(acc_cfgs, default=[]) or []
    st = _safe(acc_state, default={}) or {}
    meta = st.get("_meta") or {}
    last_day = str(meta.get("last_run_day") or "")
    last_ts = float(meta.get("last_run_ts") or 0)
    rows, used = [], 0.0
    if not cfgs:
        g.pop("acc", None)
        for e in g.get("events") or []:
            if str(e.get("key", "")).startswith("acc:") and e.get("status") == "open":
                e["status"], e["resolved"] = "resolved", now
        return
    # ⏰ الجولة اليومية تأخرت
    key_run = "acc:run"
    if last_ts and now - last_ts > GUARD_ACC_RUN_H * 3600:
        _gd_event(g, key_run, "🟠", "🪙 جولة المُراكِم تأخرت",
                  f"آخر جولة قبل {int((now - last_ts) / 3600)} ساعة (يوم {last_day}) — المفروض مرة كل يوم بعد نص الليل. "
                  f"تأكد إن اللوحة شغّالة ليلاً.", kind="acc_run")
    else:
        _gd_resolve(g, key_run)
    days7 = [(datetime.now() - timedelta(days=i)).strftime("%Y-%m-%d") for i in range(1, 8)]
    for a in cfgs:
        aid = str(a.get("id") or "")
        e = st.get(aid) or {}
        sym = str(a.get("symbol") or "")
        base = sym.split("-")[0]
        pct = float(a.get("pct") or 0)
        used += pct
        en = bool(a.get("enabled", True))
        pool = float(e.get("pool") or 0)
        minb = max(1.0, float(a.get("min_buy") or 0))
        coin = float(e.get("coin") or 0)
        spent = float(e.get("spent") or 0)
        px = float(PX.get(sym) or 0)
        buys = [x for x in (e.get("buys") or []) if isinstance(x, dict)]
        last_buy = max([float(x.get("ts") or 0) for x in buys] or [0])
        inf = e.get("inflight") or {}
        sinf = e.get("sell_inflight") or {}
        miss = []
        for d in days7[:3]:
            if (a.get("start") or "") and d < str(a.get("start")):
                continue
            share = (e.get("days") or {}).get(d)
            prof = float(_safe(day_profit, d, default=0.0) or 0)
            if prof > 0.0005 and pct > 0 and last_day > d and (share is None or float(share) <= 0):
                miss.append(d)
        rows.append({"id": aid, "name": a.get("name") or sym, "sym": sym, "base": base, "pct": pct,
                     "enabled": en, "pool": round(pool, 4), "reserve": round(float(e.get("pending") or 0), 4),
                     "coin": round(coin, 8), "spent": round(spent, 4),
                     "avg": round(spent / coin, 8) if coin > 0 else 0,
                     "value": round(coin * px, 4) if px else None,
                     "pl": round(coin * px - spent, 4) if px and coin > 0 else None,
                     "min_buy": minb, "last_buy": last_buy, "n_buys": len(buys),
                     "skip": str(e.get("skip") or ""), "inflight": bool(inf), "sell_inflight": bool(sinf),
                     "miss": miss,
                     "alloc7": round(sum(float((e.get("days") or {}).get(d) or 0) for d in days7), 4),
                     "buy7": round(sum(float(x.get("usd") or 0) for x in buys
                                       if now - float(x.get("ts") or 0) <= 7 * 86400), 4)})
        # 🔴 أمر معلّق: فلوس طلعت والعملة ما انسجّلت بعد
        for tag, box, word in (("buy", inf, "شراء"), ("sell", sinf, "بيع")):
            k = f"acc:{tag}:{aid}"
            ts0 = float((box or {}).get("ts") or 0)
            if box and ts0 and now - ts0 > GUARD_ACC_INFLIGHT:
                _gd_event(g, k, "🔴", f"🪙 أمر {word} للمُراكِم ما انسوّى",
                          f"{a.get('name') or sym}: أمر {word} معلّق من {int((now - ts0) / 60)} دقيقة — "
                          f"اللوحة ما تأكدت من تنفيذه. افتح 🪙 المُراكِم وشوف الحالة قبل أي شراء يدوي.",
                          sym=sym, kind="acc_inflight")
            else:
                _gd_resolve(g, k)
        # 🟠 ربح يوم ما انوزّع
        k = f"acc:alloc:{aid}"
        if miss:
            _gd_event(g, k, "🟠", "🪙 ربح يوم ما انوزّع للمُراكِم",
                      f"{a.get('name') or sym}: أيام فيها ربح وما أخذ نصيبه ({'، '.join(miss)}) — "
                      f"نسبته {pct:.0f}%. راجع تاريخ البداية وحالة اللوحة بتلك الأيام.", sym=sym, kind="acc_alloc")
        else:
            _gd_resolve(g, k)
        # 🟠 فلوس واقفة: فوق الحد الأدنى وما اشترى من يومين
        k = f"acc:pool:{aid}"
        if en and pool >= minb and last_buy and now - last_buy > GUARD_ACC_POOL_H * 3600:
            _gd_event(g, k, "🟠", "🪙 فلوس المُراكِم واقفة",
                      f"{a.get('name') or sym}: {pool:.2f}$ قيد الشراء (الحد الأدنى {minb:.0f}$) وآخر شراء قبل "
                      f"{int((now - last_buy) / 3600)} ساعة." + (f" السبب المسجّل: {e.get('skip')}" if e.get("skip") else ""),
                      sym=sym, kind="acc_pool")
        else:
            _gd_resolve(g, k)
    # 🟠 مجموع النسب فوق 100%
    k = "acc:pct"
    if used > 100.0001:
        _gd_event(g, k, "🟠", "🪙 مجموع نسب المُراكِم فوق 100%",
                  f"المجموع {used:.0f}% — التوزيع ياخذ أكثر من ربح اليوم. صحّح النسب.", kind="acc_pct")
    else:
        _gd_resolve(g, k)
    g["acc"] = {"ts": now, "rows": rows, "used_pct": round(used, 2),
                "keep_pct": round(max(0.0, 100.0 - used), 2), "last_run": last_day,
                "last_run_ts": last_ts, "flow": _safe(flow_days, 7, default=[]) or []}


