_RI_REQ_LOCK = threading.Lock()


def _ri_request_write(path, payload, wait=8.0):
    """📨 طلب للبوت بملف — **ما يكتب فوق طلب سابق ما انطبق بعد** (كان الأول يضيع بصمت لو ضغطت مرتين بسرعة).
    ينتظر البوت يستلم السابق (عادة ثواني)؛ وإذا ما استلمه (موقوف؟) يرجّع False حتى اللوحة ترفض بوضوح."""
    with _RI_REQ_LOCK:
        t0 = time.time()
        while os.path.exists(path) and time.time() - t0 < wait:
            time.sleep(0.25)
        if os.path.exists(path):
            return False
        save_json_atomic(path, payload)
        return True


