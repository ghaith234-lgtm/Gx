/* ⬇️ تنزيل ملف من اللوحة — يرسل الجلسة والـPIN (الرابط المباشر ما يرسل الـPIN ⇒ كان ينرفض لمن مفعّل PIN) */
async function dlFile(url,name){
  toast('⏳ أجهّز الملف…',true);
  try{const r=await fetch(url,{headers:H()});
    if(r.status===401){toast('🔒 الجلسة انتهت أو الـPIN غلط',false);return false}
    if(!r.ok){toast('تعذّر التنزيل ('+r.status+')',false);return false}
    const m=(r.headers.get('Content-Disposition')||'').match(/filename="?([^";]+)"?/);
    const u=URL.createObjectURL(await r.blob()),a=document.createElement('a');
    a.href=u;a.download=(m&&m[1])||name;document.body.appendChild(a);a.click();a.remove();
    setTimeout(()=>URL.revokeObjectURL(u),8000);toast('✅ نزل الملف',true);return true}
  catch(e){toast('تعذّر التنزيل',false);return false}}
function repMark(){                     // يوضّح المدة والمصدر المختارين
