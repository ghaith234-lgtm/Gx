  _sf('#mGuard',x=>{x.textContent=gA.length?`🛡️ ${gA.length}`:'';x.style.color=gRed?'var(--red)':'var(--amber)'});
  _sf('#mPulse',x=>{const p=$('#pulse');if(p)x.className=p.className});
  const sw=$('#step_w');if(sw&&typeof d.wallets==='number')sw.textContent=d.wallets>0?'✅ المحفظة جاهزة':'1️⃣ 👛 أضف محفظة OKX';
  $('#tEx').textContent=(typeof d.ex_b==='number')?`${d.ex_s}↑ ${d.ex_b}↓ · ${d.ex_b+d.ex_s}`:'—'}

/* ── الدُرج ── */
/* 📦 v3.21.2: اسما زري الإيقاف/الاستئناف بالكرت — نفس الحساب بالتحديث وبعد الضغط فوراً (العدّاد = المقطوع بس) */
function accLbls(b){const AX=b.accx||{};
  return[b.floor>0?`▶️ استئناف الشراء (${AX.nb||0})`:(b.pause_buy?'⏳ جاري إيقاف الشراء…':'⏸ إيقاف الشراء'),
         b.ceil>0?`▶️ استئناف البيع (${AX.ns||0})`:(b.pause_sell?'⏳ جاري إيقاف البيع…':'⏸ إيقاف البيع')]}
function accBtnSync(dir){const el=CARDS.get(dir),b=botOf(dir);if(!el||!el._r||!el._r.ab||!b)return;
  const R=el._r,[abL,asL]=accLbls(b);
  R.ab.textContent=abL;R.ab.className=(b.floor>0||b.pause_buy)?'on':'';
  R.as.textContent=asL;R.as.className=(b.ceil>0||b.pause_sell)?'on':''}
/* 📦 v3.21.2: شارة المخزن — وقت الإيقاف: المقطوع بس (يتنفّذ بأمر واحد لو تستأنف) · بلا إيقاف (حجوزات النطاق): مثل قبل */
function accChipsOf(b){
  const AX=b.accx||{};let c='';
  if(b.floor>0){if((AX.nb||0)>0){c+=`<span class="chip acc" title="${AX.nb} تنشرى بأمر واحد لو تستأنف هسه · ${Math.max(0,(AX.kb||0)-AX.nb)} محفوظة ترجع بأماكنها">📦 شراء ${AX.nb} ≈ $${AX.ub}</span>`;
    if(AX.ab!=null&&AX.ab<AX.nb)c+=`<span class="chip" style="color:var(--red);border-color:rgb(var(--red2-rgb)/.45);background:rgb(var(--red2-rgb)/.08)"
      title="💵 ب٢٤: دولارك الحر $${AX.qa} يغطي ${AX.ab} من ${AX.nb} درجة لو تستأنف هسه (الكل ≈ $${AX.qn}) — البوت يشتري اللي يغطيه بأمر واحد والباقي ينتظر بالمخزن لحد ما يتوفر دولار · الدولار الحر مشترك بين بوتات نفس الحساب">💵 يغطي ${AX.ab}/${AX.nb}</span>`}}
  else if(b.n_abuys>0)c+=`<span class="chip acc">📦 شراء ${b.n_abuys} ≈ $${b.abuys_usd}</span>`;
  if(b.ceil>0){if((AX.ns||0)>0)c+=`<span class="chip acc" title="لحد ${AX.ns} تنباع بأمر واحد لو تستأنف هسه (بقدر عملتك الحرّة) · ${Math.max(0,(AX.ks||0)-AX.ns)} محفوظة ترجع بأماكنها">📦 بيع ${AX.ns} ≈ $${AX.us}</span>`}
  else if(b.n_asells>0)c+=`<span class="chip acc">📦 بيع ${b.n_asells} ≈ $${b.asells_usd}</span>`;
  return c}
function accumPrompt(b,side){
  b=botOf(b.dir)||b;                                   // 🔁 الحالة الحالية (مو نسخة بناء الكرت)
  const buy=side==='buy',limOn=buy?b.floor>0:b.ceil>0,pend=buy?b.pause_buy:b.pause_sell;
  // ▶️ 🔐 v3.21.10 (ب٢٦): الاستئناف ينفّذ أمر سوق ⇒ نافذة تأكيد بالأرقام أول (لمسة غلط ما تصرف فلوس)
  if(limOn){resumeConfirm(b,side);return}
  if(pend){const bb=botOf(b.dir);if(bb){if(buy)bb.pause_buy=false;else bb.pause_sell=false}   // إيقاف بانتظار البوت ⇒ إلغاؤه (ولا أمر بالسوق)
    accBtnSync(b.dir);ctl(b.dir,buy?'accum_buy':'accum_sell');return}
  // غير مفعّل → اطلب الحد (معبّى بسعر السوق بأرقامه الكاملة)
  const cp=+((window.JPX&&JPX[b.symbol])||b.cp||0);
  const word=buy?'الشراء':'البيع';
  const dir2=buy?'لا شراء تحت هذا السعر':'لا بيع فوق هذا السعر';
