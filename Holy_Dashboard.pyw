def price_loop():
    # سعر حي بسلسلة مصادر: OKX → مرآة OKX → Binance — وأي فشل كامل يظهر سببه بالواجهة
    while True:
        try:
            # 🪙 رموز المُراكِمات أيضاً — حتى لو ما عندك بوت على تلك العملة
            _sy = {b["symbol"] for b in bot_dirs().values()}
            try:
                _sy |= {a.get("symbol") for a in acc_cfgs() if a.get("symbol")}
            except Exception:
                pass
            syms = sorted(_sy)
            got_any = False
            for sym in syms:
                px = 0.0
                r = _okx_pub(f"/api/v5/market/ticker?instId={sym}")
                if r and r.get("code") == "0" and r.get("data"):
                    px = float(r["data"][0].get("last") or 0)
                if not px:
                    try:
                        with urllib.request.urlopen(f"https://aws.okx.com/api/v5/market/ticker?instId={sym}", timeout=6, context=_OKX_CTX) as rr:
                            j = json.loads(rr.read().decode("utf-8"))
                            if j.get("code") == "0" and j.get("data"):
                                px = float(j["data"][0].get("last") or 0)
                    except Exception:
                        pass
                if not px:
                    try:
                        j = _http_json("https://api.binance.com/api/v3/ticker/price?symbol="
                                       + sym.replace("-", ""), timeout=10)
                        px = float((j or {}).get("price") or 0)
                    except Exception:
                        pass
                if px:
                    PX[sym] = px
                    got_any = True
            if syms:
                if got_any:
                    BAL_ERR.pop("السعر العام", None)
                else:
                    BAL_ERR["السعر العام"] = "بايثون ما گدر يجلب السعر (OKX وBinance) — شبكة/بروكسي"
        except Exception:
            pass
        time.sleep(4)

import ssl as _ssl
