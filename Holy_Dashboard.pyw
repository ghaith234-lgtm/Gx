# ═══════════════ 🔓 إشعارات الأوامر المعلّقة بعد إيقاف إعادة الاستثمار ═══════════════
NOTIFY_FILE = os.path.join(ROOT, "Holy_Notify.json")
_FATE_USD = {}      # دولار تفكيك انبلغ بهالدورة لكل بوت — حتى «💰 ربح» القديمة ما تعيده
_FATE_RX_USD = re.compile(r"تحرّر ربح\s*([\d.]+)\$")
_FATE_RX_WHY = re.compile(r"—\s*([^·]+?)\s*·")
_FATE_RX_BACK = re.compile(r"شغّلت من جديد — (\d+) أمر مكبّر")


def _fate_text(sym, msg):
    """سطر سجل ⇒ (رسالة مصير أمر معلّق، دولارها) أو (None، 0). العملة تطلع برسالة التسليم (وين راحت وبأي معدل)."""
    m = str(msg or "")
    s = _tp_md(sym)
    if "[تفكيك]" in m:
        x = _FATE_RX_USD.search(m)
        usd = float(x.group(1)) if x else 0.0
        if usd <= 0:
            if "بوقت مناسب" in m or "رأس مال" in m:       # ⚡ تصغّر لاحقاً بلا دولار (عملة رأس مال/للمُراكِم) — برضه يستاهل رسالة
                return (f"⚡ *أمر معلّق تصغّر وتحرر* — `{s}`\n{_tp_md(m.split(']', 1)[-1].strip())[:260]}"), 0.0
            return None, 0.0
        w = _FATE_RX_WHY.search(m)
        why = w.group(1).strip() if w else ("بيع مكبّر نفّذ" if "رجعت لحجمها" in m else "تفكيك")
        return (f"🔓 *أمر معلّق تحرر* — `{s}`\n{_tp_md(why)}\n"
                f"💵 `+{usd:.4f}$` للربح المحرر (يأخذ المُراكِم نسبته في توقيته)"), usd
    x = _FATE_RX_BACK.search(m)
    if x:
        return (f"▶️ *إعادة الاستثمار رجعت* — `{s}`\n"
                f"{x.group(1)} أمر معلّق عاد درجات إعادة استثمار كأن الإيقاف لم يحدث"), 0.0
    if "[تصحيح النمو اليتيم]" in m:
        return f"🧹 *تصحيح نمو يتيم* — `{s}`\n{_tp_md(m.split(']', 1)[-1].strip())[:160]}", 0.0
    body = _tp_md(m.split("]", 1)[-1].strip())[:300]
    if ("⚠️ [حقن]" in m or "⚠️ [سحب]" in m) or ("[تعديل أمر]" in m and ("حقن" in m or "سحب" in m)):
        return f"⚠️ *لم يُطبَّق طلبك كله* — `{s}`\n{body}", 0.0   # ⚠️ الفشل **قبل** النجاح — سطر تحذير ما ينقرا «تم» أبداً
    if "[حقن] طبّقت" in m:                             # 💉 نتيجة الحقن الحقيقية (من البوت، مو لحظة الطلب)
        return f"💉 *الحقن تم* — `{s}`\n{body}", 0.0
    if "[حقن] الدرجة" in m:
        return f"💉 *حقن بالدرجة* — `{s}`\n{body}", 0.0
    if "[سحب] الدرجة" in m:                            # ➖ كل درجة: وين راح كل جزء + الأمر صغر بالمنصة
        return f"➖ *السحب تم* — `{s}`\n{body}", 0.0
    if "بوقت مناسب بعد" in m and "[تفكيك]" not in m:   # العملة من أمر معلّق تصغّر لاحقاً (رسالة الدولار تطلع من [تفكيك])
        return f"⚡ *أمر معلّق تصغّر بوقت مناسب* — `{s}`\n{body}", 0.0
    return None, 0.0



_FATE_BUF = {}      # 📨 سطور طلب حقن/سحب لسه ما وصلت خلاصته — تنجمع برسالة وحدة
_FATE_REQFAIL = ("طلب تالف", "مطفية — الطلب اتلغى", "الطلب قديم")


def _fate_kind(m):
    if "[حقن]" in m or ("[تعديل أمر]" in m and "حقن" in m):
        return "inj"
    if "[سحب]" in m or ("[تعديل أمر]" in m and "سحب" in m):
        return "wd"
    return None


def _fate_line(m):
    body = _tp_md(m.split("]", 1)[-1].strip())[:230]
    if "⚠️" in m:
        return "⚠️ " + body
    tag = " — ✅ مؤكد من المنصة" if "المنشور" in m else (" — 🗂️ بالذاكرة" if "بالذاكرة" in m else "")
    return "• " + body + tag


def _fate_flush(sym, buf, summary=None):
    kind = buf.get("kind"); lines = buf.get("lines") or []
    ok_lines = [l for l in lines if "⚠️" not in l]
    head = ("💉 *تم الحقن*" if kind == "inj" else "➖ *تم السحب*") if (summary or ok_lines) else \
           ("⚠️ *لم يُطبَّق الحقن*" if kind == "inj" else "⚠️ *لم يُطبَّق السحب*")
    out = [f"{head} — `{sym}`"] + [_fate_line(l) for l in ok_lines] + [_fate_line(l) for l in lines if "⚠️" in l]
    if summary:
        out.append("🧾 " + _tp_md(summary.split("]", 1)[-1].strip())[:220])
    return ("\n".join(out), 0.0)


def _fate_batch(key, sym, msgs):
    """📨 سطور البوت الجديدة ⇒ رسائل: **رسالة وحدة لكل طلب حقن/سحب** (تطلع عند سطر الخلاصة، يعني بعد ما كل درجة
    تأكدت من المنصة) · فشل الطلب كله ⇒ رسالة وحدة فوراً · تسليم عملة «بوقت مناسب» ينضم لرسالة التفكيك."""
    out, pend_ho = [], []
    buf = _FATE_BUF.get(key)
    for m in msgs:
        kind = _fate_kind(m)
        if kind and any(x in m for x in _FATE_REQFAIL):
            if buf:
                out.append(_fate_flush(sym, buf)); buf = None
            out.append((f"⚠️ *لم يُطبَّق {'الحقن' if kind == 'inj' else 'السحب'}* — `{sym}`\n{_tp_md(m.split(']', 1)[-1].strip())[:240]}", 0.0))
            continue
        is_sum = (kind == "inj" and "[حقن] طبّقت" in m) or (kind == "wd" and re.search(r"\[سحب\] \d+ درجة", m))
        if is_sum:
            b0 = buf if (buf and buf.get("kind") == kind) else {"kind": kind, "lines": []}
            if buf and buf.get("kind") != kind:
                out.append(_fate_flush(sym, buf))
            out.append(_fate_flush(sym, b0, m)); buf = None
            continue
        if kind:
            if buf and buf.get("kind") != kind:
                out.append(_fate_flush(sym, buf)); buf = None
            if not buf:
                buf = {"kind": kind, "lines": [], "t": time.time()}
            buf["lines"].append(m)
            continue
        if "[تسليم للمُراكِم]" in m:
            if "بوقت مناسب" in m:                        # ينضم لرسالة التفكيك (قبله أو بعده)
                if out and out[-1][0].startswith(("🔓", "⚡")):
                    out[-1] = (out[-1][0] + "\n🪙 " + _tp_md(m.split("]", 1)[-1].strip())[:200], out[-1][1])
                else:
                    pend_ho.append(m)
            continue                                     # غير هيچ: الإيقاف/السحب يغطيه برسالته
        txt, usd = _fate_text(sym, m)
        if txt:
            if pend_ho and "[تفكيك]" in m:
                txt += "".join("\n🪙 " + _tp_md(x.split("]", 1)[-1].strip())[:200] for x in pend_ho); pend_ho = []
            out.append((txt, usd))
    for x in pend_ho:
        out.append((f"⚡ *أمر معلّق صُغّر وتحرّر* — `{sym}`\n🪙 {_tp_md(x.split(']', 1)[-1].strip())[:220]}", 0.0))
    if buf and time.time() - float(buf.get("t") or time.time()) > 90:     # خلاصة ما وصلت (توقف؟) ⇒ نطلعه كما هو
        out.append(_fate_flush(sym, buf)); buf = None
    if buf:
        _FATE_BUF[key] = buf
    else:
        _FATE_BUF.pop(key, None)
    return out


def _release_msg(sym, base, lt, rl, acc_on, tp_now):
    """🔄 رسالة **وحدة** للإيقاف: من الجهتين — كم دولار وكم عملة انسحب (منشور بالمنصة ✅ مؤكد / ذاكرة / دفتر)،
    ومنها كم رأس مال محقون وكم ربح متراكم، ووين راح كل واحد."""
    bd = rl.get("bd") or {}
    profit = float(lt.get("profit") or rl.get("usd") or 0)
    capu = float(lt.get("release_capital") or rl.get("capital") or 0)
    capc = float(rl.get("capital_coin") or 0)
    rc = float(lt.get("release_coin") or 0)
    nowq, waitq = int(rl.get("resized_now") or 0), int(rl.get("unwind") or lt.get("unwind_left") or 0)
    usd_tot = float(rl.get("gross") or (profit + capu))
    L = [f"🔄 *إيقاف إعادة الاستثمار — `{sym}`*", "━━━━━━━━━━━━━", f"💵 *دولار مسحوب:* `{usd_tot:.4f}$`"]
    p = []
    if float(bd.get("usd_live") or 0) > 1e-9: p.append(f"منشور في المنصة ✅ مؤكد `{float(bd['usd_live']):.4f}$`")
    if float(bd.get("usd_mem") or 0) > 1e-9: p.append(f"ذاكرة `{float(bd['usd_mem']):.4f}$`")
    if float(bd.get("usd_book") or 0) > 1e-9: p.append(f"حصّالة ونمو دفتري `{float(bd['usd_book']):.4f}$`")
    if p: L.append("   ↳ " + " · ".join(p))
    L.append(f"   ↳ رأس مال محقون `{capu:.4f}$` ← محفظتك · ربح متراكم `{profit:.4f}$` ← الربح المحرر")
    if rc + capc > 1e-12:
        L.append(f"🪙 *عملة مسحوبة:* `{rc + capc:.8f}` {base}")
        p = []
        if float(bd.get("coin_live") or 0) > 1e-12: p.append(f"منشور في المنصة ✅ مؤكد `{float(bd['coin_live']):.8f}`")
        if float(bd.get("coin_mem") or 0) > 1e-12: p.append(f"ذاكرة `{float(bd['coin_mem']):.8f}`")
        if p: L.append("   ↳ " + " · ".join(p))
        L.append(f"   ↳ رأس مال محقون `{capc:.8f}` ← محفظتك · ربح متراكم `{rc:.8f}` ← {'المُراكِم' if acc_on else 'محفظتك (لا يوجد مُراكِم مفعّل)'}")
    if nowq: L.append(f"⚡ `{nowq}` أمر منشور صُغّر في المنصة وتأكّد")
    if waitq: L.append(f"⏳ `{waitq}` رفضت المنصة تصغيره — يعيد المحاولة تلقائياً ويصلك إشعاره")
    L += ["━━━━━━━━━━━━━", f"📊 الإجمالي: `{tp_now:.4f}$`"]
    return "\n".join(L)

def _tg_fate_events():
    """📨 بعد إيقاف إعادة الاستثمار: كل أمر معلّق يجي مصيره (للذاكرة أو تنفيذ) ⇒ رسالة تگول شنو صار.
    المصدر سجل البوت · المؤشر محفوظ بملف ⇒ إعادة تشغيل اللوحة ما تعيد القديم، وأول تشغيل صامت."""
    cur = _safe(load_json, NOTIFY_FILE, default={}) or {}
    changed = False
    for b in bot_dirs().values():
        c0 = b.get("cfg") or {}
        if c0.get("is_demo") or c0.get("bot_type") in _NONGRID:
            continue
        key = os.path.relpath(b["dir"], ROOT)
        _, hp, _ = paths_of(b)
        hist = [h for h in (_safe(load_json, hp, default=[]) or []) if isinstance(h, dict) and h.get("time")]
        if not hist:
            continue
        top_t = str(hist[0].get("time"))
        top_m = [str(h.get("msg")) for h in hist if str(h.get("time")) == top_t]
        c = cur.get(key)
        if not c:
            cur[key] = {"t": top_t, "m": top_m}
            changed = True
            continue
        new = []
        for h in hist:                                   # الأحدث أولاً
            t, msg = str(h.get("time")), str(h.get("msg"))
            if t < c["t"] or (t == c["t"] and msg in (c.get("m") or [])):
                break
            new.append(h)
        if not new:
            continue
        cur[key] = {"t": top_t, "m": top_m}
        changed = True
        for txt, usd in _fate_batch(key, b["symbol"], [str(h.get("msg")) for h in reversed(new)]):
            tg_send(txt)                                 # 📨 رسالة وحدة لكل طلب/حدث
            if usd > 0:
                _FATE_USD[b["dir"]] = _FATE_USD.get(b["dir"], 0.0) + usd
    if changed:
        save_json_atomic(NOTIFY_FILE, cur)


# ═══════════════ 📦 v3.21.1: إشعار عبور درجات الإيقاف ═══════════════
_ACCX = {"st": None, "dirty": False}      # الدرجات اللي انبلّغت لكل بوت/جهة بهالإيقاف — محفوظة بملف الإشعارات
_ACCX_FILE_KEY = "__accx__"
DASH_EVENTS = []                          # 🔔 أحداث تطلع من اللوحة نفسها ⇒ تنضم لمركز الإشعارات الداخلي


def _px_s(x):
    """سعر للعرض بأرقامه المعنوية — العملة الرخيصة ما تصير 0.0000 والغالية ما تطلع بخانات زايدة."""
    try:
        x = float(x)
    except Exception:
        return str(x)
    if not math.isfinite(x):
        return "—"
    if not x:
        return "0"
    d = 4 if abs(x) >= 1 else min(12, max(4, 3 - int(math.floor(math.log10(abs(x))))))
    return f"{x:.{d}f}".rstrip("0").rstrip(".")


def _accx_ok(b, side, p):
    """نفس قيود المحرك وقت الاستئناف: شراء تحت «أدنى سعر» ما ينشرى (v3.21.1) · النطاق: ما يطلع برّا الحدّين."""
    c = b["cfg"]
    if side == "buy" and p < float(c.get("min_price") or 0) - 1e-12:
        return False
    if str(c.get("bot_type") or "grid") == "grid_range":
        g = float(c.get("grid_percentage") or 0.008)
        lo, up = float(c.get("lower_price") or 0), float(c.get("upper_price") or 0)
        if side == "buy":
            return not ((lo > 0 and p < lo - 1e-12) or (up > 0 and p * (1 + g) > up + 1e-12))
        return not (up > 0 and p > up + 1e-12)
    return True


def _accx_levels(b, st, side, cp):
    """الدرجات اللي **قطعها السعر** وهي بمخزن الإيقاف = اللي تتنفّذ بأمر واحد لو تستأنف هسه
    (شراء: سعرها ≥ السعر الحالي · بيع: ≤ السعر الحالي). [(سعر، كمية)]"""
    out = []
    for v in (st.get("accum_buys" if side == "buy" else "accum_sells") or {}).values():
        try:
            p, q = float((v or {}).get("target_price") or 0), float((v or {}).get("locked_qty") or 0)
        except Exception:
            continue
        if p > 0 and q > 0 and _accx_ok(b, side, p) and (p >= cp if side == "buy" else p <= cp):
            out.append((p, q))
    return out


def _accx_afford(b, lv, cp):
    """💵 v3.21.8 (ب٢٤): كم درجة من المقطوعة يغطيها دولارك الحر هسه — نفس حساب المحرك بالضبط (من الحافة · سعر الأمر المجمّع
    ≤ السعر × 1.005 و ≤ أوطى درجة بالأمر · هامش 0.2%). None = الرصيد ما انجلب. الدولار الحر مشترك بين بوتات نفس الحساب."""
    ent = BAL.get(b["dir"]) or {}
    if "q_av" not in ent or not lv or not cp or cp <= 0:
        return None
    av = float(ent.get("q_av") or 0)
    cap, budget = round(float(cp) * 1.005, 4), av * 0.998
    k, sq, mn = 0, 0.0, None
    for i, (p, q) in enumerate(sorted(lv, key=lambda x: -x[0])):
        sq += q
        mn = p if mn is None else min(mn, p)
        if sq * min(cap, mn) <= budget + 1e-12:
            k = i + 1                                  # أطول بادئة يغطيها الدولار (نفس المحرك)
    need = sum(q for _, q in lv) * min(cap, min(p for p, _ in lv))
    return {"k": k, "n": len(lv), "av": round(av, 2), "need": round(need, 2)}


def _accx_snap(b, st):
    """📦 v3.21.2: عدّاد الإيقاف للكرت والنافذة — **اللي قطعها السعر بس** (يبدي من صفر لحظة الإيقاف ويزيد كل ما يقطع درجة)
    + المبلغ بأسعار الدرجات · kb/ks = كل المحفوظ بالمخزن (الأوامر اللي انسحبت لحظة الإيقاف ترجع بأماكنها بالاستئناف)."""
    cp = float(PX.get(b["symbol"]) or st.get("current_price") or 0)
    out = {"nb": 0, "ub": 0.0, "ns": 0, "us": 0.0,
           "kb": len(st.get("accum_buys") or {}), "ks": len(st.get("accum_sells") or {})}
    if cp > 0 and float(st.get("buy_floor") or 0) > 0:
        lv = _accx_levels(b, st, "buy", cp)
        out["nb"], out["ub"] = len(lv), round(sum(p * q for p, q in lv), 2)
        out["cb"] = round(sum(q for _, q in lv), 8)    # 🪙 v3.21.10: مجموع العملة (لنافذة تأكيد الاستئناف)
        _af = _accx_afford(b, lv, cp)                  # 💵 v3.21.8 (ب٢٤)
        if _af:
            out["ab"], out["qa"], out["qn"] = _af["k"], _af["av"], _af["need"]
    if cp > 0 and float(st.get("sell_ceiling") or 0) > 0:
        lv = _accx_levels(b, st, "sell", cp)
        out["ns"], out["us"] = len(lv), round(sum(p * q for p, q in lv), 2)
        out["cs"] = round(sum(q for _, q in lv), 8)    # 🪙 v3.21.10: مجموع العملة (لنافذة تأكيد الاستئناف)
    return out


def _accx_msg(b, side, lv, n_new, lim, cp):
    """(رسالة تيليگرام، سطر مركز الإشعارات): كم أمر · معدل سعر الدرجات · الكمية والمبلغ · تقدير الاستئناف الآن."""
    sym = b["symbol"]
    base = sym.split("-")[0]
    buy = side == "buy"
    n = len(lv)
    q = sum(x[1] for x in lv)
    usd = sum(x[0] * x[1] for x in lv)                 # المبلغ لو كل درجة انفّذت بسعرها (البوت العادي)
    avg = usd / q if q > 0 else 0.0                    # معدل موزون بالكمية
    now = cp * q                                       # أمر واحد بسعر السوق هسه
    k = (b["cfg"].get("api_key") or "").strip()
    tk = float((_FEE_CACHE.get(f"{k[:8]}|{sym}") or {}).get("taker") or 0.001)
    fee = now * tk                                     # الأمر المجمّع «آخذ» (IOC)
    gain = (usd - now) if buy else (now - usd)
    ar = "الشراء" if buy else "البيع"
    tg = (f"📦 *إيقاف {ar} — `{sym}`*\n"
          f"━━━━━━━━━━━━━\n"
          f"{'⬇️' if buy else '⬆️'} السعر عبر `{n_new}` درجة {'شراء' if buy else 'بيع'} جديدة\n"
          f"{'🟢 متاح للشراء' if buy else '🔴 متاح للبيع'}: `{n}` أمر {'تحت الأرضية' if buy else 'فوق السقف'}\n"
          f"📊 معدل سعر الدرجات: `{_px_s(avg)}`\n"
          f"🪙 الكمية: `{q:.8g}` {base}\n"
          f"💵 المبلغ بأسعار الدرجات: `{usd:.2f}$`\n"
          f"━━━━━━━━━━━━━\n"
          f"💲 السعر الحالي: `{_px_s(cp)}` · {'الأرضية' if buy else 'السقف'}: `{_px_s(lim)}`\n"
          f"⚡ إن استأنفت الآن: أمر واحد {'تدفع' if buy else 'تستلم'} ≈ `{now:.2f}$` · "
          f"{'توفير' if buy else 'زيادة'} ≈ `{gain:.2f}$`\n"
          f"🧾 عمولة الأمر ≈ `{fee:.2f}$` (آخذ `{tk * 100:.3f}%`)")
    fd = (f"📦 [إيقاف {ar}] السعر عبر {n_new} درجة جديدة — {'متاح للشراء' if buy else 'متاح للبيع'} {n} أمر · "
          f"معدل {_px_s(avg)} · {q:.8g} {base} ≈ {usd:.2f}$ · إن استأنفت الآن ≈ {now:.2f}$ "
          f"({'توفير' if buy else 'زيادة'} {gain:.2f}$)")
    _af = _accx_afford(b, lv, cp) if buy else None     # 💵 v3.21.8 (ب٢٤): الدولار الحر مقابل المطلوب
    if _af:
        if _af["k"] >= _af["n"]:
            tg += f"\n💵 دولارك الحر `{_af['av']:.2f}$` يكفي الكل ✅"
            fd += f" · 💵 دولارك الحر {_af['av']:.2f}$ يكفي الكل"
        elif _af["k"]:
            tg += f"\n💵 دولارك الحر `{_af['av']:.2f}$` يغطي `{_af['k']}` من `{_af['n']}` درجة — وينتظر الباقي في المخزن حتى يتوفر دولار"
            fd += f" · 💵 دولارك الحر {_af['av']:.2f}$ يغطي {_af['k']} من {_af['n']} — الباقي ينتظر"
        else:
            tg += f"\n⚠️ دولارك الحر `{_af['av']:.2f}$` لا يكفي ولا لدرجة واحدة (الكل ≈ `{_af['need']:.2f}$`)"
            fd += f" · ⚠️ دولارك الحر {_af['av']:.2f}$ لا يكفي ولا لدرجة واحدة"
    return tg, fd


def _accx_state():
    if _ACCX["st"] is None:
        cur = _safe(load_json, NOTIFY_FILE, default={}) or {}
        v = cur.get(_ACCX_FILE_KEY)
        _ACCX["st"] = v if isinstance(v, dict) else {}
    return _ACCX["st"]


def _accx_save():
    """يحفظ بس لو تغيّر — والبوتات المحذوفة (مجلدها راح) تنشال من الملف."""
    if not _ACCX["dirty"] or _ACCX["st"] is None:
        return
    for k in [k for k in _ACCX["st"] if not os.path.isdir(os.path.join(ROOT, k))]:
        _ACCX["st"].pop(k, None)                       # بس اللي مجلده انحذف فعلاً (قراءة وحدة فاشلة ما تمسح)
    cur = _safe(load_json, NOTIFY_FILE, default={}) or {}
    cur[_ACCX_FILE_KEY] = _ACCX["st"]
    save_json_atomic(NOTIFY_FILE, cur)
    _ACCX["dirty"] = False


def _accx_tick(b, st, cp):
    """📦 v3.21.1: إشعار **مرة وحدة** لكل درجة يعبرها السعر وإنت موقف — شراء تحت الأرضية / بيع فوق السقف:
    كم أمر تقدر تشتري/تبيع هسه بأمر واحد · معدل سعر الدرجات · الكمية والمبلغ · تقدير الاستئناف الآن.
    تذبذب السعر على نفس الدرجة ما يعيد الإشعار · الإيقاف يخلص أو حدّه يتغيّر ⇒ يبدي من جديد ·
    محفوظ بملف الإشعارات ⇒ إعادة تشغيل اللوحة ما تعيد القديم."""
    S = _accx_state()
    key = os.path.relpath(b["dir"], ROOT)
    ent = S.setdefault(key, {})
    out = []
    for side, lk, ak in (("buy", "buy_floor", "accum_buys"), ("sell", "sell_ceiling", "accum_sells")):
        lim = float(st.get(lk) or 0)
        rec = ent.get(side)
        if lim <= 0:
            if rec is not None:
                ent.pop(side, None)                    # الإيقاف خلص ⇒ الإيقاف الجاي يبدي من الصفر
                _ACCX["dirty"] = True
            continue
        if not isinstance(rec, dict) or abs(float(rec.get("lim") or 0) - lim) > lim * 1e-9:
            rec = {"lim": lim, "k": []}                # إيقاف جديد (أو الحد تغيّر)
            ent[side] = rec
            _ACCX["dirty"] = True
        have = {f"{float((v or {}).get('target_price') or 0):.10g}" for v in (st.get(ak) or {}).values()}
        seen = [x for x in (rec.get("k") or []) if x in have]   # درجة طلعت من المخزن ⇒ تنتسى
        if len(seen) != len(rec.get("k") or []):
            rec["k"] = seen
            _ACCX["dirty"] = True
        if cp <= 0:
            continue
        lv = _accx_levels(b, st, side, cp)
        new = {f"{p:.10g}" for p, _ in lv} - set(seen)
        if not new:
            continue
        try:
            m = _accx_msg(b, side, lv, len(new), lim, cp)   # الرسالة أول — لو فشلت، الدرجات ما تنعلّم «مبلّغة»
        except Exception:
            continue
        rec["k"] = seen + sorted(new)
        _ACCX["dirty"] = True
        out.append(m)
    if not ent:
        S.pop(key, None)
    return out


