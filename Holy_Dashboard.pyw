        items = [(kk, s) for kk, (s, _) in sig.items()] + [("vote", 1.0 if vk in ("su", "u") else -1.0 if vk in ("sd", "d") else 0.0)]
        for kk, s in items:
            if abs(s) < 0.15:
                continue
            x = e["a"].setdefault(kk, [0, 0, 0, 0, 0, 0])
            x[4] = x[4] or T[t]
            x[5] = T[t]
            if s > 0:
                x[0] += 1; x[2] += 1 if upm else 0
