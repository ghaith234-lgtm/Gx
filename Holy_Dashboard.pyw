#splash .btile{width:clamp(96px,26vw,150px);height:auto;filter:drop-shadow(0 18px 38px rgb(0 0 0/.42));animation:spTile .75s cubic-bezier(.2,.9,.25,1.25) both}
#splash .btile .lip path,#splash .btile .ink path,#splash .btile .ink2 path{stroke-dasharray:1;stroke-dashoffset:1;animation:spDraw .62s cubic-bezier(.5,0,.2,1) forwards}
#splash .btile .l1{animation-delay:.38s!important}#splash .btile .l2{animation-delay:.5s!important}
#splash .btile .b1{animation-delay:.72s!important}#splash .btile .b2{animation-delay:.84s!important}#splash .btile .br{animation-delay:1s!important;animation-duration:.5s!important}
#splash .btile .tsh{opacity:0;animation:spFade .7s ease 1.25s forwards}
#splash .sp-word{width:min(86vw,600px);line-height:0}
#splash .bword{width:100%;height:auto;stroke-width:6.2;clip-path:inset(0 100% 0 0);animation:spWipe .85s cubic-bezier(.6,0,.2,1) 1s forwards}
#splash .bword .bink{stroke:var(--spInk,#ece7ff)}#splash .bword .bsh{stroke:#000;opacity:.55}
@keyframes spDraw{to{stroke-dashoffset:0}}
