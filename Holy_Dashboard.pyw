def edit_bot(b, data):
    upd, restart_needed = {}, False
    if data.get("grid_pct") not in (None, ""):
        upd["grid_percentage"] = float(data["grid_pct"]) / 100.0
    if data.get("usd_value") not in (None, ""):
        upd["usd_value"] = float(data["usd_value"])
    if data.get("min_price") not in (None, ""):
        upd["min_price"] = float(data["min_price"])
    if data.get("forced_base") not in (None, ""):
        upd["forced_base_price"] = float(data["forced_base"])
    if data.get("wallet"):
        k = wallet_keys(data["wallet"])
        if not k:
            return {"ok": False, "msg": "محفظة غير معروفة"}
        upd.update(k); restart_needed = True
    if not upd:
        return {"ok": False, "msg": "لا يوجد ما يُعدَّل"}
    write_cfg_keys(b["cfg_path"], upd)
    msg = "✏️ حُفظت الإعدادات — تُطبَّق مباشرة (البوت يقرؤها كل ثانية)"
    if "grid_percentage" in upd:
        msg += ". النسبة الجديدة للأوامر الجديدة؛ لإعادة رسم السلم كله استخدم إعادة البناء ♻️"
    if restart_needed:
        sp, _, _ = paths_of(b)
        if is_alive(b["dir"], sp)[0]:
            stop_bot(b, disable_auto=False); time.sleep(0.6); launch(b)
            msg += ". استُبدلت المفاتيح وأُعيد تشغيل البوت 🔄"
        else:
            msg += ". ستُطبَّق المفاتيح الجديدة عند التشغيل"
    return {"ok": True, "msg": msg}

def rebuild(b):
    sp, _, _ = paths_of(b)
    was_alive = is_alive(b["dir"], sp)[0]
    stop_bot(b, disable_auto=False)
    time.sleep(0.8)
    for f in glob.glob(os.path.join(b["dir"], "grid_state_*")):
        try: os.remove(f)
        except Exception: pass
    ok, msg = launch(b) if was_alive or True else (True, "")
    tg_send(f"♻️ *إعادة بناء* — `{b['symbol']}` سيرسم شبكة جديدة من السعر الحالي")
    return {"ok": ok, "msg": "♻️ مُسحت الذاكرة وانطلق البوت ببناء شبكة جديدة" if ok else msg}

def _gone_archive(b):
    """🗃️ v3.22.2: لحظة الحذف — أرقام البوت الكلية تنحفظ (المحرر · 💠 داخل الأوامر · 💠 للمُراكِم · ربح العملة) ⇒ الإجماليات ما تنقص.
    قبلها نلحّق الدفترين وأرشيف إعادة الاستثمار حتى آخر ربح ينحسب بيومه."""
    c0 = b.get("cfg") or {}
    if c0.get("is_demo"):
        return
    _safe(ledger_tick, default=None)
    _safe(coin_ledger_tick, default=None)
    _safe(reinvest_tick, default=None)
    st = _safe(load_json, paths_of(b)[0], default={}) or {}
    bt = c0.get("bot_type") or "grid"
    key = os.path.relpath(b["dir"], ROOT)
    base = str(b["symbol"]).split("-")[0].upper()
    e = {"key": key, "sym": b["symbol"], "type": bt, "ts": time.time(), "rel": 0.0, "held": 0.0, "handoff": 0.0, "coin": {}}
    if bt == "dca":
        e["coin"] = {base: round(float(st.get("total_coin_profit") or 0), 10)}
    elif bt == "dca_buy":
        e["rel"] = round(float(st.get("total_coin_profit") or 0), 8)
    elif bt in _REC_T:                                     # 🔁 الدوري: المحرر بالدولار · 💠 الشرائي اللي بقى داخله (العملات بدفتر العملات)
        e["rel"] = round((float(st.get("rel_total") or 0) if bt in _REC_USD else 0.0) + float(st.get("wd_usd") or 0), 8)
        if bt in _REC_USD:
            e["held"] = round(_rec_held(st), 8)
    else:
        e["rel"] = round(float(st.get("total_profit") or 0) * _safe(net_factor, b, default=1.0), 8)
        rs = _safe(_ri_state_of, st, default=None)
        if rs:
            e["held"], e["handoff"] = round(rs["held"], 8), round(rs["handoff"], 8)
    if not (e["rel"] or e["held"] or e["handoff"] or any(e["coin"].values())):
        return
    g = load_json(GONE) or {}
    if not isinstance(g, dict):
        g = {}
    g.setdefault("bots", {})[f"{key}@{int(e['ts'])}"] = e
    save_json_atomic(GONE, g)


