def _open_app_window(url):
    """يفتح كروم/إيدج بوضع التطبيق (--app): نافذة نظيفة مستقلة، وإغلاقها يُنهي العملية فنراقبها"""
    import glob as _glob
    cands = []
    if os.name == "nt":
        pf = os.environ.get("ProgramFiles", r"C:\Program Files")
        pfx = os.environ.get("ProgramFiles(x86)", r"C:\Program Files (x86)")
        local = os.environ.get("LOCALAPPDATA", "")
        for base in (pf, pfx):
            cands.append(os.path.join(base, "Google", "Chrome", "Application", "chrome.exe"))
            cands.append(os.path.join(base, "Microsoft", "Edge", "Application", "msedge.exe"))
            cands.append(os.path.join(base, "BraveSoftware", "Brave-Browser", "Application", "brave.exe"))
        if local:
            cands.append(os.path.join(local, "Google", "Chrome", "Application", "chrome.exe"))
    else:
        cands = ["/usr/bin/google-chrome", "/usr/bin/chromium", "/usr/bin/chromium-browser", "/usr/bin/microsoft-edge"]
    exe = next((c for c in cands if os.path.exists(c)), None)
    if not exe:
        exe = shutil.which("chrome") or shutil.which("google-chrome") or shutil.which("msedge") or shutil.which("chromium")
    if not exe:
        return None
    try:
        prof = os.path.join(ROOT, ".holy_browser_profile")
        # GUI: لا CREATE_NO_WINDOW (يمنع ظهور النافذة تحت pythonw عند الدبل-كلك)
        return subprocess.Popen([exe, f"--app={url}", f"--user-data-dir={prof}",
                                 "--new-window", "--no-first-run", "--no-default-browser-check",
                                 "--window-size=1340,880"])
    except Exception:
        return None

def health_scan():
    """🩺 فحص شامل — **قراءة فقط**، ولا يكتب ولا يلمس ملف بوت أبداً.

    يجمع كل الفحوصات المتفرقة بحكم واحد: عمليات يتيمة · تباين أوامر ·
    حوالات معلّقة · تغطية · بصمات المحركات · مكتبات · ملفات حالة قديمة."""
    R = {"crit": [], "warn": [], "info": [], "bots": 0}
    try:
        for pkg, mod, why in PKGS:
            if pkg == "pywebview":
                continue
            try:
                importlib.import_module(mod)
            except Exception:
                R["crit"].append(f"مكتبة ناقصة: {pkg} — اضغط 🧰 وتنصيب الناقص")
    except Exception:
        pass
    try:
        bl = list(bot_dirs().values())
    except Exception as e:
        R["crit"].append(f"تعذّر مسح مجلدات البوتات: {type(e).__name__}")
        return R
    R["bots"] = len(bl)
    for b in bl:
        sym = b.get("symbol", "?")
        try:
            sp = paths_of(b)[0]
            st = load_json(sp) or {}
            alive, how = is_alive(b["dir"], sp)
            # عمليات متعددة لنفس المجلد
            try:
                pids = bot_pids(b["dir"])
                if len(pids) > 1:
                    R["crit"].append(f"{sym}: {len(pids)} عملية لنفس المجلد — أوقفه وشغّله")
            except Exception:
                pass
            # 🕰️ سكون طويل: المحرك يكتب عند الأحداث فقط — فالملف القديم
            #    طبيعي بسوق هادئ. نقارن بأحدث نشاط (حالة أو سجل) وبعتبة عالية.
            try:
                hp2 = paths_of(b)[1]
                last = os.path.getmtime(sp)
                try:
                    last = max(last, os.path.getmtime(hp2))
                except Exception:
                    pass
                hrs = (time.time() - last) / 3600.0
                if alive and hrs > 12:
                    R["warn"].append(f"{sym}: ولا حركة من {hrs:.0f} ساعة — "
                                     f"إما أن السوق هادئ أو أن المحرك متوقف · راجع سجله")
                elif not alive and (st.get("limit_buys") or st.get("limit_sells")):
                    R["warn"].append(f"{sym}: متوقف وعنده أوامر حية بالمنصة")
            except Exception:
                pass
            # المحرك على القرص
            try:
                if _eng_old(b):
                    R["warn"].append(f"{sym}: محرك المجلد قديم — اضغط 🧬")
            except Exception:
                pass
            # إعادة الاستثمار
            ri = _safe(reinvest_snapshot, b, st, default=None) or {}
            if ri.get("desync"):
                R["crit"].append(f"{sym}: {len(ri['desync'])} أمر حجمه لا يطابق الدفتر")
            if ri.get("handoff_stuck"):           # 🪙 عالقة فعلاً (مو مسجّلة بدفتر المُراكِم ومضى عليها +30 دقيقة)
                R["crit"].append(f"{sym}: حوالة عملة معلّقة لم يستلمها المُراكِم (+30 دقيقة)")
            if ri.get("on") != ri.get("cfg_on") and (ri.get("on") or ri.get("cfg_on")):
                R["warn"].append(f"{sym}: حالة إعادة الاستثمار لا تطابق التهيئة")
            if ri.get("file_old"):
                R["warn"].append(f"{sym}: نسخة قديمة من reinvest.py — أعد التشغيل")
            # التعادل
            try:
                fe = _safe(okx_fee_rate, b, default=None)
                g = _cycle_step(b["cfg"])                 # 📐 v3.36.3: ربح الدورة (البلس: بُعد الشراء)
                if fe and g > 0:
                    be = 2 * fe["maker"] / (1 - fe["maker"])
                    if g <= be:
                        R["crit"].append(f"{sym}: خطوة {g*100:.3f}% تحت التعادل "
                                         f"{be*100:.3f}% — كل دورة تخسر")
            except Exception:
                pass
            # التغطية
            try:
                cv = _safe(coverage_of, b, st, default=None)
                if cv and cv.get("cov_usdt") is not None and float(cv["cov_usdt"]) < 60:
                    R["warn"].append(f"{sym}: تغطية {cv['cov_usdt']}% — "
                                     f"يحتاج {cv.get('need_usdt')}$ والمتاح {cv.get('have_usdt')}$")
            except Exception:
                pass
        except Exception as e:
            R["warn"].append(f"{sym}: تعذّر الفحص ({type(e).__name__})")
    # 👛 التغطية الجماعية: البوتات اللي تتقاسم نفس المحفظة
    try:
        pools = {}
        for b in bl:
            st = load_json(paths_of(b)[0]) or {}
            cv = _safe(coverage_of, b, st, default=None)
            if not cv or cv.get("need_usdt") is None:
                continue
            w = _safe(wallet_id, b, default=None)
            key = f"w{w}" if w is not None else f"h{cv.get('have_usdt')}"
            p = pools.setdefault(key, {"need": 0.0, "have": float(cv.get("have_usdt") or 0), "n": 0})
            p["need"] += float(cv.get("need_usdt") or 0)
            p["have"] = max(p["have"], float(cv.get("have_usdt") or 0))
            p["n"] += 1
        for key, p in pools.items():
            if p["n"] < 2 or p["need"] <= 0:
                continue
            pct = p["have"] / p["need"] * 100.0
            if pct < 100:
                R["warn"].append(f"محفظة فيها {p['n']} بوت: التغطية الجماعية "
                                 f"{pct:.0f}% — مجموع الاحتياج {p['need']:.0f}$ "
                                 f"والمتاح {p['have']:.0f}$")
    except Exception:
        pass
    if not R["crit"] and not R["warn"]:
        R["info"].append(f"{R['bots']} بوت · ولا مشكلة")
    return R


def money_audit():
    """🧾 تدقيق حركة الأموال — كل سنت: من وين جا · وين راح · وشنو معلّق. قراءة فقط.

    لكل بوت: المحرر · 💠 بالحصّالات (ربح ورأس مال) · التفكيك المعلّق · المسلَّم للمُراكِم كعملة
    ⇒ إجمالي التداول (الهوية اللي مفحوصة بالمحاكاة لحد 0.1 مليم). ولكل تسليم بمعرّفه:
    المُراكِم استلم + الباقي بالمحفظة = المحرَّر **بالضبط**. وكل فحص ينكتب ✅/❌ بتفاصيله."""
    cfgs = _safe(acc_cfgs, default=[]) or []
    ast_ = _safe(acc_state, default={}) or {}
    seen = set(ast_.get("_ri_seen") or [])
    left_log = ast_.get("_ri_left_log") or {}
    bots, checks, ho_all = [], [], {}

    def chk(name, ok, detail=""):
        checks.append({"check": name, "ok": bool(ok), "detail": str(detail)})

    for b in bot_dirs().values():
        cfg = b.get("cfg") or {}
        if cfg.get("is_demo"):
            continue
        name = os.path.basename(str(b["dir"]).rstrip("/\\"))
        sym, bt = b["symbol"], cfg.get("bot_type") or "grid"
        base = sym.split("-")[0]
        st = _safe(load_json, paths_of(b)[0], default={}) or {}
        rec = {"bot": name, "sym": sym, "type": bt}
        if bt in ("dca", "dca_buy"):
            rec["dca"] = {k: st.get(k) for k in ("total_coin_profit", "cycles_done", "total_profit") if k in st}
            bots.append(rec)
            continue
        if bt in _REC_T:                                      # 🔁 الدوري: أرقامه + تسليمات عملته
            rec["rec"] = {k: st.get(k) for k in ("side", "mode", "profit_total", "rel_total", "ri_total", "pot", "wd_usd", "wd_coin",
                                                  "wd_lot_val", "wd_lot_q", "cycles", "orders", "skips", "dust", "paused",
                                                  "kind", "n_step", "tgt", "buy_usd", "sell_usd") if k in st}
            rec["rec"]["open_lots"] = len(st.get("lots") or [])
            _mine, why = _ri_eligible(b, cfgs)
            for h in _rec_handoffs_of(b, st):
                ho_all[h["id"]] = dict(h, bot=name, base=base, delivered=h["id"] in seen, waiting_reason="" if h["id"] in seen else why)
            bots.append(rec)
            continue
        nf = float(_safe(net_factor, b, default=1.0) or 1.0)
        tp = float(st.get("total_profit") or 0)
        rec.update(total_profit_engine=tp, nf=nf, released=round(tp * nf, 8),
                   locked_coin={dn: round(sum(float((v or {}).get("locked_qty") or 0)
                                              for v in (st.get(dn) or {}).values() if isinstance(v, dict)), 10)
                                for dn in ("limit_sells", "virtual_sells", "accum_sells")},
                   reserved_usd={dn: round(sum(float((v or {}).get("target_price") or 0) * float((v or {}).get("locked_qty") or 0)
                                               for v in (st.get(dn) or {}).values() if isinstance(v, dict)), 6)
                                 for dn in ("limit_buys", "virtual_buys", "accum_buys")})
        neg = ["total_profit"] if tp < -1e-9 else []
        ri = st.get("reinvest") if isinstance(st.get("reinvest"), dict) else None
        if ri:
            pot_gain = pot_cap = 0.0
            lvs = []
            for k, lv in (ri.get("levels") or {}).items():
                px, ub, gq = float(lv.get("px") or 0), float(lv.get("usd_book") or 0), float(lv.get("grown_qty") or 0)
                tot = ub + gq * px
                cap = min(max(0.0, float(lv.get("inj_book") or 0) + float(lv.get("inj_grown") or 0)), max(0.0, tot))
                pot_gain += max(0.0, tot - cap)
                pot_cap += cap
                if ub < -1e-9 or gq < -1e-12:
                    neg.append(f"level {k}")
                lvs.append({"k": k, "px": px, "base": float(lv.get("base_qty") or 0), "grown": gq, "usd_book": ub,
                            "value": round(tot, 8), "capital": round(cap, 8), "cycles": int(lv.get("cycles") or 0)})
            uw = [dict({"k": k}, **{x: e.get(x) for x in ("side", "base_qty", "grown_qty", "px", "inj", "ts", "miss")})
                  for k, e in (ri.get("unwind") or {}).items() if isinstance(e, dict)]
            uw_pend = sum(max(0.0, float(u.get("grown_qty") or 0) * float(u.get("px") or 0) - float(u.get("inj") or 0)) for u in uw)
            _mine, why = _ri_eligible(b, cfgs)
            hos = [{"id": h["id"], "coin": float(h.get("coin") or 0), "avg_px": float(h.get("avg_px") or 0),
                    "usd": float(h.get("usd") or 0), "ts": h.get("ts"), "why": h.get("why"), "level": h.get("level"),
                    "delivered": h["id"] in seen, "waiting_reason": "" if h["id"] in seen else why}
                   for h in _ri_handoffs_of(st)]
            for h in hos:
                ho_all[h["id"]] = dict(h, bot=name, base=base)
            orphan, ho_tot = float(ri.get("orphan_usd") or 0), float(ri.get("handoff_total") or 0)
            rec["reinvest"] = {"on": bool(ri.get("on")), "pct": ri.get("pct"), "cycles": ri.get("cycles"),
                               "levels": lvs, "pot_gain": round(pot_gain, 8), "pot_capital": round(pot_cap, 8),
                               "orphan_usd": orphan, "unwind": uw, "unwind_pending_usd": round(uw_pend, 8),
                               "handoffs": hos, "handoff_total_usd": ho_tot,
                               "unwound_usd": float(ri.get("unwound_usd") or 0),
                               "cap_coin_total": float(ri.get("cap_coin_total") or 0), "released_last": ri.get("released")}
            rec["identity"] = {"released_normal": round(tp * nf, 8), "pot_gain": round(pot_gain, 8), "orphan": orphan,
                               "unwind_pending": round(uw_pend, 8), "handoff_total": ho_tot,
                               "trading_total": round(tp * nf + pot_gain + orphan + uw_pend + ho_tot, 8)}
            q_usd = sum(h["coin"] * h["avg_px"] for h in hos)     # «usd» بالخانة القديمة = دولار التحرير كله، مو قيمة العملة
            chk(f"{name}: مجموع التسليمات بالطابور ≤ إجمالي المسلَّم", q_usd <= ho_tot + 1e-6, f"{q_usd:.6f} ≤ {ho_tot:.6f}")
            miss = [u["k"] for u in uw if int(u.get("miss") or 0) >= 120]
            chk(f"{name}: كل أمر مكبّر معلّق موجود في أوامر البوت", not miss, f"غير موجودة: {miss}" if miss else f"{len(uw)} معلّق")
            wait = [h for h in hos if not h["delivered"]]
            chk(f"{name}: ولا تسليم عملة ينتظر", not wait,
                "؛ ".join(f"{h['coin']:.8f} — {h['waiting_reason'] or 'بالطريق'}" for h in wait))
        chk(f"{name}: لا رقم سالب في الحالة", not neg, str(neg) if neg else "")
        bots.append(rec)
    accs, got = [], {}
    for a in cfgs:
        e = ast_.get(a.get("id")) or {}
        buys = [x for x in (e.get("buys") or []) if isinstance(x, dict)]
        rib = [x for x in buys if x.get("why") == "إعادة استثمار"]
        for x in rib:
            if x.get("hid"):
                got.setdefault(x["hid"], []).append(float(x.get("qty") or 0))
        coin, spent = float(e.get("coin") or 0), float(e.get("spent") or 0)
        accs.append({"id": a.get("id"), "name": a.get("name"), "symbol": a.get("symbol"), "pct": a.get("pct"),
                     "coin_pct": a.get("coin_pct"), "enabled": a.get("enabled", True), "coin": coin, "spent": spent,
                     "avg": round(spent / coin, 10) if coin > 0 else 0, "pool": e.get("pool"), "reserve": e.get("pending"),
                     "n_buys": len(buys), "reinvest_qty": round(sum(float(x.get("qty") or 0) for x in rib), 10),
                     "reinvest_usd": round(sum(float(x.get("usd") or 0) for x in rib), 8),
                     "reinvest_no_id": sum(1 for x in rib if not x.get("hid")),
                     "days": dict(sorted((e.get("days") or {}).items())[-14:])})
    for hid, h in ho_all.items():
        if not h["delivered"] or hid not in got:
            continue                           # قبل v3.15 سجل المُراكِم ما كان يحمل المعرّف
        q, lf = sum(got[hid]), float(left_log.get(hid) or 0)
        chk(f"تسليم {hid}: المُراكِم + المحفظة = المحرَّر", abs(q + lf - h["coin"]) < 1e-8 and len(got[hid]) <= max(1, len(cfgs)),
            f"{q:.10f} + {lf:.10f} = {h['coin']:.10f} · {len(got[hid])} سطر")
    for hid in got:
        if hid not in ho_all:
            checks.append({"check": f"تسليم {hid}", "ok": True, "detail": "انقص من طابور البوت (أقدم من 200) — معلومة"})
    g = _safe(_gd_load, default={}) or {}
    ev = [{"sev": e.get("sev"), "title": e.get("title"), "detail": e.get("detail")} for e in (g.get("events") or [])
          if e.get("status") == "open"]
    bad = [c for c in checks if not c["ok"]]
    return {"ts": time.time(), "version": APP_VERSION, "bots": bots, "accumulators": accs,
            "accumulator_left_by_coin": ast_.get("_ri_left") or {}, "guard_open": ev,
            "checks": checks, "summary": {"ok": len(checks) - len(bad), "bad": len(bad)}}


def _money_audit_md(A=None):
    """قسم التقرير التشخيصي: تدقيق حركة الأموال."""
    A = A or money_audit()
    S = A["summary"]
    o = ["", "## 💰 تدقيق حركة الأموال (تلقائي — كل سنت)",
         f"**{S['ok']} فحص سليم · {S['bad']} فحص فيه مشكلة** · التفاصيل الكاملة بـ`money_audit.json` بالحزمة", ""]
    rows = [b for b in A["bots"] if b.get("identity")]
    if rows:
        o += ["| البوت | المحرر | 💠 بالحصّالات | معلّق تفكيك | سُلّم للمُراكِم | = إجمالي التداول | تسليمات تنتظر |",
              "|---|---|---|---|---|---|---|"]
        for b in rows:
            i, r = b["identity"], b["reinvest"]
            o.append(f"| {b['bot']} ({b['sym']}) | {i['released_normal']:.4f} | {i['pot_gain'] + i['orphan']:.4f} | "
                     f"{i['unwind_pending']:.4f} ({len(r['unwind'])}) | {i['handoff_total']:.4f} | **{i['trading_total']:.4f}** | "
                     f"{sum(1 for h in r['handoffs'] if not h['delivered'])} |")
    for a in A["accumulators"]:
        o.append(f"- 🪙 مُراكِم {a['name']}: {a['coin']:.8f} بكلفة {a['spent']:.4f}$ (معدل {a['avg']:.8f}) · "
                 f"منها من إعادة الاستثمار {a['reinvest_qty']:.8f} ({a['reinvest_usd']:.4f}$) · نسبة العملة {a['coin_pct']}%")
    bad = [c for c in A["checks"] if not c["ok"]]
    if bad:
        o += ["", "### ❌ فحوص فيها مشكلة"] + [f"- {c['check']} — {c['detail']}" for c in bad]
    return "\n".join(o)



def _diag_bot_checks(b, st, hist):
    """🧾 فحوص محسوبة لبوت — تنقرا بلا تشغيل شي (للتشخيص)."""
    out = {"symbol": (b.get("cfg") or {}).get("symbol") or b.get("symbol")}
    try:
        _es, _en, _ev = engine_for(b.get("cfg") or {})      # 🧬 المحرك المتوقع **حسب نوع البوت** (لانهائية · مدى · بلس · DCA)
        mp = os.path.join(b["dir"], _en)
        out["bot_type"] = (b.get("cfg") or {}).get("bot_type") or "grid"
        out["engine_fp"] = str(_file_fp(mp)) if os.path.exists(mp) else None
        out["engine_expected"] = _ev
        out["engine_match"] = out["engine_fp"] == _ev
        rp = os.path.join(b["dir"], "reinvest.py")
        out["reinvest_fp"] = str(_file_fp(rp)) if os.path.exists(rp) else None
        out["reinvest_expected"] = REINV_VERSION
        out["reinvest_match"] = out["reinvest_fp"] == REINV_VERSION if out["reinvest_fp"] else None
    except Exception as e:
        out["fp_error"] = f"{type(e).__name__}: {e}"
    cnt = lambda dn: len(st.get(dn) or {})
    qty = lambda dn: round(sum(float((v or {}).get("locked_qty") or 0) for v in (st.get(dn) or {}).values() if isinstance(v, dict)), 8)
    out["orders"] = {dn: {"n": cnt(dn), "qty": qty(dn)} for dn in ("limit_buys", "limit_sells", "virtual_buys", "virtual_sells", "accum_buys", "accum_sells")}
    out["sell_claims"] = round(qty("limit_sells") + qty("virtual_sells") + qty("accum_sells"), 8)
    out["engine_v2"] = {k: st.get(k) for k in ("fee_dust", "nocoin_n", "nocoin_until", "inv_sold_total")}
    out["engine_v2"]["sell_wait"] = len(st.get("sell_wait") or {})
    ri = st.get("reinvest") if isinstance(st.get("reinvest"), dict) else None
    if ri:
        lv = ri.get("levels") or {}
        out["reinvest"] = {"on": bool(ri.get("on")), "pct": ri.get("pct"), "levels": len(lv),
                           "usd_book": round(sum(float(v.get("usd_book") or 0) for v in lv.values()), 6),
                           "grown_value": round(sum(float(v.get("grown_qty") or 0) * float(v.get("px") or 0) for v in lv.values()), 6),
                           "capital": round(sum(float(v.get("inj_book") or 0) + float(v.get("inj_grown") or 0) for v in lv.values()), 6),
                           "unwind": {k: {x: e.get(x) for x in ("side", "grown_qty", "px", "inj", "tries", "ts")} for k, e in (ri.get("unwind") or {}).items()},
                           "handoffs_pending": len(_ri_pending_handoffs(st, 0.0)), "handoffs_stuck": len(_ri_pending_handoffs(st, 1800.0)),
                           "handoffs_logged": len(_ri_handoffs_of(st)),
                           "cap_coin_total": ri.get("cap_coin_total"), "inj_coin_total": ri.get("inj_coin_total"),
                           "released": ri.get("released"), "handoff_total": ri.get("handoff_total")}
    tags = [t for t, _s, _w in _GD_TR_WARN] + ["🩹", "🛟", "🧩", "⚡ [تجميع", "💰 [ربح تعويضي]", "[تفكيك]", "بوقت مناسب", "[تحرير ربح داخلي]", "[حقن]", "[سحب]"]
    msgs = [str((h or {}).get("msg") or "") for h in (hist or [])[:3000]]
    out["log_counts_last3000"] = {t: sum(1 for m in msgs if t in m) for t in tags}
    out["last_trade"] = st.get("last_trade")
    out["total_profit"] = st.get("total_profit")
    return out


def _diag_exchange():
    """🔌 صورة المنصة لكل محفظة (قراءة فقط): الأوامر المفتوحة والأرصدة — **ولا حرف من المفاتيح**."""
    res = {}
    for wid, W in (_safe(_gd_wallets, default={}) or {}).items():
        rec = {"bots": [os.path.basename(str((x or {}).get("dir") or x)) if isinstance(x, dict) else str(x) for x in (W.get("bots") or [])]}
        try:
            pend, pc = _gd_pages("/api/v5/trade/orders-pending?instType=SPOT&limit=100", W["keys"], "ordId")
            rec["orders"] = [{k: o.get(k) for k in ("ordId", "instId", "side", "px", "sz", "accFillSz", "state", "clOrdId")} for o in (pend or [])]
        except Exception as e:
            rec["orders_error"] = f"{type(e).__name__}: {e}"
        try:
            r = _okx_get("/api/v5/account/balance", *W["keys"])
            rec["balance"] = [{k: d.get(k) for k in ("ccy", "cashBal", "availBal", "frozenBal")}
                              for d in (((r or {}).get("data") or [{}])[0].get("details") or [])
                              if float(d.get("cashBal") or 0) or float(d.get("frozenBal") or 0)]
        except Exception as e:
            rec["balance_error"] = f"{type(e).__name__}: {e}"
        res[wid] = rec
    return res


def books_audit():
    """🧮 v3.22.6: تدقيق الحسابات (قراءة فقط) — كل رقم مقابل مصدره، للتقرير التشخيصي.
    ❌ = تناقض داخلي لازم ما يصير أبداً · ⚠️ = يستاهل نظرة · ℹ️ = مقارنة للمعلومة."""
    C = []
    def add(name, ok, detail, lv=None):
        C.append({"check": name, "ok": bool(ok), "level": lv or ("ok" if ok else "err"), "detail": detail})
    near = lambda a, b, e=1e-4: abs(float(a or 0) - float(b or 0)) <= e
    today = datetime.now().strftime("%Y-%m-%d")
    since = _books_since()
    add("بداية الدفاتر", True, f"من {since}" if since else "من أول تشغيل (لم تُضغط «بداية جديدة»)", "info")
    led = load_json(LEDGER) or {}
    tb = _safe(trade_book, True, default={}) or {}
    pv = _safe(profit_view, 400, False, default={}) or {}
    T = pv.get("tot") or {}
    add("الإجمالي بالشريط = تقرير كل التاريخ", near(tb.get("trade_all"), T.get("t")) and near(tb.get("rel_all"), T.get("led")),
        f"تداول {tb.get('trade_all')} / {T.get('t')} · محرر {tb.get('rel_all')} / {T.get('led')}")
    rows_t = sum(float(b.get("t") or 0) for b in pv.get("bots") or [])
    days_t = sum(float(d.get("t") or 0) for d in pv.get("days") or [])
    add("مجموع صفوف البوتات = مجموع الأيام = الإجمالي", near(rows_t, T.get("t"), 1e-3) and near(days_t, T.get("t"), 1e-3),
        f"صفوف {rows_t:.6f} · أيام {days_t:.6f} · إجمالي {T.get('t')}")
    # 🧹 v3.26.7: انشال فحص «تقرير تيليغرام = لوحة التقارير» بطلبك — كان إنذار كاذب: يقارن يوم وحد ويّا «أسبوع» اللوحة لما الدفاتر أطول من 62 يوم
    #    (الاثنين من نفس المحرّك `_pv_per_rows` — اليوم بيوم متطابقين بالضبط)
    ri = _ri_keyset(((load_json(RI_LEDGER) or {}).get("bots") or {}))
    nori_bad = [b["k"] for b in pv.get("bots") or [] if b["k"] not in ri and b.get("type") not in ("dca_buy",) + _REC_T and b["k"] != _RI_LEGACY_K
                and not near(b.get("t"), b.get("led"), 1e-6)]
    add("بوت بلا إعادة استثمار: التداول = المحرر بالضبط", not nori_bad, "كلها" if not nori_bad else f"تختلف: {nori_bad}")
    for b in pv.get("bots") or []:
        if b["k"] in ri:
            st = None
            for bd in bot_dirs().values():
                if os.path.relpath(bd["dir"], ROOT) == b["k"]:
                    st = _safe(load_json, paths_of(bd)[0], default={})
            rs = _safe(_ri_state_of, st or {}, default=None) or {"held": 0.0, "handoff": 0.0}
            gap = float(b.get("t") or 0) - (float(b.get("led") or 0) + rs["held"] + rs["handoff"])
            add(f"هوية إعادة الاستثمار — {b.get('name')}", abs(gap) < 0.05 + 0.01 * abs(float(b.get('t') or 0)),
                f"تداول {b.get('t'):.4f} ≈ محرر {b.get('led'):.4f} + داخل الأوامر {rs['held']:.4f} + للمُراكِم {rs['handoff']:.4f} (فرق {gap:+.4f} — يكبر إذا كانت الدفاتر أقصر من عمر البوت)", "ok" if abs(gap) < 0.05 + 0.01 * abs(float(b.get('t') or 0)) else "warn")
    for bd in bot_dirs().values():
        c0 = bd.get("cfg") or {}
        if c0.get("is_demo") or c0.get("bot_type") in _NONGRID:
            if str(c0.get("bot_type") or "") in _REC_T:
                for _n, _ok, _d, _lv in (_safe(_rec_audit, bd, led, default=[]) or []):    # 🔁 الدوري: هوية إعادة الاستثمار + الدفتر
                    add(_n, _ok, _d, _lv)
            continue
        k = os.path.relpath(bd["dir"], ROOT)
        st = _safe(load_json, paths_of(bd)[0], default={}) or {}
        card = float(st.get("total_profit") or 0) * float(_safe(net_factor, bd, default=1.0))
        lsum = sum(float(v or 0) for v in ((led.get(k) or {}).get("daily") or {}).values())
        add(f"بطاقة البوت مقابل الدفتر — {bd.get('symbol')} ({k})", True,
            f"البطاقة (صافي) {card:.4f} · الدفتر {lsum:.4f} — يتساويان إذا كان الدفتر يغطي عمر البوت كله (بلا «بداية جديدة» وبلا إعادة بناء)", "info")
        neg = [d for d, v in ((led.get(k) or {}).get("daily") or {}).items() if float(v or 0) < -1e-9]
        if neg:
            add(f"يوم سالب بدفتر جرد — {k}", False, f"{neg}", "warn")
    cl = load_json(COIN_LEDGER) or {}
    for src in ("dca", "ri", "rec"):
        tot = {}
        for row in (cl.get("daily") or {}).values():
            for base, e in (row or {}).items():
                tot[base] = tot.get(base, 0.0) + float((e or {}).get(src) or 0)
        T2 = cl.get("total_" + src) or {}
        okc = all(near(tot.get(k2, 0), T2.get(k2, 0), 1e-8) for k2 in set(tot) | set(T2))
        add(f"دفتر العملات ({'DCA بيعي' if src == 'dca' else ('الدوري' if src == 'rec' else 'إعادة استثمار')}): الإجمالي = مجموع الأيام", okc, f"أيام {tot} · إجمالي {T2}")
    st_all = _safe(acc_state, default={}) or {}
    for a in _safe(acc_cfgs, default=[]) or []:
        e = st_all.get(a.get("id")) or {}
        days = e.get("days") or {}
        dp = e.get("dpct") or {}
        miss = []
        for n in range(1, 8):
            d = (datetime.now() - timedelta(days=n)).strftime("%Y-%m-%d")
            if (a.get("start") or "") > d or (since and d < since):
                continue
            prof = day_profit_w(d, acc_wid(a)) if acc_wid(a) else day_profit(d)     # 👛 ربح بوتات محفظته بس (مثل التوزيع)
            if prof <= 0:
                continue
            pc = float(dp.get(d, a.get("pct", 0)) or 0)
            if float(days.get(d) or 0) + 1e-6 < round(prof * pc / 100.0, 6):
                miss.append(f"{d}: {float(days.get(d) or 0):.4f} < {prof * pc / 100:.4f}")
        add(f"المُراكِم {a.get('name') or a.get('id')}: نصيبه من كل يوم منتهي", not miss, "كامل (آخر 7 أيام)" if not miss else " · ".join(miss), "ok" if not miss else "warn")
    for _n, _ok, _d in (_safe(profit_audit, default=[]) or []):      # 💰 v3.22.8
        add(_n, _ok, _d)
    for _n, _ok, _d, _lv in (_safe(_loss_audit, default=[]) or []):  # 📉 v3.25.4: سجل الخسائر
        add(_n, _ok, _d, _lv)
    errs = sum(1 for c in C if c["level"] == "err")
    warns = sum(1 for c in C if c["level"] == "warn")
    return {"ok": errs == 0, "errors": errs, "warnings": warns, "at": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
            "version": APP_VERSION, "books_since": since, "checks": C}


def _loss_audit():
    """🧮 v3.25.4: سجل الخسائر — كل خروج بخسارة بسجلات البوتات (من بداية السجل) انقرا · ولا خسارة مكررة"""
    L = _loss_load()
    if not L.get("since"):
        return [("📉 سجل الخسائر", True, "لم يبدأ بعد (يبدأ في أول جولة)", "info")]
    since, done = float(L["since"]), set(str(x) for x in (L.get("done") or []))
    ids = [str(x.get("id")) for x in (L.get("items") or []) if isinstance(x, dict)]
    miss = []
    now = time.time()
    for b in bot_dirs().values():
        bt = str((b.get("cfg") or {}).get("bot_type") or "")
        if (b.get("cfg") or {}).get("is_demo") or bt not in _LOSS_T:   # 📐 v3.32.0: من الجدول
            continue
        st = _safe(load_json, paths_of(b)[0], default={}) or {}
        for c in (st.get("cycles_log") or []):
            try:
                ts, p = float(c.get("ts") or 0), float(c.get("profit") or 0)
            except Exception:
                continue
            cid = ("dca:" if bt in ("dca", "dca_buy") else "rec:") + str(c.get("id"))
            if p < -1e-12 and ts >= since and now - ts > 300 and cid not in done:
                miss.append(cid)
    dup = len(ids) - len(set(ids))
    out = [("📉 سجل الخسائر: قُرئ كل خروج بخسارة", not miss, "كلها مسجّلة" if not miss else f"لم تُقرأ {len(miss)}: {miss[:3]}", "ok" if not miss else "err"),
           ("📉 سجل الخسائر: ولا خسارة مكررة", dup == 0, f"{len(ids)} خسارة" + (f" · {dup} مكررة" if dup else ""), "ok" if dup == 0 else "err")]
    return out


def books_audit_md(A):
    L = [f"# 🧮 تدقيق الحسابات — v{A.get('version')} · {A.get('at')}",
         f"**النتيجة:** {'✅ لا تناقض' if A.get('ok') else '❌ فيه تناقض'} · أخطاء {A.get('errors')} · تنبيهات {A.get('warnings')}", ""]
    ic = {"ok": "✅", "err": "❌", "warn": "⚠️", "info": "ℹ️"}
    for c in A.get("checks") or []:
        L.append(f"- {ic.get(c['level'], '•')} **{c['check']}** — {c['detail']}")
    return "\n".join(L)

