                out.append({"sym": b["symbol"], "base": base, "time": e.get("time", ""), "msg": e.get("msg", ""),
                            "dir": os.path.relpath(b["dir"], ROOT)})
    # 🪙 أحداث المُراكِمات (شراء · بيع · ترحيل · سحب)
    try:
        _st = acc_state()
        for _a in acc_cfgs():
            _e = _st.get(_a["id"]) or {}
            _nm = _a.get("name") or _a.get("symbol")
            _bs = str(_a.get("symbol", "")).split("-")[0]
            _sy = _a.get("symbol", "")
            def _add(lst, fmt, n=8):
                for _x in (lst or [])[:n]:
                    try:
                        out.append({"sym": _sy, "base": _bs,
                                    "time": datetime.fromtimestamp(_x["ts"]).strftime("%Y-%m-%d %H:%M:%S"),
                                    "msg": fmt(_x), "acc": True})
                    except Exception:
                        pass
            _add(_e.get("buys"), lambda x: (f"🪙 [{_nm}] شراء {x['qty']} {_bs} بـ {x['usd']}$ "
                                            f"@ {x['px']} ({x.get('why','آلي')})"))
            _add(_e.get("sells"), lambda x: (f"💰 [{_nm}] بيع {x['qty']} {_bs} بـ {x['usd']}$ "
                                             f"@ {x['px']} · ربح {x.get('profit',0):+.2f}$"))
            _add(_e.get("moves"), lambda x: f"📦 [{_nm}] نُقل {x['usd']}$ للمتراكم ({x.get('why','')})", 5)
            _add(_e.get("wlog"), lambda x: f"📤 [{_nm}] تحوّل {x['usd']}$ من المتراكم للصندوق النهائي", 5)
            _add(_e.get("cout"), lambda x: f"📤 [{_nm}] تحوّل {x['qty']} {_bs} من المخزون للصندوق النهائي", 5)
    except Exception:
        pass
    out.extend(dict(e) for e in list(DASH_EVENTS))       # 📦 v3.21.1: إشعارات اللوحة نفسها (عبور درجات الإيقاف)
    out.sort(key=lambda x: x.get("time", ""), reverse=True)
    return out[:limit]

def series_of(d):
    hist = list(reversed(history_of(d, 1500)))
    cum, line, daily = 0.0, [], {}
    for e in hist:
        m = PROFIT_RE.search(e.get("msg", "")) if isinstance(e, dict) else None
        if not m:
            continue
        v = float(m.group(1)); cum += v
        ts = str(e.get("time", ""))
        line.append({"t": ts, "v": round(cum, 4)})
        daily[ts[:10]] = round(daily.get(ts[:10], 0) + v, 4)
    return {"line": line[-400:], "daily": [{"d": k, "v": daily[k]} for k in sorted(daily)][-30:]}

