            ent["oid_b"] = [str(d.get("ordId") or d.get("clOrdId") or "") for d in ds if d.get("side") == "buy"]
            ent["oid_s"] = [str(d.get("ordId") or d.get("clOrdId") or "") for d in ds if d.get("side") == "sell"]
    for w in (app_cfg().get("wallets") or []):
        r = _okx_get("/api/v5/account/balance", w.get("api", ""), w.get("sec", ""), w.get("pass", ""))
        if not _scope_err("محفظة " + w.get("name", ""), r):
            WBAL[w.get("name", "")] = round(float(r["data"][0].get("totalEq") or 0), 2)
            coins = []
            _fs, _fn = 0.0, 0
            for d in (r["data"][0].get("details") or []):
                try:
                    usd = float(d.get("eqUsd") or 0)
                    bal = float(d.get("availBal") or d.get("cashBal") or 0)
                    tot = float(d.get("eq") or d.get("cashBal") or 0) or bal      # 🪙 v3.21.7: الكلي (حر + محجوز بأوامر)
                    lock = max(0.0, float(d.get("frozenBal") or 0))
                    if usd >= 0.5 or bal > 0 or tot > 0:
                        c = {"ccy": d.get("ccy"), "bal": round(bal, 6), "tot": round(tot, 8), "lock": round(lock, 8), "usd": round(usd, 2)}
                        f = _fx_coin(str(d.get("ccy") or ""), tot, usd)
                        if f:
                            c.update(fx=round(f["fx"], 2), pct=round(f["pct"], 2))
                            _fs += f["fx"]; _fn += 1
                        coins.append(c)
                except Exception:
                    continue
            coins.sort(key=lambda x: -x["usd"])
            WDET[w.get("name", "")] = coins[:40]
            WFX[w.get("name", "")] = {"usd": round(_fs, 2), "n": _fn}
    try:
        _bot_fx()
    except Exception:
        pass
    _px_ref_save()


