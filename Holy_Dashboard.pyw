function pcD(s){if(!s)return '—';const p=String(s).split('-');return (+p[2])+'/'+(+p[1])}
function pcStep(x){if(!(x>0))return 1;const e=Math.pow(10,Math.floor(Math.log10(x))),f=x/e;return (f<=1?1:f<=2?2:f<=5?5:10)*e}
function pcRT(x,y,w,h,r){r=Math.max(0,Math.min(r,w/2,h));const F=n=>n.toFixed(2);
  return `M${F(x)},${F(y+h)}V${F(y+r)}Q${F(x)},${F(y)} ${F(x+r)},${F(y)}H${F(x+w-r)}Q${F(x+w)},${F(y)} ${F(x+w)},${F(y+r)}V${F(y+h)}Z`}
function pcArc(cx,cy,r0,r1,a0,a1){const P=(r,a)=>[(cx+r*Math.sin(a)).toFixed(2),(cy-r*Math.cos(a)).toFixed(2)],lg=(a1-a0)>Math.PI?1:0;
  const[x0,y0]=P(r1,a0),[x1,y1]=P(r1,a1),[x2,y2]=P(r0,a1),[x3,y3]=P(r0,a0);
  return `M${x0},${y0}A${r1},${r1} 0 ${lg} 1 ${x1},${y1}L${x2},${y2}A${r0},${r0} 0 ${lg} 0 ${x3},${y3}Z`}
