/* 🃏 v3.26.8: كل الكروت بنفس النمط واللون — نفس الخلفية والحافة · نفس شارة النوع · نفس المربعات · نفس الحشوة */
.card.dca,.card.rec{background:var(--glass);border-color:var(--line)}
.card.dca:hover,.card.rec:hover{border-color:rgb(var(--vio-rgb)/.34)}
.card.dca .dcahead{padding:0}
.card.dca .dcabody{padding:12px 0 0}
.card .dcatag,.card .dcatag.rectag,.card .ctag{font-size:11px;background:rgb(var(--vio-rgb)/.12);color:var(--vio);border:1px solid rgb(var(--vio-rgb)/.3);padding:2px 9px;border-radius:99px;font-weight:600;white-space:nowrap}
.card.dca:not(.rec) .dcafill{background:linear-gradient(90deg,var(--cyan),var(--vio));box-shadow:0 0 8px rgb(var(--cyan-rgb)/.35)}
.card .rows{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));grid-auto-flow:row dense;gap:8px}
.card .row{display:grid;grid-template-columns:auto minmax(0,1fr);align-items:center;gap:3px 6px;background:rgb(var(--ov-rgb)/.03);border-radius:11px;padding:8px 10px;font-size:12px;min-width:0}
.card .row .ic{width:auto;font-size:12px}
.card .row .nm{font-size:10.5px;color:var(--mut2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.card .row>b{grid-column:1/-1;font-size:14px;min-width:0;max-width:none!important;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;text-align:right}
.card .row.wide{grid-column:1/-1}
/* 🃏 v3.26.9: شكل «C» — الأيقونة بدائرة والاسم والرقم جنبها · كل الأرقام بنفس الحجم · كل صف مربعين · المربع الوحيد ياخذ السطر كله */
.card .rows{gap:8px}
.card .row,.card .dcacell{display:grid;grid-template-columns:32px minmax(0,1fr);grid-template-rows:auto auto;column-gap:10px;row-gap:1px;align-items:center;
  padding:9px 11px;border-radius:15px;background:rgb(var(--ov-rgb)/.045);border:1px solid rgb(var(--ov-rgb)/.065);box-shadow:inset 0 1px 0 rgb(255 255 255/.045);min-width:0}
.card .row .ic,.card .dcacell .ic{grid-row:1/3;width:32px;height:32px;border-radius:50%;display:grid;place-items:center;
  background:radial-gradient(circle at 35% 30%,rgb(var(--vio-rgb)/.30),rgb(var(--cyan-rgb)/.10));font-size:14px;opacity:1}
.card .row .nm,.card .dcacell .dl{grid-column:2;align-self:end;font-size:10.5px;color:var(--mut2);margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.card .row>b,.card .dcacell b{grid-column:2;align-self:start;font-weight:700;font-size:14px!important;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.card .row.wide>b{font-size:13px!important}
.card .dcatop{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:8px}
.card .row.odd,.card .dcacell.odd{grid-column:1/-1}
