   (L0.asells||[]).slice().sort((a,z)=>z.p-a.p).forEach(x=>acc+=`<div class="vrow"><span class="dot" style="background:var(--amber)"></span><span class="p num">${f4(x.p)}</span><span class="q num">≈ $${(x.p*x.q).toFixed(2)}</span><span class="tag">📦 بيع</span></div>`)})(b.ladder);
