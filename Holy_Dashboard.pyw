def find_script(name):
    cand = os.path.join(ROOT, name)
    if os.path.exists(cand):
        return cand
    for d in glob.glob(os.path.join(ROOT, "*", name)):
        if "_archive" not in d:
            return d
    return None

def wallet_keys(name):
    for w in app_cfg().get("wallets", []):
        if w.get("name") == name:
            return {"api_key": w.get("api", ""), "secret_key": w.get("sec", ""), "passphrase": w.get("pass", "")}
    return None

def compute_dca_table(cfg, base_price):
    """📋 v3.22.1 (ح٥): جدول خطة DCA قبل النشر — **صافي بعد العمولة** بنفس حساب المحرك:
    الأساس ماركت (آخذ 0.1%) · الأمان ليمت (صانع 0.08% · بالدرع فوري آخذ 0.1%) · الإغلاق فوري (آخذ 0.1%).
    كل صف = لو السعر وصل لهالأمر ورجع للهدف: كم صرفت لحد هنا · متوسطك · سعر خروجك · كم لازم يرجع · ربحك الصافي."""
    try:
        base_qty = float(cfg.get("base_order_qty", 0))
        avg_qty = float(cfg.get("avg_order_qty", 0))
        first_dev = float(cfg.get("first_deviation", 0)) / 100.0
        step_mult = float(cfg.get("step_multiplier", 1))
        size_mult = float(cfg.get("size_multiplier", 1))
        n_safety = int(float(cfg.get("max_safety_orders", 0)))
        tp_raw = float(cfg.get("take_profit_pct", 0))
    except Exception:
        return []
    is_buy = str(cfg.get("bot_type") or cfg.get("dca_type") or "dca") == "dca_buy"  # 🎚️ اتجاه البوت
    trail = str(cfg.get("trail_on")).lower() in ("1", "true", "on", "yes")
    fee_min = 0.20
    fee_warn = tp_raw < fee_min
    tp_pct = max(tp_raw, fee_min) / 100.0
    if base_price <= 0 or base_qty <= 0 or n_safety < 0:
        return []
    f_lv = DCA_FEE_TAKER if trail else DCA_FEE_MAKER

    def _target(a):
        return a * (1 + tp_pct) if is_buy else a * (1 - tp_pct)

    rows = []
    cq = cv = cnet = 0.0
    cum_dev, step_dev, order_qty = 0.0, first_dev, avg_qty
    prev_px = base_price
    for i in range(0, n_safety + 1):
        if i == 0:
            price, q, fee, step = base_price, base_qty, DCA_FEE_TAKER, 0.0
        else:
            cum_dev += step_dev
            price = base_price * (1 - cum_dev) if is_buy else base_price * (1 + cum_dev)
            q, fee, step = order_qty, f_lv, step_dev * 100
            step_dev *= step_mult; order_qty *= size_mult
        cq += q; cv += price * q
        cnet += q * (1 - fee) if is_buy else price * q * (1 - fee)
        avg = cv / cq
        tgt = _target(avg)
        if is_buy:
            prof = cnet * tgt * (1 - DCA_FEE_TAKER) - cv
            gap = (tgt / price - 1) * 100
            prof_usd = prof
        else:
            prof = cnet / tgt * (1 - DCA_FEE_TAKER) - cq
            gap = (1 - tgt / price) * 100
            prof_usd = prof * tgt
        rows.append({"n": i, "label": "أساسي" if i == 0 else f"أمان {i}", "price": round(price, 10), "order_qty": round(q, 4),
                     "order_val": round(price * q, 2), "step": round(step, 3), "dev": round(cum_dev * 100, 3),
                     "cum_qty": round(cq, 4), "cum_vol": round(cv, 2), "avg": round(avg, 10), "target": round(tgt, 10),
                     "gap_pct": round(gap, 3), "exit_profit": round(prof, 4), "exit_usd": round(prof_usd, 4),
                     "gap": round(abs(tgt - avg), 10)})
        prev_px = price
    last, first = rows[-1], rows[0]
    cov = abs(last["price"] / base_price - 1) * 100
    exit_vals = [r["gap_pct"] for r in rows]
    summary = {
        "is_buy": is_buy, "trail": trail, "tp_used": round(max(tp_raw, fee_min), 3), "fee_warn": fee_warn,
        "coverage": round(cov, 3), "cov_warn": cov < 3.0,
        "capital_needed": round(last["cum_vol"], 2) if is_buy else round(last["cum_qty"], 4),
        "capital_usd": round(last["cum_vol"], 2),
        "max_exit": round(max(exit_vals), 3), "avg_exit": round(sum(exit_vals) / len(exit_vals), 3),
        "profit_base": first["exit_profit"], "profit_full": last["exit_profit"],
        "profit_full_usd": last["exit_usd"],
        "final_avg": last["avg"], "final_target": last["target"], "last_price": last["price"],
        "fee_maker": DCA_FEE_MAKER * 100, "fee_taker": DCA_FEE_TAKER * 100,
        # توافق مع الأسماء القديمة
        "drop_needed": round(last["gap_pct"], 3), "coin_profit": last["exit_profit"],
        "total_sold": last["cum_qty"], "total_usdt": last["cum_vol"],
    }
    return {"rows": rows, "summary": summary}


def compute_grid_range_table(cfg, cp):
    """يحسب جدول أوامر جرد النطاق قبل التشغيل: كل المستويات بين الحدّين،
    وكم USDT للشراء (تحت السعر) وكم عملة للبيع (فوق السعر) — ليكون المستخدم جاهزاً."""
    try:
        # النسبة قد تصل كـ grid_pct (نسبة مئوية) أو grid_percentage (كسر)
        if cfg.get("grid_pct") not in (None, ""):
            g = float(cfg.get("grid_pct")) / 100.0
        else:
            g = float(cfg.get("grid_percentage", 0))
        usd = float(cfg.get("usd_value", 0))
        lower = float(cfg.get("lower_price", 0) or 0)
        upper = float(cfg.get("upper_price", 0) or 0)
        base = float(cfg.get("forced_base_price", 0) or 0) or float(cp or 0)
    except Exception:
        return {"ok": False, "msg": "تأكد من الأرقام"}
    if g <= 0 or usd <= 0 or base <= 0:
        return {"ok": False, "msg": "النسبة والقيمة والسعر لازم أكبر من صفر"}
    if lower <= 0 and upper <= 0:
        return {"ok": False, "msg": "حدّد حداً أدنى أو أعلى (وإلا فهو إنفنتي بلا جدول محصور)"}
    if lower > 0 and upper > 0 and lower >= upper:
        return {"ok": False, "msg": "الحد الأدنى لازم أقل من الحد الأعلى"}

    import math as _m
    step = 1.0 + g
    MAXROWS = 300  # سقف أمان لكل جهة

    # ═══ جهة البيع: مستويات فوق السعر حتى الحد الأعلى ═══
    sells = []
    capped_sell = False
    if upper > 0:
        # أول درجة بيع = أقرب درجة سلم فوق base
        n = 1
        while True:
            price = round(base * (step ** n), 6)
            if price > upper + 1e-9:
                break
            if price > cp:  # بيع فعلي فوق السعر الحالي
                qty = usd * step / price          # كمية العملة لهذا الأمر
                sells.append({"n": n, "price": round(price, 6), "coin_qty": round(qty, 4),
                              "usdt_value": round(qty * price, 2)})
            n += 1
            if len(sells) >= MAXROWS:
                capped_sell = True
                break

    # ═══ جهة الشراء: مستويات تحت السعر حتى الحد الأدنى ═══
    buys = []
    capped_buy = False
    if lower > 0:
        n = 1
        while True:
            price = round(base * (step ** (-n)), 6)
            if price < lower - 1e-9:
                break
            if price < cp:  # شراء فعلي تحت السعر الحالي
                qty = usd / (price * step)         # كمية العملة (بحجم أمر ثابت)
                buys.append({"n": n, "price": round(price, 6), "coin_qty": round(qty, 4),
                             "usdt_cost": round(qty * price, 2)})
            n += 1
            if len(buys) >= MAXROWS:
                capped_buy = True
                break

    total_buy_usdt = round(sum(b["usdt_cost"] for b in buys), 2)
    total_sell_coin = round(sum(s["coin_qty"] for s in sells), 4)
    total_sell_value = round(sum(s["usdt_value"] for s in sells), 2)
    # ربح تقريبي لكل دورة شبكة = فرق الدرجة على حجم الأمر
    profit_per_grid = round(usd - usd / step, 4)  # ≈ usd × g/(1+g)

    return {
        "ok": True,
        "base_price": round(base, 6), "cp": round(float(cp or 0), 6),
        "grid_pct": round(g * 100, 4),
        "lower": round(lower, 6) if lower > 0 else None,
        "upper": round(upper, 6) if upper > 0 else None,
        "buys": buys, "sells": sells,
        "n_buys": len(buys), "n_sells": len(sells),
        "total_buy_usdt": total_buy_usdt,
        "total_sell_coin": total_sell_coin,
        "total_sell_value": total_sell_value,
        "profit_per_grid": profit_per_grid,
        "capped": capped_buy or capped_sell,
        "usd_value": round(usd, 2),
    }


