/* 📈 شريط الأسعار — أيقونة العملة من الإنترنت، ولو ما وصلت تطلع دائرة بالحرف */
function tkIcon(base){const b=String(base||'').toLowerCase().replace(/[^a-z0-9]/g,'');
  return `<img class="tki" src="https://assets.coincap.io/assets/icons/${b}@2x.png" alt="" loading="lazy"
    onerror="this.style.display='none';this.nextElementSibling.style.display='inline-flex'"><span class="tkl">${gEsc(String(base||'?').slice(0,1))}</span>`}
function fmtPx(v){v=+v||0;
  if(v>=1000)return v.toLocaleString('en-US',{maximumFractionDigits:2});
  if(v>=1)return v.toFixed(4).replace(/0+$/,'').replace(/\.$/,'');
  return v.toPrecision(4).replace(/0+$/,'').replace(/\.$/,'')}
function tapeSync(d){
  const T=d.ticker||{}, el=$('#tape'), inn=$('#tapein'); if(!el||!inn)return;
  const rows=T.rows||[];
  const coins=(T.coins&&T.coins.length)?T.coins:rows.map(r=>r.sym);
  if(!T.on||!coins.length){el.style.display='none'; liveWS(wsCoins([])); return}
  el.style.display='';
  const sig=coins.join(',');
  if(inn.dataset.sig!==sig){                       // ما نعيد البناء إلا لو تغيّرت العملات — حتى ما تتقطع الحركة
    const one=coins.map(s=>{const bs=String(s).split('-')[0];
      return `<span class="tk" data-s="${gEsc(s)}">${tkIcon(bs)}<b>${gEsc(bs)}</b><span class="tkp">—</span><i class="tkc">—</i></span>`}).join('');
    inn.innerHTML=one+one; inn.dataset.sig=sig;
    Object.entries(LIVE.last).forEach(([k,v])=>{if(Date.now()-v.ts<20000)livePx(k,v.px,v.chg)});
  }
  if(!TAPES.p)TAPES.p=new Tape(el,inn);
  TAPES.p.setLoop(Math.max(20,+T.speed||45));
  liveWS(wsCoins(coins));                           // ⚡ لحظي من المنصة مباشرة (الشريط + البوتات)
  for(const r of rows){
    const _lv=LIVE.last[r.sym]; if(_lv&&Date.now()-_lv.ts<20000)continue;   // اللحظي أحدث من السيرفر
    const up=(+r.chg||0)>=0;
    inn.querySelectorAll(`.tk[data-s="${(window.CSS&&CSS.escape)?CSS.escape(r.sym):r.sym}"]`).forEach(e=>{
      e.querySelector('.tkp').textContent=fmtPx(r.px);
      const c=e.querySelector('.tkc');
      c.textContent=(up?'▲ ':'▼ ')+Math.abs(+r.chg||0).toFixed(2)+'%';
      c.className='tkc '+(up?'up':'dn');
    });
  }
}

