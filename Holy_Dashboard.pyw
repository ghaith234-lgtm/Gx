def deploy_rec(data):
    """🔁 v3.25.0: ينشئ بوت دوري (شراء/بيع متكرر). الإعدادات تثبت من الإنشاء — من الكرت: إيقاف الأمر الدوري · ⚖️ نسبة إعادة الاستثمار · البيع · السحب."""
    sym = str(data.get("symbol", "")).strip().upper()
