def _ina_sq(D, S):
    """⚡ الانضغاط على شموع الساعة المسكّرة: شغّال هسه + من كم شمعة · أو خرج منه هسه (بعد ≥ 6 شموع) وباتجاه شنو"""
    sq = _safe(_fc_sq, D, S, default=None) or []
    C = D["c"]
    tc = len(C) - 2                                   # آخر شمعة مسكّرة (الأخيرة لسه تتكوّن)
    if tc < 25 or len(sq) <= tc:
        return None
    run = lambda e: next((e - j for j in range(e, -1, -1) if not sq[j]), e + 1)
    n_on = run(tc) if sq[tc] else 0
    prev = run(tc - 1) if (not sq[tc] and sq[tc - 1]) else 0
    m20 = sum(C[tc - 19:tc + 1]) / 20.0
    return {"on": bool(sq[tc]), "n": n_on, "rel": prev >= INA_SQ_MIN, "rel_n": prev, "d": "up" if C[tc] >= m20 else "dn", "t": D["t"][tc]}


def _ina_rel(R):
    """📏 صدق المعدل على نفس العملة: الحيّ (من لما شغّلت) لو ≥ 20 مرة · وإلا فحص آخر 12 يوم"""
