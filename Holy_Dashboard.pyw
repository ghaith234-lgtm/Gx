.stat .k{font-size:10.5px;color:var(--mut)}.stat .v{font-size:14.5px;font-weight:600;margin-top:3px}
.dgrid2{display:grid;grid-template-columns:1fr 1fr;gap:9px}
.histline{padding:8px 4px;border-bottom:1px dashed rgb(var(--vio-rgb)/.12);font-size:12.2px;line-height:1.7}
.histline .t{color:var(--mut2);font-size:10.3px;direction:ltr;display:inline-block}

/* ═══ نوافذ + توست ═══ */
.mbg{position:fixed;inset:0;z-index:120;background:rgb(var(--scrim-rgb)/.66);backdrop-filter:blur(8px);display:grid;place-items:center;padding:18px}
.modal{width:min(860px,97vw);max-height:94vh;overflow-y:auto;background:var(--modal-bg);
  border:1px solid rgb(var(--vio-rgb)/.3);border-radius:22px;padding:22px;box-shadow:0 30px 80px rgb(var(--sh-rgb)/.6);
  animation:pop .34s var(--pop)}
@keyframes pop{from{opacity:0;transform:scale(.94) translateY(14px)}to{opacity:1;transform:none}}
.modal h2{font-size:17px;margin-bottom:16px}
.mbtns{display:flex;gap:10px;justify-content:flex-start;margin-top:18px}
.belldot{position:absolute;top:3px;inset-inline-end:3px;width:8px;height:8px;border-radius:50%;background:var(--red);box-shadow:0 0 6px var(--red);animation:pp 1.4s infinite}
#bBell{position:relative}
#bFs[hidden]{display:none!important}   /* ⛶ v3.27.0: بس بالحاسوب (المتصفح · برنامج ويندوز) */
/* 🔔 v3.21.7: درج من اليمين بطول الشاشة — نص الشاشة (بالهاتف ~87%) */
#notifPanel{position:fixed;top:0;bottom:0;right:0;left:auto;z-index:150;width:min(640px,max(50vw,min(340px,92vw)));
  background:rgb(var(--surf-rgb)/.96);backdrop-filter:blur(22px) saturate(1.3);border-left:1px solid var(--line2);border-radius:20px 0 0 20px;
  display:flex;flex-direction:column;overflow:hidden;transform:translateX(105%);visibility:hidden;
  transition:transform .38s var(--ease),visibility 0s linear .38s;box-shadow:-24px 0 60px rgb(var(--sh-rgb)/.55);
  padding-top:env(safe-area-inset-top);padding-bottom:env(safe-area-inset-bottom)}
#notifPanel.on{transform:none;visibility:visible;transition:transform .38s var(--ease),visibility 0s}
#npScrim{position:fixed;inset:0;z-index:149;background:rgb(var(--scrim-rgb)/.5);opacity:0;pointer-events:none;transition:opacity .3s var(--ease)}
#npScrim.on{opacity:1;pointer-events:auto}
body.npopen{overflow:hidden}
.nphead{display:flex;align-items:center;gap:9px;padding:13px 16px;border-bottom:1px solid var(--line);font-weight:600;font-size:14px}
.npn{font-size:11px;background:var(--vio);color:var(--on-acc);border-radius:99px;padding:1px 8px;font-weight:700}
.npx{margin-inline-start:auto;width:30px;height:30px;border-radius:9px;display:grid;place-items:center;font-size:13px}
.npbody{flex:1;overflow-y:auto;padding:8px}
.npempty{text-align:center;color:var(--mut2);font-size:12.5px;padding:34px 16px}
.nitem{display:flex;gap:10px;padding:10px 11px;border-radius:11px;margin-bottom:5px;background:rgb(var(--ov-rgb)/.03);
  border:1px solid transparent;animation:nIn .35s var(--ease)}
.nitem:hover{border-color:var(--line)}
.nitem.fresh{border-color:var(--line2);background:rgb(var(--cyan-rgb)/.06)}
@keyframes nIn{from{opacity:0;transform:translateX(14px)}to{opacity:1;transform:none}}
.nicon{font-size:17px;flex:none;margin-top:1px}
.nbody{flex:1;min-width:0}
.ntext{font-size:12.5px;line-height:1.5;word-break:break-word}
.ntime{font-size:10px;color:var(--mut2);margin-top:3px;direction:ltr}
.npfoot{display:flex;align-items:center;justify-content:space-between;padding:10px 14px;border-top:1px solid var(--line)}
.npmute{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--mut);cursor:pointer}
.npmute input{accent-color:var(--vio);width:15px;height:15px}
#toast{pointer-events:none;position:fixed;bottom:26px;left:50%;transform:translateX(-50%) translateY(18px);z-index:200;
  background:rgb(var(--surf4-rgb)/.92);border:1px solid var(--line2);border-radius:14px;padding:11px 20px;font-size:13.5px;
  opacity:0;pointer-events:none;transition:opacity .3s,transform .38s var(--ease);backdrop-filter:blur(14px);max-width:90vw}
#toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
#toast.err{border-color:rgb(var(--red-rgb)/.5)}
@media (max-width:760px){.totals{order:3;width:100%;justify-content:center}.bench{width:42%}main{padding:14px;gap:13px}}
/* ═══ الشريط العلوي v3.10 — صف الهوية والأرقام والتشغيل، ثم صف البوتات والصفحات ═══ */
header{flex-direction:column;flex-wrap:nowrap;align-items:stretch;gap:9px;padding:10px 22px}
/* ⚠️ nowrap إلزامي: عمود متعدد الأسطر يأخذ عرض أعرض عنصر (الشريط اللي ما ينلف) فيطفح بالموبايل */
.hrow,nav.actions{min-width:0;max-width:100%}
.hrow{display:flex;align-items:center;gap:16px;flex-wrap:wrap}
.ops{display:flex;gap:6px;align-items:center}
.ops button{padding:7px 10px;font-size:14px;line-height:1.1}
nav.actions{align-items:center;gap:8px}
nav.actions .grp{display:flex;gap:7px;flex-wrap:wrap;align-items:center}
nav.actions .gsep{width:1px;height:24px;background:var(--line);margin:0 4px;flex:none}
/* ↔️ v3.21.7: صف بيه سحب ⇒ حافة باهتة بجهة الباقي + سهم ينبّه */
/* ↔️ v3.21.9: تلميح سحب خفيف — شفاف · ما ينلمس · يظهر بعد ثانيتين · يأشّر لجهة الأزرار الباقية (الصف نفسه مثل قبل) */
.navwrap{position:relative;min-width:0;max-width:100%}
.navhint{position:absolute;top:50%;z-index:2;display:none;align-items:center;padding:6px 8px;border-radius:99px;pointer-events:none;
  color:var(--tx);opacity:0;transform:translateY(-50%);transition:opacity 1s var(--ease)}
.navhint svg{width:15px;height:15px;display:block}
.navhint svg+svg{margin-inline-start:-9px;opacity:.5}
.navhint.l{left:0;background:linear-gradient(to right,rgb(var(--surf2-rgb)/.9),rgb(var(--surf2-rgb)/0))}
.navhint.r{right:0;background:linear-gradient(to left,rgb(var(--surf2-rgb)/.9),rgb(var(--surf2-rgb)/0))}
.navwrap.hint.ml .navhint.l,.navwrap.hint.mr .navhint.r{display:flex}
.navwrap.hint.show .navhint{opacity:.45}
.navwrap.hint.show .navhint.l{animation:navHL 1.7s ease-in-out .2s 3}
.navwrap.hint.show .navhint.r{animation:navHR 1.7s ease-in-out .2s 3}
@keyframes navHL{0%,100%{transform:translateY(-50%)}50%{transform:translate(-6px,-50%);opacity:.85}}
@keyframes navHR{0%,100%{transform:translateY(-50%)}50%{transform:translate(6px,-50%);opacity:.85}}
/* ✨ الشريط العلوي — 🔔 يمين · الهوية بالوسط · ▶️ ⏹️ يسار · بطاقات الأرباح سطر تحته */
.hrow{display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);align-items:center;column-gap:12px;row-gap:10px}
.hrow>.ops.opsb{grid-column:1;grid-row:1;justify-self:start;margin:0!important}
.hrow>.brand{grid-column:2;grid-row:1;justify-self:center}
.hrow>.ops:not(.opsb){grid-column:3;grid-row:1;justify-self:end;margin:0!important}
.hrow>.totals{grid-column:1/-1;grid-row:2;width:100%;justify-content:center;margin:0!important}
.hrow>.stats{grid-column:1/-1;grid-row:2;width:100%;margin:0}
/* 📊 v3.22.2: خانات متساوية — اليوم فوق · الإجمالي تحت (الموبايل: كل خانة يمّ إجماليها) · 🪙 v3.30.0: 12 خانة (6 × 2) */
.stats{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:6px}
/* 📏 v3.22.4: الخانات أقصر (66 ⇐ 48 بكسل) حتى الكروت تبين بالحاسوب */
.st{position:relative;overflow:hidden;display:flex;flex-direction:column;justify-content:center;gap:2px;min-width:0;min-height:0;
  padding:5px 12px;border:1px solid var(--line);border-radius:11px;background:rgb(var(--ov-rgb)/.035)}
.st .sl{font-size:11px;line-height:1.25;color:var(--mut);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;position:relative;z-index:1}
.st .sv{display:flex;align-items:baseline;gap:5px;min-width:0;font-size:18px;line-height:1.15;font-weight:600;white-space:nowrap;overflow:hidden;position:relative;z-index:1}
.st .sv>span,.st .sv.rotv{background:linear-gradient(92deg,var(--cyan),var(--vio));-webkit-background-clip:text;background-clip:text;color:transparent;overflow:hidden;text-overflow:ellipsis}
.st .sv small{font-size:12px;color:var(--mut);font-weight:400}
.st .sv .cu{font-size:12px;color:var(--mut);font-weight:500;-webkit-text-fill-color:var(--mut)}
.st.click{cursor:pointer}.st.click:hover{border-color:var(--cyan)}
.st.rot .sv{transition:opacity .28s ease}.st.rot .sv.fade{opacity:0}
.st .spk{position:absolute;left:0;right:0;bottom:0;width:100%;height:22px;opacity:.32;pointer-events:none}
.st.pos .sv>span{background:linear-gradient(92deg,var(--green),var(--cyan));-webkit-background-clip:text;background-clip:text}
.pc-kpi.stats{grid-template-columns:repeat(6,minmax(0,1fr));margin:4px 0 14px}
@media (min-width:1280px){.pc-kpi.stats .st .sl[data-s]{font-size:0}.pc-kpi.stats .st .sl[data-s]::before{content:attr(data-s);font-size:11px}}   /* 📊 v3.31.0: اللوحة عرضها ~1000px حتى على الشاشة الكبيرة ⇒ 6 بالصف = الاسم المختصر (الكامل بالـtitle) */
@media (max-width:430px){.pc-kpi.stats .st .sl[data-x]::before{content:attr(data-x)}}   /* 📱 «🪙 تداول ع كلي» ما يلزم جنب كمية العملة ⇒ «🪙 كلي ع» (مثل الشريط تحت 380) */
@media (min-width:761px) and (max-width:1279px){.st .sl[data-s]{font-size:0}.st .sl[data-s]::before{content:attr(data-s);font-size:11px}}   /* 6 بالصف ⇒ الاسم المختصر */
@media (max-width:760px){
  /* 📱 v3.23.2: كلها تبين بلا سحب — عمودين · كل خانة يمّ إجماليها (اليوم ⇐ الكلي) · شريط بسطر واحد: الاسم المختصر ⇐ الرقم · بلا خط الحركة
     (نفس الترتيب بالشريط العلوي ولوحة التقارير — الحاسوب ما تغيّر) */
  .stats,.pc-kpi.stats{grid-template-columns:repeat(2,minmax(0,1fr));grid-auto-flow:row;gap:5px;overflow:visible}
  .stats>.st:nth-child(1){order:1}.stats>.st:nth-child(7){order:2}.stats>.st:nth-child(2){order:3}.stats>.st:nth-child(8){order:4}
  .stats>.st:nth-child(3){order:5}.stats>.st:nth-child(9){order:6}.stats>.st:nth-child(4){order:7}.stats>.st:nth-child(10){order:8}
  .stats>.st:nth-child(5){order:9}.stats>.st:nth-child(6){order:10}.stats>.st:nth-child(11){order:11}.stats>.st:nth-child(12){order:12}
  .st{flex-direction:row;align-items:center;justify-content:space-between;gap:6px;min-height:32px;padding:4px 9px;border-radius:9px}
  .st .sl{flex:1 1 auto;min-width:0;font-size:10.5px;line-height:1.2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .st .sl[data-s]{font-size:0}.st .sl[data-s]::before{content:attr(data-s);font-size:10.5px}
  .st .sv{flex:0 0 auto;max-width:72%;justify-content:flex-end;font-size:14.5px;gap:3px}   /* الرقم ما ينقص أبداً — الاسم هو اللي ينضغط */
  .st .sv small,.st .sv .cu{font-size:10.5px}
  .st .sv .cu+.cu{display:none}
  .st.rot .sv{font-size:12.5px}.st.rot .sv .cu{font-size:10px}         /* 🪙 كمية العملة طويلة (+0.0005 BTC) ⇒ خط أصغر حتى الاسم ما ينقص */
  .pc-kpi.stats{gap:4px}.pc-kpi.stats .st{padding:4px 7px;gap:4px}
  .st .spk{display:none}}
@media (max-width:380px){.st .sl[data-s]::before{font-size:10px}.st .sl[data-x]::before{content:attr(data-x)}.st .sv{font-size:13.5px}.st.rot .sv{font-size:12px}.pc-kpi.stats .st{padding:4px 6px}.pc-kpi.stats .st .sl[data-s]::before{font-size:9.5px}.pc-kpi.stats .st .sv{font-size:12.5px}.pc-kpi.stats .st.rot .sv{font-size:11.5px}}
@media (max-width:760px){.hrow{column-gap:8px}}
@media (max-width:380px){.hrow{column-gap:5px}.brand{gap:5px}}
@media (prefers-reduced-motion:reduce){.navhint{animation:none!important}}
