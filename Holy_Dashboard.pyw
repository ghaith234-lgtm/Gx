def _bt_mod(name, **kw):
    m = _bt_types.ModuleType(name)
    m.__dict__.update(kw)
    return m


class _BtResp:
    def __init__(self, j):
        self._j = j
        self.status_code = 200
        self.text = json.dumps(j)

    def json(self):
        return self._j

    def read(self):
        return self.text.encode("utf-8")

    def __enter__(self):
        return self

    def __exit__(self, *a):
        return False


def _bt_route(ex, method, url, body=None):
    u = _bt_up.urlparse(url)
    q = {k: v[0] for k, v in _bt_up.parse_qs(u.query).items()}
    p = u.path
    if method == "GET":
        if p == "/api/v5/trade/order":
            return ex.query(q.get("ordId"), q.get("clOrdId"))
        if p == "/api/v5/trade/orders-pending":
            return ex.pending()
        if p == "/api/v5/account/balance":
            return ex.balance(q.get("ccy"))
        if p == "/api/v5/market/ticker":
            return ex.ticker()
        if p == "/api/v5/public/instruments":
            return ex.instrument()
    else:
        b = json.loads(body or "{}") if isinstance(body, (str, bytes)) else (body or {})
        if p == "/api/v5/trade/cancel-order":
            return ex.cancel(b.get("ordId"), b.get("clOrdId"))
        if p == "/api/v5/trade/amend-order":
            return ex.amend(b.get("ordId"), b.get("newSz"), b.get("clOrdId"))
        if p == "/api/v5/trade/order":
            return ex.place(b.get("side"), b.get("ordType"), b.get("sz"), b.get("px"), b.get("clOrdId") or "", b.get("tgtCcy"))
    raise ConnectionError("backtest: no network (" + method + " " + p + ")")


def _bt_fakes(ex, clock):
    """الوحدات التي يأخذها المحرك بدل الحقيقية — داخل المحرك فقط"""
    class TradeAPI:
        def __init__(self, *a, **k):
            pass

        def place_order(self, instId=None, tdMode=None, side=None, ordType=None, sz=None, px=None, clOrdId="", tgtCcy=None, **k):
            clock.lat()
            return ex.place(side, ordType, sz, px, clOrdId or "", tgtCcy)

        def get_order(self, instId=None, ordId=None, clOrdId=None, **k):
            clock.lat()
            return ex.query(ordId, clOrdId)

        def get_order_list(self, instId=None, **k):
            clock.lat()
            return ex.pending()

        def cancel_order(self, instId=None, ordId=None, clOrdId=None, **k):
            clock.lat()
            return ex.cancel(ordId, clOrdId)

        def amend_order(self, instId=None, ordId=None, clOrdId=None, newSz=None, **k):
            clock.lat()
            return ex.amend(ordId, newSz, clOrdId)

    class MarketAPI:
        def __init__(self, *a, **k):
            pass

        def get_ticker(self, instId=None, **k):
            clock.lat()
            return ex.ticker()

        def get_instruments(self, instType=None, instId=None, **k):
            clock.lat()
            return ex.instrument()

    okx = _bt_mod("okx")
    okx.Trade = _bt_mod("okx.Trade", TradeAPI=TradeAPI)
    okx.MarketData = _bt_mod("okx.MarketData", MarketAPI=MarketAPI)

    def _get(url, headers=None, timeout=None, params=None, **k):
        if params:
            url = url + ("&" if "?" in url else "?") + _bt_up.urlencode(params)
        clock.lat()
        return _BtResp(_bt_route(ex, "GET", url))

    def _post(url, headers=None, data=None, timeout=None, **k):
        clock.lat()
        return _BtResp(_bt_route(ex, "POST", url, data if data is not None else k.get("json")))

    requests = _bt_mod("requests", get=_get, post=_post,
                       exceptions=_bt_mod("requests.exceptions", RequestException=Exception, Timeout=TimeoutError, ConnectionError=ConnectionError))

    def _urlopen(url, data=None, timeout=None, **k):
        url = getattr(url, "full_url", url)
        clock.lat()
        return _BtResp(_bt_route(ex, "GET" if data is None else "POST", url, data))

    class _Req:
        def __init__(self, url, data=None, headers=None, method=None, **k):
            self.full_url, self.data = url, data

    urllib_ = _bt_mod("urllib", parse=_bt_up)
    urllib_.request = _bt_mod("urllib.request", urlopen=_urlopen, Request=_Req)
    urllib_.error = _bt_mod("urllib.error", URLError=OSError, HTTPError=OSError)

    class _WsApp:
        def __init__(self, *a, **k):
            pass

        def run_forever(self, *a, **k):
            threading.Event().wait()                    # لا بث مباشر داخل الصندوق: المحرك يقرأ السوق بالسؤال

        def send(self, *a, **k):
            pass

        def close(self, *a, **k):
            pass

    websocket = _bt_mod("websocket", WebSocketApp=_WsApp, enableTrace=lambda *a, **k: None)

    class _Empty(Exception):
        pass

    class _Queue:
        def __init__(self, *a, **k):
            self.items = []

        def put(self, x, *a, **k):
            self.items.append(x)

        def put_nowait(self, x):
            self.items.append(x)

        def get(self, block=True, timeout=None):
            if self.items:
                return self.items.pop(0)
            if block and timeout:
                clock.idle(timeout)
            raise _Empty()

        def get_nowait(self):
            return self.get(False)

        def empty(self):
            return not self.items

        def qsize(self):
            return len(self.items)

    queue_ = _bt_mod("queue", Queue=_Queue, Empty=_Empty, Full=Exception, LifoQueue=_Queue, SimpleQueue=_Queue)

    class _Sock:
        def __init__(self, *a, **k):
            pass

        def bind(self, *a, **k):
            pass

        def close(self):
            pass

        def setsockopt(self, *a, **k):
            pass

        def __getattr__(self, k):
            raise OSError("backtest: no network")

    import socket as _rs
    socket_ = _bt_mod("socket", socket=_Sock, error=OSError, timeout=TimeoutError, AF_INET=_rs.AF_INET, SOCK_STREAM=_rs.SOCK_STREAM,
                      SOL_SOCKET=_rs.SOL_SOCKET, SO_REUSEADDR=_rs.SO_REUSEADDR, setdefaulttimeout=lambda *a: None, getdefaulttimeout=lambda: None,
                      gethostname=lambda: "backtest")

    def _vt(t=None):
        return clock.t if t is None else t

    time_ = _bt_mod("time", time=lambda: clock.t, sleep=clock.sleep, monotonic=lambda: clock.t, perf_counter=time.perf_counter,
                    time_ns=lambda: int(clock.t * 1e9), localtime=lambda t=None: time.localtime(_vt(t)), gmtime=lambda t=None: time.gmtime(_vt(t)),
                    strftime=lambda f, t=None: time.strftime(f, t if t is not None else time.localtime(clock.t)), ctime=lambda t=None: time.ctime(_vt(t)),
                    mktime=time.mktime, struct_time=time.struct_time, timezone=time.timezone, altzone=time.altzone, daylight=time.daylight,
                    tzname=time.tzname, process_time=time.process_time)

    class _DT(_bt_dtm.datetime):
        @classmethod
        def now(cls, tz=None):
            return _bt_dtm.datetime.fromtimestamp(clock.t, tz)

        @classmethod
        def utcnow(cls):
            return _bt_dtm.datetime.utcfromtimestamp(clock.t)

        @classmethod
        def today(cls):
            return _bt_dtm.datetime.fromtimestamp(clock.t)

    datetime_ = _bt_mod("datetime", **{k: getattr(_bt_dtm, k) for k in dir(_bt_dtm) if not k.startswith("__")})
    datetime_.datetime = _DT

    def _dump(obj, fp, **kw):                            # المحتوى نفسه بالمرمّز السريع (بلا إزاحة أسطر)
        kw.pop("indent", None)
        fp.write(json.dumps(obj, **kw))

    def _dumps(obj, **kw):
        kw.pop("indent", None)
        return json.dumps(obj, **kw)

    json_ = _bt_mod("json", **{k: getattr(json, k) for k in dir(json) if not k.startswith("__")})
    json_.dump, json_.dumps = _dump, _dumps
    return {"okx": okx, "okx.Trade": okx.Trade, "okx.MarketData": okx.MarketData, "requests": requests, "urllib": urllib_,
            "urllib.request": urllib_.request, "urllib.error": urllib_.error, "websocket": websocket, "queue": queue_, "socket": socket_,
            "time": time_, "datetime": datetime_, "json": json_}


def _bt_no_net(*a, **k):
    raise OSError("backtest: no network")


def _bt_seal():
    """🔒 عملية الاختبار بلا شبكة إطلاقاً (حتى لو استورد محرك شيئاً لم نزيّفه)"""
    import socket as _s
    _s.socket.connect = _bt_no_net
    _s.socket.connect_ex = _bt_no_net
    _s.create_connection = _bt_no_net
    _s.getaddrinfo = _bt_no_net
    os.fsync = lambda fd: None                         # قرص الصندوق لا يحتاج تثبيتاً (سرعة)


class _BtNull(_bt_io.TextIOBase):
    def write(self, s):
        return len(s)


def _bt_exec(src, script, folder, fakes, main_src=None):
    """يشغّل مصدر المحرك كبرنامج رئيسي في مجلده — مثل التشغيل الحقيقي تماماً — مع العالم المزيّف ·
    main_src: غلاف إعادة الاستثمار يستورد «main» ⇒ محرك الشبكة نفسه وحدةً بنفس العالم"""
    real_import = _bt_bi.__import__
    mods = dict(fakes)
    bi = dict(_bt_bi.__dict__)

    def _imp(name, globals=None, locals=None, fromlist=(), level=0):
        if level == 0:
            if name == "main" and main_src is not None:
                if "main" not in mods:
                    m = _bt_types.ModuleType("main")
                    m.__dict__.update({"__file__": os.path.join(folder, "main.py"), "__builtins__": bi})
                    mods["main"] = m
                    exec(compile(main_src, os.path.join(folder, "main.py"), "exec"), m.__dict__)
                return mods["main"]
            if name in mods:
                return mods[name] if (fromlist or "." not in name) else mods[name.split(".")[0]]
            top = name.split(".")[0]
            if top in mods and not fromlist and top != "main":
                return mods[top]
        return real_import(name, globals, locals, fromlist, level)

    bi["__import__"] = _imp
    bi["input"] = lambda *a: (_ for _ in ()).throw(_BtDone())        # محرك يسأل لوحة المفاتيح ⇒ يتوقف الاختبار
    g = {"__name__": "__main__", "__file__": os.path.join(folder, script), "__builtins__": bi}
    code = compile(src, os.path.join(folder, script), "exec")
    old_cwd, old_out = os.getcwd(), sys.stdout
    os.chdir(folder)
    sys.stdout = _BtNull()
    why = "end"
    try:
        exec(code, g)
        why = "returned"
    except _BtDone:
        why = "end"
    except SystemExit:
        why = "exit"
    finally:
        sys.stdout = old_out
        os.chdir(old_cwd)
    return why


def _bt_pkey(kind):
    """مفتاح الربح المحقق بدفتر المحرك نفسه + ملف حالته"""
    fam = (_BOT_KINDS.get(kind) or {}).get("fam")
    return {"grid": "total_profit", "dca": "total_coin_profit", "rec": "profit_total"}.get(fam, "profit_total"), (_BOT_KINDS.get(kind) or {}).get("state", "")


# ═══════════ ▶️ مسار واحد ═══════════
def _bt_ri_nf(cfg):
    """💠 v3.36.8: عامل الغلاف (reinvest.py `panel_net_factor`) بالحرف — الحصة العادية مكتوبة بدفتر المحرك مقسومة عليه ⇒ الضرب به يرجّعها صافية"""
    try:
        g = float(cfg.get("grid_percentage") or 0)
        f = float(cfg.get("fee_rate") or 0.0008)
        if g <= 0 or f < 0:
            return 1.0
        net = g - 2.0 * f - g * f
        return 0.0 if net <= 0 else max(0.0, min(1.0, net / (g * 0.999)))
    except Exception:
        return 1.0


def _bt_ri_held(st):
    """💠 v3.36.8: الربح المعاد استثماره داخل الدرجات بالدولار (بسعر الدرجة نفسه — ما يتحرك بحركة السعر): الحصّالة + النمو × سعر الدرجة − المحقون"""
    ri = (st or {}).get("reinvest") or {}
    tot = float(ri.get("orphan_usd") or 0)
    for lv in (ri.get("levels") or {}).values():
        try:
            t = float(lv.get("usd_book") or 0) + float(lv.get("grown_qty") or 0) * float(lv.get("px") or 0)
            tot += max(0.0, t - min(max(0.0, float(lv.get("inj_book") or 0) + float(lv.get("inj_grown") or 0)), max(0.0, t)))
        except Exception:
            continue
    return tot


def _bt_cum(st, pk, rnf):
    """ربح البيع والشراء من دفتر المحرك · الشبكة بإعادة الاستثمار: الحصة العادية صافية + المعاد استثماره (يصعد بس — درجة بكل بيعة)"""
    v = float((st or {}).get(pk) or 0)
    if rnf is None or not ((st or {}).get("reinvest") or {}).get("on"):
        return v
    return v * rnf + _bt_ri_held(st)


def _bt_run(kind, cfg, sym, px, dt, quote, base, spec, maker=0.0008, taker=0.001, slip=0.0005, samples=1200, stop=None):
    """محرك واحد على مسار واحد ⇒ الصفقات · المحفظة على طول المسار · ربح دفتر المحرك نفسه · النتيجة (بداية = نهاية ⇒ الفرق = ما صنعه البوت)"""
    shm = "/dev/shm" if os.path.isdir("/dev/shm") and os.access("/dev/shm", os.W_OK) else None
    folder = _bt_tmp.mkdtemp(prefix="holy_bt_", dir=shm)
    try:
        ex = _BtEx(sym, px[0], quote, base, spec["tickSz"], spec["lotSz"], spec["minSz"], maker, taker, slip)
        n = len(px) - 1
        every = max(1, n // max(1, samples))
        pk, spre = _bt_pkey(kind)
        sp_file = os.path.join(folder, f"{spre}{sym}.json")
        S = {"nf": 0, "pr": 0.0, "w": 0}
        curve, pops = [], []
        rnf = _bt_ri_nf(cfg) if kind in ("grid", "grid_range", "grid_plus") and cfg.get("reinvest") else None    # 💠 v3.36.8

        def _prof():
            try:
                with open(sp_file, encoding="utf-8") as f:
                    return _bt_cum(json.load(f) or {}, pk, rnf)
            except Exception:
                return S["pr"]

        def _pop_check(i):
            # 🎞️ v3.36.8: كل تغيّر بالدفتر له علامة ربح — المحرك يسجّل البيعة بدورته (بعد التنفيذ بنقطة أو أكثر) ⇒ بعد كل بيعة نراقب دفتره
            #    النقاط الجاية لحد ما يسجّلها (كانت تنطوي بصمت لو سجّلها بعد ما تغيّر عدد التنفيذات بشراء)
            if len(ex.fills) != S["nf"]:
                if any(x[1] == "sell" for x in ex.fills[S["nf"]:]):
                    S["w"] = 60
                S["nf"] = len(ex.fills)
            elif S["w"] > 0:
                S["w"] -= 1
            else:
                return
            p1 = _prof()
            if abs(p1 - S["pr"]) > 1e-12:
                pops.append((i, round(p1 - S["pr"], 8)))
                S["pr"] = p1
                S["w"] = 0

        def on_point(i):
            _pop_check(i)
            if i % every == 0 or i == n:
                curve.append((i, ex.p, round(ex.bal[ex.quote], 8), round(ex.bal[ex.base], 10), round(S["pr"], 8)))

        clock = _BtClock(ex, px, _BT_T0, dt, on_point)
        clock.stop = stop
        curve.append((0, px[0], round(quote, 8), round(base, 10), 0.0))
        c = dict(cfg)
        c.update({"api_key": "backtest", "secret_key": "backtest", "passphrase": "backtest", "symbol": sym, "is_demo": False,
                  "auto_restart": False})
        with open(os.path.join(folder, f"config_{sym}.json"), "w", encoding="utf-8") as f:
            json.dump(c, f, ensure_ascii=False)
        src, script, _v = engine_for(c)
        main_src = None
        if kind in ("grid", "grid_range", "grid_plus") and c.get("reinvest"):
            main_src, src, script = src, REINV_SRC, "reinvest.py"          # نفس قرار التشغيل الحقيقي: الغلاف يستورد المحرك
        w0 = time.time()
        why = _bt_exec(src, script, folder, _bt_fakes(ex, clock), main_src=main_src)
        if stop is not None and stop.is_set():
            why = "stopped"
        st = {}
        try:
            with open(sp_file, encoding="utf-8") as f:
                st = json.load(f) or {}
        except Exception:
            pass
        _pop_check(clock.i)
        _pe = _bt_cum(st, pk, rnf) if st else S["pr"]
        if abs(_pe - S["pr"]) > 1e-12:                # آخر تسجيل للمحرك بعد آخر نقطة ⇒ علامته بالنهاية (العلامات = رقم البطاقة)
            pops.append((clock.i, round(_pe - S["pr"], 8)))
            S["pr"] = _pe
        fin = (clock.i, ex.p, round(ex.bal[ex.quote], 8), round(ex.bal[ex.base], 10), round(_pe, 8))
        if curve[-1][0] == clock.i:
            curve[-1] = fin                       # آخر لحظة: ما فعله المحرك بعد وصول السعر لنقطة النهاية يدخل في الحالة الأخيرة (= بطاقة النهاية)
        else:
            curve.append(fin)
        return {"why": why, "secs": round(time.time() - w0, 2), "n": n, "i_end": clock.i, "ex": ex, "curve": curve, "pops": pops,
                "state": st, "pkey": pk, "realized": float(st.get(pk) or 0), "rnf": rnf}
    finally:
        shutil.rmtree(folder, ignore_errors=True)


def _bt_trade(kind, r, p0, result, base0):
    """💰 ربح البيع والشراء للصفقات المكتملة — صافي العمولة المدفوعة فعلاً — و📦 المفتوح عند النهاية بسعر البداية.
    المجموع = فرق المحفظة بالمليم (المفتوح = الفرق − ربح البيع والشراء).
    · DCA والدوري ومسار القيمة: دفتر المحرك نفسه (صافٍ أصلاً) — والمفتوح من ملف حالته يطابق الباقي بالمليم (tie)
    · الشبكات: المحرك يسجّل فرق السعر الخام ×0.999 ⇒ نطرح العمولة الحقيقية: دفتره÷0.999 − عمولات البيع − عمولات شراء العملات التي بيعت
    · الشبكة بإعادة الاستثمار (v3.36.8): ربح الدورات المكتملة صافياً — الحصة العادية + المعاد استثماره داخل الدرجات (يصعد بس) ·
      المفتوح = الباقي (درجات لم تكتمل دورتها + ما اشتراه الربح المعاد استثماره بسعر البداية) — كان فرق المحفظة بسعر البداية (يصعد وينزل)"""
    ex, st, book = r["ex"], r["state"] or {}, float(r["realized"] or 0)
    out = {"trade_coin": None, "od": {}, "tie": None}
    f_ = lambda v: float(v or 0)
    if kind in ("grid", "grid_range", "grid_plus"):
        if (st.get("reinvest") or {}).get("on"):
            trade = _bt_cum(st, r.get("pkey") or "total_profit", r["rnf"]) if r.get("rnf") is not None else result
            out["od"] = {"k": "ri", "q": round(ex.bal[ex.base] - base0, 10), "pot": round(_bt_ri_held(st), 8)}
        else:
            held = [o for sd in ("limit_sells", "virtual_sells", "accum_sells") for o in (st.get(sd) or {}).values()]
            buy_fee = sum(x[4] * x[2] for x in ex.fills if x[1] == "buy")
            open_fee = sum(f_(o.get("fee_coin")) * f_(o.get("cost_px")) for o in held)
            trade = book / 0.999 - ex.fees[ex.quote] - (buy_fee - open_fee)
            out["od"] = {"k": "grid", "q": round(ex.bal[ex.base] - base0, 10)}
    elif kind in ("dca", "dca_buy"):
        if kind == "dca_buy":
            trade = book
            out["od"] = {"k": "held", "q": round(f_(st.get("total_net")), 10), "c": round(f_(st.get("total_usdt")), 8)}
            y = f_(st.get("total_net")) * p0 - f_(st.get("total_usdt")) + f_(st.get("dust_coin")) * p0
        else:
            out["trade_coin"] = book
            trade = book * p0
            out["od"] = {"k": "sold", "q": round(f_(st.get("total_sold_qty")), 10), "u": round(f_(st.get("total_net")), 8)}
            y = f_(st.get("total_net")) - f_(st.get("total_sold_qty")) * p0 + f_(st.get("dust_usdt"))
        out["tie"] = round(result - trade - y, 8)
    else:
        lots = st.get("lots") or []
        q, c = sum(f_(l.get("q")) for l in lots), sum(f_(l.get("c")) for l in lots)
        if kind == "rec_sell":
            out["trade_coin"] = book
            trade = book * p0
            out["od"] = {"k": "sold", "q": round(q, 10), "u": round(c, 8)}
            y = c - q * p0
        else:
            trade = book
            out["od"] = {"k": "held", "q": round(q, 10), "c": round(c, 8)}
            y = q * p0 - c
        out["tie"] = round(result - trade - y, 8)
    out["trade"] = round(trade, 8)
    out["open"] = round(result - trade, 8)
    return out


def _bt_summary(kind, r, quote0, base0, p0, dt):
    """أرقام المسار الواحد — كلها من المنصة التجريبية (المحفظة) ودفتر المحرك نفسه"""
    ex = r["ex"]
    q1, b1 = ex.bal[ex.quote], ex.bal[ex.base]
    v0 = quote0 + base0 * p0
    v1 = q1 + b1 * p0                                     # النهاية = سعر البداية
    vals = [c[2] + c[3] * c[1] for c in r["curve"]]
    peak, mdd, low = vals[0] if vals else v0, 0.0, min(vals) if vals else v0
    for v in vals:
        peak = max(peak, v)
        mdd = max(mdd, peak - v)
    coin = (_BOT_KINDS.get(kind) or {}).get("cur") == "coin"
    rej = {}
    for _t, sc in ex.rejects:
        rej[sc] = rej.get(sc, 0) + 1
    fee_usd = ex.fees[ex.quote] + ex.fees[ex.base] * p0
    tr = _bt_trade(kind, r, p0, v1 - v0, base0)
    return {"trade": tr["trade"], "trade_coin": None if tr["trade_coin"] is None else round(tr["trade_coin"], 10), "open_usd": tr["open"],
            "od": tr["od"], "tie": tr["tie"],
            "result": round(v1 - v0, 8), "pct": round((v1 - v0) / v0 * 100, 4) if v0 > 0 else 0.0, "v0": round(v0, 8), "v1": round(v1, 8),
            "q0": quote0, "b0": base0, "q1": round(q1, 8), "b1": round(b1, 10), "p0": p0,
            "realized": round(r["realized"], 8), "coin": coin, "buys": sum(1 for f in ex.fills if f[1] == "buy"),
            "sells": sum(1 for f in ex.fills if f[1] == "sell"), "fee_usd": round(fee_usd, 8), "mdd": round(mdd, 8), "low": round(low, 8),
            "used_max": round(max([quote0 - c[2] for c in r["curve"]] + [0.0]), 8),
            "coin_used_max": round(max([base0 - c[3] for c in r["curve"]] + [0.0]), 10),
            "pmin": round(min(c[1] for c in r["curve"]), 12), "pmax": round(max(c[1] for c in r["curve"]), 12),
            "rej_bal": rej.get("51008", 0), "rej_min": rej.get("51020", 0), "rej_px": rej.get("51000", 0),
            "rej_other": sum(v for k, v in rej.items() if k not in ("51008", "51020", "51000")),
            "open": sum(1 for o in ex.orders.values() if o["state"] == "live"), "why": r["why"], "secs": r["secs"],
            "ri": bool((r["state"].get("reinvest") or {}).get("on")),
            "days": round(r["i_end"] * dt / 86400.0, 2)}


def _bt_detail(r, dt, s=None):
    """ما تحتاجه الإعادة المتحرّكة: المسار (عيّنات) · المحفظة · ربح البيع والشراء · الصفقات · علامات الربح
    (الشبكة: دفترها خام قبل العمولة ⇒ يُضرب بنسبة الصافي إلى الخام فينتهي على رقم البطاقة نفسه ·
     إعادة الاستثمار: ربح الدورات صافياً لحظة بلحظة — محسوب كذلك من وقت التشغيل، فيصعد بس وينتهي على رقم البطاقة)"""
    fl = r["ex"].fills
    stp = max(1, len(fl) // 4000)
    curve, pops = r["curve"], r["pops"]
    if s and s.get("od", {}).get("k") == "ri":
        pass                                      # 💠 v3.36.8: العيّنات نفسها (ربح الدورات صافياً) · علامة ربح لكل بيعة
    elif s and s.get("od", {}).get("k") == "grid" and abs(float(r["realized"] or 0)) > 1e-12:
        k = float(s["trade"]) / float(r["realized"])
        curve = [(c[0], c[1], c[2], c[3], round(c[4] * k, 8)) for c in curve]
        pops = [(i, round(v * k, 8)) for i, v in pops]
    return {"dt": dt, "n": r["n"], "c": [[c[0], round(c[1], 12), c[2], c[3], c[4]] for c in curve],
            "f": [[int(round((f[0] - _BT_T0) / dt)), 1 if f[1] == "sell" else 0, round(f[2], 12), round(f[3], 10), round(f[4], 10), 1 if f[5] else 0]
                  for f in fl[::stp]], "f_all": len(fl), "pops": pops}


# ═══════════ 🧰 التحضير والتشغيل من اللوحة ═══════════
def _bt_kind_of(body):
    k = str(body.get("kind") or "").strip()
    if k in _BT_KINDS:
        return k
    if body.get("g_type") is not None or body.get("grid_pct") is not None:
        g = str(body.get("g_type") or "grid")
        return g if g in ("grid", "grid_range", "grid_plus") else "grid"
    if body.get("dca_type") is not None:
        return "dca_buy" if str(body.get("dca_type")) == "dca_buy" else "dca"
    if body.get("rec_type") is not None:
        return "rec_sell" if str(body.get("rec_type")) == "rec_sell" else "rec_buy"
    if body.get("start_usd") is not None:
        return "rec_va"
    return ""


def _bt_spec(sym):
    """قواعد العملة (خطوة السعر · خطوة الكمية · أقل كمية) — قراءة عامة بلا مفاتيح، محفوظة ساعة · آخر قراءة ناجحة تبقى بملف
    (إذا تعذّر الوصول للمنصة لحظتها يُستعمل آخر ما عُرف)"""
    c = _BT_SPEC.get(sym)
    if c and time.time() - c[0] < 3600:
        return c[1]
    sf = os.path.join(BT_DIR, "spec.json")
    v = None
    try:
        r = _okx_pub(f"/api/v5/public/instruments?instType=SPOT&instId={sym}")
        if r and r.get("code") == "0" and (r.get("data") or []):
            d = r["data"][0]
            v = {"tickSz": float(d.get("tickSz") or 0), "lotSz": float(d.get("lotSz") or 0), "minSz": float(d.get("minSz") or 0)}
            if v["tickSz"] <= 0 or v["lotSz"] <= 0:
                v = None
    except Exception:
        v = None
    if v:
        _BT_SPEC[sym] = (time.time(), v)
        try:
            os.makedirs(BT_DIR, exist_ok=True)
            d = load_json(sf) or {}
            d[sym] = v
            save_json_atomic(sf, d)
        except Exception:
            pass
        return v
    try:
        v = (load_json(sf) or {}).get(sym)
        if v and float(v.get("tickSz") or 0) > 0 and float(v.get("lotSz") or 0) > 0:
            return {"tickSz": float(v["tickSz"]), "lotSz": float(v["lotSz"]), "minSz": float(v.get("minSz") or 0)}
    except Exception:
        pass
    return None


def _bt_src(data):
    """المصدر: نموذج النشر (body) أو بوت قائم (dir) ⇒ (النوع، الرمز، الإعدادات من البوت أو None، الجسم أو None، رسالة خطأ)"""
    d_rel = str(data.get("dir") or "").strip()
    if d_rel:
        full = os.path.realpath(os.path.join(ROOT, d_rel))
        b = bot_dirs().get(full) if full.startswith(os.path.realpath(ROOT) + os.sep) else None
        if not b:
            return None, None, None, None, "مجلد غير معروف"
        kind = str(b["cfg"].get("bot_type") or "grid")
        if kind not in _BT_KINDS:
            return None, None, None, None, "هذا النوع لا يُختبر هنا (المُراكِم خارج الاختبار)"
        cfg = {k: v for k, v in b["cfg"].items() if k not in ("api_key", "secret_key", "passphrase", "wallet")}
        return kind, b["symbol"], cfg, None, ""
    body = dict(data.get("body") or {})
    for k in ("api_key", "secret_key", "passphrase"):
        body.pop(k, None)
    kind = _bt_kind_of(dict(body, kind=data.get("kind")))
    if kind not in _BT_KINDS:
        return None, None, None, None, "نوع البوت غير معروف"
    sym = str(body.get("symbol") or "").strip().upper()
    if not sym or "-" not in sym:
        return None, None, None, None, "اكتب الرمز كاملاً مثل XRP-USDT"
    body["symbol"] = sym
    return kind, sym, None, body, ""


def _bt_wallet_def(kind, cfg, body, p0, spec):
    """محفظة البداية المقترحة (تتغيّر من النافذة): ما يكفي خطة البوت تقريباً"""
    g = dict(cfg or {})
    g.update(body or {})
    f = lambda k, d=0.0: (float(g.get(k)) if g.get(k) not in (None, "") else d)
    try:
        if kind in ("grid", "grid_range", "grid_plus"):
            usd = f("usd_value", 10)
            return round(usd * 25, 2), round(usd * 15 / p0, 8)
        if kind == "rec_va":
            return round(f("cap", 300), 2), 0.0
        if kind == "rec_buy":
            return round(f("cap", 60), 2), 0.0
        if kind == "rec_sell":
            return 0.0, round(f("cap", 60) / p0, 8)
        if kind in ("dca", "dca_buy"):
            bq, aq, sm, n = f("base_order_qty", 0), f("avg_order_qty", 0), f("size_multiplier", 1), int(f("max_safety_orders", 0))
            tot = bq + sum(aq * sm ** i for i in range(max(0, n)))           # أقصى ما تحتاجه الخطة كاملة (بالعملة)
            tot *= 1.02
            return (round(tot * p0, 2), 0.0) if kind == "dca_buy" else (0.0, round(tot, 8))
    except Exception:
        pass
    return 300.0, 0.0


def bt_prep(data):
    """🧪 ما تحتاجه النافذة قبل البدء: السعر الحالي · قواعد العملة · محفظة مقترحة · تقلّب العملة"""
    kind, sym, cfg, body, err = _bt_src(data)
    if err:
        return {"ok": False, "msg": err}
    try:
        p0 = float(PX.get(sym) or 0) or float(_acc_price(sym) or 0)
    except Exception:
        p0 = 0.0
    if p0 <= 0:                                              # آخر سعر رآه بوت يتداول العملة نفسها (أي نوع)
        try:
            for b_ in bot_dirs().values():
                if b_["symbol"] == sym:
                    st = load_json(paths_of(b_)[0]) or {}
                    p0 = float(st.get("px") or st.get("current_price") or 0)
                    if p0 > 0:
                        break
        except Exception:
            p0 = 0.0
    spec = _bt_spec(sym)
    if not spec:
        return {"ok": False, "msg": "تعذّر معرفة قواعد العملة من المنصة (خطوة السعر والكمية) — أعد المحاولة"}
    q, b = _bt_wallet_def(kind, cfg, body, p0 if p0 > 0 else 1.0, spec)
    if p0 <= 0:
        b = 0.0
    base = sym.split("-")[0]
    warn = [] if p0 > 0 else ["سعر العملة غير معروف الآن — اكتب سعر البداية بنفسك"]
    if kind in ("grid", "grid_range", "grid_plus") and p0 < 0.01:
        warn.append("⚠️ محركات الشبكة تقرّب الأسعار إلى أربع خانات عشرية — عملة سعرها أقل من 0.01 لا تعمل عليها الشبكة كما ينبغي (سيظهر ذلك في الاختبار)")
    _rsrc = cfg if cfg is not None else (body or {})
    if kind in ("grid", "grid_range", "grid_plus") and _rsrc.get("reinvest") and not _rsrc.get("demo"):   # 💠 v3.36.7
        try:
            _rp = float(_rsrc.get("reinvest_pct") if _rsrc.get("reinvest_pct") not in (None, "") else 100)
        except Exception:
            _rp = 100.0
        warn.append(f"💠 يعمل بإعادة الاستثمار {_rp:g}% من أول دورة — كما {'يعمل البوت' if cfg is not None else 'سيُنشر'}")
    return {"ok": True, "kind": kind, "sym": sym, "base": base, "p0": p0, "spec": spec, "quote_def": q, "base_def": b,
            "vol": _BT_VOL.get(base, _BT_VOL_DEF), "vol_known": base in _BT_VOL, "label": (_BOT_KINDS.get(kind) or {}).get("lbl", kind),
            "ico": (_BOT_KINDS.get(kind) or {}).get("ico", ""), "coin": (_BOT_KINDS.get(kind) or {}).get("cur") == "coin", "warn": warn,
            "src": "bot" if cfg is not None else "form"}


def _bt_workers():
    try:
        c = os.cpu_count() or 1
    except Exception:
        c = 1
    return 1 if c < 4 else (2 if c < 8 else 3)


def _bt_clean(keep=4):
    try:
        ds = sorted((d for d in os.listdir(BT_DIR) if d.startswith("bt_")), reverse=True)
        for d in ds[keep:]:
            if d not in _BT_JOBS or not any(p.poll() is None for p in _BT_JOBS[d]["procs"]):
                shutil.rmtree(os.path.join(BT_DIR, d), ignore_errors=True)
                _BT_JOBS.pop(d, None)
    except Exception:
        pass


def bt_start(data):
    """▶️ يبدأ الاختبار: عمليات منفصلة بأولوية منخفضة · اختبار واحد في المرة · لا مفاتيح في ملف المهمة"""
    if getattr(sys, "frozen", False):
        return {"ok": False, "msg": "الاختبار يحتاج نسخة بايثون من اللوحة"}
    with _BT_LK:
        for jid, j in list(_BT_JOBS.items()):
            if any(p.poll() is None for p in j["procs"]) and not _bt_finished(j["dir"]):
                return {"ok": False, "msg": "يوجد اختبار يعمل الآن — انتظره أو أوقفه أولاً", "id": jid}
    kind, sym, cfg, body, err = _bt_src(data)
    if err:
        return {"ok": False, "msg": err}
    per = str(data.get("period") or "month")
    mood = str(data.get("mood") or "normal")
    if per not in _BT_PER or mood not in _BT_MOOD:
        return {"ok": False, "msg": "اختر المدة وطبيعة السوق"}
    try:
        npaths = int(data.get("paths") or 1)
        seed = int(float(data.get("seed") or 0)) % 1000000000
        p0 = float(data.get("p0") or 0)
        q0 = float(data.get("quote") or 0)
        b0 = float(data.get("base") or 0)
        maker = float(data.get("maker") if data.get("maker") not in (None, "") else 0.08) / 100.0
        taker = float(data.get("taker") if data.get("taker") not in (None, "") else 0.10) / 100.0
        slip = float(data.get("slip") if data.get("slip") not in (None, "") else 0.05) / 100.0
    except Exception:
        return {"ok": False, "msg": "تأكد من الأرقام في كل الخانات"}
    if npaths not in _BT_PATHS:
        return {"ok": False, "msg": "عدد المسارات: 1 أو 5 أو 10 أو 20"}
    if not (p0 > 0) or q0 < 0 or b0 < 0 or (q0 <= 0 and b0 <= 0):
        return {"ok": False, "msg": "سعر البداية والمحفظة يجب أن تكون أرقاماً موجبة"}
    if not (0 <= maker <= 0.01 and 0 <= taker <= 0.01 and 0 <= slip <= 0.02):
        return {"ok": False, "msg": "العمولة من 0 إلى 1% · الانزلاق من 0 إلى 2%"}
    spec = _bt_spec(sym)
    if not spec:
        return {"ok": False, "msg": "تعذّر معرفة قواعد العملة من المنصة — أعد المحاولة"}
    base = sym.split("-")[0]
    jid = "bt_" + time.strftime("%Y%m%d_%H%M%S") + f"_{int(time.time() * 1000) % 1000:03d}"
    jd = os.path.join(BT_DIR, jid)
    os.makedirs(jd, exist_ok=True)
    job = {"id": jid, "v": 1, "kind": kind, "sym": sym, "cfg": cfg, "body": body, "period": per, "mood": mood, "paths": npaths, "seed": seed,
           "p0": p0, "quote": q0, "base": b0, "spec": spec, "maker": maker, "taker": taker, "slip": slip,
           "vol": _BT_VOL.get(base, _BT_VOL_DEF) * _BT_MOOD[mood], "t": time.time(), "app": APP_VERSION}
    save_json_atomic(os.path.join(jd, "job.json"), job)
    w = min(_bt_workers(), npaths)
    procs = []
    flags = (0x08000000 | 0x00004000) if os.name == "nt" else 0          # بلا نافذة · أولوية أقل من العادية (ويندوز)
    for k in range(w):
        lf = open(os.path.join(jd, f"w{k}.log"), "w", encoding="utf-8")
        procs.append(subprocess.Popen([PYTHON_EXE, "-u", os.path.abspath(__file__), "--holy-bt", jd, str(k), str(w)], cwd=jd,
                                      stdout=lf, stderr=lf, creationflags=flags, env={**os.environ, "PYTHONIOENCODING": "utf-8"}))
    with _BT_LK:
        _BT_JOBS[jid] = {"procs": procs, "t": time.time(), "dir": jd}
    _bt_clean()
    journal("bot", f"🧪 اختبار تجريبي بدأ — {sym} · {(_BOT_KINDS.get(kind) or {}).get('lbl', kind)} · {per} · {npaths} مسار", sym=sym)
    return {"ok": True, "id": jid, "workers": w}


def _bt_finished(jd):
    """كل المسارات انتهت (أو أُوقف) — العامل قد يكون ما زال يغلق ملفاته"""
    try:
        if os.path.exists(os.path.join(jd, "stop.flag")):
            return True
        n = int((load_json(os.path.join(jd, "job.json")) or {}).get("paths") or 0)
        return n > 0 and sum(1 for f in os.listdir(jd) if f.startswith("s_")) >= n
    except Exception:
        return False


def _bt_jdir(jid):
    jid = str(jid or "")
    if not re.fullmatch(r"bt_[0-9_]+", jid):
        return None
    jd = os.path.join(BT_DIR, jid)
    return jd if os.path.isdir(jd) else None


def bt_status(data):
    jd = _bt_jdir(data.get("id"))
    if not jd:
        return {"ok": False, "msg": "اختبار غير معروف"}
    job = load_json(os.path.join(jd, "job.json")) or {}
    paths = []
    for n in range(int(job.get("paths") or 0)):
        s = load_json(os.path.join(jd, f"s_{n}.json"))
        if s:
            paths.append(s)
    err = None
    for fn in sorted(os.listdir(jd)):
        if fn.startswith("err_"):
            e = load_json(os.path.join(jd, fn)) or {}
            err = e.get("msg") or "خطأ"
    j = _BT_JOBS.get(job.get("id"))
    alive = bool(j and any(p.poll() is None for p in j["procs"]))
    stopped = os.path.exists(os.path.join(jd, "stop.flag"))
    done = len(paths) >= int(job.get("paths") or 0)
    state = "error" if err else ("done" if done else ("stopped" if stopped and not alive else ("run" if alive else "lost")))
    secs = [p["sum"]["secs"] for p in paths if p.get("sum")]
    eta = None
    if state == "run" and secs:
        w = len(j["procs"]) if j else 1
        eta = round(sum(secs) / len(secs) * (int(job.get("paths") or 0) - len(paths)) / max(1, w), 0)
    agg = None
    if paths:
        rs = sorted(p["sum"]["result"] for p in paths)
        pcs = sorted(p["sum"]["pct"] for p in paths)
        ts = sorted(float(p["sum"].get("trade", p["sum"]["realized"])) for p in paths)
        agg = {"n": len(rs), "med": rs[len(rs) // 2] if len(rs) % 2 else (rs[len(rs) // 2 - 1] + rs[len(rs) // 2]) / 2, "min": rs[0], "max": rs[-1],
               "mean": sum(rs) / len(rs), "pos": sum(1 for x in rs if x > 0), "pmed": pcs[len(pcs) // 2], "pmin": pcs[0], "pmax": pcs[-1],
               "tmed": ts[len(ts) // 2] if len(ts) % 2 else (ts[len(ts) // 2 - 1] + ts[len(ts) // 2]) / 2, "tmin": ts[0], "tmax": ts[-1]}
    cfg_view = load_json(os.path.join(jd, "cfg.json"))
    return {"ok": True, "id": job.get("id"), "state": state, "err": err, "done": len(paths), "total": int(job.get("paths") or 0), "eta": eta,
            "paths": sorted(paths, key=lambda p: p["n"]), "agg": agg, "job": {k: job.get(k) for k in ("kind", "sym", "period", "mood", "paths", "seed", "p0", "quote",
                                                                                                    "base", "maker", "taker", "slip", "vol", "spec")},
            "cfg": cfg_view}


def bt_path(data):
    jd = _bt_jdir(data.get("id"))
    if not jd:
        return {"ok": False, "msg": "اختبار غير معروف"}
    try:
        n = int(data.get("n") or 0)
    except Exception:
        n = 0
    d = load_json(os.path.join(jd, f"p_{n}.json"))
    s = load_json(os.path.join(jd, f"s_{n}.json"))
    if not d or not s:
        return {"ok": False, "msg": "المسار لم ينتهِ بعد"}
    return {"ok": True, "n": n, "d": d, "s": s}


def bt_stop(data):
    jd = _bt_jdir(data.get("id"))
    if not jd:
        return {"ok": False, "msg": "اختبار غير معروف"}
    try:
        open(os.path.join(jd, "stop.flag"), "w").close()
    except Exception:
        pass
    j = _BT_JOBS.get(os.path.basename(jd))
    if j:
        for p in j["procs"]:
            if p.poll() is None:
                try:
                    p.terminate()
                except Exception:
                    pass
    return {"ok": True, "msg": "⏹ أُوقف الاختبار"}


# ═══════════ 🧪 العملية المنفصلة ═══════════
def _bt_dry_cfg(kind, body, sym, spec, p0):
    """الإعدادات كما يكتبها النشر الحقيقي بالحرف: دالة النشر نفسها على جذر مؤقت — بلا مفاتيح ولا تشغيل ولا شبكة ولا إشعار
    (هذا داخل عملية الاختبار المنفصلة فقط: تغيير متغيّراتها لا يمس اللوحة)"""
    g = globals()
    tmp = _bt_tmp.mkdtemp(prefix="holy_btroot_")
    try:
        g["ROOT"] = tmp
        g["wallet_keys"] = lambda name: {"api_key": "backtest", "secret_key": "backtest", "passphrase": "backtest"}
        g["launch"] = lambda b: (True, "backtest")
        g["tg_send"] = lambda *a, **k: True
        g["journal"] = lambda *a, **k: None
        g["log_event"] = lambda *a, **k: None
        g["_acc_spec"] = lambda s: {"lotSz": spec["lotSz"], "minSz": spec["minSz"]}
        g["_acc_price"] = lambda s: p0
        fn = {"grid": deploy, "grid_range": deploy, "grid_plus": deploy, "dca": deploy_dca, "dca_buy": deploy_dca,
              "rec_buy": deploy_rec, "rec_sell": deploy_rec, "rec_va": deploy_va}[kind]
        b = dict(body)
        b.update({"symbol": sym, "wallet": "backtest", "auto": False})
        if kind in ("grid", "grid_range", "grid_plus"):
            b["g_type"], b["demo"] = kind, False
        elif kind in ("dca", "dca_buy"):
            b["dca_type"] = kind
        elif kind in ("rec_buy", "rec_sell"):
            b["rec_type"] = kind
        r = fn(b) or {}
        if not r.get("ok"):
            return None, str(r.get("msg") or "الإعدادات غير صالحة")
        for d in os.listdir(tmp):
            p = os.path.join(tmp, d, f"config_{sym}.json")
            if os.path.exists(p):
                cfg = load_json(p) or {}
                return {k: v for k, v in cfg.items() if k not in ("api_key", "secret_key", "passphrase")}, ""
        return None, "تعذّر قراءة الإعدادات"
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def _bt_child(jd, k, w):
    """عامل الاختبار: بلا شبكة · أولوية منخفضة · يكتب كل مسار حين ينتهي (s_n ملخص · p_n تفاصيل)"""
    _bt_seal()
    try:
        os.nice(10)
    except Exception:
        pass
    k, w = int(k), max(1, int(w))
    job = load_json(os.path.join(jd, "job.json")) or {}
    stop = threading.Event()

    def _watch():
        while not stop.is_set():
            if os.path.exists(os.path.join(jd, "stop.flag")):
                stop.set()
                break
            time.sleep(0.5)

    threading.Thread(target=_watch, daemon=True).start()
    kind, sym, spec, p0 = job["kind"], job["sym"], job["spec"], float(job["p0"])
    cfg = job.get("cfg")
    if cfg is None:
        cfg, err = _bt_dry_cfg(kind, job.get("body") or {}, sym, spec, p0)
        if cfg is None:
            save_json_atomic(os.path.join(jd, f"err_{k}.json"), {"msg": err})
            return 2
    if k == 0:
        save_json_atomic(os.path.join(jd, "cfg.json"), {kk: v for kk, v in cfg.items() if kk not in ("api_key", "secret_key", "passphrase", "bot_id")})
    days, dt = _BT_PER[job["period"]]
    for n in range(k, int(job["paths"]), w):
        if stop.is_set():
            break
        seed = int(job["seed"]) + n
        px = _bt_path(p0, days, dt, float(job["vol"]), seed)
        try:
            r = _bt_run(kind, cfg, sym, px, dt, float(job["quote"]), float(job["base"]), spec, job["maker"], job["taker"], job["slip"], stop=stop)
        except Exception as e:
            save_json_atomic(os.path.join(jd, f"err_{k}.json"), {"msg": f"تعذّر تشغيل المحرك في الصندوق: {type(e).__name__}: {e}"})
            return 3
        if r["why"] == "stopped":
            break
        s = {"n": n, "seed": seed, "sum": _bt_summary(kind, r, float(job["quote"]), float(job["base"]), p0, dt)}
        save_json_atomic(os.path.join(jd, f"p_{n}.json"), _bt_detail(r, dt, s["sum"]))
        save_json_atomic(os.path.join(jd, f"s_{n}.json"), s)
    return 0


def _rec_audit(b, led):
    """🧮 تدقيق الدوري (قراءة فقط): هوية إعادة الاستثمار (كل اللي انعاد استثماره = بالحصّالة + بالأوامر + انسحب) · الدفتر مقابل البوت"""
    out = []
    st = _safe(load_json, paths_of(b)[0], default={}) or {}
    sell = b["cfg"].get("bot_type") == "rec_sell"
    nm_ = "مسار القيمة" if _is_va(b) else "الدوري"
    k = os.path.relpath(b["dir"], ROOT)
    u = str(b["symbol"]).split("-")[0] if sell else "$"
    rt = float(st.get("ri_total") or 0)
    inside = _rec_held(st)
    wd = float(st.get("wd_coin" if sell else "wd_usd") or 0) + float(st.get("wd_lot_q" if sell else "wd_lot_val") or 0)
    gap = rt - inside - wd
    okk = abs(gap) <= 1e-6 + 1e-6 * abs(rt)
    out.append((f"{nm_} — هوية إعادة الاستثمار ({k})", okk,
                f"المعاد استثماره {rt:.8g}{u} = داخل البوت {inside:.8g} + انسحب {wd:.8g} (فرق {gap:+.2e})", "ok" if okk else "err"))
    pt, rel, rit = float(st.get("profit_total") or 0), float(st.get("rel_total") or 0), rt
    okp = abs(pt - rel - rit) <= 1e-6 + 1e-6 * abs(pt)
    out.append((f"{nm_} — الربح = المحرر + المعاد استثماره ({k})", okp, f"{pt:.8g} = {rel:.8g} + {rit:.8g}", "ok" if okp else "err"))
    lsum = sum(float(v or 0) for v in ((led.get(k) or {}).get("daily") or {}).values())
    exp = (0.0 if sell else rel) + float(st.get("wd_usd") or 0)
    out.append((f"{nm_} — الدفتر مقابل البوت ({k})", True,
                f"الدفتر {lsum:.4f}$ · البوت (محرر الصفقات{' — البيعي عملة' if sell else ''} + سحب دولار) {exp:.4f}$ — يتساوون لو الدفتر يغطي عمر البوت كله", "info"))
    return out


# ═══════════ 📉 v3.25.4: سجل الخسائر — يحسب بس (ولا يتدخل بالبوتات ولا بالأرباح ولا بالصناديق) ═══════════
#   كل خسارة تتحقق (بيع فعلي) تنكتب مرة وحدة بمعرّفها — لكل محفظة ولكل عملة — من لحظة التفعيل (القديم ما ينحسب):
#     📉 DCA بيعي: دورة خلصت بخسارة (عملة) · 📈 DCA شرائي: دورة خلصت بخسارة (دولار) · 🪙 المُراكِم: بيع تحت معدله (دولار)
#     🔁 الدوري بالمعدل: خروج بخسارة · 🔁 الدوري «كل أمر على حدا»: كل أمر انباع بخسارة لحاله (الرابح ما يقاصص الخاسر)
#     (الدوري الشرائي دولار · البيعي عملة). بوتات الشبكة ما تبيع بخسارة (كل بيعة فوق شرائها) ⇒ ما عدها خسائر.
#   خسارة على الورق (عملة لسه بيدك) ما تنحسب لحد ما تنباع. السجل بملفه — يبقى بعد حذف البوت وبعد ما سجل البوت يقص قديمه،
#   و«بداية جديدة للحسابات» ما تمسحه.
LOSS_FILE = os.path.join(ROOT, "Holy_Losses.json")
_LOSS_LOCK = threading.Lock()
LOSS_SRC = {"dca": "📉 DCA بيعي — دورة بخسارة", "dca_buy": "📈 DCA شرائي — دورة بخسارة", "acc": "🪙 المُراكِم — بيع تحت المعدل",
            "rec_avg": "🔁 الدوري (المعدل) — خروج بخسارة", "rec_lot": "🔁 الدوري — أمر انباع بخسارة",
            "rec_va": "💹 مسار القيمة — بيعة بخسارة"}
LOSS_KEEP = 50000


def _loss_load():
    d = load_json(LOSS_FILE)
    return d if isinstance(d, dict) else {}


def _loss_split(bt, c, lots):
    """🔁 خروج «كل أمر على حدا» شمل أكثر من أمر (بيع يدوي للكل/لأوامر مختارة): نتيجة كل أمر لحاله من نفس التنفيذ —
    الشرائي: عملات الأمر × (الدولار الصافي ÷ العملات المباعة) − كلفته · البيعي: دولار الأمر × (العملات الراجعة ÷ الدولار المصروف) − عملاته.
    `lots` = لقطة الأوامر قبل الخروج {id: [q, c]}. يرجع [(id, النتيجة, الكلفة, الراجع)] — أو None لو اللقطة ناقصة أو ما تطابق السجل
    (⇒ الخروج ينحسب كمجموعة وحدة)."""
    ids = [str(x) for x in (c.get("lots") or [])]
    if not ids or any(i not in lots for i in ids):
        return None
    try:
        out, inn, cost = float(c.get("out") or 0), float(c.get("in") or 0), float(c.get("cost") or 0)
        Q = sum(float(lots[i][0]) for i in ids)
        C = sum(float(lots[i][1]) for i in ids)
    except Exception:
        return None
    res = []
    if bt in _REC_USD:
        if Q <= 0 or out <= 0 or abs(C - cost) > 1e-6 + 1e-6 * abs(cost):
            return None
        den = max(out, Q)
        for i in ids:
            q, cc = float(lots[i][0]), float(lots[i][1])
            got = inn * q / den
            res.append((i, got - cc, cc, got))
    else:
        if C <= 0 or out <= 0 or abs(Q - cost) > 1e-9 + 1e-6 * abs(cost):
            return None
        den = max(out, C)
        for i in ids:
            q, cc = float(lots[i][0]), float(lots[i][1])
            back = inn * cc / den
            res.append((i, back - q, q, back))
    return res


def _loss_fmt(it):
    u = it.get("ccy") or ""
    a = float(it.get("amt") or 0)
    return (f"{a:.4f}$" if u == "USDT" else f"{a:.8g} {u} ≈ {float(it.get('usd') or 0):.4f}$")


def loss_tick():
    """📉 v3.25.4: يقرا الخسائر الجديدة من سجلات البوتات والمُراكِمات (قراءة بس — ولا شي يتحرك ولا يتغيّر ببوت أو دفتر ربح).
    كل سجل خروج ينقرا مرة وحدة (`done`) · الأوامر المفتوحة للدوري تنحفظ لقطتها (`lots`) حتى خروج يدوي لأكثر من أمر
    ينحسب أمر أمر. يرجع عدد الخسائر الجديدة."""
    with _LOSS_LOCK:
        L = _loss_load()
        now = time.time()
        ch = False
        if not L.get("since"):
            L = {"v": 1, "since": now, "since_d": datetime.now().strftime("%Y-%m-%d %H:%M"), "items": [], "done": [], "lots": {}}
            ch = True
        since = float(L["since"])
        items = L.setdefault("items", [])
        have = {str(x.get("id")) for x in items if isinstance(x, dict)}
        done = [str(x) for x in (L.get("done") or [])]
        dset = set(done)
        lc = L.setdefault("lots", {})
        live, new = set(), []
        try:
            labs = _pf_wallets()[1]
        except Exception:
            labs = {}

        def mark(i):
            dset.add(i); done.append(i)

        def put(it):
            if it["id"] not in have:
                have.add(it["id"]); new.append(it)

        for b in bot_dirs().values():
            cfg = b.get("cfg") or {}
            bt = str(cfg.get("bot_type") or "")
            if cfg.get("is_demo") or bt not in _LOSS_T:          # 📐 v3.32.0: من الجدول
                continue
            st = _safe(load_json, paths_of(b)[0], default=None)
            if not isinstance(st, dict):
                continue
            key = os.path.relpath(b["dir"], ROOT)
            k_ = str(cfg.get("api_key") or "").strip()
            w = _gd_wid(k_) if k_ else ""
            sym = b["symbol"]
            base, quote = (sym.split("-") + ["USDT"])[:2]
            com = {"w": w, "wl": labs.get(w, ""), "bot": key, "name": sym, "sym": sym}
            if bt in ("dca", "dca_buy"):
                for c in (st.get("cycles_log") or []):
                    if not isinstance(c, dict) or not c.get("id"):
                        continue
                    cid = "dca:" + str(c["id"])
                    live.add(cid)
                    try:
                        ts, p, px = float(c.get("ts") or 0), float(c.get("profit") or 0), float(c.get("px") or 0)
                    except Exception:
                        continue
                    if cid in dset or ts < since:
                        continue
                    mark(cid); ch = True
                    if p < -1e-12:
                        ccy = base if bt == "dca" else quote
                        put(dict(com, id=cid, ts=ts, src=bt, ccy=ccy, amt=round(-p, 10), px=px,
                                 usd=round(-p * px if ccy != quote else -p, 6), n=c.get("n"), manual=bool(c.get("manual"))))
                continue
            mode = str(st.get("mode") or cfg.get("mode") or "lots")
            cache = lc.setdefault(key, {})
            ccy = quote if bt in _REC_USD else base
            for c in (st.get("cycles_log") or []):
                if not isinstance(c, dict) or not c.get("id"):
                    continue
                cid = "rec:" + str(c["id"])
                live.add(cid)
                try:
                    ts, p, px = float(c.get("ts") or 0), float(c.get("profit") or 0), float(c.get("px") or 0)
                except Exception:
                    continue
                ids = [str(x) for x in (c.get("lots") or [])]
                if cid in dset or ts < since:
                    for i in ids:
                        cache.pop(i, None)
                    continue
                mark(cid); ch = True
                val = (lambda a: round(a, 6)) if ccy == quote else (lambda a, px=px: round(a * px, 6))
                parts = _loss_split(bt, c, cache) if (mode != "avg" and len(ids) > 1) else None
                if parts is not None:
                    for (lid, pnl, cost, got) in parts:
                        if pnl < -1e-12:
                            put(dict(com, id=cid + "|" + lid, ts=ts, src="rec_lot", ccy=ccy, amt=round(-pnl, 10), px=px, usd=val(-pnl),
                                     n=c.get("n"), lot=lid, manual=bool(c.get("manual")), cost=round(cost, 10), got=round(got, 10)))
                elif p < -1e-12:
                    put(dict(com, id=cid, ts=ts, src=("rec_va" if bt == "rec_va" else ("rec_avg" if mode == "avg" else "rec_lot")), ccy=ccy, amt=round(-p, 10), px=px, usd=val(-p),
                             n=c.get("n"), lot=(ids[0] if len(ids) == 1 else ""), lots=len(ids), grp=bool(mode != "avg" and len(ids) > 1),
                             manual=bool(c.get("manual")), cost=c.get("cost"), got=c.get("in")))
                for i in ids:
                    cache.pop(i, None)
            cur = {}
            for l in (st.get("lots") or []):
                if isinstance(l, dict) and l.get("id"):
                    try:
                        cur[str(l["id"])] = [round(float(l.get("q") or 0), 12), round(float(l.get("c") or 0), 10)]
                    except Exception:
                        pass
            for i, v in cur.items():
                if cache.get(i) != v:
                    cache[i] = v; ch = True
            if len(cache) > 1000:
                for i in [i for i in cache if i not in cur][:len(cache) - 1000]:
                    cache.pop(i, None)
        try:
            ast = acc_state() or {}
            cmap = {a.get("id"): a for a in (acc_cfgs() or []) if isinstance(a, dict)}
        except Exception:
            ast, cmap = {}, {}
        for aid, e in (ast.items() if isinstance(ast, dict) else []):
            if str(aid).startswith("_") or not isinstance(e, dict):
                continue
            a = cmap.get(aid) or {}
            sym = str(a.get("symbol") or "")
            w = (_safe(acc_wid, a, default="") or "") if a else ""
            for x in (e.get("sells") or []):
                if not isinstance(x, dict):
                    continue
                sid = f"acc:{aid}|{x.get('ts')}"
                live.add(sid)
                try:
                    ts, p = float(x.get("ts") or 0), float(x.get("profit") or 0)
                except Exception:
                    continue
                if sid in dset or ts < since:
                    continue
                mark(sid); ch = True
                if p < -1e-9:
                    usd = float(x.get("usd") or 0)
                    put({"id": sid, "ts": ts, "w": w, "wl": labs.get(w, ""), "bot": aid, "name": a.get("name") or sym or aid, "sym": sym,
                         "src": "acc", "ccy": "USDT", "amt": round(-p, 6), "usd": round(-p, 6), "px": x.get("px"), "qty": x.get("qty"),
                         "got": round(usd, 6), "cost": round(usd - p, 6), "manual": str(x.get("why") or "") != "آلي", "why": str(x.get("why") or "")[:40]})
        if new:
            new.sort(key=lambda it: float(it.get("ts") or 0))
            items.extend(new)
            for it in new:
                _safe(journal, "loss", f"📉 {LOSS_SRC.get(it['src'], it['src'])}: −{_loss_fmt(it)} — {it.get('name')}"
                      + (f" · #{it.get('n')}" if it.get("n") is not None else "") + (f" · أمر {it.get('lot')}" if it.get("lot") else "")
                      + (" · يدوي" if it.get("manual") else "") + (f" · {it.get('wl')}" if it.get("wl") else ""), "warn",
                      bot=str(it.get("bot") or ""), sym=str(it.get("sym") or ""), src=it["src"], amount=it.get("amt"), ccy=it.get("ccy"),
                      usd=it.get("usd"), wallet=it.get("w"), loss=it["id"], default=None)
            ch = True
        if len(items) > LOSS_KEEP:
            L["items"] = items[-LOSS_KEEP:]
        if ch:
            L["done"] = list(dict.fromkeys([x for x in done if x in live] + done[-30000:]))
            _safe(save_json_atomic, LOSS_FILE, L, default=None)
        return len(new)


def loss_view(w=None, src=None, d_from=None, d_to=None, limit=500):
    """📉 صفحة الخسائر: لكل محفظة مجموعها (دولار + كل عملة + ما يقابلها بالدولار وقتها) ومنين جت · والقائمة بالفلاتر"""
    _safe(loss_tick, default=None)
    L = _loss_load()
    items = [x for x in (L.get("items") or []) if isinstance(x, dict)]
    try:
        labs = _pf_wallets()[1]
    except Exception:
        labs = {}
    lab = lambda x: labs.get(x.get("w") or "") or x.get("wl") or ("محفظة غير معروفة" if not x.get("w") else str(x.get("w")))
    day = lambda x: datetime.fromtimestamp(float(x.get("ts") or 0)).strftime("%Y-%m-%d")

    def acc(e, x):
        a = float(x.get("amt") or 0)
        if x.get("ccy") == "USDT":
            e["usd"] = round(e["usd"] + a, 6)
        else:
            e["coins"][x["ccy"]] = round(e["coins"].get(x["ccy"], 0.0) + a, 10)
        e["eq"] = round(e["eq"] + float(x.get("usd") or 0), 6)
        e["n"] += 1

    blank = lambda: {"usd": 0.0, "coins": {}, "eq": 0.0, "n": 0}
    W = {}
    for x in items:
        wk = x.get("w") or ""
        e = W.setdefault(wk, dict(blank(), wid=wk, label=lab(x), src={}))
        acc(e, x)
        acc(e["src"].setdefault(x.get("src") or "?", blank()), x)
    sel = [x for x in items if (not w or (x.get("w") or "") == w) and (not src or x.get("src") == src)
           and (not d_from or day(x) >= d_from) and (not d_to or day(x) <= d_to)]
    S = dict(blank(), src={}, days={})
    for x in sel:
        acc(S, x)
        acc(S["src"].setdefault(x.get("src") or "?", blank()), x)
        acc(S["days"].setdefault(day(x), blank()), x)
    out = []
    for x in reversed(sel[-int(limit or 500):]):
        y = {k: x.get(k) for k in ("id", "ts", "w", "src", "bot", "name", "sym", "ccy", "amt", "usd", "px", "n", "lot", "lots", "grp", "manual", "cost", "got", "qty", "why")}
        y.update(wl=lab(x), src_t=LOSS_SRC.get(x.get("src"), x.get("src")), day=day(x))
        out.append(y)
    return {"ok": True, "since": L.get("since"), "since_d": L.get("since_d"), "srcs": LOSS_SRC,
            "wallets": sorted(W.values(), key=lambda e: -e["eq"]), "sel": S, "n": len(sel), "n_all": len(items), "items": out}


def _ri_eligible(b, cfgs=None):
    """(مُراكِمات مؤهلة، سبب الانتظار) — نفس العملة · مفعّل · نسبة عملة > 0 · **نفس المحفظة**.

    التسليم دفتري (ما ينقل عملة بين المحافظ) ⇒ لو المُراكِم على محفظة ثانية، العملة
    فعلياً مو عنده — فما نسجّلها له؛ تنتظر وتطلع بالرقابة."""
    cfgs = acc_cfgs() if cfgs is None else cfgs
    base = b["symbol"].split("-")[0].upper()
    bk = str((b.get("cfg") or {}).get("api_key") or "").strip()
    bw = _gd_wid(bk) if bk else ""
    same = [a for a in cfgs if str(a.get("symbol", "")).split("-")[0].upper() == base]
    if not same:
        return [], f"ماكو مُراكِم لعملة {base}"
    samew = [a for a in same if acc_wid(a) == bw]          # 👛 v3.22.9: كل مُراكِم على محفظته — العملة لمُراكِم نفس محفظة البوت بس
    if not samew:
        return [], f"مُراكِم {base} على محفظة ثانية — العملة تبقى بمحفظة البوت (كل محفظة حسابها مستقل)"
    mine = [a for a in samew if a.get("enabled", True) and float(a.get("coin_pct") or 0) > 0]
    if not mine:
        if not any(a.get("enabled", True) for a in samew):
            return [], f"مُراكِم {base} (بنفس المحفظة) موقوف"
        return [], f"«نسبة العملة» بمُراكِم {base} صفر — خلّيها 100%"
    return mine, ""


def accum_coin_handoff():
    """🪙 يستلم العملة المحرَّرة من إعادة الاستثمار ويوزّعها مباشرة على المُراكِم — خلال ثوانٍ.

    العملة مشتراة أصلاً — فما بيه شراء ولا عمولة. تنضاف للكمية، وتكلفتها
    تنضاف لـspent، فالمعدّل يندمج لحاله:  المعدّل = spent ÷ coin

    🔒 آمن ذاتياً: الزيادة وعلامة «انسلّم» بنفس الكتابة الذرّية — لو كتابة قديمة مسحتهما
       سوية يعاد التسليم بالدورة الجاية، فما يضيع وما يتكرر. والقفل `_ACC_IO` يمنع
       التداخل ويا جولة نص الليل والأزرار.
    ⏳ ماكو مُراكِم مؤهل ⇒ **ينتظر** (ما ينعلّم مستلماً) ويطلع بالرقابة بسببه.
    بوابتا الحد الأدنى والنطاق **ما تنطبقان** — هذني تحكمان الشراء."""
    with _ACC_IO:
        cfgs = acc_cfgs()
        st = acc_state()
        seen = list(st.get("_ri_seen") or [])
        seen_set = set(seen)
        done = []
        live_h = set()                                   # 🔢 v3.25.4: كل تسليم لسه بسجل بوت (ما ينمسح من العلامات أبداً)
        for b in bot_dirs().values():
            try:
                bst = load_json(paths_of(b)[0]) or {}
            except Exception:
                continue
            allh = _ri_handoffs_of(bst) + _dca_handoffs_of(b, bst) + _rec_handoffs_of(b, bst)
            live_h.update(str(h.get("id")) for h in allh if h.get("id"))
            his = [h for h in allh if h.get("id") not in seen_set]
            if not his:
                continue
            mine, _why = _ri_eligible(b, cfgs)
            _bk = str((b.get("cfg") or {}).get("api_key") or "").strip()
            _bw = _gd_wid(_bk) if _bk else "?"                 # 👛 v3.22.9: الباقي محفوظ لكل محفظة (للرقابة)
            if not mine:
                # 👛 ماكو مُراكِم مفعّل يستلمها ⇒ تتحرر **للمحفظة مباشرة** (طلب المالك) — مسجّلة بمعرّفها
                for ho in his:
                    hid, coin = ho["id"], float(ho.get("coin") or 0)
                    seen_set.add(hid); seen.append(hid)
                    if coin > 0:
                        _bs = str(ho.get("symbol") or b["symbol"]).split("-")[0]
                        lf = st.setdefault("_ri_left", {}); lf[_bs] = round(float(lf.get(_bs) or 0) + coin, 10)
                        lw = st.setdefault("_ri_left_w", {}).setdefault(_bw, {}); lw[_bs] = round(float(lw.get(_bs) or 0) + coin, 10)
                        st.setdefault("_ri_left_log", {})[hid] = coin
                        done.append((str(ho.get("symbol") or b["symbol"]), _bs, coin, float(ho.get("avg_px") or 0), [], coin,
                                     str(ho.get("why") or "") + " · " + _why))
                continue
            tot_pct = sum(float(a.get("coin_pct") or 0) for a in mine)
            scale = 100.0 / tot_pct if tot_pct > 100.0 else 1.0
            for ho in sorted(his, key=lambda h: float(h.get("ts") or 0)):
                hid, coin, avg = ho["id"], float(ho.get("coin") or 0), float(ho.get("avg_px") or 0)
                if coin <= 0 or avg <= 0:
                    seen_set.add(hid); seen.append(hid)
                    continue
                sym = str(ho.get("symbol") or b["symbol"])
                base = sym.split("-")[0]
                given, rows = 0.0, []
                for a in mine:
                    q = round(coin * float(a.get("coin_pct") or 0) / 100.0 * scale, 10)
                    if q <= 0:
                        continue
                    e = st.setdefault(a["id"], {"pending": 0.0, "coin": 0.0, "spent": 0.0, "buys": []})
                    e["coin"] = round(float(e.get("coin", 0)) + q, 10)
                    e["spent"] = round(float(e.get("spent", 0)) + q * avg, 6)
                    e["buys"] = ([{"ts": time.time(), "qty": round(q, 10), "usd": round(q * avg, 6),
                                   "px": round(avg, 10), "why": "ربح DCA" if str(hid).startswith("dca:") else ("الدوري" if str(hid).startswith("rec:") else "إعادة استثمار"),
                                   "hid": hid}] + list(e.get("buys") or []))[:400]
                    given += q
                    rows.append((a.get("name") or sym, float(a.get("coin_pct") or 0), q, e["coin"],
                                 (e["spent"] / e["coin"]) if e["coin"] > 0 else 0.0))
                left = round(coin - given, 10)
                if left > 1e-12:                           # 👛 الباقي بقصد (نسبة أقل من 100%) — للرقابة
                    lf = st.setdefault("_ri_left", {})
                    lf[base] = round(float(lf.get(base) or 0) + left, 10)
                    lw = st.setdefault("_ri_left_w", {}).setdefault(_bw, {}); lw[base] = round(float(lw.get(base) or 0) + left, 10)
                    ll = st.setdefault("_ri_left_log", {})          # 🧾 باقي كل تسليم بمعرّفه — للتدقيق
                    ll[hid] = left
                seen_set.add(hid)
                seen.append(hid)
                done.append((sym, base, coin, avg, rows, left, str(ho.get("why") or "")))
        if not done:
            return 0
        # 🔢 v3.25.4: العلامات = كل اللي لسه بسجلات البوتات + آخر 30000 (قبل: آخر 3000 بس — بوتات كثيرة ⇒ تسليم قديم ينعاد مرة ثانية)
        st["_ri_seen"] = list(dict.fromkeys([x for x in seen if x in live_h] + seen[-30000:]))
        ll = st.get("_ri_left_log") or {}
        if len(ll) > 30000:                               # 🧾 باقي التسليمات: القديم اللي طلع من سجلات البوتات بس ينقص
            for _k in [k for k in ll if k not in live_h][:len(ll) - 30000]:
                ll.pop(_k, None)
        _acc_save(st)
    for sym, base, coin, avg, rows, left, why in done:
        _dcah = str(why or "").startswith("ربح DCA")
        _rech = "الدوري" in str(why or "")
        msg = (f"🪙 *{'ربح DCA محرَّر (عملة)' if _dcah else ('ربح الدوري محرَّر (عملة)' if _rech else 'عملة معاد استثمارها')} — {'للمُراكِم' if rows else 'للمحفظة'}*\n`{sym}` · {why or 'تحرير'}\n━━━━━━━━━━━━━\n"
               f"📦 المحرَّر: `{coin:.8f}` {base} @ `{avg:.8f}$` = `{coin * avg:.4f}$`\n━━━━━━━━━━━━━\n")
        for nm, pc, q, tq, ta in rows:
            msg += f"🏧 {_tp_md(nm)}: `{pc:.0f}%` ← `{q:.8f}` {base} · صار عنده `{tq:.8f}` بمعدل `{ta:.8f}$`\n"
        if left > 1e-12:
            msg += f"👛 {'تحررت للمحفظة' if not rows else 'بقى بالمحفظة'}: `{left:.8f}` {base}\n"
        msg += ("بلا شراء وبلا عمولة — انضافت مباشرة ومعدلها اندمج" if rows else "ماكو مُراكِم مفتوح على هالعملة بنفس المحفظة — بقت حرة بمحفظتك")
        tg_send(msg)
        log_event(f"🪙 [إعادة استثمار] {sym}: سُلّم {coin - left:.8f}/{coin:.8f} {base} @ {avg:.8f}$ "
                  f"({why}) على {len(rows)} مُراكِم · الباقي {left:.8f} للمحفظة")
    return len(done)


