</div>

<script>
const $=s=>document.querySelector(s);
let DATA=null,CUR=null,lastTotal=null,REPKIND='daily',REPSRC='main',repChart=null;
const CARDS=new Map(),SPR=new Map();

/* ── PIN + API ── */
function H(){const p=localStorage.getItem('dash_pin');return p?{'X-Dash-Pin':p,'Content-Type':'application/json'}:{'Content-Type':'application/json'}}
/* ⏳ v3.26.0: أي تحميل (طلب أو تنزيل) أطول من 0.18 ثانية ⇒ الشعار بالشريط يتحرك (0.9 ثانية على الأقل حتى ما يرمش) ·
   التحديث الدوري للأرقام (كل 3 ثواني) ساكت */
var BUSY={n:0,t:null,on:0,since:0};
function busySet(d){BUSY.n=Math.max(0,BUSY.n+d);const R=document.documentElement;
  if(BUSY.n>0){if(!BUSY.on&&!BUSY.t)BUSY.t=setTimeout(()=>{BUSY.t=null;if(BUSY.n>0){BUSY.on=1;BUSY.since=Date.now();R.classList.add('busy')}},180)}
  else{if(BUSY.t){clearTimeout(BUSY.t);BUSY.t=null}
    if(BUSY.on)setTimeout(()=>{if(BUSY.n===0&&BUSY.on){BUSY.on=0;R.classList.remove('busy')}},Math.max(0,900-(Date.now()-BUSY.since)))}}
const LDR_SVG='__BRAND_LDR__';
function LDR(t){return `<div class="ldr">${LDR_SVG}<span>${t||''}</span></div>`}
async function api(path,body,quiet){if(quiet)return api0(path,body);busySet(1);try{return await api0(path,body)}finally{busySet(-1)}}
async function api0(path,body){
  const r=await fetch(path,body?{method:'POST',headers:H(),body:JSON.stringify(body)}:{headers:H()});
  if(r.status===401){       // 🔒 الجلسة انتهت أو غير مصرّح — رجوع لصفحة الدخول
    if(!window.__locked){window.__locked=1;
      try{document.body.innerHTML='<div style="height:100vh;display:flex;align-items:center;justify-content:center;color:#8b95a7;font-family:system-ui">🔒 انتهت الجلسة — إعادة التوجيه…</div>'}catch(e){}
      setTimeout(()=>location.reload(),600);}
    throw 0}
  return r.json()}
async function ctl(dir,action,value){try{const r=await api('/api/control',{dir,action,value});toast(r.msg,r.ok);tick()}catch(e){toast('تعذر الاتصال','0')}}
function g(action,value){ctl('',action,value)}
function goTop(){window.scrollTo({top:0,behavior:'smooth'})}
/* 📱 الشريط المصغّر: يظهر بالموبايل لما يطلع الشريط الكبير من الشاشة */
function mbarSync(){const h=$('#top');if(h)document.body.classList.toggle('pastTop',h.getBoundingClientRect().bottom<0)}
addEventListener('scroll',mbarSync,{passive:true});

/* ── نابض الأرقام (فيزياء framer: k=75 c=15 m=.8) ── */
function spring(el,fmt){let x=0,v=0,t=0,raf=null,init=false;
  function step(){const dt=1/60,a=(-75*(x-t)-15*v)/.8;v+=a*dt;x+=v*dt;
    if(Math.abs(x-t)<.0004&&Math.abs(v)<.002){x=t;v=0;el.textContent=fmt(x);raf=null;return}
    el.textContent=fmt(x);raf=requestAnimationFrame(step)}
  return{set(n){if(!isFinite(n))n=0;if(!init){init=true;x=n;t=n;el.textContent=fmt(n);return}
    if(Math.abs(n-t)<1e-9)return;t=n;if(raf==null)raf=requestAnimationFrame(step)}}}
const f2=x=>x.toFixed(2),f4=x=>{const a=Math.abs(x);return(a>0&&a<0.001)?x.toFixed(Math.min(12,3-Math.floor(Math.log10(a)))):x.toFixed(4)};

/* ── توست + صوت ── */
let toastT=null;
function toast(msg,ok){const t=$('#toast');t.textContent=msg||'…';t.className=(ok===false||ok==='0')?'err show':'show';
  clearTimeout(toastT);toastT=setTimeout(()=>t.classList.remove('show'),3600)}
function chime(){try{const c=new(window.AudioContext||window.webkitAudioContext)();const g=c.createGain();g.gain.value=.06;g.connect(c.destination);
  [880,1320].forEach((f,i)=>{const o=c.createOscillator();o.frequency.value=f;o.type='sine';o.connect(g);o.start(c.currentTime+i*.09);o.stop(c.currentTime+.09+i*.09)})}catch(e){}}
function toggleSound(){const off=localStorage.getItem('dash_sound')==='off';localStorage.setItem('dash_sound',off?'on':'off');
  toast(off?'🎵 صوت الربح شغال':'🔇 صوت الربح مطفي',true)}     // ⚙️ v3.21.7: الزر انتقل للإعدادات
function soundOn(){return localStorage.getItem('dash_sound')!=='off'}

/* ════════ مركز الإشعارات الداخلي ════════ */
const NOTIF_MAX=20;          // السجل يحتفظ بآخر 20 إشعار فقط
let NOTIFS=[],NSEEN=new Set(),npOpen=false,npReady=false;
function npSoundOn(){return localStorage.getItem('np_sound')!=='off'}
function saveNpSound(){localStorage.setItem('np_sound',$('#npSound').checked?'on':'off')}
$('#npSound').checked=npSoundOn();
// نغمة إشعار (مختلفة عن نغمة الربح)
function notifBeep(){if(!npSoundOn())return;try{const c=new(window.AudioContext||window.webkitAudioContext)();
  const g=c.createGain();g.gain.value=.05;g.connect(c.destination);
  const o=c.createOscillator();o.frequency.value=660;o.type='triangle';o.connect(g);
  o.start();o.frequency.exponentialRampToValueAtTime(990,c.currentTime+.12);o.stop(c.currentTime+.14)}catch(e){}}
// أيقونة حسب نوع الحدث
function notifIcon(msg){
  if(/💵/.test(msg))return'💵';                // 💵 v3.21.8 (ب٢٤): الدولار الحر مقابل الأمر المجمّع
  if(/رفض|فشل|انقطع|🔌|⚠/.test(msg))return'⚠️';
  if(/ربح|PROFIT|💰|💎/.test(msg))return'💰';
  if(/مخزن|📦|تجميع/.test(msg))return'📦';
  if(/درع|🛡|🚨|PANIC|سكين/.test(msg))return'🛡️';
  if(/شراء|🟢/.test(msg))return'🟢';        // قبل البيع: سطر الشراء فيه «تجهيز بيع»
  if(/بيع|🔴/.test(msg))return'🔴';
  if(/عاد|🌐/.test(msg))return'🌐';
  return'🔔'}
function toggleNotif(){npOpen=!npOpen;$('#notifPanel').classList.toggle('on',npOpen);
  $('#npScrim').classList.toggle('on',npOpen);document.body.classList.toggle('npopen',npOpen);   // 🔔 v3.21.7: درج + خلفية معتمة
  if(npOpen){$('#bellDot').style.display='none';renderNotif();markAllSeen()}}
/* 👉 سحب الدرج لليمين يسكّره */
(()=>{const p=$('#notifPanel');let x0=null,y0=0;
  p.addEventListener('touchstart',e=>{const t=e.touches[0];x0=t.clientX;y0=t.clientY},{passive:true});
  p.addEventListener('touchend',e=>{if(x0===null)return;const t=e.changedTouches[0],dx=t.clientX-x0,dy=Math.abs(t.clientY-y0);x0=null;
    if(npOpen&&dx>70&&dy<60)toggleNotif()},{passive:true})})();
function markAllSeen(){NOTIFS.forEach(n=>n.seen=true)}
function clearNotif(){NOTIFS=[];renderNotif();$('#bellDot').style.display='none'}
function renderNotif(){
  const body=$('#npBody');$('#npCount').textContent=NOTIFS.length;
  if(!NOTIFS.length){body.innerHTML='<div class="npempty">لا إشعارات بعد — راح تظهر هنا فور حدوثها</div>';return}
  body.innerHTML=NOTIFS.map((n,i)=>`<div class="nitem ${n.seen?'':'fresh'}${n.dir&&CARDS.has(n.dir)?' ngo':''}" data-i="${i}" title="${n.dir&&CARDS.has(n.dir)?'اضغط ⇒ كرت البوت':''}"><span class="nicon">${notifIcon(n.msg)}</span><div class="nbody"><div class="ntext"><b>${n.base||''}</b> ${(n.msg||'').replace(/[*`]/g,'').replace(/</g,'&lt;')}</div><div class="ntime">${n.time||''}</div></div></div>`).join('');
  body.onclick=ev=>{const it=ev.target.closest('.nitem.ngo');if(!it)return;const n=NOTIFS[+it.dataset.i];if(n&&n.dir)holyGo('bot:'+n.dir)}}
async function pollNotif(){
  try{const feed=await api('/api/feed');
    if(Array.isArray(feed)){
      // أول تحميل: نملأ السجل بصمت (بلا نغمة) ونعلّم الكل مرئي
      if(!npReady){
        NOTIFS=feed.slice(0,NOTIF_MAX).map(e=>({...e,seen:true}));
        feed.forEach(e=>NSEEN.add((e.time||'')+e.msg));
        npReady=true;renderNotif();
      }else{
        let fresh=0;
        // الأحدث أولاً؛ نمر عكسياً لإضافتها بالترتيب الصحيح
        for(let i=feed.length-1;i>=0;i--){const e=feed[i];const k=(e.time||'')+e.msg;
          if(!NSEEN.has(k)){NSEEN.add(k);NOTIFS.unshift({...e,seen:npOpen});fresh++}}
        if(fresh>0){
          if(NOTIFS.length>NOTIF_MAX)NOTIFS=NOTIFS.slice(0,NOTIF_MAX);  // امسح الأقدم
          renderNotif();notifBeep();
          if(!npOpen){$('#bellDot').style.display='';}
          // توست للأحدث
          const top=NOTIFS[0];if(top)toast(`${notifIcon(top.msg)} ${top.base}: ${(top.msg||'').replace(/[*`]/g,'').slice(0,60)}`,true);
        }
      }
    }
  }catch(e){}
  setTimeout(pollNotif,document.hidden?20000:3000)}
pollNotif();

/* ── بناء البطاقة (مرة واحدة) ── */
function buildCard(b,i){
  if(b.bot_type==='dca'||b.bot_type==='dca_buy')return buildDcaCard(b,i);
  if(b.bot_type==='rec_va')return buildVaCard(b,i);   // 💹 v3.34.0
  if(b.bot_type==='rec_buy'||b.bot_type==='rec_sell')return buildRecCard(b,i);   // 🔁 v3.25.0: الدوري
  const el=document.createElement('div');el.className='card';el.style.setProperty('--i',i);el.dataset.dir=b.dir;
  const BASE=b.symbol.split('-')[0];
  el.innerHTML=`
  <div class="chead"><span class="sym"><img class="coin" src="https://assets.coincap.io/assets/icons/${BASE.toLowerCase()}@2x.png" data-alt="https://static.okx.com/cdn/oksupport/asset/currency/icon/${BASE.toLowerCase()}.png" onerror="cfb(this,'${BASE}')"> ${b.symbol}</span>${b.demo?'<span class="chip demo">تجريبي</span>':''}
    <span class="gtb ctag" title="نوع الشبكة">${gtLabel(b)}</span><span class="pill off" data-k="pill">—</span><span class="hbadge" data-k="hb" style="display:none;cursor:pointer"></span></div>
  <div class="cmain">
    <div><div class="big"><span class="num" data-k="profit">0.0000</span><span class="u"> $</span></div>
      <div class="delta z" data-k="delta">اليوم —</div>
      <div class="pricebox"><span class="plabel">السعر</span><span class="num bigprice" data-k="cp">—</span><span class="ptrend" data-k="ptrend"></span></div></div>
    <div class="bench"><div class="btrack"><div class="bfill" data-k="bfill"></div><div class="bavg" data-k="bavg"></div></div>
      <div class="blbl"><span>متوسط البوتات</span><span class="num" data-k="bavgv">0.00</span></div></div>
  </div>
  <div class="cchart" data-k="cchart" style="display:none"></div>
  <div class="rows">
    <div class="row"><span class="ic">🔺</span><span class="nm">أدنى بيع</span><b class="num" data-k="lsell">—</b></div>
    <div class="row"><span class="ic">🔻</span><span class="nm">أعلى شراء</span><b class="num" data-k="hbuy">—</b></div>
