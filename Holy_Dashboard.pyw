        return {"ok": True, "msg": f"💰 أمر {_t} الفوري أُرسل — البوت يغلق الدورة بالسعر الحالي"}
    if action in ("last_on", "last_off"):
        if b["cfg"].get("bot_type") not in ("dca", "dca_buy"):
            return {"ok": False, "msg": "«آخر دورة» لبوتات DCA بس"}
