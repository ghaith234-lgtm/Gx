def ledger_tick():
    led = load_json(LEDGER) or {}
    today = datetime.now().strftime("%Y-%m-%d")
    changed = False
    for b in bot_dirs().values():
        # 🛡️ إصلاح: الديمو وبوتات DCA خارج سجل الدولار
        #   • الديمو معزول تماماً (لا يلوّث الأرقام الحقيقية)
        #   • DCA ربحه بالعملة (total_coin_profit) ولا يكتب total_profit إطلاقاً،
        #     فإدخاله يقرأ صفراً ويصفّر خط الأساس → تضخّم لا نهائي بالسجل
        if b["cfg"].get("is_demo") or b["cfg"].get("bot_type") == "dca":
            continue
        sp, _, _ = paths_of(b)
        st = load_json(sp) or {}
        if b["cfg"].get("bot_type") == "dca_buy":
            # 💵 v3.22.1 (ح٧): ربح DCA الشرائي دولار صافي = ربح تداول + ربح محرَّر ⇒ الدفتر اليومي ⇒ المُراكِم ياخذ نسبته.
            #    من سجل الدورات بمعرّفاتها (كل دورة مرة وحدة · الدورات قبل v3.22.1 ما تنحسب) · يوم ما شافها الدفتر (مثل الجرد)
            key = os.path.relpath(b["dir"], ROOT)
            ent = led.get(key) if isinstance(led.get(key), dict) else None
            if ent is None:
                ent = {"symbol": b["symbol"], "dca": True, "daily": {}, "monthly": {}, "trades_daily": {}, "hourly": {}, "dca_seen": []}
            seen = list(ent.get("dca_seen") or [])
            sset = set(seen)
            for c in (st.get("cycles_log") or []):
                cid = str(c.get("id") or "")
                if not cid or cid in sset:
                    continue
                try:
                    pv = float(c.get("profit") or 0)
                except Exception:
                    continue
                ent.setdefault("daily", {})[today] = round(float(ent["daily"].get(today, 0.0)) + pv, 6)
                ent.setdefault("trades_daily", {})[today] = int(ent["trades_daily"].get(today, 0)) + 1
                seen.append(cid); sset.add(cid)
                changed = True
            ent["dca_seen"] = seen[-600:]
            led[key] = ent
            continue
        tot = float(st.get("total_profit") or 0)
        # 🔑 إصلاح: المفتاح = مجلد البوت (كان الرمز فقط → تصادم لو بوتان بنفس العملة)
        key = os.path.relpath(b["dir"], ROOT)
        ent = led.get(key)
        if ent is None:
            # ترحيل: لو السجل القديم مفتاحه الرمز، ننقله كما هو للمفتاح الجديد
            legacy = led.get(b["symbol"])
            if isinstance(legacy, dict) and "last_seen_total" in legacy:
                ent = legacy; led.pop(b["symbol"], None); changed = True
                # 🛡️ خط الأساس القديم قد يكون مصفَّراً بسبب تصادم DCA السابق.
                #    نثبّته على الربح الحالي فوراً حتى لا يُحسب التراكمي كربح جديد.
                #    (يحفظ تاريخك اليومي كما هو — بلا حاجة لتصفير السجل)
                ent["last_seen_total"] = tot
                ent["_migrated"] = datetime.now().strftime("%Y-%m-%d %H:%M")
            else:
                ent = {"last_seen_total": 0.0, "daily": {}, "monthly": {}, "trades_daily": {}, "hourly": {}}
        ent.setdefault("symbol", b["symbol"])
        led[key] = ent
        last = float(ent.get("last_seen_total", 0))
        diff = tot - last
        if diff > 1e-9:
            diff = diff * _safe(net_factor, b, default=1.0)   # 📉 صافي بعد العمولة
            ent.setdefault("daily", {})[today] = round(ent.get("daily", {}).get(today, 0.0) + diff, 6)
            ent["last_seen_total"] = tot
            changed = True
        elif diff < -1e-9:           # البوت انبنى من جديد/تصفّر — نزّل خط الأساس بلا خصم
            ent["last_seen_total"] = tot
            changed = True
    if changed:
        try: save_json_atomic(LEDGER, led)
        except Exception: pass
    return led

