            "sl_far": (_safe(_step_sl_far, st, default=None) if _bt == "grid_step" else None),     # 🪜 v3.36.20: الباقي مختصر
            "vbuy_usd": (round(sum(float(v.get("target_price") or 0) * float(v.get("locked_qty") or 0)
