        if text and text[0] == "\ufeff":
            text = text[1:]
        norm = "\n".join(ln.rstrip() for ln in text.replace("\r\n", "\n").replace("\r", "\n").split("\n")).strip()
        return _hl.sha1(norm.encode("utf-8")).hexdigest()[:8]
    except Exception:
        return "0"

