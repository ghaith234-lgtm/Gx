def _gd_empty():
    return {"v": 2, "auto_fix": False, "paused": False, "wallets": {}, "events": [],
            "bots": {}, "tg": {}, "legacy": {}, "scan_ts": 0, "scan_n": 0}


def _gd_migrate(old):
    """🔧 ترحيل ملف v3.9 (مفتاحه رمز الزوج) إلى v2 (مفتاحه المحفظة + العملة).
    ولا تسوية تضيع: كل `adj` قديم ينتقل مع سطر «ترحيل» بسجلها."""
    new = _gd_empty()
    new["paused"] = bool((old or {}).get("paused"))
    bots_old = (old or {}).get("bots") or {}
    if not bots_old:
        return new
    try:                                   # نسخة من الملف القديم قبل أي تغيير
        bk = GUARD_FILE.replace(".json", ".v1.json")
        if not os.path.exists(bk):
            save_json_atomic(bk, old)
    except Exception:
        pass
    by_sym = {}
    for b in bot_dirs().values():
        c = b.get("cfg") or {}
        if c.get("is_demo") or not (c.get("api_key") and c.get("secret_key") and c.get("passphrase")):
            continue
        by_sym.setdefault(b["symbol"], []).append(b)
    for sym, e in bots_old.items():
        try:
            adj = float((e or {}).get("adj") or 0.0)
        except Exception:
            adj = 0.0
        if abs(adj) < 1e-12:
            continue
        cands = by_sym.get(sym) or []
        wids = {_gd_wid(b["cfg"].get("api_key")) for b in cands}
        if len(wids) == 1:
            c = _gd_coin(new, wids.pop(), sym.split("-")[0])
            _gd_hist(c, "migrate", adj, note=f"ترحيل تسوية v3.9 (كانت على {sym})",
                     by="🔧 ترحيل", px=float((e or {}).get("px") or 0))
        elif wids:
            # v3.9 كان يخلط كل بوتات الزوج بمفتاح واحد ⇒ لو الزوج على أكثر من محفظة
            # ما نعرف لمن تعود التسوية — ما نخمّن: تبقى ظاهرة بقسم «قديم» وقرارها إلك
            new["legacy"][sym] = {"adj": adj, "note": f"غامضة: الزوج على {len(wids)} محافظ — راجعها يدوياً"}
        else:
            new["legacy"][sym] = {"adj": adj, "note": "تسوية قديمة لزوج ما عليه بوت الآن"}
    try:
        log_event(f"🛡️ [الرقابة] ترحيل v1→v2: {len(bots_old)} بند · "
                  f"{len(new['legacy'])} بلا بوت")
    except Exception:
        pass
    return new


def _gd_load():
    """📂 يقرا ملف الرقابة. ملف تالف ⇒ نسخة احتياطية قبل أي كتابة (ولا تسوية تنمحي)."""
    g = load_json(GUARD_FILE)
    if g is None and os.path.exists(GUARD_FILE):
        try:
            if os.path.getsize(GUARD_FILE) > 0:
                bad = GUARD_FILE.replace(".json", f".corrupt-{int(time.time())}.json")
                shutil.copy2(GUARD_FILE, bad)
                log_event(f"⚠️ [الرقابة] الملف تالف — انحفظت نسخته: {os.path.basename(bad)}")
        except Exception:
            pass
    if not isinstance(g, dict):
        g = {}
    if g.get("v") != 2:
        g = _gd_migrate(g)       # كل المستدعين ماسكين _GUARD_IO (RLock) ⇒ الحفظ هنا آمن
        _gd_save(g)              # نحفظ فوراً — وإلا الترحيل يتكرر بكل نبضة للواجهة
    base = _gd_empty()
    for k, v in base.items():
        g.setdefault(k, v)
    return g


def _gd_save(g):
    try:
        save_json_atomic(GUARD_FILE, g)
        return True
    except Exception as e:
        try:
            log_event(f"⚠️ [الرقابة] تعذّر الحفظ: {type(e).__name__}")
        except Exception:
            pass
        return False


def _gd_wid(api_key):
    """🔑 معرّف محفظة ثابت عبر الإقلاعات — بصمة من المفتاح، ولا حرف منه يُخزَّن."""
    import hashlib as _h
    return "w" + _h.sha256(("holy-guard|" + str(api_key or "").strip()).encode("utf-8")).hexdigest()[:10]


def _gd_wallet(g, wid):
    W = g["wallets"].setdefault(wid, {})
    for k, v in (("coins", {}), ("quotes", {}), ("orders", {}), ("cursor", 0),
                 ("seen_ev", []), ("acc_seen", {}), ("label", ""), ("err", "")):
        W.setdefault(k, v)
    W["orders"].setdefault("seen", {})
    W["orders"].setdefault("missing", {})
    W["orders"].setdefault("stray", {})
    return W


def _gd_coin(g, wid, ccy):
    W = _gd_wallet(g, wid)
    c = W["coins"].setdefault(ccy, {})
    for k, v in (("adj", 0.0), ("hist", []), ("trim_sum", 0.0), ("strike", 0),
                 ("first_over", 0), ("ok_streak", 0), ("pev", [])):
        c.setdefault(k, v)
    return c


def _gd_hist(c, kind, qty, note="", by="", px=0.0, ev=None, exp=None, act=None):
    """📜 سطر بسجل التسويات — منو ومتى وليش وبكم.
    الثابت المحاسبي: adj == trim_sum + Σ(qty لكل الأسطر) — يُفحص بالفحص الذاتي."""
    qty = round(float(qty), 10)
    c["adj"] = round(float(c.get("adj") or 0.0) + qty, 10)
    h = {"ts": time.time(), "kind": kind, "qty": qty, "adj": c["adj"],
         "note": str(note or "")[:240], "by": str(by or "")[:60]}
    try:
        if px and float(px) > 0:
            h["px"] = float(px)
            h["usd"] = round(qty * float(px), 4)
    except Exception:
        pass
    if ev:
        h["ev"] = [str(x)[:160] for x in ev][:12]
    if exp is not None:
        h["exp"] = round(float(exp), 10)
    if act is not None:
        h["act"] = round(float(act), 10)
    c.setdefault("hist", []).insert(0, h)
    if len(c["hist"]) > GUARD_MAX_HIST:
        cut = c["hist"][GUARD_MAX_HIST:]
        c["trim_sum"] = round(float(c.get("trim_sum") or 0.0)
                              + sum(float(x.get("qty") or 0) for x in cut), 10)
        c["hist"] = c["hist"][:GUARD_MAX_HIST]
    return h


def _gd_book_hist(c, dq, now, px=0.0):
    """🧾 قيد تلقائي **واحد لكل يوم** (مو لكل فحص): مطابقة الدفتر بتنفيذات المنصة.

    يحفظ الثابت المحاسبي بالبناء: التسوية تنعاد حسابها = المقصوص + Σ القيود."""
    h = c.setdefault("hist", [])
    day = datetime.fromtimestamp(now).strftime("%Y-%m-%d")
    if h and h[0].get("kind") == "book" and h[0].get("day") == day:
        e = h[0]
        e["qty"] = round(float(e.get("qty") or 0) + float(dq), 10)
        e["n"] = int(e.get("n") or 1) + 1
        e["ts"] = now
        if px and float(px) > 0:
            e["px"], e["usd"] = float(px), round(e["qty"] * float(px), 4)
    else:
        e = _gd_hist(c, "book", dq, note="🤖 مطابقة الدفتر بتنفيذات المنصة — بيع من مخزونك أعلى السلّم "
                                          "وعمولة الشراء المخصومة بالعملة (حركة داخلية، مو فرق حقيقي)",
                     by="🤖 الرقابة", px=px)
        e["day"], e["n"] = day, 1
    c["adj"] = round(float(c.get("trim_sum") or 0.0) + sum(float(x.get("qty") or 0) for x in c["hist"]), 10)
    e["adj"] = c["adj"]
    return e


def _gd_event(g, key, sev, title, detail="", wid="", sym="", kind="", status="open",
              tg=True, extra=None):
    """🗒️ حدث بخط الزمن — نفس المفتاح وهو مفتوح ⇒ يتحدّث بدل ما يتكرر."""
    now = time.time()
    for e in g["events"]:
        if e.get("key") == key and e.get("status") in ("open", "info"):
            e["seen"] = now
            e["detail"] = str(detail or "")[:600]
            e["sev"] = sev
            e["title"] = str(title or "")[:200]
            if extra:
                e.update(extra)
            return e
    import secrets as _s
    e = {"id": "e" + str(int(now * 1000)) + _s.token_hex(2), "key": key, "ts": now, "seen": now,
         "sev": sev, "kind": kind, "title": str(title or "")[:200],
         "detail": str(detail or "")[:600], "wid": wid, "sym": sym, "status": status,
         "tg": (not tg)}          # tg=True ⇒ ينتظر إرسالاً (False = لسه ما انرسل)
    if extra:
        e.update(extra)
    g["events"].insert(0, e)
    if len(g["events"]) > GUARD_MAX_EVENTS:
        g["events"] = g["events"][:GUARD_MAX_EVENTS]
    return e


def _gd_resolve(g, key, note=""):
    """✅ حدث مفتوح زالت أسبابه ⇒ «انحلّ» (يبقى بالسجل)."""
    hit = None
    for e in g["events"]:
        if e.get("key") == key and e.get("status") == "open":
            e["status"] = "resolved"
            e["resolved"] = time.time()
            if note:
                e["rnote"] = str(note)[:200]
            hit = e
    return hit


def _gd_md(s):
    """نص آمن لـMarkdown تيليغرام — الرموز الخاصة تكسر الرسالة فتضيع."""
    return re.sub(r"[_*`\[\]]", " ", str(s or ""))


def _gd_bot_ids(b):
    """🆔 بادئات clOrdId المحتملة للبوت — نفس معادلة المحرك بالضبط (بلا لمسه)."""
    import hashlib as _h
    cfg = b.get("cfg") or {}
    out = []
    bid = str(cfg.get("bot_id") or "").strip()
    if bid:
        out.append(bid)
    pre = "HD" if cfg.get("bot_type") in _GD_DCA else "HB"
    for d in {os.path.abspath(b["dir"]), os.path.realpath(b["dir"])}:
        out.append(pre + _h.md5(d.encode("utf-8")).hexdigest()[:10].upper())
    return [x for x in dict.fromkeys(out) if x]


_GD_RX_BUY = re.compile(r"\[شراء فوري\]\s*السعر:\s*([0-9.eE+-]+)")
_GD_RX_SELL = re.compile(r"\[(?:بيع فوري|ربح داخلي)\]\s*السعر:\s*([0-9.eE+-]+)")
_GD_RX_BATCH = re.compile(r"\[تجميع (?:ال)?(?:شراء|بيع) مؤكد\].*?بمتوسط سعر\s*\(([0-9.eE+-]+)\)")   # المحرك يكتب «تجميع بيع» (بلا «ال»)
_GD_RX_DCA_FILL = re.compile(r"^🔴 بيع (?:أساسي|أمان \d+) — ([0-9.eE+-]+)")
_GD_RX_DCA_CLOSE = re.compile(r"إغلاق الدورة")
_GD_RX_REJECT = re.compile(r"\[(?:رفض أمر شراء|رفض أمر بيع|فشل تجميع)")


def _gd_hist_scan(hp, is_dca=False, now=None):
    """📜 من سجل صفقات البوت: آخر تنفيذ (وقته وسعره) · آخر دورة · رفض حديث."""
    out = {"fill_ts": 0.0, "fill_px": 0.0, "cycle_ts": 0.0, "reject_ts": 0.0}
    now = now or time.time()
    try:
        h = load_json(hp) or []
    except Exception:
        h = []
    if not isinstance(h, list):
        return out
    for e in h[:400]:
        try:
            msg = str(e.get("msg") or "")
            ts = time.mktime(time.strptime(str(e.get("time")), "%Y-%m-%d %H:%M:%S"))
        except Exception:
            continue
        if not out["reject_ts"] and _GD_RX_REJECT.search(msg):
            out["reject_ts"] = ts
        if is_dca:
            m = _GD_RX_DCA_FILL.search(msg)
            if m and not out["fill_ts"]:
                out["fill_ts"], out["fill_px"] = ts, float(m.group(1))
            if not out["cycle_ts"] and _GD_RX_DCA_CLOSE.search(msg):
                out["cycle_ts"] = ts
                if not out["fill_ts"]:
                    out["fill_ts"] = ts
        else:
            ms = _GD_RX_SELL.search(msg)
            mb = _GD_RX_BUY.search(msg) if not ms else None
            mc = _GD_RX_BATCH.search(msg) if not (ms or mb) else None
            m = ms or mb or mc
            if m and not out["fill_ts"]:
                try:
                    out["fill_ts"], out["fill_px"] = ts, float(m.group(1))
                except Exception:
                    pass
            if ms and not out["cycle_ts"]:
                out["cycle_ts"] = ts
        if out["fill_ts"] and out["cycle_ts"] and out["reject_ts"]:
            break
    return out


def _gd_rungs(st, is_dca):
    """🪜 كل أسعار الدرجات الموجودة بحالة البوت (حي + ذاكرة + مخزن) لكل جهة."""
    r = {"buy": [], "sell": []}
    try:
        if is_dca:
            for i in (st.get("active_sells") or {}).values():
                r["sell"].append(float(i.get("price") or 0))
            for i in (st.get("pending_levels") or []):
                r["sell"].append(float(i.get("price") or 0))
        else:
            for side, keys in (("buy", ("limit_buys", "virtual_buys", "accum_buys")),
                               ("sell", ("limit_sells", "virtual_sells", "accum_sells"))):
                for k in keys:
                    for i in (st.get(k) or {}).values():
                        try:
                            r[side].append(float(i.get("target_price") or 0))
                        except Exception:
                            continue
    except Exception:
        pass
    return {k: [x for x in v if x > 0] for k, v in r.items()}


