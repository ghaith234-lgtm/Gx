    e["ts"] = now
    d = e.get("d") or {}
    start = time.strftime("%Y-%m-%d", time.gmtime((max(int(k) for k in d) - 10 * _PRO_DAY) if d else now - 3 * 365 * _PRO_DAY))
    j = _http_json(f"https://api.frankfurter.app/{start}..?from=USD&to=EUR,JPY,GBP,CAD,SEK,CHF", timeout=25)
