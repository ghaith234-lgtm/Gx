      rs.parentElement.title=r.rsi>=70?'مشترى زايد — احتمال تصحيح':r.rsi<=30?'مباع زايد — منطقة شراء تاريخياً':'متوازن';
      const at=e.querySelector('.iatr'); at.textContent=gN(r.atr,2)+'%';
