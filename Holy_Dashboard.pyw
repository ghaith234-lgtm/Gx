            try:
                sp, hp, _lp = paths_of(b)
                put(f"bots/{sym}/state.json", load_json(sp) or {})
                hist = load_json(hp) or []
                put(f"bots/{sym}/history.json", hist[:3000] if isinstance(hist, list) else hist)
