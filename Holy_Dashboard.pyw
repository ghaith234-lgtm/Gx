# المصطلحات (v3.11):
#   💵 الربح المحرر      = الدولار اللي طلع من البوتات ربحاً عادياً (السجل اليومي) — يدخل الربح اليومي والمُراكِم
#   🔄 ربح التداول       = كل ربح البيعات = بدون إعادة استثمار + 💠 المعاد استثماره
#   📈 إجمالي التداول    = إجمالي المحرر + 💠 اللي لسه داخل الأوامر + 💠 اللي تسلّمه المُراكِم عملةً
# الفرق بين المحرر و«بدون» = تحرير أرباح إعادة استثمار قديمة (مو ربح تداول جديد — ما ينحسب مرتين)
_TP_WD = ("الاثنين", "الثلاثاء", "الأربعاء", "الخميس", "الجمعة", "السبت", "الأحد")
_HDP_CACHE = {}


def _tp_cnt(n, one, two, few, many):
    """عدد بالعربي الصحيح: بيعة وحدة · بيعتين · 5 بيعات · 12 بيعة."""
    n = int(n)
    if n == 1:
        return one
    if n == 2:
        return two
    return f"{n} {few}" if 3 <= n % 100 <= 10 else f"{n} {many}"


def _tp_wd(day):
    try:
        return _TP_WD[datetime.strptime(day, "%Y-%m-%d").weekday()]
    except Exception:
        return ""


def _tp_md(s):
    """نص متغيّر داخل رسالة Markdown — نهرّب علاماتها حتى ما ترفضها تيليغرام."""
    s = str(s if s is not None else "")
    for ch in ("_", "*", "`", "["):
        s = s.replace(ch, "\\" + ch)
    return s


def _hist_day_parts(b, days=20):
    """📜 من سجل صفقات بوت واحد، لكل يوم: {n: الحصة العادية × المعامل · r: المعاد استثماره · c: البيعات}.

    البيعة المقسومة تكتب سطرين (💠 فيه «% من» + 🔴 للحصة العادية) ⇒ تنعد **مرة وحدة** من سطر 🔴.
    البيعة 100% تكتب 💠 بس ⇒ تنعد منه. والنسبة صفر تكتب 🔴 بس."""
    try:
        _, hp, _ = paths_of(b)
        mt = os.path.getmtime(hp) if os.path.exists(hp) else 0
        nfv = _safe(net_factor, b, default=1.0)
        since = _books_since()
        ck = (hp, mt, int(days), round(float(nfv), 12), datetime.now().strftime("%Y-%m-%d"), since)
        hit = _HDP_CACHE.get(hp)
        if hit and hit[0] == ck:
            return {k: dict(v) for k, v in hit[1].items()}
        hist = load_json(hp) or []
        cut = max((datetime.now() - timedelta(days=days)).strftime("%Y-%m-%d"), since)   # 📒 قبل «بداية جديدة» ما ينحسب
    except Exception:
        return {}
    out = {}
    for row in hist if isinstance(hist, list) else []:
        if not isinstance(row, dict):
            continue
        day = str(row.get("time") or "")[:10]
        if len(day) != 10 or day < cut:
            continue
        msg = str(row.get("msg") or "")
        m = _RI_RE_IN.search(msg)
        if m:
            e = out.setdefault(day, {"n": 0.0, "r": 0.0, "c": 0})
            e["r"] += float(m.group(1))
            if "% من" not in msg:
                e["c"] += 1
            continue
        m = _RI_RE_SELL.search(msg)
        if m:
            e = out.setdefault(day, {"n": 0.0, "r": 0.0, "c": 0})
            e["n"] += float(m.group(1)) * nfv
            e["c"] += 1
            continue
        m = _RI_RE_CU.search(msg)                          # ⚡ ربح اللحاق (البيع المجمّع) — كان يطيح من ربح التداول
        if m:
            e = out.setdefault(day, {"n": 0.0, "r": 0.0, "c": 0})
            e["n"] += float(m.group(1)) * nfv            # نفس مقياس سطر البيع (المحرك يكتبه قبل المعامل)
            e["c"] += int(m.group(2) or 0)                # كل مستوى بيعة
    _HDP_CACHE[hp] = (ck, {k: dict(v) for k, v in out.items()})
    return out


def _ri_state_of(st):
    """💠 لقطة إعادة الاستثمار من ملف حالة: الربح اللي لسه داخل الأوامر · المسلَّم للمُراكِم · النسبة.

    «داخل الأوامر» = قيمة كل درجة (الحصّالة + النمو × سعر الدرجة) ناقص رأس المال المحقون
    + يتيم + نمو أوامر حيّة تنتظر التفكيك. بسعر الدرجة ⇒ ما يتحرك بحركة السوق."""
    ri = (st or {}).get("reinvest")
    if not isinstance(ri, dict):
        return None
    held = 0.0
    for lv in (ri.get("levels") or {}).values():
        try:
            px = float(lv.get("px") or 0)
            tot = float(lv.get("usd_book") or 0) + float(lv.get("grown_qty") or 0) * px
            cap = min(max(0.0, float(lv.get("inj_book") or 0) + float(lv.get("inj_grown") or 0)), max(0.0, tot))
            held += max(0.0, tot - cap)
        except Exception:
            continue
    held += float(ri.get("orphan_usd") or 0)
    for e in (ri.get("unwind") or {}).values():
        try:
            held += max(0.0, float(e.get("grown_qty") or 0) * float(e.get("px") or 0) - float(e.get("inj") or 0))
        except Exception:
            continue
    pc = ri.get("pct")
    return {"on": bool(ri.get("on")), "held": held, "handoff": float(ri.get("handoff_total") or 0),
            "pct": 100.0 if pc is None else float(pc), "levels": len(ri.get("levels") or {}),
            "used": bool(ri.get("on") or ri.get("levels") or ri.get("unwind")
                         or float(ri.get("handoff_total") or 0) > 0 or float(ri.get("orphan_usd") or 0) > 0)}


def _tp_bots():
    """بوتات الدولار (جرد بأنواعه) — نفس اللي يدخل السجل اليومي: بلا ديمو وبلا DCA وبلا الدوري (دفاترهم من سجل دوراتهم)."""
    out = {}
    for b in bot_dirs().values():
        c0 = b.get("cfg") or {}
        if c0.get("is_demo") or c0.get("bot_type") in _NONGRID:
            continue
        out[os.path.relpath(b["dir"], ROOT)] = b
    return out


def trade_period(start, end):
    """🧮 ربح التداول لفترة (تواريخ شاملة) — لكل عملة ولكل يوم: بدون · 💠 · المحرر · البيعات.

    📚 v3.22.3: الأيام من محرّك واحد (`_pv_per_rows`) — نفس التقرير بالواجهة والشريط والإجماليات بالضبط:
      يوم بيه بيعات بالأرشيف (أو بسجل الصفقات الحي) ⇒ «بدون» n + 💠 r بيوم البيعة (لكل بوت، بإعادة استثمار أو بدون)
      يوم قبل ما يبدي أرشيف البوت ⇒ الدفتر (وقتها المحرر = المكسوب) · DCA الشرائي ⇒ الدفتر (صافي لكل دورة).
    والمحرر من السجل اليومي — فيوم التحرير يطلع المحرر أكبر من «بدون» بمبلغ التحرير، **وما ينحسب ربح تداول مرتين**."""
    d0 = datetime.strptime(start, "%Y-%m-%d")
    d1 = datetime.strptime(end, "%Y-%m-%d")
    days = []
    while d0 <= d1:
        days.append(d0.strftime("%Y-%m-%d"))
        d0 += timedelta(days=1)
    led = load_json(LEDGER) or {}
    arc = load_json(RI_LEDGER) or {}
    if not isinstance(led, dict):
        led = {}
    if not isinstance(arc, dict):
        arc = {}
    abots = arc.get("bots") or {}
    if not isinstance(abots, dict):
        abots = {}
    cur = _tp_bots()
    recb = {os.path.relpath(x["dir"], ROOT): x for x in bot_dirs().values()
            if _is_rec(x) and not (x.get("cfg") or {}).get("is_demo")}
    arcl = _arc_live(abots)                 # نفس نافذة `reinvest_tick` (20 يوم) — الأقدم بالأرشيف أصلاً
    keys = ({k for k, v in led.items() if not str(k).startswith("_") and isinstance(v, dict)}
            | {k for k in arcl if not str(k).startswith("_")} | set(cur))
    per, _ = _pv_per_rows(led, arcl, keys, datetime.strptime(start, "%Y-%m-%d").date(),
                          datetime.strptime(end, "%Y-%m-%d").date(), arc.get("daily") or {}, _ri_keyset(arcl))
    per_day = {d: {"n": 0.0, "r": 0.0, "rel": 0.0, "c": 0} for d in days}
    coins, bots_out = {}, {}
    for key in sorted(keys):
        le = led.get(key) if isinstance(led.get(key), dict) else {}
        ae = arcl.get(key) or {}
        b = cur.get(key)
        sym = (b or {}).get("symbol") or le.get("symbol") or ae.get("symbol") or key
        rs = None
        if b is not None:
            rs = _safe(_ri_state_of, _safe(load_json, paths_of(b)[0], default={}) or {}, default=None)
        elif key in recb:
            rs = _safe(_rec_rs, recb[key], usd=True, default=None)  # 🔁 الدوري الشرائي: 💠 المعاد استثماره داخل البوت (دولار)
        is_ri = bool(rs and rs["used"]) or any(float((v or {}).get("r") or 0) > 0
                                                for v in (ae.get("daily") or {}).values())
        c = coins.setdefault(sym, {"n": 0.0, "r": 0.0, "rel": 0.0, "c": 0, "bots": [], "ri": False,
                                   "held": 0.0, "handoff": 0.0, "pct": None, "on": False})
        c["bots"].append(key)
        if is_ri:
            c["ri"] = True
        if rs:
            c["held"] += rs["held"]
            c["handoff"] += rs["handoff"]
            if rs["used"]:
                pc_cfg = ((b or {}).get("cfg") or {}).get("reinvest_pct")
                c["pct"] = float(pc_cfg) if pc_cfg is not None else rs["pct"]
                c["on"] = c["on"] or rs["on"]
        bref = bots_out.setdefault(key, {"sym": sym, "n": 0.0, "r": 0.0, "rel": 0.0, "c": 0, "ri": is_ri})
        rows = per.get(key) or {}
        tdl = le.get("trades_daily") or {}
        for d in days:
            x = rows.get(d)
            if not x:
                continue
            n, r, k, rel = x[0], x[1], x[2], x[3]
            if k is None:                   # يوم من الدفتر (قبل الأرشيف): عدد البيعات من الدفتر لو موجود
                k = int(tdl.get(d) or 0)
            for tgt in (per_day[d], c, bref):
                tgt["n"] += n
                tgt["r"] += r
                tgt["rel"] += rel
                tgt["c"] += int(k)
        bref["ri"] = is_ri
    # 💠 أيام قبل v3.11: الأرشيف القديم كان يخزّن المجموع بس — الزايد عن الموزّع ينعرض «غير موزّع» (نفس صف التقرير)
    unassigned = 0.0
    for d, x in (per.get(_RI_LEGACY_K) or {}).items():
        if d in per_day:
            per_day[d]["r"] += x[1]
            unassigned += x[1]
    tot = {"n": 0.0, "r": 0.0, "rel": 0.0, "c": 0}
    for d in days:
        for k in tot:
            tot[k] += per_day[d][k]
    return {"days": days, "per_day": per_day, "coins": coins, "tot": tot, "unassigned": unassigned,
            "by_bot": bots_out}


_PV_TYPE_ALL = {"grid": "لانهائية", "grid_range": "مدى", "grid_plus": "بلس", "grid_step": "متدرج", "dca_buy": "DCA شرائي", "dca": "DCA بيعي",
                "rec_buy": "دوري شرائي", "rec_sell": "دوري بيعي", "rec_va": "مسار القيمة"}


def coin_ledger_tick():
    """🪙 v3.22.2: «الربح المحرّر بالعملات» — مراقبة بس (ما يدخل أي حساب ثاني):
    ربح DCA البيعي (صافي لكل دورة من `cycles_log`) + العملة المحرّرة من إعادة الاستثمار (تسليمات الطابور — للمُراكِم أو للمحفظة).
    كل حدث مرة وحدة بمعرّفه (بوت|حدث) · بيومه الحقيقي · يبقى بعد حذف البوت."""
    cl = load_json(COIN_LEDGER) or {}
    if not isinstance(cl, dict):
        cl = {}
    seen_l = list(cl.get("seen") or [])
    seen = set(seen_l)
    daily = cl.setdefault("daily", {})
    tot = {"dca": cl.setdefault("total_dca", {}), "ri": cl.setdefault("total_ri", {}), "rec": cl.setdefault("total_rec", {})}
    bots = cl.setdefault("bots", {})
    changed = False
    live_g = set()                                     # 🔢 v3.25.4: كل حدث لسه بسجل بوت
    for b in bot_dirs().values():
        c0 = b.get("cfg") or {}
        if c0.get("is_demo"):
            continue
        st = _safe(load_json, paths_of(b)[0], default={}) or {}
        key = os.path.relpath(b["dir"], ROOT)
        base = str(b["symbol"]).split("-")[0].upper()
        evs = []
        if c0.get("bot_type") == "dca":
            for c in (st.get("cycles_log") or []):
                if c.get("id"):
                    evs.append(("dca:" + str(c["id"]), c.get("profit"), c.get("ts"), "dca"))
        if c0.get("bot_type") in _REC_T:                 # 🔁 v3.25.0: الدوري — ربح البيعي المحرر لكل صفقة + عملة سحب المعاد استثماره
            for eid, q, ts in (_safe(_rec_coin_events, b, st, default=[]) or []):
                evs.append((eid, q, ts, "rec"))
        for h in (_safe(_ri_handoffs_of, st, default=[]) or []):
            evs.append(("ri:" + str(h.get("id")), h.get("coin"), h.get("ts"), "ri"))
        for eid, q, ts, src in evs:
            gid = key + "|" + eid
            live_g.add(gid)
            if gid in seen:
                continue
            try:
                q = float(q or 0)
                day = datetime.fromtimestamp(float(ts or time.time())).strftime("%Y-%m-%d")
            except Exception:
                continue
            seen.add(gid); seen_l.append(gid); changed = True
            if abs(q) < 1e-12:
                continue
            d = daily.setdefault(day, {})
            e = d.setdefault(base, {"dca": 0.0, "ri": 0.0})
            e[src] = round(float(e.get(src) or 0) + q, 10)
            tot[src][base] = round(float(tot[src].get(base) or 0) + q, 10)
            be = bots.setdefault(key, {"sym": b["symbol"], "type": c0.get("bot_type") or "grid"})
            be[src] = round(float(be.get(src) or 0) + q, 10)
            journal("profit", f"🪙 {q:+.8g} {base} ربح محرّر بالعملة — {'DCA بيعي' if src == 'dca' else ('البوت الدوري' if src == 'rec' else 'تحرير إعادة الاستثمار')} · يوم {day}", "ok",
                    bot=key, sym=b["symbol"], event=eid, coin=q, base=base, day=day)
    if changed:
        cl["seen"] = list(dict.fromkeys([x for x in seen_l if x in live_g] + seen_l[-30000:]))   # 🔢 v3.25.4: اللي لسه بسجلات البوتات ما ينمسح
        try:
            save_json_atomic(COIN_LEDGER, cl)
        except Exception:
            pass
    _safe(coin_trade_tick, default=None)               # 🪙 v3.30.0: دفتر تداول العملات — نفس القفل ونفس المواعيد (حتى قبل حذف البوت)
    return cl


def coins_period(start, end):
    """🪙 الربح المحرّر بالعملات لفترة (تواريخ شاملة): {العملة: {"dca", "ri", "rec", "t"}} — من دفتر العملات."""
    cl = load_json(COIN_LEDGER) or {}
    out = {}
    for d, row in ((cl.get("daily") or {}) if isinstance(cl, dict) else {}).items():
        if not (start <= d <= end) or not isinstance(row, dict):
            continue
        for base, e in row.items():
            o = out.setdefault(base, {"dca": 0.0, "ri": 0.0, "rec": 0.0, "t": 0.0})
            for k in ("dca", "ri", "rec"):
                v = float((e or {}).get(k) or 0)
                o[k] += v
                o["t"] += v
    return {k: {kk: round(vv, 10) for kk, vv in v.items()} for k, v in out.items() if abs(v["t"]) > 1e-12}


# ───────────── 🪙 v3.30.0: ربح تداول العملات + 💵 ربح المُراكِمات يوم بيوم — حسابات بس (ما تلمس البوتات ولا أي دفتر ثاني) ─────────────
#   🪙 تداول العملات = نفس «ربح التداول» بالدولار بس للبوتات اللي ربحها عملة: DCA البيعي (ربح كل دورة) + الدوري البيعي (المحرر +
#   المعاد استثماره من كل صفقة) — بيوم ما انكسب · كل بوت لحاله · يبقى بعد حذف البوت (`Holy_CoinTrade.json`).
#   عملة تحرير إعادة استثمار الجرد وسحب المعاد استثماره **تحويلات** (انحسبت ربح تداول يوم انكسبت) ⇒ مو هنا (تبقى بـ«🪙 المحرر»).
#   💵 المُراكِمات = ربح بيع كل مُراكِم (ربح أو خسارة) بيومه (`Holy_AccProfit.json`) — يبقى بعد إنهاء المُراكِم.
import calendar as _cal
COINTR_FILE = os.path.join(ROOT, "Holy_CoinTrade.json")
ACCPL_FILE = os.path.join(ROOT, "Holy_AccProfit.json")
_CT_T = _kinds(book="coin_trade")            # 📐 v3.32.0: من الجدول
_CT_TL = {k: _BOT_KINDS[k]["lbl"] for k in _CT_T}


def _ct_day(ts):
    return datetime.fromtimestamp(float(ts or time.time())).strftime("%Y-%m-%d")


def _ct_events(bt, st):
    """(المعرّف، المحرر q، المعاد استثماره qr، الوقت) لكل دورة — نفس اللي يقراه سجل ربح اليوم (`bot_day_events`)."""
    out = []
    for c in (st.get("cycles_log") or []):
        if not isinstance(c, dict) or not c.get("id"):
            continue
        if bt == "dca":
            out.append((str(c["id"]), c.get("profit"), 0.0, c.get("ts")))
        elif bt == "rec_sell":
            out.append((str(c["id"]), c.get("rel") if c.get("rel") is not None else c.get("profit"), c.get("ri") or 0.0, c.get("ts")))
    return out


def _ct_backfill(T, booked, rel_live, live_k, since):
    """أول مرة بس: اللي بدفتر العملات وما لگيناه بسجلات البوتات الحية (بوت محذوف · دورات أقدم من سجل البوت) ⇒ سطر
    «قبل v3.30» لكل عملة بيومه — حتى الكلي ما ينقص. الدوري البيعي: سقفه اللي سجّله دفتر العملات للمحذوف (بلا سحب الشرائي)."""
    cl = load_json(COIN_LEDGER) or {}
    if not isinstance(cl, dict):
        return
    cap = {}
    for k, e in (cl.get("bots") or {}).items():
        if isinstance(e, dict) and e.get("type") == "rec_sell" and k not in live_k:
            b0 = str(e.get("sym") or "").split("-")[0].upper()
            cap[b0] = cap.get(b0, 0.0) + max(0.0, float(e.get("rec") or 0))
    daily = T.setdefault("daily", {})
    meta = T.setdefault("bots", {})
    cd = cl.get("daily") or {}
    for day in sorted(cd):
        if (since and day < since) or not isinstance(cd.get(day), dict):
            continue
        for base, e in cd[day].items():
            for src, bt in (("dca", "dca"), ("rec", "rec_sell")):
                try:
                    v = float((e or {}).get(src) or 0) - booked.get((day, base, bt), 0.0)
                except Exception:
                    continue
                if src == "rec":
                    v = min(v - rel_live.get((day, base), 0.0), cap.get(base, 0.0))
                if v <= 1e-9:
                    continue
                if src == "rec":
                    cap[base] = cap.get(base, 0.0) - v
                k = f"_old|{bt}|{base}"
                r = daily.setdefault(day, {}).setdefault(k, {"b": base, "q": 0.0, "qr": 0.0, "c": 0})
                r["q"] = round(float(r.get("q") or 0) + v, 10)
                meta[k] = {"sym": base + "-USDT", "type": bt, "b": base, "old": True}


def coin_trade_tick():
    """🪙 v3.30.0: دفتر «ربح تداول العملات» — كل دورة مرة وحدة بمعرّفها وبيومها الحقيقي (حتى لو اللوحة كانت طافية وقتها).
    يشتغل ويّا دفتر العملات (نفس القفل · قبل حذف البوت) · «بداية جديدة للحسابات» تحترمها (`_books_since`)."""
    T = load_json(COINTR_FILE) or {}
    if not isinstance(T, dict):
        T = {}
    first = not T.get("v")
    seen_l = list(T.get("seen") or [])
    seen = set(seen_l)
    daily = T.setdefault("daily", {})
    meta = T.setdefault("bots", {})
    since = _safe(_books_since, default="") or ""
    changed, live_g, live_k = first, set(), {}
    booked, rel_live = {}, {}
    for b in bot_dirs().values():
        c0 = b.get("cfg") or {}
        bt = str(c0.get("bot_type") or "")
        if c0.get("is_demo") or bt not in _CT_T + _REC_T:
            continue
        st = _safe(load_json, paths_of(b)[0], default={}) or {}
        key = os.path.relpath(b["dir"], ROOT)
        base = str(b["symbol"]).split("-")[0].upper()
        if first and bt in _REC_T:                     # سحب المعاد استثماره (بدفتر العملات تحت «rec») ⇒ ينطرح من الباقي
            for r in (st.get("releases") or []):
                try:
                    if r.get("id") and float(r.get("coin") or 0) > 0:
                        k2 = (_ct_day(r.get("ts")), base)
                        rel_live[k2] = rel_live.get(k2, 0.0) + float(r["coin"])
                except Exception:
                    continue
        if bt not in _CT_T:
            continue
        live_k[key] = b
        m0 = {"sym": b["symbol"], "type": bt, "b": base, "mode": str(c0.get("mode") or "")}
        if meta.get(key) != m0:
            meta[key] = m0
            changed = True
        for eid, q, qr, ts in _ct_events(bt, st):
            gid = key + "|" + eid
            live_g.add(gid)
            try:
                q, qr, day = float(q or 0), float(qr or 0), _ct_day(ts)
            except Exception:
                continue
            if first:
                k3 = (day, base, bt)
                booked[k3] = booked.get(k3, 0.0) + q
            if gid in seen:
                continue
            seen.add(gid)
            seen_l.append(gid)
            changed = True
            if (since and day < since) or abs(q) + abs(qr) < 1e-14:
                continue
            e = daily.setdefault(day, {}).setdefault(key, {"b": base, "q": 0.0, "qr": 0.0, "c": 0})
            e["q"] = round(float(e.get("q") or 0) + q, 10)
            e["qr"] = round(float(e.get("qr") or 0) + qr, 10)
            e["c"] = int(e.get("c") or 0) + 1
    if first:
        _ct_backfill(T, booked, rel_live, live_k, since)
        T["v"] = 1
    if changed:
        T["seen"] = list(dict.fromkeys([x for x in seen_l if x in live_g] + seen_l[-30000:]))
        _safe(save_json_atomic, COINTR_FILE, T, default=None)
    return T


def _ct_name(k, m, live, dup):
    base = m.get("b") or "?"
    t = _CT_TL.get(m.get("type"), "")
    if m.get("old"):
        return f"{base} · {t} (قبل v3.30 · محذوف/قديم)"
    if m.get("type") == "rec_sell" and m.get("mode"):
        t += " · " + ("بالمعدل" if m["mode"] == "avg" else "كل أمر على حدة")
    return f"{base} · {t}" + (" · " + k if dup else "") + ("" if k in live else " (محذوف)")


def coin_trade_period(start, end, tick=False):
    """🪙 ربح تداول العملات لفترة (تواريخ شاملة) — من الدفتر: لكل عملة · لكل بوت · لكل يوم (المحرر q + المعاد استثماره qr)."""
    if tick:
        _safe(coin_trade_tick, default=None)
    T = load_json(COINTR_FILE) or {}
    daily = (T.get("daily") or {}) if isinstance(T, dict) else {}
    meta = (T.get("bots") or {}) if isinstance(T, dict) else {}
    live = {os.path.relpath(b["dir"], ROOT) for b in bot_dirs().values()}
    coins, bots, days = {}, {}, {}
    for d, row in daily.items():
        if not (start <= d <= end) or not isinstance(row, dict):
            continue
        for k, e in row.items():
            try:
                q, qr, c = float(e.get("q") or 0), float(e.get("qr") or 0), int(e.get("c") or 0)
            except Exception:
                continue
            base = e.get("b") or (meta.get(k) or {}).get("b") or "?"
            coins[base] = coins.get(base, 0.0) + q + qr
            dd = days.setdefault(d, {})
            dd[base] = dd.get(base, 0.0) + q + qr
            B = bots.setdefault(k, {"b": base, "q": 0.0, "qr": 0.0, "c": 0, "d": {}})
            B["q"] += q
            B["qr"] += qr
            B["c"] += c
            B["d"][d] = round(B["d"].get(d, 0.0) + q + qr, 10)
    grp = {}
    for k in bots:
        m = meta.get(k) or {}
        grp[(m.get("b"), m.get("type"), bool(m.get("old")))] = grp.get((m.get("b"), m.get("type"), bool(m.get("old"))), 0) + 1
    out = []
    for k, B in bots.items():
        m = meta.get(k) or {"b": B["b"]}
        best = max(B["d"].items(), key=lambda kv: kv[1]) if B["d"] else None
        t = B["q"] + B["qr"]
        out.append({"k": k, "name": _ct_name(k, m, live, grp.get((m.get("b"), m.get("type"), bool(m.get("old"))), 0) > 1),
                    "b": B["b"], "type": m.get("type") or "", "tl": _CT_TL.get(m.get("type"), ""), "mode": m.get("mode") or "",
                    "live": k in live, "old": bool(m.get("old")), "q": round(B["q"], 10), "qr": round(B["qr"], 10), "t": round(t, 10),
                    "c": B["c"], "act": sum(1 for v in B["d"].values() if abs(v) > 1e-14),
                    "best": {"d": best[0], "v": best[1]} if best and best[1] > 1e-14 else None, "days": B["d"]})
    out.sort(key=lambda x: (x["b"], -x["t"], x["k"]))
    return {"coins": {k: round(v, 10) for k, v in coins.items() if abs(v) > 1e-12}, "bots": out,
            "days": {d: {b: round(v, 10) for b, v in r.items()} for d, r in sorted(days.items())}}


def coin_trade_all():
    """🪙 ربح تداول العملات الكلي لكل عملة (كل الأيام · ويّا المحذوف)."""
    return coin_trade_period("0000-00-00", "9999-99-99")["coins"]


def acc_pl_tick():
    """💵 v3.30.0: ربح بيع المُراكِمات يوم بيوم — كل بيعة مرة وحدة (`مُراكِم|وقتها` — نفس علامة دفتر الربح) · يبقى بعد إنهاء المُراكِم.
    أول مرة: «المحقق» بالمُراكِم اللي ما لگيناه بآخر بيعاته (أقدم من آخر 200) ⇒ سطر «قبل v3.30» بأول يوم معروف."""
    B = load_json(ACCPL_FILE) or {}
    if not isinstance(B, dict):
        B = {}
    first = not B.get("v")
    seen_l = list(B.get("seen") or [])
    seen = set(seen_l)
    daily = B.setdefault("daily", {})
    names = B.setdefault("names", {})
    since = _safe(_books_since, default="") or ""
    cfg = {a.get("id"): a for a in (acc_cfgs() or []) if isinstance(a, dict)}
    st = acc_state() or {}
    changed, live_s, bsum, bday = first, set(), {}, {}
    for aid, e in st.items():
        if str(aid).startswith("_") or not isinstance(e, dict):
            continue
        a = cfg.get(aid)
        if a:
            nm = {"name": a.get("name") or a.get("symbol") or aid, "sym": a.get("symbol") or "", "w": acc_wid(a) or ""}
            if names.get(aid) != nm:
                names[aid] = nm
                changed = True
        for s in (e.get("sells") or []):
            if not isinstance(s, dict):
                continue
            sk = f"{aid}|{s.get('ts')}"
            live_s.add(sk)
            try:
                p, u, day = float(s.get("profit") or 0), float(s.get("usd") or 0), _ct_day(s.get("ts"))
            except Exception:
                continue
            if first:
                bsum[aid] = bsum.get(aid, 0.0) + p
                bday[aid] = min(bday.get(aid, day), day)
            if sk in seen:
                continue
            seen.add(sk)
            seen_l.append(sk)
            changed = True
            if since and day < since:
                continue
            r = daily.setdefault(day, {}).setdefault(aid, {"p": 0.0, "u": 0.0, "c": 0})
            r["p"] = round(float(r.get("p") or 0) + p, 6)
            r["u"] = round(float(r.get("u") or 0) + u, 6)
            r["c"] = int(r.get("c") or 0) + 1
    if first:
        today = datetime.now().strftime("%Y-%m-%d")
        rows = [(aid, float(e.get("realized") or 0), bday.get(aid)) for aid, e in st.items()
                if not str(aid).startswith("_") and isinstance(e, dict)]
        for x in (st.get("_closed") or []):
            if isinstance(x, dict) and x.get("id") and x["id"] not in st:
                rows.append((x["id"], float(x.get("realized") or 0), _ct_day(x.get("ts"))))
                names.setdefault(x["id"], {"name": x.get("name") or x.get("sym") or x["id"], "sym": x.get("sym") or "", "w": x.get("wid") or ""})
        for aid, real, d0 in rows:
            v = round(real - bsum.get(aid, 0.0), 6)
            day = d0 or today
            if abs(v) < 1e-6 or (since and day < since):
                continue
            r = daily.setdefault(day, {}).setdefault(aid, {"p": 0.0, "u": 0.0, "c": 0})
            r["p"] = round(float(r.get("p") or 0) + v, 6)
            r["old"] = round(float(r.get("old") or 0) + v, 6)
        B["v"] = 1
    if changed:
        B["seen"] = list(dict.fromkeys([x for x in seen_l if x in live_s] + seen_l[-20000:]))
        _safe(save_json_atomic, ACCPL_FILE, B, default=None)
    return B


def acc_pl_period(start, end, tick=False):
    """💵 ربح بيع المُراكِمات لفترة (تواريخ شاملة): المجموع · لكل مُراكِم · لكل يوم (الخسارة تنقص)."""
    if tick:
        _safe(acc_pl_tick, default=None)
    B = load_json(ACCPL_FILE) or {}
    daily = (B.get("daily") or {}) if isinstance(B, dict) else {}
    names = (B.get("names") or {}) if isinstance(B, dict) else {}
    live = {a.get("id") for a in (acc_cfgs() or []) if isinstance(a, dict)}
    accs, days, tot, cnt = {}, {}, 0.0, 0
    for d, row in daily.items():
        if not (start <= d <= end) or not isinstance(row, dict):
            continue
        for aid, r in row.items():
            try:
                p, u, c = float(r.get("p") or 0), float(r.get("u") or 0), int(r.get("c") or 0)
            except Exception:
                continue
            A = accs.setdefault(aid, {"p": 0.0, "u": 0.0, "c": 0, "old": 0.0, "d": {}})
            A["p"] += p
            A["u"] += u
            A["c"] += c
            A["old"] += float(r.get("old") or 0)
            A["d"][d] = round(A["d"].get(d, 0.0) + p, 6)
            days[d] = days.get(d, 0.0) + p
            tot += p
            cnt += c
    out = []
    for aid, A in accs.items():
        nm = names.get(aid) or {}
        best = max(A["d"].items(), key=lambda kv: kv[1]) if A["d"] else None
        out.append({"aid": aid, "name": (nm.get("name") or aid) + ("" if aid in live else " (منتهي)"), "sym": nm.get("sym") or "",
                    "w": nm.get("w") or "", "live": aid in live, "p": round(A["p"], 6), "u": round(A["u"], 6), "c": A["c"],
                    "old": round(A["old"], 6), "act": sum(1 for v in A["d"].values() if abs(v) > 1e-9),
                    "best": {"d": best[0], "v": best[1]} if best and best[1] > 1e-9 else None, "days": A["d"]})
    out.sort(key=lambda x: (-x["p"], x["aid"]))
    return {"tot": round(tot, 6), "c": cnt, "accs": out, "days": {d: round(v, 6) for d, v in sorted(days.items())}}


# ───────────── 🗺️ v3.22.8: خريطة الأرباح + 💰 صناديق الربح — مراقبة بس (التوزيعات نفسها ما تنلمس ولا سطر) ─────────────
#   v3.23.0 — لكل محفظة (مفتاح API): 📥 صندوق الربح المحرر (ربح البوتات بالدولار قبل التوزيع) ⇒ نهاية اليوم للمُراكِمات بنسبها
#   والباقي ⇒ 💰 الصندوق النهائي · بلا مُراكِم ⇒ للنهائي مباشرة · 🪙 العملة (للمُراكِم بنسبة العملة — نفس العملة ونفس المحفظة —
#   والباقي/بلا مُراكِم ⇒ النهائي) · المُراكِم ⇒ النهائي: 📤 التحويل (دولار أو عملة) · 💰 البيع (ربح أو خسارة) · 🛑 الإنهاء (عملته ودولاره).
