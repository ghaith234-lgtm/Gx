import gzip as _gzip
_PAGE = {}
_OV_CACHE = {"t": 0.0, "v": None}
_OV_LOCK = threading.Lock()


def _login_page():
    """🔒 صفحة الدخول بالشعار (تنبني مرة وحدة)."""
    if "login" not in _PAGE:
        _PAGE["login"] = brand_fill(LOGIN_PAGE.replace("__BRAND_TILE__", brand_tile_svg("st", "btile"), 1)
                                   .replace("__BRAND_TILE__", brand_tile_svg("lt", "btile"))).encode("utf-8")
    return _PAGE["login"]


def _page_cache():
    """🗜️ صفحة اللوحة: تنبني وتنضغط مرة وحدة لكل نسخة — والبصمة (ETag) تخلي المتصفح يعيد استعمال نسخته."""
    if _PAGE.get("v") != APP_VERSION:
        raw = brand_fill(HTML_PAGE.replace("__APPVER__", APP_VERSION)).encode("utf-8")       # 🎨 v3.26.0: الهوية
        _PAGE.update(v=APP_VERSION, raw=raw, gz=_gzip.compress(raw, 6),
                     etag='"hd-%s-%s"' % (APP_VERSION, _hl.sha256(raw).hexdigest()[:12]))
    return _PAGE


def _overview_cached(max_age=1.0):
    """⚡ لو أكثر من جهاز/تبويب يطلب الملخص بنفس الثانية ⇒ حساب واحد يخدم الكل (والأفعال تصفّره)."""
    with _OV_LOCK:
        now = time.time()
        if _OV_CACHE["v"] is not None and now - _OV_CACHE["t"] < max_age:
            return _OV_CACHE["v"]
        v = overview()
        _OV_CACHE.update(t=time.time(), v=v)
        return v


class _AuthMixin:
    def _client_ip(self):
        return self.client_address[0] if self.client_address else "?"

    def _cookie_token(self):
        raw = self.headers.get("Cookie") or ""
        for part in raw.split(";"):
            k, _, v = part.strip().partition("=")
            if k == "holy_tok":
                return v
        return ""

    def _authed(self):
        if not auth_enabled():
            return True
        tok = self._cookie_token()
        ok = _session_ok(tok, self._client_ip())
        if ok:
            self._renew_tok = tok                 # 🔐 v3.36.3: الكوكي يتجدد ويّا الجلسة (كان ينتهي بعد مدة القفل من لحظة الدخول حتى وانت تتصفح)
        return ok

    def end_headers(self):
        tok = getattr(self, "_renew_tok", None)
        if tok:
            self._renew_tok = None
            self.send_header("Set-Cookie", f"holy_tok={tok}; Path=/; HttpOnly; SameSite=Strict; Max-Age={max(1, auth_cfg()['mins']) * 60}")
        super().end_headers()

    def _send_login(self):
        body = _login_page()
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        try: self.wfile.write(body)
        except Exception: pass



class Handler(_AuthMixin, BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def _check_pin(self):
        pin = dash_cfg().get("pin")
        return (not pin) or self.headers.get("X-Dash-Pin", "") == str(pin)

    def _gz_ok(self):
        return "gzip" in (self.headers.get("Accept-Encoding") or "").lower()

    def _json(self, obj, code=200):
        jp = getattr(self, "_jpost", None)
        if jp:
            self._jpost = None
            try:
                _pp, _dd = jp
                _ok = (obj.get("ok") is not False and code < 400) if isinstance(obj, dict) else code < 400
                _lbl = str(_dd.get("action") or _dd.get("act") or _pp.rsplit("/", 1)[-1])
                _who = str(_dd.get("dir") or _dd.get("d") or _dd.get("bot") or _dd.get("symbol") or "")
                journal("user", f"👤 {_lbl}" + (f" · {_who}" if _who else "") + (f" — {str(obj.get('msg'))[:300]}" if isinstance(obj, dict) and obj.get("msg") else ""),
                        "ok" if _ok else "err", bot=_who if _who in {os.path.relpath(b['dir'], ROOT) for b in bot_dirs().values()} else "",
                        path=_pp, request=_dd, ok=_ok, code=code)
            except Exception:
                pass
        body = json.dumps(obj, ensure_ascii=False).encode("utf-8")
        gz = len(body) > 1400 and self._gz_ok()           # 🗜️ الملخص ~50 كيلو ⇒ ~10 كيلو (أخف على نت الموبايل 5 مرات)
        if gz:
            body = _gzip.compress(body, 5)
        self.send_response(code)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Cache-Control", "no-store")
        if gz:
            self.send_header("Content-Encoding", "gzip")
            self.send_header("Vary", "Accept-Encoding")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _app_get(self, u):
        """📱 v3.24.0: طلبات التطبيق — الإشعارات (بمفتاح الجهاز بس) · معلومات التطبيق وتنزيله (مفتاح الجهاز أو جلسة اللوحة)."""
        dev = app_dev_auth(self.headers.get("X-Holy-Device", ""))
        if dev is None and (u.path == "/api/app/feed" or not self._authed() or not self._check_pin()):
            return self._json({"ok": False, "auth": False, "msg": "🔒 الجهاز مو مربوط — افتح التطبيق وادخل اللوحة"}, 401)
        q = parse_qs(u.query)
        if u.path == "/api/app/feed":
            try:
                since = max(0, int((q.get("since") or ["0"])[0] or 0))
                wait = float((q.get("wait") or ["0"])[0] or 0)
            except Exception:
                return self._json({"ok": False, "msg": "طلب غير صالح"}, 400)
            last, items = app_feed_wait(since, wait)
            return self._json({"ok": True, "last": last, "items": items, "muted": bool(TG_MUTED["v"]), "server": APP_VERSION})
        a = app_apk()
        if u.path == "/api/app/info":
            _w = win_exe()
            return self._json({"ok": True, "apk": {"code": APP_APK_CODE, "name": APP_APK_NAME, "size": a["size"], "sha256": a["sha256"]},
                               "win": {"code": WIN_EXE_CODE, "name": WIN_EXE_NAME, "size": _w["size"], "sha256": _w["sha256"]},
                               "server": APP_VERSION})
        if u.path == "/app/holy.exe":
            # 💻 v3.26.0: برنامج ويندوز وبيه عنوان لوحتك (اللي كتبته بالإعدادات — وإلا العنوان اللي فتحت منه هسه)
            url = win_url_ok((q.get("u") or [""])[0])
            if not url:
                host = re.sub(r"[^A-Za-z0-9.:\-\[\]]", "", str(self.headers.get("Host") or ""))
                proto = "https" if str(self.headers.get("X-Forwarded-Proto") or "").lower() == "https" else "http"
                url = win_url_ok(f"{proto}://{host}") if host else ""
            tok = ""
            if dev is not None and str(dev.get("iid") or "").startswith("win-"):
                tok = str(self.headers.get("X-Holy-Device", "")).strip()      # البرنامج نفسه يطلب نسخة ⇒ يبقى بنفس مفتاحه
            elif url and win_exe()["raw"]:
                _did, tok, _last = win_pair(self._client_ip())                # 🔔 v3.26.1: الحاسوب ينربط بالإشعارات من التنزيل
