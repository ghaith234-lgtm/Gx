        return bool(d) and os.path.exists(os.path.join(d, "reinvest_inject.json"))
    except Exception:
        return False


def reinvest_snapshot(b, st):
    """🔄 المتراكم داخل الأوامر: دولار (شراء معلّق) وعملة (ماسك عملة)."""
    ri = st.get("reinvest")
    if not isinstance(ri, dict):
        # البوت ما اشتغل باللفّة بعد — نرجّع قراءة من التهيئة حتى تعكس
        # الشريحة الحالة فوراً بدل ما تظل «مطفية» والزبون يشك
        if not b["cfg"].get("reinvest"):
            return None
        return {"on": False, "cfg_on": True, "usd": 0.0, "coin": 0.0,
                "cycles": 0, "levels": 0, "days": 0.0, "rows": [], "top": [],
                "desync": [], "handoff": None, "released": None,
                "file": os.path.exists(os.path.join(b["dir"], "reinvest.py")),
                "file_old": False, "pending_boot": True}
    lv = ri.get("levels") or {}
    g = float(b["cfg"].get("grid_percentage") or 0)
    usd = float(ri.get("orphan_usd") or 0.0)
    coin = 0.0
    seen = set()
    rows = []
    for dname in RI_BUY_D + RI_SELL_D:
        issell = dname in RI_SELL_D
        for info in (st.get(dname) or {}).values():
            if not isinstance(info, dict):
                continue
            px = info.get("original_buy_anchor") if issell else info.get("target_price")
            k = _rung_key(st, px, g)
            if k is None or k not in lv or k in seen:
                continue
            seen.add(k)
            e = lv[k]
            usd += float(e.get("usd_book") or 0)
            gq = float(e.get("grown_qty") or 0)
            bq = float(e.get("base_qty") or 0)
            bk = float(e.get("usd_book") or 0)
            lpx = float(px or 0)
            _epx = float(e.get("px") or 0) or lpx          # 🧾 سعر دفتر الدرجة — نفس اللي يدفعه الإيقاف (المعروض = المدفوع)
            if gq > 0:
                if issell:
                    coin += gq
                else:
                    usd += gq * _epx
            # الصف يبقى ما دام للدرجة أمر — حتى لو فرّغتها كلياً،
            # وإلا يختفي وتضيع معه أزرار الحقن والسحب
            if True:
                _sp = (info.get("target_price") if issell
                       else info.get("original_sell_anchor")) or 0
                _io = None
                if issell and bq > 0:           # 🪙 العملة **الموجودة فعلاً** داخل أمر البيع (نفس حساب البوت: من كمية الشراء الأصلية)
                    _lk = float(info.get("locked_qty") or 0)
                    _io = round(min(gq, max(0.0, float(info.get("buy_qty") or _lk) - bq), _lk), 8)
                elif bq > 0:                    # 💵 النمو **الموجود فعلاً** داخل أمر الشراء (الباقي بالدفتر)
                    _io = round(min(gq, max(0.0, float(info.get("locked_qty") or 0) - bq)), 8)
                rows.append({"p": round(lpx, 8), "sp": round(float(_sp or 0), 8),
                             "b": round(bq, 8), "g": round(gq, 8),
                             "k": round(bk, 6), "s": "sell" if issell else "buy",
                             "v": round(gq * _epx, 6), "kk": str(k), "io": _io,
                             "j": round(min(float(e.get("inj_book") or 0)
                                            + float(e.get("inj_grown") or 0),
                                            bk + gq * _epx), 6),
                             "tv": round(bk + gq * _epx, 6),
                             "c": int(e.get("cycles") or 0),
                             "pct": round((gq / bq * 100) if bq > 0 else 0, 2)})
    for k, e in lv.items():                      # درجات يتيمة — فلوسها ما تنمحي
        if k not in seen:
            _bk = float(e.get("usd_book") or 0)
            _gq = float(e.get("grown_qty") or 0)
            _bq = float(e.get("base_qty") or 0)
            # السعر المخزَّن — نفس اللي يستعمله التحرير بالضبط، فالمعروض = المدفوع
            _px = float(e.get("px") or 0)
            _gv = _gq * _px if (_gq > 0 and _px > 0) else 0.0
            usd += _bk + _gv
            if _bk > 0 or _gq > 0:
                rows.append({"p": round(_px, 8), "sp": 0, "b": round(_bq, 8),
                             "g": round(_gq, 8), "kk": str(k),
                             "j": round(min(float(e.get("inj_book") or 0)
                                            + float(e.get("inj_grown") or 0),
                                            _bk + _gv), 6),
                             "tv": round(_bk + _gv, 6),
                             "c": int(e.get("cycles") or 0),
                             "k": round(_bk, 6), "s": "orphan", "v": round(_gv, 6),
                             "pct": round((_gq / _bq * 100) if _bq > 0 else 0, 2)})
    rows.sort(key=lambda r: -r["p"])
    # 🔍 هل الأوامر الحية بحجمها المفترض؟ (أساس + نمو)
    desync = []
    for oid, info in (st.get("limit_buys") or {}).items():
        if not isinstance(info, dict):
            continue
        k = _rung_key(st, info.get("target_price"), g)
        e = lv.get(k) if k else None
        if not e:
            continue
        want = float(e.get("base_qty") or 0) + float(e.get("grown_qty") or 0)
        got = float(info.get("locked_qty") or 0)
        if want > 0 and abs(got - want) > max(1e-9, want * 0.02):
            desync.append({"p": float(info.get("target_price") or 0),
                           "want": round(want, 8), "got": round(got, 8)})
    top = sorted([{"p": float(v.get("px") or 0), "b": float(v.get("base_qty") or 0),
                   "g": float(v.get("grown_qty") or 0),
                   "pct": round((float(v.get("grown_qty") or 0) /
                                 float(v.get("base_qty") or 1) * 100), 1)}
                  for v in lv.values() if float(v.get("grown_qty") or 0) > 0],
                 key=lambda x: -x["pct"])[:5]
    started = float(ri.get("started_ts") or 0)
    _uw = ri.get("unwind") or {}
    return {"on": bool(ri.get("on")), "desync": desync[:8], "top": top,
            "inj_total": round(float(ri.get("inj_total") or 0), 6),
            "pct": (100.0 if ri.get("pct") is None
                    else round(float(ri.get("pct") or 0), 2)),
            "pct_cfg": (100.0 if (b.get("cfg") or {}).get("reinvest_pct") is None
                        else round(float((b.get("cfg") or {}).get("reinvest_pct") or 0), 2)),
            "inj_pending": bool(_inj_pending(b.get("dir") if isinstance(b, dict) else None)),
            "unwind": [{"p": float(v.get("px") or 0),
                        "sp": round(float(v.get("px") or 0) * (1 + g), 8) if g > 0 else 0,
                        "b": float(v.get("base_qty") or 0),
                        "g": float(v.get("grown_qty") or 0),
                        "k": 0.0, "v": round(float(v.get("grown_qty") or 0)
                                             * float(v.get("px") or 0), 6),
                        "uw": True, "s": v.get("side") or "buy"}
                       for v in list(_uw.values())[:60]],
            "n_unwind": len(_uw),
            "handoff": (_ri_pending_handoffs(st, 0.0) or [None])[0], "handoff_stuck": (_ri_pending_handoffs(st, 1800.0) or [None])[0], "usd": round(usd, 4), "coin": round(coin, 8),
            "rows": rows[:300],
            "cycles": int(ri.get("cycles") or 0), "levels": len(lv),
            "days": round(max(0.0, (time.time() - started) / 86400.0), 2) if started else 0.0,
            "file": os.path.exists(os.path.join(b["dir"], "reinvest.py")),
            "file_old": (os.path.exists(os.path.join(b["dir"], "reinvest.py"))
                         and _file_fp(os.path.join(b["dir"], "reinvest.py")) != REINV_VERSION),
            "cfg_on": bool(b["cfg"].get("reinvest")),
            "released": ri.get("released")}

