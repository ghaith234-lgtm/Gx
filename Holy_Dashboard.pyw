        import ctypes

        class _MS(ctypes.Structure):
            _fields_ = [("dwLength", ctypes.c_uint32), ("dwMemoryLoad", ctypes.c_uint32), ("ullTotalPhys", ctypes.c_uint64), ("ullAvailPhys", ctypes.c_uint64),
                        ("ullTotalPageFile", ctypes.c_uint64), ("ullAvailPageFile", ctypes.c_uint64), ("ullTotalVirtual", ctypes.c_uint64),
                        ("ullAvailVirtual", ctypes.c_uint64), ("ullAvailExtendedVirtual", ctypes.c_uint64)]
        m = _MS(); m.dwLength = ctypes.sizeof(_MS)
        if ctypes.windll.kernel32.GlobalMemoryStatusEx(ctypes.byref(m)) and m.ullTotalPhys:
            ram = round(100.0 * (m.ullTotalPhys - m.ullAvailPhys) / m.ullTotalPhys, 1)
        g = ctypes.windll.kernel32.GetTickCount64; g.restype = ctypes.c_uint64
        up = int(g() // 1000)
        return ram, up
    try:
        mi = {}
        with open("/proc/meminfo") as fh:
            for ln in fh:
                a = ln.split()
                if len(a) >= 2:
                    mi[a[0].rstrip(":")] = float(a[1])
        if mi.get("MemTotal") and "MemAvailable" in mi:
            ram = round(100.0 * (1 - mi["MemAvailable"] / mi["MemTotal"]), 1)
    except Exception:
        pass
    try:
        with open("/proc/uptime") as fh:
            up = int(float(fh.read().split()[0]))
    except Exception:
        pass
    return ram, up


def sys_stats():
    out = {"ok": True, "cpu": None, "ram": None, "disk_free": None, "disk_total": None, "up": None}
    try:
        du = shutil.disk_usage(ROOT)
        out["disk_free"], out["disk_total"] = int(du.free), int(du.total)
    except Exception:
        pass
    try:
        out["ram"], out["up"] = _sys_ram_up()
    except Exception:
        pass
    try:
        with _SYS["lk"]:
            now, a, st = time.time(), _sys_cpu_times(), _SYS["cpu"]       # st = (وقت · الكلي · الخمول · النسبة)
            if a and (not st or now - st[0] > 30):                         # ما في قراءة قريبة ⇒ نظرة ثانية بعد ربع ثانية
                st = (now, a[0], a[1], None)
                time.sleep(0.25)
                now, a = time.time(), _sys_cpu_times()
            if a and st and now - st[0] >= 0.2 and a[0] > st[1]:
                st = (now, a[0], a[1], round(max(0.0, min(100.0, 100.0 * (1 - (a[1] - st[2]) / (a[0] - st[1])))), 1))
            _SYS["cpu"] = st
            out["cpu"] = st[3] if st else None
    except Exception:
        pass
    return out


# 🔤 v3.36.40 (المالك 13-11: أرسل خط خالد وأرسلان وسام): خطوط المالك من مجلد fonts جنب اللوحة — ما تنكتب بالكود (المستودع عام ·
#   خط خالد مكتوب داخله «تضمين مقيّد») · كل ملف ‎.ttf .otf .woff .woff2‎ هناك يطلع بـ⚙️ «خط الكتابة» باسم ملفه · يُرفع ويُحذف من ⚙️ كمان
FONT_DIR = os.path.join(ROOT, "fonts")
_FONT_CT = {".ttf": "font/ttf", ".otf": "font/otf", ".woff": "font/woff", ".woff2": "font/woff2"}
_FONT_MAGIC = ((b"\x00\x01\x00\x00", ".ttf"), (b"true", ".ttf"), (b"OTTO", ".otf"), (b"wOFF", ".woff"), (b"wOF2", ".woff2"))
_FONT_MAX = 12 * 1024 * 1024


def _font_label(stem):                                  # «alfont_com_ArbFONTS-Khalid-Art-Bold» ⇒ «Khalid Art Bold»
    s = re.sub(r"(?i)^(?:[a-z0-9]+_com_)+", "", str(stem or ""))
    s = re.sub(r"(?i)^arbfonts[-_ ]+", "", s)
    s = re.sub(r"[_\-]+", " ", s)
    s = re.sub(r"[^\w\s.()]", "", s)
    return re.sub(r"\s+", " ", s).strip(" .")[:40]


def user_fonts():
    out = []
    try:
        names = sorted(os.listdir(FONT_DIR))
    except Exception:
        return out
    for fn in names:
        ext = os.path.splitext(fn)[1].lower()
        p = os.path.join(FONT_DIR, fn)
        if ext not in _FONT_CT or fn.startswith(".") or not os.path.isfile(p):
            continue
        try:
            st = os.stat(p)
        except Exception:
            continue
        if not 0 < st.st_size <= _FONT_MAX:
            continue
        name = _font_label(os.path.splitext(fn)[0]) or "خط"
        out.append({"k": "u" + _hl.sha256(fn.encode("utf-8")).hexdigest()[:10], "name": name, "file": fn, "size": st.st_size,
                    "v": _hl.sha256(f"{fn}|{st.st_size}|{int(st.st_mtime)}".encode("utf-8")).hexdigest()[:8]})
        if len(out) >= 24:
            break
    return out


def user_font_path(k):
    for f in user_fonts():
        if f["k"] == k:
            return os.path.join(FONT_DIR, f["file"]), _FONT_CT[os.path.splitext(f["file"])[1].lower()]
    return None, None


def user_font_add(name, b64):
    try:
        raw = _b64s.b64decode(str(b64 or "").split(",")[-1], validate=False)
    except Exception:
        return {"ok": False, "msg": "الملف تالف"}
    if not 0 < len(raw) <= _FONT_MAX:
        return {"ok": False, "msg": "الخط أكبر من 12 ميغابايت" if raw else "الملف فارغ"}
    ext = next((e for m, e in _FONT_MAGIC if raw[:4] == m), "")
    if not ext:
        return {"ok": False, "msg": "هذا ليس ملف خط (المقبول: ttf · otf · woff · woff2)"}
    stem = _font_label(os.path.splitext(os.path.basename(str(name or "").replace("\\", "/")))[0]) or "خط"
    if len(user_fonts()) >= 24:
        return {"ok": False, "msg": "وصلت 24 خطاً — احذف واحداً أولاً"}
    os.makedirs(FONT_DIR, exist_ok=True)
    fn = stem + ext
    tmp = os.path.join(FONT_DIR, "." + fn + ".tmp")
    with open(tmp, "wb") as fh:
        fh.write(raw)
    os.replace(tmp, os.path.join(FONT_DIR, fn))
    k = "u" + _hl.sha256(fn.encode("utf-8")).hexdigest()[:10]
    return {"ok": True, "k": k, "msg": f"🔤 أُضيف الخط «{stem}»", "fonts": user_fonts()}


def user_font_del(k):
    p, _ct = user_font_path(str(k or ""))
    if not p:
        return {"ok": False, "msg": "الخط غير موجود"}
    os.remove(p)
    return {"ok": True, "msg": "🗑 حُذف الخط", "fonts": user_fonts()}


def _overview_cached(max_age=1.0):
    """⚡ لو أكثر من جهاز/تبويب يطلب الملخص بنفس الثانية ⇒ حساب واحد يخدم الكل (والأفعال تصفّره)."""
    with _OV_LOCK:
        now = time.time()
        if _OV_CACHE["v"] is not None and now - _OV_CACHE["t"] < max_age:
            return _OV_CACHE["v"]
        v = overview()
        _OV_CACHE.update(t=time.time(), v=v)
        return v


class _AuthMixin:
    def _client_ip(self):
        return self.client_address[0] if self.client_address else "?"

    def _cookie_token(self):
        raw = self.headers.get("Cookie") or ""
        for part in raw.split(";"):
            k, _, v = part.strip().partition("=")
            if k == "holy_tok":
                return v
        return ""

    def _authed(self):
        if not auth_enabled():
            return True
        tok = self._cookie_token()
        ok = _session_ok(tok, self._client_ip())
        if ok:
            self._renew_tok = tok                 # 🔐 v3.36.3: الكوكي يتجدد ويّا الجلسة (كان ينتهي بعد مدة القفل من لحظة الدخول حتى وانت تتصفح)
        return ok

    def end_headers(self):
        tok = getattr(self, "_renew_tok", None)
        if tok:
            self._renew_tok = None
            self.send_header("Set-Cookie", f"holy_tok={tok}; Path=/; HttpOnly; SameSite=Strict; Max-Age={max(1, auth_cfg()['mins']) * 60}")
        super().end_headers()

    def _send_login(self):
        body = _login_page()
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        try: self.wfile.write(body)
        except Exception: pass



class Handler(_AuthMixin, BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def _check_pin(self):
        pin = dash_cfg().get("pin")
        return (not pin) or self.headers.get("X-Dash-Pin", "") == str(pin)

    def _gz_ok(self):
        return "gzip" in (self.headers.get("Accept-Encoding") or "").lower()

    def _json(self, obj, code=200):
        jp = getattr(self, "_jpost", None)
        if jp:
            self._jpost = None
            try:
                _pp, _dd = jp
                _ok = (obj.get("ok") is not False and code < 400) if isinstance(obj, dict) else code < 400
                _lbl = str(_dd.get("action") or _dd.get("act") or _pp.rsplit("/", 1)[-1])
                _who = str(_dd.get("dir") or _dd.get("d") or _dd.get("bot") or _dd.get("symbol") or "")
                journal("user", f"👤 {_lbl}" + (f" · {_who}" if _who else "") + (f" — {str(obj.get('msg'))[:300]}" if isinstance(obj, dict) and obj.get("msg") else ""),
                        "ok" if _ok else "err", bot=_who if _who in {os.path.relpath(b['dir'], ROOT) for b in bot_dirs().values()} else "",
                        path=_pp, request=_dd, ok=_ok, code=code)
            except Exception:
                pass
        body = json.dumps(obj, ensure_ascii=False).encode("utf-8")
        gz = len(body) > 1400 and self._gz_ok()           # 🗜️ الملخص ~50 كيلو ⇒ ~10 كيلو (أخف على نت الموبايل 5 مرات)
        if gz:
            body = _gzip.compress(body, 5)
        self.send_response(code)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Cache-Control", "no-store")
        if gz:
            self.send_header("Content-Encoding", "gzip")
            self.send_header("Vary", "Accept-Encoding")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

