function riPrev(now,px,coinSide,base){
  const el=$('#i_prev'); if(!el)return;
  const n=parseFloat(($('#i_amt')||{}).value||'0')||0;
  if(!isFinite(n)||n<=0){el.innerHTML='<span style="color:var(--mut2)">اكتب المقدار لتشوف الأثر</span>';return}
  const cost=coinSide?n*px:n, after=(+now||0)+n;
  const pct=(+now>0)?(n/now*100):0;
  el.innerHTML=`يصبح الأمر <b style="color:var(--cyan)">${after.toFixed(4)}</b>`
    +`<span style="color:var(--mut2)"> ${coinSide?base:'$'}</span>`
    +(pct>0?` <span style="color:var(--green)">(+${pct.toFixed(1)}%)</span>`:'')
    +`<br>الكلفة من محفظتك: <b style="color:var(--amber)">${cost.toFixed(4)}$</b>`;
}

function riInject(dir,k,px,coinSide,cur){
  const b=botOf(dir); if(!b)return;
  const base=(b.symbol||'').split('-')[0];
  const unit=coinSide?base:'$';
  const now=+cur||0;
  const f4=v=>(+v).toFixed(4), f2=v=>(+v).toFixed(2);
  const quick=[10,25,50].map(q=>`<button onclick="$('#i_amt').value='${f4(now*q/100)}';riPrev(${now},${px},${coinSide?1:0},'${base}')" style="font-size:11px;padding:2px 10px;border-radius:6px">+${q}%</button>`).join('');
  const _sl=stRiRow(b,k);
  showDialog(`<h2>💉 حقن رأس مال — ${_sl&&_sl.lbl?'🪜 المستوى '+_sl.lbl.replace(' · ',' · الجزء '):'الدرجة '+(+px).toFixed(4)}</h2>
   <p style="color:var(--mut);font-size:12.5px;line-height:1.8">
     ${coinSide?`عملة من محفظتك تُضاف <b>لأمر البيع نفسه فوراً</b> (منشور أو بالذاكرة).`:`الدولار يكبّر <b>أمر الشراء فوراً</b> — وإن تعذّر ذلك، يذهب إلى الحصّالة ويكبر بدورته.`}</p>
   <div style="background:var(--bg1);border:1px solid var(--line2);border-radius:10px;padding:10px;margin-top:6px">
     <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap">
       <b style="color:var(--cyan);font-size:13px">💵 المقدار (${unit})</b>
       <span style="color:var(--mut2);font-size:11.5px">الأمر الآن:
         <b style="color:var(--tx)">${f2(now)}${coinSide?' '+base:'$'}</b></span></div>
     <input id="i_amt" type="number" step="0.0001" min="0" placeholder="0.0000"
       oninput="riPrev(${now},${px},${coinSide?1:0},'${base}')"
       style="width:100%;margin-top:8px;padding:8px;border-radius:8px;border:1px solid var(--line2);
       background:var(--bg0);color:var(--tx);font-size:14px">
     <div style="display:flex;gap:6px;margin-top:7px;flex-wrap:wrap">${quick}</div>
     <div id="i_prev" style="margin-top:9px;font-size:12px;color:var(--mut);line-height:1.8">
       <span style="color:var(--mut2)">اكتب المقدار لتشوف الأثر</span></div>
   </div>
   <p style="color:var(--amber);font-size:11.5px;margin-top:10px;line-height:1.7">
     ⚠️ هذا <b>رأس مالك وليس ربحاً</b> — يعود إليك رأس مال عند السحب أو الإلغاء.<br>
     ✅ يتعدّل الأمر <b>فوراً</b> في المنصة — وإن لم يكفِ رصيدك الحر، يُرفض ولا يتغيّر شيء.</p>
   <div class="mbtns"><button class="primary" id="i_go">💉 احقن</button>
     <button onclick="hideModal()">إلغاء</button></div>`);
  $('#i_go').onclick=async()=>{
    const n=parseFloat($('#i_amt').value||'0')||0;
    if(!isFinite(n)||n<=0){toast('مقدار غير صالح',false);return}
    const it={k:String(k),px:+px};
    if(coinSide)it.coin=n; else it.usd=n;
    const r=await api('/api/control',{dir,action:'ri_inject',value:[it]});
    toast(r&&r.msg?r.msg:'انبعث', !!(r&&r.ok));
    if(r&&r.ok){hideModal();tick()}
  };
  setTimeout(()=>{const e=$('#i_amt');if(e)e.focus()},110);
}

function gForm(x){                                           // 🪙 عملة داخل الأمر · 💵 بعده دولار
  if(!x||!(+x.g>0))return '';
  if(x.s==='sell'&&x.io!==undefined&&x.io!==null){const io=+x.io,g=+x.g;
    return io>=g-1e-9?' <span style="font-size:10px">🪙</span>':(io<=1e-9?' <span style="font-size:10px">💵</span>':' <span style="font-size:10px">🪙💵</span>');}
  if(x.io!==undefined&&x.io!==null){const io=+x.io,g=+x.g;                 // جهة الشراء: 💵 داخل الأمر · 📒 بالدفتر
    return io>=g-1e-9?' <span style="font-size:10px">💵</span>':(io<=1e-9?' <span style="font-size:10px">📒</span>':' <span style="font-size:10px">💵📒</span>');}
  return ' <span style="font-size:10px">💵</span>';
}
function gFormT(x){
  if(!x||!(+x.g>0))return '';
  if(x.s==='sell'&&x.io!==undefined&&x.io!==null){const io=+x.io,g=+x.g;
    return io>=g-1e-9?'النمو عملة داخل أمر البيع — يُسحب عملة':(io<=1e-9?'النمو ما زال دولاراً — يصبح عملة حين يُنفَّذ الشراء القادم في هذه الدرجة':'جزء عملة في الأمر وجزء ما زال دولاراً');}
  if(x.io!==undefined&&x.io!==null){const io=+x.io,g=+x.g;
    return io>=g-1e-9?'النمو دولار داخل أمر الشراء — السحب يصغّر الأمر ويتأكد من المنصة':(io<=1e-9?'النمو دولار في الدفتر (لم يدخل أمر الشراء بعد) — السحب لا يغيّر شيئاً في المنصة':'جزء داخل أمر الشراء وجزء في الدفتر');}
  return 'النمو دولار (جهة الشراء) — يكبّر أمر الشراء';
}
function riWithdraw(dir,k,px,inj,total,coinSide,io){
  const b=botOf(dir); if(!b)return;
  const base=(b.symbol||'').split('-')[0], p=+px||0, cs=!!(+coinSide);
  const capU=Math.max(0,Math.min(+inj||0,+total||0)), gainU=Math.max(0,(+total||0)-capU);
  let cap=cs&&p>0?capU/p:capU, gain=cs&&p>0?gainU/p:gainU;
  const ioN=(io===undefined||io===null||+io<0)?null:(+io);        // 🪙 جهة البيع: ما ينسحب أكثر من العملة الموجودة فعلاً بالأمر
  const bookOnly=cs&&ioN!==null&&(cap+gain)>ioN+1e-9;
  if(cs&&ioN!==null){cap=Math.min(cap,ioN); gain=Math.min(gain,Math.max(0,ioN-cap));}
  // 💵 جهة البيع: الجزء اللي بعده دولار (حصّالة + نمو ما صار عملة) — رأس المال ينحسب بالعملة أولاً (نفس البوت والإيقاف)
  const valD=cs&&ioN!==null&&p>0?Math.max(0,(+total||0)-ioN*p):0;
  const capD=valD>0?Math.min(valD,Math.max(0,capU-cap*p)):0, gainD=valD>0?Math.max(0,valD-capD):0;
  const flD=v=>Math.floor((+v)*1e4+1e-9)/1e4, capDS=flD(capD).toFixed(4), gainDS=flD(gainD).toFixed(4);
  const noCoin=cs&&ioN!==null&&ioN<=1e-12;                  // ماكو عملة معاد استثمارها داخل الأمر
  const u=cs?' '+base:'$', dp=cs?6:4, st=cs?'0.000001':'0.0001';
  const fl=v=>Math.floor((+v)*Math.pow(10,dp)+1e-9)/Math.pow(10,dp);      // «الكل» ينزل لتحت — ما يتجاوز المتاح أبداً
  const capS=fl(cap).toFixed(dp), gainS=fl(gain).toFixed(dp);
  const BX='background:var(--bg1);border:1px solid var(--line2);border-radius:10px;padding:10px';
  const IN='width:100%;padding:8px;border-radius:8px;border:1px solid var(--line2);background:var(--bg0);color:var(--tx);font-size:14px';
  const _sl=stRiRow(b,k);
