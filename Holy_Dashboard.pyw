def _mkt_back(dd, t, days):
    """أقرب قيمة محفوظة قبل `days` يوم من t (يقبل يومين فرق)"""
    for k in range(3):
        v = dd.get(str(t - (days + k) * 86400))
        if v is not None:
            return v
    return None


