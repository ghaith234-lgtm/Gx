BFX = []          # 📉 نفسه لحسابات البوتات اللي مو مضافة كمحفظة


def _px_ref(ccy, px):
    """📉 v3.21.7: سعر المرجع لليوم لكل عملة = أول سعر شافته اللوحة اليوم (منتصف الليل بتوقيت السيرفر · أو أول تشغيل).
    ينحفظ بـHoly_PxRefW.json ⇒ إعادة تشغيل اللوحة بنفس اليوم ما تغيّره."""
    try:
        px = float(px)
    except Exception:
        return None
    if not (px > 0 and math.isfinite(px)):
        return None
    d = datetime.now().strftime("%Y-%m-%d")
    with _WREF_LOCK:
        if _WREF["day"] != d:
            ref = load_json(os.path.join(ROOT, "Holy_PxRefW.json")) or {}
            _WREF["day"] = d
            _WREF["px"] = dict(ref.get("px") or {}) if ref.get("day") == d else {}
            _WREF["dirty"] = True
        if ccy not in _WREF["px"]:
            _WREF["px"][ccy] = px
            _WREF["dirty"] = True
        try:
            return float(_WREF["px"][ccy])
        except Exception:
            return None


def _px_ref_save():
    with _WREF_LOCK:
        if not _WREF["dirty"] or not _WREF["day"]:
            return
        data = {"day": _WREF["day"], "px": dict(_WREF["px"])}
        _WREF["dirty"] = False
    try:
        save_json_atomic(os.path.join(ROOT, "Holy_PxRefW.json"), data)
    except Exception:
        pass


def _fx_coin(ccy, qty, usd):
    """📉 v3.21.7: أثر السعر لعملة = الكمية الكلية × (السعر الحالي − سعر أول اليوم). المستقرة والصفرية بلا أثر."""
    try:
        qty, usd = float(qty), float(usd)
    except Exception:
        return None
    if not ccy or ccy in STABLE_CCY or qty <= 0 or usd <= 0:
        return None
    px = usd / qty
    ref = _px_ref(ccy, px)
    if not ref:
        return None
    return {"fx": qty * (px - ref), "pct": (px / ref - 1.0) * 100.0}


def _bot_fx():
    """📉 v3.21.7: حسابات البوتات اللي مفاتيحها مو مضافة كمحفظة — عملة كل حساب تنحسب مرة وحدة (بوتين بنفس العملة = مرة)."""
    wk = {str(w.get("api") or "").strip() for w in (app_cfg().get("wallets") or []) if w.get("api")}
    acc = {}
    for b in bot_dirs().values():
        cfg = b["cfg"]
        if cfg.get("is_demo"):
            continue
        k = str(cfg.get("api_key") or "").strip()
        if not k or k in wk:
            continue
        ent = BAL.get(b["dir"]) or {}
        base = b["symbol"].split("-")[0]
        a = acc.setdefault(k, {})
        if base not in a and float(ent.get("base_eq") or 0) > 0:
            a[base] = (float(ent.get("base_eq") or 0), float(ent.get("base_usd") or 0))
    out = []
    for k, a in acc.items():
        cs, sm = [], 0.0
        for ccy, (q, u) in sorted(a.items(), key=lambda kv: -kv[1][1]):
            c = {"ccy": ccy, "tot": round(q, 8), "usd": round(u, 2)}
            f = _fx_coin(ccy, q, u)
            if f:
                c.update(fx=round(f["fx"], 2), pct=round(f["pct"], 2))
                sm += f["fx"]
            cs.append(c)
        if cs:
            out.append({"key": k[:6] + "…", "usd": round(sm, 2), "coins": cs})
    BFX[:] = out

