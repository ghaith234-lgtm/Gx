def bot_dirs():
    found = {}
    for cfgp in glob.glob(os.path.join(ROOT, "config_*.json")) + glob.glob(os.path.join(ROOT, "*", "config_*.json")):
        d = os.path.dirname(cfgp) or ROOT
        if os.path.basename(d).startswith("_archive"):
            continue
        cfg = load_json(cfgp)
        if isinstance(cfg, dict) and cfg.get("symbol"):
            found[d] = {"dir": d, "cfg_path": cfgp, "cfg": cfg, "symbol": cfg["symbol"]}
    return found

def paths_of(b):
    sym = b["symbol"]; base = sym.split("-")[0]
    _bt0 = b.get("cfg", {}).get("bot_type")
    state_name = (f"dca_state_{sym}.json" if _bt0 in ("dca", "dca_buy") else
                  f"rec_state_{sym}.json" if _bt0 in _REC_T else f"grid_state_{sym}.json")   # 🔁 v3.25.0: الدوري
    return (os.path.join(b["dir"], state_name),
            os.path.join(b["dir"], f"trade_history_{base}.json"),
            os.path.join(b["dir"], "log_main.txt"))

def is_alive(d, state_path):
    p = PROCS.get(d)
    if p is not None and p.poll() is None:
        return True, "dash"
    try:
        if time.time() - os.path.getmtime(state_path) < ALIVE_WINDOW:
            return True, "external"
    except Exception:
        pass
    try:   # 🔎 عملية يتيمة بعد إعادة تشغيل اللوحة — نشوفها بمجلد العمل
        if bot_pids(d):
            return True, "orphan"
    except Exception:
        pass
    return False, ""

PROFIT_RE = re.compile(r"(?:الربح|Profit)\s*[:：]?\s*\+\s*([0-9]+(?:\.[0-9]+)?)")

def _eng_old(b):
    try:
        _, eng_script, eng_ver = engine_for(b["cfg"])
        mp = os.path.join(b["dir"], eng_script)
        if not os.path.exists(mp):
            return False
        return _file_fp(mp) != eng_ver
    except Exception:
