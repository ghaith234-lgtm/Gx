ACCUM_FILE = os.path.join(ROOT, "Holy_Accum.json")

def acc_cfgs():
    """قائمة المراكمات من الإعدادات"""
    return app_cfg().get("accumulators") or []

def acc_state():
    return load_json(ACCUM_FILE) or {}

def _acc_save(s):
    try: save_json_atomic(ACCUM_FILE, s)
    except Exception: pass

def _acc_keys():
    """مفاتيح API: من أول محفظة، وإلا من أول بوت حقيقي"""
    for w in (app_cfg().get("wallets") or []):
        if w.get("api") and w.get("sec") and w.get("pass"):
            return w["api"], w["sec"], w["pass"], w.get("name", "")
    for b in bot_dirs().values():
        c = b["cfg"]
        if not c.get("is_demo") and c.get("api_key") and c.get("secret_key") and c.get("passphrase"):
            return c["api_key"], c["secret_key"], c["passphrase"], b["symbol"]
    return None, None, None, None

# ───── 👛 v3.22.9: المُراكِم لكل محفظة — حساب مستقل: ياخذ من ربح بوتات محفظته بس · يشتري ويبيع بمفاتيحها · تختارها قبل النشر ─────
def _live_wmap():
    """{مفتاح الدفتر (مجلد البوت): wid} للبوتات الحقيقية الحية (wid = بصمة المفتاح — ولا حرف منه)"""
    out = {}
    for b in bot_dirs().values():
        c = b.get("cfg") or {}
        k = str(c.get("api_key") or "").strip()
        if c.get("is_demo") or not k:
            continue
        out[os.path.relpath(b["dir"], ROOT)] = _gd_wid(k)
    return out


def _led_wid(k, e, live=None):
    """👛 محفظة سطر بالدفتر: الوسم المحفوظ `w` (يبقى بعد حذف البوت) وإلا محفظة البوت الحي"""
    w = (e or {}).get("w") if isinstance(e, dict) else None
    if w:
        return w
    return (live if live is not None else _live_wmap()).get(k, "")


def day_profit_w(day, wid, led=None, live=None):
    """💰 ربح بوتات محفظة وحدة ليوم — نفس `day_profit` بس مقصور على المحفظة (المُراكِم ياخذ نسبته من هذا)"""
    led = (load_json(LEDGER) or {}) if led is None else led
    live = _live_wmap() if live is None else live
    tot = 0.0
    for k, e in led.items():
        if str(k).startswith("_") or not isinstance(e, dict):
            continue
        if _led_wid(k, e, live) != wid:
            continue
        tot += float((e.get("daily") or {}).get(day) or 0)
    return round(tot, 6)


def acc_wallets():
    """👛 المحافظ اللي ينفتح عليها مُراكِم: كل مفتاح OKX حقيقي (المحافظ المحفوظة + مفاتيح البوتات) —
    {wid: {wid · name · label · keys · bots}} · `keys` للاستعمال الداخلي بس (ولا يطلع للواجهة)."""
    out = {}
    for w in (app_cfg().get("wallets") or []):
        k = str(w.get("api") or "").strip()
        if k and w.get("sec") and w.get("pass"):
            wid = _gd_wid(k)
            out.setdefault(wid, {"wid": wid, "name": str(w.get("name") or ""), "keys": (k, w["sec"], w["pass"]), "bots": []})
    for b in bot_dirs().values():
        c = b.get("cfg") or {}
        k = str(c.get("api_key") or "").strip()
        if c.get("is_demo") or not (k and c.get("secret_key") and c.get("passphrase")):
            continue
        wid = _gd_wid(k)
        out.setdefault(wid, {"wid": wid, "name": "", "keys": (k, c["secret_key"], c["passphrase"]), "bots": []})["bots"].append(b)
    for wid, W in out.items():
        try:
            W["label"] = _gd_wlabel({"keys": W["keys"], "bots": W["bots"], "acc": False})
        except Exception:
            W["label"] = W["name"] or wid
        if not W["bots"]:
            W["label"] = ("محفظة · " + W["name"]) if W["name"] else W["label"]
    return out


def acc_wid(a):
    """👛 محفظة المُراكِم (`wid` بإعداداته) — مُراكِم قديم بلا محفظة ⇒ محفظة الشراء القديمة (أول محفظة/أول بوت)"""
    w = str((a or {}).get("wid") or "")
    if w:
        return w
    try:
        k = _acc_keys()[0]
        return _gd_wid(k) if k else ""
    except Exception:
        return ""


def acc_wids():
    return {acc_wid(a) for a in acc_cfgs() if acc_wid(a)}


def _acc_keys_for(a):
    """🔑 مفاتيح محفظة المُراكِم نفسها — ولا مرة مفاتيح محفظة ثانية (لو محفظته انحذفت ⇒ بلا مفاتيح، ما يشتري من حساب غيره)"""
    wid = acc_wid(a)
    W = acc_wallets().get(wid) if wid else None
    if not W:
        return None, None, None, None
    k, s_, p_ = W["keys"]
    return k, s_, p_, (W.get("name") or W.get("label") or wid)


def _acc_migrate():
    """👛 مُراكِم قديم (قبل v3.22.9) بلا محفظة ⇒ نثبّته على المحفظة اللي كان يشتري بيها فعلاً — مرة وحدة، بلا ما يتغيّر شي بحسابه."""
    try:
        c = app_cfg()
        lst = c.get("accumulators") or []
        if not lst or all(a.get("wid") for a in lst):
            return 0
        k = _acc_keys()[0]
        if not k:
            return 0
        w = _gd_wid(k)
        n = 0
        for a in lst:
            if not a.get("wid"):
                a["wid"] = w; n += 1
        c["accumulators"] = lst
        save_app_cfg(c)
        try:
            journal("accum", f"👛 {n} مُراكِم قديم انثبّت على محفظته ({w}) — من هسه ياخذ من ربح بوتات محفظته بس", "ok", wallet=w, n=n)
        except Exception:
            pass
        return n
    except Exception:
        return 0


def _acc_price(sym):
    """السعر: ذاكرة اللوحة ← OKX (عدة مضيفات) ← حالة بوت يتداول نفس العملة"""
    p = PX.get(sym)
    if p:
        try:
            if float(p) > 0: return float(p)
        except Exception: pass
    try:
        r = _okx_pub(f"/api/v5/market/ticker?instId={sym}")
        if r and r.get("code") == "0":
            v = float(r["data"][0].get("last") or 0)
            if v > 0: return v
    except Exception:
        pass
    # 🛟 بوت يتداول نفس الرمز — سعر OKX الحي من WebSocket
    try:
        for b in bot_dirs().values():
            if b["symbol"] != sym or b["cfg"].get("is_demo"):
                continue
            sp, _, _ = paths_of(b)
            st = load_json(sp) or {}
            v = float(st.get("current_price") or 0)
            if v > 0:
                return v
    except Exception:
        pass
    # 🌐 Binance — منصة مستقلة تماماً (فرق بسيط عن OKX، مقبول للمبالغ الصغيرة)
    try:
        j = _http_json("https://api.binance.com/api/v3/ticker/price?symbol="
                       + sym.replace("-", ""), timeout=10)
        v = float((j or {}).get("price") or 0)
        if v > 0:
            return v
    except Exception:
        pass
    return 0.0

def day_profit(day):
    """💰 مجموع ربح كل بوتات الجرد ليوم محدد (بالدولار) — من السجل"""
    led = load_json(LEDGER) or {}
    tot = 0.0
    for k, e in led.items():
        if str(k).startswith("_") or not isinstance(e, dict): continue
        tot += float((e.get("daily") or {}).get(day) or 0)
    return round(tot, 6)

_INST_CACHE = {}

def _acc_spec(sym):
    """📏 مواصفة العملة (حد أدنى · وحدة الكمية) — لازمة حتى لا يُرفض البيع"""
    c = _INST_CACHE.get(sym)
    if c and time.time() - c["t"] < 3600:
        return c["v"]
    v = {"lotSz": 0.00000001, "minSz": 0.0}
    try:
        r = _okx_pub(f"/api/v5/public/instruments?instType=SPOT&instId={sym}")
        if r and r.get("code") == "0" and (r.get("data") or []):
            d = r["data"][0]
            v = {"lotSz": float(d.get("lotSz") or 0.00000001),
                 "minSz": float(d.get("minSz") or 0)}
    except Exception:
        pass
    _INST_CACHE[sym] = {"t": time.time(), "v": v}
    return v

def _acc_fmt_qty(sym, q):
    """يقرّب الكمية لأسفل لوحدة العملة"""
    sp = _acc_spec(sym); lot = sp["lotSz"] or 0.00000001
    try:
        n = math.floor(float(q) / lot) * lot
        return round(n, 10)
    except Exception:
        return 0.0

def _acc_fill(dd, sym, side):
    """📐 يستخرج التنفيذ الحقيقي من رد OKX — بعد خصم الرسوم.
    الشراء: الرسم يُخصم من العملة (تستلم أقل) → المعدل الحقيقي أعلى.
    البيع:  الرسم يُخصم من الدولار (تستلم أقل) → الربح الحقيقي أقل."""
    try:
        qty = float(dd.get("accFillSz") or 0)
        px = float(dd.get("avgPx") or 0)
    except Exception:
        return 0.0, 0.0, 0.0
    if qty <= 0 or px <= 0:
        return 0.0, 0.0, 0.0
    gross = qty * px
    try:
        fee = float(dd.get("fee") or 0)          # سالب عادةً
    except Exception:
        fee = 0.0
    fccy = str(dd.get("feeCcy") or "").upper()
    base = sym.split("-")[0].upper(); quote = sym.split("-")[-1].upper()
    if side == "buy":
        # الرسم بالعملة الأساسية → ينقص ما استلمته فعلاً
        net_qty = qty + fee if (fccy == base and fee) else qty
        return max(net_qty, 0.0), round(gross, 8), px
    # بيع: الرسم بالدولار → ينقص ما قبضته
    net_usd = gross + fee if (fccy == quote and fee) else gross
    return qty, round(max(net_usd, 0.0), 8), px


def acc_sell_preview(aid):
    """💰 كم الربح لو بعت الآن؟ (قبل التنفيذ)"""
    a = next((x for x in acc_cfgs() if x.get("id") == aid), None)
    if not a: return None
    e = acc_state().get(aid) or {}
    coin = float(e.get("coin", 0)); spent = float(e.get("spent", 0))
    if coin <= 0: return {"ok": False, "msg": "لا توجد عملة مجمّعة"}
    sym = a.get("symbol", ""); px = _acc_price(sym)
    if px <= 0: return {"ok": False, "msg": "تعذّر جلب السعر"}
    sellable = _acc_fmt_qty(sym, coin)
    sp = _acc_spec(sym)
    if sellable <= 0 or (sp["minSz"] and sellable < sp["minSz"]):
        return {"ok": False, "msg": f"الكمية أقل من حد OKX ({sp['minSz']} {sym.split('-')[0]})"}
    gross = round(sellable * px, 4)
    avg = round(spent / coin, 10) if coin > 0 else 0
    cost = round(sellable * avg, 4)
    return {"ok": True, "coin": coin, "sellable": sellable, "px": px, "avg": avg,
            "gross": gross, "cost": cost, "profit": round(gross - cost, 4),
            "pct": round((gross - cost) / cost * 100, 2) if cost > 0 else 0,
            "base": sym.split("-")[0], "symbol": sym}

def acc_sell_now(aid, qty=None, reason="يدوي"):
    """💰 بيع سوقي للعملة المجمّعة — مع تأكيد التنفيذ من المنصة"""
    a = next((x for x in acc_cfgs() if x.get("id") == aid), None)
    if not a: return False, "المُراكِم غير موجود"
    st_all = acc_state()
    e = st_all.get(aid) or {}
    if e.get("inflight"):
        return False, "⏳ في أمر شراء ينتظر التأكيد — انتظر تسويته أولاً"
    if e.get("sell_inflight"):
        return False, "⏳ في أمر بيع ينتظر التأكيد"
    coin = float(e.get("coin", 0)); spent = float(e.get("spent", 0))
    if coin <= 0: return False, "لا توجد عملة مجمّعة للبيع"
    sym = a.get("symbol", "")
    want = float(qty) if qty else coin
    want = min(want, coin)
    sell_q = _acc_fmt_qty(sym, want)
    sp = _acc_spec(sym)
    if sell_q <= 0 or (sp["minSz"] and sell_q < sp["minSz"]):
        return False, f"الكمية {want} أقل من حد OKX ({sp['minSz']})"
    k, s, p, who = _acc_keys_for(a)                     # 👛 v3.22.9
    if not k: return False, "🔑 محفظة هالمُراكِم ما إلها مفاتيح (انحذفت؟) — اختر محفظته من ⚙️ بالكرت"
    cl = "HACS" + str(int(time.time()))[-7:] + _sc.token_hex(2)
    e["sell_inflight"] = {"cl": cl, "qty": sell_q, "ts": time.time(), "sym": sym}
    _acc_save(st_all)
    r = _okx_post("/api/v5/trade/order",
                  {"instId": sym, "tdMode": "cash", "side": "sell", "ordType": "market",
                   "sz": str(sell_q), "stpMode": "cancel_maker", "clOrdId": cl}, k, s, p)
    if not r:
        return False, "تعذّر الاتصال — يُتحقق من الأمر بالدورة القادمة"
    if r.get("code") != "0":
        e.pop("sell_inflight", None); _acc_save(st_all)
        return False, okx_errmsg(r, who)                 # 🔑 v3.22.7
    oid = (r.get("data") or [{}])[0].get("ordId", "")
    got = 0.0; avgpx = 0.0
    for _ in range(6):
        time.sleep(1.2)
        q2 = _okx_get(f"/api/v5/trade/order?instId={sym}&ordId={oid}", k, s, p)
        if q2 and q2.get("code") == "0" and (q2.get("data") or []):
            dd = q2["data"][0]
            if dd.get("state") == "filled":
                got, _net_usd, avgpx = _acc_fill(dd, sym, "sell")
                break
    if got <= 0:
        e["sell_inflight"]["oid"] = oid; _acc_save(st_all)
        return False, "⏳ أُرسل أمر البيع — بانتظار تأكيد المنصة"
    return _acc_apply_sell(a, st_all, got, avgpx, reason, net_usd=_net_usd)

def _acc_apply_sell(a, st_all, got, avgpx, reason="يدوي", net_usd=None):
    """يسجّل بيعاً مؤكّداً: يخصم الكمية والتكلفة، ويصفّر المعدل لو بيع الكل"""
    aid = a["id"]; e = st_all.setdefault(aid, {})
    e.pop("sell_inflight", None)
    coin = float(e.get("coin", 0)); spent = float(e.get("spent", 0))
    avg = (spent / coin) if coin > 0 else 0
    sold = min(got, coin)
    revenue = round(net_usd if (net_usd is not None and got > 0 and abs(sold - got) < 1e-12)
                    else sold * avgpx, 4)
    cost = round(sold * avg, 4)
    profit = round(revenue - cost, 4)
    left = round(coin - sold, 10)
    if left <= 1e-10:
        e["coin"] = 0.0; e["spent"] = 0.0        # 🔄 بيع كامل — المعدل يصفّر
    else:
        e["coin"] = left
        e["spent"] = round(spent - cost, 4)      # بيع جزئي — المعدل يبقى كما هو
    e["realized"] = round(float(e.get("realized", 0)) + profit, 4)
    e["sells"] = ([{"ts": time.time(), "qty": round(sold, 10), "usd": revenue,
                    "px": round(avgpx, 10), "profit": profit, "why": reason}]
                  + list(e.get("sells") or []))[:200]
    _acc_save(st_all)
    base = a.get("symbol", "").split("-")[0]
    _pct = (profit / cost * 100) if cost > 0 else 0
    tg_send(f"💰 *[بيع المجمّع]* `{a.get('name') or a.get('symbol')}`\n"
            f"باع `{sold:.8f}` {base} بـ `{revenue:.2f}$` @ `{avgpx}`\n"
            f"معدل الشراء كان: `{avg:.8f}$` · كلّف `{cost:.2f}$`\n"
            f"💵 الربح المحقق: `{profit:+.2f}$` (`{_pct:+.1f}%`)\n"
            f"الإجمالي المحقق: `{float(e.get('realized') or 0):+.2f}$`\n"
            f"{'🔄 صُفّر المعدل — يبدأ تجميع جديد من الصفر' if left <= 1e-10 else f'المتبقي: `{left:.8f}` {base}'}")
    return True, (f"✅ باع {sold:.8f} {base} بـ {revenue:.2f}$ · ربح {profit:+.2f}$"
                  + (" · صُفّر المعدل" if left <= 1e-10 else ""))

def acc_settle_sell(a, st_all):
    """🛡️ تسوية أمر بيع ضاع رده"""
    e = st_all.get(a["id"]) or {}
    inf = e.get("sell_inflight")
    if not inf: return False
    k, s, p, _ = _acc_keys_for(a)
    if not k: return True
    sym = inf.get("sym"); oid = inf.get("oid"); cl = inf.get("cl")
    q = (_okx_get(f"/api/v5/trade/order?instId={sym}&ordId={oid}", k, s, p) if oid
         else _okx_get(f"/api/v5/trade/order?instId={sym}&clOrdId={cl}", k, s, p))
    if q is None: return True
    if not _okx_no_order(q): return True     # 🔑 v3.22.7: رفض مفتاح/خطأ منصة ≠ «الأمر مو موجود» → انتظر
    if q.get("code") != "0" or not (q.get("data") or []):
        if time.time() - float(inf.get("ts") or 0) > 90:
            e.pop("sell_inflight", None); _acc_save(st_all); return False
        return True
    dd = q["data"][0]; stt = dd.get("state")
    if stt in ("live", "partially_filled"): return True
    if stt == "filled":
        _q, _nu, _px = _acc_fill(dd, sym, "sell")
        _acc_apply_sell(a, st_all, _q, _px, "تسوية", net_usd=_nu)
        return False
    e.pop("sell_inflight", None); _acc_save(st_all)
    return False


def acc_buy_now(a, st_all, amount, price, reason="آلي"):
    """🛒 ينفّذ شراءً سوقياً بمبلغ USDT — يرجع (نجح، رسالة)"""
    sym = a.get("symbol", "")
    k, s, p, who = _acc_keys_for(a)                     # 👛 v3.22.9: مفاتيح محفظة المُراكِم نفسها
    if not k:
        return False, "🔑 محفظة هالمُراكِم ما إلها مفاتيح (انحذفت؟) — اختر محفظته من ⚙️ بالكرت"
    amt = round(float(amount), 2)
    # 🛡️ حارس أخير: لا يُصرف أبداً أكثر من الرصيد المتراكم — مهما كان المُستدعي
    _fld = "pool" if reason == "آلي" else "pending"     # التلقائي من قيد الشراء · اليدوي من المتراكم
    _pend_now = round(float((st_all.get(a["id"]) or {}).get(_fld, 0)), 6)
    if amt > _pend_now + 1e-6:
        amt = round(_pend_now, 2)
    if amt < 1:
        return False, f"المبلغ ضئيل ({amt}$ · المتاح {_pend_now}$)"
    cl = "HACC" + str(int(time.time()))[-7:] + _sc.token_hex(2)
    body = {"instId": sym, "tdMode": "cash", "side": "buy", "ordType": "market",
            "sz": str(amt), "tgtCcy": "quote_ccy", "stpMode": "cancel_maker",
            "clOrdId": cl}
    # 🛡️ بصمة قبل الإرسال: لو ضاع الرد بعد وصول الأمر لـOKX، الدورة القادمة
    #    تتحقق من هذه البصمة أولاً بدل ما تشتري مرة ثانية
    _e0 = st_all.setdefault(a["id"], {"pending": 0.0, "pool": 0.0, "coin": 0.0, "spent": 0.0, "buys": []})
    _e0["inflight"] = {"cl": cl, "amt": amt, "ts": time.time(), "sym": sym, "fld": _fld}
    _acc_save(st_all)
    r = _okx_post("/api/v5/trade/order", body, k, s, p)
    if not r:
        return False, "تعذّر الاتصال — سيُتحقق من الأمر بالدورة القادمة قبل أي شراء"
    if r.get("code") != "0":
        _e0.pop("inflight", None); _acc_save(st_all)   # رُفض صراحةً — لا أمر معلّق
        return False, okx_errmsg(r, who)                 # 🔑 v3.22.7: رفض المفتاح ⇒ اسم المحفظة + الحل
    oid = (r.get("data") or [{}])[0].get("ordId", "")
    # نتحقق من التنفيذ الفعلي
    got = 0.0; paid = amt; avg = price
    for _ in range(6):
        time.sleep(1.2)
        q = _okx_get(f"/api/v5/trade/order?instId={sym}&ordId={oid}", k, s, p)
        if q and q.get("code") == "0" and (q.get("data") or []):
            dd = q["data"][0]
            if dd.get("state") == "filled":
                got, paid, avg = _acc_fill(dd, sym, "buy")
                if not avg: avg = price
                paid = round(paid, 4)
                break
    if got <= 0:
        # 🛡️ لم يتأكّد التنفيذ من المنصة — لا نسجّل شيئاً ولا نخصم.
        #    البصمة تبقى، والتسوية بالدورة القادمة تتحقق وتسجّل الحقيقة.
        _e0["inflight"]["oid"] = oid
        _acc_save(st_all)
        return False, "⏳ أُرسل الأمر — بانتظار تأكيد المنصة (يُسوّى بالدورة القادمة)"
    aid = a["id"]
    e = st_all.setdefault(aid, {"pending": 0.0, "coin": 0.0, "spent": 0.0, "buys": []})
    e.pop("inflight", None)
    e["coin"] = round(float(e.get("coin", 0)) + got, 8)
    e["spent"] = round(float(e.get("spent", 0)) + paid, 4)
    e[_fld] = round(max(0.0, float(e.get(_fld, 0)) - amt), 6)
    e["buys"] = ([{"ts": time.time(), "qty": round(got, 8), "usd": round(paid, 4),
                   "px": round(avg, 8), "why": reason}] + list(e.get("buys") or []))[:400]
    _acc_save(st_all)
    base = sym.split("-")[0]
    _msg = (f"🪙 *[شراء من الأرباح]* `{a.get('name') or sym}`\n"
            f"اشترى `{got:.8f}` {base} بـ `{paid:.2f}$` @ `{avg}`\n"
            f"النوع: {'آلي (نهاية اليوم)' if reason == 'آلي' else 'يدوي'}\n")
    _c = float(e.get("coin") or 0); _s = float(e.get("spent") or 0)
    if _c > 0:
        _msg += (f"الإجمالي: `{_c:.8f}` {base} · كلّف `{_s:.2f}$`\n"
                 f"متوسط الشراء: `{_s / _c:.8f}$`\n")
    _msg += (f"⏳ قيد الشراء: `{float(e.get('pool') or 0):.2f}$` · "
             f"🏧 المتراكم: `{float(e.get('pending') or 0):.2f}$`")
    tg_send(_msg)
    log_line = f"🪙 [{a.get('name') or sym}] شراء {got:.6f} {base} بـ {paid:.2f}$ @ {avg}"
    try: print(log_line)
    except Exception: pass
    return True, f"✅ اشترى {got:.6f} {base} بـ {paid:.2f}$"

def _okx_no_order(q):
    """🔑 v3.22.7: رد استعلام الأمر — True لو صالح للحكم: الأمر موجود (code 0 + بيانات) أو OKX يقول صراحةً «مو موجود» (51603).
    أي رفض ثاني (مفتاح 50119 · ضغط 50011 · عطل 50001 …) ⇒ False: ما نعرف شي ⇒ ننتظر — ما نمسح البصمة ونشتري فوقها."""
    try:
        c = str(q.get("code"))
        if c == "0":
            return True
        if c == "51603":
            return True
        d = q.get("data") or []
        return bool(d) and isinstance(d[0], dict) and str(d[0].get("sCode")) == "51603"
    except Exception:
        return False

def _acc_settle(a, st_all):
    """🛡️ يسوّي أمراً سابقاً ضاع رده — يرجع True لو ما زال معلّقاً (فامنع شراءً جديداً)"""
    aid = a["id"]
    e = st_all.get(aid) or {}
    inf = e.get("inflight")
    if not inf:
        return False
    k, s, p, _ = _acc_keys_for(a)
    if not k:
        return True                      # ما نقدر نتحقق → لا تشترِ
    cl = inf.get("cl"); sym = inf.get("sym") or a.get("symbol", "")
    oid = inf.get("oid")
    q = (_okx_get(f"/api/v5/trade/order?instId={sym}&ordId={oid}", k, s, p) if oid
         else _okx_get(f"/api/v5/trade/order?instId={sym}&clOrdId={cl}", k, s, p))
    if q is None:
        return True                      # الشبكة لسه مقطوعة → انتظر
    if not _okx_no_order(q):
        return True                      # 🔑 v3.22.7: رفض مفتاح/ضغط/خطأ منصة ≠ «الأمر مو موجود» → انتظر (ولا شراء فوقه)
    if q.get("code") != "0" or not (q.get("data") or []):
        # OKX ما يعرف هذا الأمر → لم يصل أصلاً، آمن نمسح البصمة
        if time.time() - float(inf.get("ts") or 0) > 90:
            e.pop("inflight", None); _acc_save(st_all)
            return False
        return True
    dd = q["data"][0]; stt = dd.get("state")
    if stt in ("live", "partially_filled"):
        return True                      # لسه شغّال → لا تشترِ فوقه
    if stt == "filled":
        got, paid, avg = _acc_fill(dd, sym, "buy")
        paid = round(paid, 4) if got else float(inf.get("amt") or 0)
        e["coin"] = round(float(e.get("coin", 0)) + got, 8)
        e["spent"] = round(float(e.get("spent", 0)) + paid, 4)
        _f = inf.get("fld") or "pending"
        e[_f] = round(max(0.0, float(e.get(_f, 0)) - float(inf.get("amt") or 0)), 6)
        e["buys"] = ([{"ts": time.time(), "qty": round(got, 8), "usd": round(paid, 4),
                       "px": round(avg, 8), "why": "تسوية"}] + list(e.get("buys") or []))[:400]
        e.pop("inflight", None); _acc_save(st_all)
        base = sym.split("-")[0]
        tg_send(f"🛡️ *[تسوية شراء]* `{a.get('name') or sym}`\n"
                f"أمر سابق ضاع رده — تأكّد تنفيذه: `{got:.6f}` {base} بـ `{paid:.2f}$`")
        return False
    # ملغى/فاشل
    e.pop("inflight", None); _acc_save(st_all)
    return False


ACC_WINDOW_H = 3          # 🕐 الشراء التلقائي مسموح فقط خلال أول 3 ساعات بعد منتصف الليل

def acc_in_window():
    """هل نحن داخل نافذة الشراء التلقائي؟"""
    try:
        return datetime.now().hour < int(app_cfg().get("acc_window_h") or ACC_WINDOW_H)
    except Exception:
        return datetime.now().hour < ACC_WINDOW_H


def _acc_move_to_reserve(a, st, why):
    """📦 ينقل «قيد الشراء» كاملاً للمتراكم فوراً — مهما كان المبلغ"""
    e = st.get(a["id"]) or {}
    pool = round(float(e.get("pool", 0)), 6)
    if pool <= 0:
        return False
    e["pending"] = round(float(e.get("pending", 0)) + pool, 6)
    e["pool"] = 0.0
    e["moves"] = ([{"ts": time.time(), "usd": pool, "why": why}] + list(e.get("moves") or []))[:100]
    e["skip"] = f"📦 نُقل {pool:.2f}$ للمتراكم ({why}) — تحت تصرّفك"
    _acc_save(st)
    tg_send(f"📦 *[نُقل للمتراكم]* `{a.get('name') or a.get('symbol')}`\n"
            f"المبلغ: `{pool:.2f}$`\n"
            f"السبب: {why}\n"
            f"🏧 المتراكم الآن: `{float(e.get('pending') or 0):.2f}$` — "
            f"تحت تصرّفك (اشترِ أو اسحب من البطاقة)")
    return True


def accum_tick(force_day=None, allow_buy=None, only=None):
    """⏰ يوزّع ربح الأيام المنتهية، ويشتري فقط إذا سُمح (داخل النافذة).
    خارج النافذة — مثلاً بعد عودة كهرباء/إنترنت متأخرة — يجمّع فقط بلا شراء.
    only (v3.22.7): شراء مُراكِم واحد بس (زر «🔁 أعد محاولة الشراء») — التوزيع يبقى للكل."""
    try:
        accum_coin_handoff()   # 🪙 العملة المحرَّرة أولاً — مباشرة بلا شراء
    except Exception:
        pass
    _acc_migrate()                                         # 👛 v3.22.9: مُراكِم قديم ⇒ محفظته اللي كان يشتري بيها
    all_cfgs = acc_cfgs()                                  # 📥 التوزيع للجميع (حتى الموقوف)
    cfgs = [a for a in all_cfgs if a.get("enabled", True)]  # 🛒 الشراء للمُفعَّل فقط
    if not all_cfgs: return
    st = acc_state()
    _led = load_json(LEDGER) or {}                         # 👛 v3.22.9: ربح كل محفظة لحالها
    _live = _live_wmap()
    today = datetime.now().strftime("%Y-%m-%d")
    yday = force_day or (datetime.now() - timedelta(days=1)).strftime("%Y-%m-%d")

    # 1) التوزيع: كل يوم منتهٍ لم يُوزَّع بعد (حتى 30 يوماً للخلف — يغطي انطفاء اللوحة)
    days = [yday] if force_day else [
        (datetime.now() - timedelta(days=n)).strftime("%Y-%m-%d") for n in range(1, 31)]
    for a in all_cfgs:
        aid = a["id"]
        e = st.setdefault(aid, {"pending": 0.0, "pool": 0.0, "coin": 0.0, "spent": 0.0,
                                "buys": [], "days": {}})
        # ═══ توزيع أرباح الأيام الجديدة ← قيد الشراء (لا المتراكم) ═══
        _start = a.get("start") or ""
        # يوم بلا ربح لا يُقفل نهائياً — نعيد فحصه أسبوعاً تحسّباً لتأخّر السجل بالتسجيل
        _stale = (datetime.now() - timedelta(days=8)).strftime("%Y-%m-%d")
        for dkey in days:
            if _start and dkey < _start:
                continue
            _rec = (e.get("days") or {}).get(dkey)
            if _rec is not None and dkey < _stale:
                continue                                  # قديم ومحسوم
            _aw = acc_wid(a)
            prof = day_profit_w(dkey, _aw, _led, _live) if _aw else day_profit(dkey)   # 👛 ربح بوتات محفظته بس
            if prof <= 0:
                if _rec is None:
                    e.setdefault("days", {})[dkey] = 0.0
                continue
            # 📒 v3.22.6: لو ربح يوم منتهي زاد بعدين (ربح فترة انطفاء انقيّد على يومه) ⇒ يوصل الفرق بس — بنفس النسبة اللي انحسب بيها
            #    (تغيير النسبة اليوم ما يرجع يوزّع الأيام الفايتة)
            dp = e.setdefault("dpct", {})
            if dkey not in dp and _rec is not None and float(_rec) > 0:
                dp[dkey] = round(float(_rec) / prof * 100.0, 6)   # يوم انوزّع قبل v3.22.6 ⇒ نسبته وقتها (ولا مفاجأة)
            pc = float(dp.get(dkey, a.get("pct", 0)) or 0)
            target = round(prof * pc / 100.0, 6)
            prev = float(_rec or 0)
            if _rec is not None and target <= prev + 1e-6:
                continue
            add = round(target - prev, 6)
            e.setdefault("days", {})[dkey] = target
            dp[dkey] = pc
            e["pool"] = round(float(e.get("pool", 0)) + add, 6)
            e["last_alloc"] = dkey
            journal("accum", f"📥 {a.get('name') or aid}: نصيب {dkey} {add:+.6f}$ ({pc:g}% من ربح محفظته {prof:.4f}$){' — فرق ربح انقيّد متأخر' if prev > 0 else ''}",
                    "ok", bot=aid, sym=a.get("symbol", ""), day=dkey, share=target, added=add, pct=pc, day_profit=prof, pool=e["pool"], wallet=_aw)
    _acc_save(st)

    # ═══ 2) التقييم — فلتران متتاليان ═══
    #   الفلتر الأول: الحد الأدنى — بوابة تُغلق كل شيء دونها (يتجمّع ولا شيء آخر)
    #   الفلتر الثاني: يعمل فقط لمن عبر الأول — النطاق وحالة الشراء
    if allow_buy is None:
        allow_buy = acc_in_window()

    _passed = []
    for a in all_cfgs:
        aid = a["id"]; e = st.get(aid) or {}
        pool = round(float(e.get("pool", 0)), 6)
        if pool <= 0:
            e.pop("buy_err", None)        # 🔑 v3.22.7: ماكو شي ينتظر ⇒ ماكو «فشل» يتعلّق بالبطاقة
            continue
        minb = max(1.0, float(a.get("min_buy", 5) or 0))
        # ── 🚪 الفلتر الأول: الحد الأدنى ──
        if pool < minb:
            e["skip"] = (f"⏳ {pool:.2f}$ قيد الشراء — ينتظر بلوغ الحد الأدنى "
                         f"({minb:.0f}$) · لا ينتقل للمتراكم")
            _acc_save(st)
            continue                      # لا نطاق · لا إيقاف · لا شيء — ينتظر فقط
        # ── 🎚️ الفلتر الثاني: النطاق وحالة الشراء ──
        if not a.get("enabled", True):
            _safe(_acc_move_to_reserve, a, st, "إيقاف الشراء")
            continue
        lo = float(a.get("low_price", 0) or 0); hi = float(a.get("high_price", 0) or 0)
        if lo > 0 or hi > 0:
            px0 = _acc_price(a.get("symbol", ""))
            if px0 <= 0:
                e["skip"] = "⚠️ تعذّر جلب السعر — يحاول لاحقاً"
                _acc_save(st); continue
            if (lo > 0 and px0 < lo) or (hi > 0 and px0 > hi):
                _safe(_acc_move_to_reserve, a, st, f"السعر {px0} خارج النطاق")
                continue
        _passed.append(a)                 # عبر الفلترين — مرشّح للشراء

    # 🕐 خارج نافذة الشراء → يبقى قيد الشراء ويحاول لاحقاً (سبب مؤقت)
    if not allow_buy:
        for a in _passed:
            e = st.get(a["id"]) or {}
            e["skip"] = ("🕐 خارج نافذة الشراء (كهرباء/إنترنت/إيقاف البرنامج؟) — "
                         "الرصيد باقٍ قيد الشراء ويحاول لاحقاً")
        _acc_save(st)
        return

    # ✅ التنفيذ
    for a in _passed:
        aid = a["id"]; e = st.get(aid) or {}
        if only and aid != only:
            continue
        # 🛡️ سوِّ أي أمر سابق ضاع رده قبل التفكير بشراء جديد
        _safe(acc_settle_sell, a, st, default=None)
        if _safe(_acc_settle, a, st, default=True):
            e = st.get(aid) or {}
            e["skip"] = "⏳ يتحقق من أمر سابق قبل الشراء"; _acc_save(st)
            continue
        e = st.get(aid) or {}
        pend = float(e.get("pool", 0))            # عبر الفلترين — الشراء من قيد الشراء
        sym = a.get("symbol", "")
        px = _acc_price(sym)
        if px <= 0:
            e["skip"] = "تعذّر جلب السعر"; _acc_save(st); continue
        # النطاق عولج بالمرحلة 2ب — ما وصل هنا إلا وهو داخله
        # 🔒 شراء تلقائي واحد فقط باليوم — تكرار الدورة لا يستهلك المتراكم دفعات
        _tday = datetime.now().strftime("%Y-%m-%d")
        if e.get("last_buy_day") == _tday:
            e["skip"] = "✅ اشترى اليوم — الباقي يتجمّع للغد (الزر متاح يدوياً)"
            _acc_save(st); continue
        cap = float(a.get("max_buy", 0) or 0)
        amt = min(pend, cap) if cap > 0 else pend
        ok, msg = acc_buy_now(a, st, amt, px)
        journal("accum", f"🛒 {a.get('name') or aid}: شراء آلي {amt:.2f}$ بسعر {px} — {msg}", "ok" if ok else "err", bot=aid, sym=sym, amount=amt, price=px)
        if ok:
            _e = st.get(aid) or {}
            _e["last_buy_day"] = _tday
            _acc_save(st)
        e = st.get(aid) or {}
        e["skip"] = "" if ok else msg
        e["last_try"] = time.time()
        # 🔑 v3.22.7: فشل الشراء (رفض/مفتاح/اتصال) ⇒ علامة بالبطاقة (زر 🔁) + تيليغرام مرة باليوم لكل مُراكِم
        #    «⏳ أُرسل الأمر» مو فشل — التسوية تكمله
        if ok:
            e.pop("buy_err", None)
        elif not str(msg).startswith("⏳"):
            e["buy_err"] = {"ts": time.time(), "msg": str(msg)[:500], "amt": round(float(amt), 2)}
            if e.get("err_tg_day") != _tday:
                e["err_tg_day"] = _tday
                _wh = int(app_cfg().get("acc_window_h") or ACC_WINDOW_H)
                tg_send(f"⚠️ *[المُراكِم ما اشترى]* `{_tp_md(a.get('name') or sym)}`\n"
                        f"المبلغ: `{float(amt):.2f}$` — باقي «قيد الشراء» ما انصرف ولا سنت\n"
                        f"السبب: {_tp_md(msg)}\n"
                        f"🔁 يعيد المحاولة كل نص ساعة داخل نافذة الشراء (أول {_wh} ساعات بعد نص الليل) · "
                        f"بعد ما تصلّح السبب اضغط «🔁 أعد محاولة الشراء» بالبطاقة")
        _acc_save(st)

_ACC_RUN = {"retry": 0.0}

def _ri_handoffs_of(bst):
    """🪙 كل تسليمات بوت: الطابور الجديد + الخانة القديمة — بلا تكرار بالمعرّف."""
    ri = bst.get("reinvest") if isinstance(bst.get("reinvest"), dict) else {}
    out, ids = [], set()
    for h in list(ri.get("handoffs") or []) + ([ri["handoff"]] if isinstance(ri.get("handoff"), dict) else []):
        if isinstance(h, dict) and h.get("id") and h["id"] not in ids:
            ids.add(h["id"])
            out.append(h)
    return out


def _ri_pending_handoffs(bst, grace=0.0):
    """🪙 تسليمات عملة **فعلاً ما وصلت**: مو مسجّلة بدفتر المُراكِم (`_ri_seen`) — ومضى عليها ≥ grace ثانية.
    البوت يبقي سجل التسليم بحالته للتوثيق؛ اللي انسلّم ينعلّم بدفتر المُراكِم ⇒ الفحص يرجع للدفتر، مو لحالة البوت
    (كان يعدّ أي تسليم صار بالماضي ⇒ «🔴 حوالة معلّقة» كاذبة للأبد)."""
    seen = set(str(x) for x in ((_safe(acc_state, default={}) or {}).get("_ri_seen") or []))
    now = time.time()
    return [h for h in _ri_handoffs_of(bst) if str(h.get("id")) not in seen and now - float(h.get("ts") or now) >= grace]


def _dca_handoffs_of(b, bst):
    """🪙 v3.22.1 (ح٧): ربح DCA البيعي (عملة صافية بعد العمولة) لكل دورة = «ربح محرَّر عملة» ⇒ نفس طريق عملة الجرد:
    للمُراكِم بنسبة العملة إذا مفتوح على نفس العملة والمحفظة، والباقي/بلا مُراكِم ⇒ المحفظة. المعرّف من سجل الدورات (ما ينعاد)."""
    if (b.get("cfg") or {}).get("bot_type") != "dca":
        return []
    out = []
    for c in (bst.get("cycles_log") or []):
        try:
            p, px = float(c.get("profit") or 0), float(c.get("px") or 0)
        except Exception:
            continue
        if c.get("id") and p > 0 and px > 0:
            out.append({"id": "dca:" + str(c["id"]), "coin": p, "avg_px": px, "symbol": b["symbol"],
                        "why": f"ربح DCA — دورة #{c.get('n')}", "ts": float(c.get("ts") or 0)})
    return out


# ═══════════ 🔁 v3.25.0: البوت الدوري (الشراء والبيع المتكرر) ═══════════
#   🟢 شرائي: يشتري بمبلغ دولار ثابت كل فترة ⇒ يبيع بالهدف ⇒ الربح دولار · 🔴 بيعي: يبيع عملات ⇒ يرجع يشتري أكثر ⇒ الربح عملة
#   الحسابات (مراقبة بس — المحرك هو اللي يتداول):
#     الدفتر اليومي (المحرر بالدولار) = الجزء المحرر من ربح كل صفقة شرائي (الخسارة تنقص) + دولار «سحب المعاد استثماره» (الاثنين)
#     ربح التداول = المحرر n + المعاد استثماره r لكل صفقة (السحب تحويل — مو ربح جديد)
#     العملة المحرّرة = الجزء المحرر من ربح كل صفقة بيعي + عملة السحب ⇒ دفتر العملات + المُراكِم (نفس طريق DCA البيعي)
_REC_T = ("rec_buy", "rec_sell")
_NONGRID = ("dca", "dca_buy") + _REC_T      # بوتات بلا سلّم شبكة (ولا غلاف إعادة استثمار الشبكة ولا تدقيق سلّم)
REC_FEE = 0.001                              # نفس المحرك: عمولة الآخذ (أوامره كلها فورية)
REC_TG_FILE = os.path.join(ROOT, "Holy_RecNotify.json")
_REC_TG = {"d": None}
_REC_TG_LOCK = threading.Lock()


def _is_rec(b):
    return str(((b or {}).get("cfg") or {}).get("bot_type") or "") in _REC_T


def _rec_ri_pct(cfg, st):
    """⚖️ نسبة إعادة الاستثمار الفعلية: من الكرت (الحالة) وإلا من الإنشاء · بالمعدل ماكو إعادة استثمار"""
    if str((cfg or {}).get("mode") or "lots") == "avg":
        return 0.0
    v = (st or {}).get("ri_pct")
    if v is None:
        v = (cfg or {}).get("ri_pct") or 0
    try:
        return min(100.0, max(0.0, float(v)))
    except Exception:
        return 0.0


def _rec_held(st):
    """💠 الربح المعاد استثماره اللي لسه داخل البوت: الحصّالة + حصته بالأوامر المفتوحة (الشرائي دولار · البيعي عملة)"""
    try:
        return max(0.0, float((st or {}).get("pot") or 0) + sum(float(l.get("ri") or 0) for l in ((st or {}).get("lots") or []) if isinstance(l, dict)))
    except Exception:
        return 0.0


def _rec_rs(b, st=None, usd=False):
    """💠 لقطة إعادة استثمار الدوري (نفس شكل `_ri_state_of`): usd=True ⇒ الشرائي بس (الرقم دولار)"""
    sell = (b.get("cfg") or {}).get("bot_type") == "rec_sell"
    if usd and sell:
        return None
    if st is None:
        st = _safe(load_json, paths_of(b)[0], default={}) or {}
    pct = _rec_ri_pct(b.get("cfg") or {}, st)
    held = _rec_held(st)
    used = pct > 0 or held > 1e-12 or float(st.get("ri_total") or 0) > 0
    return {"on": pct > 0, "held": held, "handoff": 0.0, "pct": pct, "levels": 0, "used": used,
            "c": (str(b["symbol"]).split("-")[0] if sell else "")}


def _rec_handoffs_of(b, bst):
    """🪙 العملة المحرَّرة من الدوري ⇒ نفس طريق عملة DCA البيعي (للمُراكِم بنسبة العملة إذا مفتوح على نفس العملة والمحفظة · الباقي للمحفظة):
    البيعي: الجزء المحرر من ربح كل صفقة · الاثنين: عملة «سحب المعاد استثماره» (الشرائي: حصة الربح اللي صار عملة بكلفته ·
    البيعي: الحصّالة بسعر السوق لحظة السحب). موجب بس — الخسارة ما تنسحب من المُراكِم. المعرّف من سجل البوت (ما ينعاد)."""
    if not _is_rec(b):
        return []
    out = []
    if b["cfg"].get("bot_type") == "rec_sell":
        for c in (bst.get("cycles_log") or []):
            try:
                q, px = float(c.get("rel") or 0), float(c.get("px") or 0)
            except Exception:
                continue
            if c.get("id") and q > 0 and px > 0:
                out.append({"id": "rec:" + str(c["id"]), "coin": q, "avg_px": px, "symbol": b["symbol"],
                            "why": f"ربح الدوري البيعي — صفقة #{c.get('n')}", "ts": float(c.get("ts") or 0)})
    for r in (bst.get("releases") or []):
        try:
            q, px = float(r.get("coin") or 0), float(r.get("px") or 0)
        except Exception:
            continue
        if r.get("id") and q > 0 and px > 0:
            out.append({"id": "rec:" + str(r["id"]), "coin": q, "avg_px": px, "symbol": b["symbol"],
                        "why": "سحب ربح الدوري المعاد استثماره", "ts": float(r.get("ts") or 0)})
    return out


def _rec_coin_events(b, st):
    """🪙 أحداث دفتر العملات (مراقبة): كل صفقة بيعي بجزئها المحرر (الخسارة تنقص — مثل DCA البيعي) + عملة كل سحب"""
    out = []
