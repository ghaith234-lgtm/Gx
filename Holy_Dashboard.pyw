function gEsc(s){return String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function gAgo(ts){if(!ts)return'—';const s=Math.max(0,Date.now()/1000-(+ts));
  if(s<90)return'قبل ثوانٍ';if(s<5400)return'قبل '+Math.round(s/60)+' دقيقة';
  if(s<172800)return'قبل '+(s/3600).toFixed(1)+' ساعة';return'قبل '+Math.round(s/86400)+' يوم'}
function gN(x,d){if(x==null||x==='')return'—';x=+x;if(!isFinite(x))return'—';let t=x.toFixed(d==null?8:d);
  if(t.indexOf('.')>=0)t=t.replace(/0+$/,'').replace(/\.$/,'');return t==='-0'?'0':t}
function gS(x,d){if(x==null||x==='')return'—';x=+x;if(!isFinite(x))return'—';return(x>0?'+':'')+gN(x,d)}
