# ═══════════ 🪜 v3.36.15: الشبكي المتدرج — جدول ما قبل النشر + النشر ═══════════
#   المعادلة نفس المحرك بالحرف (main_step.py → step_layout) ⇒ الجدول = المحرك (v3615_test يقارنهم خانة خانة)
#   · مستوى j: القاعدة = البداية × (1+مسافة الشراء)^j · الجزء k يبيع بالقاعدة × (1 + k × مسافة البيع)
#   · الكمية بالعملة: (المبلغ ÷ عدد البيعات) ÷ القاعدة — كل بيعة تعيد شراء كميتها نفسها بالقاعدة ⇒ الربح بالدولار
#   · فوق البداية up مستوى من عملاتك (كأنها اشتُريت بقاعدتها) · تحتها شراءات ثابتة لحد الأرضية
STEP_MIN_PART = 2.0          # 💵 أقل قيمة لكل بيعة (طلب المالك: «خلي اقل اوردر بيع دولارين»)
STEP_MAX_SLOTS = 3000        # حد الخانات (أوامر بالذاكرة) — أكثر ⇒ الجدول يرفض (مسافة شراء أكبر أو أرضية أعلى) · 🪜 v3.36.30: 1500 ⇒ 3000 (t_deep «scale»: ≈4,900 خانة ⇐ دورة ≤ 250 ms)
STEP_MAX_UP = 500            # ⬆️ v3.36.30 (المالك 10-11 «اريد مثلا 500»): مستويات فوق السعر من عملاتك — كانت 200 (المحرك نفسه بلا حد)
STEP_MAX_PARTS = 20
STEP_WINDOW = 8              # 🪟 الأقرب فقط على المنصة لكل جهة (المحرك step_window)
STEP_TAKER_FEE = 0.001       # 🧾 v3.36.18: taker OKX 0.10% — الجدول يحسب ربح كل بيعة بالأسوأ (المالك 6-11) · التنفيذ الحقيقي بعمولته


def _step_round(v, step, up=False):
    from decimal import Decimal, ROUND_FLOOR, ROUND_CEILING
    if not step or step <= 0:
        return float(v)
    st = Decimal(str(step))
    return float((Decimal(repr(float(v))) / st).quantize(Decimal(1), rounding=ROUND_CEILING if up else ROUND_FLOOR) * st)


def _step_layout(P0, G, d, N, Q, floor, up, fee, lot=None, mn=None, max_down=400, d1=None):
    """نسخة حرفية من step_layout بالمحرك (main_step.py) — [{"j","k","bp","sp","q","sq","side"(+"skip")}]"""
    P0, G, d, Q, floor, fee = float(P0), float(G), float(d), float(Q), float(floor or 0), float(fee or 0)
    d1 = d if d1 is None or d1 == "" else float(d1)
    N, up = max(1, int(N)), max(0, int(up or 0))
    lot = lot or 1e-6
    out = []
    if not all(math.isfinite(x) for x in (P0, G, d, d1, Q, floor, fee)) or P0 <= 0 or G <= 0 or d <= 0 or d1 <= 0 or Q <= 0:
        return out                                  # 🔢 nan / inf ⇒ إعداد غير صالح (بلا أي أمر)
    m = 0
    if floor > 0 and floor < P0:
        m = int(math.floor(math.log(P0 / floor) / math.log(1.0 + G) + 1e-9))
    elif floor <= 0:
        m = max_down
    m = min(m, max_down)
    sig = lambda x: float("%.12g" % float(x))

    def fl(q):
        return max(0.0, _step_round(float(q) + 1e-12, lot))
    for j in list(range(-m, 0)) + list(range(0, up)):
        bp = sig(P0 * (1.0 + G) ** j)
        for k in range(1, N + 1):
            sp = sig(bp * (1.0 + k * d)) if d1 == d else sig(bp * (1.0 + d1 + (k - 1) * d))
            q = fl((Q / N) / bp)
            sq = fl(q * (1.0 - fee))
            r = {"j": j, "k": k, "bp": bp, "sp": sp, "q": q, "sq": sq if j >= 0 else 0.0, "side": "sell" if j >= 0 else "buy"}
            if q <= 0 or (mn and (q < mn - 1e-12 or fl(q * (1.0 - fee) * 0.999) < mn - 1e-12)):
                r["skip"] = "min"
            out.append(r)
    return out


def _step_args(data):
    """قراءة نموذج النشر (نسب مئوية ⇒ كسور) · (args, None) أو (None, سبب الرفض)"""
    sym = str(data.get("symbol", "")).strip().upper()
    if not sym or "-" not in sym:
        return None, "اكتب الرمز كاملاً مثل XRP-USDT"
    try:
        Q = float(data.get("usd_value") or 0)
        N = int(float(data.get("step_parts") or 0))
        d = float(data.get("step_sell_pct") or 0) / 100.0
        _v1 = data.get("step_first_pct")                      # 📈 مسافة أول بيعة — فارغ = مسافة البيع نفسها
        d1 = d if _v1 is None or str(_v1).strip() == "" else float(_v1) / 100.0
        G = float(data.get("grid_pct") or 0) / 100.0
        floor = float(data.get("min_price") or 0)
        up = int(float(data.get("up_groups") or 0))
        p0 = float(data.get("forced_base") or 0)
    except Exception:
        return None, "تأكد من الأرقام (المبلغ · عدد البيعات · المسافات · الأرضية)"
    if not all(math.isfinite(x) for x in (Q, d, d1, G, floor, p0)):       # 🔢 «nan» / «inf» يمرّ من كل مقارنة ⇒ يُرفض هنا
        return None, "تأكد من الأرقام (المبلغ · عدد البيعات · المسافات · الأرضية)"
    if Q <= 0 or G <= 0 or d <= 0 or d1 <= 0:
        return None, "المبلغ ومسافة أول بيعة والمسافة بين البيعات ومسافة الشراء يجب أن تكون أكبر من صفر"
    if not (1 <= N <= STEP_MAX_PARTS):
        return None, f"عدد البيعات لكل شراء من 1 إلى {STEP_MAX_PARTS}"
    if up < 0 or up > STEP_MAX_UP:
        return None, f"مستويات عملاتك فوق السعر من 0 إلى {STEP_MAX_UP}"
    if floor < 0 or p0 < 0:
        return None, "الأرضية وسعر البداية لا يكونان سالبين"
    return {"sym": sym, "base": sym.split("-")[0], "Q": Q, "N": N, "d": d, "d1": d1, "G": G, "floor": floor, "up": up, "p0": p0}, None


def _step_taken(sym):
    """🪜 v3.36.18 (المالك 6-11: «واحد لكل عملة»): مجلد شبكي متدرج موجود على هالعملة (أي محفظة) · None = لا"""
    for b in bot_dirs().values():
        try:
            if str((b.get("cfg") or {}).get("bot_type") or "") == "grid_step" and str(b.get("symbol") or "").upper() == str(sym).upper():
                return os.path.basename(str(b["dir"]).rstrip("/\\"))
        except Exception:
            continue
    return None


def step_plan(data, px=None, live=False):
    """📋 جدول ما قبل النشر (حساب فقط · بلا مفاتيح ولا كتابة) — كل مستوى: قاعدته · بيعاته وربح كل بيعة صافياً بعد العمولتين ·
    المبلغ (تحت) أو العملات (فوق) · المجموع: أوامر · دولار حتى الأرضية · عملات فوق · خسارة على الورق عند الأرضية · الرفض والتنبيهات"""
    a, err = _step_args(data)
    if err:
        return {"ok": False, "msg": err}
    P0 = a["p0"] or float(px or 0) or float(PX.get(a["sym"]) or 0) or float(_acc_price(a["sym"]) or 0)
    if P0 <= 0:
        return {"ok": False, "msg": "سعر العملة غير معروف الآن — أعد المحاولة"}
    sp_ = _acc_spec(a["sym"]) or {}
    lot, mn = float(sp_.get("lotSz") or 0) or None, float(sp_.get("minSz") or 0) or None
    f = FEE_RATE_DEFAULT
    t = max(f, STEP_TAKER_FEE)                  # 🧾 v3.36.18: ربح البيعة والرفض بعمولة taker للطرفين (الأسوأ)
    errs, warns = [], []
    if a["floor"] <= 0:
        errs.append("حدّد سعر الأرضية (لا شراء تحته) — بلا أرضية الشراء لا ينتهي")
    elif a["floor"] >= P0:
        errs.append(f"الأرضية ({a['floor']:g}) يجب أن تكون تحت سعر البداية ({P0:.8g})")
    part = a["Q"] / a["N"]
    if part < STEP_MIN_PART - 1e-9:
        errs.append(f"أقل بيعة {STEP_MIN_PART:g}$: المبلغ ÷ عدد البيعات = {part:.4g}$ — زِد المبلغ أو قلّل البيعات")
    lay = _step_layout(P0, a["G"], a["d"], a["N"], a["Q"], a["floor"] if a["floor"] > 0 else P0 * 0.5, a["up"], f, lot, mn, d1=a["d1"])
    if len(lay) > STEP_MAX_SLOTS:
        errs.append(f"{len(lay)} خانة أكثر من الحد ({STEP_MAX_SLOTS}) — كبّر مسافة الشراء أو ارفع الأرضية")
    skip = [r for r in lay if r.get("skip")]
    if skip:
        errs.append(f"{len(skip)} بيعة كميتها أصغر من حد المنصة الأدنى ({mn:g} {a['base']}) — زِد المبلغ")
    rows, by = [], {}
    for r in lay:
        by.setdefault(r["j"], []).append(r)
    p1 = None
    gap = None      # (the coins a first sell leaves behind × its price, the row) — a coarse quantity step on OKX
    usd = coins = paper = 0.0
    lo_floor = a["floor"] if 0 < a["floor"] < P0 else None
    for j in sorted(by, reverse=True):
        parts = sorted(by[j], key=lambda r: r["k"])
        bp = parts[0]["bp"]
        sells = []
        for r in parts:
            qn = r["sq"] if r["side"] == "sell" else max(0.0, _step_round(r["q"] * (1 - f) + 1e-12, lot or 1e-6))
            cq = r["q"] * (1 - f)      # what a buy of q leaves after its fee (taken in the coin) — the part under OKX's step is not lost:
            pr = r["q"] * (1 - t) * r["sp"] * (1 - t) - r["q"] * r["bp"]   # the engine carries it (fee_dust) into the next sells ⇒ the profit of a sell on average
            sells.append({"k": r["k"], "sp": r["sp"], "q": r["q"], "qn": round(qn, 10), "pr": round(pr, 6), "skip": bool(r.get("skip"))})
            if r["k"] == 1 and (p1 is None or pr < p1):
                p1 = pr
            if not r.get("skip") and (gap is None or (cq - qn) * r["sp"] > gap[0]):
                gap = ((cq - qn) * r["sp"], qn, cq, qn * (r["sp"] * (1 - t) - r["bp"] / (1 - t)))
            if lo_floor and not r.get("skip"):
                paper += (qn if r["side"] == "sell" else cq) * lo_floor - r["q"] * r["bp"]
        row = {"j": j, "bp": bp, "side": "inv" if j >= 0 else "buy", "sells": sells}
        if j >= 0:
            row["coins"] = round(sum(s["qn"] for s in sells if not s["skip"]), 10)
            coins += row["coins"]
        else:
            row["usd"] = round(sum(s["q"] * bp for s in sells if not s["skip"]), 6)
            usd += row["usd"]
        rows.append(row)
    if (p1 is not None and p1 <= 0) or any(not r.get("skip") and r["sp"] * (1.0 - t) * (1.0 - t) <= r["bp"] for r in lay):
        errs.append(f"مسافة أول بيعة {a['d1'] * 100:g}% لا تغطي العمولتين ({2 * t * 100:.2f}% بعمولة taker — الأسوأ) — البيعة الأولى "   # 💰 = شرط المحرك
                    "قد تخسر · كبّر مسافة أول بيعة")
    _tk = _step_taken(a["sym"]) if live else None
    if _tk:
        errs.insert(0, f"يوجد شبكي متدرج على {a['sym']} ({_tk}) — واحد لكل عملة · احذفه أولاً")
    span = a["d1"] + (a["N"] - 1) * a["d"]          # من الشراء إلى آخر بيعة
    if a["G"] < span - 1e-12:
        warns.append(f"النسب تتداخل: بيعات كل مستوى تمتد ({span * 100:g}%) فوق مسافة الشراء ({a['G'] * 100:g}%) — مسموح، "
                     "وكل أمر يبقى منفصلاً لخانته (لا اندماج حتى بنفس السعر)")
    if gap and gap[0] >= 0.01:
        warns.append(f"خطوة الكمية في المنصة {lot:g} {a['base']}: البيعة ترسل {gap[1]:g} بدل {gap[2]:.6g} لأن عمولة الشراء تُخصم من العملة — "
                     f"الفارق يتجمّع في ذاكرة البوت ويُباع مع البيعات التالية، لذلك الربح المعروض هو متوسط البيعة: بعضها يُسجَّل بأقل منه "
                     f"(حتى {gap[3]:+.4f}$) وبعضها بأكثر")
    if a["up"] == 0:
        warns.append("لا مستويات من عملاتك فوق السعر — البوت يبدأ بشراءات تحت السعر فقط")
    nb = sum(1 for r in rows if r["side"] == "buy")
    ni = len(rows) - nb
    tot = {"nb": nb, "ni": ni, "orders": sum(1 for r in lay if not r.get("skip")), "window": STEP_WINDOW,
           "usd": round(usd, 4), "coins": round(coins, 10), "paper": round(paper, 4) if lo_floor else None,
           "lo": min((r["bp"] for r in rows if r["side"] == "buy"), default=None), "p1": round(p1 or 0, 6), "minpart": round(part, 6)}
    return {"ok": True, "sym": a["sym"], "base": a["base"], "P0": P0, "fee": f, "taker": t, "lot": lot, "mn": mn, "rows": rows, "tot": tot,
            "err": errs, "warn": warns, "args": {k: a[k] for k in ("Q", "N", "d", "d1", "G", "floor", "up")}}


def deploy_step(data):
    """🪜 نشر الشبكي المتدرج: نفس الجدول (يرفض بنفس الأسباب) · سعر البداية يُثبَّت بالإعداد (الجدول = المحرك) ·
    عملاتك الحرة (رصيد OKX الحر − ما تحتاجه بوتاتك الأخرى بنفس المحفظة والعملة) تكفي مستويات فوق السعر ⇐ وإلا يرفض"""
    a, err = _step_args(data)
    if err:
        return {"ok": False, "msg": err}
    keys = wallet_keys(data.get("wallet", "")) or {
        "api_key": str(data.get("api_key", "")).strip(), "secret_key": str(data.get("secret_key", "")).strip(),
        "passphrase": str(data.get("passphrase", "")).strip()}
    if not keys["api_key"]:
        return {"ok": False, "msg": "اختر محفظة أو أدخل مفاتيح API"}
    px = 0.0
    if not a["p0"]:
        try:
            px = float(_acc_price(a["sym"]) or 0)
        except Exception:
            px = 0.0
    P = step_plan(data, px=px)
    if not P.get("ok"):
        return P
    if P["err"]:
        return {"ok": False, "msg": "⛔ " + P["err"][0]}
    _tk = _step_taken(a["sym"])                     # 🪜 v3.36.18: واحد لكل عملة
    if _tk:
        return {"ok": False, "msg": f"⛔ يوجد شبكي متدرج على {a['sym']} ({_tk}) — واحد لكل عملة · احذفه أولاً"}
    need = float(P["tot"]["coins"] or 0)
    if need > 0:
        r = _okx_get(f"/api/v5/account/balance?ccy={a['base']}", keys["api_key"], keys["secret_key"], keys["passphrase"])
        if not r or str(r.get("code")) != "0" or not isinstance(r.get("data"), list) or not r["data"]:
            return {"ok": False, "msg": "تعذّر قراءة رصيد المحفظة من OKX — أعد المحاولة"}
        av = 0.0
        for dd in (r["data"][0].get("details") or []):
            if str(dd.get("ccy")) == a["base"]:
                av = max(0.0, float(dd.get("availBal") or 0))
        claims = 0.0
        for b in bot_dirs().values():
            try:
                if str((b.get("cfg") or {}).get("api_key") or "").strip() != keys["api_key"] or b["symbol"].split("-")[0] != a["base"]:
                    continue
                claims += float((_gd_free_claims(b, load_json(paths_of(b)[0]) or {}) or {}).get(a["base"]) or 0)
            except Exception:
                continue
        free = max(0.0, av - claims)
        if free + 1e-12 < need:
            return {"ok": False, "msg": f"⛔ مستويات عملاتك فوق السعر تحتاج {need:.8g} {a['base']} — الحر بمحفظتك {free:.8g} "
                                        f"(بعد ما تحتاجه بوتاتك الأخرى {claims:.8g}) · قلّل المستويات أو اجعلها 0"}
    _ri = None                                    # 💠 v3.36.18: إعادة الاستثمار من أول بيعة (نموذج النشر — والاختبار التجريبي يقرأها منه)
    if data.get("reinvest"):
        try:
            _ri = float(data.get("reinvest_pct") if data.get("reinvest_pct") not in (None, "") else 100)
        except Exception:
            _ri = -1.0
        if not (0 <= _ri <= 100):
            return {"ok": False, "msg": "نسبة إعادة الاستثمار يجب أن تكون من 0 إلى 100%"}
    folder = _new_bot_folder("step_" + a["base"].lower())        # 🆔 v3.36.20: كود عشوائي لكل بوت
    full = os.path.join(ROOT, folder)
    os.makedirs(full, exist_ok=True)
    cfg = {**keys, "symbol": a["sym"], "bot_type": "grid_step", "usd_value": a["Q"], "step_parts": a["N"], "step_sell": a["d"],
           "step_first": a["d1"],
           "grid_percentage": a["G"], "min_price": a["floor"], "up_groups": a["up"], "forced_base_price": float(P["P0"]),
           "fee_rate": P["fee"], "taker_rate": P["taker"], "step_window": STEP_WINDOW, "knife_guard": False, "is_demo": False,
           "auto_restart": bool(data.get("auto", True))}
    if _ri is not None:
        cfg["reinvest"], cfg["reinvest_pct"] = True, _ri          # 🪜 المحرك يعيد الاستثمار من أول بيعة (بلا غلاف)
    save_json_atomic(os.path.join(full, f"config_{a['sym']}.json"), cfg)
    eng_src, eng_script, _ = engine_for(cfg)
    with open(os.path.join(full, eng_script), "w", encoding="utf-8") as fh:
        fh.write(eng_src)
    _drop_reinvest(full)
    b = {"dir": full, "cfg_path": os.path.join(full, f"config_{a['sym']}.json"), "cfg": cfg, "symbol": a["sym"]}
    ok, msg = launch(b)
    if ok:
        tg_send(f"🪜 *تم نشر شبكي متدرج*\nالعملة: `{a['sym']}`\nالبداية: `{float(P['P0']):.8g}`\n"
                f"`{a['N']}` بيعات لكل شراء · أول بيعة `{a['d1'] * 100:g}%` · بين البيعات `{a['d'] * 100:g}%` · "
                f"الشراء `{a['G'] * 100:g}%` · `{a['Q']:g}$` لكل شراء" + (f"\n💠 إعادة استثمار `{_ri:g}%` من أول بيعة" if _ri is not None else ""))
    return {"ok": ok, "msg": (f"🪜 انتشر الشبكي المتدرج وانطلق — {a['sym']} · البداية {float(P['P0']):.8g}") if ok else msg, "dir": folder}


def step_audit(b, st):
    """🪜 تدقيق الشبكي المتدرج (بدل سلّم الشبكة): كل خانة لها أمر واحد على الأكثر · أوامر البوت لا تتلاقى (شراء تحت بيع) ·
    الأوامر الحية = الخانات اللي أمرها حي"""
    S = st.get("slots") if isinstance(st.get("slots"), dict) else None
    if not S:
        return {"ok": None, "msg": "🪜 لا خانات بعد"}
    lb, ls = st.get("limit_buys") or {}, st.get("limit_sells") or {}
    live = {str((s.get("o") or {}).get("id")) for s in S.values() if (s.get("o") or {}).get("id") and (s.get("o") or {}).get("st") == "live"}
    same = live == set(map(str, lb)) | set(map(str, ls))
    bs = [float(v.get("target_price") or 0) for v in lb.values()]
    ss = [float(v.get("target_price") or 0) for v in ls.values()]
    cross = bool(bs and ss and max(bs) >= min(ss))
    nb = sum(1 for s in S.values() if s.get("side") == "buy")
    ok = same and not cross
    return {"ok": ok, "levels": len(S), "buys": len(bs), "sells": len(ss), "overlap": cross,
            "msg": (f"✅ {len(S)} خانة ({nb} شراء · {len(S) - nb} بيع) · على المنصة {len(bs)} شراء + {len(ss)} بيع"
                    if ok else "⚠️ " + " · ".join(filter(None, ["أوامر البوت تتلاقى (شراء فوق بيع)" if cross else "",
                                                                 "الأوامر الحية لا تطابق الخانات" if not same else ""])))}


STEP_SL_MAX = 400          # 🪜 v3.36.20: فوقها البطاقة تاخذ المستويات المهمة كاملة والباقي مختصر (السلّم الكامل يجيبها كلها عند الطلب)


def _step_keep_levels(st, near=10):
    """🪜 v3.36.20: المستويات اللي تنعرض كاملة بالبطاقة لمن الخانات كثيرة — أي جزء عنده أمر (منشور · بالطريق) أو منفّذ جزئياً ·
    + أقرب `near` مستوى للسعر (الباقي — شراء ينتظر أو عملة ماسكها بالذاكرة — مختصر بعدّاداته · السلّم الكامل يجيبه كله)"""
    keep, lv = set(), {}
    for s in (st.get("slots") or {}).values():
        try:
            j = int(s["j"])
            lv[j] = float(s["bp"])
            if s.get("o") or float(s.get("acc") or 0) > 0:
                keep.add(j)
        except Exception:
            continue
    cp = float(st.get("current_price") or 0)
    if cp > 0:
        keep.update(sorted(lv, key=lambda j: abs(math.log(lv[j] / cp)) if lv[j] > 0 else 1e9)[:near])
    return keep


def _step_near(lst, st, buy, bt, n=40):
    """🪜 v3.36.20: قائمة الشبكة العامة (ذاكرة بيع/شراء) لبوت متدرج كبير — الأقرب `n` بس (أدنى بيع · أعلى شراء · أقرب 14 بالدرج)"""
    if bt != "grid_step" or len(st.get("slots") or {}) <= STEP_SL_MAX or len(lst) <= n:
        return lst
    return sorted(lst, key=lambda x: -float(x.get("p") or 0) if buy else float(x.get("p") or 0))[:n]


def _step_sl_far(st):
    """🪜 v3.36.20: المستويات اللي ما انعرضت كاملة (خانات كثيرة) — [المستوى, سعر الشراء, شراء ينتظر بالذاكرة, بيع ماسك عملة بالذاكرة]
    (ولا واحد منهم عنده أمر بالمنصة) · None = كلها كاملة"""
    S = st.get("slots") or {}
    if len(S) <= STEP_SL_MAX:
        return None
    keep, out = _step_keep_levels(st), {}
    for s in S.values():
        try:
            j = int(s["j"])
            if j not in keep:
                out.setdefault(j, [j, float(s["bp"]), 0, 0])[3 if s.get("side") == "sell" else 2] += 1
        except Exception:
            continue
    return sorted(out.values(), key=lambda e: -e[1])


def _step_slots_view(st, full=False):
    """🪜 v3.36.18: كل خانة للبطاقة (مسطرة السعر بالطول + التفاصيل) — [المستوى, الجزء, 'b'/'s', السعر, الكمية الباقية,
    'L' منشور / 'P' بالطريق / 'M' بالذاكرة, سعر الشراء, سعر البيع, كمية البيع, الكلفة, من عملاتك]
    v3.36.20: خانات كثيرة (> STEP_SL_MAX) ⇒ المستويات المهمة بس (الباقي `_step_sl_far`) · full=True ⇒ كلها (السلّم الكامل)"""
    S = st.get("slots") or {}
    keep = _step_keep_levels(st) if (not full and len(S) > STEP_SL_MAX) else None
    out = []
    for s in S.values():
        try:
            if keep is not None and int(s["j"]) not in keep:
                continue
            o = s.get("o") or {}
            buy = s.get("side") == "buy"
            live = bool(o.get("id")) and o.get("st") == "live"
            state = "L" if live else ("P" if o.get("st") == "send" else "M")
            px = float(o.get("px") or 0) if o and o.get("px") else float(s["bp"] if buy else s["sp"])
            rem = max(0.0, (float(s.get("q") or 0) + float(s.get("g") or 0) if buy else float(s.get("sq") or 0)) - float(s.get("acc") or 0))
            out.append([int(s["j"]), int(s["k"]), "b" if buy else "s", _pv_sig(px), round(rem, 10), state, float(s["bp"]), float(s["sp"]),
                        round(float(s.get("sq") or 0), 10), round(float(s.get("spent") or 0), 10),
                        1 if (not buy and float(s.get("cost") or 0) <= 0 and int(s["j"]) >= 0) else 0])
        except Exception:
            continue
    return out


def _step_merge_lv(lv):
    """البطاقة: شراءات المستوى الواحد (نفس السعر) تظهر سطراً واحداً — الكمية مجموعة · n = عدد أوامرها المنفصلة"""
    out = {}
    for x in lv or []:
        k = (x.get("k"), x.get("p"))
        if k in out:
            out[k]["q"] = round(out[k]["q"] + float(x.get("q") or 0), 6)
            out[k]["n"] = out[k].get("n", 1) + 1
        else:
            out[k] = dict(x, n=1)
    return list(out.values())


def deploy(data):
    sym = str(data.get("symbol", "")).strip().upper()
    if not sym or "-" not in sym:
        return {"ok": False, "msg": "اكتب الرمز كاملاً مثل XRP-USDT"}
    try:
        grid = float(data.get("grid_pct", 0)) / 100.0
        usd = float(data.get("usd_value", 0))
        minp = float(data.get("min_price", 0))
        base = float(data.get("forced_base", 0) or 0)
    except Exception:
        return {"ok": False, "msg": "تأكد من الأرقام (النسبة/القيمة/الأرضية)"}
    if grid <= 0 or usd <= 0:
        return {"ok": False, "msg": "يجب أن تكون النسبة وقيمة الأمر أكبر من صفر"}
    is_demo = bool(data.get("demo"))
    _ri = None                                    # 💠 v3.36.7: إعادة الاستثمار من أول دورة (من نموذج النشر — والاختبار التجريبي يقرأها من النشر نفسه)
    if data.get("reinvest") and not is_demo:
        try:
            _ri = float(data.get("reinvest_pct") if data.get("reinvest_pct") not in (None, "") else 100)
        except Exception:
            _ri = -1.0
        if not (0 <= _ri <= 100):
            return {"ok": False, "msg": "نسبة إعادة الاستثمار يجب أن تكون من 0 إلى 100%"}
        _ri = round(_ri, 2)
    keys = {"api_key": "", "secret_key": "", "passphrase": ""}
    if not is_demo:
        keys = wallet_keys(data.get("wallet", "")) or {
            "api_key": str(data.get("api_key", "")).strip(),
            "secret_key": str(data.get("secret_key", "")).strip(),
            "passphrase": str(data.get("passphrase", "")).strip()}
        if not keys["api_key"]:
            return {"ok": False, "msg": "اختر محفظة أو أدخل مفاتيح API"}
    folder = _new_bot_folder(("demo_" if is_demo else "") + sym.split("-")[0].lower())   # 🆔 v3.36.20: كود عشوائي لكل بوت
    full = os.path.join(ROOT, folder)
    os.makedirs(full, exist_ok=True)
    try:
        lower_p = float(data.get("lower_price", 0) or 0)
        upper_p = float(data.get("upper_price", 0) or 0)
    except Exception:
        lower_p = upper_p = 0.0
    try:
        buy_off = float(data.get("buy_offset", 0) or 0) / 100.0   # يصل كنسبة مئوية
    except Exception:
        buy_off = 0.0
    if buy_off < 0 or buy_off >= 0.9:
        buy_off = 0.0
    # 🎚️ النوع: **يختاره المستخدم** (g_type) — وإذا ما وصل (طلب قديم) نخمّنه: حدود → نطاق · بُعد شراء → Grid+ · وإلا إنفنتي
    _gsel = str(data.get("g_type") or "").strip()
    if _gsel in ("grid", "grid_range", "grid_plus") and not is_demo:
        if _gsel == "grid_range" and lower_p <= 0 and upper_p <= 0:
            return {"ok": False, "msg": "🎚️ جرد المدى يحتاج حداً أدنى أو أعلى (أو اختر ♾️ لانهائية)"}
        if _gsel == "grid_plus" and buy_off <= 0:
            return {"ok": False, "msg": "➕ جرد بلس يحتاج بُعد شراء أكبر من صفر (أو اختر ♾️ لانهائية)"}
        if _gsel != "grid_range":
            lower_p, upper_p = 0.0, 0.0          # حقول نوع ثاني ما تنحفظ وتلخبط
        if _gsel != "grid_plus":
            buy_off = 0.0
        g_type = _gsel
    elif is_demo:
        g_type = "grid"
    elif lower_p > 0 or upper_p > 0:
        g_type = "grid_range"
    elif buy_off > 0:
        g_type = "grid_plus"
    else:
        g_type = "grid"
    if g_type == "grid_range" and lower_p > 0 and upper_p > 0 and lower_p >= upper_p:
        return {"ok": False, "msg": "يجب أن يكون الحد الأدنى للنطاق أقل من الحد الأعلى"}
    cfg = {**keys, "symbol": sym, "grid_percentage": grid, "usd_value": usd, "min_price": minp,
           "forced_base_price": base, "knife_guard": bool(data.get("guard")), "is_demo": is_demo,
           "bot_type": g_type, "lower_price": lower_p, "upper_price": upper_p,
           "buy_offset": buy_off,
           "auto_restart": bool(data.get("auto", True))}
    if _ri is not None:
        cfg["reinvest"], cfg["reinvest_pct"] = True, _ri          # launch() يشغّل reinvest.py من أول لحظة (نفس قرار زر الكرت)
    save_json_atomic(os.path.join(full, f"config_{sym}.json"), cfg)
    if is_demo:
        srcp = find_script("demo.py")
        if not srcp:
            return {"ok": False, "msg": "وضع DEMO يحتاج ملف demo.py في المجلد الرئيسي"}
        shutil.copy2(srcp, os.path.join(full, "demo.py"))
    else:
        eng_src, eng_script, _ = engine_for(cfg)
        with open(os.path.join(full, eng_script), "w", encoding="utf-8") as f:
            f.write(eng_src)  # 🧬 المحرك المدمج الصحيح حسب النوع
    _drop_reinvest(full)
