def _ri_orphans(b, st=None):
    """🧹 أوامر مكبّرة **يتيمة** (بلا بند تفكيك) وإعادة الاستثمار مطفية — من نسخة قديمة مسحت البنود
    وسجّلت نموّها ربحاً محرراً مقدماً. الأساس = أكبر حجم يحسبه المحرك لأمر جديد: round(حجم الأمر ÷ السعر, 2).
    ⚠️ لو المالك غيّر حجم الأمر، الأوامر القديمة تبين أكبر — فالتصحيح **بموافقته** مو تلقائي."""
    st = st if st is not None else (_safe(load_json, paths_of(b)[0], default={}) or {})
    ri = st.get("reinvest") if isinstance(st.get("reinvest"), dict) else None
    usd = float((b.get("cfg") or {}).get("usd_value") or 0)
    if not ri or ri.get("on") or usd <= 0:
        return []
    upx = [float(e.get("px") or 0) for e in (ri.get("unwind") or {}).values() if isinstance(e, dict)]
    out = []
    for dn in ("limit_buys", "virtual_buys", "accum_buys", "limit_sells", "virtual_sells", "accum_sells"):
        for oid, v in (st.get(dn) or {}).items():
            if not isinstance(v, dict):
                continue
            ref = float((v.get("original_buy_anchor") if "sell" in dn else v.get("target_price")) or 0)
            q = float(v.get("locked_qty") or 0)
            if ref <= 0 or any(abs(ref - x) <= max(1e-9, ref * 1e-7) for x in upx):
                continue
            base = round(usd / ref, 2)
            if q > base + 0.0051:
                out.append({"dn": dn, "oid": str(oid), "ref": ref, "qty": q, "base": base,
                            "excess": round(q - base, 10), "usd": round((q - base) * ref, 6),
                            "live": dn in ("limit_buys", "limit_sells"), "side": "sell" if "sell" in dn else "buy"})
    return out



