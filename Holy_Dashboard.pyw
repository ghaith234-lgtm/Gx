                                   .replace("__BRAND_TILE__", brand_tile_svg("lt", "btile"))).encode("utf-8")
    return _PAGE["login"]


def _page_cache():
    """🗜️ صفحة اللوحة: تنبني وتنضغط مرة وحدة لكل نسخة — والبصمة (ETag) تخلي المتصفح يعيد استعمال نسخته."""
    if _PAGE.get("v") != APP_VERSION:
        raw = brand_fill(HTML_PAGE.replace("__APPVER__", APP_VERSION)).encode("utf-8")       # 🎨 v3.26.0: الهوية
        _PAGE.update(v=APP_VERSION, raw=raw, gz=_gzip.compress(raw, 6),
                     etag='"hd-%s-%s"' % (APP_VERSION, _hl.sha256(raw).hexdigest()[:12]))
    return _PAGE


def _overview_cached(max_age=1.0):
    """⚡ لو أكثر من جهاز/تبويب يطلب الملخص بنفس الثانية ⇒ حساب واحد يخدم الكل (والأفعال تصفّره)."""
    with _OV_LOCK:
        now = time.time()
        if _OV_CACHE["v"] is not None and now - _OV_CACHE["t"] < max_age:
            return _OV_CACHE["v"]
        v = overview()
        _OV_CACHE.update(t=time.time(), v=v)
        return v


class _AuthMixin:
    def _client_ip(self):
        return self.client_address[0] if self.client_address else "?"

    def _cookie_token(self):
        raw = self.headers.get("Cookie") or ""
        for part in raw.split(";"):
            k, _, v = part.strip().partition("=")
            if k == "holy_tok":
                return v
        return ""

    def _authed(self):
        if not auth_enabled():
            return True
        return _session_ok(self._cookie_token(), self._client_ip())

