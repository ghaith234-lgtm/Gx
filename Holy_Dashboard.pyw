#splash{position:fixed;inset:0;z-index:2147483000;display:flex;align-items:center;justify-content:center;pointer-events:none;
  background:radial-gradient(1100px 700px at 28% 18%,var(--spA,#1b0b3f),transparent 62%),radial-gradient(900px 620px at 82% 92%,var(--spB,#062033),transparent 60%),var(--spBg,#070210);
