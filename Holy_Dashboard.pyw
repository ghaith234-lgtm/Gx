def ri_archive_map(start, end):
    """💠 مبلغ إعادة الاستثمار لكل يوم بين تاريخين — الأرشيف أولاً ثم السجل الحي."""
    out = {}
    try:
        arc = load_json(RI_LEDGER) or {}
        for day, v in (arc.get("daily") or {}).items():
            if start <= day <= end and float(v or 0):
                out[day] = round(float(v), 6)
    except Exception:
        pass
    try:                                    # السجل الحي يغطي الأيام اللي ما تأرشفت بعد
        for day, v in (_safe(daily_earn_map, 20, default={}) or {}).items():
            if start <= day <= end and float(v.get("ri") or 0):
                out[day] = round(float(v["ri"]), 6)
    except Exception:
        pass
    return out


def _today_parts():
    """📅 ربح اليوم مفصّلاً من سجل الصفقات."""
    m = _safe(daily_earn_map, 2, default={}) or {}
    v = m.get(datetime.now().strftime("%Y-%m-%d")) or {"norm": 0.0, "ri": 0.0}
    return {"norm": round(float(v.get("norm") or 0), 4),
            "ri": round(float(v.get("ri") or 0), 4)}


def ri_daily_map(start, end):
    """💠 نمو إعادة الاستثمار لكل يوم — أرشيف + سجل حي."""
    return _safe(ri_archive_map, start, end, default={}) or {}


def ri_period(kind="daily", ref=None):
    """💠 نمو إعادة الاستثمار خلال فترة التقرير — من سجل الصفقات."""
    try:
        now = ref or datetime.now()
        span = {"daily": 1, "weekly": 7, "monthly": 30}.get(kind, 1)
        end = (now - timedelta(days=1)).strftime("%Y-%m-%d")
        start = (now - timedelta(days=span)).strftime("%Y-%m-%d")
        m = _safe(ri_archive_map, start, end, default={}) or {}
        g = sum(m.values())
        on = bool(m) or any((v.get("ri") or 0) > 0
                            for v in (_safe(daily_earn_map, 3, default={}) or {}).values())
        return {"on": on, "usd": round(g, 4)}
    except Exception:
        return {"on": False, "usd": 0.0}


def _ri_at(ent, day):
    """أقرب لقطة عند اليوم أو قبله — يتحمّل أيام مفقودة (انقطاع/إطفاء)."""
    ds = sorted(ent.get("daily") or {})
    prev = None
    for k in ds:
        if k <= day:
            prev = k
        else:
            break
    return (ent["daily"][prev], prev) if prev else (None, None)







