function pcDonut(v){
  const box=$('#pcDonut'),T=v.tot||{};
  const segs=((v.bots)||[]).filter(b=>b.slot>=0&&b.t>1e-9).sort((a,b)=>b.t-a.t).map(b=>({name:b.name,tl:b.tl,t:b.t,col:pcCol(b)}));
  if((T.other||0)>1e-9)segs.push({name:'غيرها ('+T.n_other+')',tl:'',t:T.other,col:PC.other});
  if(!segs.length){box.textContent='';return}
  const S=200,c=S/2,r1=92,r0=66,tot=segs.reduce((a,s)=>a+s.t,0),gap=segs.length>1?2/((r0+r1)/2):0;
  let a=0,svg=`<svg class="pc-dn" viewBox="0 0 ${S} ${S}" role="img" aria-label="حصة كل بوت من ربح التداول">`;
  segs.forEach((s,i)=>{const da=s.t/tot*2*Math.PI;
    if(segs.length===1)svg+=`<circle class="pc-sg" data-i="${i}" tabindex="0" cx="${c}" cy="${c}" r="${(r0+r1)/2}" fill="none" stroke="${s.col}" stroke-width="${r1-r0}"/>`;
    else if(da>gap)svg+=`<path class="pc-sg" data-i="${i}" tabindex="0" d="${pcArc(c,c,r0,r1,a+gap/2,a+da-gap/2)}" fill="${s.col}"/>`;
    a+=da});
  svg+=`<text class="pc-c1" id="pcC1" x="${c}" y="${c+2}" text-anchor="middle"></text><text class="pc-c2" id="pcC2" x="${c}" y="${c+20}" text-anchor="middle"></text></svg>`;
  box.innerHTML=svg;
  const ul=document.createElement('ul');ul.className='pc-dleg';
  segs.forEach((s,i)=>{const li=document.createElement('li');li.dataset.i=i;
    const sw=document.createElement('i');sw.className='pc-sw';sw.style.background=s.col;
    const nm=document.createElement('span');nm.className='pc-nm';nm.textContent=s.name+(s.tl?' · '+s.tl:'');
    const vv=document.createElement('span');vv.className='v';vv.textContent=pcN(s.t)+' $';
    const pp=document.createElement('span');pp.className='p';pp.textContent=(s.t/tot*100).toFixed(1)+'%';
    li.append(sw,nm,vv,pp);ul.appendChild(li)});
  box.appendChild(ul);
  const C1=$('#pcC1'),C2=$('#pcC2');
  const un=()=>{box.querySelectorAll('.pc-sg').forEach(e=>e.classList.remove('dim'));C1.textContent=pcN(tot)+'$';C2.textContent='ربح التداول'};
  const hl=i=>{const s=segs[i];if(!s)return;box.querySelectorAll('.pc-sg').forEach(e=>e.classList.toggle('dim',+e.dataset.i!==i));
    C1.textContent=pcN(s.t)+'$';C2.textContent=s.name+' · '+(s.t/tot*100).toFixed(1)+'%'};
  un();
  box.querySelectorAll('.pc-sg,.pc-dleg li').forEach(e=>{const i=+e.dataset.i;
    e.addEventListener('pointerenter',()=>hl(i));e.addEventListener('focus',()=>hl(i));
    e.addEventListener('pointerleave',un);e.addEventListener('blur',un)})}
