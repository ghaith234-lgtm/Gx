def _gd_errtxt(r):
    if r is None:
        return "تعذّر الاتصال بالمنصة"
    try:
        d = (r.get("data") or [{}])[0] if isinstance(r.get("data"), list) and r.get("data") else {}
        return f"OKX {r.get('code')}: {d.get('sMsg') or r.get('msg') or 'رفض الطلب'}"[:160]
    except Exception:
        return "رد غير مفهوم من المنصة"


def _gd_pages(path, keys, idkey, stop_ms=0, pages=5):
    """📄 صفحات OKX (100 لكل صفحة). يرجع (البنود، مكتملة؟) — و(None, False) لو فشلت الأولى."""
    k, s, p = keys
    out, after = [], ""
    for _i in range(pages):
        q = path + ("&after=" + after if after else "")
        r = _okx_get(q, k, s, p)
        if not r or str(r.get("code")) != "0":
            return (out, False) if out else (None, False)
        data = r.get("data") or []
        out.extend(data)
        if len(data) < 100:
            return out, True
        after = str(data[-1].get(idkey) or "")
        if not after:
            return out, False
        try:
            if stop_ms and min(int(x.get("ts") or x.get("cTime") or 0) for x in data) <= stop_ms:
                return out, True
        except Exception:
            pass
        time.sleep(0.25)
    return out, False


