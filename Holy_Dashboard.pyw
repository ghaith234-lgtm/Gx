let FILTER={q:"",sort:"profit",dir:-1};
function toggleSortDir(){FILTER.dir*=-1;const b=$('#sortdir');b.textContent=FILTER.dir<0?'↓':'↑';b.classList.toggle('up',FILTER.dir>0);applyFilter()}
/* 💾 v3.26.1: الترتيب واتجاهه ينحفظون بهذا الجهاز · البحث يبقى لحد ما تسكّر الصفحة */
(function(){try{const s=JSON.parse(localStorage.getItem('dash_sort')||'null'),sb=$('#sortby'),sd=$('#sortdir'),se=$('#search');
  if(s&&sb&&[...sb.options].some(o=>o.value===s.sort)){FILTER.sort=s.sort;sb.value=s.sort}
  if(s&&(s.dir===1||s.dir===-1)){FILTER.dir=s.dir;if(sd){sd.textContent=FILTER.dir<0?'↓':'↑';sd.classList.toggle('up',FILTER.dir>0)}}
  const q=sessionStorage.getItem('dash_q')||'';if(q&&se){se.value=q;FILTER.q=q.trim().toUpperCase();const x=$('#sclear');if(x)x.style.display=''}}catch(e){}})();
function applyFilter(){
  FILTER.q=($('#search').value||'').trim().toUpperCase();
  FILTER.sort=$('#sortby').value;
  try{localStorage.setItem('dash_sort',JSON.stringify({sort:FILTER.sort,dir:FILTER.dir}));sessionStorage.setItem('dash_q',$('#search').value||'')}catch(e){}
  $('#sclear').style.display=FILTER.q?'':'none';
  if(DATA&&DATA.bots)syncCards(DATA.bots)}
function sortBots(bots){
  let arr=bots.slice();
  const d=FILTER.dir;
  const cmp={
    profit:(a,b)=>(a.profit-b.profit)*d,
    today:(a,b)=>((a.today||0)-(b.today||0))*d,
    name:(a,b)=>a.symbol.localeCompare(b.symbol)*(-d),
    orders:(a,b)=>((a.n_buys+a.n_sells+a.n_vbuys+a.n_vsells)-(b.n_buys+b.n_sells+b.n_vbuys+b.n_vsells))*d,
    alive:(a,b)=>((a.alive?1:0)-(b.alive?1:0))*d,
    default:(a,b)=>0
  }[FILTER.sort]||((a,b)=>0);
  return arr.sort(cmp)}
/* ── 💵 رقم واحد شامل: كم دولار ينقص لتغطية كل درجات الشراء المتبقية ──
   كأن العملات كلها عملة واحدة: نجمع تكلفة كل أوامر الشراء الافتراضية
   لكل بوتات الجرد الشغّالة، ونطرح منها الرصيد المتاح.
   الأوامر الحية مستثناة — فلوسها مجمّدة عند المنصة أصلاً.
   النطاق = المحفظة: بوتات نفس مفاتيح OKX. زبون بحساب واحد يشوف
   نفس الرقم على كل بطاقاته؛ ومن عنده حسابان يشوف رقم كل حساب على بطاقاته. */
let FUND=new Map(),FKEY=new Map();
function walletKey(b){return b.wid!=null?'w'+b.wid:'b'+(+((b.cover||{}).have_usdt)||0).toFixed(2)}
function vbuyCost(b){let v=0;for(const x of (b.ladder&&b.ladder.vbuys)||[])if(x.p>0&&x.q>0)v+=x.p*x.q;return v}
function calcFund(all){
  FUND=new Map();FKEY=new Map();
  const gs=(all||[]).filter(b=>b.bot_type!=='dca'&&b.bot_type!=='dca_buy'&&!b.demo
                              &&b.cover&&b.cover.have_usdt!=null);
  gs.forEach(b=>{
    const k=walletKey(b);FKEY.set(b.dir,k);
    let e=FUND.get(k);
    if(!e){e={need:0,have:0,live:0,idle:0,syms:[]};FUND.set(k,e)}
    e.have=Math.max(e.have,+b.cover.have_usdt||0);   // نفس الحساب = نفس الرصيد
    if(b.alive){e.need+=vbuyCost(b);e.live++;e.syms.push(b.symbol.split('-')[0])}
    else e.idle++});
  FUND.forEach(e=>{e.gap=e.need-e.have});
}
/* 🃏 v3.26.8: مربّعات الكرت: قيمة طويلة (أكثر من 15 حرف) ⇒ المربّع ياخذ عرض الكرت كله */
function rowsFit(){document.querySelectorAll('#grid .card .rows .row').forEach(r=>{const b=r.querySelector('b'),w=!!b&&b.textContent.trim().length>15;if(r.classList.contains('wide')!==w)r.classList.toggle('wide',w)});
  // 🃏 v3.26.9: خانات DCA/الدوري — الأيقونة تطلع بدائرتها (من بداية الاسم · أو حسب معناه)
  document.querySelectorAll('#grid .card .dcacell').forEach(c=>{if(c._ic)return;c._ic=1;const d=c.querySelector('.dl');if(!d||c.querySelector('.ic'))return;
    const m=d.textContent.match(/^\s*(\p{Extended_Pictographic}\uFE0F?)\s*/u),ic=document.createElement('span');ic.className='ic';
    ic.textContent=m?m[1]:icFor(d.textContent);if(m)d.textContent=d.textContent.slice(m[0].length);c.insertBefore(ic,d)});
  // المربع الوحيد بآخر الصف ياخذ السطر كله (ما يبقى فراغ)
  document.querySelectorAll('#grid .card .rows,#grid .card .dcatop').forEach(box=>{
    const k=[...box.children].filter(e=>(e.classList.contains('row')||e.classList.contains('dcacell'))&&e.style.display!=='none'),sm=k.filter(e=>!e.classList.contains('wide'));
    k.forEach(e=>{const o=sm.length%2===1&&e===sm[sm.length-1];if(e.classList.contains('odd')!==o)e.classList.toggle('odd',o)})})}
function icFor(t){for(const [r,i] of [[/متوسط/,'📊'],[/السعر/,'💲'],[/المسافة|الهدف/,'🎯'],[/ربح/,'💎'],[/التشغيل/,'⏱️'],[/اليوم|يومي/,'📅'],[/شهري/,'🗓️'],[/سنوي/,'📆'],[/المفتوح/,'📦'],[/الجاي|التالي/,'⏰']])if(r.test(t))return i;return '•'}
function syncCards(allBots){
  calcFund(allBots);
  RI_ON=(allBots||[]).filter(x=>x.ri&&(x.ri.on||x.ri.cfg_on)).length;
  let profits=allBots.map(x=>x.profit);
  const bench={max:Math.max(0,...profits),avg:profits.length?profits.reduce((a,c)=>a+c,0)/profits.length:0};
  // بحث بالاسم
  let bots=allBots.filter(b=>!FILTER.q||b.symbol.toUpperCase().includes(FILTER.q));
  // ترتيب
  bots=sortBots(bots);
  const shown=new Set(bots.map(b=>b.dir));
  // أنشئ/حدّث الظاهرة، وأخفِ المفلترة
  bots.forEach(b=>{
    let el=CARDS.get(b.dir);
    if(!el){el=buildCard(b,0);CARDS.set(b.dir,el);cardLockDeco(el)}
    el.style.display='';
    updCard(el,b,bench);skinUpd(el,b)});
  // رتّب الـ DOM حسب الترتيب الجديد — فقط إذا الترتيب تغيّر فعلاً
  // (نقل عنصر فيه iframe يعيد تحميل الشارت! فلا ننقل إلا عند الحاجة)
  const grid=$('#grid');
  const wantOrder=bots.map(b=>b.dir).join('|');
  if(grid._lastOrder!==wantOrder){
    grid._lastOrder=wantOrder;
    bots.forEach(b=>{const el=CARDS.get(b.dir);if(el)grid.appendChild(el)});
  }
  // أخفِ المفلترة، واحذف المحذوفة فعلياً
  const allDirs=new Set(allBots.map(b=>b.dir));
  for(const [dir,el] of CARDS){
    if(!allDirs.has(dir)){el.remove();CARDS.delete(dir);SPR.delete(dir)}
    else if(!shown.has(dir))el.style.display='none'}
  // 🪙 بطاقات المُراكِم — بنفس حجم بطاقات البوتات
  renderAccum(DATA&&DATA.accum||[]);
  rowsFit();                                        // 🃏 v3.26.8: القيمة الطويلة تاخذ عرض الكرت كله
  // العدّاد
  const fc=$('#fcount');
  const AN=ACC_N||{all:0,shown:0},ac=AN.all?(FILTER.q?`${AN.shown} من ${AN.all} مُراكِم`:`${AN.all} مُراكِم`):'';   // 🃏 v3.26.1: المُراكِمات تنحسب
  if(FILTER.q)fc.textContent=[`${bots.length} من ${allBots.length} بوت`,ac].filter(Boolean).join(' · ');
  else fc.textContent=[allBots.length?`${allBots.length} بوت`:'',ac].filter(Boolean).join(' · ');
  // الفراغ
  $('#empty').hidden=allBots.length>0;
  if(allBots.length>0&&bots.length===0&&!AN.shown){$('#empty').hidden=false;$('#empty').innerHTML='🔍 ماكو عملة باسم "'+FILTER.q+'"'}
  else if(allBots.length>0&&$('#empty').innerHTML.includes('ماكو عملة')){$('#empty').hidden=true}
  if(HGO)setTimeout(holyGoNow,60);                 // 📱 إشعار انضغط قبل ما توصل الأرقام ⇒ هسه يفتح مكانه
  if(IN_APP&&!APP_AUTO)appAuto()}

