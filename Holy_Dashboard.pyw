WIN_URL_TAG = b"HOLY-URL-SLOT:"
WIN_URL_MAX = 540


def win_exe():
    c = _WIN_CACHE
    if not c:
        try:
            raw = _b64s.b64decode(WIN_EXE_B64)
        except Exception:
            raw = b""
        c.update(raw=raw, sha256=_hl.sha256(raw).hexdigest() if raw else "", size=len(raw))
    return c


_WIN_CACHE = {}


def win_url_ok(u):
    """عنوان اللوحة اللي ينكتب بالبرنامج: http/https بس · بلا فراغات ولا رموز تحكم · ≤540 بايت."""
    u = str(u or "").strip()
    if not re.match(r"^https?://[^\s\"'<>\\]+$", u) or len(u.encode("utf-8")) > WIN_URL_MAX:
        return ""
    return u.rstrip("/")


def win_exe_for(url, tok=""):
    """نسخة البرنامج وبيها عنوان لوحتك + مفتاح الإشعارات (`عنوان \0 مفتاح \0` بالفتحة — باقي البرنامج نفسه بايت ببايت)."""
    raw = win_exe()["raw"]
    i = raw.find(WIN_URL_TAG)
    u = win_url_ok(url).encode("utf-8")
    if not raw or i < 0 or not u:
        return raw
    t = re.sub(r"[^A-Za-z0-9_\-]", "", str(tok or ""))[:100].encode("ascii")
    blob = u + b"\0" + t + b"\0"
    if len(blob) > WIN_URL_MAX + 20:                  # عنوان طويل جداً ⇒ العنوان بس (الإشعارات تنربط من تنزيل ثاني)
        blob = u + b"\0"
    j = i + len(WIN_URL_TAG)
    return raw[:j] + blob + b"\0" * (WIN_URL_MAX + 20 - len(blob)) + raw[j + WIN_URL_MAX + 20:]


def win_pair(ip):
    """💻 v3.26.1: كل تنزيل للبرنامج من ⚙️ = حاسوب مربوط بالإشعارات (المفتاح ينكتب بالبرنامج · هنا sha256 بس — مثل الموبايل).
    التنزيلات اللي ما انفتحت ولا مرة ما تتكدّس بالأجهزة: تنشال بعد 7 أيام · وتبقى آخر 2 منها (+ الجديد = 3 تنتظر) —
    فإذا نزّلته لحاسوبين قبل ما تفتحه، الاثنين يشتغلون."""
    now = int(time.time())
    with _APPD_LOCK:
        _appd_load()
        n0 = len(_APPD["devs"])
        pend = lambda d: str(d.get("iid") or "").startswith("win-") and int(d.get("seen") or 0) <= int(d.get("created") or 0)
        _APPD["devs"] = [d for d in _APPD["devs"] if not (pend(d) and now - int(d.get("created") or 0) > 7 * 86400)]
        old = [d for d in _APPD["devs"] if pend(d)][:-2]
        _APPD["devs"] = [d for d in _APPD["devs"] if not any(d is o for o in old)]
        if len(_APPD["devs"]) != n0:
            _appd_save(True)
    return app_pair("💻 Windows · " + datetime.now().strftime("%Y-%m-%d"), "win-" + _sc.token_hex(6), WIN_EXE_CODE, ip)



