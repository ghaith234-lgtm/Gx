def startup_bat():
    appdata = os.environ.get("APPDATA", "")
    if not appdata:
        return None
    d = os.path.join(appdata, "Microsoft", "Windows", "Start Menu", "Programs", "Startup")
    return os.path.join(d, "HolyDashboard.bat") if os.path.isdir(d) else None

def boot_enabled():
    p = startup_bat()
    return bool(p and os.path.exists(p))

def boot_toggle():
    p = startup_bat()
    if not p:
        return {"ok": False, "msg": "مجلد بدء التشغيل غير متوفر (ويندوز فقط)"}
    if os.path.exists(p):
        os.remove(p)
        return {"ok": True, "msg": "🪟 الإقلاع مع ويندوز: معطل"}
    if getattr(sys, "frozen", False):
        cmd = f'start "" "{sys.executable}" --headless'
    else:
        pyw = sys.executable
        if pyw.endswith("python.exe") and os.path.exists(pyw.replace("python.exe", "pythonw.exe")):
            pyw = pyw.replace("python.exe", "pythonw.exe")
        cmd = f'start "" "{pyw}" "{os.path.join(ROOT, os.path.basename(__file__))}" --no-browser'
    with open(p, "w", encoding="utf-8") as f:
        f.write(f'@echo off\ncd /d "{ROOT}"\n{cmd}\n')
    return {"ok": True, "msg": "🪟 الإقلاع مع ويندوز: مفعّل — اللوحة والحارس راح يقلعون بروحهم"}

