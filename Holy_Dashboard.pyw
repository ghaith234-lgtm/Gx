LAUNCH_ERR = {}

def _tail_reason(log_path):
    """يستخرج سبب موت البوت من ذيل سجله (آخر سطر خطأ مفهوم)"""
    try:
        with open(log_path, "r", encoding="utf-8", errors="ignore") as f:
            lines = [ln.rstrip() for ln in f.readlines() if ln.strip()]
        if not lines:
            return "السجل فارغ — غالباً بايثون أو مكتبة okx غير مثبّتة (شغّل: pip install python-okx websocket-client)"
        # ابحث عن أبرز سطر خطأ
        for ln in reversed(lines):
            low = ln.lower()
            if "modulenotfounderror" in low or "no module named" in low:
                mod = ln.split("'")[1] if "'" in ln else ln
                hint = "python-okx" if "okx" in low else ("websocket-client" if "websocket" in low else mod)
                return f"مكتبة ناقصة: {mod} — شغّل: pip install {hint}"
            if "error" in low or "exception" in low or "traceback" in low:
                return ln[:160]
        return lines[-1][:160]
    except Exception:
        return "تعذّرت قراءة سجل البوت"

PKGS = [("python-okx", "okx", "الاتصال بمنصة OKX"),
        ("websocket-client", "websocket", "تدفّق الأسعار اللحظي"),
        ("requests", "requests", "طلبات HTTP"),
        ("pywebview", "webview", "نافذة سطح المكتب (اختيارية)")]

def _pip(args, timeout=300):
    """🧰 تشغيل pip — أوبنتو 24.04 يرفض التنصيب بلا --break-system-packages (PEP 668)."""
    cmd = [PYTHON_EXE, "-m", "pip"] + list(args) + ["--break-system-packages",
                                                    "--disable-pip-version-check"]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        out = (r.stdout or "") + (r.stderr or "")
        if "no such option" in out.lower():          # بايثون أقدم ما يعرف الخيار
            cmd = [c for c in cmd if c != "--break-system-packages"]
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
            out = (r.stdout or "") + (r.stderr or "")
        return r.returncode == 0, out.strip()[-4000:]
    except subprocess.TimeoutExpired:
        return False, "⏱️ انتهت المهلة — تحقق من الإنترنت"
    except Exception as e:
        return False, f"{type(e).__name__}: {e}"

def libs_status():
    """📋 حالة كل مكتبة: منصّبة؟ بأي نسخة؟ تستورد فعلاً؟"""
    out = []
    for pkg, mod, why in PKGS:
        ver, imp, err = "", False, ""
        try:
            r = subprocess.run([PYTHON_EXE, "-c",
                                f"import {mod},sys;"
                                f"print(getattr({mod},'__version__','?'))"],
                               capture_output=True, text=True, timeout=15)
            if r.returncode == 0:
                imp = True; ver = (r.stdout or "").strip()[:20]
            else:
                err = ((r.stderr or "").strip().splitlines() or [""])[-1][:120]
        except Exception as e:
            err = f"{type(e).__name__}"
        if imp and (not ver or ver == "?"):
            okp, o = _pip(["show", pkg], timeout=40)
            for ln in (o or "").splitlines():
                if ln.lower().startswith("version:"):
                    ver = ln.split(":", 1)[1].strip(); break
        out.append({"pkg": pkg, "mod": mod, "why": why,
                    "ok": imp, "ver": ver or "—", "err": err})
    return out

def libs_action(op):
    """🔧 install = الناقص فقط · repair = إعادة تنصيب بنفس النسخة · upgrade = الأحدث."""
    st = libs_status()
    log = []
    if op == "install":
        miss = [x["pkg"] for x in st if not x["ok"]]
        if not miss:
            return True, "✅ كل المكتبات مثبّتة — لا شيء ناقص"
        log.append(f"📦 أنصّب الناقص: {' · '.join(miss)}")
        okk, o = _pip(["install"] + miss)
        log.append(o)
    elif op == "repair":
        have = [x for x in st if x["ok"] and x["ver"] not in ("—", "?")]
        miss = [x["pkg"] for x in st if not x["ok"]]
        okk = True
        for x in have:                # نفس النسخة — ما نغيّر شي، بس نصلّح الملفات
            log.append(f"🔧 إصلاح {x['pkg']}=={x['ver']}")
            a, o = _pip(["install", "--force-reinstall", "--no-deps",
                         f"{x['pkg']}=={x['ver']}"])
            okk &= a; log.append(o)
        if miss:
            log.append(f"📦 والناقص: {' · '.join(miss)}")
            a, o = _pip(["install"] + miss); okk &= a; log.append(o)
    elif op == "upgrade":
        names = [x["pkg"] for x in PKGS_NAMES()]
        log.append("⚠️ ترقية لأحدث نسخة — راقب البوتات بعدها")
        okk, o = _pip(["install", "--upgrade"] + names)
        log.append(o)
    else:
        return False, "عملية غير معروفة"
    after = libs_status()
    log.append("\n📋 بعد العملية:")
    for x in after:
        log.append(f"  {'✅' if x['ok'] else '❌'} {x['pkg']} {x['ver']}")
    return okk, "\n".join(log)

def PKGS_NAMES():
    return [{"pkg": p} for p, m, w in PKGS]

def _drop_reinvest(folder):
    """📄 ينزّل reinvest.py بمجلد البوت جاهزاً — **مطفي** حتى يشغّله الزبون."""
    try:
