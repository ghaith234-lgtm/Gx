def deploy(data):
    sym = str(data.get("symbol", "")).strip().upper()
    if not sym or "-" not in sym:
        return {"ok": False, "msg": "اكتب الرمز كاملاً مثل XRP-USDT"}
    try:
        grid = float(data.get("grid_pct", 0)) / 100.0
        usd = float(data.get("usd_value", 0))
        minp = float(data.get("min_price", 0))
        base = float(data.get("forced_base", 0) or 0)
    except Exception:
        return {"ok": False, "msg": "تأكد من الأرقام (النسبة/القيمة/الأرضية)"}
    if grid <= 0 or usd <= 0:
        return {"ok": False, "msg": "النسبة وقيمة الأمر لازم أكبر من صفر"}
    is_demo = bool(data.get("demo"))
    keys = {"api_key": "", "secret_key": "", "passphrase": ""}
    if not is_demo:
        keys = wallet_keys(data.get("wallet", "")) or {
            "api_key": str(data.get("api_key", "")).strip(),
            "secret_key": str(data.get("secret_key", "")).strip(),
            "passphrase": str(data.get("passphrase", "")).strip()}
        if not keys["api_key"]:
            return {"ok": False, "msg": "اختر محفظة أو أدخل مفاتيح API"}
    folder = ("demo_" if is_demo else "") + sym.split("-")[0].lower()
    base_folder, c = folder, 1
    while os.path.exists(os.path.join(ROOT, folder)):
        folder = f"{base_folder}_{c}"; c += 1
    full = os.path.join(ROOT, folder)
    os.makedirs(full, exist_ok=True)
    try:
        lower_p = float(data.get("lower_price", 0) or 0)
        upper_p = float(data.get("upper_price", 0) or 0)
    except Exception:
        lower_p = upper_p = 0.0
    try:
        buy_off = float(data.get("buy_offset", 0) or 0) / 100.0   # يصل كنسبة مئوية
    except Exception:
        buy_off = 0.0
    if buy_off < 0 or buy_off >= 0.9:
        buy_off = 0.0
    # 🎚️ النوع: **يختاره المستخدم** (g_type) — وإذا ما وصل (طلب قديم) نخمّنه: حدود → نطاق · بُعد شراء → Grid+ · وإلا إنفنتي
    _gsel = str(data.get("g_type") or "").strip()
    if _gsel in ("grid", "grid_range", "grid_plus") and not is_demo:
        if _gsel == "grid_range" and lower_p <= 0 and upper_p <= 0:
            return {"ok": False, "msg": "🎚️ جرد المدى يحتاج حد أدنى أو أعلى (أو اختار ♾️ لانهائية)"}
        if _gsel == "grid_plus" and buy_off <= 0:
            return {"ok": False, "msg": "➕ جرد بلس يحتاج بُعد شراء أكبر من صفر (أو اختار ♾️ لانهائية)"}
        if _gsel != "grid_range":
            lower_p, upper_p = 0.0, 0.0          # حقول نوع ثاني ما تنحفظ وتلخبط
        if _gsel != "grid_plus":
            buy_off = 0.0
        g_type = _gsel
    elif is_demo:
        g_type = "grid"
    elif lower_p > 0 or upper_p > 0:
        g_type = "grid_range"
    elif buy_off > 0:
        g_type = "grid_plus"
    else:
        g_type = "grid"
    if g_type == "grid_range" and lower_p > 0 and upper_p > 0 and lower_p >= upper_p:
        return {"ok": False, "msg": "الحد الأدنى للنطاق لازم أقل من الحد الأعلى"}
    cfg = {**keys, "symbol": sym, "grid_percentage": grid, "usd_value": usd, "min_price": minp,
           "forced_base_price": base, "knife_guard": bool(data.get("guard")), "is_demo": is_demo,
           "bot_type": g_type, "lower_price": lower_p, "upper_price": upper_p,
           "buy_offset": buy_off,
           "auto_restart": bool(data.get("auto", True))}
    save_json_atomic(os.path.join(full, f"config_{sym}.json"), cfg)
    if is_demo:
        srcp = find_script("demo.py")
        if not srcp:
            return {"ok": False, "msg": "وضع DEMO يحتاج ملف demo.py بالمجلد الرئيسي"}
        shutil.copy2(srcp, os.path.join(full, "demo.py"))
    else:
        eng_src, eng_script, _ = engine_for(cfg)
        with open(os.path.join(full, eng_script), "w", encoding="utf-8") as f:
            f.write(eng_src)  # 🧬 المحرك المدمج الصحيح حسب النوع
    _drop_reinvest(full)
    b = {"dir": full, "cfg_path": os.path.join(full, f"config_{sym}.json"), "cfg": cfg, "symbol": sym}
    ok, msg = launch(b)
    if ok:
        tg_send(f"🚀 *تم نشر بوت جديد!*\nالعملة: `{sym}`\nالنمط: `{'DEMO' if is_demo else 'REAL'}`\nالشبكة: `{grid*100:.2f}%`")
    _gl = {"grid_range": "جرد نطاق", "grid_plus": "Grid+"}.get(g_type, "DEMO" if is_demo else "إنفنتي جرد")
    return {"ok": ok, "msg": ("🚀 انتشر وانطلق (" + _gl + ") " + sym) if ok else msg}

def edit_bot(b, data):
    upd, restart_needed = {}, False
    if data.get("grid_pct") not in (None, ""):
        upd["grid_percentage"] = float(data["grid_pct"]) / 100.0
    if data.get("usd_value") not in (None, ""):
        upd["usd_value"] = float(data["usd_value"])
    if data.get("min_price") not in (None, ""):
        upd["min_price"] = float(data["min_price"])
    if data.get("forced_base") not in (None, ""):
        upd["forced_base_price"] = float(data["forced_base"])
    if data.get("wallet"):
        k = wallet_keys(data["wallet"])
        if not k:
            return {"ok": False, "msg": "محفظة غير معروفة"}
        upd.update(k); restart_needed = True
    if not upd:
        return {"ok": False, "msg": "ما في شي للتعديل"}
    write_cfg_keys(b["cfg_path"], upd)
    msg = "✏️ الإعدادات انحفظت — تنطبق مباشرة (البوت يقرأها كل ثانية)"
    if "grid_percentage" in upd:
        msg += ". النسبة الجديدة للأوامر الجديدة؛ لإعادة رسم السلم كله استخدم إعادة البناء ♻️"
    if restart_needed:
        sp, _, _ = paths_of(b)
        if is_alive(b["dir"], sp)[0]:
            stop_bot(b, disable_auto=False); time.sleep(0.6); launch(b)
            msg += ". بدّلت المفاتيح وأعدت تشغيل البوت 🔄"
        else:
            msg += ". المفاتيح الجديدة راح تنطبق عند التشغيل"
    return {"ok": True, "msg": msg}

def rebuild(b):
    sp, _, _ = paths_of(b)
    was_alive = is_alive(b["dir"], sp)[0]
    stop_bot(b, disable_auto=False)
    time.sleep(0.8)
    for f in glob.glob(os.path.join(b["dir"], "grid_state_*")):
        try: os.remove(f)
        except Exception: pass
    ok, msg = launch(b) if was_alive or True else (True, "")
    tg_send(f"♻️ *إعادة بناء* — `{b['symbol']}` راح يرسم شبكة جديدة من السعر الحالي")
    return {"ok": ok, "msg": "♻️ انمسحت الذاكرة وانطلق ببناء شبكة جديدة" if ok else msg}

def delete_bot(b):
    stop_bot(b)
    time.sleep(0.5)
    arch = os.path.join(ROOT, "_archive")
    os.makedirs(arch, exist_ok=True)
    dest = os.path.join(arch, f"{time.strftime('%Y%m%d_%H%M%S')}_{os.path.basename(b['dir'])}")
    try:
        shutil.move(b["dir"], dest)
    except Exception as ex:
        return {"ok": False, "msg": f"أوقفته بس فشل النقل: {ex}"}
    tg_send(f"🗑 *حذف (أرشفة)* — `{b['symbol']}` انتقل إلى `_archive`")
    return {"ok": True, "msg": "⏹ انحذف بأمان — مجلده محفوظ داخل _archive إذا احتجته"}

def shutdown_all(noexit=False):
    led = load_json(LEDGER) or {}
    today = datetime.now().strftime("%Y-%m-%d")
    t_today = sum((d.get("daily", {}) or {}).get(today, 0.0) for d in led.values() if isinstance(d, dict))
    t_all = sum(float(d.get("last_seen_total", 0) or 0) for d in led.values() if isinstance(d, dict))
    n = 0
    for b in bot_dirs().values():
        sp, _, _ = paths_of(b)
        if is_alive(b["dir"], sp)[0]:
            stop_bot(b); n += 1
    tg_send(f"🛑 *[إغلاق مركز التحكم]*\nتم إيقاف `{n}` بوت.\n💵 أرباح اليوم: `{t_today:.4f}$`\n🏦 التراكمي: `{t_all:.4f}$`")
    if not noexit:
        threading.Timer(1.5, lambda: os._exit(0)).start()
    return {"ok": True, "msg": f"⏻ أوقفت {n} بوت" + ("" if noexit else " — اللوحة تنطفي الآن")}

def reset_ledger_only():
    """يصفّر سجل الأرباح (الرسم والتقارير) بلا لمس أرباح البوتات — لتنظيف أرقام وهمية قديمة"""
    led = load_json(LEDGER) or {}
    meta = led.get("_report_metadata")
    fresh = {"_report_metadata": meta} if meta else {}
    # نعيد بناء خطوط الأساس من الأرباح الحالية حتى لا يُحسب التراكمي كربح جديد
    for b in bot_dirs().values():
        if b["cfg"].get("is_demo") or b["cfg"].get("bot_type") in ("dca", "dca_buy"):
            continue
        sp, _, _ = paths_of(b)
        st = load_json(sp) or {}
        key = os.path.relpath(b["dir"], ROOT)
        fresh[key] = {"last_seen_total": float(st.get("total_profit") or 0), "symbol": b["symbol"],
                      "daily": {}, "monthly": {}, "trades_daily": {}, "hourly": {}}
    save_json_atomic(LEDGER, fresh)
    return {"ok": True, "msg": "🧹 صُفّر سجل الأرباح — أرباح البوتات لم تُمس"}


def reset_ledger():
    save_json_atomic(LEDGER, {})
    for b in bot_dirs().values():
        sp, _, _ = paths_of(b)
        st = read_retry(sp)
        if st is not None:
            st["total_profit"] = 0.0
            try: save_json_atomic(sp, st)
            except Exception: pass
    return {"ok": True, "msg": "🔄 تصفّر السجل — الأدق تسويها والبوتات واقفة حتى ما ترجع أرقامها القديمة من ذاكرتها"}

# ───────────── التحكم بالأعلام (نفس عقد v1) ─────────────
_RI_REQ_LOCK = threading.Lock()


def _ri_request_write(path, payload, wait=8.0):
    """📨 طلب للبوت بملف — **ما يكتب فوق طلب سابق ما انطبق بعد** (كان الأول يضيع بصمت لو ضغطت مرتين بسرعة).
    ينتظر البوت يستلم السابق (عادة ثواني)؛ وإذا ما استلمه (موقوف؟) يرجّع False حتى اللوحة ترفض بوضوح."""
    with _RI_REQ_LOCK:
        t0 = time.time()
        while os.path.exists(path) and time.time() - t0 < wait:
            time.sleep(0.25)
        if os.path.exists(path):
            return False
        save_json_atomic(path, payload)
        return True


_RI_BUSY = {"ok": False, "msg": "⏳ البوت لسه ما استلم طلبك السابق (هل هو شغّال؟) — هذا الطلب ما انكتب، عيده بعد شوية"}


def control(d_rel, action, value):
    bots = bot_dirs()
    full = os.path.realpath(os.path.join(ROOT, d_rel))
    if not full.startswith(os.path.realpath(ROOT)) or full not in bots:
        return {"ok": False, "msg": "مجلد غير معروف"}
    b = bots[full]
    sp, hp, lp = paths_of(b)

    if action == "start":
        alive, _ = is_alive(full, sp)
        if alive:
            return {"ok": False, "msg": "البوت شغّال أصلاً (منع الإطلاق المزدوج)"}
        if b["cfg"].get("bot_type") in ("dca", "dca_buy"):
            try:                                   # 🏁 v3.22.1 (ح٤): تشغيل بعد «آخر دورة» ⇒ يبدي دورة جديدة
                if (load_json(sp) or {}).get("stop_after_cycle"):
                    save_state_keys(sp, {"stop_after_cycle": False})
            except Exception:
                pass
        write_cfg_keys(b["cfg_path"], {"auto_restart": True})
        ok, msg = launch(b)
        if ok:
            tg_send(f"▶️ *تشغيل* — `{b['symbol']}` انطلق من اللوحة")
        return {"ok": ok, "msg": msg}
    if action == "stop":
        killed = stop_bot(b)
        tg_send(f"⏹ *إيقاف* — `{b['symbol']}`")
        return {"ok": True, "msg": "تم الإيقاف ✅ (والحارس ما راح يعيده)" if killed else "كتبت أمر الإيقاف — أوقف العملية من مصدرها إذا ظلت حية"}
    if action == "auto":
        newv = not b["cfg"].get("auto_restart", False)
        write_cfg_keys(b["cfg_path"], {"auto_restart": newv})
        return {"ok": True, "msg": "🤖 الحارس يشمل هذا البوت" if newv else "🤖 الحارس ما يلمس هذا البوت"}
    if action == "guard":
        cfg = write_cfg_keys(b["cfg_path"], {"knife_guard": not b["cfg"].get("knife_guard", False)})
        return {"ok": True, "msg": "⚔️ الدرع فعّال" if cfg["knife_guard"] else "🛡️ الدرع مطفي"}
    if action == "reinvest":
        if str((b.get("cfg") or {}).get("bot_type") or "") in ("dca", "dca_buy"):
            return {"ok": False, "msg": "💠 إعادة الاستثمار لبوتات الشبكة بس (اللانهائية · المدى · البلس) — مو للـDCA"}
        newv = not b["cfg"].get("reinvest", False)
        write_cfg_keys(b["cfg_path"], {"reinvest": newv})
        if not newv:
            try:   # علم التحرير — البوت الشغّال يلتقطه خلال ثوانٍ حتى لو ما قرأ التهيئة
                open(os.path.join(b["dir"], "reinvest_release.flag"), "w").close()
            except Exception:
                pass
            return {"ok": True, "msg": "💵 تحرير — الأرباح تنضاف للربح اليومي خلال ثوانٍ"}
        try:   # 🧹 علم تحرير قديم ما اتنفّذ — نشيله حتى ما يحرّر بالغلط
            os.remove(os.path.join(b["dir"], "reinvest_release.flag"))
        except Exception:
            pass
        # 🔁 اللفّة تنحمّل عند الإقلاع فقط — فنعيد التشغيل تلقائياً
        #    (الزبون ما يحتاج يعرف هذي التفصيلة)
        alive, _ = is_alive(full, sp)
        if not alive:
            return {"ok": True, "msg": "🔄 مفعّل — يشتغل عند أول تشغيل للبوت"}
        _auto = b["cfg"].get("auto_restart", False)
        stop_bot(b, disable_auto=True)
        time.sleep(1.5)                       # نطر العملية تنسكر وتُحفظ الحالة
        # ⚠️ لازم نحدّث cfg بالذاكرة وإلا launch يشوف reinvest=false ويشغّل main.py
        b["cfg"] = write_cfg_keys(b["cfg_path"], {"reinvest": True, "auto_restart": True})
        ok, msg = launch(b)
        if not ok:
            write_cfg_keys(b["cfg_path"], {"auto_restart": _auto})
            return {"ok": False, "msg": f"🔄 مفعّل بالتهيئة — بس التشغيل فشل: {msg}"}
        tg_send(f"🔄 *إعادة الاستثمار مفعّلة* — `{b['symbol']}` أُعيد تشغيله تلقائياً")
        return {"ok": True, "msg": "🔄 مفعّل — وأُعيد تشغيل البوت تلقائياً ✅"}
    if action == "ri_inject":
        # 💉 اللوحة ما تكتب بحالة بوت شغّال أبداً — تكتب طلباً والبوت يلتقطه بدورته
        # المعالج يمرّر value فقط (سطر 3861) — نقبل القائمة مباشرة أو داخل مفتاح
        items = value if isinstance(value, list) else (
            (value or {}).get("items") if isinstance(value, dict) else None)
        if not isinstance(items, list) or not items:
            return {"ok": False, "msg": "ولا بند"}
        clean = []
        for it in items[:64]:
            try:
                k = str(it.get("k") or "").strip()
                px = float(it.get("px") or 0)
                u = float(it.get("usd") or 0)
                c = float(it.get("coin") or 0)
                if not k or px <= 0 or (u <= 0 and c <= 0):
                    continue
                if u != u or c != c or u < 0 or c < 0:
                    continue
                clean.append({"k": k, "px": px, "usd": round(u, 8), "coin": round(c, 10)})
            except Exception:
                continue
        if not clean:
            return {"ok": False, "msg": "ولا بند صالح"}
        fp = os.path.join(b["dir"], "reinvest_inject.json")
        if not _ri_request_write(fp, {"ts": time.time(), "items": clean}):
            return dict(_RI_BUSY)
        tot = sum(x["usd"] + x["coin"] * x["px"] for x in clean)
        pass   # 📨 رسالة تيليغرام وحدة تطلع **بعد** ما البوت يطبّق ويتأكد من المنصة (مو لحظة الطلب)
        return {"ok": True, "n": len(clean), "usd": round(tot, 4),
                "msg": f"💉 انكتب الطلب — {len(clean)} درجة · {tot:.4f}$ رأس مال. "
                       f"البوت يطبّقه خلال ثواني والأمر يكبر فوراً."}
    if action == "ri_pct":
        try:
            v = float(value)
        except Exception:
            return {"ok": False, "msg": "نسبة غير صالحة"}
        if not (0 <= v <= 100) or v != v:
            return {"ok": False, "msg": "النسبة لازم بين 0 و100"}
        v = round(v, 2)
        write_cfg_keys(b["cfg_path"], {"reinvest_pct": v})
        tg_send(f"⚖️ <b>نسبة إعادة الاستثمار</b>\n{b['symbol']} · "
                f"{v:.0f}% للأمر نفسه · {100-v:.0f}% ربح عادي")
        return {"ok": True, "msg": f"⚖️ {v:.0f}% تعود للأمر · {100-v:.0f}% ربح عادي. "
                                   f"يسري من أول دورة بيع جاية."}
    if action == "ri_withdraw":
        items = value if isinstance(value, list) else (
            (value or {}).get("items") if isinstance(value, dict) else None)
        if not isinstance(items, list) or not items:
            return {"ok": False, "msg": "ولا بند"}
        clean = []
        for it in items[:64]:
            try:
                k = str(it.get("k") or "").strip()
                px = float(it.get("px") or 0)
                c = float(it.get("cap") or 0)
                gn = float(it.get("gain") or 0)
                cq = float(it.get("cap_q") or 0)            # 🪙 جهة البيع: بالعملة
                gq = float(it.get("gain_q") or 0)
                cdd = float(it.get("cap_d") or 0)           # 💵 جهة البيع: الجزء اللي بعده دولار
                gdd = float(it.get("gain_d") or 0)
                if not k or px <= 0 or (c <= 0 and gn <= 0 and cq <= 0 and gq <= 0 and cdd <= 0 and gdd <= 0):
                    continue
                if any(v != v or v < 0 for v in (c, gn, cq, gq, cdd, gdd)):
                    continue
                row = {"k": k, "px": px, "cap": round(c, 8), "gain": round(gn, 8)}
                if cq > 0 or gq > 0:
                    row.update(cap_q=round(cq, 10), gain_q=round(gq, 10))
                if cdd > 0 or gdd > 0:
                    row.update(cap_d=round(cdd, 8), gain_d=round(gdd, 8))
                clean.append(row)
            except Exception:
                continue
        if not clean:
            return {"ok": False, "msg": "ولا بند صالح"}
        if not _ri_request_write(os.path.join(b["dir"], "reinvest_withdraw.json"), {"ts": time.time(), "items": clean}):
            return dict(_RI_BUSY)
        tc = sum(x["cap"] for x in clean)
        tg = sum(x["gain"] for x in clean)
        tcq = sum(x.get("cap_q", 0) for x in clean)
        tgq = sum(x.get("gain_q", 0) for x in clean)
        tc += sum(x.get("cap_d", 0) for x in clean)
        tg += sum(x.get("gain_d", 0) for x in clean)
        _bs = b["symbol"].split("-")[0]
        _parts = ([f"رأس مال {tc:.4f}$ → محفظتك"] if tc > 0 else []) + ([f"ربح {tg:.4f}$ → الربح المحرر"] if tg > 0 else []) \
            + ([f"رأس مال {tcq:.6f} {_bs} → محفظتك"] if tcq > 0 else []) + ([f"ربح {tgq:.6f} {_bs} → المُراكِم"] if tgq > 0 else [])
        pass   # 📨 رسالة تيليغرام وحدة تطلع **بعد** ما البوت يطبّق ويتأكد من المنصة (مو لحظة الطلب)
        return {"ok": True, "msg": "➖ انكتب الطلب — " + " · ".join(_parts) + ". البوت يطبّقه خلال ثواني والأمر يصغر فوراً."}
    if action == "rebuild":
        return rebuild(b)
    if action == "buy_now":
        sp, _, _ = paths_of(b)
        stt = load_json(sp) or {}
        if stt.get("phase") not in ("selling", "buying") or not stt.get("filled"):
