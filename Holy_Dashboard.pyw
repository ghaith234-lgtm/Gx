def launch(b):
    sp, hp, lp = paths_of(b)
    eng_src, eng_script, _ = engine_for(b["cfg"])
    script = "demo.py" if b["cfg"].get("is_demo") and os.path.exists(os.path.join(b["dir"], "demo.py")) else eng_script
    # 🔄 إعادة الاستثمار: اللوحة تكتب الملف لحالها وتحدّثه — المحرك ما ينلمس
    if script == eng_script and str(b["cfg"].get("bot_type") or "") not in ("dca", "dca_buy"):   # 💠 الغلاف لبوتات الشبكة بس
        _need = bool(b["cfg"].get("reinvest"))
        if not _need:
            # ⏹ البوت توقّف وعنده تصفية ناقصة (أُلغيت الإعادة وهو مطفي):
            #    لازم يقلع بالملف حتى يحرّر الأرباح، وإلا تبقى محبوسة للأبد
            try:
                if os.path.exists(os.path.join(b["dir"], "reinvest_release.flag")):
                    _need = True
                else:
                    _rs = (load_json(sp) or {}).get("reinvest") or {}
                    if _rs.get("on") or (_rs.get("levels") or {}) or (_rs.get("unwind") or {}):
                        _need = True
            except Exception:
                pass
        if _need:
            _rp = os.path.join(b["dir"], "reinvest.py")
            try:
                if not os.path.exists(_rp) or _file_fp(_rp) != REINV_VERSION:
                    with open(_rp, "w", encoding="utf-8") as _f:
                        _f.write(REINV_SRC)   # 🧬 شفاء ذاتي لملف إعادة الاستثمار
            except Exception:
                pass
            if os.path.exists(_rp):
                script = "reinvest.py"
    if script in (eng_script, "reinvest.py") and not os.path.exists(os.path.join(b["dir"], eng_script)):   # 🧬 الغلاف يستورد المحرك ⇒ لازم موجود
        try:
            with open(os.path.join(b["dir"], eng_script), "w", encoding="utf-8") as _f:
                _f.write(eng_src)  # 🧬 شفاء ذاتي (المحرك الصحيح حسب النوع)
        except Exception:
            pass
    if not os.path.exists(os.path.join(b["dir"], script)):
        return False, f"ما لقيت {script} بهذا المجلد"
    # 🚫 منع التكرار: لو فيه عملية شغّالة لهذا المجلد، ننهيها قبل ما نطلق جديدة
    try:
        _old = bot_pids(b["dir"], ttl=0)
        if _old:
            log_event(f"🔁 [{b['symbol']}] لكيت {len(_old)} عملية شغّالة — أُنهيها قبل الإطلاق")
            kill_bot_pids(b["dir"])
    except Exception:
        pass
    log_f = open(lp, "w", encoding="utf-8")
    flags = subprocess.CREATE_NO_WINDOW if os.name == "nt" else 0
    env = {**os.environ, "PYTHONIOENCODING": "utf-8"}
    p = subprocess.Popen([PYTHON_EXE, "-u", script], cwd=b["dir"], creationflags=flags,
                         stdout=log_f, stderr=log_f, env=env)
    with LOCK:
        PROCS[b["dir"]] = p
    # تحقق ما بعد الإطلاق: إذا مات خلال 2.5 ثانية، اقرأ سبب موته من سجله بدل ادعاء النجاح
    time.sleep(2.5)
    if p.poll() is not None:
        reason = _tail_reason(lp)
        LAUNCH_ERR[b["dir"]] = reason
        return False, f"💥 البوت مات فور الإطلاق — {reason}"
    LAUNCH_ERR.pop(b["dir"], None)
    return True, "انطلق ✅"

def stop_bot(b, disable_auto=True):
    sp, _, _ = paths_of(b)
    if disable_auto and b["cfg"].get("auto_restart"):
        write_cfg_keys(b["cfg_path"], {"auto_restart": False})
    if not save_state_keys(sp, {"status": "stopped"}):     # 🔐 v3.21.10 (ب٢٨): حقل التحكم بس — ما نكتب فوق صفقات المحرك
        st = read_retry(sp) or {}
        st["status"] = "stopped"
        try: save_json_atomic(sp, st)
        except Exception: pass
    p = PROCS.get(b["dir"]); killed = False
    if p is not None and p.poll() is None:
        try:
            p.terminate()
            try: p.wait(timeout=4)
            except Exception: p.kill()
            killed = True
        except Exception:
            pass
    if not killed:
        killed = kill_external(b["dir"])
    return killed

_PIDS_CACHE = {}

def bot_pids(full, ttl=4.0):
    """🔎 عمليات المحرك لهذا المجلد — المطابقة بـ/proc/<pid>/cwd مو بسطر الأمر.

    سطر الأمر هو `python3 -u main.py` بلا مسار، فالبحث بالمسار ما يلگى شي.
    هذا سبب بقاء عمليات يتيمة بعد إعادة تشغيل اللوحة."""
    now = time.time()
    hit = _PIDS_CACHE.get(full)
    if hit and (now - hit[0]) < ttl:
        return hit[1]
    out = []
    try:
        if os.name == "nt":
            pass
        else:
            real = os.path.realpath(full)
            me = os.getpid()
            for pid in os.listdir("/proc"):
                if not pid.isdigit() or int(pid) == me:
                    continue
                try:
                    if os.path.realpath("/proc/%s/cwd" % pid) != real:
                        continue
                    with open("/proc/%s/cmdline" % pid, "rb") as f:
                        cl = f.read().decode("utf-8", "ignore")
                    if ("main.py" in cl or "reinvest.py" in cl or "demo.py" in cl):
                        out.append(int(pid))
                except Exception:
                    continue
    except Exception:
        pass
    _PIDS_CACHE[full] = (now, out)
    return out

def kill_bot_pids(full, grace=6.0):
    """🛑 إنهاء لطيف ثم قسري — ويرجّع عدد اللي ماتوا."""
    pids = bot_pids(full, ttl=0)
    if not pids:
        return 0
    import signal
    for pid in pids:
        try: os.kill(pid, signal.SIGTERM)
        except Exception: pass
    t0 = time.time()
    hard = False
    while time.time() - t0 < grace:
        time.sleep(0.4)
        if not bot_pids(full, ttl=0):
            break
    else:
        hard = True
        for pid in bot_pids(full, ttl=0):
            try: os.kill(pid, signal.SIGKILL)
            except Exception: pass
        time.sleep(0.6)
    left = bot_pids(full, ttl=0)
    log_event(f"🛑 [{os.path.basename(full)}] أُنهيت {len(pids)-len(left)} من {len(pids)} عملية"
              + (" (قسرياً)" if hard else "")
              + (f" · بقيت {len(left)} ⚠️" if left else ""))
    return len(pids) - len(left)

def kill_external(full):
    try:
        if os.name == "nt":
            out = subprocess.run(["wmic", "process", "where", "name like 'python%'",
                                  "get", "ProcessId,CommandLine"], capture_output=True, text=True, timeout=10).stdout
            for line in out.splitlines():
                if ("main.py" in line or "demo.py" in line) and os.path.basename(full).lower() in line.lower():
                    pid = line.strip().split()[-1]
                    if pid.isdigit():
                        subprocess.run(["taskkill", "/PID", pid, "/F", "/T"], capture_output=True, timeout=10)
                        return True
        else:
            return kill_bot_pids(full) > 0
    except Exception:
        pass
    return False

