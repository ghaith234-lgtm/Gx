        c30 = (cur / v30 - 1.0) if v30 else None
        s = 0 if c7 is None else (2 if c7 >= MKT_ST[1] else 1 if c7 >= MKT_ST[0] else -2 if c7 <= -MKT_ST[1] else -1 if c7 <= -MKT_ST[0] else 0)
