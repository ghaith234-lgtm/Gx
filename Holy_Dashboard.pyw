def _brand_shadow(uid, ref, n, L, box, vert=False, cls="bsh"):
    """🌗 الخيال الطويل: n نسخة صلبة تنزل يمين-تحت (اتحادها بلا تراكم ⇒ بلا خطوط) وقناع يبهّته كل ما يبعد عن الحرف."""
    x0, y0, x1, y1 = box
    st = L / n
    gx2, gy2 = (x0, y1 + L * .85) if vert else (x0 + L * .8, y1 + L * .8)
    uses = "".join(f'<use href="#{ref}" x="{i * st:.2f}" y="{i * st:.2f}"/>' for i in range(n, 0, -1))
    return (f'<defs><linearGradient id="{uid}F" gradientUnits="userSpaceOnUse" x1="{x0}" y1="{y0}" x2="{gx2:.1f}" y2="{gy2:.1f}">'
            '<stop offset="0" stop-color="#fff"/><stop offset="1" stop-color="#fff" stop-opacity="0"/></linearGradient>'
            f'<mask id="{uid}M" maskUnits="userSpaceOnUse" x="{x0 - 12}" y="{y0 - 12}" width="{x1 - x0 + L + 24}" height="{y1 - y0 + L + 24}">'
            f'<rect x="{x0 - 12}" y="{y0 - 12}" width="{x1 - x0 + L + 24}" height="{y1 - y0 + L + 24}" fill="url(#{uid}F)"/></mask></defs>'
            f'<g class="{cls}" mask="url(#{uid}M)">{uses}</g>')


