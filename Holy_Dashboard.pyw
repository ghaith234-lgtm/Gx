def _pro_dk(ts):
    """مفتاح اليوم (UTC) من ثوانٍ أو ملّي ثانية"""
    ts = float(ts)
    if ts > 1e11:
        ts /= 1000.0
    return str(int(ts) // _PRO_DAY * _PRO_DAY)


def _pro_merge(e, pairs):
    """يدمج [(اليوم, القيمة)] في السلسلة المحفوظة ويقصّها لآخر PRO_KEEP يوماً"""
    d = e.setdefault("d", {})
    for k, v in pairs:
        d[k] = v
    for k in sorted(d, key=int)[:-PRO_KEEP]:
        d.pop(k, None)
    return len(pairs)


