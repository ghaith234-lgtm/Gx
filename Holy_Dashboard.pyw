import gzip as _gzip
_PAGE = {}
_OV_CACHE = {"t": 0.0, "v": None}
_OV_LOCK = threading.Lock()


def _page_cache():
    """🗜️ صفحة اللوحة: تنبني وتنضغط مرة وحدة لكل نسخة — والبصمة (ETag) تخلي المتصفح يعيد استعمال نسخته."""
    if _PAGE.get("v") != APP_VERSION:
        raw = HTML_PAGE.replace("__APPVER__", APP_VERSION).encode("utf-8")
        _PAGE.update(v=APP_VERSION, raw=raw, gz=_gzip.compress(raw, 6),
                     etag='"hd-%s-%s"' % (APP_VERSION, _hl.sha256(raw).hexdigest()[:12]))
    return _PAGE


def _overview_cached(max_age=1.0):
    """⚡ لو أكثر من جهاز/تبويب يطلب الملخص بنفس الثانية ⇒ حساب واحد يخدم الكل (والأفعال تصفّره)."""
    with _OV_LOCK:
        now = time.time()
        if _OV_CACHE["v"] is not None and now - _OV_CACHE["t"] < max_age:
            return _OV_CACHE["v"]
        v = overview()
        _OV_CACHE.update(t=time.time(), v=v)
        return v


class _AuthMixin:
    def _client_ip(self):
        return self.client_address[0] if self.client_address else "?"

    def _cookie_token(self):
        raw = self.headers.get("Cookie") or ""
        for part in raw.split(";"):
            k, _, v = part.strip().partition("=")
            if k == "holy_tok":
                return v
        return ""

    def _authed(self):
        if not auth_enabled():
            return True
        return _session_ok(self._cookie_token(), self._client_ip())

    def _send_login(self):
        body = LOGIN_PAGE.encode("utf-8")
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        try: self.wfile.write(body)
        except Exception: pass



class Handler(_AuthMixin, BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def _check_pin(self):
        pin = dash_cfg().get("pin")
        return (not pin) or self.headers.get("X-Dash-Pin", "") == str(pin)

    def _gz_ok(self):
        return "gzip" in (self.headers.get("Accept-Encoding") or "").lower()

    def _json(self, obj, code=200):
        body = json.dumps(obj, ensure_ascii=False).encode("utf-8")
        gz = len(body) > 1400 and self._gz_ok()           # 🗜️ الملخص ~50 كيلو ⇒ ~10 كيلو (أخف على نت الموبايل 5 مرات)
        if gz:
            body = _gzip.compress(body, 5)
        self.send_response(code)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Cache-Control", "no-store")
        if gz:
            self.send_header("Content-Encoding", "gzip")
            self.send_header("Vary", "Accept-Encoding")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        u = urlparse(self.path)
        # 🔐 حارس: كل شيء محمي عدا صفحة الدخول نفسها
        if not self._authed():
            if u.path == "/":
                return self._send_login()
            return self._json({"ok": False, "auth": False, "msg": "🔒 الجلسة منتهية — أعد الدخول"}, 401)
        if u.path == "/":
            pg = _page_cache()
            if self.headers.get("If-None-Match") == pg["etag"]:   # 🔁 نفس النسخة ⇒ المتصفح يستعمل نسخته (بلا 270 كيلو)
                self.send_response(304)
                self.send_header("ETag", pg["etag"])
                self.send_header("Cache-Control", "private, no-cache")
                self.end_headers()
                return
            gz = self._gz_ok()
            body = pg["gz"] if gz else pg["raw"]
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Cache-Control", "private, no-cache")   # يتأكد كل مرة (الدخول يبقى محمي) — بس ما ينزّلها من جديد
            self.send_header("ETag", pg["etag"])
            if gz:
                self.send_header("Content-Encoding", "gzip")
                self.send_header("Vary", "Accept-Encoding")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            return
        if not self._check_pin():
            return self._json({"ok": False, "msg": "PIN غلط"}, 401)
        q = parse_qs(u.query)
        if u.path == "/api/daylog":
            return self._json({"ok": True, "trade": _safe(trade_log, default={}),
                               "rel": _safe(released_log, default={})})
        if u.path == "/api/guard":
            return self._json(_safe(guard_view, default={"ok": False, "msg": "تعذّر تحميل الرقابة"}))
        if u.path == "/api/export.zip":
            try:
                days = int((parse_qs(u.query).get("days") or ["30"])[0])
            except Exception:
                days = 30
            try:
                body, fn = diag_bundle(max(1, min(365, days)))
            except Exception as ex:
                return self._json({"ok": False, "msg": f"تعذّر: {ex}"}, 500)
            self.send_response(200)
            self.send_header("Content-Type", "application/zip")
            self.send_header("Content-Disposition", f'attachment; filename="{fn}"')
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            try:
                self.wfile.write(body)
            except Exception:
                pass
            return
        if u.path == "/api/export.md":
            try:
                days = int((parse_qs(u.query).get("days") or ["30"])[0])
            except Exception:
                days = 30
            try:
                txt = export_md(max(1, min(365, days)))
            except Exception as ex:
                txt = f"# تعذّر توليد التقرير\n\n`{ex}`"
            body = txt.encode("utf-8")
            fn = "holy_report_" + datetime.now().strftime("%Y%m%d_%H%M") + ".md"
            self.send_response(200)
            self.send_header("Content-Type", "text/markdown; charset=utf-8")
            self.send_header("Content-Disposition", f'attachment; filename="{fn}"')
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            try: self.wfile.write(body)
            except Exception: pass
            return
        if u.path == "/api/overview":
            return self._json(_overview_cached())
        if u.path == "/api/history":
            return self._json(history_of(q.get("dir", [""])[0]))
        if u.path == "/api/feed":
            return self._json(feed_all())
        if u.path == "/api/series":
            return self._json(series_of(q.get("dir", [""])[0]))
        if u.path == "/api/settings":
            return self._json(settings_payload())
        if u.path == "/api/profit":                       # 📊 ربح التداول يوم بيوم + حصة كل بوت
            try:
                pdays = int((q.get("days") or ["30"])[0])
            except Exception:
                pdays = 30
            return self._json(_safe(profit_view, max(1, min(365, pdays)),
                                    default={"ok": False, "days": [], "bots": [], "tot": {}}))
        if u.path == "/api/report.html":                  # 🖨️ التقرير المصوّر — ملف واحد جاهز للطباعة
            try:
                pdays = int((q.get("days") or ["30"])[0])
            except Exception:
                pdays = 30
            try:
                txt = report_html(max(1, min(365, pdays)))
            except Exception as ex:
                txt = f"<!doctype html><meta charset=utf-8><p>تعذّر توليد التقرير: {type(ex).__name__}</p>"
            body = txt.encode("utf-8")
            fn = "holy_report_" + datetime.now().strftime("%Y%m%d_%H%M") + ".html"
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Disposition", f'attachment; filename="{fn}"')
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            try: self.wfile.write(body)
            except Exception: pass
            return
        if u.path == "/api/report":
            kind = q.get("kind", ["daily"])[0]
            if q.get("src", ["main"])[0] == "ri":
                txt = _safe(reinvest_report, kind, default=None)
                return self._json({"ok": True, "src": "ri",
                                   "text": txt or "💠 ماكو لقطات مسجّلة بعد.\n\n"
                                   "المسجّل ياخذ لقطة كل ~5 دقائق، ويحتاج **يومين على الأقل** "
                                   "حتى يصير عنده فرق يحسبه.\n"
                                   "وإذا كل البوتات إعادة استثمارها مطفية ما يطلع شي."})
            return self._json({"ok": True, "text": build_report(kind)})
        self._json({"ok": False, "msg": "?"}, 404)

    def do_POST(self):
        _OV_CACHE["t"] = 0.0                                # أي فعل ⇒ الملخص الجاي جديد (ولا رقم قديم بعد الضغط)
        _p = urlparse(self.path).path
        if _p in ("/api/login", "/api/logout"):
            try:
                n = int(self.headers.get("Content-Length") or 0)
                d = json.loads(self.rfile.read(n).decode("utf-8") or "{}") if n else {}
            except Exception:
                d = {}
            if _p == "/api/logout":
                _SESSIONS.pop(self._cookie_token(), None)
                return self._json({"ok": True, "msg": "🔒 تم الخروج"})
            ip = self._client_ip()
            _LOGIN_TRY.setdefault(ip, [])
            _LOGIN_TRY[ip] = [t for t in _LOGIN_TRY[ip] if time.time() - t < 300]
            if len(_LOGIN_TRY[ip]) >= 8:
                return self._json({"ok": False, "msg": "🚫 محاولات كثيرة — انتظر 5 دقائق"}, 429)
            if not auth_enabled():
                return self._json({"ok": True, "msg": "لا كلمة مرور مضبوطة"})
            if _pw_verify(str(d.get("pw") or ""), auth_cfg()["hash"]):
                tok = _new_session(ip)
                _LOGIN_TRY[ip] = []
                body = json.dumps({"ok": True}).encode("utf-8")
                self.send_response(200)
                self.send_header("Content-Type", "application/json; charset=utf-8")
                self.send_header("Set-Cookie", f"holy_tok={tok}; Path=/; HttpOnly; SameSite=Strict; Max-Age={max(1, auth_cfg()['mins'])*60}")
                self.send_header("Content-Length", str(len(body)))
                self.end_headers()
                try: self.wfile.write(body)
                except Exception: pass
                return
            _LOGIN_TRY[ip].append(time.time())
            return self._json({"ok": False, "msg": "كلمة المرور غير صحيحة"}, 401)
        if not self._authed():
            return self._json({"ok": False, "auth": False, "msg": "🔒 الجلسة منتهية — أعد الدخول"}, 401)
        return self._do_POST_inner()

    def _do_POST_inner(self):
        if not self._check_pin():
            return self._json({"ok": False, "msg": "PIN غلط"}, 401)
        try:
            n = int(self.headers.get("Content-Length", 0))
            data = json.loads(self.rfile.read(n) or b"{}")
        except Exception:
            return self._json({"ok": False, "msg": "طلب غير صالح"}, 400)
        path = urlparse(self.path).path
        if path == "/api/control":
            act = data.get("action", "")
            if act == "tg_test":
                ok = tg_send("🧪 *اختبار* — إذا وصلتك هذه الرسالة فإشعارات Holy Dashboard تعمل بنجاح! 🎉", force=True)
                return self._json({"ok": ok, "msg": ("✅ انرسلت! شوف تيليغرام" if ok else TG_DIAG["last"])})
            if act == "diag":
                lines = []
                try:
                    H = health_scan()
                    lines.append("🩺 الفحص الشامل")
                    for t, ic in (("crit", "🔴"), ("warn", "🟡"), ("info", "✅")):
                        for x in H.get(t) or []:
                            lines.append(f"{ic} {x}")
                    lines.append("")
                except Exception as _e:
                    lines.append(f"⚠️ تعذّر الفحص الشامل: {type(_e).__name__}")
                lines.append(f"🐍 بايثون المستخدم للبوتات:\n{PYTHON_EXE}")
                lines.append(f"مرشحون: {', '.join(PY_CANDS) or '—'}")
                try:
                    r = subprocess.run([PYTHON_EXE, "-c", "import okx,websocket;print('OK')"],
                                       capture_output=True, text=True, timeout=10,
                                       creationflags=(0x08000000 if os.name == "nt" else 0))
                    lines.append("📦 المكتبات (okx + websocket): " + ("✅ موجودة" if "OK" in r.stdout else ("❌\n" + (r.stderr or "")[:300])))
                except Exception as ex:
                    lines.append(f"📦 فحص المكتبات فشل: {ex}")
                _c = dash_cfg()
                _tok = (_c.get("tg_token") or "").strip()
                _chat = (_c.get("tg_chat_id") or "").strip()
                lines.append(f"📨 تيليغرام: توكن {'✅ محفوظ' if _tok else '❌ فارغ'} · Chat ID {'✅ محفوظ' if _chat else '❌ فارغ'} · مكتوم: {'نعم 🔕' if TG_MUTED['v'] else 'لا'}\nآخر حالة إرسال: {TG_DIAG['last']}")
                bots = bot_dirs()
                if bots:
                    for b in list(bots.values())[:6]:
                        _, _, lp = paths_of(b)
                        tail = ""
                        try:
                            with open(lp, "r", encoding="utf-8", errors="ignore") as f:
                                tail = "".join(f.readlines()[-12:]).strip()
                        except Exception:
                            tail = "(لا سجل بعد)"
                        lines.append(f"━━━ 📜 {b['symbol']} ━━━\n{tail or '(فارغ)'}")
                return self._json({"ok": True, "msg": "\n\n".join(lines)})
            if act == "refresh_bal":
                balances_once()
                e = " · ".join(list(BAL_ERR.values())[:2])
                return self._json({"ok": not e, "msg": ("🔄 تحدثت الأرصدة من OKX" if not e else "⚠️ " + e)})
            if act == "start_all":
                n = start_all_bots()
                return self._json({"ok": True, "msg": f"▶️ شغّلت {n} بوت — وكلهن صارن تحت جناح الحارس"})
            if act == "upgrade_engines":
                return self._json(upgrade_engines())
            if act == "shutdown_beacon":
                # يُستدعى من المتصفح عند إغلاق التبويب (sendBeacon) — يوقف كل البوتات
                stop_all_bots("أُغلق التبويب")
                kill_all_bot_procs()
                threading.Timer(0.5, lambda: os._exit(0)).start()
                return self._json({"ok": True, "msg": "🛑 توقف الكل"})
            if act == "die":
                stop_all_bots("أمر إيقاف خارجي")
                kill_all_bot_procs()
                threading.Timer(0.5, lambda: os._exit(0)).start()
                return self._json({"ok": True, "msg": "🛑 توقف الكل والمحرك ينطفي…"})
            if act == "mute":
                TG_MUTED["v"] = not TG_MUTED["v"]
                return self._json({"ok": True, "msg": "🔕 التنبيهات مكتومة" if TG_MUTED["v"] else "🔔 التنبيهات شغالة"})
            if act == "libs":
                _op = str(data.get("value") or "status")
                if _op == "status":
                    return self._json({"ok": True, "rows": _safe(libs_status, default=[])})
                _ok, _log = libs_action(_op)
                log_event(f"🧰 [المكتبات] {_op} — {'نجح' if _ok else 'فشل'}")
                return self._json({"ok": _ok, "log": _log,
                                   "rows": _safe(libs_status, default=[])})
            if act == "watchdog":
                WATCHDOG["on"] = not WATCHDOG["on"]
                return self._json({"ok": True, "msg": "🤖 الحارس شغّال" if WATCHDOG["on"] else "🤖 الحارس نايم"})
            if act == "boot":
                return self._json(boot_toggle())
            if act == "shutdown_all":
                return self._json(shutdown_all(noexit=(data.get("value") == "noexit")))
            if act == "reset_ledger":
                return self._json(reset_ledger())
            if act == "send_report":
                kind = data.get("value") or "daily"
                _ok = _tg_report(build_report(kind))      # 💠 إعادة الاستثمار صارت داخل التقرير نفسه
                return self._json({"ok": bool(_ok),
                                   "msg": "📨 انرسل التقرير لتيليغرام" if _ok
                                          else "⚠️ ما انرسل — " + str(TG_DIAG.get("last") or "")})
            if act == "guard_ack":
                v = data.get("value") or {}
                _by = "👤 اللوحة (" + str((self.client_address or ["?"])[0]) + ")"
                return self._json(guard_ack(v.get("key") or v.get("sym") or "", v.get("mode") or "accept",
                                            note=v.get("note") or "", by=_by))
            if act == "guard_scan":
                # 🔎 رد صادق: كم محفظة انفحصت فعلاً — ولا «مطابق» لو ما وصلنا للمنصة
                r = _safe(guard_scan, True, default=None) or {"ok": False, "msg": "⚠️ تعذّر الفحص (خطأ داخلي)"}
                return self._json({"ok": bool(r.get("ok")), "msg": r.get("msg") or "",
                                   "wallets": r.get("wallets"), "fail": r.get("fail"),
                                   "busy": r.get("busy"), "alerts": r.get("alerts") or []})
            if act == "ri_repair":
                _nm = str(data.get("value") or "")
                _b = next((x for x in bot_dirs().values() if os.path.basename(str(x["dir"]).rstrip("/\\")) == _nm), None)
                if not _b:
                    return self._json({"ok": False, "msg": "البوت مو موجود"})
                if _safe(_file_fp, os.path.join(_b["dir"], "reinvest.py"), default="") != REINV_VERSION:
                    return self._json({"ok": False, "msg": "⚠️ أعد تشغيل البوت أول (⏹ ثم ▶️) حتى ياخذ reinvest.py الجديد — القديم ما يعرف التصحيح"})
                _o = _ri_orphans(_b)
                if not _o:
                    return self._json({"ok": True, "msg": "ما في نمو يتيم — كلشي بحجمه الأساسي"})
                save_json_atomic(os.path.join(_b["dir"], "reinvest_repair.json"),
                                 {"id": f"rep-{int(time.time())}", "orders": [{k: x[k] for k in ("dn", "oid", "qty", "base")} for x in _o]})
                log_event(f"🧹 [تصحيح النمو اليتيم] {_nm}: {len(_o)} أمر · {sum(x['usd'] for x in _o):.4f}$ — بموافقة المالك")
                return self._json({"ok": True, "msg": f"🧹 انرسل التصحيح ({len(_o)} أمر) — البوت ينفّذه خلال ثوانٍ"})
            if act == "ticker_set":
                v = data.get("value") or {}
                _c = app_cfg()
                _c["ticker_on"] = bool(v.get("on", True))
                _c["ticker_coins"] = [str(x).upper().strip() for x in (v.get("value_coins") or v.get("coins") or [])][:20]
                _c["ticker_speed"] = max(20, min(180, int(v.get("speed") or 45)))
                if v.get("indic") is not None:
                    _c["indic_on"] = bool(v.get("indic"))
                save_app_cfg(_c)
                _safe(ticker_fetch, default=None)          # تحديث فوري بلا انتظار الدورة
                threading.Thread(target=lambda: _safe(indic_fetch, default=None), daemon=True).start()
                return self._json({"ok": True, "msg": f"📈 انحفظ الشريط — {len(_c['ticker_coins'])} عملة"
                                                      + ("" if _c["ticker_on"] else " (مطفي)")})
            if act == "guard_cfg":
                v = data.get("value") or {}
                _by = "👤 اللوحة (" + str((self.client_address or ["?"])[0]) + ")"
                return self._json(guard_cfg(auto_fix=v.get("auto_fix"), paused=v.get("paused"), by=_by))
            if act == "ri_report":
                txt = _safe(reinvest_report, data.get("value") or "daily", default=None)
                if not txt:
                    return self._json({"ok": False,
                                       "msg": "ولا بوت عنده إعادة استثمار شغّالة بلقطة مسجّلة"})
                _tg_report(txt)
                return self._json({"ok": True, "msg": "💠 انرسل تقرير إعادة الاستثمار"})
            return self._json(control(data.get("dir", ""), act, data.get("value")))
        if path == "/api/deploy":
            return self._json(deploy(data))
        if path == "/api/deploy_dca":
            return self._json(deploy_dca(data))
        if path == "/api/dca_preview":
            try:
                bp = float(data.get("base_price", 0))
            except Exception:
                bp = 0
            return self._json(compute_dca_table(data, bp))
        if path == "/api/accum":
            act = str(data.get("act") or "list")
            c = app_cfg(); lst = c.get("accumulators") or []
            if act == "save":
                a = data.get("item") or {}
                sym = str(a.get("symbol") or "").strip().upper()
                if not sym or "-" not in sym:
                    return self._json({"ok": False, "msg": "رمز غير صحيح (مثل BTC-USDT)"})
                try:
                    pct = float(a.get("pct") or 0)
                    cpct = float(a.get("coin_pct") or 0)
                    minb = float(a.get("min_buy") or 0)
                    maxb = float(a.get("max_buy") or 0)
                    lo = float(a.get("low_price") or 0)
                    hi = float(a.get("high_price") or 0)
                except Exception:
                    return self._json({"ok": False, "msg": "أرقام غير صحيحة"})
                if not (0 < pct <= 100):
                    return self._json({"ok": False, "msg": "النسبة بين 1 و100"})
                if not (0 <= cpct <= 100):
                    return self._json({"ok": False, "msg": "نسبة العملة بين 0 و100 (0 = مطفية)"})
                if lo > 0 and hi > 0 and lo >= hi:
                    return self._json({"ok": False, "msg": "الحد الأدنى لازم أقل من الأعلى"})
                if minb < 1:
                    return self._json({"ok": False, "msg": "الحد الأدنى للشراء 1$ فأكثر"})
                # 🔑 معرّف فريد: الوقت + عشوائي (كان الوقت وحده → تصادم لو أُنشئا بنفس الثانية)
                aid = a.get("id") or ("acc" + str(int(time.time()))[-6:] + _sc.token_hex(3))
                others = sum(float(x.get("pct") or 0) for x in lst if x.get("id") != aid and x.get("enabled", True))
                if a.get("enabled", True) and others + pct > 100.0001:
                    return self._json({"ok": False, "msg": f"مجموع النسب يتجاوز 100% (المتبقي {100-others:.0f}%)"})
                # 🪙 نسب العملة محسوبة لكل عملة على حدة
                _cb = sym.split("-")[0].upper()
                oc = sum(float(x.get("coin_pct") or 0) for x in lst
                         if x.get("id") != aid and x.get("enabled", True)
                         and str(x.get("symbol", "")).split("-")[0].upper() == _cb)
                if a.get("enabled", True) and oc + cpct > 100.0001:
                    return self._json({"ok": False,
                                       "msg": f"مجموع نسب عملة {_cb} يتجاوز 100% (المتبقي {100-oc:.0f}%)"})
                prev = next((x for x in lst if x.get("id") == aid), None)
                item = {"id": aid, "name": str(a.get("name") or "").strip() or sym,
                        "symbol": sym, "pct": pct, "coin_pct": cpct,
                        "min_buy": minb, "max_buy": maxb,
                        "low_price": lo, "high_price": hi, "enabled": bool(a.get("enabled", True)),
                        # 🛡️ تاريخ البدء: لا يُوزَّع ربح يوم سابق لإنشائه
                        "start": (prev or {}).get("start") or datetime.now().strftime("%Y-%m-%d")}
                lst = [x for x in lst if x.get("id") != aid] + [item]
                c["accumulators"] = lst
                try:
                    wh = data.get("window_h")
                    if wh is not None: c["acc_window_h"] = max(1, min(23, int(wh)))
                except Exception: pass
                save_app_cfg(c)
                return self._json({"ok": True, "msg": "💾 حُفظ المُراكِم", "id": aid})
            if act == "delete":
                aid = data.get("id")
                c["accumulators"] = [x for x in lst if x.get("id") != aid]
                save_app_cfg(c)
                stt = acc_state(); stt.pop(aid, None); _acc_save(stt)
                return self._json({"ok": True, "msg": "🗑️ حُذف (العملة المشتراة تبقى بمحفظتك)"})
            if act == "toggle":
                _tg_a = None
                for x in lst:
                    if x.get("id") == data.get("id"):
                        x["enabled"] = not x.get("enabled", True); _tg_a = x
                c["accumulators"] = lst; save_app_cfg(c)
                _m = "✅ تم"
                # 📦 الإيقاف ينقل «قيد الشراء» للمتراكم فوراً — لا ينتظر الدورة اليومية
                if _tg_a is not None and not _tg_a.get("enabled", True):
                    _stt = acc_state()
                    _pl = round(float((_stt.get(_tg_a["id"]) or {}).get("pool", 0)), 2)
                    if _pl > 0 and _safe(_acc_move_to_reserve, _tg_a, _stt, "إيقاف الشراء"):
                        _m = f"⏸ أُوقف الشراء · 📦 نُقل {_pl:.2f}$ للمتراكم"
                return self._json({"ok": True, "msg": _m})
            if act == "buy_now":
                aid = data.get("id")
                a = next((x for x in lst if x.get("id") == aid), None)
                if not a: return self._json({"ok": False, "msg": "غير موجود"})
                stt = acc_state(); e = stt.get(aid) or {}
                pend = round(float(e.get("pending", 0)), 6)
                if pend < 1: return self._json({"ok": False, "msg": f"الرصيد المتراكم ضئيل ({pend}$)"})
                # 💵 مبلغ محدد من المستخدم (فارغ = الكل) — لا يتجاوز المتراكم أبداً
                try:
                    want = float(data.get("amount") or 0)
                except Exception:
                    want = 0.0
                amt = pend if want <= 0 else min(want, pend)
                if amt < 1: return self._json({"ok": False, "msg": "المبلغ لازم 1$ فأكثر"})
                px = _acc_price(a.get("symbol", ""))
                if px <= 0: return self._json({"ok": False, "msg": "تعذّر جلب السعر"})
                ok, msg = acc_buy_now(a, stt, amt, px, reason="يدوي")
                return self._json({"ok": ok, "msg": msg})
            if act == "sell_preview":
                pv2 = acc_sell_preview(data.get("id"))
                return self._json(pv2 or {"ok": False, "msg": "غير موجود"})
            if act == "sell":
                ok, msg = acc_sell_now(data.get("id"), data.get("qty"))
                return self._json({"ok": ok, "msg": msg})
            if act == "withdraw":
                ok, msg = acc_withdraw(data.get("id"), data.get("amount"))
                return self._json({"ok": ok, "msg": msg})
            if act == "run":
                _safe(accum_tick, allow_buy=True)     # يدوي — يتجاوز النافذة
                return self._json({"ok": True, "msg": "⏰ نُفّذت دورة التوزيع/الشراء"})
            if act == "preview":
                y = (datetime.now() - timedelta(days=1)).strftime("%Y-%m-%d")
                return self._json({"ok": True, "yday": y, "yday_profit": day_profit(y),
                                   "window_h": int(c.get("acc_window_h") or ACC_WINDOW_H),
                                   "in_window": acc_in_window(),
                                   "today_profit": day_profit(datetime.now().strftime("%Y-%m-%d")),
                                   "used_pct": sum(float(x.get("pct") or 0) for x in lst if x.get("enabled", True)),
                                   "items": lst})
            return self._json({"ok": True, "items": lst})
        if path == "/api/okx_check":
            out = {"hosts": {}, "drift": None, "bots": [], "errors": dict(BAL_ERR)}
            for h in ("https://www.okx.com", "https://aws.okx.com"):
                try:
                    req = urllib.request.Request(h + "/api/v5/public/time",
                                                 headers={"Content-Type": "application/json"})
                    with urllib.request.urlopen(req, timeout=8, context=_OKX_CTX) as rr:
                        j = json.loads(rr.read().decode())
                    out["hosts"][h] = "ok" if j.get("code") == "0" else str(j.get("code"))
                    if j.get("code") == "0" and out["drift"] is None:
                        out["drift"] = round(time.time() - int(j["data"][0]["ts"]) / 1000.0, 1)
                except Exception as ex:
                    out["hosts"][h] = f"{type(ex).__name__}"
            for b in bot_dirs().values():
                cfg = b["cfg"]
                if cfg.get("is_demo"): continue
                k, s2, p2 = cfg.get("api_key", ""), cfg.get("secret_key", ""), cfg.get("passphrase", "")
                e = {"symbol": b["symbol"], "key": (k[:6] + "…") if k else "—"}
                if not (k and s2 and p2):
                    e["res"] = "مفاتيح ناقصة"
                else:
                    base = b["symbol"].split("-")[0]
                    r2 = _okx_get(f"/api/v5/account/balance?ccy=USDT,{base}", k, s2, p2)
                    if r2 is None:
                        e["res"] = "تعذّر الاتصال"
                    elif r2.get("code") == "0":
                        det = (r2.get("data") or [{}])[0].get("details") or []
                        e["res"] = "ok"
                        e["coins"] = [{"ccy": d.get("ccy"), "bal": d.get("availBal"), "usd": d.get("eqUsd")} for d in det]
                    else:
                        dd = (r2.get("data") or [{}])
                        dd = dd[0] if dd else {}
                        e["res"] = f"OKX {r2.get('code')}: {r2.get('msg') or dd.get('sMsg') or ''}"
                        e["code"] = str(r2.get("code"))
                out["bots"].append(e)
            return self._json({"ok": True, **out})
        if path == "/api/systemd":
            # 🐧 إقلاع تلقائي على لينكس عبر systemd
            if os.name == "nt":
                return self._json({"ok": False, "msg": "هذه الميزة للينكس — ويندوز يستعمل زر الإقلاع الحالي"})
            act = str(data.get("act") or "status")
            unit = "/etc/systemd/system/holy-dashboard.service"
            script = os.path.abspath(sys.argv[0])
            body = f"""[Unit]
Description=The Holy Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={os.environ.get('USER') or 'root'}
WorkingDirectory={ROOT}
ExecStart={PYTHON_EXE} {script} --headless
Restart=always
RestartSec=10
StandardOutput=append:{os.path.join(ROOT, 'dash.log')}
StandardError=append:{os.path.join(ROOT, 'dash.log')}

[Install]
WantedBy=multi-user.target
"""
            if act == "preview":
                return self._json({"ok": True, "unit": unit, "body": body,
                                   "cmds": f"sudo tee {unit} > /dev/null <<'EOF'\n{body}EOF\nsudo systemctl daemon-reload\nsudo systemctl enable --now holy-dashboard"})
            if act == "install":
                try:
                    with open(unit, "w", encoding="utf-8") as f:
                        f.write(body)
                    subprocess.run(["systemctl", "daemon-reload"], timeout=15)
                    r = subprocess.run(["systemctl", "enable", "holy-dashboard"], capture_output=True, text=True, timeout=15)
                    ok = r.returncode == 0
                    return self._json({"ok": ok, "msg": ("🐧 مفعّل — اللوحة راح تقلع مع السيرفر تلقائياً"
                                                          if ok else "تعذّر: " + (r.stderr or "")[:200])})
                except PermissionError:
                    return self._json({"ok": False, "msg": "يحتاج صلاحية root — استعمل زر «انسخ الأوامر» ونفّذها بنفسك"})
                except Exception as ex:
                    return self._json({"ok": False, "msg": f"تعذّر: {ex}"})
            try:
                r = subprocess.run(["systemctl", "is-enabled", "holy-dashboard"], capture_output=True, text=True, timeout=10)
                st = (r.stdout or r.stderr or "").strip()
            except Exception:
                st = "?"
            return self._json({"ok": True, "enabled": st == "enabled", "state": st})
        if path == "/api/set_pw":
            cur = str(data.get("cur") or ""); new_pw = str(data.get("new") or "")
            mins = data.get("mins")
            c = app_cfg()
            if auth_enabled() and not _pw_verify(cur, c.get("pw_hash") or ""):
                return self._json({"ok": False, "msg": "كلمة المرور الحالية غير صحيحة"})
            if new_pw == "" and data.get("disable"):
                c.pop("pw_hash", None); _SESSIONS.clear()
                save_app_cfg(c)
                return self._json({"ok": True, "msg": "🔓 أُلغيت الحماية — اللوحة مكشوفة الآن"})
            if new_pw:
                if len(new_pw) < 4:
                    return self._json({"ok": False, "msg": "كلمة المرور قصيرة (4 أحرف على الأقل)"})
                c["pw_hash"] = _pw_hash(new_pw); _SESSIONS.clear()
            if mins is not None:
                try: c["lock_mins"] = max(1, min(1440, int(mins)))
                except Exception: pass
            save_app_cfg(c)
            return self._json({"ok": True, "msg": "🔐 حُفظت — سجّل الدخول من جديد" if new_pw else "✅ حُفظت مدة القفل"})
        if path == "/api/ledger_reset":
            return self._json(reset_ledger_only())
        if path == "/api/grid_range_preview":
            try:
                cp = float(data.get("cp", 0) or data.get("base_price", 0) or 0)
            except Exception:
                cp = 0
            return self._json(compute_grid_range_table(data, cp))
        if path == "/api/settings":
            return self._json(settings_save(data))
        if path == "/api/wallet":
            return self._json(wallet_op(data))
        self._json({"ok": False, "msg": "?"}, 404)

# ───────────── الواجهة (صفحة وحدة موسعة) ─────────────
HTML_PAGE = r"""<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#070210">
<script>try{var _t=localStorage.getItem('dash_theme');if(_t&&_t!=='holy')document.documentElement.dataset.theme=_t;
if(localStorage.getItem('dash_lite')==='on')document.documentElement.classList.add('lite')}catch(e){}</script>
<title>⚡ The Holy Dashboard v3</title>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --bg0:#070210;--bg1:#0d0524;--tx:#ece7ff;--mut:#9b93c9;--mut2:#6f679e;
  --vio-rgb:167 139 250;--cyan-rgb:34 211 238;--green-rgb:52 211 153;--red-rgb:251 113 133;--amber-rgb:251 191 36;
  --vio2-rgb:124 58 237;--vio3-rgb:139 92 246;--cyan2-rgb:8 145 178;--cyan3-rgb:14 116 144;--green2-rgb:34 197 94;
  --red2-rgb:239 68 68;--amber2-rgb:245 158 11;--amber3-rgb:217 119 6;--blue-rgb:59 130 246;
  --ov-rgb:255 255 255;--sh-rgb:0 0 0;--surf-rgb:13 6 30;--surf2-rgb:10 4 26;--surf3-rgb:8 3 20;--surf4-rgb:20 10 44;--scrim-rgb:4 1 12;
  --vio:rgb(var(--vio-rgb));--cyan:rgb(var(--cyan-rgb));--green:rgb(var(--green-rgb));--red:rgb(var(--red-rgb));--amber:rgb(var(--amber-rgb));
  --glass:linear-gradient(160deg,rgb(var(--ov-rgb)/.065),rgb(var(--ov-rgb)/.022));
  --line:rgb(var(--vio-rgb)/.16);--line2:rgb(var(--cyan-rgb)/.28);
  --hi:#fff;--on-acc:#0b0420;--on-green:#04140c;--red-soft:#ffd6dd;--green-soft:#c7f9e5;--big-a:#e9e4ff;--tx2:#d9d2ff;
  --bgA:#1b0b3f;--bgB:#062033;--orb1:#7c3aed;--orb2:#0891b2;--orb3:#db2777;
  --modal-bg:linear-gradient(165deg,#170a35,#0a0620);--tip-bg:#170f2c;--coin-bg:#1b1140;--chart-bg:#0b0420;
  --card2:#12161f;--bd:#232a36;
  --ease:cubic-bezier(.22,1,.36,1);--pop:cubic-bezier(.34,1.56,.64,1);
  color-scheme:dark;
}
*{box-sizing:border-box;margin:0;padding:0}
[hidden]{display:none!important}
html,body{height:100%}
body{font-family:'IBM Plex Sans Arabic',system-ui,sans-serif;background:var(--bg0);color:var(--tx);overflow-x:hidden;
  background-image:radial-gradient(1200px 700px at 85% -10%,var(--bgA) 0%,transparent 60%),radial-gradient(1000px 700px at -10% 110%,var(--bgB) 0%,transparent 55%);}
.num{font-family:'IBM Plex Mono',monospace;font-variant-numeric:tabular-nums;direction:ltr;unicode-bidi:embed}
::-webkit-scrollbar{width:9px;height:9px}::-webkit-scrollbar-thumb{background:rgb(var(--vio-rgb)/.25);border-radius:9px}
::-webkit-scrollbar-track{background:transparent}

/* ═══ خلفية حية: أجرام متوهجة ═══ */
.orb{position:fixed;border-radius:50%;opacity:.32;pointer-events:none;z-index:0;will-change:transform;background:radial-gradient(closest-side,var(--oc) 0%,var(--oc) 34%,transparent 100%);margin:-130px;padding:130px;box-sizing:content-box}
.o1{width:520px;height:520px;--oc:var(--orb1);top:-160px;left:-120px;animation:drift1 26s ease-in-out infinite alternate}
.o2{width:460px;height:460px;--oc:var(--orb2);bottom:-180px;right:-120px;animation:drift2 34s ease-in-out infinite alternate}
.o3{width:280px;height:280px;--oc:var(--orb3);top:42%;left:46%;opacity:.14;animation:drift1 40s ease-in-out infinite alternate-reverse}
@keyframes drift1{from{transform:translate(0,0) scale(1)}to{transform:translate(90px,60px) scale(1.15)}}
@keyframes drift2{from{transform:translate(0,0) scale(1.1)}to{transform:translate(-80px,-70px) scale(.95)}}

/* ═══ الشريط العلوي ═══ */
header{position:sticky;top:0;z-index:50;display:flex;align-items:center;gap:18px;flex-wrap:wrap;
  padding:12px 22px;background:rgb(var(--surf2-rgb)/.66);backdrop-filter:blur(20px) saturate(1.4);border-bottom:1px solid var(--line)}
.brand{display:flex;align-items:center;gap:8px;font-weight:700;font-size:17px;letter-spacing:.2px}
.brand .v{font-size:11px;color:var(--cyan);border:1px solid var(--line2);border-radius:99px;padding:1px 8px;background:rgb(var(--cyan-rgb)/.08)}
.pulse{width:9px;height:9px;border-radius:50%;background:var(--green);box-shadow:0 0 10px var(--green);animation:pp 1.6s ease-in-out infinite}
.pulse.off{background:var(--red);box-shadow:0 0 10px var(--red);animation:none}
@keyframes pp{0%,100%{transform:scale(1);opacity:1}50%{transform:scale(.7);opacity:.6}}
.totals{display:flex;align-items:center;gap:14px;margin-inline-start:auto}
.tot{display:flex;align-items:baseline;gap:7px}
.tot .lbl{font-size:11.5px;color:var(--mut)}
.tot b{font-size:21px;font-weight:600;background:linear-gradient(92deg,var(--cyan),var(--vio));-webkit-background-clip:text;background-clip:text;color:transparent}
.tot .cur{font-size:12px;color:var(--mut)}
.sep{width:1px;height:26px;background:var(--line)}
#spark{opacity:.95}
nav.actions{display:flex;gap:8px;flex-wrap:wrap}
button{font-family:inherit;color:var(--tx);cursor:pointer;border:1px solid var(--line);background:var(--glass);
  border-radius:12px;padding:8px 13px;font-size:13px;
  transition:transform .16s var(--pop),box-shadow .2s,border-color .2s,background .2s,opacity .2s}
button:hover{transform:translateY(-1.5px);border-color:var(--line2);box-shadow:0 6px 20px rgb(var(--cyan-rgb)/.10)}
button:active{transform:scale(.94)}
button.primary{background:linear-gradient(94deg,rgb(var(--vio2-rgb)/.85),rgb(var(--cyan2-rgb)/.85));border-color:transparent;font-weight:600;
  box-shadow:0 4px 22px rgb(var(--vio2-rgb)/.35)}
button.danger{border-color:rgb(var(--red-rgb)/.4);color:var(--red-soft)}
button.danger:hover{box-shadow:0 6px 18px rgb(var(--red-rgb)/.18)}
button.on{border-color:var(--amber);color:var(--amber);box-shadow:inset 0 0 0 1px rgb(var(--amber-rgb)/.35),0 0 14px rgb(var(--amber-rgb)/.22)}
button:disabled{opacity:.45;pointer-events:none}

/* ═══ شبكة البطاقات ═══ */
.toolbar{position:relative;z-index:2;display:flex;align-items:center;gap:14px;flex-wrap:wrap;
  max-width:1640px;margin:0 auto;padding:14px 22px 0}
.srch{position:relative;flex:1;min-width:220px;max-width:420px}
.srch input{width:100%;background:var(--glass);border:1px solid var(--line);border-radius:13px;color:var(--tx);
  padding:11px 40px 11px 42px;font-size:14px;font-family:inherit;transition:border-color .2s,box-shadow .2s}
.srch input:focus{border-color:var(--cyan);box-shadow:0 0 0 3px rgb(var(--cyan-rgb)/.13);outline:none}
.srch .si{position:absolute;inset-inline-start:14px;top:50%;transform:translateY(-50%);font-size:15px;opacity:.7;pointer-events:none}
.srch .sx{position:absolute;inset-inline-end:13px;top:50%;transform:translateY(-50%);cursor:pointer;color:var(--mut);font-size:13px}
.srch .sx:hover{color:var(--red)}
.sortbox{display:flex;align-items:center;gap:8px}
.sortbox .sl{font-size:12.5px;color:var(--mut)}
.sortbox select{background:var(--glass);border:1px solid var(--line);border-radius:11px;color:var(--tx);
  padding:9px 12px;font-size:13px;font-family:inherit;cursor:pointer;}
.sortbox select:focus{border-color:var(--cyan);outline:none}
.sortbox select option{background:var(--bg1)}
.sdir{padding:9px 13px;font-size:14px;font-weight:700;min-width:40px}
.sdir.up{color:var(--cyan);border-color:var(--line2)}
.fcount{font-size:12px;color:var(--mut2);margin-inline-start:auto}
main{position:relative;z-index:1;display:grid;grid-template-columns:repeat(auto-fill,minmax(min(355px,100%),1fr));gap:18px;padding:22px;max-width:1640px;margin:0 auto}
.empty{position:relative;z-index:1;text-align:center;color:var(--mut);padding:90px 20px;font-size:16px}

/* ═══ البطاقة (طراز performance-benchmark-card) ═══ */
.card{position:relative;background:var(--glass);border:1px solid var(--line);border-radius:20px;padding:18px 18px 14px;
  box-shadow:inset 0 1px 0 rgb(var(--ov-rgb)/.05),0 12px 34px rgb(var(--sh-rgb)/.35);
  transition:transform .28s var(--ease),box-shadow .28s,border-color .28s;overflow:hidden}
.card::before{content:'';position:absolute;inset:0;border-radius:20px;pointer-events:none;
  background:radial-gradient(420px 140px at 80% -8%,rgb(var(--vio-rgb)/.13),transparent 70%)}
.card:hover{transform:translateY(-4px);border-color:rgb(var(--vio-rgb)/.34);box-shadow:0 18px 44px rgb(var(--vio2-rgb)/.22)}
.card.dead{filter:saturate(.45) brightness(.82)}
body.boot .card{animation:rise .6s var(--ease) both;animation-delay:calc(var(--i,0)*70ms)}
@keyframes rise{from{opacity:0;transform:translateY(16px) scale(.985)}to{opacity:1;transform:none}}
.chead{display:flex;align-items:center;gap:9px;margin-bottom:12px}
.sym{font-weight:700;font-size:15.5px;display:flex;align-items:center;gap:7px}
.chip{font-size:10px;padding:2px 8px;border-radius:99px;border:1px solid var(--line);color:var(--mut)}
.chip.demo{color:var(--cyan);border-color:var(--line2)}
.chip.acc{color:var(--amber);border-color:rgb(var(--amber-rgb)/.4);background:rgb(var(--amber-rgb)/.07);box-shadow:0 0 10px rgb(var(--amber-rgb)/.15)}
@keyframes apulse{0%,100%{box-shadow:0 0 0 0 rgb(var(--amber2-rgb)/.55)}50%{box-shadow:0 0 0 7px rgb(var(--amber2-rgb)/0)}}
.hbadge{margin-inline-start:6px;font-size:13px;line-height:1}
.hbadge.bad{filter:drop-shadow(0 0 4px rgb(var(--red2-rgb)/.9))}
.hbadge.warn{filter:drop-shadow(0 0 4px rgb(var(--amber2-rgb)/.8))}
.pill{margin-inline-start:auto;font-size:11px;padding:3px 10px;border-radius:99px;display:flex;align-items:center;gap:6px;border:1px solid var(--line)}
.pill::before{content:'';width:7px;height:7px;border-radius:50%}
.pill.ok{color:var(--green-soft);border-color:rgb(var(--green-rgb)/.35)}
.pill.ok::before{background:var(--green);box-shadow:0 0 9px var(--green);animation:pp 1.8s infinite}
.pill.off{color:var(--red-soft);border-color:rgb(var(--red-rgb)/.35)}
.pill.off::before{background:var(--red)}
.cmain{display:flex;align-items:flex-end;justify-content:space-between;gap:14px;margin-bottom:14px}
.big{font-size:31px;font-weight:600;line-height:1.05;background:linear-gradient(92deg,var(--big-a),var(--cyan) 80%);-webkit-background-clip:text;background-clip:text;color:transparent}
.big .u{font-size:14px;color:var(--mut);-webkit-text-fill-color:var(--mut)}
.pricebox{display:flex;align-items:center;gap:8px;margin-top:9px}
.plabel{font-size:11px;color:var(--mut)}
.bigprice{font-size:23px;font-weight:700;transition:color .4s ease;color:var(--cyan);-webkit-text-fill-color:initial}
.bigprice.up{color:var(--green)}
.bigprice.dn{color:var(--red)}
.ptrend{font-size:15px;transition:opacity .3s;opacity:.9}
.ptrend.up{color:var(--green)}.ptrend.dn{color:var(--red)}
@keyframes priceFlash{0%{transform:scale(1)}40%{transform:scale(1.13)}100%{transform:scale(1)}}
/* ═══ كرت DCA المميّز (ثيم عنبري) ═══ */
.card.dca{border-color:rgb(var(--amber-rgb)/.28);background:linear-gradient(180deg,rgb(var(--amber-rgb)/.05),rgb(var(--surf-rgb)/.5))}
.card.dca:hover{border-color:rgb(var(--amber-rgb)/.5)}
.dcahead{display:flex;align-items:center;gap:9px;padding:14px 16px 0;flex-wrap:wrap}
.dcatag{font-size:11px;background:rgb(var(--amber-rgb)/.16);color:var(--amber);border:1px solid rgb(var(--amber-rgb)/.35);padding:2px 9px;border-radius:99px;font-weight:600}
.dcabody{padding:14px 16px 16px}
.dcatop{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px}
.dcacell{background:rgb(var(--ov-rgb)/.03);border-radius:11px;padding:9px 11px}
.dcacell .dl{display:block;font-size:10.5px;color:var(--mut2);margin-bottom:4px}
.dcacell b{font-size:15px;color:var(--tx)}
.dcaprice.up{color:var(--green)}.dcaprice.dn{color:var(--red)}
.dcacoin{color:var(--green)!important}.dcaloss{color:var(--red)!important}
.dcacyc{margin-bottom:12px}
.dcacyclbl{display:flex;justify-content:space-between;font-size:11px;color:var(--mut);margin-bottom:5px}
.dcabar{height:7px;background:rgb(var(--ov-rgb)/.06);border-radius:5px;overflow:hidden}
.dcafill{height:100%;background:linear-gradient(90deg,var(--amber),var(--green));border-radius:5px;transition:width .6s var(--ease);box-shadow:0 0 8px rgb(var(--amber-rgb)/.4)}
.dcaprofit{display:flex;align-items:center;justify-content:space-between;background:rgb(var(--green-rgb)/.07);border:1px solid rgb(var(--green-rgb)/.2);border-radius:11px;padding:10px 13px;margin-bottom:11px}
.dcaprofit .dl{font-size:11.5px;color:var(--mut)}
.dcaprofit b{font-size:17px}
.dcabuy{width:100%;padding:12px;border-radius:12px;background:linear-gradient(94deg,var(--green),#16a34a);color:var(--on-green);font-weight:700;font-size:14px;border:none;margin-bottom:10px;transition:transform .15s,box-shadow .2s}
.dcabuy:hover{box-shadow:0 6px 20px rgb(var(--green-rgb)/.3)}
.dcabuy.loss{background:linear-gradient(94deg,var(--red),#dc2626);color:#fff}
.dcabtns{display:grid;grid-template-columns:repeat(4,1fr) auto auto;gap:5px;margin-bottom:10px}
.dcaopts{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:8px}
.dcaopts .dcashield{margin-bottom:0}
.dcalast{width:100%;padding:9px 10px;border-radius:10px;font-size:12.5px;border:1px solid var(--line);background:rgb(var(--ov-rgb)/.03);color:var(--mut);text-align:center}
.dcalast.on{border-color:rgb(var(--amber-rgb)/.5);background:rgb(var(--amber-rgb)/.12);color:var(--amber);font-weight:600}
.dcaviz{margin:6px 0 10px;border:1px solid var(--line);border-radius:12px;background:rgb(var(--ov-rgb)/.02);padding:6px 4px 4px}
.dcaviz svg{width:100%;height:auto;display:block;direction:ltr}
.dcaviz .vcap{display:flex;justify-content:center;gap:10px;flex-wrap:wrap;font-size:10.5px;color:var(--mut2);padding:2px 4px 0}
.dcaviz .vempty{font-size:12px;color:var(--mut);text-align:center;padding:16px 8px}
.dntbl small{color:var(--mut2);font-size:9.5px}
.dnwarn{border-radius:9px;padding:9px 12px;margin-top:10px;font-size:11.5px;line-height:1.8}
.dcashield{width:100%;padding:9px 10px;border-radius:10px;font-size:12.5px;margin-bottom:8px;border:1px solid var(--line);background:rgb(var(--ov-rgb)/.03);color:var(--mut);text-align:center}
.dcashield.on{border-color:rgb(var(--green-rgb)/.45);background:rgb(var(--green-rgb)/.10);color:var(--green);font-weight:600}
.dcaladbox{margin:0 0 12px;border-radius:12px;border:1px solid rgb(var(--amber-rgb)/.2);background:rgb(var(--amber-rgb)/.03);padding:10px;max-height:260px;overflow-y:auto}
.dcarail{margin:10px 0 12px}
.drailtrack{position:relative;height:46px;border-radius:10px;background:linear-gradient(180deg,rgb(var(--ov-rgb)/.03),rgb(var(--ov-rgb)/.01));border:1px solid var(--line);overflow:hidden}
.drailband{position:absolute;top:0;bottom:0;background:linear-gradient(90deg,rgb(var(--green-rgb)/.10),rgb(var(--amber-rgb)/.10));border-radius:8px}
.dline{position:absolute;top:0;bottom:0;width:2px;z-index:3}
.dline.avg{background:var(--amber)}
.dline.tgt{background:var(--green)}
.dline.cp{background:var(--hi);width:2px;box-shadow:0 0 6px rgb(var(--ov-rgb)/.6)}
.dline .dlbl{position:absolute;top:2px;transform:translateX(-50%);font-size:8.5px;white-space:nowrap;padding:1px 4px;border-radius:4px;font-weight:600}
.dline.avg .dlbl{color:var(--amber);background:rgb(var(--amber-rgb)/.15)}
.dline.tgt .dlbl{color:var(--green);background:rgb(var(--green-rgb)/.15);top:auto;bottom:2px}
.dline.cp .dlbl{color:var(--hi);background:rgb(var(--ov-rgb)/.15)}
.dsell{position:absolute;top:50%;transform:translate(-50%,-50%);width:7px;height:7px;border-radius:50%;background:var(--red);z-index:2;box-shadow:0 0 4px rgb(var(--red-rgb)/.5)}
.dsell.pend{background:rgb(var(--amber-rgb)/.6);width:5px;height:5px}
.drailft{display:flex;justify-content:space-between;margin-top:5px;font-size:9.5px;color:var(--mut2)}
.ladhdr{font-size:11.5px;color:var(--amber);margin-bottom:8px;font-weight:600}
.gdbtns{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.gdbtns button{padding:10px 8px;font-size:12px;border-radius:10px;background:rgb(var(--ov-rgb)/.04);border:1px solid var(--line);color:var(--tx)}
.gdbtns button.on{background:rgb(var(--green-rgb)/.12);border-color:rgb(var(--green-rgb)/.35);color:var(--green)}
.dcabtns button{padding:9px 8px;font-size:12px}
.dcastatus{text-align:center;font-size:12px;color:var(--mut);padding:8px;background:rgb(var(--ov-rgb)/.02);border-radius:9px}
.dnsec{font-size:13px;font-weight:600;color:var(--amber);margin:14px 0 8px}
.dntbl{width:100%;border-collapse:collapse;font-size:11.5px}
.dntbl th{padding:7px 4px;font-weight:400;color:var(--mut2);border-bottom:1px solid var(--line)}
.dntbl td{padding:7px 4px;text-align:center;color:var(--tx);border-bottom:1px solid rgb(var(--ov-rgb)/.04)}
.dntbl td:first-child{color:var(--mut)}
.dnsum{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-top:12px}
.dnstat{background:rgb(var(--ov-rgb)/.03);border-radius:10px;padding:9px;text-align:center}
.dnstat span{display:block;font-size:10px;color:var(--mut2);margin-bottom:4px}
.dnstat b{font-size:15px}
.ladsec{font-size:12px;font-weight:600;margin-bottom:7px}
.ladrow{display:flex;align-items:center;gap:10px;padding:8px 11px;background:rgb(var(--ov-rgb)/.03);border-radius:9px;margin-bottom:5px}
.ladrow .num{font-size:13px;font-weight:600;min-width:70px}
.ladq{flex:1;font-size:11.5px;color:var(--mut)}
.ladtag{font-size:10px;padding:2px 8px;border-radius:99px}
.ladtag.on{background:rgb(var(--green-rgb)/.15);color:var(--green)}
.ladtag.pend{background:rgb(var(--amber-rgb)/.15);color:var(--amber)}
.bigprice.flash{animation:priceFlash .45s var(--pop)}
.delta{font-size:11.5px;margin-top:5px;font-weight:600}
.delta.up{color:var(--green)}.delta.dn{color:var(--red)}.delta.z{color:var(--mut)}
.bench{width:48%;min-width:150px}
.btrack{position:relative;height:7px;border-radius:99px;background:rgb(var(--ov-rgb)/.08);overflow:visible}
.bfill{position:absolute;inset-block:0;inset-inline-start:0;width:0%;border-radius:99px;background:linear-gradient(90deg,var(--cyan),var(--vio));
  box-shadow:0 0 12px rgb(var(--cyan-rgb)/.35);transition:width .9s var(--ease)}
.bavg{position:absolute;top:50%;width:2px;height:17px;transform:translateY(-50%);background:var(--hi);border-radius:2px;opacity:.85;transition:inset-inline-start .9s var(--ease)}
.blbl{display:flex;justify-content:space-between;margin-top:7px;font-size:10.5px;color:var(--mut)}
.rows{display:flex;flex-direction:column;gap:8px;margin-bottom:13px}
.row{display:flex;align-items:center;gap:10px;font-size:13px}
.row .ic{width:22px;text-align:center;opacity:.9}
.row .nm{flex:1;color:var(--mut)}
.row b{font-weight:600;font-size:13.5px}
.chips{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:12px;min-height:0}
.lad{margin-bottom:13px}
.ltitle{display:flex;align-items:center;gap:7px;font-size:12px;color:var(--mut);margin-bottom:7px}
.lbar{position:relative;display:flex;height:10px;border-radius:99px;overflow:visible;direction:ltr;background:rgb(var(--ov-rgb)/.05)}
.seg{height:100%;transition:width .7s var(--ease)}
.seg:first-child{border-radius:99px 0 0 99px}.seg:last-child{border-radius:0 99px 99px 0}
.s_ab{background:rgb(var(--amber-rgb)/.45)}.s_vb{background:rgb(var(--cyan-rgb)/.30)}.s_b{background:var(--cyan);box-shadow:0 0 10px rgb(var(--cyan-rgb)/.4)}
.s_gap{background:transparent}
.s_s{background:var(--green);box-shadow:0 0 10px rgb(var(--green-rgb)/.4)}.s_vs{background:rgb(var(--green-rgb)/.30)}.s_as{background:rgb(var(--amber-rgb)/.45)}
.lmark{position:absolute;top:50%;transform:translate(-50%,-50%);width:13px;height:13px;border-radius:50%;
  background:radial-gradient(circle at 35% 30%,#fff,var(--vio));box-shadow:0 0 14px var(--vio),0 0 4px #fff;transition:left .7s var(--ease);animation:pp 2.2s infinite}
.llbl{display:flex;justify-content:space-between;direction:ltr;margin-top:6px;font-size:10px;color:var(--mut2)}
.mlad{display:flex;flex-direction:column;gap:4px}
.mrow{display:flex;align-items:center;gap:9px;font-size:11px;color:var(--mut)}
.mrow .pr{min-width:78px;font-weight:600;color:var(--tx)}
.mrow .ln{flex:1;height:4px;border-radius:4px;opacity:.9}
.mrow.sell .ln{background:linear-gradient(270deg,var(--green),transparent 85%)}
.mrow.buy .ln{background:linear-gradient(270deg,transparent 85%,var(--cyan));background:linear-gradient(90deg,var(--cyan),transparent 85%)}
.mrow.cp{margin:2px 0}
.mrow.cp .ln{height:2px;background:linear-gradient(90deg,transparent,var(--vio),transparent);box-shadow:0 0 8px var(--vio)}
.mrow.cp .pr{color:var(--cyan);font-size:12.5px}
.pstrip{position:relative;height:26px;margin-top:9px;border-radius:8px;background:rgb(var(--ov-rgb)/.04);overflow:hidden;direction:ltr}
.pscan{position:absolute;top:0;bottom:0;left:0;width:34%;background:linear-gradient(90deg,transparent,rgb(var(--vio-rgb)/.10),transparent);animation:scan 3.4s linear infinite;will-change:transform}
@keyframes scan{from{transform:translateX(-103%)}to{transform:translateX(297%)}}
.ptk{position:absolute;top:5px;bottom:5px;width:2.5px;border-radius:2px;transition:left .8s var(--ease);box-shadow:0 0 6px currentColor}
.ptk.b{background:var(--cyan);color:var(--cyan)}
.ptk.s{background:var(--green);color:var(--green)}
.pmk{position:absolute;top:0;bottom:0;width:2px;background:var(--vio);transition:left .8s var(--ease);box-shadow:0 0 8px var(--vio)}
.pmk::after{content:'';position:absolute;top:50%;left:50%;width:9px;height:9px;border-radius:50%;transform:translate(-50%,-50%);background:radial-gradient(circle at 35% 30%,#fff,var(--vio));box-shadow:0 0 12px var(--vio);animation:pp 1.5s ease-in-out infinite}
.coin{width:22px;height:22px;border-radius:50%;object-fit:cover;background:var(--coin-bg);flex:none}
.coinltr{width:22px;height:22px;border-radius:50%;display:inline-grid;place-items:center;font-size:11px;font-weight:700;background:linear-gradient(135deg,var(--vio),var(--cyan));color:var(--on-acc);flex:none}
.chip.ck{cursor:pointer;user-select:none}
.chip.ck:hover{border-color:var(--line2)}
.chip.gOn{color:var(--amber);border-color:rgb(var(--amber-rgb)/.45);background:rgb(var(--amber-rgb)/.07)}
.cbtns{display:grid;grid-template-columns:auto 1fr 1fr;gap:8px}
.cbtns2{display:grid;grid-template-columns:1fr 1fr 1.3fr auto;gap:8px;margin-top:8px}
.cdel{padding:9px 13px}
.cbtns2 button{padding:9px 8px;font-size:12.5px;white-space:nowrap}
.cset{background:linear-gradient(94deg,rgb(var(--vio2-rgb)/.4),rgb(var(--cyan2-rgb)/.4));border-color:var(--line2);font-weight:600}
.cset:hover{box-shadow:0 4px 16px rgb(var(--vio2-rgb)/.25)}
.cchart{margin:4px 0 12px;border-radius:14px;overflow:hidden;border:1px solid var(--line);height:280px;background:var(--chart-bg);
  animation:chartIn .4s var(--ease)}
@keyframes chartIn{from{opacity:0;height:0;margin:0}to{opacity:1;height:280px}}
.cchart iframe{width:100%;height:100%;border:0;display:block}
.cbtns button{padding:8px 10px;font-size:12.3px;white-space:nowrap}
.last{margin-top:11px;font-size:10.8px;color:var(--mut2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;direction:rtl}

/* ═══ الصفحات المنزلقة ═══ */
.page{position:fixed;inset:0;z-index:80;background:rgb(var(--surf3-rgb)/.72);backdrop-filter:blur(22px) saturate(1.3);
  opacity:0;transform:translateX(-26px);pointer-events:none;transition:opacity .32s var(--ease),transform .32s var(--ease);overflow-y:auto}
.page.on{opacity:1;transform:none;pointer-events:auto}
.pwrap{max-width:1060px;margin:0 auto;padding:26px 22px 60px}
.phead{display:flex;align-items:center;gap:12px;margin-bottom:20px}
.phead h2{font-size:20px;font-weight:700}
.x{margin-inline-start:auto;width:38px;height:38px;border-radius:12px;display:grid;place-items:center;font-size:15px}
.panel{background:var(--glass);border:1px solid var(--line);border-radius:18px;padding:18px;margin-bottom:16px}
.panel h3{font-size:14px;margin-bottom:12px;color:var(--cyan)}
/* 📊 ربح التداول اليومي — ألوان مفحوصة لعمى الألوان على خلفية اللوحة */
.pc-head{display:flex;justify-content:space-between;align-items:baseline;gap:10px;flex-wrap:wrap}
.pc-sub{font-size:11.5px;color:var(--mut)}
.pc-kpi{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin:4px 0 14px}
.pc-k{background:rgb(var(--ov-rgb)/.035);border:1px solid var(--line);border-radius:12px;padding:10px 12px;min-width:0}
.pc-k small{display:block;font-size:11px;color:var(--mut)}
.pc-k b{display:block;font-size:18px;font-weight:600;color:var(--tx);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.pc-k i{display:block;font-style:normal;font-size:10.5px;color:var(--mut2);margin-top:1px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.pc-grid{display:grid;grid-template-columns:minmax(0,2fr) minmax(0,1fr);gap:16px;align-items:start;transition:opacity .25s}
.pc-fig{position:relative;margin:0;min-width:0}
.pc-leg{display:flex;gap:14px;flex-wrap:wrap;font-size:11.5px;color:var(--mut);margin-bottom:6px}
.pc-leg i{display:inline-block;width:10px;height:10px;border-radius:2px;margin-inline-end:6px;vertical-align:-1px}
.pc-bars{position:relative}
.pc-svg{display:block;width:100%;height:auto;direction:ltr;overflow:visible}
.pc-svg .pc-gl{stroke:rgb(var(--vio-rgb)/.12);stroke-width:1}.pc-svg .pc-bl{stroke:rgb(var(--vio-rgb)/.32);stroke-width:1}
.pc-svg text{font-family:'IBM Plex Mono',monospace;font-size:11px;fill:var(--mut)}
.pc-svg .pc-mx{fill:var(--tx);font-size:12px;font-weight:600}
.pc-svg .pc-col{transform-box:fill-box;transform-origin:50% 100%;animation:pcUp .7s var(--ease) both;animation-delay:calc(var(--i)*16ms)}
.pc-svg .pc-col.on .pc-seg{filter:brightness(1.3)}
