def _ri_handoffs_of(bst):
    """🪙 كل تسليمات بوت: الطابور الجديد + الخانة القديمة — بلا تكرار بالمعرّف."""
    ri = bst.get("reinvest") if isinstance(bst.get("reinvest"), dict) else {}
    out, ids = [], set()
    for h in list(ri.get("handoffs") or []) + ([ri["handoff"]] if isinstance(ri.get("handoff"), dict) else []):
        if isinstance(h, dict) and h.get("id") and h["id"] not in ids:
            ids.add(h["id"])
            out.append(h)
    return out


def _ri_pending_handoffs(bst, grace=0.0):
    """🪙 تسليمات عملة **فعلاً ما وصلت**: مو مسجّلة بدفتر المُراكِم (`_ri_seen`) — ومضى عليها ≥ grace ثانية.
    البوت يبقي سجل التسليم بحالته للتوثيق؛ اللي انسلّم ينعلّم بدفتر المُراكِم ⇒ الفحص يرجع للدفتر، مو لحالة البوت
    (كان يعدّ أي تسليم صار بالماضي ⇒ «🔴 حوالة معلّقة» كاذبة للأبد)."""
    seen = set(str(x) for x in ((_safe(acc_state, default={}) or {}).get("_ri_seen") or []))
    now = time.time()
    return [h for h in _ri_handoffs_of(bst) if str(h.get("id")) not in seen and now - float(h.get("ts") or now) >= grace]


def _dca_handoffs_of(b, bst):
    """🪙 v3.22.1 (ح٧): ربح DCA البيعي (عملة صافية بعد العمولة) لكل دورة = «ربح محرَّر عملة» ⇒ نفس طريق عملة الجرد:
    للمُراكِم بنسبة العملة إذا مفتوح على نفس العملة والمحفظة، والباقي/بلا مُراكِم ⇒ المحفظة. المعرّف من سجل الدورات (ما ينعاد)."""
    if (b.get("cfg") or {}).get("bot_type") != "dca":
        return []
    out = []
    for c in (bst.get("cycles_log") or []):
        try:
            p, px = float(c.get("profit") or 0), float(c.get("px") or 0)
        except Exception:
            continue
        if c.get("id") and p > 0 and px > 0:
            out.append({"id": "dca:" + str(c["id"]), "coin": p, "avg_px": px, "symbol": b["symbol"],
                        "why": f"ربح DCA — دورة #{c.get('n')}", "ts": float(c.get("ts") or 0)})
    return out


