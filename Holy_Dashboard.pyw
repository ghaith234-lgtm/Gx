async function libsRows(rows){
  if(!rows||!rows.length)return '<p style="color:var(--mut)">تعذّر الفحص</p>';
  let h='<table style="width:100%;border-collapse:collapse;direction:rtl;font-size:12.5px">';
  rows.forEach(x=>{
    h+=`<tr style="border-top:1px solid var(--line)">
      <td style="padding:7px 4px">${x.ok?'✅':'❌'}</td>
      <td style="padding:7px 4px"><b>${x.pkg}</b><br>
        <span style="color:var(--mut2);font-size:10.5px">${x.why}</span></td>
      <td style="padding:7px 4px;text-align:left;color:${x.ok?'var(--green)':'var(--red)'}">
        ${x.ok?x.ver:'غير منصّبة'}</td></tr>`;
    if(x.err)h+=`<tr><td colspan="3" style="padding:0 4px 6px;color:var(--red);font-size:10.5px">${x.err}</td></tr>`;
  });
  return h+'</table>';
}
async function libsRun(op){
