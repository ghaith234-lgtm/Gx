/* ── 📋 v3.36.10: الأوامر المنشورة على المنصة بالتفصيل (قراءة فقط) ── */
async function exOrdOpen(refresh){
  if(refresh){try{await api('/api/control',{action:'refresh_bal'})}catch(e){}}
  let v=null;try{v=await api('/api/ex_orders')}catch(e){}
  if(!v||!v.ok){toast('تعذّر تحميل الأوامر',false);return}
  const N=(x,d)=>{x=+x||0;const a=Math.abs(x);return x.toFixed(d!=null?d:(a>=100?2:a>=1?4:6))},E=s=>gEsc(String(s==null?'':s));
  const age=t=>{if(!(t>0))return '—';const s=Math.max(0,Date.now()/1000-t);return s<3600?Math.round(s/60)+' د':s<86400?Math.round(s/3600)+' س':Math.round(s/86400)+' يوم'};
  const G=v.groups||[];
  let h=`<h2>📋 الأوامر المنشورة على المنصة</h2><p class="xo-sum">${v.ns+v.nb} أمر: <b class="xo-s">${v.ns} بيع ↑</b> بقيمة <span dir="ltr">${N(v.usd_s,2)}$</span> · <b class="xo-b">${v.nb} شراء ↓</b> بقيمة <span dir="ltr">${N(v.usd_b,2)}$</span>`
    +(v.outside?` · ⚠️ ${v.outside} خارج البوتات`:'')+`<br>من OKX مباشرة${v.age!=null?` قبل ${Math.round(v.age)} ثانية`:''} — تتحدّث كل 30 ثانية · القيمة = الكمية الباقية × السعر</p><div class="xo-wrap">`;
  if(!G.length)h+='<p class="pc-empty">لا توجد أوامر منشورة الآن.</p>';
  G.forEach(g=>{
    h+=`<div class="xo-g"><div class="xo-h"><b>${E(g.sym.split('-')[0])} · ${g.bot?E(g.type):'⚠️ خارج البوتات (يدوي أو بوت آخر)'}${g.bot&&g.name?` <small>(${E(g.name)})</small>`:''}</b>`
      +`<small>${g.wallet?'👛 '+E(g.wallet)+' · ':''}<span class="xo-s">${g.ns}↑ ${N(g.usd_s,2)}$</span> · <span class="xo-b">${g.nb}↓ ${N(g.usd_b,2)}$</span></small></div>`
      +`<table class="xo-t"><tr><th>الجهة</th><th>السعر</th><th>الكمية</th><th>القيمة $</th><th>منذ</th></tr>`
      +g.orders.map(o=>`<tr><td class="${o.side==='sell'?'xo-s':'xo-b'}">${o.side==='sell'?'🔴 بيع':'🟢 شراء'}</td><td dir="ltr">${N(o.px)}</td>`
        +`<td dir="ltr">${N(o.sz,6).replace(/\.?0+$/,'')}${(+o.fill||0)>0?` <small>(نُفّذ ${N(o.fill,6).replace(/\.?0+$/,'')})</small>`:''}</td><td dir="ltr">${N(o.usd,2)}</td><td>${age(o.t)}</td></tr>`).join('')
      +`</table></div>`});
  h+=`</div><div class="mbtns"><button class="primary" onclick="exOrdOpen(1)">🔄 تحديث من OKX</button><button onclick="hideModal()">إغلاق</button></div>`;
  showModal(h)}

/* ── النوافذ ── */
/* 🪟 v3.36.34 (المالك 13-11): نمط واحد لكل النوافذ — كاملة الشاشة (بالحاسوب لوحة كبيرة مثل «الاختبار التجريبي») · ✕ بنفس الزاوية ·
   التأكيدات وشبهها بحجمها بالشكل الجديد (showDialog) · حركة الفتح من ⚙️ والإغلاق بعكسها · زر الرجوع يسكّر الأعلى أولاً (بالتطبيق وبالمتصفح) ·
   نافذة جديدة بـshowModal / showDialog تاخذ كل هذا وحدها */
const HW_ANIMS=[['none','بلا حركة'],['up','انزلاق من الأسفل'],['zoom','تكبير ناعم'],['side','انزلاق جانبي'],['btn','تتوسّع من الزر'],['blur','تلاشٍ مع ضبابية'],['spring','ارتداد خفيف']];
const HW_MS={up:240,zoom:200,side:230,btn:300,blur:230,spring:340};   // 🎬 v3.36.36: أسرع (كانت 320 · 260 · 300 · 420 · 300 · 440)
const HW={st:[],pt:null,skip:0,popping:0,pend:0,q:[]};   // ↩️ v3.36.35: pend = رجوعات هذه الخطوة · q = نوافذ تنتظر وصول رجوعنا
function uiAnim(){const v=_ls('dash_anim');return HW_ANIMS.some(x=>x[0]===v)?v:'zoom'}
function setAnim(v){if(!HW_ANIMS.some(x=>x[0]===v))v='zoom';_ls('dash_anim',v==='zoom'?null:v);const n=(HW_ANIMS.find(x=>x[0]===v)||[])[1]||'';
  hideModal();setTimeout(()=>{openSettings();toast('🎬 حركة النوافذ: '+n,true)},v==='none'?0:Math.round((HW_MS[v]||0)*.6)+80)}   // تنفتح من جديد ⇒ تشوف الحركة
function hwStyle(){try{if(document.documentElement.classList.contains('lite'))return 'none';
  if(hwDevRm()&&!hwForce())return 'none'}catch(e){}return uiAnim()}
function hwDevRm(){try{return !!(window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches)}catch(e){return false}}   // 🎬 v3.36.38
function hwForce(){return _ls('dash_motion_force')==='on'}            // شغّل الحركة رغم «تقليل الحركة» بالجهاز (لهذا الجهاز)
function setMotionForce(on){_ls('dash_motion_force',on?'on':null);try{hbgApply()}catch(e){}openSettings();
  toast(on?'🎬 الحركة تعمل رغم إعداد الجهاز':'🎬 اللوحة تتبع إعداد الجهاز (تقليل الحركة)',true)}
/* 🎬 v3.36.40 (المالك 13-11: «الخلفية المتحركة ما تشغل على الحاسوب وكلك حركة البطاقات»): الحاسوب مضبوط على «تقليل الحركة» ⇒ يسأل مرة —
   لما يختار خلفية متحركة (مرة بالجلسة) · أو تنفتح اللوحة وعنده خلفية متحركة مختارة (مرة لهذا الجهاز) · الجواب ينحفظ لهذا الجهاز */
function rmStop(){return hwDevRm()&&!hwForce()&&!uiLite()}
function rmRow(){return rmStop()?`<div class="snote" style="color:var(--amber)">⚠️ الحركة متوقفة: هذا الجهاز مضبوط على «تقليل الحركة».</div><div class="pollrow" style="margin-bottom:8px"><button type="button" class="rmGo" onclick="setMotionForce(true)">▶️ شغّل الحركة رغم إعداد الجهاز</button></div>`:''}
function rmAsk(back){if(!rmStop())return;_ls('dash_rm_seen','1');
