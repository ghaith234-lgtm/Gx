def _app_go(text, title):
    """وين يفتح الإشعار لما تضغطه: كرت البوت · المُراكِم · الرقابة · التقارير · اللوحة."""
    syms = re.findall(r"`([A-Z0-9]{2,15}-[A-Z]{2,10})`", text)
    if any(w in title for w in ("الرقابة", "رقابة", "الحارس")):
        return "guard"
    if any(w in title for w in ("المُراكِم", "المراكم", "المجمّع", "المتراكم", "تسوية شراء")):
        m = re.search(r"`([^`]{1,60})`", (str(text).splitlines() or [""])[0])      # الاسم بين `` بسطر العنوان الأصلي
        return "acc:" + (m.group(1) if m else "")
    if any(w in title for w in ("تقرير", "ملخص")):
        return "reports"
    if syms:
        dirs = [os.path.relpath(b["dir"], ROOT) for b in bot_dirs().values() if b.get("symbol") == syms[0]]
        return ("bot:" + dirs[0]) if len(dirs) == 1 else ("sym:" + syms[0])
    return ""


def _app_short(text):
    """إشعار تيليغرام ⇒ نسخة مختصرة للموبايل: عنوان + سطر · نوعه (صفقة/تنبيه/معلومة) · ربحه بالدولار (للتجميع) · وين يفتح."""
    def clean(s):
        s = re.sub(r"<[^>]+>", "", str(s))
        return re.sub(r"\s+", " ", s.replace("*", "").replace("`", "").replace("_", " ")).strip()
    lines = [l for l in str(text).splitlines() if l.strip() and not set(l.strip()) <= set("━─-=_ ")]
    title = clean(lines[0])[:90] if lines else "Holy"
    rest = [clean(l) for l in lines[1:]]
    usd = None
    pick = [l for l in rest if re.search(r"ربح الصفقة|ربح الدورة|^الصفقة", l)]
    if pick:
        m = re.search(r"([+-]?\d+(?:\.\d+)?)\s*(?:\$|USDT)", pick[0])
        if m:
            usd = round(float(m.group(1)), 6)
    tot = [l for l in rest if "الإجمالي" in l and l not in pick[:1]]          # صفقة ⇒ ربحها + الإجمالي
    body = " · ".join((pick[:1] + tot[:1]) if pick and tot else (pick[:1] + [l for l in rest if l not in pick[:1]])[:2])[:150]
    if re.search(r"[🚨⚠🛑❌🔌]|فشل|أوقف|طاح|ما اشترى|ما تكدر|خطر", title):
        kind = "alert"
    elif usd is not None or re.search(r"ربح|💰|💎", title):
        kind = "trade"
    else:
        kind = "info"
    return {"k": kind, "t": title, "b": body, "usd": usd, "go": _app_go(str(text), title)}


def app_feed_push(text, go=None, kind=None):
    """📨 كل إشعار تيليغرام (بعد زر الكتم) ينضاف هنا مختصراً — بس لو في جهاز مربوط · نفس النص خلال 3 ساعات ما يتكرر ·
    `go`: وين يفتح لما ينضغط · `kind` (v3.26.7): نوعه بالموبايل («price» ⇒ قناة «📈 إشعارات الأسعار» بنغمة Holy · التطبيق القديم يعتبره «معلومات»)."""
    with _APPD_LOCK:
        _appd_load()
        if not _APPD["devs"]:
            return False
    it = _app_short(text)
    if go:
        it["go"] = go
    if kind:
        it["k"] = kind
    hk = _hl.sha256(str(text).encode("utf-8", "replace")).hexdigest()[:20]
    with _APPF_COND:
        _appf_load()
        now = time.time()
        seen = _APPF["seen"]
        if now - seen.get(hk, 0) < 3 * 3600:
            return False
        seen[hk] = now
        if len(seen) > 600:
            for k in sorted(seen, key=seen.get)[:300]:
                seen.pop(k, None)
        _APPF["last"] += 1
        it.update(id=_APPF["last"], ts=int(now))
        _APPF["items"].append(it)
        del _APPF["items"][:-APP_FEED_KEEP]
        save_json_atomic(APP_FEED_FILE, {"last": _APPF["last"], "items": _APPF["items"]})
        _APPF_COND.notify_all()
    return True


def app_feed_wait(since, wait):
    """⏳ سحب طويل: الطلب ينتظر لحد ما يجي إشعار جديد (أو تخلص المهلة) — إشعار فوري بلا ما التطبيق يسأل كل ثانية."""
    deadline = time.time() + max(0.0, min(55.0, float(wait)))
    with _APPF_COND:
        _appf_load()
        gen = _APPF["gen"]
        while _APPF["last"] <= since and time.time() < deadline and _APPF["gen"] == gen:      # جهاز انفصل ⇒ الانتظار يخلص فوراً
            _APPF_COND.wait(max(0.05, deadline - time.time()))
        items = [x for x in _APPF["items"] if int(x.get("id") or 0) > since][-50:]
        return _APPF["last"], items


def app_pair(name, iid, code, ip):
    """🔗 ربط جهاز (من داخل اللوحة وإنت داخل): مفتاح عشوائي يرجع للتطبيق مرة وحدة · هنا ينحفظ مُجزّأ (sha256) بس."""
    tok = _sc.token_urlsafe(32)
    did = _sc.token_hex(4)
    with _APPD_LOCK:
        _appd_load()
        iid = str(iid or "")[:64]
        _APPD["devs"] = [d for d in _APPD["devs"] if not (iid and d.get("iid") == iid)]
        _APPD["devs"].append({"id": did, "iid": iid, "name": str(name or "Android")[:60], "h": _hl.sha256(tok.encode()).hexdigest(),
                              "created": int(time.time()), "seen": int(time.time()), "code": int(code or 0), "ip": str(ip)[:45]})
        _APPD["devs"] = _APPD["devs"][-APP_DEV_MAX:]
        _appd_save(True)
    with _APPF_COND:
        _appf_load()
        last = _APPF["last"]
    journal("user", f"{'💻 حاسوب' if iid.startswith('win-') else '📱 جهاز'} انربط بالإشعارات — {str(name or 'Android')[:60]}", "ok")
    return did, tok, last


def app_dev_auth(tok):
    """مفتاح الجهاز ⇒ الجهاز (أو None). يفتح الإشعارات وتنزيل التطبيق فقط."""
    tok = str(tok or "").strip()
    if len(tok) < 20:
        return None
    h = _hl.sha256(tok.encode()).hexdigest()
    with _APPD_LOCK:
        _appd_load()
        for d in _APPD["devs"]:
            if _hm.compare_digest(str(d.get("h")), h):
                d["seen"] = int(time.time())
                _appd_save()
                return d
    return None


_BIO_TRY = {}


def app_bio_set(dev_id, on):
    """🔐 v3.27.0: البصمة تفتح اللوحة بهالموبايل بدل كلمة السر — يتفعّل بس وإنت داخل بكلمة السر (كلمة السر تبقى الأصل ولباقي الأجهزة) ·
    مفتاح عشوائي يرجع للتطبيق مرة وحدة ويبقى بالموبايل · هنا بصمته (sha256) بس · ولا ينكتب بالسجلات ولا بالتقرير"""
    sec = _sc.token_urlsafe(32) if on else ""
    with _APPD_LOCK:
        _appd_load()
        d = next((x for x in _APPD["devs"] if x.get("id") == dev_id), None)
        if d is None:
            return None
        had = bool(d.get("bio_h"))
        if on:
            d["bio_h"], d["bio_on"] = _hl.sha256(sec.encode()).hexdigest(), int(time.time())
        else:
            d.pop("bio_h", None)
            d.pop("bio_on", None)
        name = str(d.get("name") or "")[:60]
        _appd_save(True)
    if on:
        journal("user", f"🔐 البصمة صارت تفتح اللوحة بـ{name} (كلمة السر تبقى للمتصفح وباقي الأجهزة)", "ok")
    elif had:
        journal("user", f"🔓 البصمة ما عادت تفتح اللوحة بـ{name}", "ok")
    return sec


def app_bio_reset_all():
    """🔐 كلمة السر تغيّرت أو انشالت ⇒ كل موبايل يرجع يربط بصمته من جديد (أول ما تدخل بكلمة السر الجديدة)"""
    n = 0
    with _APPD_LOCK:
        _appd_load()
        for d in _APPD["devs"]:
            if d.pop("bio_h", None):
                d.pop("bio_on", None)
                n += 1
        if n:
            _appd_save(True)
    return n


def app_bio_check(tok, sec):
    """🔐 مفتاح الجهاز + مفتاح البصمة ⇒ الجهاز (أو None)"""
    sec = str(sec or "").strip()
    dev = app_dev_auth(tok)
    if dev is None or len(sec) < 20 or not dev.get("bio_h"):
        return None
    return dev if _hm.compare_digest(str(dev["bio_h"]), _hl.sha256(sec.encode()).hexdigest()) else None


def app_unpair(did):
    with _APPD_LOCK:
        _appd_load()
        n0 = len(_APPD["devs"])
        gone = [d.get("name") for d in _APPD["devs"] if d.get("id") == did]
        _APPD["devs"] = [d for d in _APPD["devs"] if d.get("id") != did]
        if len(_APPD["devs"]) != n0:
            _appd_save(True)
    if gone:
        with _APPF_COND:                    # الطلب اللي ينتظر يرجع هسه ⇒ الطلب الجاي بالمفتاح الملغي ياخذ 401 (الموبايل يقول «انفصل» فوراً)
            _APPF["gen"] += 1
            _APPF_COND.notify_all()
        journal("user", f"📱 جهاز انفصل عن الإشعارات — {gone[0]}", "ok")
    return bool(gone)


def app_apk():
    """التطبيق المدمج بهذي النسخة من اللوحة (APK موقّع) + معلوماته — للتنزيل والتحديث الذاتي."""
    c = _APK_CACHE
    if not c:
        try:
            raw = _b64s.b64decode(APP_APK_B64)
        except Exception:
            raw = b""
        c.update(raw=raw, sha256=_hl.sha256(raw).hexdigest() if raw else "", size=len(raw))
    return c


