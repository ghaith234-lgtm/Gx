        except Exception:
            pass
        out.append(str(h.get("msg") or ""))
    return out


def _gd_trade_scan(g, now, snaps=None):
    """📡 **مراقبة التداول** لكل بوت شبكة — كل جولة رقابة، من نفس بيانات المنصة (بلا طلبات زايدة):
    ١ حجم كل أمر منشور بالدفتر = حجمه بالمنصة · ٢ مطالبات البيع (منشور + ذاكرة + مخزن) ≤ رصيد العملة الكلي ·
    ٣ سطور التحذير بسجل البوت (آخر 24 ساعة) · ٤ أوامر إعادة الاستثمار تنتظر التصغير من زمان · ٥ ميزان التدقيق المالي.
    كل مشكلة ⇒ حدث بالرقابة (ويوصل تيليغرام) — ويتسكّر وحده لما تنحل."""
    by_w = {str(s.get("wid")): s for s in (snaps or []) if isinstance(s, dict) and not s.get("fatal")}
    rows, live, claims, over = [], set(), {}, []
    for b in bot_dirs().values():
        cfg = b.get("cfg") or {}
        if cfg.get("is_demo"):
            continue
        try:
            sp, hp, _lp = paths_of(b)
            st = load_json(sp) or {}
        except Exception:
            continue
        if not isinstance(st, dict) or not any(k in st for k in ("limit_buys", "limit_sells", "virtual_sells")):
            continue                                            # بوت مو شبكة (DCA) — له فحوصه
        name = os.path.basename(str(b.get("dir") or "").rstrip("/\\\\")) or str(b.get("symbol") or "bot")
        sym = str(cfg.get("symbol") or b.get("symbol") or "")
        coin = sym.split("-")[0]
        wid = _gd_wid(cfg.get("api_key"))
        snap = by_w.get(wid) or {}
        row = {"bot": name, "sym": sym, "wid": wid, "live": 0, "mism": [], "warn": {}, "uw_old": 0, "claims": 0.0}
        pend = snap.get("pending") or {} if snap.get("ok_pend") else None
        for dn in ("limit_buys", "limit_sells"):
            for oid, v in (st.get(dn) or {}).items():
                if not isinstance(v, dict):
                    continue
                row["live"] += 1
                if pend is not None and str(oid) in pend:
                    q_b, q_x = float(v.get("locked_qty") or 0), float(pend[str(oid)].get("sz") or 0)
                    if abs(q_b - q_x) > max(5e-7, q_b * 1e-9):
                        # 📏 يُسجَّل للتشخيص بس — نموذج التدفق بالرقابة يفرّق المشروع (مُراكِم بالطريق · حركة المالك) من الخطأ وينبّه بسياقه
                        row["mism"].append({"oid": str(oid), "px": v.get("target_price"), "book": q_b, "okx": q_x})
        cl = sum(float((v or {}).get("locked_qty") or 0) for dn in ("limit_sells", "virtual_sells", "accum_sells")
                 for v in (st.get(dn) or {}).values() if isinstance(v, dict))
        row["claims"] = round(cl, 8)
        c = claims.setdefault((wid, coin), [0.0, []]); c[0] += cl; c[1].append(name)
        msgs = _safe(_gd_hist_recent, hp, default=[]) or []
        for tag, sev, what in _GD_TR_WARN:
            n = sum(1 for m in msgs if tag in m)
            if n:
                row["warn"][what] = n
                k = f"tr:{name}:warn:{what}"
                ex = next((m for m in msgs if tag in m), "")
                _gd_event(g, k, sev, f"⚠️ {what} — {sym}", f"{name} · {n} مرة بآخر 24 ساعة · آخرها: {ex[:260]}",
                          wid=wid, sym=sym, kind="trade")
                live.add(k)
        uw = ((st.get("reinvest") or {}).get("unwind") or {}) if isinstance(st.get("reinvest"), dict) else {}
        old = [kk for kk, e in uw.items() if isinstance(e, dict) and now - float(e.get("ts") or now) > 6 * 3600]
        if old:
            row["uw_old"] = len(old)
            k = f"tr:{name}:uw"
            _gd_event(g, k, "🟡", f"⏳ أوامر إعادة استثمار تنتظر التصغير من +6 ساعات — {sym}",
                      f"{name} · {len(old)} أمر (البوت يعيد المحاولة كل دورة أو ينتظر تنفيذه)", wid=wid, sym=sym, kind="trade")
            live.add(k)
        rows.append(row)
    for (wid, coin), (cl, names) in claims.items():
        snap = by_w.get(wid) or {}
        if not snap.get("ok_bal") or cl <= 0:
            continue
        cash = float(((snap.get("bal") or {}).get(coin) or {}).get("cash") or 0)
        if cl > cash + max(1e-6, cl * 1e-6):
            # 🪙 يُسجَّل للتشخيص بس — «المالك سحب عملة يحتاجها البوت» ينبّه عليه نموذج التدفق بالرقابة بسياقه
            over.append({"wid": wid, "coin": coin, "claims": round(cl, 8), "cash": round(cash, 8), "bots": names})
    aud = _safe(money_audit, default={}) or {}
    # 💰 ميزان المال بس — طابور التسليم للمُراكِم (عملة «بالطريق») يتابعه فحص إعادة الاستثمار بمهلته، فما نكرّره هنا
    bad = [c for c in (aud.get("checks") or []) if isinstance(c, dict) and not c.get("ok")
           and not any(t in str(c.get("check") or "") for t in ("تسليم", "المُراكِم", "مراكم"))]
    if bad:
        _gd_event(g, "tr:audit", "🔴", f"💰 التدقيق المالي: {len(bad)} فحص ما مطابق",
                  " · ".join(f"{c.get('check')}: {str(c.get('detail'))[:120]}" for c in bad[:3]), kind="trade")
        live.add("tr:audit")
    for e in g.get("events") or []:
        kk = str(e.get("key") or "")
        if kk.startswith("tr:") and e.get("status") == "open" and kk not in live:
            e["status"], e["resolved"] = "resolved", now
    g["trade"] = {"ts": now, "rows": rows, "claims_over": over, "audit": (aud.get("summary") or {})}
    return rows

GUARD_REC_GRACE = 900      # 🔁 حدث أحدث من 15 دقيقة ممكن الدفاتر ما لحقته بعد (تنقيّد كل دقيقة) ⇒ ما ينحسب ناقص
GUARD_REC_PEND = 600       # 🔒 أمر محفوظ بلا تأكيد المنصة أكثر من 10 دقائق ⇒ تنبيه


def _gd_rec_scan(g, now, snaps=None):
    """🔁 v3.25.2: فحص **كل بوت دوري** بكل جولة رقابة — قراءة فقط (ولا أمر ينحط ولا ينلغى ولا ملف بوت ينكتب):
    ١ 🧮 الحسابات: الربح = المحرر + المعاد استثماره · المعاد استثماره = داخل البوت + انسحب
    ٢ 📒 الدفاتر: كل صفقة وكل سحب انقيّد بالدفتر اليومي ودفتر العملات (ولا حدث ضاع)
    ٣ 🔒 ولا أمر محفوظ ينتظر تأكيد المنصة من زمان · ٤ ⏰ الموعد ما فات وهو شغّال · ٥ 🛡️ المستثمر ≤ حد الأمان
    ٦ 💰 المحفظة بيها اللي تحتاجه الأوامر المفتوحة (الشرائي: عملتها · البيعي: دولار يرجع يشتري) — بقراءتين حتى ما يغلط بنص تنفيذ
    ٧ 📡 ولا أمر للبوت قاعد بالمنصة (أوامره كلها فورية) · ٨ 💸 نسبة العمولة المتعلّمة معقولة
    كل مشكلة ⇒ حدث بالرقابة (تيليغرام + السجلات مرة وحدة) ويتسكّر وحده لما تنحل (وينكتب بالسجلات إنه انحل)."""
    by_w = {str(s.get("wid")): s for s in (snaps or []) if isinstance(s, dict) and not s.get("fatal")}
    led = load_json(LEDGER) or {}
    cl = load_json(COIN_LEDGER) or {}
    cseen = set((cl.get("seen") or []) if isinstance(cl, dict) else [])
    R = g.setdefault("rec", {})
    prev_cov, prev_bad = R.get("cov") or {}, R.get("bad") or {}
    rows, live, bad = [], set(), {}
    for b in bot_dirs().values():
        cfg = b.get("cfg") or {}
        if not _is_rec(b) or cfg.get("is_demo"):
            continue
        try:
            sp, hp, _lp = paths_of(b)
            st = load_json(sp) or {}
        except Exception:
            continue
        if not isinstance(st, dict) or not st:
            continue                                            # لسه ما اشتغل
        key = os.path.relpath(b["dir"], ROOT)
        sym = str(b.get("symbol") or cfg.get("symbol") or "")
        base, quote = (sym.split("-") + ["USDT"])[:2]
        sell = cfg.get("bot_type") == "rec_sell"
        wid = _gd_wid(cfg.get("api_key")) if str(cfg.get("api_key") or "").strip() else ""
        alive = bool(_safe(is_alive, b["dir"], sp, default=(False,))[0])
        u = f" {base}" if sell else "$"
        F = lambda k: float(st.get(k) or 0)
        checks = []

        def ev(tag, sev, title, detail, ok_):
            k = f"rec:{key}:{tag}"
            checks.append({"k": tag, "ok": bool(ok_), "t": title, "d": detail})
            if not ok_:
                _gd_event(g, k, sev, f"{title} — {sym}", f"🔁 {key} · {detail}", wid=wid, sym=sym, kind="rec")
                live.add(k)
        # ١ الحسابات
        pt, rel, rt, held = F("profit_total"), F("rel_total"), F("ri_total"), _rec_held(st)
        wd = F("wd_coin") + F("wd_lot_q") if sell else F("wd_usd") + F("wd_lot_val")
        g1 = pt - rel - rt
        g2 = rt - held - wd
        ev("math", "🔴", "🧮 حسابات البوت الدوري ما تتطابق", f"الربح {pt:.8g}{u} = المحرر {rel:.8g} + المعاد استثماره {rt:.8g} (فرق {g1:+.2e}) · "
           f"المعاد استثماره {rt:.8g} = داخل البوت {held:.8g} + انسحب {wd:.8g} (فرق {g2:+.2e})",
           abs(g1) <= 1e-6 + 1e-6 * abs(pt) and abs(g2) <= 1e-6 + 1e-6 * abs(rt))
        # ٢ الدفاتر — كل حدث بالبوت لازم ينقيّد (الأحدث من 15 دقيقة ينتظر)
        ent = led.get(key) if isinstance(led.get(key), dict) else {}
        rs = set(ent.get("rec_seen") or [])
        old = lambda x: now - float(x.get("ts") or now) > GUARD_REC_GRACE
        m_led = [c for c in (st.get("cycles_log") or []) if not sell and isinstance(c, dict) and c.get("id") and old(c) and "c:" + str(c["id"]) not in rs]
        m_led += [r for r in (st.get("releases") or []) if isinstance(r, dict) and r.get("id") and float(r.get("usd") or 0) > 1e-12 and old(r)
                  and "w:" + str(r["id"]) not in rs]
        m_coin = [e for e in (_safe(_rec_coin_events, b, st, default=[]) or []) if now - float(e[2] or now) > GUARD_REC_GRACE and f"{key}|{e[0]}" not in cseen]
        ev("book", "🟠", "📒 حدث للبوت الدوري ما انقيّد بالدفاتر",
           f"{len(m_led)} بالدفتر اليومي · {len(m_coin)} بدفتر العملات (أقدم من 15 دقيقة) — اللوحة تقيّدها كل دقيقة", not m_led and not m_coin)
        # ٣ أمر محفوظ بلا تأكيد · ٤ الموعد · ٥ الحد · ٧ أوامر قاعدة بالمنصة · ٨ العمولة
        pd = st.get("pending") if isinstance(st.get("pending"), dict) else None
        pend_age = now - float((pd or {}).get("ts") or now) if pd else 0.0
        ev("pend", "🟠", "🔒 أمر البوت الدوري ينتظر تأكيد المنصة من زمان",
           f"{(pd or {}).get('label') or (pd or {}).get('kind') or 'أمر'} من {pend_age / 60:.0f} دقيقة"
           + (" · رقمه بالمنصة معروف وما انحسم" if (pd or {}).get("oid") else " · الرد ضاع — البوت يسأل المنصة برقمه ولا يعيده")
           + ("" if alive else " · ⚠️ البوت مطفي — شغّله حتى يحسمه"), not pd or pend_age <= GUARD_REC_PEND)
        nx = F("next_at")
        unit = {"h": 3600, "d": 86400, "m": 30 * 86400}.get(cfg.get("unit") or "d", 86400)
        late = now - nx if nx > 0 else 0.0
        ev("sched", "🟠", "⏰ موعد البوت الدوري فات وما انفّذ", f"الموعد {datetime.fromtimestamp(nx).strftime('%Y-%m-%d %H:%M') if nx else '—'} فات من {late / 60:.0f} دقيقة والبوت شغّال",
           not (alive and not st.get("paused") and nx > 0 and late > max(1800.0, unit * 0.5)))
        usd_amt = (not sell) or bool(cfg.get("amt_usd"))
        lots = [l for l in (st.get("lots") or []) if isinstance(l, dict)]
        expo = sum(float(l.get("c" if usd_amt else "q") or 0) for l in lots)
        cap = float(cfg.get("cap") or 0)
        ue = "$" if usd_amt else f" {base}"
        ev("cap", "🟠", "🛡️ البوت الدوري عبر حد الأمان", f"المستثمر {expo:.6g}{ue} من حد {cap:g}{ue}", not (cap > 0 and expo > cap * (1 + 1e-6) + 1e-9))
        snap = by_w.get(wid) or {}
        bid = str(cfg.get("bot_id") or "")
        stray = [o for o in ((snap.get("pending") or {}).values() if snap.get("ok_pend") else []) if bid and str(o.get("cl") or "").startswith(bid)]
        ev("stray", "🟠", "📡 أمر للبوت الدوري قاعد بالمنصة", f"{len(stray)} أمر معلّق برقم البوت — أوامره كلها فورية، المفروض ولا واحد يبقى (شوفه بالمنصة)",
           not stray)
        fr = F("fee_rate")
        ev("fee", "🟡", "💸 نسبة عمولة غريبة بالبوت الدوري", f"المتعلّمة من التنفيذ {fr * 100:.4f}% (المعتاد 0.05%–0.2%)", not (fr > 0.005))
        # ٩ 🚫 v3.25.5: الخروج بالهدف انرفض لأن الرصيد ما يكفي (بوت ثاني صرف العملة/الدولار أو بيع/سحب يدوي) — من سجل البوت
        xf = 0.0
        for e_ in (_safe(load_json, hp, default=[]) or [])[:80]:
            try:
                m_ = str(e_.get("msg") or "")
                if _GD_RX_REC_CLOSE.search(m_):
                    break                                       # خروج نجح بعده ⇒ انحل
                if m_.startswith("❌") and "بالمحفظة للخروج" in m_:
                    xf = time.mktime(time.strptime(str(e_.get("time")), "%Y-%m-%d %H:%M:%S"))
                    break
            except Exception:
                continue
        ev("xfail", "🔴", "🚫 البوت الدوري ما گدر يطلع بالهدف — الرصيد ما يكفي",
           f"آخر رفض قبل {max(0.0, now - xf) / 60:.0f} دقيقة — المحفظة ما بيها {'الدولار' if sell else 'العملة'} اللي يحتاجه الخروج"
           " (بوت ثاني على نفس العملة صرفها، أو بيع/سحب يدوي) · البوت يعيد يحاول كل دقيقة · شوف «🤝 الرصيد الحر» بالرقابة",
           not (xf and now - xf <= 1200))
        nbad = [c for c in checks if not c["ok"]]
        bad[key] = [c["k"] for c in nbad]
        rows.append({"bot": key, "sym": sym, "side": "sell" if sell else "buy", "alive": alive, "paused": bool(st.get("paused")), "wid": wid, "ccy": quote if sell else base,
                     "lots": len(lots), "expo": round(expo, 8), "cap": cap, "unit": ue.strip(), "profit": round(pt, 10), "rel": round(rel, 10),
                     "ri": round(rt, 10), "held": round(held, 10), "pend": round(pend_age) if pd else 0, "next_at": nx,
                     "checks": checks, "ok": not nbad})
    cov = {}                                              # ٦ 🤝 v3.25.5: التغطية صارت بـ`_gd_cover_scan` (كل بوتات المحفظة على الرصيد الحر)
    for e in g.get("events") or []:
        kk = str(e.get("key") or "")
        if kk.startswith("rec:") and e.get("status") == "open" and kk not in live:
            e["status"], e["resolved"] = "resolved", now
            _safe(journal, "guard", f"🛡️✅ انحلّت: {e.get('title')}", "ok", kind="rec", default=None)
    # 📜 بالسجلات: كل بوت تغيّرت حالته (صار بيه مشكلة / رجع سليم) · ومرة باليوم ملخص الفحص
    for r in rows:
        was, now_b = prev_bad.get(r["bot"]), bad.get(r["bot"]) or []
        if was is not None and bool(was) != bool(now_b):
            _safe(journal, "guard", f"🛡️🔁 {r['sym']} ({r['bot']}): " + ("✅ كل فحوص البوت الدوري سليمة هسه" if not now_b else
                  "⚠️ " + " · ".join(c["t"] for c in r["checks"] if not c["ok"])), "ok" if not now_b else "warn", kind="rec", bot=r["bot"], default=None)
    dk = datetime.now().strftime("%Y-%m-%d")
    if rows and R.get("jday") != dk:
        R["jday"] = dk
        nb = sum(1 for r in rows if not r["ok"])
        _safe(journal, "guard", f"🛡️🔁 فحص البوتات الدورية: {len(rows)} بوت · " + ("✅ كل الحسابات والدفاتر والأوامر مطابقة" if not nb else f"⚠️ {nb} بيه مشكلة (شوف 🛡️ الرقابة)"),
              "ok" if not nb else "warn", kind="rec", default=None)
    R.update(ts=now, rows=rows, cov=cov, bad=bad)
    return rows


GUARD_COVER_TOL = 1e-4        # 🤝 0.01% تسامح تقريب


def _gd_cover_scan(g, now, snaps=None):
    """🤝 v3.25.5: تغطية العملة المشتركة — لكل محفظة × عملة: اللي تحتاجه البوتات **حر** بالمحفظة (أوامر الدوري المفتوحة ·
    عملات المُراكِم · اللي ماسكه DCA بدورته · بيعات الشبكة الافتراضية/المخزّنة) ≤ الرصيد الحر (availBal — مو المجموع).
    أقل ⇒ بوت ثاني على نفس العملة (بأمر حي حجزها أو باعها) أو بيع/سحب يدوي صرف عملة محجوزة ⇒ البيع/الرجوع بالهدف يتأخر.
    قراءتين ورا بعض (تنفيذ بنص الفحص يبيّن نقص لحظي). يشتغل للعملات اللي معادلة الرقابة مطفية عليها (عليها DCA أو دوري) —
    ويضم الشبكة والمُراكِم على نفس العملة (قبل: انطفوا ويّاها). قراءة بس."""
    C = g.setdefault("cover", {})
    prev = C.get("n") or {}
    n_new, live, rows = {}, set(), []
    for snap in snaps or []:
        if not isinstance(snap, dict) or snap.get("fatal"):
            continue
        wid = str(snap.get("wid") or "")
        lab = snap.get("label") or wid
        coins = snap.get("coins") or {}
        for ccy, x in (snap.get("free") or {}).items():
            mode = (coins.get(ccy) or {}).get("mode")
            if not (x.get("strict") or mode in ("dca", "mixed")):
                continue                                         # الشبكة/المُراكِم وحدهم: معادلة الرقابة تكفي
            k = f"cov:{wid}:{ccy}"
            if x.get("skip") or not snap.get("ok_bal"):
                if k in prev:
                    n_new[k] = prev[k]; live.add(k)
                continue
            need = float(x.get("amt") or 0)
            av = float(((snap.get("bal") or {}).get(ccy) or {}).get("avail") or 0)
            short = need - av
            who = " · ".join(f"{nm} {a_:.8g}" for nm, a_, _k in (x.get("who") or []))
            row = {"wid": wid, "label": lab, "ccy": ccy, "need": round(need, 10), "free": round(av, 10), "who": x.get("who") or [], "ok": True, "wait": False}
            if short > max(1e-8, need * GUARD_COVER_TOL):
                n = int(prev.get(k) or 0) + 1
                n_new[k] = n
                if n >= 2:
                    row["ok"] = False
                    _gd_event(g, k, "🔴", f"🤝 عملة محجوزة للبوتات انصرفت — {ccy}",
                              f"{lab}: البوتات تحتاج {need:.8g} {ccy} **حرّة** بالمحفظة وموجود حر {av:.8g} (ناقص {short:.8g}) — بوت ثاني على نفس العملة"
                              f" أو بيع/سحب يدوي صرفها ⇒ البيع أو الرجوع بالهدف يتأخر لحد ما يرجع الرصيد · المحتاجين: {who}", wid=wid, sym=ccy, kind="cover")
                    live.add(k)
                else:
                    row["wait"] = True
            rows.append(row)
    for e in g.get("events") or []:
        kk = str(e.get("key") or "")
        if (kk.startswith("cov:") or kk.startswith("rec:cov:")) and e.get("status") == "open" and kk not in live:
            e["status"], e["resolved"] = "resolved", now
            _safe(journal, "guard", f"🛡️✅ انحلّت: {e.get('title')}", "ok", kind="cover", default=None)
    R = g.get("rec") or {}
    for r in R.get("rows") or []:                               # بكرت الدوري بالرقابة: «💰 الرصيد الحر يغطي أوامره»
        cr = next((x for x in rows if x["wid"] == r.get("wid") and x["ccy"] == r.get("ccy")), None)
        if not cr:
            continue
        r["checks"] = [c for c in (r.get("checks") or []) if c.get("k") != "cov"] + [{
            "k": "cov", "ok": cr["ok"], "t": "💰 الرصيد الحر يغطي أوامره (ويّا البوتات الثانية على نفس العملة)",
            "d": f"تحتاج البوتات {cr['need']:.8g} {cr['ccy']} حرة · موجود {cr['free']:.8g}" + (" — ينتظر قراءة ثانية" if cr["wait"] else "")}]
        if not cr["ok"]:
            r["ok"] = False
    C.update(ts=now, n=n_new, rows=rows)
    return rows


def _gd_ri_scan(g, now):
    """🔄 يتابع كل عملة ودولار بعد إطفاء إعادة الاستثمار لحد ما يوصل مكانه:
    تسليمات ما وصلت (وسببها) · أوامر مكبّرة تنتظر التفكيك · درجات ما تنلگى."""
    cfgs = _safe(acc_cfgs, default=[]) or []
    seen = set((_safe(acc_state, default={}) or {}).get("_ri_seen") or [])
    rows, live = [], set()
    for b in bot_dirs().values():
        cfg = b.get("cfg") or {}
        if cfg.get("is_demo"):
            continue
        bst = _safe(load_json, paths_of(b)[0], default={}) or {}
        ri = bst.get("reinvest") if isinstance(bst.get("reinvest"), dict) else None
        if not ri:
            continue
        name = os.path.basename(str(b["dir"]).rstrip("/\\"))
        sym, base = b["symbol"], b["symbol"].split("-")[0]
        _mine, why = _ri_eligible(b, cfgs)
        pend = [{"id": h["id"], "coin": float(h.get("coin") or 0), "avg": float(h.get("avg_px") or 0),
                 "ts": float(h.get("ts") or 0), "reason": str(h.get("why") or ""), "why": why}
                for h in _ri_handoffs_of(bst) if h.get("id") not in seen]
        uws = [{"k": str(k), "side": e.get("side"), "g": float(e.get("grown_qty") or 0),
                "px": float(e.get("px") or 0), "ts": float(e.get("ts") or 0), "miss": int(e.get("miss") or 0)}
               for k, e in (ri.get("unwind") or {}).items() if isinstance(e, dict)]
        if not pend and not uws and not ri.get("handoffs") and not float(ri.get("unwound_usd") or 0) \
                and not _safe(_ri_orphans, b, bst, default=[]):
            continue
        orph = _safe(_ri_orphans, b, bst, default=[]) or []
        rows.append({"bot": name, "sym": sym, "on": bool(ri.get("on")), "pend": pend, "uw": uws, "orphans": orph,
                     "fp_ok": _safe(_file_fp, os.path.join(b["dir"], "reinvest.py"), default="") == REINV_VERSION,
                     "handoff_total": float(ri.get("handoff_total") or 0), "unwound_usd": float(ri.get("unwound_usd") or 0),
                     "cap_coin": float(ri.get("cap_coin_total") or 0), "n_ho": len(ri.get("handoffs") or [])})
        first = g.setdefault("ri_first", {})
        for p in pend:
            k1 = "ri:ho:" + p["id"]
            age = now - float(first.setdefault(p["id"], now))   # ⏱️ من أول ما شافته الرقابة — ما نثق بوقت مكتوب
            if p["why"]:
                _gd_event(g, k1, "🟠", "🪙 عملة محرَّرة تنتظر المُراكِم",
                          f"{sym}: {p['coin']:.8f} {base} @ {p['avg']:.6f}$ ({p['reason']}) — {p['why']}. "
                          f"تنسلّم لحالها بسعرها الأصلي أول ما ينحل السبب.", sym=sym, kind="ri_wait")
                live.add(k1)
            elif age > GUARD_HO_STUCK:
                _gd_event(g, k1, "🔴", "🪙 تسليم عملة للمُراكِم ما وصل",
                          f"{sym}: {p['coin']:.8f} {base} من {int(age / 60)} دقيقة والمُراكِم جاهز — "
                          f"تأكد إن اللوحة شغّالة.", sym=sym, kind="ri_ho")
                live.add(k1)
        for u in uws:
            if u["miss"] >= GUARD_UW_MISS:
                k2 = f"ri:uw:{name}:{u['k']}"
                _gd_event(g, k2, "🟠", "🔓 أمر مكبّر ما ينلگى بالبوت",
                          f"{sym}: الدرجة {u['k']} ({'بيع' if u['side'] == 'sell' else 'شراء'} مكبّر · نمو {u['g']:.6f} "
                          f"≈ {u['g'] * u['px']:.4f}$) اختفت من أوامر البوت — غالباً انلغت من التطبيق. "
                          f"نموّها {'عملة' if u['side'] == 'sell' else 'دولار'} بالمحفظة.", sym=sym, kind="ri_miss")
                live.add(k2)
    for e in g.get("events") or []:
        kk = str(e.get("key") or "")
        if kk.startswith("ri:") and e.get("status") == "open" and kk not in live:
            e["status"], e["resolved"] = "resolved", now
    pend_ids = {p["id"] for r in rows for p in r["pend"]}
    g["ri_first"] = {k: v for k, v in (g.get("ri_first") or {}).items() if k in pend_ids}
    g["ri"] = {"ts": now, "rows": rows}


def _gd_acc_scan(g, now):
    """🪙 يراقب المُراكِم: جولته اليومية · توزيع ربح كل يوم · الأمر المعلّق · الفلوس الواقفة.

    يشتغل بنهاية اليوم ويشتري لحاله، فأي تعثّر ما ينكشف إلا بالمراقبة — ولهذا انحط بالرقابة."""
    cfgs = _safe(acc_cfgs, default=[]) or []
    st = _safe(acc_state, default={}) or {}
    meta = st.get("_meta") or {}
    last_day = str(meta.get("last_run_day") or "")
    last_ts = float(meta.get("last_run_ts") or 0)
    rows, used = [], 0.0
    if not cfgs:
        g.pop("acc", None)
        for e in g.get("events") or []:
            if str(e.get("key", "")).startswith("acc:") and e.get("status") == "open":
                e["status"], e["resolved"] = "resolved", now
        return
    # ⏰ الجولة اليومية تأخرت
    key_run = "acc:run"
    if last_ts and now - last_ts > GUARD_ACC_RUN_H * 3600:
        _gd_event(g, key_run, "🟠", "🪙 جولة المُراكِم تأخرت",
                  f"آخر جولة قبل {int((now - last_ts) / 3600)} ساعة (يوم {last_day}) — المفروض مرة كل يوم بعد نص الليل. "
                  f"تأكد إن اللوحة شغّالة ليلاً.", kind="acc_run")
    else:
        _gd_resolve(g, key_run)
    days7 = [(datetime.now() - timedelta(days=i)).strftime("%Y-%m-%d") for i in range(1, 8)]
    usedw = {}                                    # 👛 v3.22.9: مجموع النسب لكل محفظة (كل محفظة حسابها مستقل)
    try:
        _aw = acc_wallets()
    except Exception:
        _aw = {}
    for a in cfgs:
        aid = str(a.get("id") or "")
        e = st.get(aid) or {}
        sym = str(a.get("symbol") or "")
        base = sym.split("-")[0]
        pct = float(a.get("pct") or 0)
        used += pct
        _w = acc_wid(a)
        usedw[_w] = usedw.get(_w, 0.0) + pct
        en = bool(a.get("enabled", True))
        pool = float(e.get("pool") or 0)
        minb = max(1.0, float(a.get("min_buy") or 0))
        coin = float(e.get("coin") or 0)
        spent = float(e.get("spent") or 0)
        px = float(PX.get(sym) or 0)
        buys = [x for x in (e.get("buys") or []) if isinstance(x, dict)]
        last_buy = max([float(x.get("ts") or 0) for x in buys] or [0])
        inf = e.get("inflight") or {}
        sinf = e.get("sell_inflight") or {}
        miss = []
        for d in days7[:3]:
            if (a.get("start") or "") and d < str(a.get("start")):
                continue
            share = (e.get("days") or {}).get(d)
            prof = float(_safe(day_profit_w, d, _w, default=0.0) or 0)       # 👛 ربح بوتات محفظته بس
            if prof > 0.0005 and pct > 0 and last_day > d and (share is None or float(share) <= 0):
                miss.append(d)
        rows.append({"id": aid, "name": a.get("name") or sym, "sym": sym, "base": base, "pct": pct,
                     "wid": _w, "wlabel": (_aw.get(_w) or {}).get("label") or _w,
                     "enabled": en, "pool": round(pool, 4), "reserve": round(float(e.get("pending") or 0), 4),
                     "coin": round(coin, 8), "spent": round(spent, 4),
                     "avg": round(spent / coin, 8) if coin > 0 else 0,
                     "value": round(coin * px, 4) if px else None,
                     "pl": round(coin * px - spent, 4) if px and coin > 0 else None,
                     "min_buy": minb, "last_buy": last_buy, "n_buys": len(buys),
                     "skip": str(e.get("skip") or ""), "inflight": bool(inf), "sell_inflight": bool(sinf),
                     "miss": miss,
                     "alloc7": round(sum(float((e.get("days") or {}).get(d) or 0) for d in days7), 4),
                     "buy7": round(sum(float(x.get("usd") or 0) for x in buys
                                       if now - float(x.get("ts") or 0) <= 7 * 86400), 4)})
        # 🔴 أمر معلّق: فلوس طلعت والعملة ما انسجّلت بعد
        for tag, box, word in (("buy", inf, "شراء"), ("sell", sinf, "بيع")):
            k = f"acc:{tag}:{aid}"
            ts0 = float((box or {}).get("ts") or 0)
            if box and ts0 and now - ts0 > GUARD_ACC_INFLIGHT:
                _gd_event(g, k, "🔴", f"🪙 أمر {word} للمُراكِم ما انسوّى",
                          f"{a.get('name') or sym}: أمر {word} معلّق من {int((now - ts0) / 60)} دقيقة — "
                          f"اللوحة ما تأكدت من تنفيذه. افتح 🪙 المُراكِم وشوف الحالة قبل أي شراء يدوي.",
                          sym=sym, kind="acc_inflight")
            else:
                _gd_resolve(g, k)
        # 🟠 ربح يوم ما انوزّع
        k = f"acc:alloc:{aid}"
        if miss:
            _gd_event(g, k, "🟠", "🪙 ربح يوم ما انوزّع للمُراكِم",
                      f"{a.get('name') or sym}: أيام فيها ربح وما أخذ نصيبه ({'، '.join(miss)}) — "
                      f"نسبته {pct:.0f}%. راجع تاريخ البداية وحالة اللوحة بتلك الأيام.", sym=sym, kind="acc_alloc")
        else:
            _gd_resolve(g, k)
        # 🟠 فلوس واقفة: فوق الحد الأدنى وما اشترى من يومين
        k = f"acc:pool:{aid}"
        if en and pool >= minb and last_buy and now - last_buy > GUARD_ACC_POOL_H * 3600:
            _gd_event(g, k, "🟠", "🪙 فلوس المُراكِم واقفة",
                      f"{a.get('name') or sym}: {pool:.2f}$ قيد الشراء (الحد الأدنى {minb:.0f}$) وآخر شراء قبل "
                      f"{int((now - last_buy) / 3600)} ساعة." + (f" السبب المسجّل: {e.get('skip')}" if e.get("skip") else ""),
                      sym=sym, kind="acc_pool")
        else:
            _gd_resolve(g, k)
    # 🟠 مجموع النسب فوق 100% — لكل محفظة لحالها (v3.22.9)
    k = "acc:pct"
    over = {w: u for w, u in usedw.items() if u > 100.0001}
    if over:
        _gd_event(g, k, "🟠", "🪙 مجموع نسب المُراكِم فوق 100%",
                  " · ".join(f"{(_aw.get(w) or {}).get('label') or w}: {u:.0f}%" for w, u in over.items()) +
                  " — التوزيع ياخذ أكثر من ربح المحفظة. صحّح النسب.", kind="acc_pct")
    else:
        _gd_resolve(g, k)
    _mx = max(usedw.values()) if usedw else 0.0
    g["acc"] = {"ts": now, "rows": rows, "used_pct": round(_mx, 2),
                "keep_pct": round(max(0.0, 100.0 - _mx), 2),
                "by_wallet": [{"wid": w, "label": (_aw.get(w) or {}).get("label") or w, "used": round(u, 2), "keep": round(max(0.0, 100 - u), 2)}
                              for w, u in usedw.items()], "last_run": last_day,
                "last_run_ts": last_ts, "flow": _safe(flow_days, 7, default=[]) or []}


