    if(a.pl!=null){R.adelta.textContent=(a.pl>=0?'▲ +':'▼ ')+a.pl.toFixed(2)+'$ ('+(a.pl_pct>=0?'+':'')+a.pl_pct+'%)';
      R.adelta.className='delta '+(a.pl>=0?'up':'dn')}
    else{R.adelta.textContent=(a.pool||0)>0?`⏳ ${(a.pool||0).toFixed(2)}$ قيد الشراء`:'لا عملة بعد';R.adelta.className='delta z'}
    R.apill.className='pill '+(a.enabled?'ok':'off');
    R.apill.textContent=a.enabled?'يجمع':'موقوف';
    R.aspent.textContent=(a.spent||0).toFixed(2)+'$';
    R.aavg.textContent=a.avg!=null?fmtQ(a.avg)+'$':'—';
    R.aval.textContent=a.value!=null?a.value.toFixed(2)+'$':'—';
    if(a.pl!=null){R.apl.textContent=(a.pl>=0?'+':'')+a.pl.toFixed(2)+'$ ('+(a.pl_pct>=0?'+':'')+a.pl_pct+'%)';
      R.apl.className='num '+(a.pl>=0?'dcacoin':'dcaloss')}
    else R.apl.textContent='—';
    R.apool.textContent=(a.pool||0).toFixed(2)+'$'+(a.min_buy?' / '+a.min_buy+'$':'');
    R.apool.style.color=(a.pool||0)>0?'var(--cyan)':'';
    R.apend.textContent=(a.pending||0).toFixed(2)+'$'+(a.withdrawn?` (سُحب ${a.withdrawn}$)`:'');
    R.apend.style.color=(a.pending||0)>0?'var(--amber)':'';
    R.awm.textContent=`${fmtQ(a.week_coin)} (${(a.week_usd||0).toFixed(1)}$) · ${fmtQ(a.month_coin)} (${(a.month_usd||0).toFixed(1)}$)`;
    const rng=(a.low||a.high)?`${a.low||'∞'}–${a.high||'∞'}`:'بلا حد';
    R.arng.textContent=`${rng} · ${a.pct}%`;
    R.arng.style.color=a.in_range===false?'var(--amber)':'';
    R.acnt.textContent=`${a.n_buys||0} شراء · ${a.n_sells||0} بيع`;
    if(a.realized){R.areal.textContent=(a.realized>=0?'+':'')+a.realized.toFixed(2)+'$';
      R.areal.className='num '+(a.realized>=0?'dcacoin':'dcaloss')}
    else R.areal.textContent='—';
    // 💰 زر البيع — يعرض الربح قبل التنفيذ
    if((a.coin||0)>0&&a.avg!=null&&a.cp){
      R.asell.style.display='';
      const pl=a.pl||0, up=pl>=0;
      R.asell.disabled=!!a.sell_pending;
      R.asell.style.opacity=a.sell_pending?.5:1;
      R.asell.className='primary';
      R.asell.style.background=up?'linear-gradient(94deg,#22c55e,#16a34a)':'linear-gradient(94deg,#64748b,#475569)';
      R.asell.textContent=a.sell_pending?'⏳ بيع ينتظر التأكيد'
        :`💰 بِع الكل ${up?'(ربح ':'(خسارة '}${pl>=0?'+':''}${pl.toFixed(2)}$ · ${a.pl_pct>=0?'+':''}${a.pl_pct}%)`;
      R.asell.onclick=()=>accSell(a);
    }else R.asell.style.display='none';
    R.alast.textContent=a.last?new Date(a.last.ts*1000).toLocaleString('ar',{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'})+` · ${fmtQ(a.last.qty)}`:'لا شراء بعد';
    if(a.skip){R.askip.style.display='';R.askip.textContent='⚠️ '+a.skip}
    else R.askip.style.display='none';
    // 🛒 زر الشراء اليدوي — يعمل على المتراكم فقط (التلقائي له قيد الشراء)
    const pend=a.pending||0, pool=a.pool||0, minb=a.min_buy||0, out=(a.in_range===false);
    R.abuy.onclick=()=>accBuyNow(a);
    R.aedit.onclick=()=>accEdit(a);
    R.apause.onclick=()=>accToggleCard(a);
    R.adel.onclick=()=>accDel(a.id);
    R.apause.textContent=a.enabled?'⏸ إيقاف الشراء':'▶ استئناف';
    R.apause.style.color=a.enabled?'':'var(--green)';
    if(pend<1){
      R.abuy.disabled=true; R.abuy.style.opacity=.4; R.abuy.className='';
      R.abuy.textContent=pool>0?`⏳ ${pool.toFixed(2)}$ قيد الشراء التلقائي`:'🛒 لا رصيد بالمتراكم';
      R.abuy.style.background=''; R.abuy.style.animation='';
    }else{
      R.abuy.disabled=false; R.abuy.style.opacity=1;
      // ⚡ حالة التحضير: فيه رصيد جاهز لكن الشراء الآلي موقوف (خارج النطاق / تحت الحد / معطّل)
      const ready = out || pend<minb || !a.enabled;
      // 🏧 المتراكم دائماً تحت تصرّفك — الزر جاهز ونابض
      R.abuy.className='primary';
      R.abuy.style.background='linear-gradient(94deg,#f59e0b,#ef4444)';
      R.abuy.style.animation='apulse 2.2s ease-in-out infinite';
      const why = a.last_move? a.last_move.why : (!a.enabled?'موقوف':out?'خارج النطاق':'محجوز');
      R.abuy.textContent=`⚡ المتراكم ${pend.toFixed(2)}$ — اشترِ الآن (${why})`;
    }
  });
}
function accBuyNow(a){
  const pend=a.pending||0, out=(a.in_range===false), cap=a.max_buy||0;
  const sugg=(cap>0&&cap<pend)?cap:pend;
  showModal(`<h2>🛒 شراء فوري — ${a.name||a.symbol}</h2>
  ${out?`<div style="background:rgb(var(--amber2-rgb)/.12);border:1px solid rgb(var(--amber2-rgb)/.3);border-radius:10px;padding:10px;margin-bottom:10px;font-size:11.5px;color:var(--amber)">
    ⚠️ السعر الآن <b>${a.cp}</b> خارج نطاقك (${a.low||'∞'}–${a.high||'∞'}) — الشراء هنا يتجاوزه</div>`:''}
  ${a.bought_today?`<div style="background:rgb(var(--green2-rgb)/.1);border-radius:10px;padding:8px;margin-bottom:10px;font-size:11px;color:var(--green)">
    ✅ اشترى تلقائياً اليوم — هذا شراء إضافي يدوي</div>`:''}
  <div style="background:var(--card2,#12161f);border:1px solid var(--bd,#232a36);border-radius:10px;padding:11px;margin-bottom:12px;font-size:12px;line-height:2">
    <div>🏧 المتراكم المتاح: <b style="color:var(--amber)">${pend.toFixed(2)}$</b></div>
    ${(a.pool||0)>0?`<div style="font-size:11px;color:var(--mut2)">⏳ وقيد الشراء التلقائي: ${(a.pool||0).toFixed(2)}$ (لا يُمس هنا)</div>`:''}
    ${cap>0?`<div>سقف الشراء الواحد: <b>${cap}$</b></div>`:''}
    <div>السعر الآن: <b style="color:var(--cyan)">${a.cp||'—'}$</b></div>
  </div>
  <div class="frm"><div class="fld"><label>💵 المبلغ (فارغ = الكل)</label>
    <input id="bn_amt" class="num" placeholder="${sugg.toFixed(2)}">
    <small style="color:var(--mut2);font-size:10px">لا يتجاوز المتراكم · الباقي يبقى بالزر</small></div></div>
  <div class="mbtns" style="margin-top:12px">
    ${cap>0&&cap<pend?`<button onclick="doBuyNow('${a.id}',${cap})">بحدود السقف ${cap}$</button>`:''}
    <button class="primary" onclick="doBuyNow('${a.id}',null)">🛒 نفّذ</button>
    <button onclick="hideModal()">إلغاء</button></div>`);
}
function doBuyNow(id,fixed){
  const v=(fixed!=null)?fixed:parseFloat(($('#bn_amt')||{}).value||0);
  askConfirm('🛒 تأكيد الشراء؟', v>0?`شراء بـ <b>${(+v).toFixed(2)}$</b> بسعر السوق.`:'شراء بـ<b>كل المتراكم</b> بسعر السوق.',
    async()=>{const r=await api('/api/accum',{act:'buy_now',id:id,amount:(v>0?v:0)});
      toast(r.msg||'تم',r.ok!==false);hideModal();tick&&tick()});
}
