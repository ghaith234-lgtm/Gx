function dcaChart(rows,s,base){
  const W=600,H=240,pad=46;
  // 📊 المخطط يرسم: نسبة الخروج لكل أمر (gap_pct = كم لازم ينزل السعر للخروج)
  const exitVals=rows.map(r=>r.gap_pct);
  const lo=0,hi=Math.max(...exitVals)*1.15||1;
  const x=i=>pad+(i/(Math.max(1,rows.length-1)))*(W-pad*1.6);
  const y=v=>H-pad-((v-lo)/(hi-lo))*(H-pad*1.7);
  let svg=`<svg viewBox="0 0 ${W} ${H}" style="width:100%;height:auto;background:rgb(var(--ov-rgb)/.02);border-radius:10px">`;

  // خطوط شبكية أفقية (نسب مرجعية)
  const steps=4;
  for(let g=0;g<=steps;g++){
    const v=lo+(hi-lo)*g/steps, gy=y(v);
    svg+=`<line x1="${pad}" y1="${gy}" x2="${W-pad*0.6}" y2="${gy}" stroke="var(--line)" stroke-width="0.5" opacity=".4"/>`;
    svg+=`<text x="${pad-4}" y="${gy+3}" fill="var(--mut2)" font-size="8" text-anchor="end">${v.toFixed(2)}%</text>`;
  }

  // المنطقة المظللة تحت خط نسبة الخروج
  let area='';
  rows.forEach((r,i)=>{area+=(i?'L':'M')+x(i)+' '+y(r.gap_pct)+' ';});
  area+='L'+x(rows.length-1)+' '+(H-pad)+' L'+x(0)+' '+(H-pad)+' Z';
  svg+=`<path d="${area}" fill="var(--cyan)" opacity=".1"/>`;

  // خط نسبة الخروج (سماوي بارز) — الخط البياني الأساسي
  let exitPath='';
  rows.forEach((r,i)=>{exitPath+=(i?'L':'M')+x(i)+' '+y(r.gap_pct)+' ';});
  svg+=`<path d="${exitPath}" fill="none" stroke="var(--cyan)" stroke-width="2.4"/>`;

  // نقاط على الخط مع تمييز أول 4 أوامر (هدف كامل)
  rows.forEach((r,i)=>{
    const px=x(i),py=y(r.gap_pct);
    const col = r.n<=4 ? 'var(--green)' : 'var(--cyan)';
    svg+=`<circle cx="${px}" cy="${py}" r="${r.n===0?4:3.2}" fill="${col}"/>`;
    if(r.n===0||r.n%2===0||r.n===rows.length-1){
      svg+=`<text x="${px}" y="${py-7}" fill="var(--cyan)" font-size="7.5" text-anchor="middle">${r.gap_pct}%</text>`;
    }
    svg+=`<text x="${px}" y="${H-pad+13}" fill="var(--mut2)" font-size="7.5" text-anchor="middle">${r.n===0?'أساس':r.n}</text>`;
  });

  svg+=`<text x="${(W)/2}" y="${H-6}" fill="var(--mut2)" font-size="8.5" text-anchor="middle">رقم الأمر</text>`;
  svg+='</svg>';
  svg+=`<p style="font-size:10.5px;color:var(--mut2);text-align:center;margin-top:6px">🔵 نسبة الخروج لكل أمر (كم % ${s&&s.is_buy?'يصعد':'ينزل'} السعر ليغلق بربح صافي)</p>`;
  return svg;
}
