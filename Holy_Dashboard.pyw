/* ═══ 📈 شريط الأسعار ═══ */
.tape{overflow:hidden;white-space:nowrap;direction:ltr;border-bottom:1px solid var(--line);
  background:linear-gradient(90deg,rgb(var(--cyan-rgb)/.05),rgb(var(--vio-rgb)/.05));padding:5px 0}
