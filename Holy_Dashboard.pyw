def reinvest_tick():
    """💠 أرشيف يومي **لكل بوت**: الحصة العادية · المعاد استثماره · عدد البيعات — ويعيش للأبد.

    🔒 الدمج بالأكبر: سجل صفقات المحرك محدود بـ1000 سطر، فأقدم يوم فيه ينقرا **ناقصاً** كل ما ينزاح.
       النسخة السابقة كانت تكتب الرقم الناقص **فوق** الرقم الكامل ⇒ الأرشيف يخسر ربحاً مع الأيام.
       ربح اليوم بالحقيقة ما ينقص أبداً (البيعة تضيف ولا تشيل) ⇒ الأكبر هو الصحيح دائماً.
    ويبقى المفتاح القديم `daily` (مجموع كل البوتات) للكود القديم — بنفس قاعدة الأكبر."""
    arc = load_json(RI_LEDGER) or {}
    bots_arc = arc.setdefault("bots", {})
    changed = False
    for b in bot_dirs().values():
        c0 = b.get("cfg") or {}
        if c0.get("is_demo") or c0.get("bot_type") in ("dca", "dca_buy"):
            continue
        key = os.path.relpath(b["dir"], ROOT)
        ent = bots_arc.setdefault(key, {"symbol": b["symbol"], "daily": {}})
        if ent.get("symbol") != b["symbol"]:
            ent["symbol"] = b["symbol"]
            changed = True
        dd = ent.setdefault("daily", {})
        for day, v in _hist_day_parts(b, 20).items():
            cur = dd.get(day) or {}
            new = {"n": round(max(float(cur.get("n") or 0), v["n"]), 6),
                   "r": round(max(float(cur.get("r") or 0), v["r"]), 6),
                   "c": max(int(cur.get("c") or 0), int(v["c"]))}
            if new != cur:
                dd[day] = new
                changed = True
        if len(dd) > 800:
            for k in sorted(dd)[:-800]:
                dd.pop(k, None)
            changed = True
    agg = {}
    for ent in bots_arc.values():
        for day, v in (ent.get("daily") or {}).items():
            agg[day] = agg.get(day, 0.0) + float((v or {}).get("r") or 0)
    d = arc.setdefault("daily", {})
    for day, r in agg.items():
        if r > float(d.get(day) or 0) + 1e-9:
            d[day] = round(r, 6)
            changed = True
    if len(d) > 800:                       # أكثر من سنتين — نقصّ الأقدم
        for k in sorted(d)[:-800]:
            d.pop(k, None)
        changed = True
    if changed:
        arc["updated"] = time.time()
        try:
            save_json_atomic(RI_LEDGER, arc)
        except Exception:
            pass
    return arc


# ═══════════════ 🔄 ربح التداول · 💵 الربح المحرر — مصدر واحد للشريط والتقارير ═══════════════
# المصطلحات (v3.11):
#   💵 الربح المحرر      = الدولار اللي طلع من البوتات ربحاً عادياً (السجل اليومي) — يدخل الربح اليومي والمُراكِم
#   🔄 ربح التداول       = كل ربح البيعات = بدون إعادة استثمار + 💠 المعاد استثماره
#   📈 إجمالي التداول    = إجمالي المحرر + 💠 اللي لسه داخل الأوامر + 💠 اللي تسلّمه المُراكِم عملةً
# الفرق بين المحرر و«بدون» = تحرير أرباح إعادة استثمار قديمة (مو ربح تداول جديد — ما ينحسب مرتين)
_TP_WD = ("الاثنين", "الثلاثاء", "الأربعاء", "الخميس", "الجمعة", "السبت", "الأحد")
_HDP_CACHE = {}


def _tp_cnt(n, one, two, few, many):
    """عدد بالعربي الصحيح: بيعة وحدة · بيعتين · 5 بيعات · 12 بيعة."""
    n = int(n)
    if n == 1:
        return one
    if n == 2:
        return two
    return f"{n} {few}" if 3 <= n % 100 <= 10 else f"{n} {many}"


def _tp_wd(day):
    try:
        return _TP_WD[datetime.strptime(day, "%Y-%m-%d").weekday()]
    except Exception:
        return ""


def _tp_md(s):
    """نص متغيّر داخل رسالة Markdown — نهرّب علاماتها حتى ما ترفضها تيليغرام."""
    s = str(s if s is not None else "")
    for ch in ("_", "*", "`", "["):
        s = s.replace(ch, "\\" + ch)
    return s


def _hist_day_parts(b, days=20):
    """📜 من سجل صفقات بوت واحد، لكل يوم: {n: الحصة العادية × المعامل · r: المعاد استثماره · c: البيعات}.

    البيعة المقسومة تكتب سطرين (💠 فيه «% من» + 🔴 للحصة العادية) ⇒ تنعد **مرة وحدة** من سطر 🔴.
    البيعة 100% تكتب 💠 بس ⇒ تنعد منه. والنسبة صفر تكتب 🔴 بس."""
    try:
        _, hp, _ = paths_of(b)
        mt = os.path.getmtime(hp) if os.path.exists(hp) else 0
        nfv = _safe(net_factor, b, default=1.0)
        ck = (hp, mt, int(days), round(float(nfv), 12), datetime.now().strftime("%Y-%m-%d"))
        hit = _HDP_CACHE.get(hp)
        if hit and hit[0] == ck:
            return {k: dict(v) for k, v in hit[1].items()}
        hist = load_json(hp) or []
        cut = (datetime.now() - timedelta(days=days)).strftime("%Y-%m-%d")
    except Exception:
        return {}
    out = {}
    for row in hist if isinstance(hist, list) else []:
        if not isinstance(row, dict):
            continue
        day = str(row.get("time") or "")[:10]
        if len(day) != 10 or day < cut:
            continue
        msg = str(row.get("msg") or "")
        m = _RI_RE_IN.search(msg)
        if m:
            e = out.setdefault(day, {"n": 0.0, "r": 0.0, "c": 0})
            e["r"] += float(m.group(1))
            if "% من" not in msg:
                e["c"] += 1
            continue
        m = _RI_RE_SELL.search(msg)
        if m:
            e = out.setdefault(day, {"n": 0.0, "r": 0.0, "c": 0})
            e["n"] += float(m.group(1)) * nfv
            e["c"] += 1
            continue
        m = _RI_RE_CU.search(msg)                          # ⚡ ربح اللحاق (البيع المجمّع) — كان يطيح من ربح التداول
        if m:
            e = out.setdefault(day, {"n": 0.0, "r": 0.0, "c": 0})
            e["n"] += float(m.group(1)) * nfv            # نفس مقياس سطر البيع (المحرك يكتبه قبل المعامل)
            e["c"] += int(m.group(2) or 0)                # كل مستوى بيعة
    _HDP_CACHE[hp] = (ck, {k: dict(v) for k, v in out.items()})
    return out


def _ri_state_of(st):
    """💠 لقطة إعادة الاستثمار من ملف حالة: الربح اللي لسه داخل الأوامر · المسلَّم للمُراكِم · النسبة.

    «داخل الأوامر» = قيمة كل درجة (الحصّالة + النمو × سعر الدرجة) ناقص رأس المال المحقون
    + يتيم + نمو أوامر حيّة تنتظر التفكيك. بسعر الدرجة ⇒ ما يتحرك بحركة السوق."""
    ri = (st or {}).get("reinvest")
    if not isinstance(ri, dict):
        return None
    held = 0.0
    for lv in (ri.get("levels") or {}).values():
        try:
            px = float(lv.get("px") or 0)
            tot = float(lv.get("usd_book") or 0) + float(lv.get("grown_qty") or 0) * px
            cap = min(max(0.0, float(lv.get("inj_book") or 0) + float(lv.get("inj_grown") or 0)), max(0.0, tot))
            held += max(0.0, tot - cap)
        except Exception:
            continue
    held += float(ri.get("orphan_usd") or 0)
    for e in (ri.get("unwind") or {}).values():
        try:
            held += max(0.0, float(e.get("grown_qty") or 0) * float(e.get("px") or 0) - float(e.get("inj") or 0))
        except Exception:
            continue
    pc = ri.get("pct")
    return {"on": bool(ri.get("on")), "held": held, "handoff": float(ri.get("handoff_total") or 0),
            "pct": 100.0 if pc is None else float(pc), "levels": len(ri.get("levels") or {}),
            "used": bool(ri.get("on") or ri.get("levels") or ri.get("unwind")
                         or float(ri.get("handoff_total") or 0) > 0 or float(ri.get("orphan_usd") or 0) > 0)}


def _tp_bots():
    """بوتات الدولار (جرد بأنواعه) — نفس اللي يدخل السجل اليومي: بلا ديمو وبلا DCA."""
    out = {}
    for b in bot_dirs().values():
        c0 = b.get("cfg") or {}
        if c0.get("is_demo") or c0.get("bot_type") in ("dca", "dca_buy"):
            continue
        out[os.path.relpath(b["dir"], ROOT)] = b
    return out


def trade_period(start, end):
    """🧮 ربح التداول لفترة (تواريخ شاملة) — لكل عملة ولكل يوم: بدون · 💠 · المحرر · البيعات.

    بوت بلا إعادة استثمار: «بدون» = السجل اليومي نفسه (دقيق بالكامل، = المحرر).
    بوت بإعادة استثمار: «بدون» و«💠» من سجل صفقاته (مؤرشف بالأكبر)، والمحرر من السجل اليومي —
    فيوم التحرير يطلع المحرر أكبر من «بدون» بمبلغ التحرير، **وما ينحسب ربح تداول مرتين**."""
    d0 = datetime.strptime(start, "%Y-%m-%d")
    d1 = datetime.strptime(end, "%Y-%m-%d")
    days = []
    while d0 <= d1:
        days.append(d0.strftime("%Y-%m-%d"))
        d0 += timedelta(days=1)
    dset = set(days)
    led = load_json(LEDGER) or {}
    arc = load_json(RI_LEDGER) or {}
    abots = arc.get("bots") or {}
    cur = _tp_bots()
    keys = ({k for k, v in led.items() if not str(k).startswith("_") and isinstance(v, dict)}
            | set(abots) | set(cur))
    live_days = max(3, (datetime.now() - datetime.strptime(start, "%Y-%m-%d")).days + 2)
    per_day = {d: {"n": 0.0, "r": 0.0, "rel": 0.0, "c": 0} for d in days}
    coins, bots_out = {}, {}
    for key in sorted(keys):
        le = led.get(key) if isinstance(led.get(key), dict) else {}
        ae = abots.get(key) or {}
        b = cur.get(key)
        sym = (b or {}).get("symbol") or le.get("symbol") or ae.get("symbol") or key
        rs = None
        if b is not None:
            rs = _safe(_ri_state_of, _safe(load_json, paths_of(b)[0], default={}) or {}, default=None)
        hday = {d: dict(v) for d, v in (ae.get("daily") or {}).items() if d in dset}
        if b is not None:
            for d, v in (_safe(_hist_day_parts, b, live_days, default={}) or {}).items():
                if d in dset:
                    c_ = hday.get(d) or {}
                    hday[d] = {"n": max(float(c_.get("n") or 0), v["n"]), "r": max(float(c_.get("r") or 0), v["r"]),
                               "c": max(int(c_.get("c") or 0), int(v["c"]))}
        is_ri = bool(rs and rs["used"]) or any(float((v or {}).get("r") or 0) > 0
                                                for v in (ae.get("daily") or {}).values())
        c = coins.setdefault(sym, {"n": 0.0, "r": 0.0, "rel": 0.0, "c": 0, "bots": [], "ri": False,
                                   "held": 0.0, "handoff": 0.0, "pct": None, "on": False})
        c["bots"].append(key)
        if is_ri:
            c["ri"] = True
        if rs:
            c["held"] += rs["held"]
            c["handoff"] += rs["handoff"]
            if rs["used"]:
                pc_cfg = ((b or {}).get("cfg") or {}).get("reinvest_pct")
                c["pct"] = float(pc_cfg) if pc_cfg is not None else rs["pct"]
                c["on"] = c["on"] or rs["on"]
        bref = bots_out.setdefault(key, {"sym": sym, "n": 0.0, "r": 0.0, "rel": 0.0, "c": 0, "ri": is_ri})
        for d in days:
            rel = float((le.get("daily") or {}).get(d) or 0)
            h = hday.get(d)
            if is_ri and h is not None:
                n, r, k = float(h["n"]), float(h["r"]), int(h["c"])
            else:                           # بلا إعادة استثمار، أو يوم قبل الأرشيف المفصّل
                n, r, k = rel, 0.0, int((h or {}).get("c") or 0)
            for tgt in (per_day[d], c, bref):
                tgt["n"] += n
                tgt["r"] += r
                tgt["rel"] += rel
                tgt["c"] += k
        bref["ri"] = is_ri
    # 💠 أيام قبل v3.11: الأرشيف القديم كان يخزّن المجموع بس — الزايد عن الموزّع ينعرض «غير موزّع»
    unassigned = 0.0
    legacy = arc.get("daily") or {}
    for d in days:
        extra = float(legacy.get(d) or 0) - per_day[d]["r"]
        if extra > 1e-6:
            per_day[d]["r"] += extra
            unassigned += extra
    tot = {"n": 0.0, "r": 0.0, "rel": 0.0, "c": 0}
    for d in days:
        for k in tot:
            tot[k] += per_day[d][k]
    return {"days": days, "per_day": per_day, "coins": coins, "tot": tot, "unassigned": unassigned,
            "by_bot": bots_out}


def _tp_alltime():
    """📈 إجمالي التداول حتى الآن = إجمالي المحرر (نفس رقم الكرت) + 💠 داخل الأوامر + 💠 للمُراكِم."""
    rel = held = ho = 0.0
    for b in _tp_bots().values():
        st = _safe(load_json, paths_of(b)[0], default={}) or {}
        rel += round(float(st.get("total_profit") or 0) * _safe(net_factor, b, default=1.0), 4)
        rs = _safe(_ri_state_of, st, default=None)
        if rs:
            held += rs["held"]
            ho += rs["handoff"]
    return {"rel": rel, "held": held, "handoff": ho, "trade": rel + held + ho}


def trade_now():
    """🔄 للشريط العلوي: ربح التداول اليوم ومكوّناته + مكوّنات إجمالي التداول."""
    today = datetime.now().strftime("%Y-%m-%d")
    T = trade_period(today, today)["tot"]
    A = _tp_alltime()
    return {"today": round(T["n"] + T["r"], 6), "n": round(T["n"], 6), "r": round(T["r"], 6),
            "rel_today": round(T["rel"], 6), "held": round(A["held"], 6), "handoff": round(A["handoff"], 6)}


def _tp_range(kind, ref=None):
    """الفترة بالضبط: يومي = أمس · أسبوعي = آخر 7 أيام كاملة · شهري = **الشهر الميلادي الماضي كاملاً**."""
    now = ref or datetime.now()
    y = now - timedelta(days=1)
    if kind == "daily":
        return y.strftime("%Y-%m-%d"), y.strftime("%Y-%m-%d")
    if kind == "weekly":
        return (now - timedelta(days=7)).strftime("%Y-%m-%d"), y.strftime("%Y-%m-%d")
    last = now.replace(day=1) - timedelta(days=1)
    return last.replace(day=1).strftime("%Y-%m-%d"), last.strftime("%Y-%m-%d")


def build_report(kind, ref=None):
    """📊 التقرير اليومي/الأسبوعي/الشهري — ربح التداول (بدون + 💠) لكل عملة ولكل يوم + الربح المحرر.

    Markdown بلا تداخل (العنوان العريض ما يحتوي رمز) — مفحوص بمحلّل تيليغرام نفسه."""
    start, end = _tp_range(kind, ref)
    P = trade_period(start, end)
    days, T, PD = P["days"], P["tot"], P["per_day"]
    nd = len(days)
    trade = T["n"] + T["r"]
    has_ri = T["r"] > 5e-5 or any(c["ri"] for c in P["coins"].values())
    if kind == "daily":
        title = f"📊 *التقرير اليومي — {_tp_wd(end)} {end}*"
    elif kind == "weekly":
        title = f"🗓 *التقرير الأسبوعي — {start[5:]} ← {end[5:]}*"
    else:
        title = f"📆 *التقرير الشهري — {end[:7]}* ({_tp_cnt(nd, 'يوم', 'يومين', 'أيام', 'يوم')})"
    SEP = "━━━━━━━━━━━━━━━"
    L = [title, SEP, "💹 *ربح التداول حسب العملة*" + ("" if nd == 1 else " · " + _tp_cnt(nd, "يوم", "يومين", "أيام", "يوم"))]
    shown = 0
    for sym, c in sorted(P["coins"].items(), key=lambda kv: -(kv[1]["n"] + kv[1]["r"])):
        tt = c["n"] + c["r"]
        if abs(tt) < 5e-5 and abs(c["rel"]) < 5e-5:
            continue
        shown += 1
        nb = len(c["bots"])
        L.append(f"▫️ *{_tp_md(sym.split('-')[0])}*" + (f" ({_tp_cnt(nb, 'بوت', 'بوتين', 'بوتات', 'بوت')})" if nb > 1 else "") + f": `{tt:.4f}$`")
        if c["ri"]:
            sub = f"      بدون `{c['n']:.4f}` + 💠 `{c['r']:.4f}`"
        else:
            sub = "      كله بدون إعادة استثمار"
        if c["c"]:
            sub += " · " + _tp_cnt(c["c"], "بيعة وحدة", "بيعتين", "بيعات", "بيعة")
        L.append(sub)
        if c["ri"] and (c["held"] > 5e-5 or c["on"]):
            L.append(f"      💠 داخل الأوامر الآن `{c['held']:.4f}$`"
                     + (f" · النسبة {c['pct']:.0f}%" if c["pct"] is not None else "")
                     + ("" if c["on"] else " · متوقفة"))
    if P["unassigned"] > 5e-5:
        L.append(f"▫️ 💠 غير موزّع على عملة: `{P['unassigned']:.4f}$` (أيام قبل v3.11)")
    if not shown and P["unassigned"] <= 5e-5:
        L.append("ما في ربح مسجّل بهذه الفترة")
    if nd > 1:
        L.append(SEP)
        L.append("📅 *ربح كل يوم*" + (" · المجموع = بدون + 💠" if has_ri else ""))
        mx = max([PD[d]["n"] + PD[d]["r"] for d in days] + [0.0])
        for d in days:
            v = PD[d]
            tt = v["n"] + v["r"]
            bar = ("▪" * max(1, int(round(tt / mx * 8)))) if mx > 0 and tt > 5e-5 else "—"
            line = f"`{_tp_wd(d)} {d[5:]}` `{tt:.4f}$`"
            if v["r"] > 5e-5:
                line += f" = `{v['n']:.4f}` + 💠`{v['r']:.4f}`"
            L.append(line + " " + bar)
    L.append(SEP)
    L.append(f"🔄 *ربح التداول:* `{trade:.4f}$`")
    if has_ri:
        L.append(f"      بدون إعادة استثمار `{T['n']:.4f}$` + 💠 إعادة استثمار `{T['r']:.4f}$`")
    if nd > 1:
        avg = trade / nd
        zero = sum(1 for d in days if PD[d]["n"] + PD[d]["r"] < 5e-5)
        L.append(f"📊 *المعدل اليومي:* `{avg:.4f}$`"
                 + (f" = `{T['n'] / nd:.4f}` + 💠`{T['r'] / nd:.4f}`" if has_ri else "")
                 + " (على " + _tp_cnt(nd, "يوم", "يومين", "أيام", "يوم")
                 + (f"، منها {_tp_cnt(zero, 'يوم', 'يومين', 'أيام', 'يوم')} بلا ربح" if zero else "") + ")")
        best = max(days, key=lambda d: PD[d]["n"] + PD[d]["r"])
        worst = min(days, key=lambda d: PD[d]["n"] + PD[d]["r"])
        L.append(f"🏆 أفضل يوم `{_tp_wd(best)} {best[5:]}` `{PD[best]['n'] + PD[best]['r']:.4f}$`")
        L.append(f"📉 أضعف يوم `{_tp_wd(worst)} {worst[5:]}` `{PD[worst]['n'] + PD[worst]['r']:.4f}$`")
        L.append(f"🔮 بهذا المعدل شهرياً `{avg * 30:.2f}$`")
    L.append(f"💵 *الربح المحرر:* `{T['rel']:.4f}$`")
    diff = T["rel"] - T["n"]
    if diff >= 0.01:
        L.append(f"      منه `{diff:.4f}$` تحرير من إعادة الاستثمار (أو ربح انحسب بيوم رجوع اللوحة)")
    elif diff <= -0.01:
        L.append(f"      `{-diff:.4f}$` من ربح الفترة انحسب محرراً بيوم ثاني (اللوحة كانت متوقفة)")
    L.append("      المحرر هو اللي يدخل الربح اليومي، والمُراكِم ياخذ نسبته منه")
    if kind == "daily":
        L += _safe(_flow_lines, 7, default=[]) or []      # 💵 من وين جت الأموال المحررة ووين راحت
    A = _tp_alltime()
    L.append(SEP)
    L.append(f"📈 إجمالي التداول `{A['trade']:.4f}$` · 💵 إجمالي المحرر `{A['rel']:.4f}$` (حتى الآن)")
    return "\n".join(L)


def reinvest_report(kind="daily", ref=None):
    """💠 ملخّص إعادة الاستثمار (زر اللوحة) — نفس أرقام التقرير الرئيسي بالضبط، Markdown."""
    start, end = _tp_range(kind, ref)
    P = trade_period(start, end)
    nd = len(P["days"])
    ri = [(s, c) for s, c in P["coins"].items() if c["ri"]]
    if not ri and P["unassigned"] <= 5e-5:
        return None
    ttl = {"daily": "اليومي", "weekly": "الأسبوعي", "monthly": "الشهري"}.get(kind, "اليومي")
    L = [f"💠 *إعادة الاستثمار — التقرير {ttl}*", f"{start} ← {end}", ""]
    tn = tr = 0.0
    tc = 0
    for sym, c in sorted(ri, key=lambda kv: -(kv[1]["n"] + kv[1]["r"])):
        tn += c["n"]; tr += c["r"]; tc += c["c"]
        L.append(f"▫️ *{_tp_md(sym.split('-')[0])}*: `{c['n'] + c['r']:.4f}$` = بدون `{c['n']:.4f}` + 💠 `{c['r']:.4f}`"
                 + (" · " + _tp_cnt(c["c"], "بيعة وحدة", "بيعتين", "بيعات", "بيعة") if c["c"] else ""))
        L.append(f"      داخل الأوامر الآن `{c['held']:.4f}$`"
                 + (f" · النسبة {c['pct']:.0f}%" if c["pct"] is not None else "")
                 + ("" if c["on"] else " · متوقفة")
                 + (f" · للمُراكِم `{c['handoff']:.4f}$`" if c["handoff"] > 5e-5 else ""))
    if P["unassigned"] > 5e-5:
        tr += P["unassigned"]
        L.append(f"▫️ 💠 غير موزّع على عملة `{P['unassigned']:.4f}$` (أيام قبل v3.11)")
    L += ["━━━━━━━━━━━━━━━", f"🔄 *ربح التداول بهالبوتات:* `{tn + tr:.4f}$`",
          f"      بدون `{tn:.4f}$` + 💠 `{tr:.4f}$`" + (" · " + _tp_cnt(tc, "بيعة وحدة", "بيعتين", "بيعات", "بيعة") if tc else "")]
    if nd > 1:
        L.append(f"📊 *المعدل اليومي:* `{(tn + tr) / nd:.4f}$` (على " + _tp_cnt(nd, "يوم", "يومين", "أيام", "يوم") + ")")
    return "\n".join(L)


def _tp_chunks(text, lim=3800):
    """حد تيليغرام 4096 حرف — نقسّم على حدود الأسطر."""
    parts, cur = [], ""
    for line in str(text or "").split("\n"):
        if cur and len(cur) + 1 + len(line) > lim:
            parts.append(cur)
            cur = line
        else:
            cur = (cur + "\n" + line) if cur else line
    if cur:
        parts.append(cur)
    return parts


def _tg_report(text):
    """📨 إرسال تقرير بأمان: يتقسّم تحت حد تيليغرام · ولو تيليغرام رفض التنسيق ينرسل نصاً عادياً — ما يضيع."""
    ok_all = True
    for part in _tp_chunks(text):
        ok = tg_send(part)
        if not ok and "parse" in str(TG_DIAG.get("last") or "").lower():
            ok = tg_send(part.replace("*", "").replace("`", ""), plain=True)
        ok_all = ok_all and bool(ok)
    return ok_all

# ═══════════════ 🧾 سجل ربح اليوم (ضغطة على بطاقتي الشريط) ═══════════════
_TL_PX = re.compile(r"السعر:\s*([\d.]+)")
_TL_QTY = re.compile(r"الكمية:\s*([\d.]+)")
_TL_SPLIT = re.compile(r"\((\d+)%\s*من\s*([\d.]+)\$\)")


def trade_log(day=None):
    """🧾 كل بيعة باليوم: وقتها · بوتها · كم راح ربحاً عادياً وكم انعاد استثماره.

    مبني على تاريخ اليوم بسجل صفقات المحرك ⇒ **يصفّر بنفسه بنهاية اليوم**.
    البيعة المقسومة تكتب سطرين بنفس الثانية (💠 + 🔴) ⇒ تنجمع بسطر واحد."""
    day = day or datetime.now().strftime("%Y-%m-%d")
    merged, coins = {}, {}
    for key, b in _tp_bots().items():
        _, hp, _ = paths_of(b)
        nfv = _safe(net_factor, b, default=1.0)
        sym = b["symbol"]
        for r0 in (_safe(load_json, hp, default=[]) or []):
            if not isinstance(r0, dict):
                continue
            t = str(r0.get("time") or "")
            if t[:10] != day:
                continue
            msg = str(r0.get("msg") or "")
            mp = _TL_PX.search(msg)
            px = float(mp.group(1)) if mp else 0.0
            mi = _RI_RE_IN.search(msg)
            ms = None if mi else _RI_RE_SELL.search(msg)
            if not mi and not ms:
                continue
            k = (key, t[11:19], round(px, 8))
            e = merged.setdefault(k, {"t": t[11:19], "bot": key, "sym": sym, "px": px,
                                      "n": 0.0, "r": 0.0, "pct": None, "qty": 0.0})
            if mi:
                e["r"] += float(mi.group(1))
                sp = _TL_SPLIT.search(msg)
                e["pct"] = float(sp.group(1)) if sp else 100.0
            else:
                e["n"] += float(ms.group(1)) * nfv
                mq = _TL_QTY.search(msg)
                if mq:
                    e["qty"] = float(mq.group(1))
    rows = sorted(merged.values(), key=lambda r: r["t"], reverse=True)
    for r in rows:
        c = coins.setdefault(r["sym"], {"n": 0.0, "r": 0.0, "c": 0, "pct": None, "bots": []})
        c["n"] += r["n"]; c["r"] += r["r"]; c["c"] += 1
        if r["pct"] is not None:
            c["pct"] = r["pct"]
        if r["bot"] not in c["bots"]:
            c["bots"].append(r["bot"])
    by_bot = {}
    for r in rows:
        e = by_bot.setdefault(r["bot"], {"sym": r["sym"], "n": 0.0, "r": 0.0, "c": 0})
        e["n"] += r["n"]; e["r"] += r["r"]; e["c"] += 1
    # 🔑 الملخص من `trade_period` — نفس مصدر بطاقة الشريط بالضبط، فالسجل يجمع للرقم اللي ضغطت عليه.
    #    (بوت بلا إعادة استثمار رقمه من السجل اليومي الدقيق · السطور تفصيل من سجل الصفقات)
    Pp = _safe(trade_period, day, day, default=None) or {}
    pc = Pp.get("coins") or {}
    pt = Pp.get("tot") or {}
    for sym, c in pc.items():
        e = coins.setdefault(sym, {"n": 0.0, "r": 0.0, "c": 0, "pct": None, "bots": []})
        e["n"], e["r"] = float(c.get("n") or 0), float(c.get("r") or 0)
        e["c"] = int(c.get("c") or e["c"])
        if c.get("pct") is not None:
            e["pct"] = c.get("pct")
    tot = {"n": round(float(pt.get("n") or 0), 6), "r": round(float(pt.get("r") or 0), 6),
           "c": int(pt.get("c") or len(rows))}
    tot["all"] = round(tot["n"] + tot["r"], 6)
    rows_sum = sum(r["n"] + r["r"] for r in rows)
    return {"day": day, "rows": rows[:300], "n_rows": len(rows), "coins": coins,
            "by_bot": Pp.get("by_bot") or by_bot, "tot": tot,
            "rows_sum": round(rows_sum, 6), "gap": round(tot["all"] - rows_sum, 6)}


def released_log(day=None):
    """💵 الربح المحرر اليوم: من وين جا (كل بوت) · وين راح يروح (المُراكِم) · وحركة آخر 7 أيام."""
    day = day or datetime.now().strftime("%Y-%m-%d")
    led = _safe(load_json, LEDGER, default={}) or {}
    TL = trade_log(day)
    rows, tot = [], 0.0
    for key, e in led.items():
        if str(key).startswith("_") or not isinstance(e, dict):
            continue
        rel = float((e.get("daily") or {}).get(day) or 0)
        tb = TL["by_bot"].get(key) or {}
        if abs(rel) < 5e-5 and not tb:
            continue
        n = float(tb.get("n") or 0)      # 👈 من `trade_period`: السجل اليومي للبوت العادي، وسجل الصفقات لبوت إعادة الاستثمار
        rows.append({"bot": key, "sym": e.get("symbol") or key, "rel": round(rel, 6),
                     "trade": round(n, 6), "extra": round(rel - n, 6),
                     "ri": round(float(tb.get("r") or 0), 6), "c": int(tb.get("c") or 0)})
        tot += rel
    rows.sort(key=lambda r: -r["rel"])
    st = _safe(acc_state, default={}) or {}
    accs, used = [], 0.0
    for a in (_safe(acc_cfgs, default=[]) or []):
        e = st.get(a.get("id")) or {}
        pct = float(a.get("pct") or 0)
        used += pct
        accs.append({"name": a.get("name") or a.get("symbol"), "sym": a.get("symbol"), "pct": pct,
                     "expect": round(tot * pct / 100.0, 4), "pool": round(float(e.get("pool") or 0), 4),
                     "reserve": round(float(e.get("pending") or 0), 4), "coin": float(e.get("coin") or 0),
                     "enabled": bool(a.get("enabled", True)), "min_buy": float(a.get("min_buy") or 0),
                     "skip": str(e.get("skip") or "")})
    return {"day": day, "rows": rows, "total": round(tot, 6), "accs": accs,
            "used_pct": round(used, 2), "keep": round(tot * max(0.0, 100 - used) / 100.0, 4),
            "trade_norm": TL["tot"]["n"], "flow": flow_days(7)}


def flow_days(n=7):
    """💵 حركة الأموال المحررة — آخر n يوم منتهٍ: كم تحرر · نصيب كل مُراكِم · كم بقى لك · وشنو انشرى فعلاً."""
    st = _safe(acc_state, default={}) or {}
    cfgs = _safe(acc_cfgs, default=[]) or []
    out = []
    for i in range(1, int(n) + 1):
        d = (datetime.now() - timedelta(days=i)).strftime("%Y-%m-%d")
        rel = float(_safe(day_profit, d, default=0.0) or 0.0)
        accs, alloc = [], 0.0
        for a in cfgs:
            e = st.get(a.get("id")) or {}
            share = float((e.get("days") or {}).get(d) or 0)
            alloc += share
            usd = qty = 0.0
            for x in (e.get("buys") or []):
                try:
                    if datetime.fromtimestamp(float(x.get("ts") or 0)).strftime("%Y-%m-%d") == d:
                        usd += float(x.get("usd") or 0)
                        qty += float(x.get("qty") or 0)
                except Exception:
                    continue
            accs.append({"name": a.get("name") or a.get("symbol"), "sym": a.get("symbol"),
                         "pct": float(a.get("pct") or 0), "share": round(share, 4),
                         "bought": round(usd, 4), "qty": round(qty, 8)})
        out.append({"day": d, "rel": round(rel, 4), "alloc": round(alloc, 4),
                    "keep": round(rel - alloc, 4), "accs": accs})
    return out


def _flow_lines(n=7):
    """💵 قسم «حركة الأموال المحررة» بالتقرير اليومي — آخر 7 أيام: من وين وين راحت."""
    F = _safe(flow_days, n, default=[]) or []
    if not any(x["rel"] > 5e-5 or x["alloc"] > 5e-5 for x in F):
        return []
    L = ["━━━━━━━━━━━━━━━", f"💵 *حركة الأموال المحررة — آخر {_tp_cnt(len(F), 'يوم', 'يومين', 'أيام', 'يوم')}*"]
    for x in reversed(F):
        if x["rel"] < 5e-5 and x["alloc"] < 5e-5:
            continue
        line = f"`{_tp_wd(x['day'])} {x['day'][5:]}` محرر `{x['rel']:.4f}$`"
        parts = [f"{_tp_md(a['name'])} `{a['share']:.4f}`" + (f" (شرى `{a['bought']:.2f}$`)" if a["bought"] > 5e-5 else "")
                 for a in x["accs"] if a["share"] > 5e-5 or a["bought"] > 5e-5]
        if parts:
            line += " ⇒ 🪙 " + " · ".join(parts)
        line += f" · يبقى لك `{x['keep']:.4f}$`"
        L.append(line)
    tr = sum(x["rel"] for x in F)
    ta = sum(x["alloc"] for x in F)
    L.append(f"      المجموع: محرر `{tr:.4f}$` · للمُراكِم `{ta:.4f}$` · بقى لك `{tr - ta:.4f}$`")
    return L


