APP_SILENT_SEC = 1800       # 📱 الموبايل يسحب كل ≤ دقيقة (والفحص الاحتياطي كل 15 دقيقة) ⇒ 30 دقيقة سكوت = النظام سكّره أو النت مقطوع
_APP_SILENT = {}


def app_dev_watch(now=None):
    """📱 v3.25.2: موبايل مربوط سكت أكثر من 30 دقيقة ⇒ سطر بالسجلات (مرة) · رجع ⇒ سطر «رجع اتصل». الإشعارات ما تضيع: تنتظره وتوصل لما يرجع."""
    now = now or time.time()
    out = []
    for d in _safe(app_devices, default=[]) or []:
        did, seen = str(d.get("id") or ""), float(d.get("seen") or 0)
        if not did or not seen:
            continue
        quiet = now - seen > APP_SILENT_SEC
        pc = str(d.get("name") or "").startswith("💻")              # 💻 v3.26.1: حاسوب مطفي = طبيعي ⇒ سطر هادئ
        if quiet and did not in _APP_SILENT and pc:
            _APP_SILENT[did] = seen
            out.append(("quiet", d))
            _safe(journal, "notify", f"💻 الحاسوب «{d.get('name')}» ما اتصل من {int((now - seen) / 60)} دقيقة — غالباً مطفي أو البرنامج مسكّر"
                  " (الإشعارات تنتظره وتوصل لما يرجع)", "ok", default=None)
        elif quiet and did not in _APP_SILENT:
            _APP_SILENT[did] = seen
            out.append(("quiet", d))
            _safe(journal, "notify", f"📱 الموبايل «{d.get('name')}» ما اتصل من {int((now - seen) / 60)} دقيقة — غالباً النظام سكّر Holy أو النت مقطوع"
                  " (الإشعارات تنتظره وتوصل كلها لما يرجع · من التطبيق: ⚙️ ⇐ 📱 ⇐ «والتطبيق مسكّر»)", "warn", default=None)
        elif not quiet and did in _APP_SILENT:
            gap = seen - _APP_SILENT.pop(did)
            out.append(("back", d))
            _safe(journal, "notify", f"📱 الموبايل «{d.get('name')}» رجع اتصل (بعد {int(max(0, gap) / 60)} دقيقة) — وصله اللي فاته", "ok", default=None)
    return out


def guard_loop():
    """🛡️ يفحص كل 10 دقائق. أول فحص بعد دقيقة (حتى تحمّل الأسعار والأرصدة)."""
    time.sleep(60)
    while True:
        _safe(app_dev_watch, default=None)            # 📱 v3.25.2
        try:
            guard_scan()
        except Exception as e:
            try:
                log_event(f"⚠️ [الرقابة] فشل الفحص الدوري: {type(e).__name__}: {e}")
            except Exception:
                pass
        time.sleep(GUARD_EVERY)


def selfcheck():
    """🩺 فحص ذاتي — يمسك أي تناقض بالأرقام قبل ما يكلّفك فلوس.

    يفحص الثوابت اللي لازم تصح دائماً بكل بوت:
      · ولا خانة سالبة بدفتر إعادة الاستثمار
      · رأس المال المحقون ما يتجاوز الموجود بالدرجة
      · الحصّالة ما تتجاوز حدّ التحويل (خطوتين)
      · بنود التفكيك ما تَعِد بأكثر مما بالأمر
      · العملة المسلَّمة للمُراكِم ≤ المحرَّر فعلياً
      · كل درجة إلها سعر مخزَّن، وكل أمر بيع إلها تكلفة
    """
    out = []
    for d, b in bot_dirs().items():
        sym = b.get("symbol") or os.path.basename(d)
        try:
            sp, _, _ = paths_of(b)
            st = _safe(load_json, sp, default={}) or {}
            ri = st.get("reinvest") if isinstance(st.get("reinvest"), dict) else {}
            lv = ri.get("levels") or {}
            for k, e in lv.items():
                ub = float(e.get("usd_book") or 0)
                gq = float(e.get("grown_qty") or 0)
                ib = float(e.get("inj_book") or 0)
                ig = float(e.get("inj_grown") or 0)
                px = float(e.get("px") or 0)
                if min(ub, gq, ib, ig) < -1e-9:
                    out.append(f"🔴 {sym} الدرجة {k}: خانة سالبة")
                if px <= 0:
                    out.append(f"🟠 {sym} الدرجة {k}: بلا سعر مخزَّن")
                elif (ib + ig) > (ub + gq * px) + 1e-6:
                    out.append(f"🔴 {sym} الدرجة {k}: المحقون "
                               f"{ib+ig:.4f}$ > الموجود {ub+gq*px:.4f}$")
            for k, u in (ri.get("unwind") or {}).items():
                if float(u.get("grown_qty") or 0) < -1e-12:
                    out.append(f"🔴 {sym} تفكيك {k}: كمية سالبة")
            # 🪙 العملة المسلَّمة مقابل المحرَّر
            rel = ri.get("released") or {}
            hc = float(rel.get("coin") or 0)
            if hc > 0:
                tot_sell = 0.0
                for key in ("limit_sells", "virtual_sells", "accum_sells"):
                    for i2 in (st.get(key) or {}).values():
                        tot_sell += float(i2.get("locked_qty") or 0)
                out.append(f"ℹ️ {sym}: سُلّم للمُراكِم {hc:.8f} عملة "
                           f"· باقٍ بالأوامر {tot_sell:.8f}")
            # كل أمر بيع إلها تكلفة
            miss = 0
            for key in ("limit_sells", "virtual_sells", "accum_sells"):
                for i2 in (st.get(key) or {}).values():
                    if float(i2.get("cost_px") or i2.get("original_buy_anchor") or 0) <= 0:
                        miss += 1
            if miss:
                out.append(f"🟠 {sym}: {miss} أمر بيع بلا سعر تكلفة "
                           f"— المركز يُحسب بتقدير")
        except Exception as ex:
            out.append(f"⚠️ {sym}: تعذّر الفحص ({type(ex).__name__})")
    return out


def reconcile():
    """🧾 مطابقة شاملة — كل دولار وكل عملة، بكل الحالات.

    الهوية اللي لازم تصح دائماً:
        حقوقك = دولار محجوز بالشراء + قيمة العملة المحتجزة + عملة المُراكِم
                 + الدولار الحر بالمحفظة
    و:
        ربح التداول = المحقّق (الدفتر) + المتراكم داخل الأوامر + اللي راح للمُراكِم
    """
    out = {"bots": [], "lock_buy": 0.0, "coin_value": 0.0, "coin_cost": 0.0,
           "unreal": 0.0, "realized": 0.0, "inside": 0.0, "injected": 0.0,
           "unwind": 0.0, "handoff": 0.0,
           "acc_coin": 0.0, "acc_cost": 0.0, "acc_value": 0.0,
           "ts": time.time()}
    for d, b in bot_dirs().items():
        try:
            sp, _, _ = paths_of(b)
            st = _safe(load_json, sp, default={}) or {}
            px = float(b.get("cp") or st.get("current_price") or 0)
            pos = position_of(b, st, px)
            nfv = _safe(net_factor, b, default=1.0)
            real = float(st.get("total_profit") or 0) * nfv
            ri = st.get("reinvest") if isinstance(st.get("reinvest"), dict) else {}
            ins = inj = 0.0
            for e in (ri.get("levels") or {}).values():
                try:
                    lp = float(e.get("px") or 0)
                    ins += float(e.get("grown_qty") or 0) * lp + float(e.get("usd_book") or 0)
                    inj += float(e.get("inj_book") or 0) + float(e.get("inj_grown") or 0)
                except Exception:
                    continue
            uw = sum(max(0.0, float(v.get("grown_qty") or 0) * float(v.get("px") or 0)
                         - float(v.get("inj") or 0))
                     for v in (ri.get("unwind") or {}).values())
            # 🪙 عملة سُلّمت للمُراكِم عند الإطفاء — ربح تداول صار عملة،
            #    ما عاد يظهر بالدفتر ولا بالمتراكم. نعدّه صراحة وإلا يضيع من الحساب.
            _rl = ri.get("released") or {}
            hcost = float(ri.get("handoff_total") or 0.0)
            if hcost <= 0 and float(_rl.get("coin") or 0) > 0:   # نسخ قديمة
                hcost = float(_rl.get("coin") or 0) * float(_rl.get("avg_px") or 0)
            row = {"symbol": b["symbol"], "dir": os.path.relpath(d, ROOT), "px": px,
                   "pos": pos, "realized": round(real, 6),
                   "inside": round(max(0.0, ins - inj), 6), "injected": round(inj, 6),
                   "unwind": round(uw, 6), "handoff": round(hcost, 6),
                   "ri_on": bool(ri.get("on")),
                   "pct": (100 if (b.get("cfg") or {}).get("reinvest_pct") is None
                           else float((b.get("cfg") or {}).get("reinvest_pct")))}
            out["bots"].append(row)
            out["lock_buy"] += pos["lock_buy"]
            out["coin_value"] += pos["value"]
            out["coin_cost"] += pos["cost"]
            out["unreal"] += pos["unreal"]
            out["realized"] += real
            out["inside"] += row["inside"]
            out["injected"] += inj
            out["unwind"] += uw
            out["handoff"] += hcost
        except Exception:
            continue
    # 🪙 المُراكِمات
    try:
        for a in (app_cfg().get("accumulators") or []):
            c = float(a.get("coin") or 0)
            sp2 = float(a.get("spent") or 0)
            out["acc_coin"] += c
            out["acc_cost"] += sp2
            pxa = 0.0
            for r in out["bots"]:
                if r["symbol"] == a.get("symbol"):
                    pxa = r["px"]; break
            out["acc_value"] += c * pxa
    except Exception:
        pass
    out["equity_locked"] = round(out["lock_buy"] + out["coin_value"] + out["acc_value"], 6)
    out["acc_unreal"] = round(out["acc_value"] - out["acc_cost"], 6)
    out["trade_profit"] = round(out["realized"] + out["inside"] + out["unwind"]
                                + out["handoff"], 6)
    for k in ("lock_buy", "coin_value", "coin_cost", "unreal", "realized",
              "inside", "injected", "unwind", "handoff",
              "acc_coin", "acc_cost", "acc_value"):
        out[k] = round(out[k], 6)
    return out



