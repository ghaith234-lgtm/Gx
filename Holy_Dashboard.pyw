def boot_notice():
    """🔔 عند إقلاع اللوحة: يقارن آخر نبضة بالوقت الآن — فيكشف انقطاعاً حصل"""
    try:
        return _boot_notice_inner()
    except Exception:
        return None


def _boot_notice_inner():
    prev = load_json(HEARTBEAT) or {}
    last = float(prev.get("t") or 0)
    _hb_write()
    if last <= 0:
        tg_send("🚀 *[اللوحة تعمل]*\nبدأت لأول مرة على هذا الجهاز.")
        return
    gap = time.time() - last
    if gap < 180:
        return                       # إعادة تشغيل عادية — لا داعي للإزعاج
    mins = gap / 60.0
    dur = (f"{mins:.0f} دقيقة" if mins < 90 else
           f"{mins/60:.1f} ساعة" if mins < 1440 else f"{mins/1440:.1f} يوم")
    when = time.strftime("%Y-%m-%d %H:%M", time.localtime(last))
    tg_send(f"⚡ *[اللوحة رجعت]*\nكانت متوقفة `{dur}`\n"
            f"آخر نبضة: `{when}`\nالحارس راح يعيد إطلاق البوتات تلقائياً.")

def _graceful_bye(signum=None, frame=None):
    """🔌 عند إطفاء السيرفر/اللوحة: تنبيه قبل الخروج"""
    if _HB.get("bye"): return
    _HB["bye"] = True
    try:
        alive = sum(1 for b in bot_dirs().values() if is_alive(b["dir"], paths_of(b)[0])[0])
        tg_send(f"🔌 *[اللوحة تنطفئ]*\nكان يعمل `{alive}` بوت.\n"
                f"سبب الإشارة: `{signum}`\nراح أنبّهك لما ترجع.")
    except Exception:
        pass
    try: _hb_write()
    except Exception: pass
    os._exit(0)

