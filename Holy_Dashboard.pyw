/* ═══ الشريط العلوي v3.10 — صف الهوية والأرقام والتشغيل، ثم صف البوتات والصفحات ═══ */
header{flex-direction:column;flex-wrap:nowrap;align-items:stretch;gap:9px;padding:10px 22px}
/* ⚠️ nowrap إلزامي: عمود متعدد الأسطر يأخذ عرض أعرض عنصر (الشريط اللي ما ينلف) فيطفح بالموبايل */
.hrow,nav.actions{min-width:0;max-width:100%}
.hrow{display:flex;align-items:center;gap:16px;flex-wrap:wrap}
.ops{display:flex;gap:6px;align-items:center}
.ops button{padding:7px 10px;font-size:14px;line-height:1.1}
nav.actions{align-items:center;gap:8px}
nav.actions .grp{display:flex;gap:7px;flex-wrap:wrap;align-items:center}
nav.actions .gsep{width:1px;height:24px;background:var(--line);margin:0 4px;flex:none}
/* ↔️ v3.21.7: صف بيه سحب ⇒ حافة باهتة بجهة الباقي + سهم ينبّه */
/* ↔️ v3.21.9: تلميح سحب خفيف — شفاف · ما ينلمس · يظهر بعد ثانيتين · يأشّر لجهة الأزرار الباقية (الصف نفسه مثل قبل) */
.navwrap{position:relative;min-width:0;max-width:100%}
.navhint{position:absolute;top:50%;z-index:2;display:none;align-items:center;padding:6px 8px;border-radius:99px;pointer-events:none;
  color:var(--tx);opacity:0;transform:translateY(-50%);transition:opacity 1s var(--ease)}
.navhint svg{width:15px;height:15px;display:block}
.navhint svg+svg{margin-inline-start:-9px;opacity:.5}
.navhint.l{left:0;background:linear-gradient(to right,rgb(var(--surf2-rgb)/.9),rgb(var(--surf2-rgb)/0))}
.navhint.r{right:0;background:linear-gradient(to left,rgb(var(--surf2-rgb)/.9),rgb(var(--surf2-rgb)/0))}
.navwrap.hint.ml .navhint.l,.navwrap.hint.mr .navhint.r{display:flex}
.navwrap.hint.show .navhint{opacity:.45}
.navwrap.hint.show .navhint.l{animation:navHL 1.7s ease-in-out .2s 3}
.navwrap.hint.show .navhint.r{animation:navHR 1.7s ease-in-out .2s 3}
@keyframes navHL{0%,100%{transform:translateY(-50%)}50%{transform:translate(-6px,-50%);opacity:.85}}
@keyframes navHR{0%,100%{transform:translateY(-50%)}50%{transform:translate(6px,-50%);opacity:.85}}
/* ✨ الشريط العلوي — 🔔 يمين · الهوية بالوسط · ▶️ ⏹️ يسار · بطاقات الأرباح سطر تحته */
.hrow{display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);align-items:center;column-gap:12px;row-gap:10px}
.hrow>.ops.opsb{grid-column:1;grid-row:1;justify-self:start;margin:0!important}
.hrow>.brand{grid-column:2;grid-row:1;justify-self:center}
.hrow>.ops:not(.opsb){grid-column:3;grid-row:1;justify-self:end;margin:0!important}
