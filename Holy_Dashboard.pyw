def _pick_python():
    """يختار مفسّر بايثون عنده مكتبة okx فعلاً — يحل مشكلة تعدد نسخ بايثون"""
    cands = []
    if not getattr(sys, "frozen", False):
        cands.append(sys.executable.replace("pythonw.exe", "python.exe"))
    for n in ("python", "python3", "py"):
        w = shutil.which(n)
        if w and w not in cands:
            cands.append(w)
    # فضّل اللي يستورد okx بنجاح
    for c in cands:
        try:
            r = subprocess.run([c, "-c", "import okx"], capture_output=True, timeout=8,
                               creationflags=(0x08000000 if os.name == "nt" else 0))
            if r.returncode == 0:
                return c, cands
        except Exception:
            continue
    return (cands[0] if cands else "python"), cands

