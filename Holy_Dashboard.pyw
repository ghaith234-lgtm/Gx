  $('#pcKpi').innerHTML=k('ربح التداول',pcN(T.t)+' $',`مباشر ${pcN(T.n)} · معاد ${pcN(T.r)}`)
    +k('متوسط اليوم',pcN(T.avg)+' $',(T.active||0)+' يوم بيه ربح')
    +k('أفضل يوم',B?pcN(B.v)+' $':'—',B?B.full:'')
    +k('البيعات',String(T.c||0),T.cu?'أيام قديمة بلا عدد':(((T.c||0)/Math.max(1,v.span)).toFixed(1)+' باليوم'))}
function pcBars(v){
  const box=$('#pcBars'),days=v.days||[];
  if(!days.length||!((v.tot||{}).t>0)){box.innerHTML='<p class="pc-empty">ماكو ربح تداول مسجّل بالفترة بعد.</p>';return}
  const W=Math.max(280,Math.round(box.clientWidth||640)),H=W<520?210:270,L=34,R=6,T=20,B=24,pw=W-L-R,ph=H-T-B,N=days.length,band=pw/N,bw=Math.min(24,Math.max(2,band*0.68));   // 📐 وحدة الرسم = بكسل ⇒ الكتابة بحجمها بكل شاشة
  const mx=Math.max(...days.map(d=>d.t)),st=pcStep(mx/4),top=Math.max(st,Math.ceil(mx/st-1e-9)*st),dp=st>=1?0:(st>=0.01?2:4);
  const y=val=>T+ph-(val/top)*ph;
  let s=`<svg class="pc-svg" viewBox="0 0 ${W} ${H}" role="img" aria-label="ربح التداول لكل يوم">`;
  for(let i=0;i<=Math.round(top/st);i++){const yy=y(i*st).toFixed(1);
    s+=`<line x1="${L}" x2="${W-R}" y1="${yy}" y2="${yy}" class="${i?'pc-gl':'pc-bl'}"/><text x="${L-6}" y="${(+yy+3.5).toFixed(1)}" text-anchor="end">${(i*st).toFixed(dp)}</text>`}
  const k=Math.max(1,Math.ceil(N/Math.max(3,Math.floor(pw/52))));let mi=0;days.forEach((d,i)=>{if(d.t>days[mi].t)mi=i});
  days.forEach((d,i)=>{
    const x=L+i*band+(band-bw)/2,base=T+ph;let hn=d.n/top*ph,hr=d.r/top*ph;
    if(d.n>0&&hn<1)hn=1;if(d.r>0&&hr<1)hr=1;
    let g=`<g class="pc-col" style="--i:${i}">`;
    if(hn>0)g+=hr>0?`<rect class="pc-seg" x="${x.toFixed(2)}" y="${(base-hn).toFixed(2)}" width="${bw.toFixed(2)}" height="${hn.toFixed(2)}" fill="${PC.d}"/>`
                   :`<path class="pc-seg" d="${pcRT(x,base-hn,bw,hn,4)}" fill="${PC.d}"/>`;
    if(hr>0){const gap=(hn>0&&hr>2)?2:0;g+=`<path class="pc-seg" d="${pcRT(x,base-hn-hr,bw,hr-gap,4)}" fill="${PC.r}"/>`}
    g+=`<rect class="pc-hit" x="${(L+i*band).toFixed(2)}" y="${T}" width="${band.toFixed(2)}" height="${ph}" tabindex="0" data-i="${i}" aria-label="${d.full}: ${pcN(d.t,4)}"/></g>`;
    s+=g;
    if((N-1-i)%k===0)s+=`<text x="${(x+bw/2).toFixed(1)}" y="${H-8}" text-anchor="middle">${d.lbl}</text>`});
  const dm=days[mi];
  s+=`<text class="pc-mx" x="${(L+mi*band+band/2).toFixed(1)}" y="${(y(dm.t)-6).toFixed(1)}" text-anchor="middle">${pcN(dm.t)}$</text></svg><div class="pc-tip" id="pcTip" role="status"></div>`;
  box.innerHTML=s;box.dataset.w=box.clientWidth||0;
  box.querySelectorAll('.pc-hit').forEach(h=>{const on=()=>pcTipShow(+h.dataset.i,h);
    h.addEventListener('pointerenter',on);h.addEventListener('pointerdown',on);h.addEventListener('focus',on);
    h.addEventListener('pointerleave',e=>{if(e.pointerType!=='touch')pcTipHide()});h.addEventListener('blur',pcTipHide)})}
function pcTipShow(i,h){
