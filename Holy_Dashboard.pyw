function gridLadder(b){
  if(!b)return;const L=b.ladder||{};
  const row=(x,c,t)=>`<div class="ladrow"><span class="num">${f4(x.p)}</span><span class="ladq">${x.q}</span><span class="ladtag" style="background:rgb(var(--${c}-rgb)/.13);color:var(--${c})">${t}</span></div>`;
  let h='';
  (L.sells||[]).slice().sort((a,z)=>z.p-a.p).forEach(x=>h+=row(x,'red','🔴 بيع'));
  (L.buys||[]).slice().sort((a,z)=>z.p-a.p).forEach(x=>h+=row(x,'green','🟢 شراء'));
  let hv='';
  (L.vsells||[]).slice().sort((a,z)=>z.p-a.p).forEach(x=>hv+=row(x,'amber','💤 بيع ذاكرة'));
  (L.vbuys||[]).slice().sort((a,z)=>z.p-a.p).forEach(x=>hv+=row(x,'amber','💤 شراء ذاكرة'));
  showModal(`<h2>🪜 سلم الشبكة — ${b.symbol}</h2>
    ${h?`<div class="ladsec" style="color:var(--green)">🟢 على المنصة</div>${h}`:''}
    ${hv?`<div class="ladsec" style="color:var(--amber);margin-top:10px">💤 ذاكرة (افتراضية)</div>${hv}`:''}
    ${!h&&!hv?'<p style="color:var(--mut);font-size:12px">لا أوامر بعد</p>':''}
    <div class="mbtns"><button onclick="hideModal()">إغلاق</button></div>`);
}
