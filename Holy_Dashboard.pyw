def reinvest_tick():
    """💠 أرشيف يومي **لكل بوت**: الحصة العادية · المعاد استثماره · عدد البيعات — ويعيش للأبد.

    🔒 الدمج بالأكبر: سجل صفقات المحرك محدود بـ1000 سطر، فأقدم يوم فيه ينقرا **ناقصاً** كل ما ينزاح.
       النسخة السابقة كانت تكتب الرقم الناقص **فوق** الرقم الكامل ⇒ الأرشيف يخسر ربحاً مع الأيام.
       ربح اليوم بالحقيقة ما ينقص أبداً (البيعة تضيف ولا تشيل) ⇒ الأكبر هو الصحيح دائماً.
    ويبقى المفتاح القديم `daily` (مجموع كل البوتات) للكود القديم — بنفس قاعدة الأكبر."""
    arc = load_json(RI_LEDGER) or {}
    bots_arc = arc.setdefault("bots", {})
    changed = False
    for b in bot_dirs().values():
        c0 = b.get("cfg") or {}
        if c0.get("is_demo") or c0.get("bot_type") in _NONGRID:
            continue
        key = os.path.relpath(b["dir"], ROOT)
        ent = bots_arc.setdefault(key, {"symbol": b["symbol"], "daily": {}})
        if ent.get("symbol") != b["symbol"]:
            ent["symbol"] = b["symbol"]
            changed = True
        dd = ent.setdefault("daily", {})
        for day, v in _hist_day_parts(b, 20).items():
            cur = dd.get(day) or {}
            new = {"n": round(max(float(cur.get("n") or 0), v["n"]), 6),
                   "r": round(max(float(cur.get("r") or 0), v["r"]), 6),
                   "c": max(int(cur.get("c") or 0), int(v["c"]))}
            if new != cur:
                dd[day] = new
                changed = True
        if len(dd) > 800:
            for k in sorted(dd)[:-800]:
                dd.pop(k, None)
            changed = True
    agg = {}
    for ent in bots_arc.values():
        for day, v in (ent.get("daily") or {}).items():
            agg[day] = agg.get(day, 0.0) + float((v or {}).get("r") or 0)
    d = arc.setdefault("daily", {})
    for day, r in agg.items():
        if r > float(d.get(day) or 0) + 1e-9:
            d[day] = round(r, 6)
            changed = True
    if len(d) > 800:                       # أكثر من سنتين — نقصّ الأقدم
        for k in sorted(d)[:-800]:
            d.pop(k, None)
        changed = True
    if changed:
        arc["updated"] = time.time()
        try:
            save_json_atomic(RI_LEDGER, arc)
        except Exception:
            pass
    return arc


# ═══════════════ 🔄 ربح التداول · 💵 الربح المحرر — مصدر واحد للشريط والتقارير ═══════════════
# المصطلحات (v3.11):
#   💵 الربح المحرر      = الدولار اللي طلع من البوتات ربحاً عادياً (السجل اليومي) — يدخل الربح اليومي والمُراكِم
#   🔄 ربح التداول       = كل ربح البيعات = بدون إعادة استثمار + 💠 المعاد استثماره
#   📈 إجمالي التداول    = إجمالي المحرر + 💠 اللي لسه داخل الأوامر + 💠 اللي تسلّمه المُراكِم عملةً
# الفرق بين المحرر و«بدون» = تحرير أرباح إعادة استثمار قديمة (مو ربح تداول جديد — ما ينحسب مرتين)
_TP_WD = ("الاثنين", "الثلاثاء", "الأربعاء", "الخميس", "الجمعة", "السبت", "الأحد")
_HDP_CACHE = {}


def _tp_cnt(n, one, two, few, many):
    """عدد بالعربي الصحيح: بيعة وحدة · بيعتين · 5 بيعات · 12 بيعة."""
    n = int(n)
    if n == 1:
        return one
    if n == 2:
        return two
    return f"{n} {few}" if 3 <= n % 100 <= 10 else f"{n} {many}"


def _tp_wd(day):
    try:
        return _TP_WD[datetime.strptime(day, "%Y-%m-%d").weekday()]
    except Exception:
        return ""


def _tp_md(s):
    """نص متغيّر داخل رسالة Markdown — نهرّب علاماتها حتى ما ترفضها تيليغرام."""
    s = str(s if s is not None else "")
    for ch in ("_", "*", "`", "["):
        s = s.replace(ch, "\\" + ch)
    return s


def _hist_day_parts(b, days=20):
    """📜 من سجل صفقات بوت واحد، لكل يوم: {n: الحصة العادية × المعامل · r: المعاد استثماره · c: البيعات}.

    البيعة المقسومة تكتب سطرين (💠 فيه «% من» + 🔴 للحصة العادية) ⇒ تنعد **مرة وحدة** من سطر 🔴.
    البيعة 100% تكتب 💠 بس ⇒ تنعد منه. والنسبة صفر تكتب 🔴 بس."""
    try:
        _, hp, _ = paths_of(b)
        mt = os.path.getmtime(hp) if os.path.exists(hp) else 0
        nfv = _safe(net_factor, b, default=1.0)
        since = _books_since()
        ck = (hp, mt, int(days), round(float(nfv), 12), datetime.now().strftime("%Y-%m-%d"), since)
        hit = _HDP_CACHE.get(hp)
        if hit and hit[0] == ck:
            return {k: dict(v) for k, v in hit[1].items()}
        hist = load_json(hp) or []
        cut = max((datetime.now() - timedelta(days=days)).strftime("%Y-%m-%d"), since)   # 📒 قبل «بداية جديدة» ما ينحسب
    except Exception:
        return {}
    out = {}
    for row in hist if isinstance(hist, list) else []:
        if not isinstance(row, dict):
            continue
        day = str(row.get("time") or "")[:10]
        if len(day) != 10 or day < cut:
            continue
        msg = str(row.get("msg") or "")
        m = _RI_RE_IN.search(msg)
        if m:
            e = out.setdefault(day, {"n": 0.0, "r": 0.0, "c": 0})
            e["r"] += float(m.group(1))
            if "% من" not in msg:
                e["c"] += 1
            continue
        m = _RI_RE_SELL.search(msg)
        if m:
            e = out.setdefault(day, {"n": 0.0, "r": 0.0, "c": 0})
            e["n"] += float(m.group(1)) * nfv
            e["c"] += 1
            continue
        m = _RI_RE_CU.search(msg)                          # ⚡ ربح اللحاق (البيع المجمّع) — كان يطيح من ربح التداول
        if m:
            e = out.setdefault(day, {"n": 0.0, "r": 0.0, "c": 0})
            e["n"] += float(m.group(1)) * nfv            # نفس مقياس سطر البيع (المحرك يكتبه قبل المعامل)
            e["c"] += int(m.group(2) or 0)                # كل مستوى بيعة
    _HDP_CACHE[hp] = (ck, {k: dict(v) for k, v in out.items()})
    return out


def _ri_state_of(st):
    """💠 لقطة إعادة الاستثمار من ملف حالة: الربح اللي لسه داخل الأوامر · المسلَّم للمُراكِم · النسبة.

    «داخل الأوامر» = قيمة كل درجة (الحصّالة + النمو × سعر الدرجة) ناقص رأس المال المحقون
    + يتيم + نمو أوامر حيّة تنتظر التفكيك. بسعر الدرجة ⇒ ما يتحرك بحركة السوق."""
    ri = (st or {}).get("reinvest")
    if not isinstance(ri, dict):
        return None
    held = 0.0
    for lv in (ri.get("levels") or {}).values():
        try:
            px = float(lv.get("px") or 0)
            tot = float(lv.get("usd_book") or 0) + float(lv.get("grown_qty") or 0) * px
            cap = min(max(0.0, float(lv.get("inj_book") or 0) + float(lv.get("inj_grown") or 0)), max(0.0, tot))
            held += max(0.0, tot - cap)
        except Exception:
            continue
    held += float(ri.get("orphan_usd") or 0)
    for e in (ri.get("unwind") or {}).values():
        try:
            held += max(0.0, float(e.get("grown_qty") or 0) * float(e.get("px") or 0) - float(e.get("inj") or 0))
        except Exception:
            continue
    pc = ri.get("pct")
    return {"on": bool(ri.get("on")), "held": held, "handoff": float(ri.get("handoff_total") or 0),
            "pct": 100.0 if pc is None else float(pc), "levels": len(ri.get("levels") or {}),
            "used": bool(ri.get("on") or ri.get("levels") or ri.get("unwind")
                         or float(ri.get("handoff_total") or 0) > 0 or float(ri.get("orphan_usd") or 0) > 0)}


def _tp_bots():
    """بوتات الدولار (جرد بأنواعه) — نفس اللي يدخل السجل اليومي: بلا ديمو وبلا DCA وبلا الدوري (دفاترهم من سجل دوراتهم)."""
    out = {}
    for b in bot_dirs().values():
        c0 = b.get("cfg") or {}
        if c0.get("is_demo") or c0.get("bot_type") in _NONGRID:
            continue
        out[os.path.relpath(b["dir"], ROOT)] = b
    return out


def trade_period(start, end):
    """🧮 ربح التداول لفترة (تواريخ شاملة) — لكل عملة ولكل يوم: بدون · 💠 · المحرر · البيعات.

    📚 v3.22.3: الأيام من محرّك واحد (`_pv_per_rows`) — نفس التقرير بالواجهة والشريط والإجماليات بالضبط:
      يوم بيه بيعات بالأرشيف (أو بسجل الصفقات الحي) ⇒ «بدون» n + 💠 r بيوم البيعة (لكل بوت، بإعادة استثمار أو بدون)
      يوم قبل ما يبدي أرشيف البوت ⇒ الدفتر (وقتها المحرر = المكسوب) · DCA الشرائي ⇒ الدفتر (صافي لكل دورة).
    والمحرر من السجل اليومي — فيوم التحرير يطلع المحرر أكبر من «بدون» بمبلغ التحرير، **وما ينحسب ربح تداول مرتين**."""
    d0 = datetime.strptime(start, "%Y-%m-%d")
    d1 = datetime.strptime(end, "%Y-%m-%d")
    days = []
    while d0 <= d1:
        days.append(d0.strftime("%Y-%m-%d"))
        d0 += timedelta(days=1)
    led = load_json(LEDGER) or {}
    arc = load_json(RI_LEDGER) or {}
    if not isinstance(led, dict):
        led = {}
    if not isinstance(arc, dict):
        arc = {}
    abots = arc.get("bots") or {}
    if not isinstance(abots, dict):
        abots = {}
    cur = _tp_bots()
    recb = {os.path.relpath(x["dir"], ROOT): x for x in bot_dirs().values()
            if _is_rec(x) and not (x.get("cfg") or {}).get("is_demo")}
    arcl = _arc_live(abots)                 # نفس نافذة `reinvest_tick` (20 يوم) — الأقدم بالأرشيف أصلاً
    keys = ({k for k, v in led.items() if not str(k).startswith("_") and isinstance(v, dict)}
            | {k for k in arcl if not str(k).startswith("_")} | set(cur))
    per, _ = _pv_per_rows(led, arcl, keys, datetime.strptime(start, "%Y-%m-%d").date(),
                          datetime.strptime(end, "%Y-%m-%d").date(), arc.get("daily") or {}, _ri_keyset(arcl))
    per_day = {d: {"n": 0.0, "r": 0.0, "rel": 0.0, "c": 0} for d in days}
    coins, bots_out = {}, {}
    for key in sorted(keys):
        le = led.get(key) if isinstance(led.get(key), dict) else {}
        ae = arcl.get(key) or {}
        b = cur.get(key)
        sym = (b or {}).get("symbol") or le.get("symbol") or ae.get("symbol") or key
        rs = None
        if b is not None:
            rs = _safe(_ri_state_of, _safe(load_json, paths_of(b)[0], default={}) or {}, default=None)
        elif key in recb:
            rs = _safe(_rec_rs, recb[key], usd=True, default=None)  # 🔁 الدوري الشرائي: 💠 المعاد استثماره داخل البوت (دولار)
        is_ri = bool(rs and rs["used"]) or any(float((v or {}).get("r") or 0) > 0
                                                for v in (ae.get("daily") or {}).values())
        c = coins.setdefault(sym, {"n": 0.0, "r": 0.0, "rel": 0.0, "c": 0, "bots": [], "ri": False,
                                   "held": 0.0, "handoff": 0.0, "pct": None, "on": False})
        c["bots"].append(key)
        if is_ri:
            c["ri"] = True
        if rs:
            c["held"] += rs["held"]
            c["handoff"] += rs["handoff"]
            if rs["used"]:
                pc_cfg = ((b or {}).get("cfg") or {}).get("reinvest_pct")
                c["pct"] = float(pc_cfg) if pc_cfg is not None else rs["pct"]
                c["on"] = c["on"] or rs["on"]
        bref = bots_out.setdefault(key, {"sym": sym, "n": 0.0, "r": 0.0, "rel": 0.0, "c": 0, "ri": is_ri})
        rows = per.get(key) or {}
        tdl = le.get("trades_daily") or {}
        for d in days:
            x = rows.get(d)
            if not x:
                continue
            n, r, k, rel = x[0], x[1], x[2], x[3]
            if k is None:                   # يوم من الدفتر (قبل الأرشيف): عدد البيعات من الدفتر لو موجود
                k = int(tdl.get(d) or 0)
            for tgt in (per_day[d], c, bref):
                tgt["n"] += n
                tgt["r"] += r
                tgt["rel"] += rel
                tgt["c"] += int(k)
        bref["ri"] = is_ri
    # 💠 أيام قبل v3.11: الأرشيف القديم كان يخزّن المجموع بس — الزايد عن الموزّع ينعرض «غير موزّع» (نفس صف التقرير)
    unassigned = 0.0
    for d, x in (per.get(_RI_LEGACY_K) or {}).items():
        if d in per_day:
            per_day[d]["r"] += x[1]
            unassigned += x[1]
    tot = {"n": 0.0, "r": 0.0, "rel": 0.0, "c": 0}
    for d in days:
        for k in tot:
            tot[k] += per_day[d][k]
    return {"days": days, "per_day": per_day, "coins": coins, "tot": tot, "unassigned": unassigned,
            "by_bot": bots_out}


_PV_TYPE_ALL = {"grid": "لانهائية", "grid_range": "مدى", "grid_plus": "بلس", "dca_buy": "DCA شرائي", "dca": "DCA بيعي",
                "rec_buy": "دوري شرائي", "rec_sell": "دوري بيعي"}


def coin_ledger_tick():
    """🪙 v3.22.2: «الربح المحرّر بالعملات» — مراقبة بس (ما يدخل أي حساب ثاني):
    ربح DCA البيعي (صافي لكل دورة من `cycles_log`) + العملة المحرّرة من إعادة الاستثمار (تسليمات الطابور — للمُراكِم أو للمحفظة).
    كل حدث مرة وحدة بمعرّفه (بوت|حدث) · بيومه الحقيقي · يبقى بعد حذف البوت."""
    cl = load_json(COIN_LEDGER) or {}
    if not isinstance(cl, dict):
        cl = {}
    seen_l = list(cl.get("seen") or [])
    seen = set(seen_l)
    daily = cl.setdefault("daily", {})
    tot = {"dca": cl.setdefault("total_dca", {}), "ri": cl.setdefault("total_ri", {}), "rec": cl.setdefault("total_rec", {})}
    bots = cl.setdefault("bots", {})
    changed = False
    live_g = set()                                     # 🔢 v3.25.4: كل حدث لسه بسجل بوت
    for b in bot_dirs().values():
        c0 = b.get("cfg") or {}
        if c0.get("is_demo"):
            continue
        st = _safe(load_json, paths_of(b)[0], default={}) or {}
        key = os.path.relpath(b["dir"], ROOT)
        base = str(b["symbol"]).split("-")[0].upper()
        evs = []
        if c0.get("bot_type") == "dca":
            for c in (st.get("cycles_log") or []):
                if c.get("id"):
                    evs.append(("dca:" + str(c["id"]), c.get("profit"), c.get("ts"), "dca"))
        if c0.get("bot_type") in _REC_T:                 # 🔁 v3.25.0: الدوري — ربح البيعي المحرر لكل صفقة + عملة سحب المعاد استثماره
            for eid, q, ts in (_safe(_rec_coin_events, b, st, default=[]) or []):
                evs.append((eid, q, ts, "rec"))
        for h in (_safe(_ri_handoffs_of, st, default=[]) or []):
            evs.append(("ri:" + str(h.get("id")), h.get("coin"), h.get("ts"), "ri"))
        for eid, q, ts, src in evs:
            gid = key + "|" + eid
            live_g.add(gid)
            if gid in seen:
                continue
            try:
                q = float(q or 0)
                day = datetime.fromtimestamp(float(ts or time.time())).strftime("%Y-%m-%d")
            except Exception:
                continue
            seen.add(gid); seen_l.append(gid); changed = True
            if abs(q) < 1e-12:
                continue
            d = daily.setdefault(day, {})
            e = d.setdefault(base, {"dca": 0.0, "ri": 0.0})
            e[src] = round(float(e.get(src) or 0) + q, 10)
            tot[src][base] = round(float(tot[src].get(base) or 0) + q, 10)
            be = bots.setdefault(key, {"sym": b["symbol"], "type": c0.get("bot_type") or "grid"})
            be[src] = round(float(be.get(src) or 0) + q, 10)
            journal("profit", f"🪙 {q:+.8g} {base} ربح محرّر بالعملة — {'DCA بيعي' if src == 'dca' else ('البوت الدوري' if src == 'rec' else 'تحرير إعادة الاستثمار')} · يوم {day}", "ok",
                    bot=key, sym=b["symbol"], event=eid, coin=q, base=base, day=day)
    if changed:
        cl["seen"] = list(dict.fromkeys([x for x in seen_l if x in live_g] + seen_l[-30000:]))   # 🔢 v3.25.4: اللي لسه بسجلات البوتات ما ينمسح
        try:
            save_json_atomic(COIN_LEDGER, cl)
        except Exception:
            pass
    return cl


def coins_period(start, end):
    """🪙 الربح المحرّر بالعملات لفترة (تواريخ شاملة): {العملة: {"dca", "ri", "rec", "t"}} — من دفتر العملات."""
    cl = load_json(COIN_LEDGER) or {}
    out = {}
    for d, row in ((cl.get("daily") or {}) if isinstance(cl, dict) else {}).items():
        if not (start <= d <= end) or not isinstance(row, dict):
            continue
        for base, e in row.items():
            o = out.setdefault(base, {"dca": 0.0, "ri": 0.0, "rec": 0.0, "t": 0.0})
            for k in ("dca", "ri", "rec"):
                v = float((e or {}).get(k) or 0)
                o[k] += v
                o["t"] += v
    return {k: {kk: round(vv, 10) for kk, vv in v.items()} for k, v in out.items() if abs(v["t"]) > 1e-12}


