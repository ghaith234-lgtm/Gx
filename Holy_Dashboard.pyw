}
/* ═══ 🎨 الثيمات — كل ثيم يغيّر المتغيّرات بس (الألوان الدلالية: أخضر ربح · أحمر خسارة · عنبري تنبيه) ═══ */
html[data-theme="ocean"]{--bg0:#020816;--bg1:#061431;--tx:#e6f0ff;--mut:#8ea3c7;--mut2:#5f7196;
  --vio-rgb:96 165 250;--vio2-rgb:37 99 235;--vio3-rgb:59 130 246;--cyan2-rgb:8 145 178;--cyan3-rgb:14 116 144;
  --surf-rgb:6 16 40;--surf2-rgb:4 12 30;--surf3-rgb:3 9 22;--surf4-rgb:10 26 58;--scrim-rgb:2 6 16;
  --big-a:#e0ecff;--tx2:#cfe0ff;--bgA:#0b1f4a;--bgB:#032a3a;--orb1:#2563eb;--orb2:#0891b2;--orb3:#0ea5e9;
  --modal-bg:linear-gradient(165deg,#0b1f45,#050e22);--tip-bg:#0a1a38;--coin-bg:#0d1d3f;--chart-bg:#050e22;--card2:#0a1731;--bd:#1c2c4d;--on-acc:#03121f}
