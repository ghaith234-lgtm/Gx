def engine_for(cfg):
    bt = cfg.get("bot_type") if isinstance(cfg, dict) else None
    if bt == "dca":
        return DCA_SRC, "dca.py", DCA_VERSION
    if bt == "dca_buy":
        return DCAB_SRC, "dca.py", DCAB_VERSION
    if bt == "grid_range":
        return GRIDR_SRC, "main.py", GRIDR_VERSION
    if bt == "grid_plus":
        return GRIDP_SRC, "main.py", GRIDP_VERSION
    return ENGINE_SRC, "main.py", ENGINE_VERSION

def start_all_bots():
    n = 0
    for b in bot_dirs().values():
        sp, _, _ = paths_of(b)
        if not is_alive(b["dir"], sp)[0]:
            try:
                write_cfg_keys(b["cfg_path"], {"auto_restart": True})
                ok2, _m = launch(b)
                if ok2:
                    n += 1
            except Exception:
                pass
    return n

def kill_all_bot_procs():
    """💀 قتل قسري لكل عمليات البوتات تحت هذا الجذر — يمسح أي عملية يتيمة عالقة على المنفذ"""
    n = 0
    try:
        if os.name == "nt":
            out = subprocess.run(["wmic", "process", "where", "name like 'python%'",
                                  "get", "ProcessId,CommandLine"], capture_output=True, text=True,
                                 timeout=12, creationflags=0x08000000).stdout
            rl = ROOT.lower()
            for line in out.splitlines():
                low = line.lower()
                if ("main.py" in low or "demo.py" in low) and rl in low:
                    pid = line.strip().split()[-1]
                    if pid.isdigit() and pid != str(os.getpid()):
                        subprocess.run(["taskkill", "/PID", pid, "/F", "/T"],
                                       capture_output=True, timeout=10, creationflags=0x08000000)
                        n += 1
        else:
            import signal as _sig
            try:
                out = subprocess.run(["ps", "aux"], capture_output=True, text=True, timeout=10).stdout
            except Exception:
                out = ""
            dirs = [os.path.abspath(d) for d in bot_dirs()]
            for line in out.splitlines():
                if "main.py" not in line and "demo.py" not in line:
                    continue
                parts = line.split(None, 10)
                if len(parts) < 2 or not parts[1].isdigit():
                    continue
                pid = int(parts[1])
                if pid == os.getpid():
                    continue
                hit = any(d in line for d in dirs)
                if not hit:
                    try:
                        cwd = os.readlink("/proc/%d/cwd" % pid)
                        hit = any(os.path.abspath(cwd) == d for d in dirs)
                    except Exception:
                        hit = False
                if hit:
                    try:
                        os.kill(pid, _sig.SIGKILL)
                        n += 1
                    except Exception:
                        pass
    except Exception:
        pass
    return n

def stop_all_bots(reason=""):
    n = 0
    for b in bot_dirs().values():
        try:
            sp, _, _ = paths_of(b)
            if is_alive(b["dir"], sp)[0]:
                stop_bot(b, disable_auto=True)
                n += 1
        except Exception:
            pass
    if n and reason:
        tg_send(f"⏻ {reason} — توقف {n} بوت بأمان (أوامرهم المحددة باقية على المنصة)")
    return n

def _write_state_flag(sp, key, val):
    try:
        st = json.load(open(sp, encoding="utf-8")) if os.path.exists(sp) else {}
    except Exception:
        st = {}
    st[key] = val
    tmp = sp + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(st, f, ensure_ascii=False)
    os.replace(tmp, sp)

def delete_purge(b):
    """💣 حذف نهائي: البوت الحي يلغي أوامره بنفسه؛ الميت تلغى أوامره من اللوحة (بصمته فقط) — ثم أرشفة"""
    sp, _, _ = paths_of(b)
    cfg = b["cfg"]; sym = b["symbol"]; cancelled = 0; via = ""
    if is_alive(b["dir"], sp)[0]:
        _write_state_flag(sp, "self_destruct", True)
        for _ in range(14):
            time.sleep(1)
            try:
                stx = json.load(open(sp, encoding="utf-8"))
            except Exception:
                stx = {}
            if stx.get("destruct_done") or not is_alive(b["dir"], sp)[0]:
                cancelled = -1; via = "بإيد البوت نفسه"
                break
    if cancelled == 0 and not cfg.get("is_demo"):
        k, s, p = cfg.get("api_key", ""), cfg.get("secret_key", ""), cfg.get("passphrase", "")
        bid = str(cfg.get("bot_id") or "")
        if k and s and p and bid:
            r = _okx_get(f"/api/v5/trade/orders-pending?instType=SPOT&instId={sym}", k, s, p)
            ords = [d for d in ((r or {}).get("data") or []) if str(d.get("clOrdId") or "").startswith(bid)]
            for i in range(0, len(ords), 20):
                chunk = [{"instId": sym, "ordId": d["ordId"]} for d in ords[i:i + 20]]
                rc = _okx_post("/api/v5/trade/cancel-batch-orders", chunk, k, s, p)
                if rc and str(rc.get("code")) in ("0", "2"):
                    cancelled += sum(1 for x in (rc.get("data") or []) if str(x.get("sCode")) == "0")
            via = "من اللوحة — أوامر البوت فقط حسب بصمته"
    res = delete_bot(b)
    extra = " — البوت ألغى أوامره " + via if cancelled == -1 else (f" — ألغيت {cancelled} أمر {via}" if cancelled > 0 else "")
    res["msg"] = (res.get("msg") or "") + extra
    return res

def upgrade_engines():
    upd, restarted, skipped = [], [], []
    for b in bot_dirs().values():
        eng_src, eng_script, eng_ver = engine_for(b["cfg"])  # المحرك الصحيح حسب النوع
        mp = os.path.join(b["dir"], eng_script)
        if b["cfg"].get("is_demo") and not os.path.exists(mp):
            skipped.append(b["symbol"]); continue
        try:
            cur = _file_fp(mp) if os.path.exists(mp) else ""
            if cur == eng_ver:
                continue
            sp, _, _ = paths_of(b)
            was = is_alive(b["dir"], sp)[0]
            if was:
                stop_bot(b, disable_auto=False)
                time.sleep(0.6)
            if os.path.exists(mp):
                shutil.copy2(mp, os.path.join(b["dir"], eng_script.replace(".py", "_backup.py")))
            with open(mp, "w", encoding="utf-8") as f:
                f.write(eng_src)
            upd.append(b["symbol"])
            if was:
                launch(b); restarted.append(b["symbol"])
        except Exception as ex:
            skipped.append(f"{b['symbol']}({ex})")
    if not upd and not skipped:
        return {"ok": True, "msg": f"🧬 كل البوتات أصلاً على آخر محرك"}
    msg = f"🧬 تحدّث المحرك بـ {len(upd)} بوت"
    if restarted: msg += f" — أعيد تشغيل {len(restarted)}"
    if skipped: msg += f" — تخطيت: {', '.join(skipped)}"
    tg_send(f"🧬 *تحديث المحرك*\n" + (", ".join(upd) if upd else "—"))
    return {"ok": True, "msg": msg}

def _port_busy(port):
    import socket
    try:
        s = socket.create_connection(("127.0.0.1", port), timeout=0.4)
        s.close()
        return True
    except Exception:
        return False

def _kill_port_squatter(port, pin=""):
    """يطفي أي محرك ماسك المنفذ: بأدب (die) أولاً، وإذا نسخة قديمة لا تعرفه → بالقوة عبر netstat/taskkill"""
    try:
        hdr = {"Content-Type": "application/json"}
        if pin:
            hdr["X-Dash-Pin"] = str(pin)
        req = urllib.request.Request(f"http://127.0.0.1:{port}/api/control",
                                     data=json.dumps({"action": "die"}).encode(), headers=hdr)
        urllib.request.urlopen(req, timeout=3)
    except Exception:
        pass
    time.sleep(1.0)
    if not _port_busy(port):
        return True
    if os.name == "nt":
        try:
            out = subprocess.check_output(["netstat", "-ano"], text=True, creationflags=0x08000000)
            me = str(os.getpid())
            for line in out.splitlines():
                u = line.split()
                if len(u) >= 5 and f":{port}" in u[1] and "LISTEN" in line.upper() and u[-1].isdigit() and u[-1] not in (me, "0"):
                    subprocess.call(["taskkill", "/F", "/PID", u[-1]], creationflags=0x08000000)
            time.sleep(0.8)
            return not _port_busy(port)
        except Exception:
            return False
    return False

def _block_forever():
    try:
        threading.Event().wait()
    except KeyboardInterrupt:
        pass

def main():
    # إذا فُتح بالدبل-كلك عبر pythonw (الصامت) — أعد تشغيله بـ python.exe ليعمل كل شيء (نافذة كروم تطبيق)
    if (os.name == "nt" and not getattr(sys, "frozen", False)
            and "pythonw" in os.path.basename(sys.executable).lower()
            and "--relaunched" not in sys.argv and "--stop" not in sys.argv):
        py = sys.executable.lower().replace("pythonw.exe", "python.exe")
        if os.path.exists(py):
            try:
                # 0x08000000 = CREATE_NO_WINDOW: يشغّل python.exe بلا نافذة سوداء مزعجة
                subprocess.Popen([py, os.path.abspath(__file__), "--relaunched"] + sys.argv[1:],
                                 creationflags=0x08000000)
                return
            except Exception:
                pass  # لو فشل، نكمل عادي
    c = dash_cfg()
    port = int(c.get("dash_port", c.get("port", 8077)))
    if "--stop" in sys.argv:
        busy = _port_busy(port)
        if busy:
            _kill_port_squatter(port, str(c.get("pin", c.get("dash_pin", "")) or ""))
        k = kill_all_bot_procs()   # اقتل كل البوتات مباشرة أيضاً (لا تعتمد على إشارة المحرك)
        if busy or k:
            print(f"🛑 توقف كل شيء — أُغلق المحرك و{k} بوت")
        else:
            print("ℹ️ ماكو شيء شغال أصلاً")
        return
    headless = ("--headless" in sys.argv) or ("--no-browser" in sys.argv)
    # 🐧 سيرفر لينكس بلا شاشة: لا نافذة ممكنة — نعمل بالخلفية تلقائياً
    #    (يمنع الخروج الفوري لو نُسي --headless مع nohup)
    if not headless and os.name != "nt" and not os.environ.get("DISPLAY"):
        headless = True
        print("🐧 لا شاشة (DISPLAY) — أعمل بوضع الخلفية تلقائياً")
    owner = not _port_busy(port)
    url = f"http://127.0.0.1:{port}"
    if not owner:
        same = False
        try:
            with urllib.request.urlopen(url + "/api/overview", timeout=3) as _r:
                same = (json.loads(_r.read().decode("utf-8")).get("engine_v") == ENGINE_VERSION)
        except Exception:
            same = False
        if same:
            print("⚡ نفس النسخة شغالة بالخلفية — أفتح نافذة عليها")
        else:
            print("♻️ نسخة قديمة ماسكة المنفذ — أطردها وأستلم…")
            if _kill_port_squatter(port, str(c.get("pin", c.get("dash_pin", "")) or "")):
                owner = True
            else:
                print("⚠️ ما گدرت أطردها — اطفيها من إدارة المهام أو أعد تشغيل الحاسبة")
    if owner:
        threading.Thread(target=notifier_loop, daemon=True).start()
        threading.Thread(target=watchdog_loop, daemon=True).start()
        threading.Thread(target=ledger_loop, daemon=True).start()
        threading.Thread(target=reports_loop, daemon=True).start()
        threading.Thread(target=health_loop, daemon=True).start()
        threading.Thread(target=heartbeat_loop, daemon=True).start()
        threading.Thread(target=accum_loop, daemon=True).start()
        # 🔔 كشف انقطاع سابق + تسجيل مقابض الإطفاء
        try:
            boot_notice()
            import signal as _sg
            # ⚠️ SIGTERM/SIGINT فقط — لا نسجّل SIGHUP إطلاقاً:
            #    nohup يضبطها على التجاهل، وتسجيل مُعالج يُبطل حمايته
            #    فتموت اللوحة بمجرد إغلاق جلسة SSH.
            for _s in ("SIGTERM", "SIGINT"):
                if hasattr(_sg, _s):
                    try: _sg.signal(getattr(_sg, _s), _graceful_bye)
                    except Exception: pass
            # حماية مضاعفة: لو لم يستعمل المستخدم nohup، نتجاهلها بأنفسنا
            if hasattr(_sg, "SIGHUP"):
                try: _sg.signal(_sg.SIGHUP, _sg.SIG_IGN)
                except Exception: pass
        except Exception:
            pass
        threading.Thread(target=balances_loop, daemon=True).start()
        threading.Thread(target=guard_loop, daemon=True).start()   # 🛡️ حارس المطابقة
        threading.Thread(target=qa_sample_loop, daemon=True).start()   # 👀 v3.21.5: لمح أوامر البيع لتدقيق الكميات (قراءة فقط)
        threading.Thread(target=price_loop, daemon=True).start()
