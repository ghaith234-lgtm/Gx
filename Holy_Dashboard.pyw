                     "acc": R.get("cb")})
    cg = db.get("cg") or {}
    n = cg.get("now")
    if n:
        dd = cg.get("d") or {}
        t = max(int(k) for k in dd) if dd else 0
        p7 = _mkt_back(dd, t, 7) if dd else None
        s = 1 if n["chg"] >= 2 else -1 if n["chg"] <= -2 else 0
        sc.append(s)
