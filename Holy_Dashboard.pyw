html[data-theme="light"] .card:hover{box-shadow:0 14px 34px rgb(60 40 120/.16)}
html[data-theme="light"] .modal{box-shadow:0 24px 60px rgb(60 40 120/.22)}
html[data-theme="light"] button.primary,html[data-theme="light"] .dcabuy.loss{color:#fff}
html[data-theme="light"] nav.actions .grp button[style*="gradient"]{color:#fff!important}
html[data-theme="light"] .tot b{background:linear-gradient(92deg,#0e7490,#6d28d9);-webkit-background-clip:text;background-clip:text}
html[data-theme="light"] .st .sv>span,html[data-theme="light"] .st .sv.rotv{background:linear-gradient(92deg,#0e7490,#6d28d9);-webkit-background-clip:text;background-clip:text}
html[data-theme="light"] .card.dead{filter:saturate(.55) brightness(.97)}
html[data-theme="light"] .orb{opacity:.42}
html[data-theme="light"] ::-webkit-scrollbar-thumb{background:rgb(109 40 217/.22)}
html[data-theme="graphite"] .orb{display:none}

/* ═══ ⚡ الوضع الخفيف — بلا حركات دائمة ولا ضبابية ولا أجرام (للموبايل والأجهزة الضعيفة) ═══ */
html.lite .orb{display:none}
html.lite *,html.lite *::before,html.lite *::after{backdrop-filter:none!important;-webkit-backdrop-filter:none!important}
html.lite .pulse,html.lite .pill.ok::before,html.lite .lmark,html.lite .pmk::after,html.lite .belldot,
html.lite .fgw.ext .fga,html.lite .pscan{animation:none!important}
html.lite .pscan{display:none}
html.lite body.boot .card{animation:none}
html.lite header{background:rgb(var(--surf2-rgb)/.96)}
html.lite .page{background:rgb(var(--surf3-rgb)/.97)}
html.lite .mbg{background:rgb(var(--scrim-rgb)/.82)}
html.lite #notifPanel{background:rgb(var(--surf-rgb)/.98)}
html.lite .card:hover,html.lite button:hover{transform:none}

/* ═══ ⚡ خفة دائمة: الكرت برّا الشاشة ما ينرسم (ولا حركاته) لحد ما يقرب · النبضات على بطاقة الرسوميات مو المعالج ═══ */
.card{content-visibility:auto;contain-intrinsic-size:auto 560px}
.pulse,.pill.ok::before,.pmk::after,.lmark,.belldot{will-change:transform,opacity}

/* ═══ 🎨 أزرار الثيمات بالإعدادات ═══ */
.thgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(104px,1fr));gap:8px}
.thb{display:flex;flex-direction:column;align-items:center;gap:6px;padding:10px 6px;border-radius:12px;font-size:11.5px;min-height:74px}
.thb .sw3{display:flex;gap:3px;padding:4px;border-radius:9px;border:1px solid var(--line)}
.thb .sw3 i{width:14px;height:14px;border-radius:50%;display:block}
.thb.on{border-color:var(--amber);box-shadow:inset 0 0 0 1px rgb(var(--amber-rgb)/.35)}
.pollrow{display:flex;gap:6px;flex-wrap:wrap}
.pollrow button{padding:7px 12px;font-size:12px}
.pollrow button.on{border-color:var(--amber);color:var(--amber)}

/* ═══ 🩹 إصلاحات فحص الواجهة ═══ */
.modal{max-width:100%}
@media (max-width:520px){.mbg{padding:10px}.modal{padding:18px 15px;border-radius:18px}}
/* 💰 v3.31.1: صفوف «محفظتي في المنصة» — أعمدة ثابتة حتى الأرقام تصطف تحت بعض */
.fxr{display:grid;grid-template-columns:22px 64px minmax(0,1fr) 56px 84px 92px;grid-template-areas:"i n q p c v";align-items:center;column-gap:9px;font-size:12.5px;line-height:20px}
.fxr>.coin{grid-area:i}.fxr .fxn{grid-area:n;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.fxr .fxq{grid-area:q;min-width:0;display:flex;flex-wrap:wrap;align-items:center;gap:0 9px;color:var(--mut)}.fxr .fxq>span{line-height:18px;height:18px}.fxr .fxl{color:var(--mut2);font-size:10.5px}
.fxr .fxp{grid-area:p;justify-self:end;font-size:10.5px;white-space:nowrap}.fxr .fxc{grid-area:c;justify-self:start;display:flex;line-height:16px}
.fxr .fxv{grid-area:v;justify-self:end;white-space:nowrap}
@media (max-width:600px){.fxr{grid-template-columns:22px minmax(0,1fr) auto 80px;grid-template-rows:20px minmax(18px,auto);grid-template-areas:"i n p v" "i q q c";row-gap:2px;padding:3px 0;line-height:18px}
  .fxr>.coin{align-self:center}.fxr .fxn{font-size:13px;line-height:20px}.fxr .fxv{line-height:20px}.fxr .fxq{font-size:11px;gap:0 6px}.fxr .fxl{font-size:10px}
  .fxr .fxc{justify-self:end}.fxr.nofx{grid-template-areas:"i n p v" "i q q q"}.fxr.nofx .fxc{display:none}}   /* USDT (بلا أثر سعر): الكمية تاخذ السطر كله */
@media (max-width:380px){.fxr{grid-template-columns:22px minmax(0,1fr) auto 72px;column-gap:8px}.fxr .fxq{font-size:10.5px}.fxr .fxl{font-size:9.5px}}
.bench{min-width:0}
.dline .dlbl{font-size:9.5px}
.bigprice.long{font-size:17px}
.bidi{unicode-bidi:isolate;direction:ltr;display:inline-block}
.tape2 .iv{unicode-bidi:isolate;direction:rtl}.tape2 .iv b{unicode-bidi:isolate;direction:ltr}

</style>
