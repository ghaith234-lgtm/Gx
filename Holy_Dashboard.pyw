                    snap["qa_badn"].append(name)
            snap["bots"][name] = {
                "sym": sym, "type": bt or "grid", "dca": is_dca, "alive": alive, "hb_age": hb_age,
                "auto": bool(cfg.get("auto_restart")), "cp": cp, "g": g, "step": step,
                "fill_ts": hs["fill_ts"], "fill_px": hs["fill_px"], "cycle_ts": hs["cycle_ts"],
                "reject_ts": hs["reject_ts"], "floor": float(st.get("buy_floor") or 0),
                "ceil": float(st.get("sell_ceiling") or 0), "paused": bool(st.get("paused")),
                "destruct": bool(st.get("destruct_done") or st.get("self_destruct")),
                "min_price": float(cfg.get("min_price") or 0),
                "lo": float(cfg.get("lower_price") or 0), "hi": float(cfg.get("upper_price") or 0),
                "base": base, "quote": quote, "tracked": n_tr, "ids": _gd_bot_ids(b),
                "rungs": _gd_rungs(st, is_dca)}
        except Exception as e:
            snap["err"].append(f"قراءة بوت {b.get('symbol')}: {type(e).__name__}")
            snap["qa_bad"].append(str(b.get("symbol") or "").split("-")[0])          # 🧮 عملته ما تنقارن هالجولة
            snap["qa_badn"].append(os.path.basename(str(b.get("dir") or "").rstrip("/\\")))
    # ── ٢ · المُراكِم (محفظته فقط) — الكمية من Holy_Accum.json لا من الإعدادات ──
    if W.get("acc"):
        try:
            ast_ = acc_state()
            for a in acc_cfgs():
                aid = a.get("id")
                sym = str(a.get("symbol") or "")
                base = sym.split("-")[0]
                if not aid or not base:
                    continue
                e = ast_.get(aid) or {}
                qa = float(e.get("coin") or 0)
                snap["acc"][aid] = {"base": base, "coin": qa, "name": str(a.get("name") or sym)}
                c = snap["coins"].setdefault(base, {"mode": "acc", "base_exp": 0.0, "handoff": 0.0,
                                                    "acc": 0.0, "bots": [], "px": 0.0, "tol_q": 0.0,
                                                    "inflight": False})
                c["acc"] += qa
                if e.get("inflight") or e.get("sell_inflight"):
                    c["inflight"] = True       # ⏳ أمر مُراكِم ينتظر التسوية — الرصيد سابق الدفتر
                if not c["px"]:
                    c["px"] = float(PX.get(sym) or 0)
                modes.setdefault(base, set()).add("acc")
            for _b, _q in ((ast_.get("_ri_left") or {}).items()):   # 👛 باقي تسليمات بنسبة أقل من 100%
                if _b in snap["coins"]:
                    snap["coins"][_b]["acc"] += float(_q or 0)
            snap["acc_ok"] = True
        except Exception as e:
            snap["err"].append(f"المُراكِم: {type(e).__name__}")
    for ccy, c in snap["coins"].items():
        m = modes.get(ccy) or set()
        if "dca" in m:
            c["mode"] = "dca"          # DCA يستعمل رصيد المحفظة الحر — ولا معادلة ثابتة لعملته
        elif "quote" in m:
            c["mode"] = "mixed"        # عملة تسعير لبوت ثاني بنفس المحفظة — تتحرك مع صفقاته
        elif "grid" in m:
            c["mode"] = "grid"
        else:
            c["mode"] = "acc"
    # ── ٣ · أدلة المنصة (تنفيذات + حركات رصيد) منذ آخر فحص ──
    cur = int(pw.get("cursor") or 0)
    now_ms = int((now + float((_TS_OFF or {}).get("off") or 0)) * 1000)
    if cur <= 0:
        snap["baseline"] = True            # أول فحص: نبدي العدّ من الآن (ما ننبش الماضي)
        snap["ok_ev"] = snap["ev_complete"] = True
        snap["ev_max"] = now_ms
    else:
        begin = max(cur - 120000, now_ms - 3 * 86400000 + 60000)   # التنفيذات متاحة 3 أيام
        fills, fc = _gd_pages(f"/api/v5/trade/fills?instType=SPOT&limit=100&begin={begin}",
                              keys, "billId", begin)
        bills, bc = _gd_pages(f"/api/v5/account/bills?limit=100&begin={begin}",
                              keys, "billId", begin)
        if fills is not None and bills is not None:
            snap["ok_ev"] = True
            snap["ev_complete"] = bool(fc and bc)
            mx = 0
            for f in fills:
                try:
                    ts = int(f.get("ts") or f.get("fillTime") or 0)
                except Exception:
                    continue
                mx = max(mx, ts)
                if ts <= begin:
                    continue
                snap["fills"].append(dict({k2: f.get(k2) for k2 in (
                    "ordId", "clOrdId", "instId", "side", "fillSz", "fillPx", "fee", "feeCcy",
                    "tradeId", "billId")}, ts=ts))
            for x in bills:
                try:
                    ts = int(x.get("ts") or 0)
                except Exception:
                    continue
                mx = max(mx, ts)
                if ts <= begin or str(x.get("type")) == "2":
                    continue                       # التداول يُقرأ من التنفيذات (فيها clOrdId)
                snap["bills"].append(dict({k2: x.get(k2) for k2 in (
                    "billId", "ccy", "balChg", "type", "subType", "ordId")}, ts=ts))
            snap["ev_max"] = mx or cur
        else:
            snap["err"].append("أدلة المنصة (التنفيذات والتحويلات) غير متاحة — فحص الأرصدة فقط")
    # ── ٤ · الرصيد (عملة صفر تختفي من الرد ⇒ نعتبرها صفراً، مو «تجاوز») ──
    ccys = sorted(set(snap["coins"]) | set(snap["quotes"]))
    bal, ok = {}, True           # محفظة بلا عملات للفحص = ولا شي فشل
    for i in range(0, len(ccys), 18):
        chunk = ccys[i:i + 18]
        r = _okx_get("/api/v5/account/balance?ccy=" + ",".join(chunk), *keys)
        if not r or str(r.get("code")) != "0":
            ok = False
            snap["err"].append("الرصيد: " + _gd_errtxt(r))
            break
        for dt in ((r.get("data") or [{}])[0].get("details") or []):
            try:
                cc = str(dt.get("ccy") or "")
                cash = float(dt.get("cashBal") or 0)
                av = float(dt.get("availBal") or 0)
                fr = float(dt.get("frozenBal") or 0)
                if not cash and (av or fr):
                    cash = av + fr
                bal[cc] = {"cash": cash, "avail": av, "frozen": fr}
            except Exception:
                continue
    if ok:
        for cc in ccys:
            bal.setdefault(cc, {"cash": 0.0, "avail": 0.0, "frozen": 0.0})
        snap["bal"], snap["ok_bal"] = bal, True
    # ── ٥ · الأوامر المفتوحة بالمنصة (قائمة كاملة وإلا ما نقارن) ──
    pend, pc = _gd_pages("/api/v5/trade/orders-pending?instType=SPOT&limit=100", keys, "ordId")
    if pend is not None and pc:
        snap["ok_pend"] = True
        for o in pend:
            try:
                snap["pending"][str(o.get("ordId"))] = {
                    "instId": str(o.get("instId") or ""), "side": str(o.get("side") or ""),
                    "px": float(o.get("px") or 0), "sz": float(o.get("sz") or 0),
                    "fill": float(o.get("accFillSz") or 0), "cl": str(o.get("clOrdId") or "")}
            except Exception:
                continue
    else:
        snap["err"].append("قائمة الأوامر المفتوحة غير متاحة — مطابقة الأوامر مؤجّلة")
    # ── ٦ · تفاصيل الأوامر المشبوهة فقط (مفقود مرتين · اختفى بلا تنفيذ) ──
    ask = []
    pm = ((pw.get("orders") or {}).get("missing") or {})
    if snap["ok_pend"]:
        for oid, t in snap["tracked"].items():
            if oid not in snap["pending"] and oid in pm:
                ask.append((oid, t["sym"]))
    if snap["ok_ev"] and not snap["baseline"]:
        fill_oids = {str(f.get("ordId")) for f in snap["fills"]}
        for oid, s in ((pw.get("orders") or {}).get("seen") or {}).items():
            if oid in snap["tracked"] or oid in fill_oids:
                continue
            try:
                ask.append((oid, s[4]))
            except Exception:
                continue
    for oid, sym in ask[:GUARD_MAX_DETAIL]:
        if not sym:
            continue
        r = _okx_get(f"/api/v5/trade/order?instId={sym}&ordId={oid}", *keys)
        if r and str(r.get("code")) == "0" and r.get("data"):
            d = r["data"][0]
            try:
                snap["details"][oid] = {"state": str(d.get("state") or ""),
                                        "fill": float(d.get("accFillSz") or 0),
                                        "src": str(d.get("cancelSource") or ""),
                                        "why": str(d.get("cancelSourceReason") or "")[:120]}
            except Exception:
                pass
        time.sleep(0.05)
    # ── ٧ · 🧮 v3.21.5: ختم ملفات الحالة بعد الرصيد والأوامر — انكتبت بنص الفحص ⇒ التدقيق يأجّل عملتها
    for b in W.get("bots") or []:
        try:
            _n = os.path.basename(str(b["dir"]).rstrip("/\\")) or b["symbol"]
            if _n in snap["qa_bots"]:
                snap["qa_mt1"][_n] = _safe(os.path.getmtime, paths_of(b)[0], default=None)
        except Exception:
            continue
    return snap


def _gd_side_ar(s):
    return "شراء" if s == "buy" else "بيع"


def _gd_apply(g, snap, now):
    """🧮 يدمج لقطة محفظة بملف الرقابة — منطق خالص بلا شبكة (يُختبر لوحده).

    الفرق يُعتمد بقراءتين (≥90 ثانية بينهما) — التنفيذ الجزئي وسباق حفظ الحالة
    يختفيان بالقراءة الثانية، فما ينرسل تنبيه كاذب."""
    wid = snap["wid"]
    W = _gd_wallet(g, wid)
    W["label"] = snap.get("label") or W.get("label") or wid
    W["err"] = " · ".join([e for e in (snap.get("err") or []) if e])[:400]
    W["last_try"] = now
    if snap.get("fatal"):
        W["err"] = "تعذّر فحص المحفظة (خطأ داخلي)"
        return
    if snap.get("ok_bal"):
        W["last_ok"] = now
    now_ms = int(now * 1000)
    bots = snap.get("bots") or {}
    # ── A · الأدلة: تداول من خارج البوتات · تحويلات · حركات أخرى ──
    new_ev = []
    bot_flow = {}                    # 🤖 حركة كل عملة الفعلية من تنفيذات البوتات والمُراكِم (من المنصة)
    flow_ok = bool(snap.get("ok_ev") and not snap.get("baseline"))
    if snap.get("ok_ev") and not snap.get("baseline"):
        seen = set(W.get("seen_ev") or [])
        fresh_ids = []
        prefixes = [(p, bn) for bn, bb in bots.items() for p in (bb.get("ids") or [])]
        known = set(snap.get("tracked") or {}) | set(((W.get("orders") or {}).get("seen") or {}).keys())
        manual = {}
        for f in snap.get("fills") or []:
            fid = "f:" + str(f.get("tradeId") or "") + ":" + str(f.get("billId") or "")
            if fid in seen:
                continue
            fresh_ids.append(fid)
            oid, cl = str(f.get("ordId") or ""), str(f.get("clOrdId") or "")
            if oid in known or any(cl.startswith(p) for p, _ in prefixes) or cl.startswith(_GD_ACC_CL):
                try:     # 🤖 تنفيذ بوت/مُراكِم: العملة تتحرك بالكمية ± الرسوم لو انخصمت بنفس العملة
                    _b = str(f.get("instId") or "").split("-")[0]
                    _sz, _fee = float(f.get("fillSz") or 0), float(f.get("fee") or 0)
                    _d = (_sz if str(f.get("side") or "") == "buy" else -_sz) \
                        + (_fee if str(f.get("feeCcy") or "") == _b else 0.0)
                    bot_flow[_b] = bot_flow.get(_b, 0.0) + _d
                    snap.setdefault("bot_fills", []).append([oid, str(f.get("side") or ""), _sz, _b, (_fee if str(f.get("feeCcy") or "") == _b else 0.0)])   # 🧮 v3.21.5: للتدقيق (تعليق باللقطة بس)
                except Exception:
                    pass
                continue
            try:
                sz, px = float(f.get("fillSz") or 0), float(f.get("fillPx") or 0)
                fee = float(f.get("fee") or 0)
            except Exception:
                continue
            m = manual.setdefault(oid, {"inst": str(f.get("instId") or ""), "side": str(f.get("side") or ""),
                                        "sz": 0.0, "val": 0.0, "fee": {}, "ts": 0})
            m["sz"] += sz
            m["val"] += sz * px
            fc = str(f.get("feeCcy") or "")
            m["fee"][fc] = m["fee"].get(fc, 0.0) + fee        # OKX: الرسوم سالبة = مدفوعة
            m["ts"] = max(m["ts"], int(f.get("ts") or 0))
        for oid, m in manual.items():
            base, quote = (m["inst"].split("-") + [""])[:2]
            buy = m["side"] == "buy"
            avg = m["val"] / m["sz"] if m["sz"] else 0.0
            db = (m["sz"] if buy else -m["sz"]) + m["fee"].get(base, 0.0)
            dq = (-m["val"] if buy else m["val"]) + m["fee"].get(quote, 0.0)
            txt = f"👤 {_gd_side_ar(m['side'])} من خارج البوتات {m['sz']:.8g} {base} @ {avg:.8g}"
            new_ev.append({"ccy": base, "q": db, "ts": m["ts"], "id": "o:" + oid, "txt": txt})
            if quote:
                new_ev.append({"ccy": quote, "q": dq, "ts": m["ts"], "id": "o:" + oid, "txt": txt})
            _gd_event(g, "fill:" + oid, "🟠", f"👤 تداول من خارج البوتات — {m['inst']}",
                      f"{_gd_side_ar(m['side'])} {m['sz']:.8g} {base} بمتوسط {avg:.8g} "
                      f"= {m['val']:.4f} {quote} — تطبيق أو برنامج ثاني بنفس الحساب",
                      wid=wid, sym=m["inst"], kind="manual_trade", status="info")
        for x in snap.get("bills") or []:
            bid = "b:" + str(x.get("billId") or "")
            if bid in seen:
                continue
            fresh_ids.append(bid)
            try:
                ccy, q = str(x.get("ccy") or ""), float(x.get("balChg") or 0)
            except Exception:
                continue
            if not ccy or abs(q) < 1e-12:
                continue
            t = str(x.get("type") or "")
            if t == "1":
                txt = f"🏦 تحويل {'داخل للحساب' if q > 0 else 'خارج من الحساب'} {q:+.8g} {ccy}"
                title = "🏦 " + ("إيداع/تحويل للحساب" if q > 0 else "سحب/تحويل من الحساب")
                kind = "transfer"
            else:
                txt = f"🔁 حركة رصيد ({_GD_BILL_TYPE.get(t, 'نوع ' + t)}) {q:+.8g} {ccy}"
                title, kind = "🔁 حركة رصيد مو تداول", "bill"
            new_ev.append({"ccy": ccy, "q": q, "ts": int(x.get("ts") or 0), "id": bid, "txt": txt})
            _gd_event(g, "bill:" + str(x.get("billId")), "🟠" if q < 0 else "🟡", title, txt,
                      wid=wid, sym=ccy, kind=kind, status="info")
        W["seen_ev"] = (fresh_ids + list(W.get("seen_ev") or []))[:1500]
    if snap.get("ok_ev") and snap.get("ev_complete"):
        W["cursor"] = max(int(W.get("cursor") or 0), int(snap.get("ev_max") or 0))
    # 🗑️ مُراكِم انحذف وعملته بقت بالمحفظة — دليل داخلي أكيد
    if snap.get("acc_ok"):
        for aid, a in (W.get("acc_seen") or {}).items():
            try:
                qa = float(a.get("coin") or 0)
            except Exception:
                qa = 0.0
            if aid not in (snap.get("acc") or {}) and qa > 0:
                txt = f"🗑️ حُذف مُراكِم «{a.get('name')}» — عملته {qa:.8g} {a.get('base')} بقت بالمحفظة"
                new_ev.append({"ccy": a.get("base"), "q": qa, "ts": now_ms, "id": "acc:" + aid, "txt": txt})
                _gd_event(g, "accdel:" + aid, "🟡", "🗑️ مُراكِم انحذف", txt, wid=wid,
                          sym=str(a.get("base")), kind="acc_del", status="info", tg=False)
        W["acc_seen"] = snap.get("acc") or {}
    # 🧮 v3.21.5: مجموع أدلة المنصة لكل عملة بهالفحص — تدقيق الكميات يحرّك خط أساسه بيها (بلا ما يعيد قراءتها)
    _evq = {}
    for _e in new_ev:
        try:
            _evq[_e["ccy"]] = _evq.get(_e["ccy"], 0.0) + float(_e.get("q") or 0)
        except Exception:
            continue
    snap["ev_q"] = _evq
    # ── B · مطابقة العملات (لكل محفظة × عملة) ──
    if snap.get("ok_bal"):
        for ccy, info in (snap.get("coins") or {}).items():
            c = _gd_coin(g, wid, ccy)
            act = float(((snap.get("bal") or {}).get(ccy) or {}).get("cash") or 0.0)
            c["bots"] = list(info.get("bots") or [])
            c["px"] = float(info.get("px") or c.get("px") or 0)
            c["act"], c["ts"], c["mode"] = act, now, info.get("mode")
            for e in new_ev:
                if e["ccy"] == ccy:
                    c["pev"].append({k: e[k] for k in ("q", "ts", "id", "txt")})
            c["pev"] = c["pev"][-40:]
            if info.get("mode") in ("dca", "mixed") or info.get("inflight"):
                c.update(exp=None, diff=None, strike=0, first_over=0)
                c.pop("alert", None)
                c.pop("book_prev", None)            # ينعاد تأسيسه لما يرجع للمطابقة
                if info.get("inflight"):
                    c["mode"] = "inflight"
                continue
            base_exp = float(info.get("base_exp") or 0) + float(info.get("handoff") or 0) + float(info.get("acc") or 0)
            # 🧮 المتوقَّع يتحرك **بالتنفيذات الفعلية** بس. أي حركة بالدفتر ما يقابلها تنفيذ =
            #    نقل بين رصيدك الحر وأوامر البوت (بيع مخزون ينفتح أعلى السلّم، أو يرجع) — والفرق
            #    بين كمية الشراء والعملة الواصلة = عمولة انخصمت بالعملة. الاثنين كانوا يطلعون «نقص»
            #    كاذب يرجع بعد كل اعتماد. هسه ينحسبون بالتسوية تلقائياً بقيد يومي مسجّل.
            #    الفرق الحقيقي (سحب · بيع من التطبيق · ضياع) ما يمر من هنا — يبقى يطلع تنبيه.
            _bp = c.get("book_prev")
            if flow_ok and _bp is not None:
                _dadj = float(bot_flow.get(ccy, 0.0)) - (base_exp - float(_bp))
                if abs(_dadj) > 1e-12:
                    _gd_book_hist(c, _dadj, now, px=float(info.get("px") or c.get("px") or 0))
            if flow_ok or _bp is None:
                c["book_prev"] = round(base_exp, 12)
            exp = base_exp + float(c.get("adj") or 0.0)
            diff = act - exp
            px = c["px"]
            tol = max(GUARD_TOL * max(base_exp, 1e-9), float(info.get("tol_q") or 0), 1e-8)
            c.update(base_exp=round(base_exp, 10), exp=round(exp, 10), diff=round(diff, 10),
                     tol=tol, handoff=float(info.get("handoff") or 0), acc=float(info.get("acc") or 0))
            pev_sum = sum(float(e.get("q") or 0) for e in c["pev"])
            if abs(diff) <= tol:
                c["strike"], c["first_over"] = 0, 0
                c.pop("alert", None)
                c.pop("snooze_until", None)
                c["ok_streak"] = int(c.get("ok_streak") or 0) + 1
                if c["ok_streak"] >= 2 and c["pev"]:   # حركات تعادلت (شراء ثم بيع نفس الكمية…)
                    c["pev_done"] = (c["pev"] + list(c.get("pev_done") or []))[:20]
                    c["pev"] = []
                continue
            c["ok_streak"] = 0
            if not c.get("first_over"):
                c["first_over"], c["strike"] = now, 1
            else:
                c["strike"] = int(c.get("strike") or 0) + 1
            confirmed = c["strike"] >= 2 and now - float(c["first_over"]) >= GUARD_CONFIRM_S
            explained = bool(c["pev"]) and abs(diff - pev_sum) <= tol
            al = {"diff": round(diff, 10), "usd": round(diff * px, 4), "exp": round(exp, 10),
                  "act": round(act, 10), "first": c["first_over"], "confirmed": confirmed,
                  "explained": explained, "ev": [e["txt"] for e in c["pev"]][-10:],
                  "ev_sum": round(pev_sum, 10), "tol": tol}
            sd = c.get("snooze_diff")
            if sd is not None and abs(float(sd) - diff) > 2 * tol:
                c.pop("snooze_until", None)          # الوضع تغيّر ⇒ التأجيل ينكسر
                c.pop("snooze_diff", None)
            if confirmed and explained and g.get("auto_fix"):
                _gd_hist(c, "auto", diff, note="تصحيح تلقائي — الفرق مفسَّر بالكامل بأدلة المنصة",
                         by="🤖 تلقائي", px=px, ev=al["ev"], exp=exp, act=act)
                _gd_event(g, f"auto:{wid}:{ccy}:{int(now)}", "🟢", f"🤖 صُحّح تلقائياً — {ccy}",
                          f"{diff:+.8g} {ccy} ≈ {diff * px:+.4f}$ · " + " · ".join(al["ev"][-4:]),
                          wid=wid, sym=ccy, kind="auto_fix", status="auto")
                c["pev"] = []
                c["strike"], c["first_over"] = 0, 0
                c.pop("alert", None)
                continue
            c["alert"] = al
    # ── C · الدولار (عملة التسعير): الحر مقابل أمر الشراء الجاي · المحجوز مقابل البوتات ──
    if snap.get("ok_bal"):
        for q, qi in (snap.get("quotes") or {}).items():
            b = (snap.get("bal") or {}).get(q) or {}
            okx_fr = None
            if snap.get("ok_pend"):
                okx_fr = sum(o["px"] * max(0.0, o["sz"] - o["fill"])
                             for o in (snap.get("pending") or {}).values()
                             if o.get("side") == "buy" and str(o.get("instId")).endswith("-" + q))
            rec = W["quotes"].setdefault(q, {})
            av = float(b.get("avail") or 0)
            rec.update(avail=av, cash=float(b.get("cash") or 0), frozen=float(b.get("frozen") or 0),
                       okx_frozen=(None if okx_fr is None else round(okx_fr, 6)),
                       bots_frozen=round(float(qi.get("bots_frozen") or 0), 6),
                       min_next=float(qi.get("min_next") or 0), ts=now)
            for e in new_ev:
                if e["ccy"] == q:
                    rec.setdefault("moves", []).insert(0, {k: e[k] for k in ("q", "ts", "txt")})
            rec["moves"] = (rec.get("moves") or [])[:20]
            key = f"low:{wid}:{q}"
            if rec["min_next"] > 0 and av < rec["min_next"]:
                _gd_event(g, key, "🟡", f"💵 رصيد {q} الحر أقل من أمر شراء واحد",
                          f"المتاح {av:.2f} {q} · أصغر أمر شراء {rec['min_next']:.2f} {q} — "
                          f"السلّم ما يگدر يمتد للأسفل، وأي أمر شراء جديد راح تنرفضه المنصة.",
                          wid=wid, sym=q, kind="low_quote")
            else:
                _gd_resolve(g, key)
    # ── D · مطابقة الأوامر أمراً بأمر ──
    O = W["orders"]
    tracked = snap.get("tracked") or {}
    if snap.get("ok_pend"):
        pending = snap.get("pending") or {}
        newm = {}
        for oid, t in tracked.items():
            if oid in pending:
                continue
            m = dict(O["missing"].get(oid) or {"first": now, "strike": 0})
            m.update(t)
            m["strike"] = int(m.get("strike") or 0) + 1
            newm[oid] = m
        O["missing"] = newm
        news = {}
        for oid, o in pending.items():
            if oid in tracked or o.get("cl", "").startswith(_GD_ACC_CL):
                continue
            s = dict(O["stray"].get(oid) or {"first": now, "strike": 0})
            s.update(o)
            s["strike"] = int(s.get("strike") or 0) + 1
            news[oid] = s
        O["stray"] = news
        for oid, s in news.items():
            if s["strike"] < 2 or now - float(s["first"]) < GUARD_CONFIRM_S:
                continue
            inst = s.get("instId") or ""
            base, quote = (inst.split("-") + [""])[:2]
            owner = next((bb["sym"] for bb in bots.values()
                          if any(s.get("cl", "").startswith(p) for p in (bb.get("ids") or []))), None)
            if owner:
                _gd_event(g, "stray:" + oid, "🟠", f"👻 أمر يتيم للبوت {owner}",
                          f"{_gd_side_ar(s.get('side'))} {s.get('sz', 0):.8g} @ {s.get('px', 0):.8g} — مفتوح "
                          f"بالمنصة والبوت ما يعرفه، ويحجز رصيداً. البوت الشغّال يلغيه بروحه؛ "
                          f"بقاؤه يعني البوت متوقف أو معلّق.", wid=wid, sym=inst, kind="stray")
            else:
                _gd_event(g, "stray:" + oid, "🟠", f"👤 أمر مفتوح مو من البوتات — {inst}",
                          f"{_gd_side_ar(s.get('side'))} {s.get('sz', 0):.8g} {base} @ {s.get('px', 0):.8g} "
                          f"= {s.get('sz', 0) * s.get('px', 0):.4f} {quote} — يحجز رصيداً عن البوتات. "
                          f"إذا مو إنت، ألغِه من التطبيق وغيّر مفاتيح الـAPI.", wid=wid, sym=inst, kind="stray")
        for e in g["events"]:
            if (e.get("status") == "open" and e.get("wid") == wid
                    and str(e.get("key", "")).startswith("stray:") and e["key"][6:] not in news):
                e["status"], e["resolved"] = "resolved", now
        # ✂️ أمر كان حياً بالفحص السابق واختفى من البوت: انلغى بالمنصة بلا تنفيذ ودرجته ضاعت
        fill_oids = {str(f.get("ordId")) for f in (snap.get("fills") or [])}
        for oid, s in (O.get("seen") or {}).items():
            if oid in tracked or oid in fill_oids:
                continue
            try:
                bn, side, px, qty, sym = s[0], s[1], float(s[2]), float(s[3]), s[4]
            except Exception:
                continue
            bb = bots.get(bn)
            d = (snap.get("details") or {}).get(oid)
            if not bb or bb.get("destruct") or not d:
                continue
            if d.get("state") != "canceled" or float(d.get("fill") or 0) > 0:
                continue
            tolp = px * (0.001 if bb.get("dca") else float(bb.get("g") or 0.008) * 0.3)
            if any(abs(x - px) <= tolp for x in ((bb.get("rungs") or {}).get(side) or [])):
                continue          # الدرجة موجودة (ذاكرة/مخزن/أُعيد نشرها) ⇒ البوت هو اللي حرّكها
            src = str(d.get("src") or "")
            srcl = _GD_CANCEL_SRC.get(src, (f"رمز {src}" if src else "مصدر غير معروف"))
            _gd_event(g, "cxl:" + oid, "🟠" if src == "32" else "🔴",
                      f"✂️ أمر للبوت {sym} انلغى من خارج البوت",
                      f"{_gd_side_ar(side)} {qty:.8g} @ {px:.8g} — المنصة تگول: {srcl}. "
                      f"الدرجة ضاعت من السلّم"
                      + (" وعملة البيع صارت حرة بالمحفظة" if side == "sell" else "") + ".",
                      wid=wid, sym=sym, kind="ext_cancel")
        O["seen"] = {oid: [t["bot"], t["side"], t["px"], t["qty"], t["sym"]] for oid, t in tracked.items()}
    O["n_tracked"] = len(tracked)
    if snap.get("ok_pend"):
        O["n_pending"] = len(snap.get("pending") or {})
    # ── E · صحة البوتات: الميت الصامت ──
    for bn, bb in bots.items():
        B = g["bots"].setdefault(bn, {})
        B.update(sym=bb["sym"], wid=wid, alive=bb["alive"], hb_age=bb.get("hb_age"),
                 fill_ts=bb.get("fill_ts"), fill_px=bb.get("fill_px"), cycle_ts=bb.get("cycle_ts"),
                 reject_ts=bb.get("reject_ts"), ts=now, type=bb.get("type"),
                 tracked=bb.get("tracked"), dca=bb.get("dca"))
        reasons = []
        key = "bot:" + bn
        if bb.get("destruct"):
            B["state"] = "gone"
            B["reasons"] = []
            _gd_resolve(g, key)
            continue
        if not bb["alive"] and bb.get("auto"):
            B["dead_since"] = B.get("dead_since") or now
            if now - float(B["dead_since"]) >= GUARD_DEAD_MIN:
                reasons.append(("🔴", f"مطفي من {int((now - B['dead_since']) / 60)} دقيقة وإقلاعه التلقائي "
                                      f"مفعّل — الحارس الآلي ما رجّعه (تأكد إنه شغّال)", "dead"))
        else:
            B.pop("dead_since", None)
        hb = bb.get("hb_age")
        if bb["alive"] and not bb.get("dca") and hb is not None and hb > GUARD_HB_STALE:
            reasons.append(("🔴", f"العملية حية بس حلقة المحرك واقفة — آخر نبض قبل {int(hb / 60)} دقيقة", "hung"))
        if snap.get("ok_pend"):
            um = [(oid, m) for oid, m in O["missing"].items() if m.get("bot") == bn
                  and m["strike"] >= 2 and now - float(m["first"]) >= GUARD_CONFIRM_S]
            if um:
                det = []
                for oid, m in um[:3]:
                    st_ = ((snap.get("details") or {}).get(oid) or {}).get("state") or ""
                    word = {"filled": "منفّذ", "canceled": "ملغي",
                            "partially_filled": "منفّذ جزئياً"}.get(st_, "حالته مجهولة")
                    det.append(f"{_gd_side_ar(m.get('side'))} @ {float(m.get('px') or 0):.8g} {word}")
                if bb["alive"]:
                    reasons.append(("🔴", f"{len(um)} أمر مسجّل بالبوت ومو موجود بالمنصة ({'، '.join(det)}) "
                                          f"— البوت ما عالجها", "unproc"))
                else:
                    reasons.append(("🟡", f"{len(um)} أمر تغيّر بالمنصة والبوت متوقف ({'، '.join(det)}) "
                                          f"— يعالجها أول ما يشتغل", "unproc_off"))
        if (bb["alive"] and not bb.get("dca") and not bb.get("paused")
                and float(bb.get("fill_ts") or 0) > 0 and float(bb.get("fill_px") or 0) > 0
                and float(bb.get("cp") or 0) > 0):
            cp, fp = float(bb["cp"]), float(bb["fill_px"])
            steps = abs(math.log(cp / fp)) / math.log(1.0 + max(float(bb.get("step") or 0.008), 1e-6))
            zone = ((bb.get("floor", 0) > 0 and cp < bb["floor"]) or (bb.get("ceil", 0) > 0 and cp > bb["ceil"])
                    or (bb.get("min_price", 0) > 0 and cp < bb["min_price"])
                    or (bb.get("type") == "grid_range" and ((bb.get("lo", 0) > 0 and cp < bb["lo"])
                                                             or (bb.get("hi", 0) > 0 and cp > bb["hi"]))))
            idle = now - float(bb["fill_ts"])
            if steps >= GUARD_STALL_STEPS and idle >= GUARD_STALL_MIN and not zone:
                B["stall_strike"] = int(B.get("stall_strike") or 0) + 1
                if B["stall_strike"] >= 2:
                    reasons.append(("🟠", f"السعر تحرك {steps:.1f} درجة من آخر تنفيذ ({fp:.8g} ← {cp:.8g}) "
                                          f"وما صار ولا تنفيذ من {idle / 3600:.1f} ساعة", "stall"))
            else:
                B["stall_strike"] = 0
        else:
            B["stall_strike"] = 0
        B["reasons"] = [r[1] for r in reasons]
        B["state"] = ("bad" if any(r[0] == "🔴" for r in reasons) else
                      "warn" if reasons else ("ok" if bb["alive"] else "off"))
        if reasons:
            sev = "🔴" if B["state"] == "bad" else ("🟠" if any(r[0] == "🟠" for r in reasons) else "🟡")
            sig = ",".join(sorted(r[2] for r in reasons))
            e = _gd_event(g, key, sev, f"☠️ بوت {bb['sym']} ما يشتغل صح", " · ".join(B["reasons"]),
                          wid=wid, sym=bb["sym"], kind="bot", extra={"sig": sig})
            if e.get("tg") is True and e.get("sig_sent") != sig:
                e["tg"] = False                      # سبب جديد ⇒ رسالة جديدة
        else:
            hit = _gd_resolve(g, key)
            if hit and hit.get("sig_sent"):
                _gd_event(g, f"botok:{bn}:{int(now)}", "🟢", f"✅ بوت {bb['sym']} رجع يشتغل طبيعي",
                          "زالت كل أسباب التنبيه السابق.", wid=wid, sym=bb["sym"], kind="bot_ok", status="info")


def _gd_is_open(e, now):
    return (e.get("status") == "open" and e.get("sev") in ("🔴", "🟠")
            and float(e.get("snooze_until") or 0) <= now)


def _gd_alerts(g, now=None):
    """🚨 التنبيهات المفتوحة (شارة القائمة): فروق عملات مؤكدة + أحداث حمراء/برتقالية."""
    now = now or time.time()
    out = []
    for wid, W in (g.get("wallets") or {}).items():
        for ccy, c in (W.get("coins") or {}).items():
            al = c.get("alert")
            if not al or not al.get("confirmed") or float(c.get("snooze_until") or 0) > now:
                continue
            out.append({"key": f"coin:{wid}:{ccy}", "kind": "coin", "sev": "🔴",
                        "symbol": f"{ccy} · {W.get('label') or wid}", "base": ccy,
                        "title": f"فرق برصيد {ccy}", "diff": al["diff"], "usd": al["usd"],
                        "exp": al["exp"], "act": al["act"], "explained": al.get("explained")})
    for e in g.get("events") or []:
        if _gd_is_open(e, now):
            out.append({"key": "ev:" + e["id"], "kind": e.get("kind") or "event", "sev": e.get("sev"),
                        "symbol": e.get("sym") or "", "title": e.get("title"), "detail": e.get("detail")})
    return out


def _gd_outbox(g, now):
    """📨 الرسائل المستحقة — كل حالة مرة وحدة (محفوظة بالملف، ما تنعاد بإعادة التشغيل)."""
    out = []
    for wid, W in (g.get("wallets") or {}).items():
        for ccy, c in (W.get("coins") or {}).items():
            al = c.get("alert")
            if not al or not al.get("confirmed") or float(c.get("snooze_until") or 0) > now:
                continue
            tol = float(al.get("tol") or 0)
            if c.get("tg_first") == al["first"] and abs(float(c.get("tg_diff") or 0) - al["diff"]) <= 2 * tol:
                continue
            up = al["diff"] > 0
            txt = (f"🛡️ *الرقابة — فرق برصيد {_gd_md(ccy)}*\n👛 {_gd_md(W.get('label'))}\n"
                   f"━━━━━━━━━━━━━\n"
                   f"المتوقَّع: `{al['exp']:.8f}`\nالفعلي بالمنصة: `{al['act']:.8f}`\n"
                   f"الفرق: `{al['diff']:+.8f}` ≈ `{al['usd']:+.4f}$` ({'زيادة' if up else 'نقص'})\n"
                   f"━━━━━━━━━━━━━\n")
            if al.get("explained"):
                txt += "🧾 *مفسَّر بأدلة المنصة:*\n" + "\n".join(_gd_md(x) for x in al["ev"][-5:]) + "\n"
                txt += "افتح اللوحة ← 🛡️ الرقابة واعتمده بضغطة (أو شغّل التصحيح التلقائي)."
            else:
                txt += ("❓ ما لگيت دليل بالمنصة يفسّره.\n" + (
                    "_محتمل: إيداع · شراء من التطبيق · أمر بيع للبوت انلغى فصارت عملته حرة · "
                    "عملة محرَّرة بلا مُراكِم_" if up else
                    "_محتمل: سحب · بيع من التطبيق · تحويل لحساب ثاني_") +
                    "\nافتح اللوحة ← 🛡️ الرقابة: اعتمد أو أجّل.")
            out.append(("coin", wid, ccy, al["first"], al["diff"], txt))
    for e in g.get("events") or []:
        if e.get("tg") is not False:
            continue
        if now - float(e.get("ts") or now) > 86400 or float(e.get("snooze_until") or 0) > now:
            e["tg"] = True                   # قديم أو مؤجّل ⇒ ما نرسل متأخراً
            continue
        txt = (f"🛡️ *الرقابة* — {_gd_md(e.get('title'))}\n"
               + (f"👛 {_gd_md(((g.get('wallets') or {}).get(e.get('wid')) or {}).get('label'))}\n" if e.get("wid") else "")
               + f"{_gd_md(e.get('detail'))}")
        out.append(("ev", e["id"], txt))
    return out[:GUARD_TG_PER_SCAN]


# ═══════════════ 🧮 تدقيق الكميات الدوري (v3.21.5 · ب١٧) ═══════════════
#
# 🔑 قراءة فقط: ولا أمر ينحط ولا ينلغى ولا ملف بوت ينكتب. كل اللي يسويه يكتب بملف الرقابة
#    (Holy_Guard.json ← "qa") ويبلّغ: نافذة الرقابة · التقرير التشخيصي · تيليغرام مرة لكل حالة.
#
# أربع فحوص بكل جولة رقابة (كل 10 دقائق) — كلها تنأكد بقراءتين بينهما ≥90 ثانية:
#   ١ 📏 حجم كل أمر منشور بالدفتر = حجمه بالمنصة (كان ينحسب للتشخيص بس — هسه ينبّه بعد التأكيد).
#   ٢ 🪙 العملة اللي يحسبها البوت ملكه (سجلات البيع بكلفتها + الكسر + تسليمات بالطريق + المُراكِم
#      + شراء نص منفّذ) ≤ رصيد المحفظة. غير هيچ أوامر بيع راح تنرفض.
#   ٣ 🧮 «العملة الحرة خارج البوتات» = الرصيد − كل سجلات البيع − الكسر − المُراكِم − رأس المال الراجع.
#      كل تنفيذ بوت يحرّك الطرفين سوا ⇒ ما تتغير. تتغير بس بدليل من المنصة (تحويل · تداول من التطبيق)
#      أو حقن عملة. تغيّر بلا دليل = الدفتر نسى عملات (+) أو انضاف سجل بلا عملة (−) — وهذا بالضبط
#      اللي قيد «مطابقة الدفتر» بالرقابة القديمة يبلعه بصمت.
#   ٤ 🧾 سلامة السجلات: رقم تالف · نفس الأمر شراء وبيع · سجل بيع أصغر من حد المنصة (عالق) · كسر كبير.
#
# متى **ما يقارن** (حتى ما يغلط): أمر تغيّر بالمنصة والبوت ما عالجه · أمر للبوت لسه ما انسجّل ·
#   أمر مجمّع بنص معالجته · ملف حالة انكتب بنص الفحص · أمر مُراكِم معلّق · أدلة المنصة ناقصة.
#   وحركة مخزونك (فتح/غلق بيع مخزون) أو تغيّر البوتات ⇒ خط أساس جديد بأول فحص نظيف (ما نخمّن).
GUARD_QA_GAP = 86400       # فجوة أكثر من يوم بين فحصين ⇒ خط أساس جديد
GUARD_QA_CENT = 0.01       # أصغر فرق يستاهل تبليغ (دولار) — أصغر منه تقريب ينجمع ويبين بالنافذة
_QA_LIM_AR = {"pend": "قائمة الأوامر ما وصلت", "read": "ملف بوت ما انقرا", "acc": "أمر مُراكِم معلّق",
              "cu": "أمر مجمّع بنص معالجته", "mt": "البوت كتب حالته بنص الفحص",
              "stray": "أمر للبوت بالمنصة لسه ما انسجّل", "miss": "أمر تغيّر بالمنصة والبوت ما عالجه",
              "ev": "أدلة المنصة ناقصة", "px": "ماكو سعر", "transit": "شراء نص منفّذ ما شفنا تنفيذاته + حركة (تنفسَّر لما يكتمل)"}


def _gd_qa_f(x):
    """رقم آمن: فاضي ⇒ 0 · مو رقم ⇒ nan (حتى ينكشف كسجل تالف بدل ما ينبلع)."""
    if x is None or x == "":
        return 0.0
    try:
        return float(x)
    except Exception:
        return float("nan")


def _gd_qa_bot(st, cfg, sym, cp, seen_ho, mt0, minsz=0.0):
    """🧮 لقطة كميات بوت شبكة من ملف حالته — منطق خالص (يُختبر لوحده · بلا شبكة).

    سجل بيع **مشترى** = بيه كلفة (cost_px > 0) · غيره **مخزون** (عملتك الحرة معروضة للبيع، ومنها المحسوبة بالخفاء)."""
    F, fin = _gd_qa_f, math.isfinite
    out = {"sym": sym, "base": str(sym).split("-")[0], "mt0": mt0, "lvl": 0.0, "live": {},
           "mem_b": 0.0, "mem_i": 0.0, "inv_sig": [], "fee_dust": 0.0, "dust_bq": 0.0,
           "inj": 0.0, "cap": 0.0, "ho": 0.0, "invs": 0.0, "cu": bool(st.get("cu_pending")),
           "destruct": bool(st.get("destruct_done") or st.get("self_destruct")),
           "issues": [], "n_b": 0, "n_i": 0, "minsz": float(minsz or 0)}
    usd = F(cfg.get("usd_value"))
    if fin(usd) and usd > 0 and cp and cp > 0:
        out["lvl"] = usd / float(cp)
    if out["destruct"]:
        return out             # 💣 بوت انحذف: سجلاته ما يديرها أحد ⇒ عملتها صارت حرة لك (ما تنحسب مطالبة)
    bad, sub = [], []
    for dn in ("limit_buys", "limit_sells", "virtual_buys", "virtual_sells", "accum_buys", "accum_sells"):
        led = st.get(dn)
        if led is None:
            continue
        if not isinstance(led, dict):
            bad.append(f"{dn}: مو قائمة سجلات")
            continue
        sell = "sell" in dn
        for k, v in led.items():
            if not isinstance(v, dict):
                bad.append(f"{dn}/{k}: سجل مو مفهوم")
                continue
            q, px, cpx = F(v.get("locked_qty")), F(v.get("target_price")), F(v.get("cost_px"))
            if not (fin(q) and fin(px) and fin(cpx)) or q < 0 or px < 0:
                bad.append(f"{'بيع' if sell else 'شراء'} @ {v.get('target_price')}: كمية {v.get('locked_qty')}")
                continue
            if q <= 0 or px <= 0:
                continue                       # سجل فاضي — ما يطالب بشي (المحرك يتجاهله)
            if not sell:
                if dn == "limit_buys":
                    out["live"][str(k)] = ["b", q, "", px]
                continue
            real = cpx > 0
            if dn == "limit_sells":
                out["live"][str(k)] = ["s", q, "b" if real else "i", px]
            elif real:
                out["mem_b"] += q
            else:
                out["mem_i"] += q
            if real:
                out["n_b"] += 1
            else:
                out["n_i"] += 1
                out["inv_sig"].append([round(px, 8), round(q, 10)])
            if dn != "limit_sells" and minsz and q < float(minsz) - 1e-12 and not v.get("gen"):
                sub.append((px, q))
    iss = out["issues"]
    lb, ls = st.get("limit_buys"), st.get("limit_sells")
    if isinstance(lb, dict) and isinstance(ls, dict):
        dup = sorted(set(map(str, lb)) & set(map(str, ls)))
        if dup:
            iss.append({"k": "dup", "sev": "🔴", "title": "نفس الأمر مسجّل شراء وبيع", "sig": ",".join(dup[:5]),
                        "txt": f"{len(dup)} أمر بنفس الرقم بالجهتين ({', '.join(dup[:3])}) — تنفيذه ينعالج غلط"})
    fd, du = F(st.get("fee_dust")), F(st.get("dust_bq"))
    if not fin(fd) or fd < -1e-9:
        bad.append(f"كسر العملة {st.get('fee_dust')}")
    else:
        out["fee_dust"] = max(0.0, fd)
    if not fin(du):
        bad.append(f"كسر الشراء {st.get('dust_bq')}")
    else:
        out["dust_bq"] = du
    lvl = out["lvl"]
    if lvl > 0 and out["fee_dust"] > lvl:
        iss.append({"k": "fd_big", "sev": "🟡", "title": "كسر العملة أكبر من درجة", "sig": "fd",
                    "txt": f"كسر العملة {out['fee_dust']:.8g} (الدرجة ≈ {lvl:.8g}) — المفروض يندمج بأول بيع بعد شراء؛ "
                           f"كبره يعني عملة مشتراة واقفة بلا أمر بيع"})
    if lvl > 0 and abs(out["dust_bq"]) > lvl:
        iss.append({"k": "dq_big", "sev": "🟡", "title": "كسر الشراء أكبر من درجة", "sig": "dq",
                    "txt": f"وحدات الشراء المؤجلة {out['dust_bq']:+.8g} (الدرجة ≈ {lvl:.8g}) — المفروض تنضم لأول شراء بعد بيع"})
    if sub:
        sq = sum(q for _p, q in sub)
        iss.append({"k": "sub", "sev": "🟡", "title": "سجل بيع أصغر من حد المنصة (عالق)", "sig": f"{len(sub)}:{round(sq, 10)}",
                    "txt": f"{len(sub)} سجل بيع بالذاكرة أصغر من حد المنصة ({float(minsz):.8g}) مجموعها {sq:.8g} — "
                           f"ما ينحط أمر بيها لحد ما ينضم لها التزام بنفس الدرجة: "
                           + "، ".join(f"{q:.8g} @ {p:.8g}" for p, q in sub[:4])})
    if bad:
        iss.append({"k": "bad", "sev": "🔴", "title": "سجلات تالفة بملف البوت", "sig": f"{len(bad)}:{bad[0]}",
                    "txt": f"{len(bad)} خانة مو رقم صحيح: " + "؛ ".join(bad[:4])})
    ri = st.get("reinvest") if isinstance(st.get("reinvest"), dict) else {}
    for key, fld in (("inj", "inj_coin_total"), ("cap", "cap_coin_total")):
        x = F(ri.get(fld))
        out[key] = x if fin(x) else 0.0
    x = F(st.get("inv_sold_total"))          # 🪙 مخزونك اللي انباع بالأمر المجمّع (بلا سجل) — حركة مفسَّرة
    out["invs"] = x if fin(x) else 0.0
    for ho in _ri_handoffs_of(st):
        try:
            if ho.get("id") not in seen_ho:
                x = F(ho.get("coin"))
                out["ho"] += x if fin(x) else 0.0
        except Exception:
            continue
    out["inv_sig"].sort()
    return out


def _gd_qa_event(g, live, key, sev, title, detail, wid="", sym="", amt=None, tg=True):
    """🗒️ حدث تدقيق: مرة لكل حالة — «علمت» عليه يسكّته لحد ما يتغيّر الرقم جوهرياً (>25%)."""
    live.add(key)
    for e in g.get("events") or []:
        if e.get("key") == key and e.get("status") == "acked":
            a0 = e.get("amt")
            if amt is None or a0 is None or abs(float(amt) - float(a0)) <= 0.25 * max(abs(float(a0)), 1e-12):
                return e
    e = _gd_event(g, key, sev, title, detail, wid=wid, sym=sym, kind="qa", tg=tg)
    if amt is not None:
        a0 = e.get("amt")
        if (tg and e.get("tg") is True and a0 is not None
                and abs(float(amt) - float(a0)) > 0.25 * max(abs(float(a0)), 1e-12)):
            e["tg"] = False                      # تغيّر جوهري ⇒ رسالة جديدة
        if e.get("tg") is False or a0 is None:
            e["amt"] = float(amt)
    return e


def _gd_qa_keep(g, live, key):
    """أثناء التأجيل (فحص ما يقارن) الحدث المفتوح يبقى مثل ما هو — ما ينحل بلا دليل."""
    if any(e.get("key") == key and e.get("status") in ("open", "acked") for e in g.get("events") or []):
        live.add(key)


def _gd_qty_audit(g, now, snaps=None):
    """🧮 تدقيق الكميات الدوري — منطق خالص على لقطات جولة الرقابة (بلا شبكة · بلا كتابة بملفات البوتات).
    يرجع ملخص العرض (ينحفظ أيضاً بـ g["qa"]["view"])."""
    QA = g.setdefault("qa", {})
    QC = QA.setdefault("c", {})          # حالة كل محفظة × عملة (خط الأساس · العدّادات)
    QS = QA.setdefault("sz", {})         # فروق حجم الأوامر بانتظار التأكيد
    QB = QA.setdefault("b", {})          # مشاكل السجلات بانتظار التأكيد
    live, evald, notes = set(), set(), {}
    b_scope, b_seen, sz_scope, sz_seen = set(), set(), set(), set()
    view = {"ts": now, "coins": [], "bots": [], "sz": []}
    for s in snaps or []:
        if not isinstance(s, dict) or s.get("fatal") or not s.get("ok_bal"):
            continue
        wid = str(s.get("wid") or "")
        if not wid:
            continue
        evald.add(wid)
        W = (g.get("wallets") or {}).get(wid) or {}
        wl = W.get("label") or s.get("label") or wid
        qb = s.get("qa_bots") or {}
        pend = s.get("pending") or {}
        okp = bool(s.get("ok_pend"))
        mt1 = s.get("qa_mt1") or {}
        bad_c = set(s.get("qa_bad") or [])
        tracked = s.get("tracked") or {}
        pref = [p for bb in (s.get("bots") or {}).values() for p in (bb.get("ids") or []) if p]
        stray = set()
        if okp:
            for oid, o in pend.items():
                if oid not in tracked and any(str(o.get("cl") or "").startswith(p) for p in pref):
                    stray.add(str(o.get("instId") or ""))
        if not okp:          # قائمة الأوامر ما وصلت ⇒ فروق الحجم تبقى مثل ما هي (ما تنحل بلا دليل)
            for kk, Z in QS.items():
                if Z.get("wid") == wid:
                    sz_scope.add(kk)
                    sz_seen.add(kk)
                    _gd_qa_keep(g, live, kk)
        for _bn in s.get("qa_badn") or []:      # ملف بوت ما انقرا ⇒ تنبيهات سجلاته تبقى
            for e in g.get("events") or []:
                if str(e.get("key") or "").startswith(f"qa:rec:{_bn}:"):
                    _gd_qa_keep(g, live, e["key"])
        by = {}
        for name, q in qb.items():
            by.setdefault(q.get("base"), []).append((name, q))
            b_scope.add(name)
            # ── ٤ · سلامة السجلات ──
            for it in q.get("issues") or []:
                kk = f"qa:rec:{name}:{it['k']}"
                b_seen.add(kk)
                B = QB.setdefault(kk, {"n": 0, "first": now, "bot": name})
                B["n"] = int(B.get("n") or 0) + 1
                if B["n"] >= 2 and now - float(B.get("first") or now) >= GUARD_CONFIRM_S:
                    _gd_qa_event(g, live, kk, it["sev"], f"🧮 {it['title']} — {q.get('sym')}",
                                 f"{name} · {it['txt']} · ما لمست أي أمر.", wid=wid, sym=q.get("sym"),
                                 tg=it["sev"] != "🟡")
                else:
                    _gd_qa_keep(g, live, kk)
            view["bots"].append({"wid": wid, "bot": name, "sym": q.get("sym"), "n_b": q.get("n_b"), "n_i": q.get("n_i"),
                                 "fee_dust": q.get("fee_dust"), "dust_bq": q.get("dust_bq"), "lvl": q.get("lvl"),
                                 "issues": [{"k": it["k"], "sev": it["sev"], "title": it["title"], "txt": it["txt"]}
                                            for it in q.get("issues") or []]})
            # ── ١ · حجم الأمر: الدفتر ⇔ المنصة ──
            if not okp:
                continue
            for oid, ent in (q.get("live") or {}).items():
                sz_scope.add("qa:sz:" + oid)
                if oid not in pend:
                    continue
                side, qq, _kind, opx = ent
                x = float(pend[oid].get("sz") or 0)
                if abs(qq - x) <= max(5e-7, qq * 1e-9):
                    continue
                kk = "qa:sz:" + oid
                sz_seen.add(kk)
                Z = QS.setdefault(kk, {"n": 0, "first": now})
                if abs(float(Z.get("book", qq)) - qq) > 1e-12 or abs(float(Z.get("okx", x)) - x) > 1e-12:
                    Z.update(n=0, first=now)            # الرقمين تغيّروا ⇒ نعيد التأكيد
                Z.update(bot=name, wid=wid, sym=q.get("sym"), side=side, px=opx, book=qq, okx=x)
                Z["n"] = int(Z.get("n") or 0) + 1
                conf = Z["n"] >= 2 and now - float(Z.get("first") or now) >= GUARD_CONFIRM_S
                view["sz"].append(dict(Z, oid=oid, conf=conf))
                if conf:
                    sell = side == "s"
                    dq = x - qq
                    _gd_qa_event(g, live, kk, "🟠", f"📏 حجم أمر بالمنصة غير اللي بالدفتر — {q.get('sym')}",
                                 f"{name} · {'بيع' if sell else 'شراء'} @ {opx:.8g}: الدفتر {qq:.8g} · المنصة {x:.8g} "
                                 f"(الفرق {dq:+.8g} ≈ {dq * opx:+.4f}$) — "
                                 + ("المنصة راح تبيع كمية غير اللي يحسبها البوت ⇒ عملة تبقى بلا أمر أو بيع ما تغطيه عملة. "
                                    if sell else
                                    "المنصة راح تشتري كمية غير اللي يحسبها البوت ⇒ بيعه بعدين يختلف عن الشراء. ")
                                 + "غالباً تعديل حجم ما تأكد أو تعديل من التطبيق. ما لمست الأمر.",
                                 wid=wid, sym=q.get("sym"), amt=dq)
                else:
                    _gd_qa_keep(g, live, kk)
        # ── ٢ + ٣ · لكل عملة شبكة بالمحفظة ──
        ev_ok = bool(s.get("ok_ev") and not s.get("baseline"))          # أدلة جديدة تنضاف لخط الأساس
        ev_full = bool(s.get("ok_ev") and s.get("ev_complete"))          # أول فحص (العدّ يبدي من هسه) = كامل
        evq = s.get("ev_q") or {}
        for ccy, info in (s.get("coins") or {}).items():
            if info.get("mode") != "grid" or ccy not in by:
                continue
            ck = f"{wid}:{ccy}"
            C = QC.setdefault(ck, {})
            cash = float(((s.get("bal") or {}).get(ccy) or {}).get("cash") or 0)
            px = float(info.get("px") or 0)
            lim = []
            if not okp:
                lim.append("pend")
            if ccy in bad_c:
                lim.append("read")
            if info.get("inflight"):
                lim.append("acc")
            if px <= 0:
                lim.append("px")
            bought = inv = fd = cap = ho = transit = t_apx = 0.0
            lv, isig, bsig, inj, invs = [], [], [], {}, {}
            # 🧩 شراء نص منفّذ: الواصل **الصافي** من تنفيذاته بالرقم (الكمية − عمولتها بالعملة) — بلا تقدير
            cur_lb = {oid for _n, q in by[ccy] for oid, ent in (q.get("live") or {}).items() if ent[0] == "b"}
            tb = {o: list(v) for o, v in (C.get("tb") or {}).items()}
            for _bf in s.get("bot_fills") or []:
                _oid, _sd, _sz, _b = _bf[:4]
                if _b == ccy and _sd == "buy" and (_oid in cur_lb or _oid in tb):
                    _e = tb.setdefault(_oid, [0.0, 0.0])
                    _e[0] += float(_sz or 0)
                    _e[1] += float(_sz or 0) + (float(_bf[4] or 0) if len(_bf) > 4 else 0.0)
            C["tb"] = {o: v for o, v in tb.items() if o in cur_lb}
            for name, q in by[ccy]:
                bsig.append(name + ("!" if q.get("destruct") else ""))
                if q.get("cu"):
                    lim.append("cu")
                if mt1.get(name) != q.get("mt0"):
                    lim.append("mt")
                if q.get("sym") in stray:
                    lim.append("stray")
                for oid, ent in (q.get("live") or {}).items():
                    side, qq, kind = ent[0], float(ent[1]), ent[2]
                    if okp and oid in pend:
                        f = max(0.0, float(pend[oid].get("fill") or 0))
                        if side == "s":
                            if kind == "b":
                                bought += max(0.0, qq - f)
                            else:
                                inv += max(0.0, qq - f)
                        elif f > 0:
                            _t = C["tb"].get(oid)
                            if _t and abs(_t[0] - f) <= 1e-9 * max(1.0, f):
                                transit += _t[1]              # صافي بالضبط
                            else:
                                transit += f                  # تنفيذ ما شفناه (قبل أول فحص/أدلة متأخرة) ⇒ إجمالي تقريبي
                                t_apx += f
                    elif okp:
                        lim.append("miss")
                bought += float(q.get("mem_b") or 0)
                inv += float(q.get("mem_i") or 0)
                fd += float(q.get("fee_dust") or 0)
                cap += float(q.get("cap") or 0)
                ho += float(q.get("ho") or 0)
                isig += [list(x) for x in (q.get("inv_sig") or [])]
                inj[name] = float(q.get("inj") or 0)
                invs[name] = float(q.get("invs") or 0)
                if float(q.get("lvl") or 0) > 0:
                    lv.append(float(q["lvl"]))
            acc = float(info.get("acc") or 0)
            own = bought + fd + ho + acc + transit           # 🪙 لازم تكون موجودة بالمحفظة
            claims = own + inv + cap
            free = cash - claims                              # 🧮 حرة خارج البوتات
            lvl = min(lv) if lv else 0.0
            thr = max(1e-9 * max(cash, claims), (GUARD_QA_CENT / px) if px > 0 else 1e-8, 0.0025 * t_apx, 1e-12)
            # ── ٢ · عملة البوتات ⇔ المحفظة ──
            short = own - cash
            k2 = f"qa:own:{wid}:{ccy}"
            q2 = C.setdefault("q2", {"n": 0, "first": 0})
            st2 = "ok"
            if lim:
                st2 = "wait"
                _gd_qa_keep(g, live, k2)
            elif short > thr:
                if not q2.get("n"):
                    q2["first"] = now
                q2["n"] = int(q2.get("n") or 0) + 1
                st2 = "pending"
                if q2["n"] >= 2 and now - float(q2["first"]) >= GUARD_CONFIRM_S:
                    st2 = "alert"
                    _cal = bool((((W.get("coins") or {}).get(ccy) or {}).get("alert")))
                    _gd_qa_event(g, live, k2, "🔴", f"🪙 عملة البوتات أكثر من الموجودة بالمحفظة — {ccy}",
                                 f"البوتات{' والمُراكِم' if acc > 0 else ''} يحسبون {own:.8g} {ccy} (مشتراة بأوامر البيع {bought:.8g}"
                                 + (f" · كسر {fd:.8g}" if fd > 0 else "") + (f" · تسليمات بالطريق {ho:.8g}" if ho > 0 else "")
                                 + (f" · المُراكِم {acc:.8g}" if acc > 0 else "") + (f" · شراء نص منفّذ {transit:.8g}" if transit > 0 else "")
                                 + f") والمحفظة بيها {cash:.8g} — ناقص {short:.8g} ≈ {short * px:.4f}$. "
                                 "أوامر البيع اللي ما تغطيها عملة راح تنرفض (البوت يهدّي ويعيد). "
                                 "محتمل: سحب أو بيع من التطبيق لعملة محجوزة · سجل بيع مكرر بالدفتر · بيع مخزون بالأمر "
                                 "المجمّع أكل عملات شراء نص منفّذ. ما لمست أي أمر.",
                                 wid=wid, sym=ccy, amt=short, tg=not _cal)
                else:
                    _gd_qa_keep(g, live, k2)
            else:
                q2.update(n=0, first=0)
            # ── ٣ · ثبات العملة الحرة ──
            k3 = f"qa:free:{wid}:{ccy}"
            # 📦 تنفيذات أوامر مخزونك الحيّة (بالرقم): السجل اللي انشطب بتنفيذ ما يغيّر الحرة — حتى حدود التفسير تضيق
            cur_li = {oid: [round(float(ent[3]), 8), round(float(ent[1]), 10)] for _n, q in by[ccy]
                      for oid, ent in (q.get("live") or {}).items() if ent[0] == "s" and ent[2] == "i"}
            seen_k = {}                                   # 👀 أوامر بيع لمحها المراقب (كل 20 ثانية) بنوعها
            for _n, _q in by[ccy]:
                seen_k.update((s.get("qa_seen") or {}).get(_n) or {})
            known_i = {o: [round(float(e[1]), 8), round(float(e[2]), 10)] for o, e in seen_k.items() if e and e[0] == "i"}
            known_i.update(C.get("linv") or {})
            known_i.update(cur_li)
            invf = {o: list(v) for o, v in (C.get("invf") or {}).items()}
            for _oid, _sd, _sz, _b in [x[:4] for x in s.get("bot_fills") or []]:
                if _b == ccy and _sd == "sell" and _oid in known_i:
                    _e = invf.setdefault(_oid, list(known_i[_oid]) + [0.0])
                    _e[2] += float(_sz or 0)
            for _oid in [o for o in invf if o not in cur_li]:
                C["igl"] = (C.get("igl") or []) + [invf.pop(_oid)]   # [سعر · كمية السجل · المنفّذ] — أمر مخزون خلص
            if len(C.get("igl") or []) > 500:     # تأجيل طويل وحركة كثيرة ⇒ ما نخمّن: خط أساس جديد
                C["igl"], C["rebase"] = [], True
            C["linv"], C["invf"] = cur_li, invf
            # 🕳️ بيع للبوت برقم ما شفناه (انحط وانفّذ بين فحصين): ممكن يكون مخزون انفتح وانباع — يوسّع التفسير (بحدود عملتك الحرة)
            cur_all = {oid for _n, q in by[ccy] for oid in (q.get("live") or {})}
            old_all = set(C.get("lall") or [])
            C["usf"] = float(C.get("usf") or 0) + sum(float(_sz or 0) for _oid, _sd, _sz, _b in [x[:4] for x in s.get("bot_fills") or []]
                                                       if _b == ccy and _sd == "sell" and _oid not in old_all
                                                       and _oid not in cur_all and _oid not in seen_k)
            C["lall"] = sorted(cur_all)
            if ev_ok:
                C["evp"] = float(C.get("evp") or 0) + max(0.0, float(evq.get(ccy) or 0))
            prev_inj, prev_iv = C.get("inj") or {}, C.get("invs") or {}
            d_inj = sum(v - float(prev_inj[n]) for n, v in inj.items() if n in prev_inj)
            d_iv = sum(v - float(prev_iv[n]) for n, v in invs.items() if n in prev_iv)
            C["inj"], C["invs"] = inj, invs
            if "S0" in C:      # 🧾 الحركات المفسَّرة تحرّك خط الأساس (أدلة المنصة · حقن عملة من محفظتك · مخزون انباع بالمجمّع)
                C["S0"] = float(C["S0"]) + (float(evq.get(ccy) or 0) if ev_ok else 0.0) - d_inj - d_iv
            if s.get("baseline"):
                C["rebase"] = True                   # عدّ الأدلة بدا من جديد ⇒ اللي قبله ما نعرفه
            if not ev_full:
                lim.append("ev")
                if s.get("ok_ev"):
                    C["rebase"] = True               # صفحات أدلة أكثر من الحد ⇒ ما نثق بخط الأساس
            isig.sort()
            bsig.sort()
            eid = C.get("eid")
            if eid:
                _e = next((x for x in g.get("events") or [] if x.get("id") == eid), None)
                if not _e or _e.get("status") == "acked":
                    C.pop("eid", None)
                    if _e:
                        C["rebase"] = True            # ✔️ «علمت» = اعتمد المستوى الجديد
            need = ("S0" not in C) or bool(C.get("rebase")) or C.get("bsig") != bsig or C.get("isig") is None \
                or now - float(C.get("ts") or 0) > GUARD_QA_GAP
            st3, d = "ok", None
            if lim:
                st3 = "wait"
                if need:
                    C["rebase"] = True
                _gd_qa_keep(g, live, k3)
            elif t_apx > 0 and (need or C.get("isig") != isig or C.get("igl") or float(C.get("usf") or 0) > 0):
                # 🧩 شراء نص منفّذ + خط أساس جديد أو حركة مخزون: عمولته بالعملة تخلي الحرة تبين أقل شوية ⇒ ما نتعلّم منها
                #    (لا خط أساس ولا تفسير مخزون) لحد ما يكتمل — الحركات تتجمّع وتنفسَّر بأول فحص بلا نص منفّذ
                st3 = "wait"
                lim.append("transit")
                if need:
                    C["rebase"] = True
                _gd_qa_keep(g, live, k3)
            elif need:
                C.update(S0=free, isig=isig, bsig=bsig, rebase=False, n=0, first=0, d=0.0, igl=[],
                         usf=0.0, evp=0.0, fprev=free)
                st3 = "base"
                notes[k3] = "خط أساس جديد (تغيّر بالبوتات · فحص متقطّع · أو اعتمدته) — آخر فرق مؤكد بقى بالسجل"
            else:
                _igl = list(C.get("igl") or [])
                _usf, _evp = float(C.get("usf") or 0), float(C.get("evp") or 0)
                _fprev = float(C.get("fprev", free))
                C["igl"], C["usf"], C["evp"] = [], 0.0, 0.0
                if C.get("isig") != isig or _igl or _usf > 0:
                    # 📦 حركة مخزونك (فتح/غلق/نقل بيع مخزون): أقصى تفسير شرعي = فتح بقدر المضاف (الحرة تنقص) ·
                    #    غلق **بلا تنفيذ** بقدر المشطوب ناقص المنفّذ بالرقم (تزيد). الحركة الجديدة بهالفترة تنفسَّر لحد
                    #    هالحدود بس — الباقي فرق أكيد. (سجل منفّذ وانفتح مثله بنفس الفترة ⇒ ينحسب «مضاف» — ما نغلط)
                    from collections import Counter as _Cn
                    _pc, _cc = _Cn(tuple(x) for x in C["isig"]), _Cn(tuple(x) for x in isig)
                    _addc, _remc = _cc - _pc, _pc - _cc
                    _add = sum(k_[1] * n_ for k_, n_ in _addc.items())
                    _rem = sum(k_[1] * n_ for k_, n_ in _remc.items())
                    for _p, _qq, _f in _igl:              # أمر مخزون خلص بتنفيذ:
                        _k = (_p, _qq)
                        if _remc.get(_k, 0) > 0:          # سجله كان موجود وانشطب ⇒ المنفّذ منه ما يغيّر الحرة
                            _remc[_k] -= 1
                            _rem -= min(_f, _qq)
                        else:                             # انفتح وانباع بنفس الفترة (أو انفتح مثله من جديد) ⇒ نقص شرعي
                            _add += _f
                    _rem = max(0.0, _rem)
                    # 🔒 مخزون ينفتح بس من عملة حرة فعلاً: الحرة بآخر فحص + اللي دخل (إيداع) + المخزون اللي انشطب
                    _add = min(_add + _usf, max(0.0, _fprev) + _evp + _rem)
                    _dn = (free - float(C["S0"])) - float(C.get("d") or 0)
                    C["S0"] = float(C["S0"]) + min(max(_dn, -_add), _rem)
                    C["isig"] = isig
                d = free - float(C["S0"])
                if abs(d) <= thr:
                    if t_apx <= 0:        # ⚠️ شراء نص منفّذ ما شفنا تنفيذاته: عمولته تبين فرق مؤقت ⇒ ما نتعلّمه بخط الأساس
                        C["drift"] = round(float(C.get("drift") or 0) + d, 12)  # تقريب صغير ينجمع ويبين
                        C["S0"] = free
                    C.update(n=0, first=0)
                    d = 0.0
                else:
                    if not C.get("n"):
                        C["first"] = now
                    C["n"] = int(C.get("n") or 0) + 1
                    st3 = "pending"
                    if C["n"] >= 2 and now - float(C["first"]) >= GUARD_CONFIRM_S:
                        st3 = "alert"
                        big = lvl > 0 and abs(d) >= 0.5 * lvl
                        _bn = "، ".join(n for n, _q in by[ccy])
                        if d > 0:
                            ttl = f"🧮 عملة طلعت من دفتر البوتات بلا تنفيذ — {ccy}"
                            txt = (f"{d:+.8g} {ccy} ≈ {d * px:+.4f}$ صارت حرة بالمحفظة بلا تنفيذ ولا تحويل ولا حقن — "
                                   f"الدفتر نسى سجل بيع مشترى: عملته ما عليها أمر بيع بكلفتها (يا تبقى واقفة، يا البوت يعرضها "
                                   f"كمخزونك بلا كلفتها). العملة نفسها موجودة. ")
                        else:
                            ttl = f"🧮 العملة الحرة نقصت بلا دليل — {ccy}"
                            txt = (f"{d:+.8g} {ccy} ≈ {d * px:+.4f}$: سجلات البيع صارت تطالب بعملة أكثر من الموجودة — يا سجل "
                                   f"بيع انضاف بلا شراء يقابله (التزام وهمي)، يا البوت باع عملة محجوزة. بيعها راح ينرفض لنقص "
                                   f"العملة أو ياكل من عملتك الحرة. ")
                        txt += (("بحجم درجة أو أكثر. " if big else "") + f"البوتات: {_bn}. "
                                "لو انطفى البوت أو انقطع قبلها ممكن صحّح دفتره بنفسه — راجع سجله. "
                                "✔️ «علمت» = تعتمد المستوى الجديد. ما لمست أي أمر.")
                        e = _gd_qa_event(g, live, k3, "🔴" if big else "🟡", ttl, txt, wid=wid, sym=ccy, amt=d, tg=big)
                        if e:
                            C["eid"] = e.get("id")
                    else:
                        _gd_qa_keep(g, live, k3)
                C["d"] = d
                C["fprev"] = free
            C["ts"] = now
            view["coins"].append({"wid": wid, "label": wl, "ccy": ccy, "cash": cash, "own": own, "bought": bought,
                                  "inv": inv, "acc": acc, "cap": cap, "fd": fd, "ho": ho, "transit": transit,
                                  "free": free, "short": short, "d": d, "drift": float(C.get("drift") or 0),
                                  "st": st3, "q2": st2, "lim": sorted(set(lim)), "px": px, "thr": thr, "lvl": lvl,
                                  "bots": [n for n, _q in by[ccy]]})
    # 🧹 عدّادات ما انشافت هالجولة (بمحافظ انفحصت) تنمسح · الأحداث اللي زال سببها تنحل
    for kk in [k for k, B in QB.items() if B.get("bot") in b_scope and k not in b_seen]:
        QB.pop(kk, None)
    for kk in [k for k in QS if k in sz_scope and k not in sz_seen] + \
              [k for k, Z in QS.items() if Z.get("wid") in evald and k not in sz_scope]:
        QS.pop(kk, None)
    for e in g.get("events") or []:
        kk = str(e.get("key") or "")
        if not kk.startswith("qa:") or e.get("status") not in ("open", "acked") or kk in live:
            continue
        if e.get("wid") and e.get("wid") not in evald:
            continue
        e["status"], e["resolved"] = "resolved", now
        e["rnote"] = notes.get(kk) or "زال السبب بآخر فحص"
    view["coins"].sort(key=lambda r: ({"alert": 0, "pending": 1}.get(r["st"], 2), r["q2"] != "alert", r["ccy"]))
    QA["view"] = view
    return view


GUARD_QA_SAMPLE = 20       # 👀 كل كم ثانية يلمح أوامر البيع الحيّة (قراءة ملف الحالة بس)
_QA_SEEN = {}              # البوت ⇒ {رقم الأمر: [النوع b/i · السعر · الكمية · أول لمحة · آخر لمحة]} — بالذاكرة بس
_QA_SEEN_LOCK = threading.Lock()


def _gd_qa_sample(now=None):
    """👀 يلمح أوامر البيع الحيّة لكل بوت شبكة (مشترى/مخزون) — قراءة ملف الحالة فقط، بلا شبكة ولا كتابة.
    حتى أمر مخزون ينحط وينفّذ بين جولتين رقابة ينعرف نوعه (بدونه التدقيق يوسّع التفسير ويضعف بكشف المكرر)."""
    now = now or time.time()
    for b in bot_dirs().values():
        try:
            cfg = b.get("cfg") or {}
            if cfg.get("is_demo") or cfg.get("bot_type") in _GD_DCA:
                continue
            name = os.path.basename(str(b["dir"]).rstrip("/\\")) or b["symbol"]
            st = load_json(paths_of(b)[0]) or {}
            ls = st.get("limit_sells") or {}
            if not isinstance(ls, dict):
                continue
            with _QA_SEEN_LOCK:
                reg = _QA_SEEN.setdefault(name, {})
                for oid, v in ls.items():
                    if not isinstance(v, dict):
                        continue
                    e = reg.get(str(oid))
                    if e:
                        e[4] = now
                    else:
                        reg[str(oid)] = ["b" if _gd_qa_f(v.get("cost_px")) > 0 else "i", _gd_qa_f(v.get("target_price")),
                                         _gd_qa_f(v.get("locked_qty")), now, now]
                for oid in [o for o, e in reg.items() if now - float(e[4]) > 4 * 3600]:
                    reg.pop(oid, None)                       # أقدم من 4 ساعات ⇒ ينشال (الذاكرة ما تكبر)
        except Exception:
            continue


def qa_sample_loop():
    """👀 حلقة اللمح — خفيفة (ملفات محلية)، وأي خطأ ما يوقفها."""
    time.sleep(15)
    while True:
        try:
            _gd_qa_sample()
        except Exception:
            pass
        time.sleep(GUARD_QA_SAMPLE)


def guard_qa_lines(V=None):
    """📄 قسم «تدقيق الكميات» بالتقرير التشخيصي."""
    if V is None:
        with _GUARD_IO:
            V = ((_gd_load().get("qa") or {}).get("view") or {})
    L = ["\n## 🧮 تدقيق الكميات الدوري (قراءة فقط — ولا أمر ينلمس)"]
    if not V.get("ts"):
        L.append("- ما انفحص بعد (أول فحص بعد دقيقة من الإقلاع)")
        return L
    L.append(f"- آخر فحص: **{datetime.fromtimestamp(V['ts']).strftime('%Y-%m-%d %H:%M')}**")
    stl = {"ok": "✅ ثابتة", "base": "🧭 خط أساس جديد", "wait": "⏳ ما انقارنت", "pending": "⏳ فرق ينتظر قراءة ثانية",
           "alert": "🔴 فرق مؤكد"}
    f8 = (lambda x: "—" if x is None else f"{(0.0 if abs(float(x)) < 5e-13 else float(x)):.8g}")
    if V.get("coins"):
        L.append("| العملة | المحفظة | عملة البوتات | منها مشتراة | مخزون معروض | الرصيد | الحرة خارج البوتات | ثبات الحرة | البوتات ⇔ الرصيد |")
        L.append("|---|---|---|---|---|---|---|---|---|")
        for r in V["coins"]:
            why = (" (" + "، ".join(_QA_LIM_AR.get(x, x) for x in r.get("lim") or []) + ")") if r.get("lim") else ""
            own = ("🔴 ناقص " + f8(r["short"])) if r.get("q2") == "alert" else ("⏳" if r.get("q2") in ("pending", "wait") else "✅")
            L.append(f"| {r['ccy']} | {r['label']} | {f8(r['own'])} | {f8(r['bought'])} | {f8(r['inv'])} | {f8(r['cash'])} | "
                     f"{f8(r['free'])} | {stl.get(r['st'], r['st'])}{why}"
                     + (f" · فرق {f8(r['d'])}" if r.get("st") in ("pending", "alert") else "") + f" | {own} |")
    for z in V.get("sz") or []:
        L.append(f"- 📏 {z.get('bot')}: {'بيع' if z.get('side') == 's' else 'شراء'} @ {f8(z.get('px'))} — الدفتر {f8(z.get('book'))} · "
                 f"المنصة {f8(z.get('okx'))}{' (مؤكد)' if z.get('conf') else ' (ينتظر قراءة ثانية)'}")
    for b in V.get("bots") or []:
        for it in b.get("issues") or []:
            L.append(f"- {it['sev']} {b['bot']}: {it['title']} — {it['txt']}")
    return L


def guard_scan(force=False):
    """🛡️ فحص كامل لكل المحافظ. الشبكة خارج قفل الملف، والدمج تحت القفل.
    يرجع ملخصاً صادقاً: كم محفظة انفحصت فعلاً وكم فشلت — ولا «مطابق» بلا فحص."""
    if not _GUARD_SCAN.acquire(blocking=False):
        return {"ok": False, "busy": True, "msg": "⏳ فحص جارٍ — ثواني ويخلص"}
    try:
        with _GUARD_IO:
            prev = _gd_load()
        if prev.get("paused") and not force:
            return {"ok": True, "paused": True, "msg": "⏸️ الرقابة موقوفة"}
        now = time.time()
        wallets = _gd_wallets()
        snaps = []
        for wid, W in wallets.items():
            s = _safe(_gd_gather, W, prev, now, default=None)
            snaps.append(s if s else {"wid": wid, "fatal": True, "err": ["خطأ داخلي بالجمع"]})
        with _GUARD_IO:
            g = _gd_load()
            for s in snaps:
                try:
                    _gd_apply(g, s, now)
                except Exception as e:
                    try:
                        log_event(f"⚠️ [الرقابة] دمج {s.get('wid')}: {type(e).__name__}: {e}")
                    except Exception:
                        pass
            _safe(_gd_acc_scan, g, now, default=None)      # 🪙 المُراكِم: جولته · توزيعه · أوامره المعلّقة
            _safe(_gd_ri_scan, g, now, default=None)       # 🔄 التفكيك والتسليم بعد إطفاء إعادة الاستثمار
            _safe(_gd_trade_scan, g, now, snaps, default=None)   # 📡 مراقبة التداول: الدفتر ⇄ المنصة · المطالبات · التحذيرات · التدقيق
            try:                                                  # 🧮 v3.21.5: تدقيق الكميات الدوري (قراءة فقط)
                _gd_qty_audit(g, now, snaps)
            except Exception as e:
                try:
                    log_event(f"⚠️ [الرقابة] تدقيق الكميات: {type(e).__name__}: {e}")
                except Exception:
                    pass
            g["scan_ts"] = now
            g["scan_n"] = int(g.get("scan_n") or 0) + 1
            g["scan_wallets"] = len(snaps)
            g["scan_fail"] = sum(1 for s in snaps if s.get("fatal") or not s.get("ok_bal"))
            _gd_save(g)
            outbox = _gd_outbox(g, now)
            alerts = _gd_alerts(g, now)
        sent_c, sent_e = [], []
        for item in outbox:
            if tg_send(item[-1]):
                (sent_c if item[0] == "coin" else sent_e).append(item)
        if sent_c or sent_e:
            with _GUARD_IO:
                g = _gd_load()
                for _, wid, ccy, first, diff, _t in sent_c:
                    c = (((g["wallets"].get(wid) or {}).get("coins") or {}).get(ccy))
                    if c is not None:
                        c["tg_first"], c["tg_diff"] = first, diff
                ids = {x[1] for x in sent_e}
                for e in g["events"]:
                    if e.get("id") in ids:
                        e["tg"] = True
                        if e.get("sig"):
                            e["sig_sent"] = e["sig"]
                _gd_save(g)
        nw, nf = len(snaps), sum(1 for s in snaps if s.get("fatal") or not s.get("ok_bal"))
        if not nw:
            msg = "🛡️ ماكو محفظة حقيقية للفحص (بوتات تجريبية أو بلا مفاتيح)"
        elif nf == nw:
            msg = "⚠️ تعذّر الوصول للمنصة — ما انفحص شي، والحالة السابقة باقية"
        else:
            msg = (f"🛡️ انفحصت {nw - nf}/{nw} محفظة · " +
                   (f"{len(alerts)} تنبيه مفتوح" if alerts else "ولا تنبيه مفتوح"))
        return {"ok": nf < nw or not nw, "alerts": alerts, "wallets": nw, "fail": nf, "msg": msg}
    finally:
        _GUARD_SCAN.release()


def guard_alerts():
    """🚨 للشارة بالقائمة — نفس المفتاح القديم `guard` باللقطة المجمّعة."""
    with _GUARD_IO:
        g = _gd_load()
    return _gd_alerts(g)


def guard_view():
    """🖥️ كل ما تحتاجه نافذة الرقابة — بلا أي مفتاح أو سر."""
    now = time.time()
    with _GUARD_IO:
        g = _gd_load()
    busy = _GUARD_SCAN.locked()
    wallets = []
    for wid, W in (g.get("wallets") or {}).items():
        coins = []
        for ccy, c in (W.get("coins") or {}).items():
            fresh = abs(float(c.get("ts") or 0) - float(W.get("last_ok") or -1)) < 1
            if not fresh and not c.get("hist") and not abs(float(c.get("adj") or 0)) > 0:
                continue
            st = ("stale" if not fresh else c.get("mode") if c.get("mode") in ("dca", "mixed", "inflight")
                  else ("alert" if (c.get("alert") or {}).get("confirmed") else
                        "pending" if c.get("alert") else "ok"))
            coins.append({"ccy": ccy, "mode": c.get("mode"), "status": st, "exp": c.get("exp"),
                          "act": c.get("act"), "diff": c.get("diff"), "adj": c.get("adj"),
                          "px": c.get("px"), "tol": c.get("tol"), "bots": c.get("bots") or [],
                          "handoff": c.get("handoff"), "acc": c.get("acc"),
                          "snoozed": float(c.get("snooze_until") or 0) > now,
                          "hist": (c.get("hist") or [])[:30], "n_hist": len(c.get("hist") or []),
                          "alert": c.get("alert"), "key": f"coin:{wid}:{ccy}"})
        coins.sort(key=lambda x: (x["status"] != "alert", x["status"] != "pending", x["ccy"]))
        O = W.get("orders") or {}
        wallets.append({"wid": wid, "label": W.get("label") or wid, "last_ok": W.get("last_ok"),
                        "last_try": W.get("last_try"), "err": W.get("err") or "",
                        "coins": coins, "quotes": W.get("quotes") or {},
                        "orders": {"tracked": O.get("n_tracked"), "pending": O.get("n_pending"),
                                   "missing": sum(1 for m in (O.get("missing") or {}).values() if m.get("strike", 0) >= 2),
                                   "stray": sum(1 for m in (O.get("stray") or {}).values() if m.get("strike", 0) >= 2)},
                        "cursor": W.get("cursor")})
    bots = []
    for bn, B in (g.get("bots") or {}).items():
        if now - float(B.get("ts") or 0) > 3 * GUARD_EVERY + 60:
            continue
        bots.append({"dir": bn, **{k: B.get(k) for k in ("sym", "alive", "hb_age", "fill_ts", "fill_px",
                                                            "cycle_ts", "reject_ts", "state", "reasons",
                                                            "type", "tracked", "dca", "ts")}})
    bots.sort(key=lambda x: ({"bad": 0, "warn": 1, "off": 2, "ok": 3}.get(x.get("state"), 4), x.get("sym") or ""))
    ev = []
    for e in (g.get("events") or [])[:60]:
        d_ = {k: e.get(k) for k in ("id", "ts", "sev", "title", "detail", "status", "kind", "sym",
                                    "resolved", "acked_by", "note")}
        d_["snoozed"] = float(e.get("snooze_until") or 0) > now
        d_["wlabel"] = ((g.get("wallets") or {}).get(e.get("wid")) or {}).get("label", "")
        ev.append(d_)
    return {"ok": True, "now": now, "scan_ts": g.get("scan_ts"), "scan_n": g.get("scan_n"),
            "scan_wallets": g.get("scan_wallets"), "scan_fail": g.get("scan_fail"),
            "auto_fix": bool(g.get("auto_fix")), "paused": bool(g.get("paused")), "busy": busy,
            "every": GUARD_EVERY, "alerts": _gd_alerts(g, now), "wallets": wallets, "bots": bots,
            "events": ev, "legacy": g.get("legacy") or {}, "selfcheck": guard_selfcheck(g),
            "acc": g.get("acc") or {}, "ri": g.get("ri") or {},
            "qa": (g.get("qa") or {}).get("view") or {}}


def guard_ack(key, mode="accept", note="", by=""):
    """✅ قرار المستخدم على تنبيه — كله يُسجَّل بمنو ومتى وليش.
    accept (فرق عملة ⇒ تسوية) · snooze (6 ساعات) · dismiss (حدث ⇒ علمت) · reset (تصفير التسوية)."""
    key = str(key or "").strip()
    mode = str(mode or "accept")
    note = str(note or "").strip()[:200]
    by = by or "👤 اللوحة"
    now = time.time()
    with _GUARD_IO:
        g = _gd_load()
        if key and not key.startswith(("coin:", "ev:")):
            # 🔁 توافق مع v3.9: كان يرسل رمز الزوج
            for b in bot_dirs().values():
                c0 = b.get("cfg") or {}
                if b["symbol"] == key and c0.get("api_key"):
                    key = f"coin:{_gd_wid(c0.get('api_key'))}:{key.split('-')[0]}"
                    break
        if key.startswith("coin:"):
            try:
                _, wid, ccy = key.split(":", 2)
            except Exception:
                return {"ok": False, "msg": "مفتاح غير صالح"}
            W = (g.get("wallets") or {}).get(wid)
            c = ((W or {}).get("coins") or {}).get(ccy)
            if c is None:
                return {"ok": False, "msg": "ماكو سجل لهذي العملة"}
            al = c.get("alert")
            if mode == "accept":
                if not al:
                    return {"ok": False, "msg": "ماكو فرق مفتوح لهذي العملة"}
                d = float(al["diff"])
                _gd_hist(c, "accept", d, note=note or ("مفسَّر بأدلة المنصة" if al.get("explained")
                                                       else "اعتمده المستخدم بلا دليل من المنصة"),
                         by=by, px=float(c.get("px") or 0), ev=al.get("ev"), exp=al.get("exp"), act=al.get("act"))
                c["pev"] = []
                c["strike"], c["first_over"] = 0, 0
                c.pop("alert", None)
                c.pop("snooze_until", None)
                if c.get("exp") is not None:        # العرض يتحدّث فوراً بدل انتظار الفحص الجاي
                    c["exp"] = round(float(c["exp"]) + d, 10)
                    c["diff"] = round(float(c.get("diff") or 0) - d, 10)
                _gd_save(g)
                log_event(f"🛡️ [الرقابة] {ccy} @ {W.get('label')}: اعتُمد {d:+.8f} — التسوية {c['adj']:+.8f} — {by}")
                return {"ok": True, "msg": f"✅ انعتمد الفرق {d:+.8f} {ccy} — انسجّل بالسجل والرقابة رجعت تطابق"}
            if mode == "snooze":
                c["snooze_until"] = now + GUARD_SNOOZE
                c["snooze_diff"] = float((al or {}).get("diff") or 0)
                _gd_save(g)
                return {"ok": True, "msg": "⏳ تأجّل 6 ساعات — يرجع لو الفرق تغيّر"}
            if mode == "reset":
                prev_adj = float(c.get("adj") or 0)
                if abs(prev_adj) < 1e-12:
                    return {"ok": False, "msg": "التسوية أصلاً صفر"}
                _gd_hist(c, "reset", -prev_adj, note=note or "تصفير التسوية", by=by, px=float(c.get("px") or 0))
                c["strike"], c["first_over"] = 0, 0
                c.pop("alert", None)
                if c.get("exp") is not None:
                    c["exp"] = round(float(c["exp"]) - prev_adj, 10)
                    c["diff"] = round(float(c.get("diff") or 0) + prev_adj, 10)
                _gd_save(g)
                log_event(f"🛡️ [الرقابة] {ccy}: تصفير التسوية ({prev_adj:+.8f}) — {by}")
                return {"ok": True, "msg": "♻️ التسوية انصفّرت — الفحص الجاي يعيد المقارنة من الصفر"}
            return {"ok": False, "msg": "أمر غير معروف"}
        if key.startswith("ev:"):
            eid = key[3:]
            e = next((x for x in g.get("events") or [] if x.get("id") == eid), None)
            if not e:
                return {"ok": False, "msg": "الحدث مو موجود"}
            if mode in ("dismiss", "accept"):
                e["status"], e["acked_by"], e["acked"] = "acked", by, now
                if note:
                    e["note"] = note
                _gd_save(g)
                return {"ok": True, "msg": "✔️ تسجّل إنك شفته"}
            if mode == "snooze":
                e["snooze_until"] = now + GUARD_SNOOZE
                _gd_save(g)
                return {"ok": True, "msg": "⏳ تأجّل 6 ساعات"}
            return {"ok": False, "msg": "أمر غير معروف"}
    return {"ok": False, "msg": "ماكو تنبيه بهذا المفتاح"}


def guard_cfg(auto_fix=None, paused=None, by=""):
    """⚙️ مفاتيح الرقابة: التصحيح التلقائي · الإيقاف المؤقت."""
    with _GUARD_IO:
        g = _gd_load()
        msg = []
        if auto_fix is not None:
            g["auto_fix"] = bool(auto_fix)
            msg.append("🤖 التصحيح التلقائي " + ("شغّال — الفروق المفسَّرة بأدلة المنصة تتصحّح لحالها"
                                                if g["auto_fix"] else "مطفي — كل فرق ينتظر قرارك"))
            _gd_event(g, f"cfg:{int(time.time())}", "🟡", msg[-1], f"بواسطة {by or 'اللوحة'}",
                      kind="cfg", status="info", tg=False)
        if paused is not None:
            g["paused"] = bool(paused)
            msg.append("⏸️ الرقابة موقوفة" if g["paused"] else "▶️ الرقابة شغّالة")
        _gd_save(g)
    try:
        log_event("🛡️ [الرقابة] " + " · ".join(msg) + f" — {by}")
    except Exception:
        pass
    return {"ok": True, "msg": " · ".join(msg) or "ما تغيّر شي"}


def guard_selfcheck(g=None):
    """🩺 ثوابت الرقابة: التسوية = مجموع سجلها · ولا خانة مستحيلة."""
    if g is None:
        with _GUARD_IO:
            g = _gd_load()
    out = []
    for wid, W in (g.get("wallets") or {}).items():
        for ccy, c in (W.get("coins") or {}).items():
            s = float(c.get("trim_sum") or 0) + sum(float(h.get("qty") or 0) for h in (c.get("hist") or []))
            if abs(s - float(c.get("adj") or 0)) > 1e-8:
                out.append(f"🔴 {ccy} @ {W.get('label') or wid}: التسوية {float(c.get('adj') or 0):+.10f} "
                           f"≠ مجموع السجل {s:+.10f}")
            if int(c.get("strike") or 0) < 0:
                out.append(f"🟠 {ccy}: عدّاد تأكيد سالب")
    for ck, C in (((g.get("qa") or {}).get("c")) or {}).items():      # 🧮 v3.21.5: ثوابت تدقيق الكميات
        try:
            if "S0" in C and not math.isfinite(float(C["S0"])):
                out.append(f"🔴 تدقيق الكميات {ck}: خط الأساس مو رقم")
            if int(C.get("n") or 0) < 0 or int((C.get("q2") or {}).get("n") or 0) < 0:
                out.append(f"🟠 تدقيق الكميات {ck}: عدّاد سالب")
        except Exception:
            out.append(f"🟠 تدقيق الكميات {ck}: خانة غير مفهومة")
    return out


