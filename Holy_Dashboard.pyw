.gd-sec>summary{cursor:pointer;font-weight:800;font-size:14px;color:var(--tx)}.gd-sec>summary small{color:var(--mut2);font-weight:400}
.gd-sec p{margin:7px 0;color:var(--mut)}.gd-sec p b{color:var(--tx)}
