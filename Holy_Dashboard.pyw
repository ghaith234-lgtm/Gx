function offHint(){
  const h=$('#n_boff_h'); if(!h)return;
  const g=parseFloat($('#n_grid').value)/100, off=parseFloat($('#n_boff').value)/100;
  if(!(off>0)||!(g>0)){h.textContent='0 = كلاسيكي (ربح الدورة = مسافة السلم)';h.style.color='var(--mut2)';return}
  const n=Math.max(1,Math.round(Math.log(1/(1-off))/Math.log(1+g)));
  const eff=(1-1/Math.pow(1+g,n))*100;
  const fee=0.16, keep=((eff-fee)/eff*100);
  const exact=Math.abs(eff-off*100)<0.05;
  h.innerHTML=`= <b>${n}</b> درجة سلم → الفعلي <b style="color:var(--cyan)">${eff.toFixed(2)}%</b> ${exact?'✅ مضبوط':'(يُقرَّب لأقرب درجة)'} · يبقى لك <b>${keep.toFixed(0)}%</b> بعد الرسوم`;
  h.style.color='var(--mut)';
}
