def _dca_finish_scan():
    """🏁 v3.22.1 (ح٤): بوت DCA خلّص «آخر دورة» (phase=finished) ⇒ توقفه اللوحة وتطفّي الحارس (ما يرجّعه) وتبلّغ مرة وحدة."""
    for b in bot_dirs().values():
        if b["cfg"].get("bot_type") not in ("dca", "dca_buy"):
            continue
        sp, _, _ = paths_of(b)
        st = load_json(sp) or {}
        if st.get("phase") != "finished":
            continue
        fin = float(st.get("finished_at") or 0)
        if _DCA_FIN_SEEN.get(b["dir"]) == fin:
            continue
        _fk = "f|" + os.path.relpath(b["dir"], ROOT)
        _fs = _dca_tg_get(_fk)
        if _fs == fin or (_fs is None and fin and time.time() - fin > 600):
            _DCA_FIN_SEEN[b["dir"]] = fin                  # 🔧 v3.25.3: انبلّغ قبل (أو قديم من نسخة سابقة) ⇒ ولا إيقاف ولا رسالة ثانية
            if _fs != fin:
                _dca_tg_set(_fk, fin)
            continue
        alive, _ = is_alive(b["dir"], sp)
        if alive or b["cfg"].get("auto_restart"):
            stop_bot(b, disable_auto=True)
        _DCA_FIN_SEEN[b["dir"]] = fin
        _dca_tg_set(_fk, fin)
        _isb = b["cfg"].get("bot_type") == "dca_buy"
        _u = "USDT" if _isb else b["symbol"].split("-")[0]
        tot = round(float(st.get("total_coin_profit") or 0), 4)
        cyc = int(st.get("cycles_done") or 0)
        tg_send(f"🏁 *آخر دورة انتهت — `{b['symbol']}`*\nالبوت وقف وما فتح دورة جديدة (الحارس انطفى عليه)\n"
                f"📊 إجمالي الربح: `{tot}` {_u} · {cyc} دورة\n▶️ للتشغيل من جديد: زر التشغيل بالكرت")
        log_event(f"🏁 [{b['symbol']}] آخر دورة انتهت — البوت وقف · الإجمالي {tot} {_u} · {cyc} دورة")


def watchdog_loop():
    time.sleep(3)
    # عند الإقلاع: شغّل كل بوت معلَّم auto_restart (إقلاع مع ويندوز = اللوحة تقلع والبوتات وراها)
    for b in bot_dirs().values():
        if b["cfg"].get("auto_restart") and WATCHDOG["on"]:
            sp, _, _ = paths_of(b)
            if not is_alive(b["dir"], sp)[0]:
                ok, _ = launch(b)
                if ok:
                    tg_send(f"🤖 *الحارس* — أعاد إطلاق `{b['symbol']}` عند الإقلاع")
            time.sleep(0.6)
    while True:
        try:
            _safe(_dca_finish_scan, default=None)       # 🏁 v3.22.1 (ح٤): «آخر دورة» خلصت ⇒ إيقاف + تبليغ
        except Exception:
            pass
        try:
            if WATCHDOG["on"]:
                for b in bot_dirs().values():
                    if not b["cfg"].get("auto_restart"):
                        continue
                    sp, _, _ = paths_of(b)
                    if is_alive(b["dir"], sp)[0]:
                        continue
                    hist = WD_HIST.setdefault(b["dir"], [])
                    now = time.time()
                    hist[:] = [t for t in hist if now - t < 900]
                    if hist and now - hist[-1] < 20:
                        continue
                    if len(hist) >= 4:
                        write_cfg_keys(b["cfg_path"], {"auto_restart": False})
                        why = LAUNCH_ERR.get(b["dir"], "سبب غير معروف — افحص سجله")
                        tg_send(f"⚠️ *الحارس أوقف* `{b['symbol']}`\nالسبب: {why}\nأصلح المشكلة ثم اضغط ▶️ تشغيل")
                        hist.clear()
                        continue
                    ok, _ = launch(b)
                    if ok:
                        hist.append(now)
                        tg_send(f"🤖 *الحارس* — `{b['symbol']}` طاح وأعدت تشغيله ({len(hist)}/4)")
        except Exception:
            pass
        time.sleep(5)

