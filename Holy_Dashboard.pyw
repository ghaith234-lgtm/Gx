  // 🛡️ شارة الرقابة بالقائمة (أحمر = يحتاج قرار · أصفر = انتبه) + الشريط المصغّر
  const gA=(d.guard||[]), gb=$('#bGuard'), gRed=gA.some(a=>a.sev==='🔴');
