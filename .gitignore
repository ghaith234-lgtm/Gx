# Python caches
__pycache__/
*.pyc

# 📱 the app's build: downloaded tools and build output stay local
android/.tools/
android/build/

# 🔐 the app's signing key never goes into this repository (it is PUBLIC)
*.p12
*.jks
*.keystore
*.pfx
PASSWORD*
android/keystore/

# 📱 the signed app file (built by android/build.py --key …) — it goes INTO the dashboard (APP_APK_B64), not into git
android/dist/

# 🔤 v3.36.40: the owner's own fonts (never in this public repository)
fonts/
